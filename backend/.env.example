# 应用配置
# 生产环境必须设置 APP_ENV=production，且 APP_SECRET_KEY 必须是至少 32 字符的非默认随机值。
APP_ENV=development
APP_SECRET_KEY=replace-with-at-least-32-random-characters

# 微信小程序登录。AppSecret 只放后端 .env，不能写进小程序代码。
WECHAT_MINIPROGRAM_APPID=your-wechat-miniprogram-appid
WECHAT_MINIPROGRAM_SECRET=your-wechat-miniprogram-secret
WECHAT_XIAOYU_MINIPROGRAM_APPID=your-xiaoyu-miniprogram-appid
WECHAT_XIAOYU_MINIPROGRAM_SECRET=your-xiaoyu-miniprogram-secret
WECHAT_JSCODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session
# 分享视频结尾小程序码打开的版本：release（正式版）、trial（体验版）或 develop。
WECHAT_MINIPROGRAM_CODE_ENV_VERSION=release

# 数据库
# 生产环境必须显式配置；本地示例账号请按自己的 PostgreSQL 安装调整。
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/pawtale

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# StepFun 离线加强 ASR。当前使用 StepAudio 3 ASR Max。
STEPFUN_API_KEY=your-stepfun-key
STEPFUN_BASE_URL=https://api.stepfun.com
# Long-form narration: step-tts-mini, default voice wenrounvsheng (24 kHz MP3).
STEPFUN_TTS_TIMEOUT_SECONDS=120
STEPFUN_ASR_MODEL=stepaudio-3-asr-max

# 火山方舟。API Key 只放后端，用于豆包文字模型和分享视频 AI 背景图。
VOLC_ARK_API_KEY=
VOLC_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLC_ARK_MODEL=doubao-seed-2-0-pro-260215
VOLC_ARK_IMAGE_MODEL=doubao-seedream-5-0-lite-260128
VOLC_ARK_IMAGE_SIZE=2K
VOLC_ARK_IMAGE_OUTPUT_FORMAT=png
VOLC_ARK_IMAGE_RESPONSE_FORMAT=b64_json
VOLC_ARK_IMAGE_TIMEOUT_SECONDS=180
VOLC_ARK_IMAGE_MAX_CONCURRENT_REQUESTS=3
MEMOIR_SHARE_VIDEO_AI_BACKGROUND_ENABLED=false
MEMOIR_SHARE_VIDEO_SCENE_PLANNER_ENABLED=true
MEMOIR_SHARE_VIDEO_SCENE_PLANNER_MODEL=doubao-seed-2-0-pro-260215

# Claude 中转站，OpenAI 兼容格式。Base URL 可带或不带 /v1。
ANTHROPIC_AUTH_TOKEN=your-claude-token
ANTHROPIC_BASE_URL=https://blankapi.com

# 默认 AI 模型：DeepSeek V4.1 Flash
DEFAULT_AI_MODEL=deepseek-flash
AI_TEXT_MAX_CONCURRENT_REQUESTS=3
AI_TEXT_REALTIME_TIMEOUT_SECONDS=15
AI_TEXT_INTERACTIVE_TIMEOUT_SECONDS=60
AI_TEXT_GENERATION_TIMEOUT_SECONDS=180

# ECS-local embedding service (no provider key required)
EMBEDDING_SERVICE_BASE_URL=http://127.0.0.1:8102
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSIONS=512
EMBEDDING_TIMEOUT_SECONDS=5
MEMOIR_EDITING_JOB_DEADLINE_SECONDS=3600
MEMOIR_SHARE_VIDEO_JOB_DEADLINE_SECONDS=1800
MEMOIR_BOOK_EXPORT_DEADLINE_SECONDS=240
MEMOIR_INTERVIEW_POLICY_SHADOW_ENABLED=false
MEMOIR_INTERVIEW_POLICY_SHADOW_MODEL=
MEMOIR_INTERVIEW_POLICY_ACTIVE_ENABLED=false
MEMOIR_INTERVIEW_POLICY_ACTIVE_ROLLOUT_PERCENT=0
MEMOIR_INTERVIEW_POLICY_ACTIVE_MODEL=
MEMOIR_INTERVIEW_POLICY_OUTCOME_MODEL=
MEMOIR_TOPIC_MAP_SHADOW_ENABLED=false
MEMOIR_TOPIC_MAP_SHADOW_MODEL=

# GitHub App 单向备份。Private key 只放后端，可用 inline 内容或文件路径二选一。
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_SETUP_REDIRECT_URL=http://localhost:5173/
GITHUB_SYNC_DEFAULT_BRANCH=main

# 豆包 / 火山引擎大模型流式 ASR
# 新版语音控制台优先使用 VOLC_ASR_API_KEY；旧版控制台可使用 APP_KEY + ACCESS_KEY。
VOLC_ASR_API_KEY=your-volc-asr-api-key
VOLC_ASR_APP_KEY=
VOLC_ASR_ACCESS_KEY=
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOLC_ASR_CONNECT_TIMEOUT_SECONDS=10

# AI 追问/语音编辑合成。默认关闭；启用火山/豆包语音 V3 时设置为 volc。
TTS_PROVIDER=disabled
TTS_TIMEOUT_SECONDS=30
TTS_MAX_CONCURRENT_REQUESTS=3
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
VOLC_TTS_API_KEY=
VOLC_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional/sse
VOLC_TTS_BIDIRECTIONAL_ENDPOINT=wss://openspeech.bytedance.com/api/v3/tts/bidirection
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_SPEAKER=zh_female_vv_uranus_bigtts
VOLC_TTS_RESPONSE_FORMAT=mp3
VOLC_TTS_SAMPLE_RATE=24000
