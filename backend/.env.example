# 应用配置
# 生产环境必须设置 APP_ENV=production，且 APP_SECRET_KEY 必须是至少 32 字符的非默认随机值。
APP_ENV=development
APP_SECRET_KEY=replace-with-at-least-32-random-characters

# 微信小程序登录。AppSecret 只放后端 .env，不能写进小程序代码。
WECHAT_MINIPROGRAM_APPID=your-wechat-miniprogram-appid
WECHAT_MINIPROGRAM_SECRET=your-wechat-miniprogram-secret
WECHAT_JSCODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session

# 数据库
# 不设置 DATABASE_URL 时，默认使用仓库根目录 data/pawtale.db
# DATABASE_URL=sqlite+aiosqlite:///../data/pawtale.db

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Claude 代理，OpenAI 兼容格式
ANTHROPIC_AUTH_TOKEN=your-claude-token
ANTHROPIC_BASE_URL=https://cursor.scihub.edu.kg/api

# 默认 AI 模型：deepseek / claude-opus-4 / claude-sonnet-4
DEFAULT_AI_MODEL=claude-opus-4

# 豆包 / 火山引擎大模型流式 ASR
# 新版语音控制台优先使用 VOLC_ASR_API_KEY；旧版控制台可使用 APP_KEY + ACCESS_KEY。
VOLC_ASR_API_KEY=your-volc-asr-api-key
VOLC_ASR_APP_KEY=
VOLC_ASR_ACCESS_KEY=
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOLC_ASR_CONNECT_TIMEOUT_SECONDS=10

# AI 追问语音合成。默认关闭；启用 OpenAI 兼容 TTS 时设置为 openai_compatible。
TTS_PROVIDER=disabled
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_RESPONSE_FORMAT=mp3
TTS_TIMEOUT_SECONDS=30
