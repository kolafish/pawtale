      "relevance",
      "memoir_interviewer_tone",
      "empathy_without_overacting",
      "faithfulness",
      "natural_spoken_chinese"
    ],
    "runtime_metrics": [
      "latency_ms",
      "input_tokens",
      "output_tokens",
      "cached_input_tokens",
      "finish_reason",
      "estimated_cost"
    ]
