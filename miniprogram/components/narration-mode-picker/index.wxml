<view class="narration-picker {{largeText ? 'narration-picker-large' : ''}}">
  <text class="narration-picker-title">讲述方式</text>
  <view class="narration-options" aria-role="radiogroup" aria-label="四种讲述方式">
    <view wx:for="{{options}}" wx:key="value" id="mode-{{item.value}}"
      class="narration-option {{selected === item.value ? 'is-selected' : ''}}"
      data-mode="{{item.value}}" bindtap="choose" hover-class="{{disabled || locked ? 'none' : 'ui-subtle-action-hover'}}"
      aria-role="radio" aria-checked="{{selected === item.value}}" aria-disabled="{{disabled || locked}}"
      aria-label="{{item.label}}，{{selected === item.value ? '已选中，' : ''}}{{item.description}}">
      <view class="narration-option-heading">
        <text>{{item.label}}</text>
        <text wx:if="{{selected === item.value}}" class="narration-option-check">✓ 已选</text>
      </view>
      <text wx:if="{{!compact}}" class="narration-option-description">{{item.description}}</text>
    </view>
  </view>
  <text class="narration-picker-hint">{{locked ? '本次方式已确定，结束讲述后可切换。' : '选好方式，再点下方按钮开始。'}}</text>
</view>
