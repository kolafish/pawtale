.narration-picker { margin: 18rpx 0 24rpx; }
.narration-picker-title, .narration-picker-hint, .narration-option-description { display: block; }
.narration-picker-title { margin-bottom: 14rpx; color: var(--ui-section-title); font-family: var(--ui-font-editorial); font-size: 28rpx; font-weight: 800; }
.narration-options { display: flex; flex-direction: column; gap: 10rpx; }
.narration-option {
  min-width: 0;
  min-height: 96rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface);
  box-shadow: var(--ui-control-shadow);
  display: flex;
  align-items: center;
  gap: 18rpx;
  transition-property: transform, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}
.narration-option.is-selected { background: var(--ui-accent-surface-subtle); box-shadow: 0 0 0 2rpx var(--ui-accent-border) inset, 0 5rpx 14rpx rgba(63, 47, 37, 0.04); }
.narration-option-mark { width: 18rpx; height: 18rpx; flex: 0 0 18rpx; border-radius: 50%; background: var(--ui-success-text); box-shadow: 0 0 0 8rpx var(--ui-success-surface); }
.narration-option-copy { min-width: 0; flex: 1; }
.narration-option-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; color: var(--ui-text-primary); font-size: 30rpx; font-weight: 700; line-height: 1.45; }
.narration-option-check { width: 40rpx; height: 40rpx; flex: 0 0 40rpx; border-radius: 50%; background: var(--ui-accent); color: var(--ui-on-accent); font-size: 23rpx; line-height: 40rpx; opacity: 0; text-align: center; transform: scale(0.8); }
.narration-option-check.is-visible { opacity: 1; transform: scale(1); }
.narration-option-description, .narration-picker-hint { color: var(--ui-text-secondary); font-size: 24rpx; line-height: 1.5; text-wrap: pretty; }
.narration-option-description { margin-top: 4rpx; }
.narration-picker-hint { margin-top: 12rpx; }
.narration-picker.is-compact .narration-option { min-height: 88rpx; padding: 14rpx 16rpx; gap: 12rpx; }
.narration-picker.is-compact .narration-option-mark { width: 14rpx; height: 14rpx; flex-basis: 14rpx; box-shadow: 0 0 0 6rpx var(--ui-surface-subtle); }
.narration-picker.is-compact .narration-option-heading { font-size: 27rpx; }
.narration-picker.is-compact .narration-option-description { font-size: 22rpx; }
.narration-picker-large .narration-option-heading { font-size: 34rpx; }
.narration-picker-large .narration-option-check, .narration-picker-large .narration-option-description, .narration-picker-large .narration-picker-hint { font-size: 28rpx; }
