.ai-task-title,
.ai-task-detail {
  display: block;
  overflow-wrap: anywhere;
}

.ai-task-title {
  color: var(--ui-text-primary);
  font-size: var(--ui-font-list-title);
  font-weight: 700;
  line-height: 1.4;
  text-wrap: balance;
}

.ai-task-detail {
  margin-top: 6rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  font-variant-numeric: tabular-nums;
  text-wrap: pretty;
}

.ai-task-track {
  height: 12rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(143, 64, 55, 0.1);
}

.ai-task-progress {
  height: 100%;
  border-radius: inherit;
  background: var(--ui-accent);
  transition-property: width;
  transition-duration: 180ms;
  transition-timing-function: ease-out;
}

.ai-task-progress.is-indeterminate {
  width: 38% !important;
  animation: ai-task-indeterminate 1.2s ease-in-out infinite alternate;
}

.ai-task-cancel {
  min-height: 88rpx;
  margin-top: 12rpx;
  padding: 10rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 38rpx;
  transition-property: transform, opacity;
  transition-duration: 120ms;
  transition-timing-function: ease-out;
}

.ai-task-cancel:active {
  opacity: 0.72;
  transform: scale(0.96);
}

@keyframes ai-task-indeterminate {
  0% {
    transform: translateX(0);
  }

  100% {
    transform: translateX(160%);
  }
}
