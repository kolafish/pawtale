.styles { display: grid; gap: 10rpx; margin-top: 14rpx; }
.style { position: relative; display: flex; align-items: center; gap: 20rpx; min-height: 88rpx; padding: 16rpx 58rpx 16rpx 18rpx; border-radius: var(--ui-radius-control); background: var(--ui-surface-soft); box-shadow: var(--ui-control-shadow); transition: transform 150ms ease-out; }
.style:active { transform: scale(0.96); }
.style::after { content: ""; position: absolute; top: 50%; right: 20rpx; width: 18rpx; height: 18rpx; border: 2rpx solid var(--ui-border); border-radius: 50%; transform: translateY(-50%); }
.selected { background: var(--ui-success-surface); box-shadow: 0 0 0 1rpx rgba(88,112,82,.1); }
.selected::after { border-color: var(--ui-success-text); background: var(--ui-success-text); box-shadow: inset 0 0 0 5rpx var(--ui-success-surface); }
image { flex: none; width: 128rpx; height: 228rpx; border-radius: 2rpx; outline: 1px solid rgba(0,0,0,.1); outline-offset: -1px; }
.copy { min-width: 0; flex: 1; }
.label { display: block; color: var(--ui-text-primary); font-size: var(--ui-font-meta); font-weight: 700; line-height: 1.4; }
.description { display: block; margin-top: 4rpx; color: var(--ui-text-secondary); font-size: var(--ui-font-body); line-height: var(--ui-line-body); }
