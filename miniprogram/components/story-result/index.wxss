.result-shell {
  margin-top: 22rpx;
  padding: 20rpx 0 12rpx;
  border-radius: var(--ui-radius-card);
  background: #fcf8f0;
  color: #59412a;
  overflow: hidden;
}
.result-copy { position: relative; padding: 0 24rpx; text-align: center; }
.result-row { margin-bottom: 8rpx; line-height: 1.5; overflow-wrap: anywhere; }
.result-label { margin-right: 14rpx; font-size: var(--ui-font-meta); color: #785120; }
.result-title {
  font-family: var(--ui-font-editorial);
  font-size: 44rpx;
  font-weight: 500;
  text-shadow: 0 0 12px rgba(239, 195, 108, 0.28);
}
.result-meta { display: flex; flex-wrap: wrap; justify-content: center; gap: 8rpx 20rpx; }
.result-count { font-size: var(--ui-font-section-title); color: #785120; text-shadow: 0 0 12px rgba(239, 195, 108, 0.33); }
.result-more { font-size: var(--ui-font-meta); color: var(--ui-text-secondary); align-self: center; }
.book-art { display: block; width: 100%; height: 250rpx; }
.quiet-result { padding: 16rpx 20rpx; }
.quiet-result .result-title { font-size: var(--ui-font-list-title); text-shadow: none; }
.quiet-result .result-count { font-size: var(--ui-font-body); text-shadow: none; }
.large-text .result-title { font-size: 48rpx; }
.large-text .result-label, .large-text .result-more { font-size: var(--ui-font-large-meta); }
.large-text .result-count { font-size: 40rpx; }
.large-text.quiet-result .result-title { font-size: var(--ui-font-large-list-title); }
