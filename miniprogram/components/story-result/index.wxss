.result-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.result-scene { position: relative; width: 640rpx; max-width: 88vw; color: #59412a; }
.result-aura {
  position: absolute;
  top: -64rpx;
  right: -36rpx;
  bottom: -24rpx;
  left: -36rpx;
  background: radial-gradient(ellipse at 50% 32%, rgba(255, 250, 238, .99) 24%, rgba(255, 250, 238, .97) 48%, rgba(255, 250, 238, 0) 76%);
}
.result-copy { position: relative; padding: 0 20rpx; text-align: center; }
.result-title {
  display: block;
  font-family: var(--ui-font-editorial);
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.45;
  overflow-wrap: anywhere;
  text-shadow: 0 0 8px #fffaf0, 0 0 16px rgba(239, 195, 108, .4);
}
.result-count { display: block; margin-top: 12rpx; font-size: 38rpx; line-height: 1.5; color: #785120; text-shadow: 0 0 8px #fffaf0; }
.book-art { position: relative; display: block; width: 100%; height: 280rpx; }
.large-text .result-title { font-size: 52rpx; }
.large-text .result-count { font-size: 42rpx; }
.quiet-result .result-title { font-size: var(--ui-font-list-title); }
.quiet-result .result-count { font-size: var(--ui-font-body); }
.quiet-result .result-aura { top: -80rpx; bottom: -80rpx; }
@media (max-height: 440px) {
  .result-scene { width: 320px; }
  .result-title, .large-text .result-title { font-size: 24px; }
  .result-count, .large-text .result-count { font-size: 22px; margin-top: 6px; }
  .book-art { height: 120px; }
}
