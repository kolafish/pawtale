.group-title,
.group-detail,
.question,
.reason,
.state,
.required-answer-label,
.friendly-group-title,
.friendly-question {
  display: block;
  overflow-wrap: anywhere;
}

.friendly-issue-group {
  margin-top: 22rpx;
}

.friendly-required-group + .friendly-optional-group {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.friendly-group-title {
  margin-bottom: 12rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  font-weight: 650;
  line-height: 1.5;
}

.friendly-issue-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(248, 239, 234, 0.72);
  box-shadow:
    0 0 0 1rpx rgba(91, 63, 48, 0.05),
    0 8rpx 24rpx rgba(91, 63, 48, 0.04);
}

.friendly-issue-card + .friendly-issue-card {
  margin-top: 14rpx;
}

.friendly-question-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.friendly-chat-icon {
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 253, 250, 0.76);
}

.friendly-chat-icon image {
  width: 46rpx;
  height: 46rpx;
}

.friendly-question {
  min-width: 0;
  flex: 1 1 auto;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-action);
  font-weight: 650;
  line-height: 1.5;
  text-wrap: pretty;
}

.friendly-primary-action {
  width: 100%;
  min-height: var(--ui-hit-size);
  margin-top: 22rpx;
  padding: 14rpx 22rpx 14rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border-radius: 22rpx;
  background: rgba(255, 253, 250, 0.86);
  color: var(--ui-accent-strong);
  box-shadow:
    0 0 0 1rpx var(--ui-accent-border),
    0 6rpx 18rpx rgba(91, 63, 48, 0.04);
  font-size: var(--ui-font-action);
  font-weight: 700;
  line-height: 1.5;
  transition-property: transform, opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.friendly-primary-action:active {
  transform: scale(0.96);
  opacity: 0.84;
}

.friendly-primary-action > text {
  margin-top: -2rpx;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.friendly-secondary-actions {
  min-height: var(--ui-hit-size);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 36rpx;
}

.friendly-secondary-action {
  min-height: var(--ui-hit-size);
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  line-height: 1.5;
  transition-property: opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.friendly-secondary-action:active {
  opacity: 0.62;
}

.issue-group {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.group-title {
  font-size: var(--ui-font-list-title);
  font-weight: 700;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
}

.required .group-title {
  color: var(--ui-danger-text);
}

.optional .group-title {
  color: var(--ui-accent-strong);
}

.group-detail,
.reason,
.state {
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
}

.group-detail,
.reason {
  margin-top: 6rpx;
}

.issue {
  margin-top: 18rpx;
  padding: 20rpx;
  background: var(--ui-surface-subtle);
}

.question {
  font-size: var(--ui-font-action);
  font-weight: 650;
  line-height: 1.5;
}

.state {
  margin-top: 12rpx;
  color: var(--ui-accent-strong);
}

.actions {
  display: flex;
  gap: 12rpx;
}

.required-answer-editor {
  margin-top: 18rpx;
}

.required-answer-label {
  margin-bottom: 10rpx;
  color: var(--ui-text-primary);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 1.5;
}

.action {
  min-height: var(--ui-hit-size);
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--ui-accent);
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-action);
  font-weight: 700;
}

.action.compact {
  flex: 1;
  min-width: 0;
  padding: 12rpx 8rpx;
  line-height: 1.5;
  text-align: center;
  overflow-wrap: anywhere;
}

.required-actions .action:first-child {
  flex: 2;
}

.action.subtle {
  border-color: var(--ui-border);
  color: var(--ui-text-secondary);
}

.action.is-disabled {
  opacity: 0.48;
}

.action:active {
  transform: scale(0.96);
  background: var(--ui-accent-surface-subtle);
}
