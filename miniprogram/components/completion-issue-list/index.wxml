<view wx:if="{{requiredIssues.length}}" class="issue-group required">
  <text class="group-title">需要确认 · {{requiredIssues.length}} 项</text>
  <text class="group-detail">
    {{allowRequiredConfirmation ? "处理后才能生成全书。" : "涉及隐私、事实冲突或内容取舍，需要处理后才能确认本章。"}}
  </text>
  <view wx:for="{{requiredIssues}}" wx:key="id" class="issue">
    <text class="question">{{item.question}}</text>
    <text class="reason">{{item.reason}}</text>
    <view
      wx:if="{{allowRequiredConfirmation}}"
      class="action ui-pressable {{busyIssueId || disabled ? 'is-disabled' : ''}}"
      data-issue-id="{{item.id}}"
      bindtap="confirmRequired"
    >{{busyIssueId === item.id ? "处理中…" : "确认处理决定"}}</view>
    <text wx:else class="state">
      {{index === 0 ? "请通过上方“本章进度”处理当前项" : "处理当前项后继续确认"}}
    </text>
  </view>
</view>

<view wx:if="{{optionalIssues.length}}" class="issue-group optional">
  <text class="group-title">可选补充 · {{optionalIssues.length}} 项</text>
  <text class="group-detail">可以补讲、标记已处理或跳过，不会阻塞成书。</text>
  <view wx:for="{{optionalIssues}}" wx:key="id" class="issue">
    <text class="question">{{item.question}}</text>
    <text class="reason">{{item.reason}}</text>
    <view class="actions">
      <view class="action compact ui-pressable {{busyIssueId || disabled ? 'is-disabled' : ''}}" data-issue-id="{{item.id}}" bindtap="beginInterview">
        {{item.active_session_id ? "继续补充" : "语音补充"}}
      </view>
      <view class="action compact ui-pressable {{busyIssueId || disabled ? 'is-disabled' : ''}}" data-issue-id="{{item.id}}" bindtap="markHandled">已处理</view>
      <view class="action compact subtle ui-pressable {{busyIssueId || disabled ? 'is-disabled' : ''}}" data-issue-id="{{item.id}}" bindtap="skip">不补了</view>
    </view>
  </view>
</view>
