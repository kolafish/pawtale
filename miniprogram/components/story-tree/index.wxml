<view class="story-home ui-accessible-page {{largeText ? 'large-text' : ''}}">
  <view class="story-hero ui-card ui-card-borderless">
    <view
      id="active-project-action"
      class="hero-heading {{canSwitchProject ? 'ui-pressable' : ''}}"
      bindtap="openProjects"
      hover-class="{{canSwitchProject ? 'ui-subtle-action-hover' : 'none'}}"
      aria-role="{{canSwitchProject ? 'button' : 'heading'}}"
      aria-label="{{canSwitchProject ? '当前故事本，' + story.memoir.title + '，点击切换' : story.overview.title}}"
    >
      <text class="hero-title">{{story.overview.title}}</text>
      <text wx:if="{{canSwitchProject}}" class="hero-title-arrow" aria-hidden="true">›</text>
    </view>

    <view class="hero-visual" aria-label="故事树成长到第 {{story.overview.growthStage}} 阶段">
      <image
        class="hero-tree-image"
        src="{{story.overview.growthImageSrc}}"
        mode="aspectFit"
        aria-hidden="true"
      />
      <view
        wx:for="{{story.overview.themeTags}}"
        wx:key="id"
        wx:for-index="tagIndex"
        class="theme-tag theme-tag-{{tagIndex}} theme-tone-{{item.tone}}"
      >
        <view class="theme-tag-leaf" aria-hidden="true"></view>
        <text class="theme-tag-text">{{item.title}}</text>
      </view>
    </view>

    <text class="hero-summary ui-tabular">{{story.overview.summaryText}}</text>
    <slot name="heroAction"></slot>
  </view>

  <slot name="afterHero"></slot>

  <view wx:if="{{story.overview.hasChapters}}" class="story-list-section">
    <view class="story-list-heading">
      <text class="story-list-title">树上的故事</text>
      <view
        wx:if="{{story.overview.hasMoreChapters}}"
        class="story-list-toggle ui-pressable"
        bindtap="toggleAllChapters"
        hover-class="ui-subtle-action-hover"
        aria-role="button"
        aria-expanded="{{showAllChapters}}"
      >{{showAllChapters ? '收起' : '查看全部'}} ›</view>
    </view>

    <view class="story-list ui-card ui-card-borderless">
      <block wx:for="{{story.chapters}}" wx:key="id">
        <view
          wx:if="{{showAllChapters || item.featured}}"
          id="story-chapter-{{item.id}}"
          class="story-row ui-pressable {{item.highlighted ? 'is-new-growth' : ''}} {{item.growthAnimating ? 'growth-arriving' : ''}}"
          data-id="{{item.id}}"
          bindtap="openChapter"
          hover-class="ui-subtle-action-hover"
          aria-role="button"
          aria-label="{{item.title}}，{{item.storyCountText}}"
        >
          <view class="story-leaf story-tone-{{item.tone}}" aria-hidden="true">
            <view class="story-leaf-shape"></view>
          </view>
          <view class="story-row-copy">
            <view class="story-row-title-line">
              <text class="story-row-title">{{item.title}}</text>
              <text wx:if="{{item.growthLabel}}" class="growth-label">{{item.growthLabel}}</text>
            </view>
            <text class="story-row-meta ui-tabular">{{item.storyCountText}}</text>
          </view>
          <text class="story-row-arrow" aria-hidden="true">›</text>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{showBook}}" class="book-card ui-card ui-card-borderless ui-pressable" bindtap="openBook"
    hover-class="ui-subtle-action-hover" aria-role="button" aria-label="{{story.memoir.progressDetail}}，{{story.memoir.bookMetaText}}">
    <view class="book-symbol" aria-hidden="true"><text>书</text></view>
    <view class="book-copy">
      <text class="book-title">我的书</text>
      <text class="book-meta ui-tabular">{{story.memoir.bookMetaText}}</text>
    </view>
    <view class="book-action"><text>{{story.memoir.progressDetail}}</text><text aria-hidden="true">›</text></view>
  </view>

  <view wx:if="{{canVoiceEdit}}" class="story-utilities">
    <view class="story-utility ui-pressable" bindtap="openTranscripts" hover-class="ui-subtle-action-hover"
      aria-role="button" aria-label="查看全部回忆">全部回忆</view>
    <view class="story-utility ui-pressable" bindtap="openVoiceEdit" hover-class="ui-subtle-action-hover"
      aria-role="button" aria-label="用语音编辑故事">语音编辑</view>
  </view>
</view>
