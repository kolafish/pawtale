.story-home {
  display: block;
}

.story-hero {
  overflow: hidden;
  padding: 24rpx;
  border-radius: 32rpx;
  background: #fcfaf5;
  box-shadow:
    0 0 0 1rpx rgba(54, 42, 34, 0.04),
    0 8rpx 22rpx rgba(63, 47, 37, 0.045),
    0 28rpx 60rpx rgba(63, 47, 37, 0.045);
}

.hero-heading {
  box-sizing: border-box;
  width: fit-content;
  max-width: 100%;
  min-height: 44px;
  margin: -8rpx 0 0 -8rpx;
  padding: 8rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.hero-title {
  min-width: 0;
  overflow: hidden;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-title-arrow {
  color: var(--ui-accent-strong);
  font-size: 38rpx;
  font-weight: 500;
  line-height: 1;
  transform: translateY(-1rpx);
}

.hero-visual {
  position: relative;
  height: 390rpx;
  margin: 0 -10rpx;
  overflow: hidden;
  border-radius: 22rpx;
}

.hero-tree-book-action {
  width: 100%;
  height: 100%;
  border-radius: 22rpx;
  transform-origin: center;
}

.story-tree-book-hover {
  opacity: 0.94;
  transform: scale(0.96);
}

.hero-tree-image {
  width: 100%;
  height: 100%;
}

.theme-tag {
  position: absolute;
  z-index: 2;
  pointer-events: none;
  box-sizing: border-box;
  max-width: 210rpx;
  min-height: 58rpx;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 9rpx;
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.035),
    0 5rpx 14rpx rgba(63, 47, 37, 0.05);
}

.theme-tag-0 { left: 14rpx; top: 100rpx; }
.theme-tag-1 { right: 8rpx; top: 154rpx; }
.theme-tag-2 { right: 34rpx; bottom: 42rpx; }

.theme-tone-clay { background: #f8e7df; color: #9a493a; }
.theme-tone-sun { background: #fbefd8; color: #8d642e; }
.theme-tone-leaf { background: #eaf1e5; color: #526b4e; }

.theme-tag-leaf {
  width: 20rpx;
  height: 13rpx;
  flex: 0 0 20rpx;
  border-radius: 100% 0 100% 0;
  background: currentColor;
  opacity: 0.85;
  transform: rotate(-28deg);
}

.theme-tag-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--ui-font-body);
  font-weight: 700;
  line-height: var(--ui-line-body);
}

.hero-summary {
  display: block;
  color: var(--ui-text-primary);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
  font-variant-numeric: tabular-nums;
  text-align: left;
}

.hero-summary.is-static {
  margin-top: 4rpx;
  text-align: center;
}

.story-summary-action {
  box-sizing: border-box;
  width: 100%;
  min-height: 44px;
  margin-top: 2rpx;
  padding: 4rpx 8rpx 4rpx 12rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  transition-property: transform, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.story-summary-action .hero-summary {
  min-width: 0;
  flex: 1;
}

.story-summary-toggle {
  min-height: 44px;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-action);
  font-weight: 700;
  line-height: 1.35;
}

.story-summary-arrow {
  width: 24rpx;
  color: var(--ui-accent-strong);
  font-size: 32rpx;
  font-weight: 400;
  line-height: 1;
  text-align: center;
  transform: rotate(90deg) translateX(1rpx);
  transition-property: transform;
  transition-duration: 220ms;
  transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
}

.story-summary-arrow.is-open {
  transform: rotate(-90deg) translateX(-1rpx);
}

.story-list-expand {
  display: grid;
  grid-template-rows: 0fr;
  opacity: 0;
  pointer-events: none;
  transition-property: grid-template-rows, opacity, margin-top;
  transition-duration: 220ms;
  transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
}

.story-list-expand.is-open {
  grid-template-rows: 1fr;
  margin-top: 10rpx;
  opacity: 1;
  pointer-events: auto;
}

.story-list-expand-inner {
  min-height: 0;
  overflow: hidden;
}

.story-list {
  overflow: hidden;
  border-radius: 18rpx;
  background: rgba(255, 253, 250, 0.62);
  box-shadow:
    0 0 0 1rpx rgba(54, 42, 34, 0.055),
    0 5rpx 14rpx rgba(63, 47, 37, 0.025);
}

.story-row {
  position: relative;
  box-sizing: border-box;
  min-height: 100rpx;
  padding: 14rpx 14rpx 14rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  transition-property: transform, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.story-row + .story-row::before {
  content: "";
  position: absolute;
  top: 0;
  left: 80rpx;
  right: 14rpx;
  height: 1rpx;
  background: var(--ui-divider);
}

.story-row.is-new-growth {
  background: #fffaf0;
  box-shadow: 0 0 0 2rpx rgba(192, 154, 96, 0.14) inset;
}

.story-leaf {
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 54rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.story-tone-clay { background: #f8e7df; color: #a75341; }
.story-tone-sun { background: #fbefd8; color: #9a6b2b; }
.story-tone-leaf { background: #eaf1e5; color: #587052; }

.story-leaf-shape {
  width: 25rpx;
  height: 18rpx;
  border-radius: 100% 0 100% 0;
  background: currentColor;
  transform: rotate(-34deg) translate(1rpx, -1rpx);
}

.story-row-copy {
  min-width: 0;
  flex: 1;
}

.story-row-title-line {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.story-row-title,
.story-row-meta {
  display: block;
}

.story-row-title {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ui-text-primary);
  font-size: var(--ui-font-list-title);
  font-weight: 700;
  line-height: 1.4;
}

.story-row-meta {
  margin-top: 2rpx;
  color: var(--ui-text-muted);
  font-size: var(--ui-font-caption);
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
}

.growth-label {
  flex: 0 0 auto;
  color: var(--ui-warning-text);
  font-size: var(--ui-font-caption);
  font-weight: 700;
}

.story-row-arrow {
  width: 24rpx;
  flex: 0 0 24rpx;
  color: var(--ui-text-muted);
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
  text-align: center;
  transform: translateX(1rpx);
}

.story-utilities {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.story-utility {
  box-sizing: border-box;
  min-height: 44px;
  padding: 0 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  font-weight: 600;
}

.story-utility-divider {
  width: 1rpx;
  height: 24rpx;
  flex: 0 0 1rpx;
  background: rgba(96, 77, 64, 0.18);
}

.growth-arriving {
  animation: story-growth-arrive 520ms ease-out;
}

.story-summary-action.is-growing .hero-summary {
  animation: story-summary-grow 620ms cubic-bezier(0.2, 0, 0, 1);
}

@keyframes story-growth-arrive {
  from { opacity: 0.58; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes story-summary-grow {
  0% { color: var(--ui-accent-strong); opacity: 0.55; transform: translateY(5rpx) scale(0.98); }
  55% { color: var(--ui-accent-strong); opacity: 1; transform: translateY(0) scale(1.025); }
  100% { color: var(--ui-text-primary); opacity: 1; transform: translateY(0) scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  .growth-arriving,
  .story-summary-action.is-growing .hero-summary { animation: none; }
  .story-list-expand,
  .story-summary-arrow { transition-duration: 0ms; }
}

.large-text .hero-title { font-size: 42rpx; }
.large-text .hero-visual { height: 430rpx; }
.large-text .theme-tag { max-width: 240rpx; min-height: 66rpx; }
.large-text .theme-tag-text { font-size: var(--ui-font-large-body); }
.large-text .hero-summary { font-size: 36rpx; }
.large-text .story-summary-toggle,
.large-text .story-utility { font-size: var(--ui-font-large-body); }
.large-text .story-row { min-height: 136rpx; flex-wrap: wrap; }
.large-text .story-row-title { font-size: 35rpx; }
.large-text .story-row-meta,
.large-text .growth-label { font-size: var(--ui-font-large-meta); }
.large-text .story-utility { font-size: var(--ui-font-large-meta); }

@media (max-width: 360px) {
  .story-hero { padding: 20rpx; }
  .hero-visual { height: 360rpx; }
  .theme-tag { max-width: 180rpx; padding-right: 12rpx; padding-left: 12rpx; }
}
