.story-home {
  display: block;
}

.story-hero {
  overflow: hidden;
  padding: 24rpx;
  border-radius: 32rpx;
  background: #fcfaf5;
  box-shadow:
    0 0 0 1rpx rgba(54, 42, 34, 0.04),
    0 8rpx 22rpx rgba(63, 47, 37, 0.045),
    0 28rpx 60rpx rgba(63, 47, 37, 0.045);
}

.hero-heading {
  box-sizing: border-box;
  width: fit-content;
  min-height: 44px;
  margin: -8rpx 0 0 -8rpx;
  padding: 8rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.hero-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.35;
  text-wrap: balance;
}

.hero-title-arrow {
  color: var(--ui-accent-strong);
  font-size: 38rpx;
  font-weight: 500;
  line-height: 1;
  transform: translateY(-1rpx);
}

.hero-visual {
  position: relative;
  height: 390rpx;
  margin: 0 -10rpx;
  overflow: hidden;
  border-radius: 22rpx;
}

.hero-tree-image {
  width: 100%;
  height: 100%;
}

.theme-tag {
  position: absolute;
  z-index: 2;
  box-sizing: border-box;
  max-width: 210rpx;
  min-height: 58rpx;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 9rpx;
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.035),
    0 5rpx 14rpx rgba(63, 47, 37, 0.05);
}

.theme-tag-0 { left: 14rpx; top: 100rpx; }
.theme-tag-1 { right: 8rpx; top: 154rpx; }
.theme-tag-2 { right: 34rpx; bottom: 42rpx; }

.theme-tone-clay { background: #f8e7df; color: #9a493a; }
.theme-tone-sun { background: #fbefd8; color: #8d642e; }
.theme-tone-leaf { background: #eaf1e5; color: #526b4e; }

.theme-tag-leaf {
  width: 20rpx;
  height: 13rpx;
  flex: 0 0 20rpx;
  border-radius: 100% 0 100% 0;
  background: currentColor;
  opacity: 0.85;
  transform: rotate(-28deg);
}

.theme-tag-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-summary,
.hero-growth-copy {
  display: block;
  text-align: center;
}

.hero-summary {
  margin-top: 4rpx;
  color: var(--ui-text-primary);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
  font-variant-numeric: tabular-nums;
}

.hero-growth-copy {
  max-width: 560rpx;
  margin: 8rpx auto 0;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 1.55;
  text-wrap: pretty;
}

.story-list-section {
  margin-top: 30rpx;
}

.story-list-heading {
  min-height: 44px;
  padding: 0 4rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.story-list-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.story-list-toggle {
  min-height: 44px;
  padding: 0 10rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  color: var(--ui-accent-strong);
  font-size: 25rpx;
  font-weight: 700;
}

.story-list {
  overflow: hidden;
  border-radius: 28rpx;
  background: rgba(255, 253, 250, 0.96);
}

.story-row {
  position: relative;
  box-sizing: border-box;
  min-height: 112rpx;
  padding: 18rpx 18rpx 18rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  transition-property: transform, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.story-row + .story-row::before {
  content: "";
  position: absolute;
  top: 0;
  left: 88rpx;
  right: 18rpx;
  height: 1rpx;
  background: var(--ui-divider);
}

.story-row.is-new-growth {
  background: #fffaf0;
  box-shadow: 0 0 0 2rpx rgba(192, 154, 96, 0.14) inset;
}

.story-leaf {
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 54rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.story-tone-clay { background: #f8e7df; color: #a75341; }
.story-tone-sun { background: #fbefd8; color: #9a6b2b; }
.story-tone-leaf { background: #eaf1e5; color: #587052; }

.story-leaf-shape {
  width: 25rpx;
  height: 18rpx;
  border-radius: 100% 0 100% 0;
  background: currentColor;
  transform: rotate(-34deg) translate(1rpx, -1rpx);
}

.story-row-copy {
  min-width: 0;
  flex: 1;
}

.story-row-title-line {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.story-row-title,
.story-row-meta {
  display: block;
}

.story-row-title {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ui-text-primary);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.4;
}

.story-row-meta {
  margin-top: 2rpx;
  color: var(--ui-text-muted);
  font-size: 23rpx;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
}

.growth-label {
  flex: 0 0 auto;
  color: var(--ui-warning-text);
  font-size: 20rpx;
  font-weight: 700;
}

.story-status {
  flex: 0 0 auto;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.35;
  white-space: nowrap;
}

.story-status-rich { color: var(--ui-success-text); background: var(--ui-success-surface); }
.story-status-continue { color: var(--ui-warning-text); background: var(--ui-warning-surface); }
.story-status-starting,
.story-status-quiet { color: var(--ui-text-secondary); background: var(--ui-surface-subtle); }
.story-status-working { color: #5f6973; background: #e7ecef; }
.story-status-confirm { color: var(--ui-accent-strong); background: var(--ui-accent-surface); }

.story-row-arrow {
  width: 24rpx;
  flex: 0 0 24rpx;
  color: var(--ui-text-muted);
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
  text-align: center;
  transform: translateX(1rpx);
}

.book-card {
  box-sizing: border-box;
  min-height: 128rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(255, 253, 250, 0.9);
  transition-property: transform, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.book-symbol {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-accent-strong);
  background: var(--ui-accent-surface-subtle);
  font-family: var(--ui-font-editorial);
  font-size: 28rpx;
  font-weight: 800;
}

.book-copy {
  min-width: 0;
  flex: 1;
}

.book-title,
.book-meta {
  display: block;
}

.book-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
}

.book-meta {
  margin-top: 2rpx;
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
}

.book-action {
  min-height: 44px;
  flex: 0 0 auto;
  padding: 0 14rpx 0 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 7rpx;
  color: var(--ui-accent-strong);
  background: var(--ui-accent-surface-subtle);
  font-size: 24rpx;
  font-weight: 700;
}

.story-utilities {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.story-utility {
  min-height: 44px;
  padding: 0 18rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  font-weight: 600;
}

.growth-arriving {
  animation: story-growth-arrive 520ms ease-out;
}

@keyframes story-growth-arrive {
  from { opacity: 0.58; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .growth-arriving { animation: none; }
}

.large-text .hero-title { font-size: 42rpx; }
.large-text .hero-visual { height: 430rpx; }
.large-text .theme-tag { max-width: 240rpx; min-height: 66rpx; }
.large-text .theme-tag-text { font-size: 30rpx; }
.large-text .hero-summary { font-size: 36rpx; }
.large-text .hero-growth-copy { font-size: 31rpx; }
.large-text .story-list-title { font-size: 38rpx; }
.large-text .story-list-toggle,
.large-text .story-utility { font-size: 31rpx; }
.large-text .story-row { min-height: 136rpx; flex-wrap: wrap; }
.large-text .story-row-title { font-size: 35rpx; }
.large-text .story-row-meta,
.large-text .story-status,
.large-text .growth-label { font-size: 28rpx; }
.large-text .story-status { margin-left: 68rpx; }
.large-text .book-card { min-height: 150rpx; flex-wrap: wrap; }
.large-text .book-title { font-size: 36rpx; }
.large-text .book-meta,
.large-text .book-action { font-size: 29rpx; }
.large-text .book-action { margin-left: 80rpx; }

@media (max-width: 360px) {
  .story-hero { padding: 20rpx; }
  .hero-visual { height: 360rpx; }
  .theme-tag { max-width: 180rpx; padding-right: 12rpx; padding-left: 12rpx; }
  .story-status { padding-right: 9rpx; padding-left: 9rpx; }
  .book-card { flex-wrap: wrap; }
  .book-action { margin-left: 80rpx; }
}
