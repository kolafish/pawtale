.story-home {
  display: block;
}

.story-hero {
  overflow: hidden;
  padding: 24rpx;
  border-radius: 32rpx;
  background: #fcfaf5;
  box-shadow:
    0 0 0 1rpx rgba(54, 42, 34, 0.04),
    0 8rpx 22rpx rgba(63, 47, 37, 0.045),
    0 28rpx 60rpx rgba(63, 47, 37, 0.045);
}

.hero-heading {
  box-sizing: border-box;
  width: fit-content;
  min-height: 44px;
  margin: -8rpx 0 0 -8rpx;
  padding: 8rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.hero-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.35;
  text-wrap: balance;
}

.hero-title-arrow {
  color: var(--ui-accent-strong);
  font-size: 38rpx;
  font-weight: 500;
  line-height: 1;
  transform: translateY(-1rpx);
}

.hero-visual {
  position: relative;
  height: 390rpx;
  margin: 0 -10rpx;
  overflow: hidden;
  border-radius: 22rpx;
}

.hero-tree-image {
  width: 100%;
  height: 100%;
}

.theme-tag {
  position: absolute;
  z-index: 2;
  box-sizing: border-box;
  max-width: 210rpx;
  min-height: 58rpx;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 9rpx;
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.035),
    0 5rpx 14rpx rgba(63, 47, 37, 0.05);
}

.theme-tag-0 { left: 14rpx; top: 100rpx; }
.theme-tag-1 { right: 8rpx; top: 154rpx; }
.theme-tag-2 { right: 34rpx; bottom: 42rpx; }

.theme-tone-clay { background: #f8e7df; color: #9a493a; }
.theme-tone-sun { background: #fbefd8; color: #8d642e; }
.theme-tone-leaf { background: #eaf1e5; color: #526b4e; }

.theme-tag-leaf {
  width: 20rpx;
  height: 13rpx;
  flex: 0 0 20rpx;
  border-radius: 100% 0 100% 0;
  background: currentColor;
  opacity: 0.85;
  transform: rotate(-28deg);
}

.theme-tag-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-summary {
  display: block;
  color: var(--ui-text-primary);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
  font-variant-numeric: tabular-nums;
  text-align: left;
}

.hero-summary.is-static {
  margin-top: 4rpx;
  text-align: center;
}

.story-summary-action {
  box-sizing: border-box;
  width: 100%;
  min-height: 44px;
  margin-top: 2rpx;
  padding: 4rpx 8rpx 4rpx 12rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  transition-property: transform, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.story-summary-action .hero-summary {
  min-width: 0;
  flex: 1;
}

.story-summary-toggle {
  min-height: 44px;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: var(--ui-accent-strong);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
}

.story-summary-arrow {
  width: 24rpx;
  color: var(--ui-accent-strong);
  font-size: 32rpx;
  font-weight: 400;
  line-height: 1;
  text-align: center;
  transform: rotate(90deg) translateX(1rpx);
  transition-property: transform;
  transition-duration: 220ms;
  transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
}

.story-summary-arrow.is-open {
  transform: rotate(-90deg) translateX(-1rpx);
}

.story-list-expand {
  display: grid;
  grid-template-rows: 0fr;
  opacity: 0;
  pointer-events: none;
  transition-property: grid-template-rows, opacity, margin-top;
  transition-duration: 220ms;
  transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
}

.story-list-expand.is-open {
  grid-template-rows: 1fr;
  margin-top: 10rpx;
  opacity: 1;
  pointer-events: auto;
}

.story-list-expand-inner {
  min-height: 0;
  overflow: hidden;
}

.story-list {
  overflow: hidden;
  border-radius: 18rpx;
  background: rgba(255, 253, 250, 0.62);
  box-shadow:
    0 0 0 1rpx rgba(54, 42, 34, 0.055),
    0 5rpx 14rpx rgba(63, 47, 37, 0.025);
}

.story-row {
  position: relative;
  box-sizing: border-box;
  min-height: 100rpx;
  padding: 14rpx 14rpx 14rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  transition-property: transform, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.story-row + .story-row::before {
  content: "";
  position: absolute;
  top: 0;
  left: 80rpx;
  right: 14rpx;
  height: 1rpx;
  background: var(--ui-divider);
}

.story-row.is-new-growth {
  background: #fffaf0;
  box-shadow: 0 0 0 2rpx rgba(192, 154, 96, 0.14) inset;
}

.story-leaf {
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 54rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.story-tone-clay { background: #f8e7df; color: #a75341; }
.story-tone-sun { background: #fbefd8; color: #9a6b2b; }
.story-tone-leaf { background: #eaf1e5; color: #587052; }

.story-leaf-shape {
  width: 25rpx;
  height: 18rpx;
  border-radius: 100% 0 100% 0;
  background: currentColor;
  transform: rotate(-34deg) translate(1rpx, -1rpx);
}

.story-row-copy {
  min-width: 0;
  flex: 1;
}

.story-row-title-line {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.story-row-title,
.story-row-meta {
  display: block;
}

.story-row-title {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ui-text-primary);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.4;
}

.story-row-meta {
  margin-top: 2rpx;
  color: var(--ui-text-muted);
  font-size: 23rpx;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
}

.growth-label {
  flex: 0 0 auto;
  color: var(--ui-warning-text);
  font-size: 20rpx;
  font-weight: 700;
}

.story-row-arrow {
  width: 24rpx;
  flex: 0 0 24rpx;
  color: var(--ui-text-muted);
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
  text-align: center;
  transform: translateX(1rpx);
}

.book-card {
  position: relative;
  box-sizing: border-box;
  min-height: 292rpx;
  margin-top: 24rpx;
  padding: 28rpx 28rpx 22rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background:
    radial-gradient(circle at 8% 108%, rgba(211, 191, 145, 0.2), transparent 38%),
    radial-gradient(circle at 96% 92%, rgba(236, 218, 178, 0.18), transparent 34%),
    #fcfaf5;
  box-shadow:
    0 0 0 1rpx rgba(54, 42, 34, 0.04),
    0 8rpx 22rpx rgba(63, 47, 37, 0.04),
    0 26rpx 56rpx rgba(63, 47, 37, 0.045);
  transition-property: transform, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.book-heading,
.book-body {
  position: relative;
  z-index: 1;
}

.book-heading {
  padding-left: 4rpx;
}

.book-title,
.book-awaiting,
.book-chapter {
  display: block;
}

.book-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
  text-wrap: balance;
}

.book-body {
  min-height: 188rpx;
  margin-top: 4rpx;
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
}

.book-illustration-wrap {
  position: relative;
  width: 132rpx;
  height: 174rpx;
  flex: 0 0 132rpx;
}

.book-illustration {
  position: absolute;
  left: -4rpx;
  bottom: 0;
  width: 128rpx;
  height: 112rpx;
  opacity: 0.72;
  filter: saturate(0.72) contrast(0.9);
}

.book-result {
  min-width: 0;
  flex: 1;
  padding-bottom: 1rpx;
}

.book-total-line {
  min-height: 76rpx;
  display: flex;
  align-items: baseline;
  color: var(--ui-accent-strong);
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

.book-total-prefix {
  margin-right: 5rpx;
  color: var(--ui-text-secondary);
  font-size: 22rpx;
  font-weight: 600;
}

.book-total-value {
  font-family: var(--ui-font-editorial);
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.book-total-unit {
  margin-left: 7rpx;
  font-size: 25rpx;
  font-weight: 800;
}

.book-awaiting {
  padding-top: 16rpx;
  color: var(--ui-accent-strong);
  font-family: var(--ui-font-editorial);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
}

.book-chapter {
  margin-top: 2rpx;
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
}

.book-recent {
  box-sizing: border-box;
  width: fit-content;
  min-height: 48rpx;
  margin-top: 10rpx;
  padding: 5rpx 13rpx 5rpx 12rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #617151;
  background: rgba(232, 238, 218, 0.86);
  box-shadow: 0 0 0 1rpx rgba(82, 107, 78, 0.035);
}

.book-recent-leaf {
  width: 18rpx;
  height: 12rpx;
  flex: 0 0 18rpx;
  border-radius: 100% 0 100% 0;
  background: #668057;
  transform: rotate(-32deg) translateY(-1rpx);
}

.book-recent-text {
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.35;
  font-variant-numeric: tabular-nums;
}

.book-action {
  min-height: 50rpx;
  width: fit-content;
  margin-top: 8rpx;
  padding: 0 2rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 4rpx;
  color: var(--ui-accent-strong);
  font-size: 23rpx;
  font-weight: 700;
}

.book-action-arrow {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
  transform: translate(1rpx, -1rpx);
}

.story-utilities {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.story-utility {
  min-height: 44px;
  padding: 0 18rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  font-weight: 600;
}

.growth-arriving {
  animation: story-growth-arrive 520ms ease-out;
}

.story-summary-action.is-growing .hero-summary {
  animation: story-summary-grow 620ms cubic-bezier(0.2, 0, 0, 1);
}

@keyframes story-growth-arrive {
  from { opacity: 0.58; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes story-summary-grow {
  0% { color: var(--ui-accent-strong); opacity: 0.55; transform: translateY(5rpx) scale(0.98); }
  55% { color: var(--ui-accent-strong); opacity: 1; transform: translateY(0) scale(1.025); }
  100% { color: var(--ui-text-primary); opacity: 1; transform: translateY(0) scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  .growth-arriving,
  .story-summary-action.is-growing .hero-summary { animation: none; }
  .story-list-expand,
  .story-summary-arrow { transition-duration: 0ms; }
}

.large-text .hero-title { font-size: 42rpx; }
.large-text .hero-visual { height: 430rpx; }
.large-text .theme-tag { max-width: 240rpx; min-height: 66rpx; }
.large-text .theme-tag-text { font-size: 30rpx; }
.large-text .hero-summary { font-size: 36rpx; }
.large-text .story-summary-toggle,
.large-text .story-utility { font-size: 31rpx; }
.large-text .story-row { min-height: 136rpx; flex-wrap: wrap; }
.large-text .story-row-title { font-size: 35rpx; }
.large-text .story-row-meta,
.large-text .growth-label { font-size: 28rpx; }
.large-text .book-card { min-height: 334rpx; padding: 30rpx 28rpx 24rpx; }
.large-text .book-title { font-size: 36rpx; }
.large-text .book-chapter { font-size: 27rpx; }
.large-text .book-body { min-height: 216rpx; }
.large-text .book-illustration-wrap { width: 142rpx; height: 190rpx; flex-basis: 142rpx; }
.large-text .book-illustration { width: 138rpx; height: 122rpx; }
.large-text .book-total-value { font-size: 70rpx; }
.large-text .book-total-unit,
.large-text .book-action { font-size: 29rpx; }
.large-text .book-recent-text { font-size: 25rpx; }
.large-text .book-action { min-height: 56rpx; }

@media (max-width: 360px) {
  .story-hero { padding: 20rpx; }
  .hero-visual { height: 360rpx; }
  .theme-tag { max-width: 180rpx; padding-right: 12rpx; padding-left: 12rpx; }
  .book-card { padding-right: 22rpx; padding-left: 22rpx; }
  .book-body { gap: 10rpx; }
  .book-illustration-wrap { width: 116rpx; flex-basis: 116rpx; }
  .book-illustration { width: 112rpx; height: 100rpx; }
  .book-total-value { font-size: 54rpx; }
}
