.story-toolbar {
  min-height: 44px;
  margin: 12rpx 2rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.timeline-label,
.voice-edit-entry,
.transcript-list-entry {
  height: 44px;
  display: flex;
  align-items: center;
  line-height: 1;
}

.timeline-label {
  min-width: 0;
  gap: 12rpx;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 32rpx;
  font-weight: 800;
}

.timeline-mark {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--ui-accent);
  box-shadow: 0 0 0 7rpx var(--ui-accent-surface);
}

.voice-edit-entry,
.transcript-list-entry {
  margin: 0;
  padding: 0 10rpx;
  border-radius: 14rpx;
  background: transparent;
  color: var(--ui-accent-strong);
  font-size: 24rpx;
  font-weight: 600;
}

.voice-edit-entry { width: auto; margin-left: auto; padding: 0 14rpx; justify-content: center; color: var(--ui-text-secondary); font-size: 28rpx; font-weight: 700; }
.transcript-list-entry { gap: 6rpx; }
.transcript-list-mark { font-size: 30rpx; font-weight: 400; line-height: 1; }

.story-tree {
  position: relative;
  padding-bottom: 8rpx;
}

.story-tree::before {
  content: "";
  position: absolute;
  z-index: 0;
  left: 24rpx;
  top: 42rpx;
  bottom: 72rpx;
  width: 3rpx;
  background: linear-gradient(180deg, var(--ui-accent-border), #d8c8ba 74%, rgba(216, 200, 186, 0));
}

.overview-row {
  position: relative;
  z-index: 1;
  min-height: 104rpx;
  margin: 0 0 14rpx 72rpx;
  display: flex;
  align-items: center;
}

.overview-symbol {
  position: absolute;
  left: -79rpx;
  top: 20rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ui-success-surface);
  box-shadow:
    0 0 0 5rpx rgba(255, 253, 250, 0.9),
    0 6rpx 14rpx rgba(88, 112, 82, 0.08);
}

.overview-tree-image { width: 64rpx; height: 64rpx; }

.overview-card {
  width: 100%;
  min-height: 100rpx;
  padding: 20rpx 22rpx;
  border-radius: var(--ui-radius-card);
  background: rgba(255, 253, 250, 0.94);
}

.overview-heading,
.overview-book {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx 16rpx;
}

.overview-copy { min-width: 0; flex: 1 1 220rpx; }
.overview-title, .overview-summary { display: block; }
.overview-title { color: var(--ui-text-primary); font-size: 30rpx; font-weight: 800; line-height: 1.35; }
.overview-summary { margin-top: 5rpx; color: var(--ui-text-muted); font-size: 23rpx; line-height: 1.4; }
.overview-outcome { color: var(--ui-success-text); font-size: 22rpx; font-weight: 700; }
.overview-book { margin-top: 8rpx; align-items: center; }
.overview-readability { display: flex; flex-wrap: wrap; gap: 4rpx 14rpx; }
.overview-readable { color: var(--ui-text-secondary); font-size: 23rpx; line-height: 1.5; }

.chapter-block {
  --chapter-tone: var(--ui-accent);
  position: relative;
  z-index: 1;
  min-height: 112rpx;
  margin-bottom: 12rpx;
  padding-left: 72rpx;
}

.chapter-node {
  position: absolute;
  z-index: 2;
  left: -1rpx;
  top: 28rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--chapter-tone);
  color: var(--ui-on-accent);
  font-size: 26rpx;
  font-weight: 800;
  box-shadow: 0 0 0 5rpx rgba(255, 253, 250, 0.9);
}

.chapter-sprig-image {
  position: absolute;
  z-index: 0;
  right: -18rpx;
  top: -17rpx;
  width: 38rpx;
  height: 38rpx;
  pointer-events: none;
}

.chapter-node-number { position: relative; z-index: 1; }

.chapter-card {
  position: relative;
  min-height: 108rpx;
  padding: 20rpx 20rpx 20rpx 22rpx;
  border-radius: var(--ui-radius-card);
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 6rpx 12rpx;
  background: rgba(255, 253, 250, 0.96);
}

.chapter-copy { min-width: 0; }
.chapter-title, .chapter-meta { display: block; overflow-wrap: anywhere; }
.chapter-title { color: var(--ui-text-primary); font-family: var(--ui-font-editorial); font-size: 30rpx; font-weight: 800; line-height: 1.35; text-wrap: balance; }
.chapter-meta { margin-top: 5rpx; color: var(--ui-text-muted); font-size: 22rpx; line-height: 1.45; text-wrap: pretty; }

.chapter-status {
  grid-column: 1;
  justify-self: start;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: var(--ui-surface-subtle);
  color: var(--ui-text-secondary);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.35;
  white-space: nowrap;
}

.chapter-status.attention { background: var(--ui-accent-surface); color: var(--ui-accent-strong); }
.chapter-status.draft { background: var(--ui-warning-surface); color: var(--ui-warning-text); }

.chapter-chevron {
  grid-column: 2;
  grid-row: 1 / span 2;
  align-self: center;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-text-muted);
  font-size: 28rpx;
  transform: rotate(0deg);
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
}

.chapter-chevron.expanded { transform: rotate(180deg); }

.chapter-block.is-new-growth .chapter-card,
.section-row.is-new-growth {
  background: #fffaf0;
  box-shadow: 0 0 0 2rpx rgba(192, 154, 96, 0.18), 0 10rpx 24rpx rgba(117, 85, 55, 0.06);
}

.growth-label {
  display: inline-block;
  margin-top: 8rpx;
  padding: 2rpx 10rpx;
  border-radius: 9rpx;
  background: var(--ui-warning-surface);
  color: var(--ui-warning-text);
  font-size: 21rpx;
  line-height: 1.5;
}

.section-list {
  position: relative;
  margin: 10rpx 0 4rpx 14rpx;
  padding-left: 20rpx;
  border-left: 1rpx solid var(--ui-accent-border);
}

.chapter-reading-actions { display: flex; flex-wrap: wrap; gap: 4rpx 14rpx; }
.story-inline-action {
  display: flex;
  align-items: center;
  width: auto;
  min-height: 44px;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 14rpx;
  background: transparent;
  color: var(--ui-accent-strong);
  font-size: 25rpx;
  line-height: 1.5;
}
.story-inline-action.is-secondary { color: var(--ui-text-secondary); font-weight: 400; }

.section-row,
.chapter-media-row {
  position: relative;
  min-height: 88rpx;
  margin-bottom: 8rpx;
  padding: 15rpx 16rpx 15rpx 20rpx;
  border-radius: var(--ui-radius-inner);
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 253, 250, 0.76);
  box-shadow: 0 0 0 1rpx rgba(54, 42, 34, 0.035), 0 5rpx 14rpx rgba(63, 47, 37, 0.03);
}

.chapter-media-row { background: rgba(250, 247, 242, 0.9); }
.chapter-media-title { min-width: 0; flex: 1; color: var(--ui-text-secondary); font-size: 23rpx; font-weight: 700; }
.section-marker { position: absolute; left: -27rpx; top: 38rpx; width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--ui-surface); box-shadow: 0 0 0 4rpx var(--chapter-tone); }
.section-copy { min-width: 0; flex: 1; }
.section-title, .section-meta { display: block; overflow-wrap: anywhere; }
.section-title { color: var(--ui-text-primary); font-size: 26rpx; font-weight: 700; line-height: 1.35; text-wrap: balance; }
.section-meta { margin-top: 4rpx; color: var(--ui-text-muted); font-size: 21rpx; line-height: 1.4; }
.section-action { width: 26rpx; flex: 0 0 26rpx; color: var(--ui-text-muted); font-size: 30rpx; line-height: 1; text-align: center; }

.section-media { max-width: 188rpx; flex: 0 0 auto; display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 6rpx; }
.section-media-entry { min-width: 40px; min-height: 40px; padding: 0 8rpx; border-radius: var(--ui-radius-control); }
.media-chip { padding: 6rpx 10rpx; border-radius: 999rpx; font-size: 19rpx; font-weight: 700; line-height: 1.3; font-variant-numeric: tabular-nums; white-space: nowrap; }
.image-chip { color: #756147; background: var(--ui-warning-surface); }
.video-chip { color: #5f6973; background: #e7ecef; }

.unassigned-card {
  position: relative;
  z-index: 1;
  min-height: 104rpx;
  margin: 12rpx 2rpx 0 72rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--ui-radius-card);
  display: grid;
  grid-template-columns: 42rpx minmax(0, 1fr);
  align-items: start;
  gap: 6rpx 14rpx;
  background: rgba(250, 247, 242, 0.82);
  box-shadow: 0 0 0 2rpx var(--ui-border) inset;
}

.unassigned-mark { width: 42rpx; height: 42rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--ui-surface); color: var(--ui-accent-strong); font-size: 32rpx; }
.unassigned-copy, .unassigned-card .section-media-entry, .unassigned-action { grid-column: 2; }
.unassigned-copy { min-width: 0; }
.unassigned-title, .unassigned-meta, .unassigned-detail { display: block; }
.unassigned-title { color: var(--ui-text-primary); font-size: 26rpx; font-weight: 700; line-height: 1.35; }
.unassigned-meta, .unassigned-detail { margin-top: 4rpx; color: var(--ui-text-muted); font-size: 21rpx; line-height: 1.4; text-wrap: pretty; }
.unassigned-detail { color: #9b8f87; }
.unassigned-card .section-media-entry { justify-self: start; justify-content: flex-start; max-width: 100%; padding: 0; }
.unassigned-action { min-height: 40px; display: flex; align-items: center; color: var(--ui-accent-strong); font-size: 22rpx; font-weight: 700; }

.add-chapter-action {
  min-height: 88rpx;
  margin: 20rpx 2rpx 0 72rpx;
  padding: 0 22rpx;
  border-radius: var(--ui-radius-inner);
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--ui-accent-strong);
  font-size: 25rpx;
  font-weight: 700;
  background: rgba(255, 253, 250, 0.54);
  box-shadow: 0 0 0 2rpx var(--ui-accent-border) inset;
}
.add-chapter-mark { font-size: 32rpx; font-weight: 400; line-height: 1; }

.growth-arriving { animation: story-growth-arrive 650ms ease-out; }
@keyframes story-growth-arrive {
  from { opacity: 0.55; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@media (prefers-reduced-motion: reduce) { .growth-arriving { animation: none; } }

.large-text .timeline-label { font-size: 38rpx; }
.large-text .voice-edit-entry { font-size: 34rpx; }
.large-text .transcript-list-entry, .large-text .story-inline-action, .large-text .overview-readable { font-size: 30rpx; }
.large-text .overview-title, .large-text .unassigned-title { font-size: 34rpx; }
.large-text .chapter-title { font-size: 38rpx; }
.large-text .section-title { font-size: 32rpx; }
.large-text .overview-summary, .large-text .overview-outcome, .large-text .chapter-status { font-size: 26rpx; }
.large-text .chapter-meta, .large-text .section-meta, .large-text .unassigned-meta, .large-text .unassigned-detail, .large-text .growth-label { font-size: 27rpx; }
.large-text .media-chip { font-size: 25rpx; }
.large-text .unassigned-action { font-size: 30rpx; }
.large-text .section-row { flex-wrap: wrap; }
.large-text .section-copy { flex-basis: 100%; }
.large-text .section-action { margin-left: auto; }

@media (max-width: 360px) {
  .story-toolbar { flex-wrap: wrap; }
  .voice-edit-entry { margin-left: 0; }
  .transcript-list-entry { margin-left: auto; }
  .chapter-card { padding-right: 16rpx; }
  .section-row, .chapter-media-row { flex-wrap: wrap; }
  .section-copy, .chapter-media-title { flex-basis: 100%; }
  .section-action { margin-left: auto; }
}
