.voice-chat-page {
  --ui-fixed-action-space: 252rpx;
  --voice-overlay-bottom: 228rpx;
  padding-top: 34rpx;
  padding-right: 30rpx;
  padding-left: 30rpx;
}

.voice-chat-page.no-control-bar {
  --ui-fixed-action-space: 60rpx;
}

.top-bar {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.top-copy {
  min-width: 0;
}

.mode-label {
  display: block;
  color: var(--ui-text-primary);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 58rpx;
}

.top-subtitle {
  display: block;
  margin-top: 4rpx;
  color: var(--ui-text-secondary);
  font-size: 30rpx;
  line-height: 42rpx;
}

.topic-panel {
  margin-top: 18rpx;
  padding: 32rpx 34rpx;
  border: 0;
  border-radius: 30rpx;
  background: var(--ui-accent-surface-subtle);
  box-shadow: var(--ui-card-shadow);
}

.topic-kicker {
  display: block;
  color: var(--ui-text-secondary);
  font-size: 30rpx;
  line-height: 42rpx;
}

.topic-title {
  display: block;
  margin-top: 8rpx;
  color: var(--ui-text-primary);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 58rpx;
  word-break: break-word;
}

.story-growth-bubble {
  min-height: 100rpx;
  margin-top: 18rpx;
  padding: 18rpx 18rpx 18rpx 22rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #f5efe6;
  box-shadow: 0 0 0 1rpx rgba(135, 106, 83, 0.10);
}

.story-growth-bubble.ready {
  background: #f2f3e9;
  box-shadow: 0 0 0 1rpx rgba(118, 137, 100, 0.14);
}

.story-growth-mark {
  flex: 0 0 auto;
  width: 18rpx;
  height: 34rpx;
  border-radius: 12rpx 12rpx 12rpx 2rpx;
  background: #ad8a71;
  transform: rotate(28deg);
}

.story-growth-bubble.ready .story-growth-mark {
  background: #8da07c;
}

.story-growth-copy {
  min-width: 0;
  flex: 1;
}

.story-growth-title,
.story-growth-detail {
  display: block;
}

.story-growth-title {
  color: var(--ui-text-primary);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.story-growth-detail {
  margin-top: 3rpx;
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  line-height: 34rpx;
}

.story-growth-action {
  flex: 0 0 auto;
  width: auto;
  min-width: 112rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.76);
  color: var(--ui-section-title);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.large-text .story-growth-title {
  font-size: 36rpx;
  line-height: 1.45;
}

.large-text .story-growth-detail {
  font-size: 30rpx;
  line-height: 1.5;
}

.story-growth-action::after {
  border: 0;
}

.finish-button {
  width: 156rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: var(--ui-surface);
  color: var(--ui-section-title);
  font-size: 30rpx;
  font-weight: 600;
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.08),
    0 6rpx 18rpx rgba(0, 0, 0, 0.05);
}

.transcript-stage {
  min-height: 440rpx;
  margin-top: 28rpx;
  padding: 40rpx 34rpx;
  border: 0;
  border-radius: 32rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow-raised);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.voice-chat-page.human-interview .transcript-stage {
  justify-content: flex-start;
}

.voice-chat-page.human-recording-focus .transcript-stage {
  min-height: 900rpx;
  padding-top: 52rpx;
  padding-bottom: 40rpx;
}

.voice-chat-page.ai-recording-focus .transcript-stage {
  min-height: 820rpx;
  padding: 44rpx 36rpx;
  border-radius: 36rpx;
  justify-content: flex-start;
  box-shadow: var(--ui-card-shadow-raised);
}

.assistant-panel {
  margin-top: 24rpx;
  padding: 34rpx;
  border: 0;
  border-radius: 32rpx;
  background: var(--ui-accent-surface-subtle);
  box-shadow: var(--ui-card-shadow);
}

.completion-issue-panel {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  background: var(--ui-accent-surface-subtle);
  box-shadow: var(--ui-card-shadow);
}

.completion-issue-panel.complete-state {
  background: var(--ui-success-surface);
  box-shadow:
    0 0 0 1rpx rgba(94, 119, 88, 0.10),
    0 10rpx 26rpx rgba(94, 119, 88, 0.06);
}

.completion-issue-panel.error-state {
  background: var(--ui-danger-surface);
  box-shadow:
    0 0 0 1rpx rgba(182, 69, 69, 0.12),
    0 10rpx 26rpx rgba(182, 69, 69, 0.06);
}

.completion-issue-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.completion-issue-label,
.completion-issue-status {
  line-height: 38rpx;
}

.completion-issue-label {
  color: var(--ui-section-title);
  font-size: 28rpx;
  font-weight: 700;
}

.completion-issue-status {
  flex: 0 1 auto;
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  text-align: right;
}

.completion-issue-question,
.completion-issue-error,
.completion-issue-action-state {
  display: block;
  overflow-wrap: anywhere;
}

.completion-issue-question {
  margin-top: 18rpx;
  color: var(--ui-text-primary);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.42;
  text-wrap: balance;
}

.completion-issue-error {
  margin-top: 14rpx;
  color: var(--ui-danger-text);
  font-size: 26rpx;
  line-height: 40rpx;
}

.completion-issue-action-state {
  margin-top: 14rpx;
  color: var(--ui-section-title);
  font-size: 26rpx;
  line-height: 40rpx;
}

.completion-issue-actions {
  margin-top: 24rpx;
  display: flex;
  justify-content: flex-end;
}

.completion-issue-actions button,
.completion-issue-continue {
  min-height: 80rpx;
  margin: 0;
  padding: 12rpx 16rpx;
  border: 0;
  border-radius: 10rpx;
  background: var(--ui-surface);
  color: var(--ui-section-title);
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.09);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 38rpx;
  text-align: center;
  transition-property: transform, background-color, opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.voice-chat-page.book-completion .completion-issue-panel {
  padding: 22rpx 24rpx;
  border-left: 6rpx solid #bd7b6f;
  border-radius: 8rpx;
  background: var(--ui-surface);
  box-shadow: none;
}

.voice-chat-page.book-completion .completion-issue-question {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.voice-chat-page.book-completion .completion-issue-actions {
  margin-top: 18rpx;
}

.completion-issue-actions button::after,
.completion-issue-continue::after {
  border: 0;
}

.completion-issue-actions button:active,
.completion-issue-continue:active {
  transform: scale(0.96);
}

.completion-issue-actions button[disabled],
.completion-issue-continue[disabled] {
  opacity: 0.58;
  transform: none;
}

.completion-issue-actions button {
  min-width: 220rpx;
}

.completion-issue-continue {
  width: 100%;
  margin-top: 22rpx;
  background: var(--ui-accent);
  color: var(--ui-on-accent);
  box-shadow: none;
}

.assistant-head {
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.assistant-label {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--ui-surface-subtle);
  color: var(--ui-section-title);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 38rpx;
}

.assistant-text {
  display: block;
  margin-top: 22rpx;
  color: var(--ui-text-primary);
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.48;
  word-break: break-word;
}

.assistant-tts-text {
  display: block;
  margin-top: 22rpx;
  color: var(--ui-text-primary);
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.48;
  word-break: break-word;
}

.assistant-opening {
  margin-top: 18rpx;
}

.assistant-context {
  display: block;
  color: var(--ui-text-secondary);
  font-size: 30rpx;
  line-height: 1.55;
}

.assistant-question {
  display: block;
  margin-top: 18rpx;
  color: var(--ui-text-primary);
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.35;
}

.assistant-topic-options {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.assistant-topic-button {
  min-height: 80rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 999rpx;
  background: var(--ui-surface);
  color: var(--ui-section-title);
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.assistant-topic-button::after {
  border: 0;
}

.assistant-tts-spoken {
  color: var(--ui-accent);
}

.assistant-tts-current {
  margin: 0 2rpx;
  padding: 2rpx 6rpx;
  border-radius: 8rpx;
  background: var(--ui-accent);
  color: var(--ui-on-accent);
}

.tts-progress-track {
  margin-top: 18rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--ui-border);
  overflow: hidden;
}

.tts-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--ui-accent);
  transition: width 160ms ease;
}

.tts-error {
  display: block;
  margin-top: 16rpx;
  color: var(--ui-danger-text);
  font-size: 28rpx;
  line-height: 1.4;
}

.assistant-actions {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  flex-wrap: wrap;
}

.assistant-button {
  min-width: 180rpx;
  min-height: 86rpx;
  margin: 0;
  border: 0;
  border-radius: 24rpx;
  background: var(--ui-surface);
  color: var(--ui-section-title);
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 38rpx;
}

.assistant-button::after {
  border: 0;
}

.assistant-button[disabled] {
  opacity: 0.66;
}

.assistant-button.ghost {
  background: var(--ui-accent-surface);
  box-shadow: none;
  color: var(--ui-accent-strong);
}

.assistant-panel.error-state {
  background: var(--ui-danger-surface);
  box-shadow:
    0 0 0 1rpx rgba(182, 69, 69, 0.12),
    0 10rpx 26rpx rgba(182, 69, 69, 0.06);
}

.assistant-panel.error-state .assistant-label,
.assistant-panel.error-state .assistant-text {
  color: var(--ui-danger-text);
}

.stage-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--ui-surface-subtle);
  color: var(--ui-section-title);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.stage-status.error {
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
}

.stage-status.listening {
  background: var(--ui-accent-surface);
  color: var(--ui-accent);
}

.live-scroll {
  max-height: 300rpx;
  margin-top: 32rpx;
  overflow: hidden;
}

.voice-chat-page.human-interview .live-scroll {
  margin-top: 0;
}

.voice-chat-page.human-recording-focus .live-scroll,
.voice-chat-page.human-recording-focus .live-scroll.long {
  height: 650rpx;
  max-height: 650rpx;
}

.voice-chat-page.ai-recording-focus .live-scroll,
.voice-chat-page.ai-recording-focus .live-scroll.long {
  height: 620rpx;
  max-height: 620rpx;
}

.live-scroll.long {
  height: 300rpx;
}

.live-text {
  display: block;
  color: var(--ui-text-primary);
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.42;
  word-break: break-all;
  text-wrap: pretty;
}

.voice-chat-page.ai-recording-focus .live-text {
  font-size: 54rpx;
  line-height: 1.48;
}

.live-text.placeholder {
  color: var(--ui-text-muted);
  font-weight: 600;
}

.live-text-end {
  height: 2rpx;
}

.human-transcript-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: calc(var(--voice-overlay-bottom) + env(safe-area-inset-bottom));
  box-sizing: border-box;
  padding: 28rpx 30rpx 24rpx;
  background: rgba(247, 243, 236, 0.96);
  z-index: 24;
  display: flex;
}

.human-transcript-sheet {
  flex: 1 1 auto;
  min-height: 0;
  padding: 42rpx 38rpx 28rpx;
  border-radius: 34rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow-raised);
  display: flex;
  flex-direction: column;
}

.human-transcript-scroll {
  flex: 1 1 auto;
  min-height: 0;
  height: 100%;
  overflow: hidden;
}

.human-transcript-sheet .live-text {
  font-size: 58rpx;
  line-height: 1.45;
}

.human-transcript-footer {
  margin-top: 24rpx;
  min-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: var(--ui-accent-surface);
  color: var(--ui-accent);
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.human-transcript-footer .capture-dot {
  background: var(--ui-accent);
  box-shadow: 0 0 0 10rpx rgba(168, 79, 67, 0.12);
}

.human-transcript-level {
  margin-top: 18rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--ui-border);
  overflow: hidden;
}

.capture-strip {
  margin-top: 34rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: var(--ui-accent-surface);
  color: var(--ui-text-secondary);
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.voice-chat-page.human-recording-focus .capture-strip {
  margin-top: 26rpx;
}

.voice-chat-page.ai-recording-focus .capture-strip {
  margin-top: 30rpx;
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
}

.capture-strip.active {
  color: var(--ui-accent);
}

.capture-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: var(--ui-switch-off);
}

.capture-strip.active .capture-dot {
  background: var(--ui-accent);
  box-shadow: 0 0 0 10rpx rgba(168, 79, 67, 0.12);
}

.voice-activity {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.inline-help-button {
  align-self: flex-start;
  min-height: 80rpx;
  margin: 22rpx 0 0;
  border: 0;
  border-radius: 999rpx;
  background: var(--ui-accent-surface);
  color: var(--ui-accent-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.inline-help-button::after {
  border: 0;
}

.level-track {
  flex: 1 1 220rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: var(--ui-border);
  overflow: hidden;
}

.level-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--ui-accent);
  transition: width 120ms ease;
}

.auto-stop-text {
  color: var(--ui-section-title);
  font-size: 28rpx;
  font-weight: 800;
}

.auto-listen-text {
  color: var(--ui-accent);
  font-size: 28rpx;
  font-weight: 800;
}

.auto-stop-toggle {
  min-width: 92rpx;
  height: 56rpx;
  margin: 0;
  border: 0;
  border-radius: 16rpx;
  background: var(--ui-accent-surface);
  color: var(--ui-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 800;
}

.auto-stop-toggle::after {
  border: 0;
}

.history-panel {
  margin-top: 30rpx;
  padding: 12rpx;
  border: 0;
  border-radius: 24rpx;
  background: var(--ui-surface);
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.06),
    0 10rpx 26rpx rgba(0, 0, 0, 0.06);
}

.history-toggle {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  border: 0;
  border-radius: 18rpx;
  background: transparent;
  color: var(--ui-text-primary);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 14rpx 18rpx;
  text-align: left;
  transition-property: transform, background-color;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.history-toggle::after {
  border: 0;
}

.history-heading {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.history-count {
  color: var(--ui-text-muted);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 38rpx;
  font-variant-numeric: tabular-nums;
}

.history-toggle-text {
  flex: 0 0 auto;
  color: var(--ui-accent);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.history-lines {
  padding: 0 14rpx 14rpx;
}

.transcript-line {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-text-primary);
  font-size: 34rpx;
  line-height: 1.55;
}

.transcript-line.assistant {
  background: var(--ui-surface);
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.06);
}

.transcript-line.interviewer {
  background: #f4f7f8;
  color: #26353a;
  box-shadow: 0 0 0 1rpx rgba(38, 53, 58, 0.06);
}

.line-role {
  display: inline-flex;
  min-width: 70rpx;
  height: 42rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: var(--ui-accent);
  color: var(--ui-on-accent);
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.transcript-line.assistant .line-role {
  background: var(--ui-surface-subtle);
  color: var(--ui-text-secondary);
}

.transcript-line.interviewer .line-role {
  background: #57727b;
  color: var(--ui-on-accent);
}

.control-bar {
  --ui-fixed-action-top: 26rpx;
  --ui-fixed-action-bottom: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.human-record-panel {
  width: 100%;
  max-width: 660rpx;
  margin: 20rpx auto 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.role-record-button {
  box-sizing: border-box;
  min-height: 128rpx;
  margin: 0;
  border: 0;
  border-radius: 34rpx;
  background: var(--ui-accent-surface);
  color: var(--ui-accent);
  box-shadow:
    0 0 0 2rpx rgba(168, 79, 67, 0.14),
    0 12rpx 30rpx rgba(168, 79, 67, 0.10);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 18rpx 14rpx;
  transition-property: transform, background-color, box-shadow, color;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.role-record-button.interviewer {
  background: #f4f7f8;
  color: #57727b;
  box-shadow:
    0 0 0 2rpx rgba(87, 114, 123, 0.14),
    0 12rpx 30rpx rgba(87, 114, 123, 0.08);
}

.role-record-button::after {
  border: 0;
}

.role-record-button.disabled {
  opacity: 0.72;
}

.role-record-button:active {
  transform: scale(0.96);
