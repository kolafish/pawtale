.voice-chat-page {
  --ui-fixed-action-space: 370rpx;
  padding-top: 26rpx;
  padding-right: 30rpx;
  padding-left: 30rpx;
}

.voice-chat-page.no-control-bar {
  --ui-fixed-action-space: 60rpx;
}

.top-bar {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.top-copy {
  flex: 1;
  min-width: 0;
}

.home-return-button {
  width: 136rpx;
  min-width: 136rpx;
  height: 80rpx;
  margin: 0;
  padding: 0 12rpx 0 4rpx;
  flex: 0 0 136rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border: 0;
  border-radius: var(--ui-radius-control);
  background: transparent;
  color: var(--ui-text-secondary);
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1;
  white-space: nowrap;
}

.home-return-button::after {
  border: 0;
}

.home-return-mark {
  margin-top: -2rpx;
  color: var(--ui-section-title);
  font-size: 48rpx;
  font-weight: 400;
  line-height: 1;
}

.mode-label {
  display: block;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 38rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.top-subtitle {
  display: block;
  margin-top: 4rpx;
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  line-height: 38rpx;
}

.topic-panel {
  margin-top: 18rpx;
  min-height: 92rpx;
  padding: 16rpx 24rpx;
  border: 0;
  border-radius: var(--ui-radius-card);
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.topic-panel::before {
  content: none;
}

.topic-leaf {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  border-radius: 50%;
  background: #eef3e9;
  color: #718565;
  display: flex;
  align-items: center;
  justify-content: center;
}

.topic-leaf-shape {
  width: 23rpx;
  height: 16rpx;
  border-radius: 100% 0 100% 0;
  background: currentColor;
  transform: rotate(-34deg) translate(1rpx, -1rpx);
}

.topic-kicker {
  flex: 0 0 auto;
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.topic-title {
  min-width: 0;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 48rpx;
  word-break: break-word;
  text-wrap: balance;
}

.story-growth-bubble {
  min-height: 100rpx;
  margin-top: 18rpx;
  padding: 18rpx 18rpx 18rpx 22rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #f5efe6;
  box-shadow: 0 0 0 1rpx rgba(135, 106, 83, 0.10);
}

.story-growth-bubble.ready {
  background: #f2f3e9;
  box-shadow: 0 0 0 1rpx rgba(118, 137, 100, 0.14);
}

.story-growth-mark {
  flex: 0 0 auto;
  width: 18rpx;
  height: 34rpx;
  border-radius: 12rpx 12rpx 12rpx 2rpx;
  background: #ad8a71;
  transform: rotate(28deg);
}

.story-growth-bubble.ready .story-growth-mark {
  background: #8da07c;
}

.story-growth-copy {
  min-width: 0;
  flex: 1;
}

.story-growth-title,
.story-growth-detail {
  display: block;
}

.story-growth-title {
  color: var(--ui-text-primary);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.story-growth-detail {
  margin-top: 3rpx;
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  line-height: 34rpx;
}

.story-growth-action {
  flex: 0 0 auto;
  width: auto;
  min-width: 112rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.76);
  color: var(--ui-section-title);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.large-text .story-growth-title {
  font-size: 36rpx;
  line-height: 1.45;
}

.large-text .story-growth-detail {
  font-size: 30rpx;
  line-height: 1.5;
}

.story-growth-action::after {
  border: 0;
}

.finish-button {
  width: 160rpx;
  min-width: 160rpx;
  height: 80rpx;
  margin: 0;
  padding: 0 12rpx;
  flex: 0 0 160rpx;
  white-space: nowrap;
  border-radius: var(--ui-radius-control);
  background: transparent;
  color: var(--ui-section-title);
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 0 0 1rpx var(--ui-accent-border) inset;
}

.transcript-stage {
  min-height: 520rpx;
  margin-top: 22rpx;
  padding: 34rpx;
  border: 0;
  border-radius: var(--ui-radius-card);
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.voice-chat-page.human-interview .transcript-stage {
  justify-content: flex-start;
}

.voice-chat-page.human-recording-focus .transcript-stage {
  min-height: 900rpx;
  padding-top: 52rpx;
  padding-bottom: 40rpx;
}

.voice-chat-page.ai-recording-focus .transcript-stage {
  min-height: 500rpx;
  padding: 34rpx 36rpx;
  border-radius: 36rpx;
  justify-content: flex-start;
  box-shadow: var(--ui-card-shadow-raised);
}

.assistant-panel {
  margin-top: 22rpx;
  padding: 30rpx 32rpx 32rpx;
  border: 0;
  border-radius: 34rpx;
  background: var(--ui-accent-surface-subtle);
  box-shadow: var(--ui-card-shadow-raised);
}

.completion-issue-panel {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  background: var(--ui-accent-surface-subtle);
  box-shadow: var(--ui-card-shadow);
}

.completion-issue-panel.complete-state {
  background: var(--ui-success-surface);
  box-shadow:
    0 0 0 1rpx rgba(94, 119, 88, 0.10),
    0 10rpx 26rpx rgba(94, 119, 88, 0.06);
}

.completion-issue-panel.error-state {
  background: var(--ui-danger-surface);
  box-shadow:
    0 0 0 1rpx rgba(182, 69, 69, 0.12),
    0 10rpx 26rpx rgba(182, 69, 69, 0.06);
}

.completion-issue-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.completion-issue-label,
.completion-issue-status {
  line-height: 38rpx;
}

.completion-issue-label {
  color: var(--ui-section-title);
  font-size: 28rpx;
  font-weight: 700;
}

.completion-issue-status {
  flex: 0 1 auto;
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  text-align: right;
}

.completion-issue-question,
.completion-issue-error,
.completion-issue-action-state {
  display: block;
  overflow-wrap: anywhere;
}

.completion-issue-question {
  margin-top: 18rpx;
  color: var(--ui-text-primary);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.42;
  text-wrap: balance;
}

.completion-issue-error {
  margin-top: 14rpx;
  color: var(--ui-danger-text);
  font-size: 26rpx;
  line-height: 40rpx;
}

.completion-issue-action-state {
  margin-top: 14rpx;
  color: var(--ui-section-title);
  font-size: 26rpx;
  line-height: 40rpx;
}

.completion-issue-actions {
  margin-top: 24rpx;
  display: flex;
  justify-content: flex-end;
}

.completion-issue-defer,
.completion-issue-continue {
  min-height: 88rpx;
  margin: 0;
  padding: 12rpx 16rpx;
  border: 0;
  border-radius: 10rpx;
  background: var(--ui-surface);
  color: var(--ui-section-title);
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.09);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 38rpx;
  text-align: center;
  transition-property: transform, background-color, opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.voice-chat-page.book-completion .completion-issue-panel {
  padding: 22rpx 24rpx;
  border-left: 6rpx solid #bd7b6f;
  border-radius: 8rpx;
  background: var(--ui-surface);
  box-shadow: none;
}

.voice-chat-page.book-completion .completion-issue-question {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.voice-chat-page.book-completion .completion-issue-actions {
  margin-top: 18rpx;
}

.completion-issue-defer::after,
.completion-issue-continue::after {
  border: 0;
}

.completion-issue-defer:active,
.completion-issue-continue:active {
  transform: scale(0.96);
}

.completion-issue-defer.is-disabled,
.completion-issue-continue.is-disabled {
  opacity: 0.58;
  transform: none;
}

.completion-issue-defer {
  min-width: 220rpx;
}

.completion-issue-continue {
  width: 100%;
  margin-top: 22rpx;
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
}

.assistant-head {
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.assistant-label {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--ui-surface-subtle);
  color: var(--ui-section-title);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 38rpx;
}

.assistant-text,
.assistant-tts-text {
  display: block;
  margin-top: 22rpx;
  color: var(--ui-text-primary);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.48;
  word-break: break-word;
  text-wrap: pretty;
}

.assistant-opening {
  margin-top: 18rpx;
}

.assistant-context {
  display: block;
  color: var(--ui-text-secondary);
  font-size: 28rpx;
  line-height: 1.55;
  text-wrap: pretty;
}

.assistant-question {
  display: block;
  margin-top: 18rpx;
  color: var(--ui-text-primary);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.42;
  text-wrap: balance;
}

.assistant-topic-options {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.voice-chat-page .assistant-topic-button {
  width: 184rpx;
  min-width: 0;
  min-height: 80rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 999rpx;
  background: var(--ui-surface);
  color: var(--ui-section-title);
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.assistant-topic-button::after {
  border: 0;
}

.assistant-tts-spoken {
  color: var(--ui-accent);
}

.assistant-tts-current {
  margin: 0 2rpx;
  padding: 2rpx 6rpx;
  border-radius: 8rpx;
  background: var(--ui-accent);
  color: var(--ui-on-accent);
}

.tts-progress-track {
  margin-top: 18rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--ui-border);
  overflow: hidden;
}

.tts-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--ui-accent);
  transition: width 160ms ease;
}

.tts-error {
  display: block;
  margin-top: 16rpx;
  color: var(--ui-danger-text);
  font-size: 28rpx;
  line-height: 1.4;
}

.assistant-actions {
  width: 100%;
  margin-top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  flex-wrap: nowrap;
}

.voice-chat-page .assistant-button {
  width: auto;
  min-width: 190rpx;
  max-width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 999rpx;
  background: var(--ui-surface);
  color: var(--ui-section-title);
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 38rpx;
  white-space: nowrap;
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.assistant-button::after {
  border: 0;
}

.voice-chat-page .assistant-button.is-disabled {
  opacity: 0.66;
}

.voice-chat-page .assistant-button:active {
  transform: scale(0.96);
}

.voice-chat-page .assistant-button.is-disabled:active {
  transform: none;
}

.voice-chat-page .assistant-button.ghost {
  background: transparent;
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.08);
  color: var(--ui-accent-strong);
}

.assistant-panel.error-state {
  background: var(--ui-danger-surface);
  box-shadow:
    0 0 0 1rpx rgba(182, 69, 69, 0.12),
    0 10rpx 26rpx rgba(182, 69, 69, 0.06);
}

.assistant-panel.error-state .assistant-label,
.assistant-panel.error-state .assistant-text {
  color: var(--ui-danger-text);
}

.stage-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--ui-surface-subtle);
  color: var(--ui-section-title);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.stage-status.error {
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
}

.stage-status.listening {
  background: var(--ui-accent-surface);
  color: var(--ui-accent);
}

.transcript-stage-head {
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 14rpx 20rpx;
}

.capture-summary {
  min-height: 54rpx;
  margin-left: auto;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--ui-surface-subtle);
  color: var(--ui-text-secondary);
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 36rpx;
  font-variant-numeric: tabular-nums;
}

.capture-summary .capture-dot {
  width: 12rpx;
  height: 12rpx;
  background: var(--ui-accent);
  box-shadow: 0 0 0 7rpx rgba(168, 79, 67, 0.10);
}

.live-caption-shell {
  position: relative;
  min-height: 0;
  margin-top: 24rpx;
}

.live-scroll {
  max-height: 300rpx;
  overflow: hidden;
}

.voice-chat-page.human-recording-focus .live-scroll,
.voice-chat-page.human-recording-focus .live-scroll.long {
  height: 650rpx;
  max-height: 650rpx;
}

.voice-chat-page.ai-recording-focus .live-scroll,
.voice-chat-page.ai-recording-focus .live-scroll.long {
  height: 360rpx;
  max-height: 360rpx;
}

.live-scroll.long {
  height: 300rpx;
}

.live-text {
  display: block;
  color: var(--ui-text-primary);
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.42;
  word-break: break-all;
  text-wrap: pretty;
}

.live-text-context {
  display: block;
  padding-bottom: 18rpx;
  color: var(--ui-text-secondary);
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1.55;
  word-break: break-all;
}

.live-text-current {
  display: block;
}

.voice-chat-page.ai-recording-focus .live-text-current {
  font-size: 52rpx;
  line-height: 1.48;
}

.live-text.placeholder {
  color: var(--ui-text-muted);
  font-weight: 600;
}

.live-text-end {
  height: 24rpx;
}

.voice-chat-page.ai-recording-focus .live-text-end,
.voice-chat-page.human-recording-focus .live-text-end,
.live-scroll.reviewing .live-text-end {
  height: 120rpx;
}

.live-caption-top-fade {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 1;
  height: 62rpx;
  pointer-events: none;
  background: linear-gradient(180deg, var(--ui-surface), rgba(255, 253, 250, 0));
  opacity: 1;
  transition-property: opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.live-caption-shell.reviewing .live-caption-top-fade {
  opacity: 0;
}

.return-to-latest {
  flex: 0 0 auto;
  width: auto;
  min-width: 184rpx;
  min-height: 80rpx;
  margin: 0 0 0 auto;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 250, 0.96);
  color: var(--ui-accent-strong);
  box-shadow:
    0 0 0 1rpx rgba(54, 42, 34, 0.07),
    0 8rpx 22rpx rgba(63, 47, 37, 0.11);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.return-to-latest:active {
  transform: scale(0.96);
}

.capture-strip {
  margin-top: 34rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: var(--ui-accent-surface);
  color: var(--ui-text-secondary);
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.voice-chat-page.human-recording-focus .capture-strip {
  margin-top: 26rpx;
}

.voice-chat-page.ai-recording-focus .capture-strip {
  margin-top: 30rpx;
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
}

.capture-strip.active {
  color: var(--ui-accent);
}

.capture-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: var(--ui-switch-off);
}

.capture-strip.active .capture-dot {
  background: var(--ui-accent);
  box-shadow: 0 0 0 10rpx rgba(168, 79, 67, 0.12);
}

.voice-activity {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.inline-help-button {
  align-self: flex-start;
  min-width: 232rpx;
  min-height: 88rpx;
  margin: 20rpx 0 0;
  border: 0;
  border-radius: 999rpx;
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  box-shadow: var(--ui-control-shadow);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  font-size: 28rpx;
  font-weight: 700;
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.inline-help-button::after {
  border: 0;
}

.inline-help-button:active {
  transform: scale(0.96);
}

.level-track {
  flex: 1 1 220rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: var(--ui-border);
  overflow: hidden;
}

.level-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--ui-accent);
  transition: width 120ms ease;
}

.history-panel {
  margin-top: 30rpx;
  padding: 12rpx;
  border: 0;
  border-radius: 24rpx;
  background: var(--ui-surface);
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.06),
    0 10rpx 26rpx rgba(0, 0, 0, 0.06);
}

.history-toggle {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  border: 0;
  border-radius: 18rpx;
  background: transparent;
  color: var(--ui-text-primary);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 14rpx 18rpx;
  text-align: left;
  transition-property: transform, background-color;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.history-toggle::after {
  border: 0;
}

.history-heading {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.history-count {
  color: var(--ui-text-muted);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 38rpx;
  font-variant-numeric: tabular-nums;
}

.history-toggle-text {
  flex: 0 0 auto;
  color: var(--ui-accent);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.history-lines {
  padding: 0 14rpx 14rpx;
}

.transcript-line {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-text-primary);
  font-size: 34rpx;
  line-height: 1.55;
