<view class="ui-page-shell ui-fixed-action-page {{voiceChatPageClass}} {{embedded ? 'voice-session-embedded' : ''}}">
  <view class="top-bar">
    <button
      wx:if="{{embedded}}"
      id="voice-home-action"
      class="home-return-button ui-button"
      disabled="{{finishingSession}}"
      bindtap="returnToHome"
      aria-label="结束讲述并返回首页"
    >
      <text class="home-return-mark" aria-hidden="true">‹</text>
      <text>首页</text>
    </button>
    <view class="top-copy">
      <text class="mode-label">{{topModeLabel}}</text>
      <text class="top-subtitle">{{topSubtitle}}</text>
    </view>
    <button
      id="voice-finish-action"
      class="finish-button ui-button"
      loading="{{finishingSession}}"
      disabled="{{finishingSession}}"
      bindtap="finishSession"
    >
      {{embedded && !finishingSession ? '结束讲述' : finishButtonText}}
    </button>
  </view>

  <view class="topic-panel">
    <view class="topic-leaf" aria-hidden="true"><view class="topic-leaf-shape"></view></view>
    <text class="topic-kicker">正在聊</text>
    <text class="topic-title">{{topicTitleText}}</text>
  </view>

  <view
    wx:if="{{!embedded && (progressNoticeTitle || storyGrowthNoticeState !== 'hidden')}}"
    class="story-growth-bubble {{progressNoticeTitle ? 'ready' : storyGrowthNoticeState}}"
    aria-live="polite"
  >
    <view class="story-growth-mark" aria-hidden="true"></view>
    <view class="story-growth-copy">
      <text class="story-growth-title">{{progressNoticeTitle || storyGrowthNoticeTitle}}</text>
      <text class="story-growth-detail">{{progressNoticeTitle ? progressNoticeDetail : storyGrowthNoticeDetail}}</text>
    </view>
    <button size="mini" class="story-growth-action" bindtap="handleStoryGrowthNoticeAction">
      {{progressNoticeTitle ? '查看故事' : storyGrowthNoticeActionText}}
    </button>
  </view>

  <view wx:if="{{showHumanRecordActions}}" class="human-record-panel">
    <view
      class="{{interviewerRecordButtonClass}}"
      data-role="interviewer"
      bindtap="startRecordingAsSpeaker"
      aria-role="button"
      aria-disabled="{{micButtonDisabled}}"
    >
      <view class="role-record-icon-shell">
        <image class="role-record-icon" src="/assets/memoir-microphone.png" mode="aspectFit" />
      </view>
      <text class="role-record-text">记录采访者</text>
    </view>
    <view
      class="{{narratorRecordButtonClass}}"
      data-role="narrator"
      bindtap="startRecordingAsSpeaker"
      aria-role="button"
      aria-disabled="{{micButtonDisabled}}"
    >
      <view class="role-record-icon-shell">
        <image class="role-record-icon" src="/assets/memoir-microphone.png" mode="aspectFit" />
      </view>
      <text class="role-record-text">记录被访者</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="error ui-error-banner">{{error}}</view>
  <view wx:if="{{showErrorKindStrip}}" class="session-state-strip">
    <text class="session-state-error">{{errorKindText}}</text>
  </view>
  <view wx:if="{{showRecoveryPanel}}" class="recovery-panel">
    <text wx:if="{{recoveryNotice}}" class="recovery-text">{{recoveryNotice}}</text>
    <view wx:if="{{showRecoveryActions}}" class="recovery-actions">
      <button wx:if="{{canReconnect}}" class="recovery-button ui-button" bindtap="reconnectGateway">重新连接</button>
      <button wx:if="{{canFinishAfterDisconnect}}" class="recovery-button ui-button ghost" bindtap="finishAfterDisconnect">查看讲述记录</button>
    </view>
  </view>

  <view wx:if="{{showVoiceAuthorizationPanel}}" class="voice-auth-panel">
    <text class="voice-auth-title">开始录音前需要声纹授权</text>
    <text class="voice-auth-desc">同意后才会打开麦克风，语音会用于实时识别文字、小余语音回应、原始音频留存和回忆录成书。</text>
    <checkbox-group bindchange="changeVoiceAuthorization">
      <view class="voice-auth-row ui-consent-row">
        <label class="ui-consent-choice">
          <checkbox
            value="voice_authorization"
            checked="{{voiceAuthorizationAgreed}}"
            color="#b65d49"
          />
          <text class="voice-auth-copy">我已阅读并同意</text>
        </label>
        <view
          class="voice-auth-link ui-consent-link ui-pressable"
          catchtap="openVoiceAuthorization"
          hover-class="ui-subtle-action-hover"
          aria-role="button"
          aria-label="查看声纹授权协议"
        >《声纹授权协议》</view>
      </view>
    </checkbox-group>
  </view>

  <view wx:if="{{showCompletionIssuePanel}}" class="{{completionIssuePanelClass}}">
    <view class="completion-issue-head">
      <text class="completion-issue-label">本次只补这一点</text>
      <text class="completion-issue-status">{{completionIssueStatusText}}</text>
    </view>
    <text class="completion-issue-question">{{completionIssueQuestionText}}</text>
    <text wx:if="{{completionIssueError}}" class="completion-issue-error">{{completionIssueError}}</text>
    <text wx:if="{{completionIssueActionText}}" class="completion-issue-action-state">{{completionIssueActionText}}</text>
    <view wx:if="{{showCompletionIssueActions}}" class="completion-issue-actions">
      <button
        class="completion-issue-defer ui-button ui-pressable {{completionIssueControlsDisabled ? 'is-disabled' : ''}}"
        disabled="{{completionIssueControlsDisabled}}"
        bindtap="chooseCompletionIssueResolution"
      >暂时不补</button>
    </view>
    <view
      wx:if="{{showCompletionIssueContinue}}"
      class="completion-issue-continue ui-block-action ui-pressable {{completionIssueControlsDisabled ? 'is-disabled' : ''}}"
      aria-role="button"
      aria-disabled="{{completionIssueControlsDisabled}}"
      bindtap="finishCompletionRound"
    >
      返回全书概览
    </view>
  </view>

  <view wx:if="{{showAssistantPanel}}" class="{{assistantPanelClass}}">
    <view class="assistant-head">
      <text class="assistant-label">{{assistantLabelText}}</text>
    </view>
    <view wx:if="{{showAssistantOpening}}" class="assistant-opening">
      <text class="assistant-context">今天可以接着讲，也可以换个方向。想不起来也没关系。</text>
      <text class="assistant-question">{{assistantQuestionText}}</text>
      <view class="assistant-topic-options">
        <button
          wx:for="{{openingTopicOptions}}"
          wx:key="id"
          class="assistant-topic-button"
          data-prompt-text="{{item.promptText}}"
          bindtap="chooseOpeningTopic"
        >
          {{item.label}}
        </button>
      </view>
    </view>
    <text wx:elif="{{showSelectedOpeningTopic}}" class="assistant-text">{{selectedOpeningTopicText}}</text>
    <view wx:elif="{{showAssistantTTS}}" class="assistant-tts-text">
      <text class="assistant-tts-spoken">{{ttsSpokenText}}</text>
      <text class="assistant-tts-current">{{ttsCurrentText}}</text>
      <text>{{ttsRemainingText}}</text>
    </view>
    <text wx:else class="assistant-text">{{assistantDisplayText}}</text>
    <view wx:if="{{showTTSProgress}}" class="tts-progress-track">
      <view class="tts-progress-fill" style="width: {{ttsProgressPercent}}%;"></view>
    </view>
    <text wx:if="{{followUpTTSError}}" class="tts-error">{{followUpTTSError}}</text>
  </view>

  <button
    wx:if="{{showInlineHelp}}"
    class="inline-help-button"
    loading="{{followUpLoading}}"
    disabled="{{followUpLoading}}"
    bindtap="stopAndAskFollowUp"
  >
    让小余问一句
  </button>

  <view wx:if="{{showTranscriptStage}}" class="transcript-stage">
    <view class="transcript-stage-head">
      <text wx:if="{{showStageStatus}}" class="{{stageStatusClass}}">
        {{stageStatusText}}
      </text>
      <view wx:if="{{recording}}" class="capture-summary">
        <view class="capture-dot"></view>
        <text>已说 {{captureDurationText}}</text>
        <text wx:if="{{showLiveCharCount}}">· {{liveCharCount}} 字</text>
      </view>
      <button
        wx:if="{{showReturnToLatest}}"
        class="return-to-latest ui-button"
        bindtap="resumeLiveTranscriptFollow"
        aria-label="{{returnToLatestText}}"
      >{{returnToLatestText}}</button>
    </view>
    <view class="live-caption-shell {{liveTranscriptFollowing ? '' : 'reviewing'}}">
      <scroll-view
        class="{{liveScrollClass}}"
        scroll-y="{{true}}"
        scroll-top="{{liveScrollTop}}"
        scroll-into-view="{{liveScrollTarget}}"
        scroll-with-animation="{{false}}"
        lower-threshold="32"
        bindtouchstart="pauseLiveTranscriptFollow"
        bindscrolltolower="resumeLiveTranscriptFollow"
      >
        <text class="{{liveTextClass}} live-text-current">{{liveCurrentText}}</text>
        <view id="{{liveTextEndId}}" class="live-text-end"></view>
      </scroll-view>
    </view>
    <view wx:if="{{showCaptureStrip && !recording}}" class="{{captureStripClass}}">
      <view class="capture-dot"></view>
      <text>说完后点“说完了”，我会帮您整理成文字。</text>
    </view>
    <view wx:if="{{recording}}" class="voice-activity">
      <view class="level-track">
        <view class="level-fill" style="width: {{audioLevelPercent}}%;"></view>
      </view>
    </view>
  </view>

  <view wx:if="{{showHistoryPanel}}" class="history-panel">
    <view
      class="history-toggle"
      bindtap="toggleHistory"
      hover-class="ui-subtle-action-hover"
      aria-role="button"
      aria-expanded="{{historyExpanded}}"
      aria-label="{{historyToggleText}}已保存的讲述"
    >
      <view class="history-heading">
        <text class="history-saved-check" aria-hidden="true">✓</text>
        <text class="history-saved-label">已保存</text>
        <text class="history-count">{{historyCountText}}</text>
      </view>
      <view class="history-toggle-action">
        <text class="history-toggle-text">{{historyToggleText}}</text>
        <text class="history-toggle-mark" aria-hidden="true">{{historyExpanded ? '⌃' : '›'}}</text>
      </view>
    </view>
    <view wx:if="{{showHistoryLines}}" class="history-lines">
      <view wx:for="{{transcriptLineViews}}" wx:key="id" class="{{item.lineClass}}">
        <text class="line-role">{{item.roleText}}</text>
        <text>{{item.text}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showControlBar}}" class="control-bar ui-fixed-action-dock">
    <text class="control-hint {{controlHintText ? '' : 'is-empty'}}">{{controlHintText || ' '}}</text>
    <view
      id="voice-primary-action"
      class="{{micButtonClass}}"
      bindtap="toggleRecording"
      aria-role="button"
      aria-disabled="{{micButtonDisabled}}"
      aria-label="{{micButtonText}}"
    >
      <view class="mic-icon-shell">
        <image class="mic-icon" src="/assets/memoir-microphone.png" mode="aspectFit" />
        <view class="mic-processing-indicator" aria-hidden="true">
          <view class="mic-processing-spinner"></view>
        </view>
      </view>
      <text class="mic-button-text">{{micButtonText}}</text>
    </view>
    <view class="assistant-actions-slot">
      <view wx:if="{{showAssistantActions}}" class="assistant-actions">
        <button
          wx:if="{{assistantPromptText}}"
          class="assistant-button ghost {{followUpTTSLoading ? 'is-disabled' : ''}}"
          loading="{{followUpTTSLoading}}"
          disabled="{{followUpTTSLoading}}"
          bindtap="playFollowUpAudio"
        >
          {{replayButtonText}}
        </button>
        <button
          class="assistant-button {{followUpLoading ? 'is-disabled' : ''}}"
          loading="{{followUpLoading}}"
          disabled="{{followUpLoading}}"
          bindtap="regenerateFollowUp"
        >
          {{followUpButtonText}}
        </button>
      </view>
    </view>
  </view>

</view>
