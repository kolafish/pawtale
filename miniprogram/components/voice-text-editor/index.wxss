.voice-text-input,
.voice-text-hint,
.voice-text-error {
  display: block;
  overflow-wrap: anywhere;
}

.voice-text-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 176rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: var(--ui-surface);
  color: var(--ui-text-primary);
  box-shadow: var(--ui-control-shadow);
  font-size: 27rpx;
  line-height: 42rpx;
}

.voice-text-hint,
.voice-text-error {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 34rpx;
}

.voice-text-hint {
  color: var(--ui-text-secondary);
}

.voice-text-error {
  color: var(--ui-danger-text);
}

.voice-text-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
  gap: 14rpx;
  margin-top: 14rpx;
}

.voice-action,
.submit-action,
.cancel-action {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.voice-action,
.cancel-action {
  background: var(--ui-surface);
  color: var(--ui-text-secondary);
  box-shadow: var(--ui-control-shadow);
}

.submit-action {
  background: var(--ui-accent);
  color: var(--ui-on-accent);
}

.cancel-action {
  margin-top: 12rpx;
}

.voice-action.recording {
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
}

.is-disabled {
  opacity: 0.48;
}

.voice-action:active,
.submit-action:active,
.cancel-action:active {
  transform: scale(0.96);
}
