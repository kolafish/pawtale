.voice-text-input,
.voice-text-hint,
.voice-text-error {
  display: block;
  overflow-wrap: anywhere;
}

.voice-text-status {
  min-height: 64rpx;
  margin-top: 12rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-radius: 12rpx;
  background: var(--ui-success-surface);
  color: var(--ui-success-text);
  font-size: var(--ui-font-caption);
  line-height: 1.5;
}

.voice-text-status-dot {
  width: 12rpx;
  height: 12rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: currentColor;
}

.voice-text-status.stopping {
  color: var(--ui-text-secondary);
}

.voice-text-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 176rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
  color: var(--ui-text-primary);
  box-shadow: var(--ui-control-shadow);
  font-size: var(--ui-font-body);
  line-height: 1.5;
}

.voice-text-hint,
.voice-text-error {
  margin-top: 8rpx;
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
}

.voice-text-hint {
  color: var(--ui-text-secondary);
}

.voice-text-error {
  color: var(--ui-danger-text);
}

.voice-text-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.voice-action,
.submit-action,
.cancel-action {
  min-height: 96rpx;
  min-width: 0;
  padding: 12rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-control);
  font-size: var(--ui-font-action);
  font-weight: 700;
  text-align: center;
  line-height: 1.5;
  white-space: normal;
  overflow-wrap: anywhere;
}

.voice-action {
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  box-shadow: inset 0 0 0 2rpx var(--ui-accent-border);
}

.submit-action {
  background: var(--ui-accent);
  color: var(--ui-on-accent);
  box-shadow: 0 10rpx 24rpx rgba(148, 69, 53, 0.18);
}

.cancel-action {
  margin-top: 12rpx;
  background: transparent;
  color: var(--ui-text-secondary);
}

.voice-action.recording {
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
  box-shadow: inset 0 0 0 2rpx currentColor;
}

.is-disabled {
  opacity: 0.48;
}

.voice-action:active,
.submit-action:active,
.cancel-action:active {
  transform: scale(0.96);
}
