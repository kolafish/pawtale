.voice-text-input,
.voice-text-hint,
.voice-text-error {
  display: block;
  overflow-wrap: anywhere;
}

.voice-text-status {
  min-height: 64rpx;
  margin-top: 12rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-radius: 12rpx;
  background: var(--ui-success-surface);
  color: var(--ui-success-text);
  font-size: var(--ui-font-caption);
  line-height: 34rpx;
}

.voice-text-status-dot {
  width: 12rpx;
  height: 12rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: currentColor;
}

.voice-text-status.stopping {
  color: var(--ui-text-secondary);
}

.voice-text-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 176rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
  color: var(--ui-text-primary);
  box-shadow: var(--ui-control-shadow);
  font-size: var(--ui-font-body);
  line-height: 42rpx;
}

.voice-text-hint,
.voice-text-error {
  margin-top: 8rpx;
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
}

.voice-text-hint {
  color: var(--ui-text-secondary);
}

.voice-text-error {
  color: var(--ui-danger-text);
}

.voice-text-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10rpx;
  margin-top: 14rpx;
}

.voice-action,
.submit-action,
.cancel-action {
  position: relative;
  min-height: 88rpx;
  padding: 0 54rpx 0 58rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  border-radius: var(--ui-radius-control);
  font-size: var(--ui-font-action);
  font-weight: 700;
}

.voice-action,
.cancel-action {
  background: var(--ui-surface-soft);
  color: var(--ui-text-secondary);
}

.submit-action {
  background: var(--ui-surface);
  color: var(--ui-text-primary);
  box-shadow: var(--ui-card-shadow);
}

.cancel-action {
  margin-top: 12rpx;
}

.voice-action.recording {
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
}

.voice-action::before,
.submit-action::before {
  content: "";
  position: absolute;
  left: 24rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--ui-text-muted);
}

.submit-action::before {
  background: var(--ui-accent);
  box-shadow: 0 0 0 8rpx var(--ui-accent-surface);
}

.voice-action.recording::before {
  background: var(--ui-danger-text);
}

.voice-action::after,
.submit-action::after {
  content: "›";
  position: absolute;
  right: 22rpx;
  color: var(--ui-text-muted);
  font-size: 36rpx;
  font-weight: 300;
}

.is-disabled {
  opacity: 0.48;
}

.voice-action:active,
.submit-action:active,
.cancel-action:active {
  transform: scale(0.96);
}
