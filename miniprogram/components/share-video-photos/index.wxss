.photo-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx -6rpx 0;
}

.photo-cell {
  position: relative;
  box-sizing: border-box;
  width: calc(25% - 12rpx);
  height: 0;
  margin: 6rpx;
  padding-bottom: calc(25% - 12rpx);
  border-radius: 14rpx;
  overflow: hidden;
  background: var(--ui-surface-subtle);
}

.photo-cell.dragging {
  transform: scale(1.08);
  box-shadow: 0 8rpx 24rpx rgba(48, 41, 37, 0.25);
  z-index: 2;
}

.photo-cell.chosen {
  outline: 4rpx solid var(--ui-accent);
  outline-offset: -4rpx;
}

.photo-image {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.photo-placeholder {
  background: var(--ui-surface-subtle);
}

.photo-order {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: var(--ui-accent);
  color: var(--ui-on-accent);
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}

.photo-remove {
  position: absolute;
  right: 0;
  top: 0;
  width: 52rpx;
  height: 52rpx;
  background: rgba(48, 41, 37, 0.55);
  border-bottom-left-radius: 14rpx;
  color: #ffffff;
  font-size: 34rpx;
  line-height: 50rpx;
  text-align: center;
}

.photo-add {
  border: 2rpx dashed var(--ui-accent-border);
  background: var(--ui-surface);
}

.photo-add.disabled {
  opacity: 0.5;
}

.photo-add-mark,
.photo-add-label {
  position: absolute;
  left: 0;
  right: 0;
  color: var(--ui-accent-strong);
  text-align: center;
}

.photo-add-mark {
  top: 22%;
  font-size: 44rpx;
}

.photo-add-label {
  top: 58%;
  font-size: 24rpx;
}

.photo-status {
  display: block;
  margin-top: 12rpx;
  color: var(--ui-section-title);
  font-size: var(--ui-font-meta);
  line-height: 1.5;
}

.photo-status.muted {
  color: var(--ui-text-secondary);
}

.photo-status.warning {
  color: var(--ui-danger-text);
}

.picker-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.4);
}

.picker-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  padding: 20rpx 26rpx calc(20rpx + env(safe-area-inset-bottom));
  border-radius: var(--ui-radius-card) var(--ui-radius-card) 0 0;
  background: var(--ui-surface);
}

.picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-title {
  color: var(--ui-text-primary);
  font-size: var(--ui-font-body);
  font-weight: 700;
}

.picker-body {
  height: 60vh;
}
