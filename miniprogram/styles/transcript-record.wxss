.detail-page {
  padding: 28rpx var(--ui-page-inline) 120rpx;
}

.error {
  margin-bottom: 24rpx;
}

.empty-panel,
.hero-panel,
.section-card {
  margin-top: 24rpx;
  border-radius: var(--ui-radius-card);
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow);
  overflow: hidden;
}

.empty-panel {
  padding: 48rpx 34rpx;
  color: var(--ui-text-secondary);
  font-size: 30rpx;
  line-height: 1.55;
}

.empty-title,
.empty-copy,
.record-title,
.record-meta,
.section-title,
.section-hint {
  display: block;
}

.empty-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.4;
  text-wrap: balance;
}

.empty-copy {
  margin-top: 14rpx;
  text-wrap: pretty;
}

.hero-panel {
  position: relative;
  padding: 38rpx 32rpx 34rpx;
  background:
    radial-gradient(circle at 92% 12%, rgba(182, 93, 73, 0.09), transparent 176rpx),
    linear-gradient(145deg, var(--ui-surface), var(--ui-surface-soft));
}

.hero-panel::before {
  content: "";
  position: absolute;
  top: 36rpx;
  left: 0;
  width: 6rpx;
  height: 62rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: var(--ui-accent);
}

.record-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-page-title);
  font-weight: 700;
  letter-spacing: 0.03em;
  line-height: 1.38;
  overflow-wrap: anywhere;
  text-wrap: balance;
}

.record-meta {
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  line-height: 1.5;
  overflow-wrap: anywhere;
  text-wrap: pretty;
}

.section-card {
  padding: 30rpx 28rpx;
}

.section-head,
.actions-row,
.playback-head {
  display: flex;
  align-items: center;
}

.section-head,
.playback-head {
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.section-heading {
  flex: 1 1 auto;
  min-width: 0;
}

.section-title {
  color: var(--ui-section-title);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-section-title);
  font-weight: 700;
  letter-spacing: 0.02em;
  line-height: 1.4;
  text-wrap: balance;
}

.section-hint {
  margin-top: 4rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  overflow-wrap: anywhere;
  text-wrap: pretty;
}

.section-count {
  flex: 0 0 auto;
  max-width: 240rpx;
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 1.4;
  text-align: right;
  overflow-wrap: anywhere;
  font-variant-numeric: tabular-nums;
}

.actions-row {
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.primary-actions,
.playback-actions,
.offline-asr-actions,
.share-video-actions,
.material-assignment-actions {
  justify-content: flex-start;
}

.primary-button,
.ghost-button,
.edit-exit-button,
.text-action-button {
  min-height: 88rpx;
  margin: 0;
  border: 0;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  box-shadow: var(--ui-control-shadow);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--ui-font-action);
  font-weight: 700;
  line-height: 1.35;
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.primary-button,
.ghost-button {
  flex: 1 1 220rpx;
  padding: 14rpx 24rpx;
}

.primary-button {
  background: linear-gradient(90deg, var(--ui-accent-surface) 0 8rpx, var(--ui-surface) 8rpx);
}

.ghost-button {
  color: var(--ui-value-text);
}

.text-action-button {
  width: auto;
  min-width: 88rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  box-shadow: none;
}

.primary-button[disabled],
.ghost-button[disabled],
.edit-exit-button[disabled],
.text-action-button[disabled] {
  opacity: 0.52;
}

.primary-button:active,
.ghost-button:active,
.edit-exit-button:active,
.text-action-button:active {
  transform: scale(0.96);
}

.login-entry-action {
  width: 100%;
  margin-top: 26rpx;
}

.bottom-spacer {
  height: 20rpx;
}

.detail-page.large-text {
  padding: 28rpx 24rpx 120rpx;
}

.detail-page.large-text .record-title {
  font-size: 46rpx;
  line-height: 1.4;
}

.detail-page.large-text .section-title,
.detail-page.large-text .empty-title {
  font-size: 38rpx;
  line-height: 1.45;
}

.detail-page.large-text .record-meta,
.detail-page.large-text .section-hint,
.detail-page.large-text .empty-copy {
  font-size: var(--ui-font-large-body);
  line-height: 1.55;
}

.detail-page.large-text .section-count {
  font-size: var(--ui-font-large-meta);
  line-height: 1.45;
}

.detail-page.large-text .primary-button,
.detail-page.large-text .ghost-button,
.detail-page.large-text .edit-exit-button,
.detail-page.large-text .text-action-button {
  min-height: 96rpx;
  font-size: var(--ui-font-large-body);
  line-height: 1.4;
}
