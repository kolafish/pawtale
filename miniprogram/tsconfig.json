{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM"],
    "baseUrl": "."
  },
  "include": ["**/*.ts", "types/**/*.d.ts"]
}
