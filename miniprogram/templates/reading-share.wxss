.book-share-panel {
  padding: 24rpx 30rpx;
  border-top: 1rpx solid var(--ui-divider);
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: 1.5;
}
.book-share-description {
  display: block;
}
.book-share-primary-action {
  margin-top: 18rpx;
}
.book-share-primary-action .reading-share-primary-button {
  width: 100%;
}
.book-share-management {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 8rpx;
}
.book-share-manage-button {
  min-height: 80rpx;
  margin: 0;
  padding: 0 12rpx;
  border: 0;
  background: transparent;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  line-height: 1.3;
}
.book-share-manage-button.is-danger {
  color: var(--ui-danger-text);
}
.book-share-manage-button:active {
  transform: scale(0.96);
}
.book-share-manage-button[disabled] {
  opacity: 0.58;
  transform: none;
}
.reading-share-primary-button {
  min-width: 0;
  min-height: 80rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 0;
  border-radius: var(--ui-radius-control);
  background: var(--ui-accent-surface-subtle);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 1.3;
  transition: transform 150ms ease-out, opacity 150ms ease-out, background-color 150ms ease-out, box-shadow 150ms ease-out;
  display: flex;
  align-items: center;
  justify-content: center;
}
.reading-share-primary-button:active { transform: scale(0.96); }
.reading-share-primary-button[disabled] { opacity: 0.58; transform: none; }
