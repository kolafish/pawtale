.share-like-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 24rpx 0;
  padding: 22rpx 26rpx;
  border-radius: var(--ui-radius-card);
  background: var(--ui-surface);
  border: 1rpx solid var(--ui-border);
}
.share-like-button {
  display: flex;
  flex: none;
  align-items: center;
  gap: 8rpx;
  min-height: 80rpx;
  margin: 0;
  padding: 0 26rpx;
  border: 1rpx solid var(--ui-accent-border);
  border-radius: 999rpx;
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-action);
  line-height: 1.2;
}
.share-like-button.is-liked {
  border-color: var(--ui-accent);
  background: var(--ui-accent);
  color: var(--ui-on-accent);
}
.share-like-button[disabled] {
  opacity: 0.7;
}
.share-like-heart {
  font-size: 36rpx;
}
.share-like-people {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}
.share-like-avatars {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.share-like-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background: var(--ui-accent-surface);
  color: var(--ui-accent-strong);
  font-size: 26rpx;
  line-height: 52rpx;
  text-align: center;
}
.share-like-text {
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  line-height: 1.4;
}
.share-like-people-shell {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}
.share-like-profile-link {
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-meta);
  line-height: 1.4;
}
.share-like-list-title {
  display: block;
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-body);
  font-weight: 600;
}
.share-like-list-people {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 12rpx;
  margin-top: 16rpx;
}
.share-like-list-person {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: 128rpx;
}
.share-like-list-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: var(--ui-accent-surface);
  color: var(--ui-accent-strong);
  font-size: 34rpx;
  line-height: 88rpx;
  text-align: center;
}
.share-like-list-name {
  max-width: 128rpx;
  overflow: hidden;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-caption);
  line-height: 1.3;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
