<template name="shareLikePeople">
  <view class="share-like-people">
    <view wx:if="{{avatars.length}}" class="share-like-avatars" aria-hidden="true">
      <block wx:for="{{avatars}}" wx:key="key">
        <image wx:if="{{item.url}}" class="share-like-avatar" src="{{item.url}}" mode="aspectFill" />
        <text wx:else class="share-like-avatar is-placeholder">家</text>
      </block>
    </view>
    <text wx:if="{{text}}" class="share-like-text">{{text}}</text>
  </view>
</template>

<template name="shareLikeList">
  <view class="share-like-list">
    <text class="share-like-list-title">♥ {{count}} 位家人点了赞</text>
    <view class="share-like-list-people">
      <view wx:for="{{likers}}" wx:key="key" class="share-like-list-person">
        <image wx:if="{{item.url}}" class="share-like-list-avatar" src="{{item.url}}" mode="aspectFill" aria-hidden="true" />
        <text wx:else class="share-like-list-avatar is-placeholder" aria-hidden="true">家</text>
        <text class="share-like-list-name">{{item.name}}</text>
      </view>
    </view>
  </view>
</template>

<template name="shareLikeBar">
  <view wx:if="{{shareLikeVisible || shareForward}}" class="share-like-bar">
    <button
      wx:if="{{shareCanLike}}"
      class="share-like-button ui-button {{shareLiked ? 'is-liked' : ''}}"
      bindtap="toggleShareLike"
      disabled="{{shareLikeBusy}}"
      aria-label="{{shareLiked ? '取消点赞' : '点赞'}}"
      hover-class="ui-subtle-action-hover"
    >
      <text class="share-like-heart" aria-hidden="true">{{shareLiked ? '♥' : '♡'}}</text>
      <text>{{shareLiked ? '已赞' : '点赞'}}</text>
    </button>
    <button wx:if="{{shareForward}}" class="ui-share-primary" open-type="share">分享给好友</button>
    <view class="share-like-people-shell">
      <text wx:if="{{shareCanLike && !shareLiked}}" class="share-like-text">首次使用会通过微信建立账号，记录您的点赞；头像和昵称可选填。</text>
      <template is="shareLikePeople" data="{{avatars: shareLikeAvatars, text: shareLikeText}}" />
      <text wx:if="{{shareLiked && shareLikeProfileMissing}}" class="share-like-profile-link" bindtap="openShareLikeProfile" aria-role="button">留下名字和头像，让讲故事的人知道是你 ›</text>
    </view>
  </view>
</template>
