<import src="./share-likes.wxml" />
<template name="readingShareActions">
  <view class="reading-share-actions {{showBookReader || showChapterReader ? 'has-reader' : ''}}">
    <view class="ui-share-actions">
      <button wx:if="{{showChapterReader}}" class="hero-reading-action" bindtap="openChapterPreview" disabled="{{readerDisabled}}">
        <text>阅读本章</text><text aria-hidden="true">→</text>
      </button>
      <button wx:if="{{showBookReader}}" class="hero-reading-action" bindtap="openBookReader">
        <text>{{bookStaleNotice ? '阅读已保存书稿' : '阅读全书'}}</text><text aria-hidden="true">→</text>
      </button>
      <button class="ui-share-primary" open-type="{{bookShareReady ? 'share' : ''}}" bindtap="prepareReadingShare" loading="{{bookShareBusy}}" disabled="{{bookShareBusy}}">{{showChapterReader ? '分享整章' : '分享给好友'}}</button>
      <button wx:if="{{showChapterReader}}" class="ui-share-primary" bindtap="openExcerptShare" disabled="{{readerDisabled}}">分享划线</button>
      <button wx:if="{{!hideShareMore}}" class="ui-share-more" bindtap="openReadingShareMore" disabled="{{bookShareBusy}}" aria-label="分享更多操作">···</button>
    </view>
    <text wx:if="{{!hideShareDescription || bookShareFeedbackVisible}}" class="reading-share-scope"><block wx:if="{{!showBookReader && !showChapterReader}}">{{shareScopeLabel || '整本书'}} · </block>{{bookShareDescription}}</text>
    <template wx:if="{{bookShareLikeCount}}" is="shareLikeList" data="{{count: bookShareLikeCount, likers: bookShareLikers}}" />
  </view>
</template>
