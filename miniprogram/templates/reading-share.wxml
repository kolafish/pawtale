<import src="./share-likes.wxml" />
<template name="readingShareActions">
  <view class="reading-share-actions">
    <view class="ui-share-actions">
      <button class="ui-share-primary" open-type="{{bookShareReady ? 'share' : ''}}" bindtap="prepareReadingShare" loading="{{bookShareBusy}}" disabled="{{bookShareBusy}}">分享给好友</button>
      <button class="ui-share-more" bindtap="openReadingShareMore" disabled="{{bookShareBusy}}" aria-label="分享更多操作">···</button>
    </view>
    <text class="reading-share-scope">{{shareScopeLabel || '整本书'}} · {{bookShareDescription}}</text>
    <template wx:if="{{bookShareLikeCount}}" is="shareLikeList" data="{{count: bookShareLikeCount, likers: bookShareLikers}}" />
  </view>
</template>
