.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #fffaf2;
  color: #2b1714;
  box-sizing: border-box;
}

.section {
  border: 1rpx solid #e6d7c7;
  border-radius: 8rpx;
  padding: 28rpx;
  background: #fff;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.status {
  display: inline-block;
  padding: 10rpx 18rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.ok {
  background: #eef8ef;
  color: #247340;
}

.bad {
  background: #fdecee;
  color: #a33333;
}

.metrics {
  display: grid;
  gap: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.event {
  min-height: 40rpx;
  color: #8a453b;
  font-size: 24rpx;
  margin-bottom: 28rpx;
}

.primary,
.secondary {
  margin-top: 16rpx;
  border-radius: 8rpx;
  font-weight: 700;
}

.primary {
  color: #fff;
  background: #9f4a3c;
}

.secondary {
  color: #9f4a3c;
  background: #fff7f0;
}
