.voice-settings-page { padding: 22rpx 32rpx 96rpx; }
.voice-settings-page > .ui-page-context-row { min-height: 72rpx; margin-bottom: 30rpx; padding: 16rpx 22rpx; border-radius: var(--ui-radius-inner); background: var(--ui-success-surface); }
.voice-settings-page > .ui-page-context-row::before { content: ""; width: 12rpx; height: 12rpx; flex: 0 0 12rpx; border-radius: 50%; background: var(--ui-success-text); }
.voice-settings-page > .ui-page-context-row .ui-page-context { flex: 1; color: var(--ui-success-text); font-size: var(--ui-font-body); }
.section { margin-top: 38rpx; }
.first-section { margin-top: 0; }

.section-header {
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title { margin-bottom: 14rpx; font-size: var(--ui-font-section-title); }
.section-header .section-title { margin-bottom: 0; }

.section-current {
  max-width: 58%;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-caption);
  font-weight: 600;
  line-height: 1.4;
  text-align: right;
  overflow-wrap: anywhere;
}

.settings-card,
.settings-list {
  width: 100%;
}

.settings-list { overflow: hidden; }
.settings-card { padding: 8rpx 26rpx; }

.switch-row {
  min-height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.switch-copy, .option-copy { min-width: 0; flex: 1; }

.option-row {
  width: 100%;
  min-height: 112rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  transition-property: transform, background-color, opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.option-row + .option-row { border-top: 1rpx solid var(--ui-divider); }
.option-row.selected { background: linear-gradient(90deg, rgba(234, 241, 230, 0.72), rgba(255, 253, 250, 0)); }
.option-row-hover { background: var(--ui-accent-surface-subtle); transform: scale(0.96); }

.option-label {
  display: block;
  color: var(--ui-text-primary);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.4;
  text-wrap: balance;
}

.option-desc {
  display: block;
  margin-top: 6rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  overflow-wrap: anywhere;
  text-wrap: pretty;
}

.selection-mark {
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
  border-radius: 50%;
  background: transparent;
  color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--ui-font-meta);
  font-weight: 900;
  opacity: 0;
  filter: blur(4px);
  transform: scale(0.25);
  transition-property: opacity, filter, transform, background-color, color, box-shadow;
  transition-duration: 220ms;
  transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
}

.selection-mark.visible {
  background: var(--ui-success-surface);
  color: var(--ui-success-text);
  opacity: 1;
  filter: blur(0);
  transform: scale(1);
  box-shadow: 0 0 0 1rpx rgba(88, 112, 82, 0.14);
}

.settings-subgroup { padding-top: 18rpx; }
.settings-subgroup + .settings-subgroup { border-top: 1rpx solid var(--ui-divider); }

.subgroup-label {
  display: block;
  padding: 0 24rpx 10rpx;
  color: var(--ui-section-title);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-meta);
  font-weight: 800;
  line-height: 1.35;
  letter-spacing: 0.04em;
}

.settings-subgroup .option-row:first-of-type { border-top: 0; }
.option-row.compact { min-height: 104rpx; }
.speed-subgroup { padding: 22rpx 24rpx 24rpx; }
.speed-subgroup .subgroup-label { padding: 0 0 14rpx; }

.speed-options {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6rpx;
  padding: 6rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-subtle);
}

.speed-option {
  min-width: 0;
  min-height: 88rpx;
  padding: 12rpx 8rpx;
  border-radius: 14rpx;
  color: var(--ui-text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--ui-font-action);
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
  transition-property: transform, background-color, color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.speed-option.selected {
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  box-shadow: var(--ui-control-shadow);
}

.speed-option-hover { transform: scale(0.96); }
.voice-settings-page.large-text { padding-right: 24rpx; padding-left: 24rpx; }

.voice-settings-page.large-text .section-current,
.voice-settings-page.large-text .option-desc,
.voice-settings-page.large-text .subgroup-label {
  font-size: var(--ui-font-large-meta);
  line-height: 1.5;
}

.voice-settings-page.large-text .option-label {
  font-size: 35rpx;
  line-height: 1.4;
}

.voice-settings-page.large-text .switch-row,
.voice-settings-page.large-text .option-row {
  min-height: 132rpx;
}

.voice-settings-page.large-text .speed-option {
  min-height: 104rpx;
  font-size: var(--ui-font-large-meta);
  line-height: 1.35;
}
