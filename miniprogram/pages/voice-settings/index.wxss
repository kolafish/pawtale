.voice-settings-page {
  padding: 24rpx 36rpx 96rpx;
}

.section {
  margin-top: 34rpx;
}

.first-section {
  margin-top: 0;
}

.section-header {
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title {
  margin-bottom: 14rpx;
}

.section-header .section-title {
  margin-bottom: 0;
}

.section-current {
  max-width: 58%;
  color: var(--ui-value-text);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: right;
  overflow-wrap: anywhere;
}

.settings-card,
.settings-list {
  width: 100%;
}

.settings-list {
  overflow: hidden;
}

.settings-card {
  padding: 8rpx 26rpx;
}

.switch-row {
  min-height: 118rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.switch-copy,
.option-copy {
  min-width: 0;
  flex: 1;
}

.option-row {
  width: 100%;
  min-height: 114rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  transition-property: background-color, opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.option-row + .option-row {
  border-top: 1rpx solid var(--ui-divider);
}

.option-row.selected {
  background: var(--ui-surface);
}

.option-row-hover {
  background: var(--ui-accent-surface-subtle);
}

.option-label {
  display: block;
  color: var(--ui-text-primary);
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.35;
  text-wrap: balance;
}

.option-desc {
  display: block;
  margin-top: 6rpx;
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
  text-wrap: pretty;
}

.selection-mark {
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
  border-radius: 999rpx;
  background: var(--ui-switch-off);
  color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 900;
  opacity: 0;
  filter: blur(4px);
  transform: scale(0.25);
  transition-property: opacity, filter, transform, background-color, color;
  transition-duration: 220ms;
  transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
}

.selection-mark.visible {
  background: var(--ui-accent);
  color: var(--ui-on-accent);
  opacity: 1;
  filter: blur(0);
  transform: scale(1);
}

.settings-subgroup {
  padding-top: 18rpx;
}

.settings-subgroup + .settings-subgroup {
  border-top: 1rpx solid var(--ui-divider);
}

.subgroup-label {
  display: block;
  padding: 0 24rpx 10rpx;
  color: var(--ui-section-title);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.35;
}

.settings-subgroup .option-row:first-of-type {
  border-top: 0;
}

.option-row.compact {
  min-height: 104rpx;
}

.speed-subgroup {
  padding: 22rpx 24rpx 24rpx;
}

.speed-subgroup .subgroup-label {
  padding: 0 0 14rpx;
}

.speed-options {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.speed-option {
  min-width: 0;
  min-height: 84rpx;
  padding: 12rpx 8rpx;
  border-radius: 18rpx;
  background: var(--ui-surface-subtle);
  color: var(--ui-text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.3;
  text-align: center;
  transition-property: transform, background-color, color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.speed-option.selected {
  background: var(--ui-accent);
  color: var(--ui-on-accent);
  box-shadow: 0 8rpx 20rpx rgba(143, 64, 55, 0.18);
}

.speed-option-hover {
  transform: scale(0.96);
}

.voice-settings-page.large-text {
  padding-right: 24rpx;
  padding-left: 24rpx;
}

.voice-settings-page.large-text .section-current,
.voice-settings-page.large-text .option-desc,
.voice-settings-page.large-text .subgroup-label {
  font-size: 28rpx;
  line-height: 1.5;
}

.voice-settings-page.large-text .option-label {
  font-size: 35rpx;
  line-height: 1.4;
}

.voice-settings-page.large-text .switch-row,
.voice-settings-page.large-text .option-row {
  min-height: 132rpx;
}

.voice-settings-page.large-text .speed-option {
  min-height: 104rpx;
  font-size: 28rpx;
  line-height: 1.35;
}
