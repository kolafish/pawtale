.feedback-page {
  min-height: 100vh;
  padding: 46rpx 36rpx 190rpx;
  background: #fffaf2;
}

.feedback-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}

.page-title {
  color: #24100b;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.2;
}

.avatar-mark {
  width: 144rpx;
  height: 144rpx;
  border: 4rpx solid #f0cfa8;
  border-radius: 50%;
  background: #fff7ea;
  display: flex;
  align-items: center;
  justify-content: center;
}

.prompt-card {
  margin-top: 48rpx;
  padding: 40rpx 36rpx;
  border: 2rpx solid #f0cfa8;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #24100b;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.4;
}

.issue-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 34rpx;
}

.issue-card {
  min-height: 166rpx;
  border: 2rpx solid #128577;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #24100b;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.issue-card.active {
  background: #e9f7f4;
  box-shadow: 0 12rpx 28rpx rgba(18, 133, 119, 0.14);
}

.issue-icon {
  color: #128577;
  font-size: 50rpx;
  font-weight: 900;
  line-height: 1;
}

.speaker-icon,
.tap-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #128577;
}

.feedback-textarea {
  width: 100%;
  min-height: 180rpx;
  margin-top: 30rpx;
  padding: 26rpx;
  border: 2rpx solid #eadfce;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #24100b;
  font-size: 30rpx;
  line-height: 1.5;
}

.primary-action,
.service-action {
  height: 104rpx;
  margin-top: 30rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  font-size: 38rpx;
  font-weight: 900;
}

.primary-action {
  background: #128577;
  color: #ffffff;
}

.primary-action-disabled {
  opacity: 0.7;
}

.service-action {
  border: 2rpx solid #128577;
  background: rgba(255, 255, 255, 0.76);
  color: #128577;
}

.headset-icon {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #128577;
  border-bottom-color: transparent;
  border-radius: 50%;
}

.footer-note {
  display: block;
  margin-top: 32rpx;
  color: #88776e;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
}
