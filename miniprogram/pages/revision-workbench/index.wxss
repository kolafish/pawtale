.revision-page {
  padding: 28rpx 30rpx 72rpx;
  color: var(--ui-text-primary);
}

.revision-kicker,
.revision-title,
.revision-summary,
.revision-meta,
.status-notice,
.chapter-label,
.chapter-title,
.section-label,
.section-title,
.section-content,
.order-item {
  display: block;
  overflow-wrap: anywhere;
}

.revision-intro {
  padding: 32rpx 30rpx;
  background: linear-gradient(140deg, #eef3e9 0%, var(--ui-surface) 82%);
}

.revision-kicker,
.chapter-label,
.section-label {
  color: var(--ui-section-title);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-caption);
  font-weight: 700;
  line-height: 1.5;
  letter-spacing: 0.04em;
}

.revision-kicker::after {
  content: "";
  display: block;
  width: 40rpx;
  height: 3rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  background: var(--ui-accent);
}

.revision-title {
  margin-top: 14rpx;
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-page-title);
  font-weight: 700;
  line-height: 1.4;
  text-wrap: balance;
}

.revision-summary,
.status-notice {
  text-wrap: pretty;
}

.revision-summary {
  margin-top: 16rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: 1.58;
}

.revision-meta {
  margin-top: 14rpx;
  color: var(--ui-text-muted);
  font-size: var(--ui-font-meta);
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}

.status-notice {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface-subtle);
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: 1.5;
}

.status-notice.success {
  background: var(--ui-success-surface);
  color: var(--ui-success-text);
}

.status-notice.error {
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
}

.mode-switch {
  min-height: 92rpx;
  margin-top: 22rpx;
  padding: 0 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface);
  box-shadow: var(--ui-control-shadow);
}

.mode-option {
  position: relative;
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-action);
  font-weight: 700;
}

.mode-option.active {
  color: var(--ui-accent-strong);
}

.mode-option.active::after,
.ui-version-option.active::after {
  content: "";
  position: absolute;
  right: 16rpx;
  bottom: 0;
  left: 16rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: var(--ui-accent);
}

.version-switch {
  position: sticky;
  top: 16rpx;
  z-index: 4;
  min-height: 92rpx;
  padding: 0 18rpx;
  gap: 20rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow-raised);
}

.version-switch .ui-version-option {
  position: relative;
  min-height: 92rpx;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.changed-list,
.whole-book,
.revision-plan {
  margin-top: 22rpx;
}

.changed-chapter,
.whole-chapter,
.plan-item {
  margin-top: 18rpx;
  padding: 28rpx 26rpx;
}

.plan-field-label {
  display: block;
  margin-top: 22rpx;
  color: var(--ui-text-primary);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 1.5;
}

.plan-field {
  margin-top: 6rpx;
}

.plan-targets {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.plan-target {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--ui-success-surface);
  color: var(--ui-success-text);
  font-size: var(--ui-font-caption);
  line-height: 1.45;
}

.chapter-title {
  margin-top: 7rpx;
  font-family: var(--ui-font-editorial);
  font-size: 33rpx;
  font-weight: 700;
  line-height: 1.45;
  text-wrap: balance;
}

.changed-section,
.whole-section,
.metadata-change {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.section-title {
  margin-top: 4rpx;
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-list-title);
  font-weight: 700;
  line-height: 1.5;
  text-wrap: balance;
}

.metadata-after-title {
  margin-top: 20rpx;
  color: var(--ui-accent-strong);
}

.section-content {
  margin-top: 9rpx;
  color: var(--ui-text-secondary);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-body);
  line-height: 1.72;
  white-space: pre-wrap;
}

.order-after-title {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.order-item {
  margin-top: 9rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: 1.55;
  font-variant-numeric: tabular-nums;
}

.state-card {
  margin-top: 22rpx;
  padding: 28rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  line-height: 1.55;
}

.revision-page .ui-error-banner,
.revision-progress {
  margin-top: 22rpx;
}

.feedback-card {
  margin-top: 28rpx;
  background: var(--ui-surface);
}

.initial-feedback-card {
  margin-top: 0;
}

.feedback-card voice-text-editor {
  display: block;
  margin-top: 20rpx;
}

.revision-actions {
  margin-top: 28rpx;
}

.primary-action,
.secondary-action {
  position: relative;
  min-height: 104rpx;
  padding: 18rpx 58rpx 18rpx 66rpx;
  justify-content: flex-start;
  border-radius: var(--ui-radius-inner);
  font-size: var(--ui-font-action);
  font-weight: 700;
  text-align: left;
}

.primary-action {
  background: var(--ui-surface);
  color: var(--ui-text-primary);
  box-shadow: var(--ui-card-shadow-raised);
}

.primary-action::before {
  content: "";
  position: absolute;
  left: 24rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--ui-accent);
  box-shadow: 0 0 0 10rpx var(--ui-accent-surface);
}

.primary-action::after {
  content: "›";
  position: absolute;
  right: 24rpx;
  color: var(--ui-accent);
  font-size: 40rpx;
  font-weight: 300;
}

.secondary-action {
  min-height: 88rpx;
  margin-top: 12rpx;
  padding: 0 24rpx;
  justify-content: center;
  background: transparent;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-action);
  box-shadow: inset 0 0 0 1rpx var(--ui-divider);
}
