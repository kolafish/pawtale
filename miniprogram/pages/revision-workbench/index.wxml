<view class="ui-page-shell {{pageClass}}">
  <view wx:if="{{loading}}" class="state-card ui-card ui-card-borderless">正在准备修改预览...</view>
  <block wx:else>
  <block wx:if="{{proposal}}">
    <view class="revision-intro ui-card ui-card-borderless">
      <text class="revision-kicker">{{proposal.phase === "plan_ready" ? (scope === "chapter_section" ? "小节修改思路" : "书稿修改思路") : (scope === "chapter_section" ? "小节修改预览" : "书稿修改预览")}}</text>
      <text wx:if="{{proposal.status === 'ready'}}" class="revision-title">{{proposal.phase === "plan_ready" ? "确认思路后生成修改稿" : "确认后生效"}}</text>
      <text class="revision-summary">{{proposal.summary}}</text>
      <text wx:if="{{proposal.phase === 'plan_ready'}}" class="revision-meta ui-tabular">共 {{proposal.revision_plan ? proposal.revision_plan.items.length : 0}} 项修改安排</text>
      <text wx:else class="revision-meta ui-tabular">{{proposal.comparison.chapter_order_changed ? "包含章节顺序调整；" : ""}}涉及 {{proposal.comparison.changed_chapter_count}} 章、{{proposal.comparison.changed_section_count}} 个小节{{metadataChanges.length ? "；成书信息 " + metadataChanges.length + " 项" : ""}}</text>
      <text wx:if="{{proposal.status === 'stale'}}" class="status-notice error">
        书稿已变化，请返回重新生成预览。
      </text>
      <text wx:elif="{{proposal.status === 'applied'}}" class="status-notice success">
        修改已生效，原版本已保留。
      </text>
      <text wx:elif="{{proposal.status === 'dismissed'}}" class="status-notice">
        已放弃修改，书稿未改变。
      </text>
    </view>

    <view wx:if="{{proposal.phase === 'plan_ready'}}" class="revision-plan">
      <view
        wx:for="{{proposal.revision_plan ? proposal.revision_plan.items : []}}"
        wx:key="title"
        class="plan-item ui-card ui-card-borderless"
      >
        <text class="chapter-label">修改安排 {{index + 1}}</text>
        <text class="chapter-title">{{item.title}}</text>
        <text class="plan-field-label">修改原因</text>
        <text class="revision-summary plan-field">{{item.reason}}</text>
        <text class="plan-field-label">修改方式</text>
        <text class="revision-summary plan-field">{{item.approach}}</text>
        <view wx:if="{{item.targets.length}}" class="plan-targets">
          <text
            wx:for="{{item.targets}}"
            wx:key="*this"
            class="plan-target"
          >{{item}}</text>
        </view>
      </view>
      <view wx:if="{{metadataChanges.length}}" class="plan-item ui-card ui-card-borderless">
        <text class="chapter-label">成书信息调整</text>
        <view
          wx:for="{{metadataChanges}}"
          wx:key="field"
          class="metadata-change"
        >
          <text class="plan-field-label">{{item.label}}</text>
          <text class="revision-summary plan-field" selectable>{{item.after_value || "（留空）"}}</text>
        </view>
      </view>
      <view
        wx:if="{{(!proposal.revision_plan || !proposal.revision_plan.items.length) && !metadataChanges.length}}"
        class="state-card ui-card ui-card-borderless"
      >
        无需修改正文，可在下方补充意见。
      </view>
    </view>

    <block wx:else>
      <view wx:if="{{scope === 'book'}}" class="mode-switch" aria-label="预览范围">
      <view
        class="mode-option ui-pressable {{mode === 'changes' ? 'active' : ''}}"
        data-mode="changes"
        bindtap="switchMode"
      >只看修改处</view>
      <view
        class="mode-option ui-pressable {{mode === 'whole' ? 'active' : ''}}"
        data-mode="whole"
        bindtap="switchMode"
      >查看全书</view>
      </view>

      <view class="version-switch ui-version-switch" aria-label="预览版本">
      <view
        class="ui-version-option ui-pressable {{previewVersion === 'before' ? 'active' : ''}}"
        data-version="before"
        bindtap="switchPreviewVersion"
      >修改前</view>
      <view
        class="ui-version-option ui-pressable {{previewVersion === 'after' ? 'active' : ''}}"
        data-version="after"
        bindtap="switchPreviewVersion"
      >修改后</view>
      </view>

      <view wx:if="{{mode === 'changes'}}" class="changed-list">
      <view wx:if="{{metadataChanges.length}}" class="changed-chapter ui-card ui-card-borderless">
        <text class="chapter-label">成书信息</text>
        <view
          wx:for="{{metadataChanges}}"
          wx:key="field"
          class="metadata-change"
        >
          <text class="section-label">{{item.label}}</text>
          <text class="section-title">修改前</text>
          <text class="section-content" selectable>{{item.before_value || "（留空）"}}</text>
          <text class="section-title metadata-after-title">修改后</text>
          <text class="section-content" selectable>{{item.after_value || "（留空）"}}</text>
        </view>
      </view>
      <view
        wx:if="{{proposal.comparison.chapter_order_changed}}"
        class="changed-chapter order-comparison ui-card ui-card-borderless"
      >
        <text class="chapter-label">章节顺序</text>
        <text class="chapter-title">调整前</text>
        <text
          wx:for="{{proposal.comparison.before_chapter_order}}"
          wx:key="chapter_id"
          class="order-item"
        >{{index + 1}}. {{item.title}}</text>
        <text class="chapter-title order-after-title">调整后</text>
        <text
          wx:for="{{proposal.comparison.after_chapter_order}}"
          wx:key="chapter_id"
          class="order-item"
        >{{index + 1}}. {{item.title}}</text>
      </view>
      <view
        wx:for="{{changedChapters}}"
        wx:key="chapter_id"
        wx:for-item="chapter"
        class="changed-chapter ui-card ui-card-borderless"
      >
        <text class="chapter-label">修改章节</text>
        <text class="chapter-title">{{chapter.title}}</text>
        <view
          wx:for="{{chapter.sections}}"
          wx:key="section_id"
          wx:for-item="section"
          class="changed-section"
        >
          <text class="section-label">小节</text>
          <text class="section-title">{{section.display_title}}</text>
          <text class="section-content" selectable>{{section.display_content}}</text>
        </view>
      </view>
      <view
        wx:if="{{!changedChapters.length && !proposal.comparison.chapter_order_changed && !metadataChanges.length}}"
        class="state-card ui-card ui-card-borderless"
      >
        没有实际改动，请继续调整或放弃修改。
      </view>
      </view>

      <view wx:elif="{{wholeLoading}}" class="state-card ui-card ui-card-borderless">正在加载整书预览...</view>

      <view wx:else class="whole-book">
      <view
        wx:for="{{wholeChapters}}"
        wx:key="chapter_id"
        wx:for-item="chapter"
        class="whole-chapter ui-card ui-card-borderless"
      >
        <text class="chapter-label">{{chapter.index_text}}</text>
        <text class="chapter-title">{{chapter.title}}</text>
        <view
          wx:for="{{chapter.sections}}"
          wx:key="section_id"
          wx:for-item="section"
          class="whole-section"
        >
          <text class="section-title">{{section.title}}</text>
          <text class="section-content" selectable>{{section.content}}</text>
        </view>
        <text wx:if="{{!chapter.sections.length}}" class="section-content" selectable>{{chapter.content}}</text>
      </view>
      </view>
    </block>

  </block>

    <view
      wx:if="{{(scope === 'chapter_section' && !proposal) || (proposal && proposal.status === 'ready' && proposal.can_dismiss)}}"
      class="revision-intro feedback-card {{proposal ? '' : 'initial-feedback-card'}} ui-card ui-card-borderless"
    >
      <text class="{{proposal ? 'chapter-label' : 'revision-kicker'}}">{{proposal ? "继续调整" : "小节修改"}}</text>
      <text class="revision-title">
        {{proposal
          ? (proposal.revision_plan ? "修改思路还需要怎么调整？" : "这版还需要怎么改？")
          : "说出修改要求，直接看修改前后"}}
      </text>
      <text wx:if="{{!proposal && sectionTitle}}" class="chapter-title">{{sectionTitle}}</text>
      <text class="revision-summary">
        {{!proposal
          ? "查看对比后确认保存，原版本会保留。"
          : (proposal.revision_plan
            ? (proposal.phase === "draft_ready"
              ? (scope === "chapter_section"
                ? "补充意见后先更新思路，当前小节不变。"
                : "补充意见后先更新思路，书稿不变。")
              : "补充意见，更新修改思路。")
            : "补充意见后更新预览。")}}
      </text>
      <voice-text-editor
        value="{{feedbackText}}"
        gateway-url="{{feedbackDictationUrl}}"
        voice-session-id="{{proposalId || sectionId}}"
        maxlength="1000"
        placeholder="{{proposal ? '请输入希望保留或继续调整的内容' : '例如：语气平实些，不增加新事实'}}"
        submit-text="{{proposal ? (proposal.revision_plan ? '更新修改思路' : '按意见调整') : '生成修改预览'}}"
        busy-text="{{proposal ? '正在调整…' : '正在生成修改预览…'}}"
        disabled="{{busy || draftBusy}}"
        busy="{{feedbackBusy}}"
        automatic-voice-command="{{true}}"
        bindchange="changeFeedbackText"
        bindsubmit="submitFeedback"
      />
      <text wx:if="{{feedbackBusy}}" class="revision-meta">
        {{proposal
          ? "AI 正在更新" + (proposal.revision_plan ? "修改思路" : "修改预览") + "，离开页面后任务也会继续。"
          : "AI 正在生成修改预览，离开页面后任务也会继续。"}}
      </text>
    </view>

    <view wx:if="{{feedbackBusy && !proposal}}" class="revision-progress">
      <ai-task-progress
        title="正在生成小节修改预览"
        detail="离开页面后任务也会继续，确认保存前当前正文不会改变。"
        mode="indeterminate"
      />
    </view>

    <view wx:if="{{draftBusy}}" class="revision-progress">
      <ai-task-progress
        title="正在按思路生成修改稿"
        detail="离开页面后任务也会继续，重新进入仍可查看进度。"
        mode="indeterminate"
      />
    </view>

    <view wx:if="{{error}}" class="ui-error-banner">{{error}}</view>

    <view wx:if="{{proposal}}" class="revision-actions">
      <view
        wx:if="{{proposal.phase === 'plan_ready' && proposal.status === 'ready'}}"
        class="primary-action ui-block-action ui-pressable {{busy || feedbackBusy || draftBusy ? 'is-disabled' : ''}}"
        aria-role="button"
        aria-disabled="{{busy || feedbackBusy || draftBusy}}"
        bindtap="generateDraft"
      >{{draftBusy ? "正在生成修改稿…" : "生成修改稿"}}</view>
      <view
        wx:elif="{{proposal.can_apply}}"
        class="primary-action ui-block-action ui-pressable {{busy || feedbackBusy || draftBusy ? 'is-disabled' : ''}}"
        aria-role="button"
        aria-disabled="{{busy || feedbackBusy || draftBusy}}"
        bindtap="applyRevision"
      >{{feedbackBusy ? "请等待调整完成" : (busy ? "正在确认…" : "采用修改稿")}}</view>
      <view
        wx:if="{{proposal.can_dismiss}}"
        class="secondary-action ui-block-action ui-pressable {{busy || feedbackBusy || draftBusy ? 'is-disabled' : ''}}"
        aria-role="button"
        aria-disabled="{{busy || feedbackBusy || draftBusy}}"
        bindtap="dismissRevision"
      >放弃修改</view>
      <view
        wx:if="{{proposal.status === 'applied'}}"
        class="primary-action ui-block-action ui-pressable"
        aria-role="button"
        bindtap="openAppliedBook"
      >{{scope === "chapter_section" ? "返回本章" : "查看修改后的书稿"}}</view>
    </view>
  </block>
</view>
