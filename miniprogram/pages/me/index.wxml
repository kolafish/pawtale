<page-meta page-style="--ui-navigation-height: {{navigationHeight || 0}}px;" />
<brand-navigation title="{{navigationTitle || '设置'}}" page-class="{{pageClass || homePageClass}}" bindlayout="onNavigationLayout" />
<view class="ui-page-shell ui-accessible-page {{pageClass}}">
  <view wx:if="{{error}}" class="error ui-error-banner">{{error}}</view>

  <block wx:if="{{!loggedIn}}">
    <view class="guest-login-panel ui-card ui-card-borderless">
      <view class="guest-login-mark">余</view>
      <text class="panel-title">登录后管理你的回忆录</text>
      <view
        class="primary-button support-action ui-block-action ui-pressable"
        aria-role="button"
        bindtap="openLogin"
      >
        前往登录
      </view>
    </view>

    <view class="section">
      <text class="section-title ui-section-heading">显示与辅助</text>
      <view class="settings-card ui-card ui-card-borderless">
        <view class="switch-row">
          <view class="switch-copy">
            <text class="action-title">大字模式</text>
          </view>
          <switch
            checked="{{largeTextEnabled}}"
            color="#b65d49"
            aria-label="大字模式"
            bindchange="changeLargeText"
          />
        </view>
      </view>
    </view>
  </block>

  <block wx:if="{{loggedIn}}">
    <view class="profile-panel ui-card ui-card-borderless">
      <button
        class="profile-avatar-picker"
        open-type="chooseAvatar"
        disabled="{{avatarSaving || loading}}"
        bindchooseavatar="chooseWeChatAvatar"
        aria-label="更换微信头像"
        hover-class="ui-avatar-action-hover"
      >
        <image wx:if="{{avatarUrl}}" class="avatar-image ui-image-outline" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar">
          <text>{{avatarText}}</text>
        </view>
        <text class="avatar-edit-badge">{{avatarSaving ? "…" : "换"}}</text>
      </button>
      <view class="profile-main">
        <view wx:if="{{editingName}}" class="name-edit-row">
          <input
            class="name-input support-form-input"
            type="nickname"
            value="{{nameDraft}}"
            maxlength="40"
            placeholder="点击选择微信昵称"
            focus="{{editingName}}"
            bindinput="changeNameDraft"
          />
        </view>
        <text wx:else class="profile-name">{{displayName || "作者"}}</text>
        <text class="profile-email">{{accountEmailText || email || "正在加载账号"}}</text>
      </view>
      <view wx:if="{{editingName}}" class="profile-actions">
        <button class="mini-button ghost support-action ui-pressable" disabled="{{savingName}}" bindtap="cancelEditName">取消</button>
        <button class="mini-button primary support-action ui-pressable" loading="{{savingName}}" disabled="{{savingName}}" bindtap="saveDisplayName">
          保存
        </button>
      </view>
      <button wx:else class="edit-name-button support-action ui-pressable" disabled="{{loading}}" bindtap="startEditName">编辑</button>
    </view>

    <view class="section">
      <view class="setting-header">
        <text class="section-title ui-section-heading">当前回忆录</text>
        <text class="setting-current stats-refresh">{{voiceStatsLoading ? "更新中" : " "}}</text>
      </view>
      <view class="project-overview ui-card ui-card-borderless">
        <view class="project-overview-head">
          <view class="project-overview-main">
            <text class="action-title">{{projectTitle || "尚未创建回忆录"}}</text>
            <text wx:if="{{!projectCount}}" class="action-meta">创建第一本回忆录</text>
          </view>
        </view>

        <view class="overview-stats">
          <view class="overview-stat">
            <text class="overview-stat-value ui-tabular">{{sessionCount}}</text>
            <text class="overview-stat-label">讲述次数</text>
          </view>
          <view class="overview-stat">
            <text class="overview-stat-value ui-tabular">{{utteranceCount}}</text>
            <text class="overview-stat-label">文字讲述</text>
          </view>
          <view class="overview-stat">
            <text class="overview-stat-value ui-tabular">{{totalUserCharCount}}</text>
            <text class="overview-stat-label">文字</text>
          </view>
          <view class="overview-stat">
            <text class="overview-stat-value small ui-tabular">{{totalAudioText}}</text>
            <text class="overview-stat-label">录音</text>
          </view>
        </view>
        <text class="overview-stats-hint">段数仅统计已转文字的讲述，录音时长含未转写录音。</text>

      </view>
    </view>

    <view class="section">
      <view class="setting-header">
        <text class="section-title ui-section-heading">AI 使用额度</text>
        <text class="setting-current stats-refresh">{{creditLoading ? "更新中" : " "}}</text>
      </view>
      <view wx:if="{{creditAvailable}}" class="credit-card ui-card ui-card-borderless">
        <view class="credit-card-head">
          <view>
            <text class="action-title">{{creditOverdrawn ? "已超出额度" : "当前可用"}} ¥{{creditRemainingText}}</text>
            <text class="action-meta">已使用 ¥{{creditUsedText}} / ¥{{creditTotalText}}</text>
          </view>
          <text class="credit-percent ui-tabular">{{creditProgressPercent}}%</text>
        </view>
        <view class="credit-progress-track" aria-label="AI 额度已使用 {{creditProgressPercent}}%">
          <view class="credit-progress-fill" style="width: {{creditProgressPercent}}%;"></view>
        </view>
        <text class="credit-hint">AI 使用费按模型预估成本的 {{creditMultiplier}} 倍扣除。</text>
        <button
          wx:if="{{creditPacks.length}}"
          class="credit-recharge-button support-action ui-pressable {{creditPurchasing ? 'is-disabled' : ''}}"
          aria-disabled="{{creditPurchasing}}"
          bindtap="openCreditPurchase"
        >{{creditPurchasing ? "充值处理中" : "充值额度"}}</button>
        <button class="credit-usage-toggle ui-pressable" bindtap="toggleCreditUsageDetails">
          {{creditUsageExpanded ? "收起使用明细" : "查看使用明细"}}
        </button>
        <view wx:if="{{creditUsageExpanded}}" class="credit-usage-list">
          <view wx:for="{{creditUsageDays}}" wx:for-item="day" wx:key="dateText" class="credit-usage-day">
            <view class="credit-usage-day-head">
              <text>{{day.dateText}}</text>
              <text class="ui-tabular">当日扣费 -¥{{day.amountText}}</text>
            </view>
            <view wx:for="{{day.purposes}}" wx:for-item="group" wx:key="purpose" class="credit-usage-row">
              <view class="credit-usage-copy">
                <text class="action-title">{{group.purpose}}</text>
                <text class="action-meta">{{group.count}} 次</text>
              </view>
              <text class="credit-usage-amount ui-tabular">-¥{{group.amountText}}</text>
            </view>
            <view wx:for="{{day.credits}}" wx:for-item="entry" wx:key="id" class="credit-usage-row">
              <view class="credit-usage-copy">
                <text class="action-title">{{entry.label}}</text>
                <text wx:if="{{entry.note}}" class="action-meta">{{entry.note}}</text>
              </view>
              <text class="credit-usage-amount ui-tabular">{{entry.amountText}}</text>
            </view>
          </view>
          <text wx:if="{{creditUsageLoading}}" class="credit-usage-message">正在加载…</text>
          <text wx:if="{{creditUsageError}}" class="credit-usage-message">{{creditUsageError}}</text>
          <text wx:if="{{!creditUsageLoading && !creditUsageError && !creditUsageDays.length}}" class="credit-usage-message">暂无额度记录</text>
          <button wx:if="{{creditUsageError || (creditUsageHasMore && !creditUsageLoading)}}" class="credit-usage-more ui-pressable" bindtap="loadMoreCreditUsageDetails">
            {{creditUsageError ? "重新加载" : "加载更早记录"}}
          </button>
        </view>
      </view>
      <view wx:elif="{{creditError}}" class="credit-card ui-card ui-card-borderless credit-card-error">
        <text class="action-meta">{{creditError}}</text>
        <button class="credit-retry-button support-action ui-pressable" bindtap="loadAICreditSummary">重新加载</button>
      </view>
      <view wx:else class="credit-card ui-card ui-card-borderless">
        <text class="action-meta">{{creditLoading ? "正在读取额度…" : "暂无额度信息"}}</text>
      </view>
    </view>

    <view class="section">
      <text class="section-title ui-section-heading">回忆录管理</text>
      <view class="settings-list ui-card ui-card-borderless">
        <view
          class="settings-nav-row"
          aria-role="button"
          aria-label="{{projectCount ? '管理回忆录' : '创建回忆录'}}"
          bindtap="openProjects"
          hover-class="settings-nav-row-hover"
        >
          <view class="settings-row-copy">
            <text class="action-title">{{projectCount ? "管理回忆录" : "创建回忆录"}}</text>
            <text wx:if="{{projectCount}}" class="action-meta">共 {{projectCount}} 本</text>
          </view>
          <text class="row-chevron">›</text>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-title ui-section-heading">语音与工具</text>
      <view class="settings-list ui-card ui-card-borderless">
        <view
          class="settings-nav-row"
          aria-role="button"
          aria-label="查看语音授权"
          bindtap="openVoiceAuthorization"
          hover-class="settings-nav-row-hover"
        >
          <view class="settings-row-copy">
            <text class="action-title">语音授权</text>
            <text wx:if="{{!voiceAuthorizationAgreed}}" class="action-meta">录音前请先授权</text>
          </view>
          <view class="settings-row-tail">
            <text class="status-pill {{voiceAuthorizationAgreed ? 'ok' : 'warn'}}">{{voiceAuthorizationStatusText}}</text>
            <text class="row-chevron">›</text>
          </view>
        </view>

        <view
          class="settings-nav-row"
          aria-role="button"
          aria-label="语音与 AI 设置"
          bindtap="openVoiceSettings"
          hover-class="settings-nav-row-hover"
        >
          <view class="settings-row-copy">
            <text class="action-title">语音与 AI</text>
          </view>
          <view class="settings-row-tail">
            <text class="row-value">{{aiModelLabel}}</text>
            <text class="row-chevron">›</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-title ui-section-heading">显示与辅助</text>
      <view class="settings-card ui-card ui-card-borderless">
        <view class="switch-row">
          <view class="switch-copy">
            <text class="action-title">大字模式</text>
          </view>
          <switch
            checked="{{largeTextEnabled}}"
            color="#b65d49"
            aria-label="大字模式"
            bindchange="changeLargeText"
          />
        </view>
      </view>
    </view>

  </block>

  <view class="section">
    <text class="section-title ui-section-heading">协议与隐私</text>
    <view class="settings-list ui-card ui-card-borderless">
      <view class="settings-nav-row" aria-role="button" bindtap="openPrivacyContract" hover-class="settings-nav-row-hover">
        <view class="settings-row-copy"><text class="action-title">用户隐私保护指引</text></view>
        <text class="row-chevron">›</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loggedIn}}" class="account-actions">
    <button
      class="account-action-button"
      hover-class="ui-subtle-action-hover"
      disabled="{{loading}}"
      bindtap="logout"
    >{{loading && !deletingAccount ? "正在退出…" : "退出登录"}}</button>
    <button
      class="account-action-button"
      hover-class="ui-subtle-action-hover"
      disabled="{{loading}}"
      bindtap="deleteAccount"
    >{{deletingAccount ? "正在注销…" : "注销账号"}}</button>
  </view>

  <view
    wx:if="{{creditSheetVisible}}"
    class="credit-sheet-mask"
    bindtap="closeCreditPurchase"
    catchtouchmove="noop"
  >
    <view class="credit-sheet" catchtap="noop" aria-role="dialog" aria-label="充值 AI 额度">
      <view class="credit-sheet-grabber"></view>
      <view class="credit-sheet-head">
        <view class="credit-sheet-heading">
          <text class="credit-sheet-title">充值 AI 额度</text>
          <text class="credit-sheet-subtitle">付多少到账多少，使用时按模型预估成本的 {{creditMultiplier}} 倍扣除</text>
        </view>
        <view class="credit-sheet-close ui-pressable" aria-role="button" aria-label="关闭" bindtap="closeCreditPurchase">×</view>
      </view>
      <view class="credit-pack-list">
        <view
          wx:for="{{creditPacks}}"
          wx:for-item="pack"
          wx:key="product_id"
          class="credit-pack ui-pressable {{pack.product_id === creditSelectedPackId ? 'is-selected' : ''}}"
          aria-role="radio"
          aria-checked="{{pack.product_id === creditSelectedPackId}}"
          aria-label="{{pack.title}}，{{pack.description}}，支付 {{pack.priceText}} 元"
          data-product-id="{{pack.product_id}}"
          bindtap="selectCreditPack"
        >
          <image wx:if="{{pack.iconPath}}" class="credit-pack-icon" src="{{pack.iconPath}}" mode="aspectFill"></image>
          <view class="credit-pack-copy">
            <text class="credit-pack-title">{{pack.title}}</text>
            <text class="credit-pack-description">{{pack.description}}</text>
            <text wx:if="{{pack.note}}" class="credit-pack-note">{{pack.note}}</text>
          </view>
          <view class="credit-pack-price">
            <text class="credit-pack-currency">¥</text><text class="credit-pack-amount ui-tabular">{{pack.priceText}}</text>
          </view>
        </view>
      </view>
      <view
        class="credit-sheet-confirm support-action ui-block-action ui-pressable"
        aria-role="button"
        bindtap="confirmCreditPurchase"
      >
        <block wx:for="{{creditPacks}}" wx:for-item="pack" wx:key="product_id">
          <text wx:if="{{pack.product_id === creditSelectedPackId}}">支付 ¥{{pack.priceText}}，购买{{pack.title}}</text>
        </block>
      </view>
      <text class="credit-sheet-footnote">额度仅用于本小程序的 AI 功能，不可提现</text>
    </view>
  </view>
</view>
