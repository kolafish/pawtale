<view class="{{pageClass}}">
  <view class="ui-page-context-row">
    <text class="ui-page-context">{{loggedIn ? "管理回忆录、语音工具和个人偏好" : "登录并继续记录家里的故事"}}</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <block wx:if="{{!loggedIn}}">
    <view class="guest-login-panel">
      <view class="guest-login-mark">余</view>
      <text class="panel-title">登录后管理你的回忆录</text>
      <text class="panel-copy">讲述记录、成书进度和个人设置都会跟随账号保存。</text>
      <view
        class="primary-button ui-block-action ui-pressable"
        aria-role="button"
        bindtap="openLogin"
      >
        前往登录
      </view>
    </view>

    <view class="section">
      <text class="section-title">显示与辅助</text>
      <view class="settings-card">
        <view class="switch-row">
          <view class="switch-copy">
            <text class="action-title">大字模式</text>
            <text class="action-meta">放大主要页面的文字和操作区域。</text>
          </view>
          <switch
            checked="{{largeTextEnabled}}"
            color="#a64b3e"
            aria-label="大字模式"
            bindchange="changeLargeText"
          />
        </view>
      </view>
    </view>
  </block>

  <block wx:if="{{loggedIn}}">
    <view class="profile-panel">
      <button
        class="profile-avatar-picker"
        open-type="chooseAvatar"
        disabled="{{avatarSaving || loading}}"
        bindchooseavatar="chooseWeChatAvatar"
        aria-label="更换微信头像"
        hover-class="profile-avatar-picker-hover"
      >
        <image wx:if="{{avatarUrl}}" class="avatar-image ui-image-outline" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar">
          <text>{{avatarText}}</text>
        </view>
        <text class="avatar-edit-badge">{{avatarSaving ? "…" : "换"}}</text>
      </button>
      <view class="profile-main">
        <view wx:if="{{editingName}}" class="name-edit-row">
          <input
            class="name-input"
            type="nickname"
            value="{{nameDraft}}"
            maxlength="40"
            placeholder="点击选择微信昵称"
            focus="{{editingName}}"
            bindinput="changeNameDraft"
          />
        </view>
        <text wx:else class="profile-name">{{displayName || "作者"}}</text>
        <text class="profile-email">{{accountEmailText || email || "正在加载账号"}}</text>
        <text wx:if="{{!editingName}}" class="profile-avatar-hint">点击头像可选择微信头像</text>
      </view>
      <view wx:if="{{editingName}}" class="profile-actions">
        <button class="mini-button ghost ui-pressable" disabled="{{savingName}}" bindtap="cancelEditName">取消</button>
        <button class="mini-button primary ui-pressable" loading="{{savingName}}" disabled="{{savingName}}" bindtap="saveDisplayName">
          保存
        </button>
      </view>
      <button wx:else class="edit-name-button ui-pressable" disabled="{{loading}}" bindtap="startEditName">编辑</button>
    </view>

    <view class="section">
      <view class="setting-header">
        <text class="section-title">当前回忆录</text>
        <text class="setting-current stats-refresh">{{voiceStatsLoading ? "更新中" : " "}}</text>
      </view>
      <view class="project-overview">
        <view class="project-overview-head">
          <view class="project-overview-main">
            <text class="action-title">{{projectTitle || "尚未创建回忆录"}}</text>
            <text class="action-meta">
              {{projectCount ? ("当前使用 · " + (utteranceCount ? (utteranceCount + " 条讲述记录") : "还没有讲述记录")) : "创建第一本回忆录并设置讲述资料"}}
            </text>
          </view>
        </view>

        <view class="overview-stats">
          <view class="overview-stat">
            <text class="overview-stat-value ui-tabular">{{sessionCount}}</text>
            <text class="overview-stat-label">讲述次数</text>
          </view>
          <view class="overview-stat">
            <text class="overview-stat-value ui-tabular">{{utteranceCount}}</text>
            <text class="overview-stat-label">讲述记录</text>
          </view>
          <view class="overview-stat">
            <text class="overview-stat-value ui-tabular">{{totalUserCharCount}}</text>
            <text class="overview-stat-label">文字</text>
          </view>
          <view class="overview-stat">
            <text class="overview-stat-value small ui-tabular">{{totalAudioText}}</text>
            <text class="overview-stat-label">录音</text>
          </view>
        </view>

        <view
          class="overview-button primary ui-block-action ui-pressable {{!projectCount ? 'is-disabled' : ''}}"
          aria-role="button"
          aria-disabled="{{!projectCount}}"
          bindtap="openVoiceProgress"
        >
          查看讲述进度
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-title">回忆录管理</text>
      <view class="settings-list">
        <view
          class="settings-nav-row"
          aria-role="button"
          aria-label="{{projectCount ? '管理回忆录' : '创建回忆录'}}"
          bindtap="openProjects"
          hover-class="settings-nav-row-hover"
        >
          <view class="settings-row-copy">
            <text class="action-title">{{projectCount ? "管理回忆录" : "创建回忆录"}}</text>
            <text class="action-meta">
              {{projectCount ? ("切换当前回忆录、编辑资料 · 共 " + projectCount + " 本") : "创建第一本回忆录后开始访谈"}}
            </text>
          </view>
          <text class="row-chevron">›</text>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-title">语音与工具</text>
      <view class="settings-list">
        <view
          class="settings-nav-row"
          aria-role="button"
          aria-label="多人实时转写"
          bindtap="openSpeakerTranscription"
          hover-class="settings-nav-row-hover"
        >
          <view class="settings-row-copy">
            <text class="action-title">多人实时转写</text>
            <text class="action-meta">临时区分多人对话，不保存到素材库。</text>
          </view>
          <text class="row-chevron">›</text>
        </view>

        <view
          class="settings-nav-row"
          aria-role="button"
          aria-label="查看声纹授权"
          bindtap="openVoiceAuthorization"
          hover-class="settings-nav-row-hover"
        >
          <view class="settings-row-copy">
            <text class="action-title">声纹授权</text>
            <text class="action-meta">{{voiceAuthorizationAgreed ? "已完成授权，点击查看协议详情。" : "开始语音前需要阅读并同意协议。"}}</text>
          </view>
          <view class="settings-row-tail">
            <text class="status-pill {{voiceAuthorizationAgreed ? 'ok' : 'warn'}}">{{voiceAuthorizationStatusText}}</text>
            <text class="row-chevron">›</text>
          </view>
        </view>

        <view
          class="settings-nav-row"
          aria-role="button"
          aria-label="语音与 AI 设置"
          bindtap="openVoiceSettings"
          hover-class="settings-nav-row-hover"
        >
          <view class="settings-row-copy">
            <text class="action-title">语音与 AI</text>
            <text class="action-meta">模型、音色、语速与访谈环境。</text>
          </view>
          <view class="settings-row-tail">
            <text class="row-value">{{aiModelLabel}}</text>
            <text class="row-chevron">›</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-title">显示与辅助</text>
      <view class="settings-card">
        <view class="switch-row">
          <view class="switch-copy">
            <text class="action-title">大字模式</text>
            <text class="action-meta">放大主要页面的文字和操作区域。</text>
          </view>
          <switch
            checked="{{largeTextEnabled}}"
            color="#a64b3e"
            aria-label="大字模式"
            bindchange="changeLargeText"
          />
        </view>
      </view>
    </view>

    <view wx:if="{{!passwordLoginEnabled}}" class="section">
      <text class="section-title">账号与安全</text>
      <view
        class="settings-disclosure"
        aria-role="button"
        aria-expanded="{{showAccountSettings}}"
        bindtap="toggleAccountSettings"
        hover-class="settings-nav-row-hover"
      >
        <view class="settings-disclosure-copy">
          <text class="action-title">补充邮箱登录</text>
          <text class="action-meta">也可以在 Web 端使用邮箱和密码登录。</text>
        </view>
        <text class="settings-disclosure-action">{{showAccountSettings ? "收起" : "设置"}}</text>
      </view>
      <view wx:if="{{showAccountSettings}}" class="credential-panel disclosure-content">
        <view class="field">
          <text class="field-label">邮箱</text>
          <input
            class="field-input"
            type="text"
            value="{{credentialEmail}}"
            placeholder="name@example.com"
            bindinput="changeCredentialEmail"
          />
        </view>

        <view class="field">
          <text class="field-label">密码</text>
          <input
            class="field-input"
            password
            value="{{credentialPassword}}"
            placeholder="至少 8 位"
            bindinput="changeCredentialPassword"
          />
        </view>

        <view
          class="primary-button ui-block-action ui-pressable {{loading || credentialsLoading ? 'is-disabled' : ''}}"
          aria-role="button"
          aria-disabled="{{loading || credentialsLoading}}"
          bindtap="submitCredentials"
        >
          {{credentialsLoading ? "保存中" : "设置邮箱密码"}}
        </view>
      </view>
    </view>

    <view
      class="logout-button ui-block-action ui-pressable {{loading ? 'is-disabled' : ''}}"
      aria-role="button"
      aria-disabled="{{loading}}"
      bindtap="logout"
    >{{loading ? "正在退出…" : "退出登录"}}</view>
  </block>
</view>
