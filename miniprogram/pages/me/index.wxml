<view class="ui-page-shell ui-accessible-page {{pageClass}}">
  <view class="ui-page-context-row">
    <text class="ui-page-context">{{loggedIn ? "管理回忆录、语音工具和个人偏好" : "登录并继续记录家里的故事"}}</text>
  </view>

  <view wx:if="{{error}}" class="error ui-error-banner">{{error}}</view>

  <block wx:if="{{!loggedIn}}">
    <view class="guest-login-panel ui-card ui-card-borderless">
      <view class="guest-login-mark">余</view>
      <text class="panel-title">登录后管理你的回忆录</text>
      <text class="panel-copy">讲述记录、成书进度和个人设置都会跟随账号保存。</text>
      <view
        class="primary-button support-action ui-block-action ui-pressable"
        aria-role="button"
        bindtap="openLogin"
      >
        前往登录
      </view>
    </view>

    <view class="section">
      <text class="section-title ui-section-heading">显示与辅助</text>
      <view class="settings-card ui-card ui-card-borderless">
        <view class="switch-row">
          <view class="switch-copy">
            <text class="action-title">大字模式</text>
            <text class="action-meta">放大主要页面的文字和操作区域。</text>
          </view>
          <switch
            checked="{{largeTextEnabled}}"
            color="#b65d49"
            aria-label="大字模式"
            bindchange="changeLargeText"
          />
        </view>
      </view>
    </view>
  </block>

  <block wx:if="{{loggedIn}}">
    <view class="profile-panel ui-card ui-card-borderless">
      <button
        class="profile-avatar-picker"
        open-type="chooseAvatar"
        disabled="{{avatarSaving || loading}}"
        bindchooseavatar="chooseWeChatAvatar"
        aria-label="更换微信头像"
        hover-class="ui-avatar-action-hover"
      >
        <image wx:if="{{avatarUrl}}" class="avatar-image ui-image-outline" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar">
          <text>{{avatarText}}</text>
        </view>
        <text class="avatar-edit-badge">{{avatarSaving ? "…" : "换"}}</text>
      </button>
      <view class="profile-main">
        <view wx:if="{{editingName}}" class="name-edit-row">
          <input
            class="name-input support-form-input"
            type="nickname"
            value="{{nameDraft}}"
            maxlength="40"
            placeholder="点击选择微信昵称"
            focus="{{editingName}}"
            bindinput="changeNameDraft"
          />
        </view>
        <text wx:else class="profile-name">{{displayName || "作者"}}</text>
        <text class="profile-email">{{accountEmailText || email || "正在加载账号"}}</text>
        <text wx:if="{{!editingName}}" class="profile-avatar-hint">点击头像可选择微信头像</text>
      </view>
      <view wx:if="{{editingName}}" class="profile-actions">
        <button class="mini-button ghost support-action ui-pressable" disabled="{{savingName}}" bindtap="cancelEditName">取消</button>
        <button class="mini-button primary support-action ui-pressable" loading="{{savingName}}" disabled="{{savingName}}" bindtap="saveDisplayName">
          保存
        </button>
      </view>
      <button wx:else class="edit-name-button support-action ui-pressable" disabled="{{loading}}" bindtap="startEditName">编辑</button>
    </view>

    <view class="section">
      <view class="setting-header">
        <text class="section-title ui-section-heading">当前回忆录</text>
        <text class="setting-current stats-refresh">{{voiceStatsLoading ? "更新中" : " "}}</text>
      </view>
      <view class="project-overview ui-card ui-card-borderless">
        <view class="project-overview-head">
          <view class="project-overview-main">
            <text class="action-title">{{projectTitle || "尚未创建回忆录"}}</text>
            <text class="action-meta">
              {{projectCount ? ("当前使用 · " + (utteranceCount ? (utteranceCount + " 段文字讲述") : "还没有文字讲述")) : "创建第一本回忆录并设置讲述资料"}}
            </text>
          </view>
        </view>

        <view class="overview-stats">
          <view class="overview-stat">
            <text class="overview-stat-value ui-tabular">{{sessionCount}}</text>
            <text class="overview-stat-label">讲述次数</text>
          </view>
          <view class="overview-stat">
            <text class="overview-stat-value ui-tabular">{{utteranceCount}}</text>
            <text class="overview-stat-label">文字讲述</text>
          </view>
          <view class="overview-stat">
            <text class="overview-stat-value ui-tabular">{{totalUserCharCount}}</text>
            <text class="overview-stat-label">文字</text>
          </view>
          <view class="overview-stat">
            <text class="overview-stat-value small ui-tabular">{{totalAudioText}}</text>
            <text class="overview-stat-label">录音</text>
          </view>
        </view>
        <text class="overview-stats-hint">这里统计已转成文字的讲述；尚未生成文字的录音也会显示在讲述记录列表中。</text>

      </view>
    </view>

    <view class="section">
      <view class="setting-header">
        <text class="section-title ui-section-heading">AI 使用额度</text>
        <text class="setting-current stats-refresh">{{creditLoading ? "更新中" : " "}}</text>
      </view>
      <view wx:if="{{creditAvailable}}" class="credit-card ui-card ui-card-borderless">
        <view class="credit-card-head">
          <view>
            <text class="action-title">当前可用 ¥{{creditRemainingText}}</text>
            <text class="action-meta">已使用 ¥{{creditUsedText}} / ¥{{creditTotalText}}</text>
          </view>
          <text class="credit-percent ui-tabular">{{creditProgressPercent}}%</text>
        </view>
        <view class="credit-progress-track" aria-label="AI 额度已使用 {{creditProgressPercent}}%">
          <view class="credit-progress-fill" style="width: {{creditProgressPercent}}%;"></view>
        </view>
        <text class="credit-hint">额度按 AI 实际调用成本计算。余额用尽后，可添加微信联系管理员。</text>
        <button class="credit-recharge-button support-action ui-pressable" bindtap="openRechargeQr">添加微信充值</button>
        <button class="credit-usage-toggle ui-pressable" bindtap="toggleCreditUsageDetails">
          {{creditUsageExpanded ? "收起使用明细" : "查看使用明细"}}
        </button>
        <view wx:if="{{creditUsageExpanded}}" class="credit-usage-list">
          <view wx:for="{{creditUsageItems}}" wx:key="id" class="credit-usage-row">
            <view class="credit-usage-copy">
              <text class="action-title">{{item.purpose}}</text>
              <text class="action-meta">{{item.timeText}}</text>
            </view>
            <text class="credit-usage-amount ui-tabular">-¥{{item.amountText}}</text>
          </view>
          <text wx:if="{{creditUsageLoading}}" class="credit-usage-message">正在加载…</text>
          <text wx:if="{{creditUsageError}}" class="credit-usage-message">{{creditUsageError}}</text>
          <text wx:if="{{!creditUsageLoading && !creditUsageError && !creditUsageItems.length}}" class="credit-usage-message">暂无扣费记录</text>
          <button wx:if="{{creditUsageError || (creditUsageHasMore && !creditUsageLoading)}}" class="credit-usage-more ui-pressable" bindtap="loadMoreCreditUsageDetails">
            {{creditUsageError ? "重新加载" : "加载更早记录"}}
          </button>
        </view>
      </view>
      <view wx:elif="{{creditError}}" class="credit-card ui-card ui-card-borderless credit-card-error">
        <text class="action-meta">{{creditError}}</text>
        <button class="credit-retry-button support-action ui-pressable" bindtap="loadAICreditSummary">重新加载</button>
      </view>
    </view>

    <view class="section">
      <text class="section-title ui-section-heading">回忆录管理</text>
      <view class="settings-list ui-card ui-card-borderless">
        <view
          class="settings-nav-row"
          aria-role="button"
          aria-label="{{projectCount ? '管理回忆录' : '创建回忆录'}}"
          bindtap="openProjects"
          hover-class="settings-nav-row-hover"
        >
          <view class="settings-row-copy">
            <text class="action-title">{{projectCount ? "管理回忆录" : "创建回忆录"}}</text>
            <text class="action-meta">
              {{projectCount ? ("切换当前回忆录、编辑设置 · 共 " + projectCount + " 本") : "创建第一本回忆录后开始访谈"}}
            </text>
          </view>
          <text class="row-chevron">›</text>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-title ui-section-heading">语音与工具</text>
      <view class="settings-list ui-card ui-card-borderless">
        <view
          class="settings-nav-row"
          aria-role="button"
          aria-label="查看语音授权"
          bindtap="openVoiceAuthorization"
          hover-class="settings-nav-row-hover"
        >
          <view class="settings-row-copy">
            <text class="action-title">语音授权</text>
            <text class="action-meta">{{voiceAuthorizationAgreed ? "已完成授权，点击查看协议详情。" : "开始语音前需要阅读并同意协议。"}}</text>
          </view>
          <view class="settings-row-tail">
            <text class="status-pill {{voiceAuthorizationAgreed ? 'ok' : 'warn'}}">{{voiceAuthorizationStatusText}}</text>
            <text class="row-chevron">›</text>
          </view>
        </view>

        <view
          class="settings-nav-row"
          aria-role="button"
          aria-label="语音与 AI 设置"
          bindtap="openVoiceSettings"
          hover-class="settings-nav-row-hover"
        >
          <view class="settings-row-copy">
            <text class="action-title">语音与 AI</text>
            <text class="action-meta">模型、音色、语速与访谈环境。</text>
          </view>
          <view class="settings-row-tail">
            <text class="row-value">{{aiModelLabel}}</text>
            <text class="row-chevron">›</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-title ui-section-heading">显示与辅助</text>
      <view class="settings-card ui-card ui-card-borderless">
        <view class="switch-row">
          <view class="switch-copy">
            <text class="action-title">大字模式</text>
            <text class="action-meta">放大主要页面的文字和操作区域。</text>
          </view>
          <switch
            checked="{{largeTextEnabled}}"
            color="#b65d49"
            aria-label="大字模式"
            bindchange="changeLargeText"
          />
        </view>
      </view>
    </view>

    <view
      class="logout-button support-action ui-block-action ui-pressable {{loading ? 'is-disabled' : ''}}"
      aria-role="button"
      aria-disabled="{{loading}}"
      bindtap="logout"
    >{{loading ? (deletingAccount ? "正在注销…" : "正在退出…") : "退出登录"}}</view>
    <button
      class="delete-account-button"
      hover-class="ui-subtle-action-hover"
      disabled="{{loading}}"
      bindtap="deleteAccount"
    >注销账号</button>
  </block>

  <view wx:if="{{rechargeQrVisible}}" class="recharge-qr-mask" catchtap="closeRechargeQr">
    <view class="recharge-qr-sheet" catchtap="stopRechargeQrTap">
      <text class="recharge-qr-title">添加微信充值</text>
      <text class="recharge-qr-copy">长按二维码识别并添加微信，提供你在小程序中的账号信息。</text>
      <image
        class="recharge-qr-image"
        src="/assets/recharge-wechat-qr.jpg"
        mode="widthFix"
        show-menu-by-longpress
        aria-label="微信二维码"
      />
      <button class="credit-retry-button support-action ui-pressable" bindtap="closeRechargeQr">关闭</button>
    </view>
  </view>
</view>
