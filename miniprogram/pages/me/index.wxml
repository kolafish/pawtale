<view class="me-page">
  <view class="header">
    <text class="page-title">我的</text>
    <text class="page-subtitle">账号、回忆录和语音访谈设置</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <block wx:if="{{!loggedIn}}">
    <view class="login-panel">
      <text class="panel-title">登录 Pawtale</text>
      <text class="panel-copy">
        登录后管理回忆录、转写和成书。
      </text>

      <button
        class="primary-button"
        loading="{{wechatLoading}}"
        disabled="{{loading || wechatLoading || credentialsLoading}}"
        bindtap="submitWeChat"
      >
        {{wechatLoading ? "微信登录中" : "微信登录"}}
      </button>

      <button
        class="mode-button"
        disabled="{{loading || wechatLoading || credentialsLoading}}"
        bindtap="toggleAccountMode"
      >
        {{accountMode ? "收起账号登录" : "使用 Pawtale 账号登录"}}
      </button>

      <view wx:if="{{accountMode}}" class="account-panel">
        <view class="field">
          <text class="field-label">邮箱</text>
          <input
            class="field-input"
            type="text"
            value="{{emailInput}}"
            placeholder="name@example.com"
            bindinput="changeEmailInput"
          />
        </view>

        <view class="field">
          <text class="field-label">密码</text>
          <input
            class="field-input"
            password
            value="{{password}}"
            placeholder="至少 8 位"
            bindinput="changePassword"
          />
        </view>

        <button
          class="secondary-button"
          loading="{{loading}}"
          disabled="{{loading || wechatLoading || credentialsLoading}}"
          bindtap="submitAccount"
        >
          {{loading ? "登录中" : "账号登录"}}
        </button>
      </view>
    </view>
  </block>

  <block wx:else>
  <view class="profile-panel">
    <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill" />
    <view wx:else class="avatar">
      <text>{{avatarText}}</text>
    </view>
    <view class="profile-main">
      <view wx:if="{{editingName}}" class="name-edit-row">
        <input
          class="name-input"
          value="{{nameDraft}}"
          maxlength="40"
          placeholder="填写昵称"
          focus="{{editingName}}"
          bindinput="changeNameDraft"
        />
      </view>
      <text wx:else class="profile-name">{{displayName || "作者"}}</text>
      <text class="profile-email">{{accountEmailText || email || "正在加载账号"}}</text>
    </view>
    <view wx:if="{{editingName}}" class="profile-actions">
      <button class="mini-button ghost" disabled="{{savingName}}" bindtap="cancelEditName">取消</button>
      <button class="mini-button primary" loading="{{savingName}}" disabled="{{savingName}}" bindtap="saveDisplayName">
        保存
      </button>
    </view>
    <button wx:else class="edit-name-button" disabled="{{loading}}" bindtap="startEditName">编辑</button>
  </view>

  <view wx:if="{{!passwordLoginEnabled}}" class="section">
    <text class="section-title">Web 登录账号</text>
    <view class="credential-panel">
      <view class="field">
        <text class="field-label">邮箱</text>
        <input
          class="field-input"
          type="text"
          value="{{credentialEmail}}"
          placeholder="name@example.com"
          bindinput="changeCredentialEmail"
        />
      </view>

      <view class="field">
        <text class="field-label">密码</text>
        <input
          class="field-input"
          password
          value="{{credentialPassword}}"
          placeholder="至少 8 位"
          bindinput="changeCredentialPassword"
        />
      </view>

      <button
        class="primary-button"
        loading="{{credentialsLoading}}"
        disabled="{{loading || credentialsLoading}}"
        bindtap="submitCredentials"
      >
        {{credentialsLoading ? "保存中" : "设置邮箱密码"}}
      </button>
    </view>
  </view>

  <view class="section">
    <text class="section-title">当前回忆录</text>
    <view class="action-card" bindtap="openProjects" hover-class="tap-hover">
      <view>
        <text class="action-title">{{projectTitle || "尚未创建回忆录"}}</text>
        <text class="action-meta">{{projectCount ? ("共 " + projectCount + " 本 · 管理项目") : "创建第一本回忆录并设置讲述资料"}}</text>
      </view>
      <text class="chevron">›</text>
    </view>
  </view>

  <view class="section">
    <text class="section-title">访谈管理</text>
    <view class="action-card" bindtap="openVoiceProgress" hover-class="tap-hover">
      <view>
        <text class="action-title">访谈进度</text>
        <text class="action-meta">查看会话、模块和累计文字</text>
      </view>
      <text class="chevron">›</text>
    </view>
  </view>

  <view class="section">
    <view class="setting-header">
      <text class="section-title">当前项目统计</text>
      <text wx:if="{{voiceStatsLoading}}" class="setting-current">更新中</text>
    </view>
    <view class="stats-grid">
      <view class="stat-card">
        <text class="stat-value">{{sessionCount}}</text>
        <text class="stat-label">会话</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{utteranceCount}}</text>
        <text class="stat-label">语音段</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{totalUserCharCount}}</text>
        <text class="stat-label">文字</text>
      </view>
      <view class="stat-card">
        <text class="stat-value small">{{totalAudioText}}</text>
        <text class="stat-label">录音</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="setting-header">
      <text class="section-title">语音聊天音色</text>
      <text class="setting-current">{{chatTTSVoiceLabel}}</text>
    </view>
    <view class="voice-options">
      <view
        wx:for="{{ttsVoiceOptions}}"
        wx:key="value"
        class="voice-option {{item.value === chatTTSVoice ? 'selected' : ''}}"
        data-scope="chat"
        data-voice="{{item.value}}"
        bindtap="selectTTSVoice"
        hover-class="tap-hover"
      >
        <text class="voice-label">{{item.label}}</text>
        <text class="voice-desc">{{item.description}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="setting-header">
      <text class="section-title">语音聊天语速</text>
      <text class="setting-current">{{chatTTSSpeedLabel}}</text>
    </view>
    <view class="voice-options">
      <view
        wx:for="{{ttsSpeedOptions}}"
        wx:key="value"
        class="voice-option {{item.value === chatTTSSpeedRatio ? 'selected' : ''}}"
        data-scope="chat"
        data-speed="{{item.value}}"
        bindtap="selectTTSSpeed"
        hover-class="tap-hover"
      >
        <text class="voice-label">{{item.label}}</text>
        <text class="voice-desc">{{item.description}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="setting-header">
      <text class="section-title">成书朗读音色</text>
      <text class="setting-current">{{bookTTSVoiceLabel}}</text>
    </view>
    <view class="voice-options">
      <view
        wx:for="{{ttsVoiceOptions}}"
        wx:key="value"
        class="voice-option {{item.value === bookTTSVoice ? 'selected' : ''}}"
        data-scope="book"
        data-voice="{{item.value}}"
        bindtap="selectTTSVoice"
        hover-class="tap-hover"
      >
        <text class="voice-label">{{item.label}}</text>
        <text class="voice-desc">{{item.description}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="setting-header">
      <text class="section-title">成书朗读语速</text>
      <text class="setting-current">{{bookTTSSpeedLabel}}</text>
    </view>
    <view class="voice-options">
      <view
        wx:for="{{ttsSpeedOptions}}"
        wx:key="value"
        class="voice-option {{item.value === bookTTSSpeedRatio ? 'selected' : ''}}"
        data-scope="book"
        data-speed="{{item.value}}"
        bindtap="selectTTSSpeed"
        hover-class="tap-hover"
      >
        <text class="voice-label">{{item.label}}</text>
        <text class="voice-desc">{{item.description}}</text>
      </view>
    </view>
  </view>

  <button class="logout-button" loading="{{loading}}" disabled="{{loading}}" bindtap="logout">退出登录</button>
  </block>
</view>
