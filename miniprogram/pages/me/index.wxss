@import "../../styles/support-forms.wxss";

.me-page {
  padding: 24rpx 36rpx 120rpx;
}

.delete-account-button {
  display: block;
  margin: 28rpx auto 0;
  padding: 12rpx 24rpx;
  border: 0;
  background: transparent;
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  text-decoration: underline;
}

.delete-account-button::after {
  border: 0;
}

.guest-login-panel {
  padding: 48rpx 36rpx 34rpx;
  text-align: center;
}

.guest-login-mark {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: var(--ui-success-surface);
  color: var(--ui-accent-strong);
  font-family: var(--ui-font-editorial);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 88rpx;
  text-align: center;
}

.panel-title,
.profile-name,
.action-title {
  display: block;
  color: var(--ui-text-primary);
  font-weight: 800;
  text-wrap: balance;
}

.panel-title {
  font-family: var(--ui-font-editorial);
  font-size: 38rpx;
  line-height: 1.3;
}

.panel-copy,
.action-meta {
  display: block;
  color: var(--ui-text-secondary);
  text-wrap: pretty;
}

.panel-copy {
  max-width: 520rpx;
  margin: 12rpx auto 0;
  font-size: 26rpx;
  line-height: 1.5;
}

.primary-button {
  width: 100%;
  min-height: 92rpx;
  margin-top: 28rpx;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  font-size: 29rpx;
  box-shadow: var(--ui-control-shadow);
}

.mini-button[disabled],
.edit-name-button[disabled],
.profile-avatar-picker[disabled] {
  opacity: 0.64;
}

.profile-panel {
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.profile-avatar-picker {
  position: relative;
  width: 92rpx;
  height: 92rpx;
  min-width: 92rpx;
  min-height: 92rpx;
  flex: 0 0 92rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  line-height: 1;
  overflow: visible;
  transition-property: transform, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.avatar,
.avatar-image {
  width: 92rpx;
  height: 92rpx;
  border-radius: 999rpx;
  flex: 0 0 92rpx;
}

.avatar {
  background: var(--ui-success-surface);
  color: var(--ui-accent-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--ui-font-editorial);
  font-size: 36rpx;
  font-weight: 800;
}

.avatar-edit-badge {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  font-size: 18rpx;
  font-weight: 800;
  line-height: 40rpx;
  text-align: center;
  box-shadow: var(--ui-control-shadow);
}

.profile-main,
.name-edit-row,
.project-overview-main,
.settings-row-copy,
.switch-copy {
  min-width: 0;
}

.profile-main,
.settings-row-copy,
.switch-copy {
  flex: 1;
}

.profile-name {
  font-family: var(--ui-font-editorial);
  font-size: 34rpx;
  line-height: 1.3;
}

.profile-email,
.profile-avatar-hint {
  display: block;
  line-height: 1.4;
}

.profile-email {
  margin-top: 6rpx;
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  overflow-wrap: anywhere;
}

.profile-avatar-hint {
  margin-top: 5rpx;
  color: var(--ui-accent);
  font-size: 21rpx;
  font-weight: 700;
}

.name-input {
  font-size: 30rpx;
  font-weight: 800;
}

.profile-actions {
  width: 144rpx;
  min-width: 0;
  display: grid;
  gap: 8rpx;
}

.profile-actions > button {
  width: 100%;
  min-width: 0;
}

.mini-button,
.edit-name-button {
  min-height: 88rpx;
  padding: 0;
  border-radius: 16rpx;
  background: transparent;
  color: var(--ui-accent-strong);
  font-size: 24rpx;
}

.mini-button.ghost {
  color: var(--ui-text-secondary);
}

.mini-button.primary,
.edit-name-button {
  background: var(--ui-accent-surface-subtle);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
}

.edit-name-button {
  flex: 0 0 96rpx;
  width: 96rpx;
}

.section {
  margin-top: 32rpx;
}

.section-title {
  margin-bottom: 14rpx;
}

.setting-header {
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.setting-header .section-title {
  margin-bottom: 0;
}

.setting-current {
  flex: 0 0 auto;
  color: var(--ui-value-text);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
}

.stats-refresh {
  min-width: 72rpx;
  text-align: right;
}

.action-title {
  font-size: 30rpx;
  line-height: 1.35;
}

.action-meta {
  margin-top: 7rpx;
  font-size: 24rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.project-overview {
  padding: 28rpx;
  background: var(--ui-success-surface);
  box-shadow: none;
}

.overview-stats {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(88, 112, 82, 0.14);
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.overview-stat {
  min-width: 0;
  padding: 2rpx 10rpx;
  text-align: center;
}

.overview-stat + .overview-stat {
  border-left: 1rpx solid rgba(88, 112, 82, 0.14);
}

.overview-stat-value {
  display: block;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.15;
  overflow-wrap: anywhere;
}

.overview-stat-value.small {
  font-family: inherit;
  font-size: 26rpx;
  line-height: 1.3;
}

.overview-stat-label {
  display: block;
  margin-top: 10rpx;
  color: var(--ui-success-text);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.3;
}

.settings-list {
  overflow: hidden;
}

.settings-nav-row {
  width: 100%;
  min-height: 112rpx;
  padding: 22rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  color: inherit;
  transition-property: background-color, opacity, transform;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.settings-nav-row + .settings-nav-row {
  border-top: 1rpx solid var(--ui-divider);
}

.settings-nav-row-hover {
  background: var(--ui-accent-surface-subtle);
  transform: scale(0.96);
}

.settings-row-tail {
  max-width: 44%;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
}

.row-value {
  max-width: 220rpx;
  color: var(--ui-value-text);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: right;
  overflow-wrap: anywhere;
}

.row-chevron {
  flex: 0 0 auto;
  color: var(--ui-accent);
  font-size: 42rpx;
  font-weight: 500;
  line-height: 1;
  transform: translateY(-1rpx);
}

.status-pill {
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.25;
  white-space: nowrap;
}

.status-pill.ok {
  background: var(--ui-success-surface);
  color: var(--ui-success-text);
}

.status-pill.warn {
  background: var(--ui-warning-surface);
  color: var(--ui-warning-text);
}

.settings-card {
  padding: 6rpx 26rpx;
}

.switch-row {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.logout-button {
  width: 100%;
  min-height: 88rpx;
  margin-top: 38rpx;
  border-radius: var(--ui-radius-control);
  background: transparent;
  color: var(--ui-danger-text);
  font-size: 28rpx;
  box-shadow: inset 0 0 0 1rpx rgba(168, 73, 63, 0.18);
}

.error {
  margin-bottom: 24rpx;
  font-size: 27rpx;
}

.me-page.large-text {
  padding-right: 24rpx;
  padding-left: 24rpx;
}

.me-page.large-text .panel-copy,
.me-page.large-text .action-meta,
.me-page.large-text .profile-email,
.me-page.large-text .setting-current,
.me-page.large-text .row-value {
  font-size: 28rpx;
  line-height: 1.5;
}

.me-page.large-text .overview-stat-label {
  font-size: 30rpx;
  line-height: 1.4;
}

.me-page.large-text .action-title,
.me-page.large-text .profile-name {
  font-size: 36rpx;
  line-height: 1.4;
}

.me-page.large-text .edit-name-button {
  flex-basis: 112rpx;
  width: 112rpx;
}

.me-page.large-text .overview-stats {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  row-gap: 22rpx;
}

.me-page.large-text .overview-stat:nth-child(3) {
  border-left: 0;
}

.me-page.large-text .overview-stat-value {
  font-size: 44rpx;
}

.me-page.large-text .overview-stat-value.small {
  font-size: 34rpx;
}

.me-page.large-text .settings-nav-row,
.me-page.large-text .switch-row {
  min-height: 132rpx;
}

.me-page.large-text .settings-row-tail {
  max-width: 36%;
}

.me-page.large-text .status-pill {
  font-size: 26rpx;
}
