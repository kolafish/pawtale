.me-page {
  min-height: 100vh;
  padding: 24rpx 36rpx 120rpx;
  background: var(--ui-page-background);
}

.profile-panel,
.guest-login-panel,
.credential-panel,
.project-overview,
.settings-card,
.settings-list,
.settings-disclosure {
  border: 0;
  border-radius: 26rpx;
  background: var(--ui-surface);
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.06),
    0 2rpx 4rpx rgba(64, 43, 24, 0.04),
    0 10rpx 28rpx rgba(64, 43, 24, 0.06);
}

.guest-login-panel {
  padding: 52rpx 36rpx 38rpx;
  text-align: center;
}

.guest-login-mark {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 26rpx;
  border-radius: 999rpx;
  background: #fff3ef;
  color: var(--ui-accent);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 96rpx;
  text-align: center;
}

.panel-title {
  display: block;
  color: var(--ui-text-primary);
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.28;
  text-wrap: balance;
}

.panel-copy {
  display: block;
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
  text-wrap: pretty;
}

.guest-login-panel .panel-copy {
  max-width: 520rpx;
  margin-right: auto;
  margin-left: auto;
}

.primary-button,
.overview-button,
.mini-button,
.edit-name-button,
.logout-button {
  max-width: none;
  margin-right: 0;
  margin-left: 0;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

.primary-button::after,
.overview-button::after,
.mini-button::after,
.edit-name-button::after,
.logout-button::after {
  border: 0;
}

.primary-button {
  width: 100%;
  height: 96rpx;
  min-height: 48px;
  margin-top: 28rpx;
  border-radius: 18rpx;
  background: var(--ui-accent);
  color: #ffffff;
  font-size: 30rpx;
}

.primary-button[disabled] {
  color: #ffffff;
  opacity: 0.64;
}

.profile-panel {
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar,
.avatar-image {
  width: 92rpx;
  height: 92rpx;
  border-radius: 999rpx;
  flex: 0 0 92rpx;
}

.avatar {
  background: var(--ui-accent);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
}

.avatar-image {
  background: #e8d8c3;
}

.profile-main,
.name-edit-row,
.project-overview-main,
.settings-row-copy,
.settings-disclosure-copy,
.switch-copy {
  min-width: 0;
}

.profile-main,
.settings-row-copy,
.settings-disclosure-copy,
.switch-copy {
  flex: 1;
}

.profile-name {
  display: block;
  color: var(--ui-text-primary);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
  text-wrap: balance;
}

.profile-email {
  display: block;
  margin-top: 6rpx;
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.name-input {
  width: 100%;
  height: 88rpx;
  min-height: 44px;
  padding: 0 18rpx;
  border: 2rpx solid #e8d8c3;
  border-radius: 16rpx;
  background: var(--ui-page-background);
  color: var(--ui-text-primary);
  font-size: 30rpx;
  font-weight: 800;
}

.profile-actions {
  width: 144rpx;
  min-width: 0;
  display: grid;
  gap: 10rpx;
}

.profile-actions > button {
  width: 100%;
  min-width: 0;
}

.mini-button {
  width: 100%;
  height: 88rpx;
  min-height: 44px;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.mini-button.ghost {
  background: #fff3ef;
  color: var(--ui-accent-strong);
}

.mini-button.primary,
.edit-name-button {
  background: var(--ui-accent);
  color: #ffffff;
}

.edit-name-button {
  flex: 0 0 96rpx;
  width: 96rpx;
  height: 88rpx;
  min-height: 44px;
  padding: 0;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.mini-button[disabled],
.edit-name-button[disabled] {
  opacity: 0.64;
}

.section {
  margin-top: 32rpx;
}

.section-title {
  display: block;
  margin-bottom: 14rpx;
  color: #7b4a40;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.35;
  text-wrap: balance;
}

.setting-header {
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.setting-header .section-title {
  margin-bottom: 0;
}

.setting-current {
  flex: 0 0 auto;
  color: var(--ui-accent);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
}

.stats-refresh {
  min-width: 72rpx;
  text-align: right;
}

.action-title {
  display: block;
  color: var(--ui-text-primary);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
  text-wrap: balance;
}

.action-meta {
  display: block;
  margin-top: 7rpx;
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
  text-wrap: pretty;
}

.project-overview {
  padding: 28rpx;
}

.project-overview-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.overview-stats {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
}

.overview-stat {
  min-width: 0;
  min-height: 98rpx;
  padding: 18rpx 10rpx;
  border-radius: 18rpx;
  background: #fcf7ed;
  text-align: center;
}

.overview-stat-value {
  display: block;
  color: var(--ui-text-primary);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.15;
  overflow-wrap: anywhere;
}

.overview-stat-value.small {
  font-size: 26rpx;
  line-height: 1.3;
}

.overview-stat-label {
  display: block;
  margin-top: 10rpx;
  color: #7b4a40;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.3;
}

.overview-button {
  width: 100%;
  height: 88rpx;
  min-height: 44px;
  margin-top: 22rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  line-height: 1;
}

.overview-button.primary {
  background: var(--ui-accent);
  color: #ffffff;
}

.overview-button[disabled] {
  opacity: 0.5;
}

.settings-list {
  width: 100%;
  overflow: hidden;
}

.settings-nav-row,
.settings-disclosure {
  width: 100%;
  min-height: 116rpx;
  padding: 24rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  color: inherit;
  transition-property: background-color, opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.settings-nav-row + .settings-nav-row {
  border-top: 1rpx solid rgba(43, 23, 19, 0.08);
}

.settings-nav-row-hover {
  background: #fff9f3;
}

.settings-row-tail {
  max-width: 44%;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
}

.row-value {
  max-width: 220rpx;
  color: var(--ui-accent);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: right;
  overflow-wrap: anywhere;
}

.row-chevron {
  flex: 0 0 auto;
  color: #b99a85;
  font-size: 42rpx;
  font-weight: 500;
  line-height: 1;
  transform: translateY(-1rpx);
}

.status-pill {
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.25;
  white-space: nowrap;
}

.status-pill.ok {
  background: var(--ui-success-surface);
  color: var(--ui-success-text);
}

.status-pill.warn {
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
}

.settings-card {
  padding: 8rpx 26rpx;
}

.switch-row {
  min-height: 118rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.settings-disclosure {
  box-sizing: border-box;
}

.settings-disclosure-action {
  min-width: 72rpx;
  flex: 0 0 auto;
  color: var(--ui-accent);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
  text-align: right;
}

.credential-panel {
  margin-top: 14rpx;
  padding: 28rpx;
}

.field + .field {
  margin-top: 24rpx;
}

.field-label {
  display: block;
  color: var(--ui-accent);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.3;
}

.field-input {
  height: 92rpx;
  margin-top: 12rpx;
  padding: 0 22rpx;
  border: 2rpx solid #e8d8c3;
  border-radius: 16rpx;
  background: var(--ui-page-background);
  color: var(--ui-text-primary);
  font-size: 29rpx;
}

.logout-button {
  width: 100%;
  height: 92rpx;
  min-height: 46px;
  margin-top: 38rpx;
  border-radius: 22rpx;
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
  font-size: 29rpx;
}

.logout-button[disabled] {
  opacity: 0.64;
}

.error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
  font-size: 27rpx;
  line-height: 1.45;
}

.me-page.large-text {
  padding-right: 24rpx;
  padding-left: 24rpx;
}

.me-page.large-text .panel-copy,
.me-page.large-text .action-meta,
.me-page.large-text .profile-email,
.me-page.large-text .setting-current,
.me-page.large-text .settings-disclosure-action,
.me-page.large-text .row-value {
  font-size: 28rpx;
  line-height: 1.5;
}

.me-page.large-text .section-title,
.me-page.large-text .field-label,
.me-page.large-text .overview-stat-label {
  font-size: 30rpx;
  line-height: 1.4;
}

.me-page.large-text .panel-title,
.me-page.large-text .action-title,
.me-page.large-text .profile-name {
  font-size: 36rpx;
  line-height: 1.4;
}

.me-page.large-text .field-input,
.me-page.large-text .name-input {
  min-height: 48px;
  font-size: 32rpx;
}

.me-page.large-text .primary-button,
.me-page.large-text .logout-button,
.me-page.large-text .overview-button,
.me-page.large-text .mini-button,
.me-page.large-text .edit-name-button {
  min-height: 48px;
  font-size: 30rpx;
  line-height: 1.35;
}

.me-page.large-text .edit-name-button {
  flex-basis: 112rpx;
  width: 112rpx;
}

.me-page.large-text .overview-stats {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.me-page.large-text .overview-stat {
  min-height: 114rpx;
  padding: 20rpx 14rpx;
}

.me-page.large-text .overview-stat-value {
  font-size: 44rpx;
}

.me-page.large-text .overview-stat-value.small {
  font-size: 34rpx;
}

.me-page.large-text .settings-nav-row,
.me-page.large-text .switch-row,
.me-page.large-text .settings-disclosure {
  min-height: 132rpx;
}

.me-page.large-text .settings-row-tail {
  max-width: 36%;
}

.me-page.large-text .status-pill {
  font-size: 26rpx;
}
