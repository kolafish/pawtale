.me-page {
  min-height: 100vh;
  padding: 30rpx 36rpx 120rpx;
  background: #fcf7ed;
}

.profile-panel,
.guest-login-panel,
.credential-panel,
.action-card,
.project-overview,
.voice-options,
.settings-card {
  border: 2rpx solid #e8d8c3;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(64, 43, 24, 0.07);
}

.guest-login-panel {
  padding: 56rpx 36rpx 40rpx;
  text-align: center;
}

.guest-login-mark {
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto 28rpx;
  border-radius: 999rpx;
  background: #fff3ef;
  color: #a64b3e;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 104rpx;
  text-align: center;
}

.credential-panel {
  padding: 30rpx;
}

.panel-title {
  display: block;
  color: #2b1713;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
}

.panel-copy {
  display: block;
  margin-top: 14rpx;
  color: #7b6f68;
  font-size: 26rpx;
  line-height: 1.45;
}

.guest-login-panel .panel-copy {
  max-width: 520rpx;
  margin-right: auto;
  margin-left: auto;
}

.field {
  margin-top: 28rpx;
}

.field-label {
  display: block;
  color: #a64b3e;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.2;
}

.field-input {
  height: 92rpx;
  margin-top: 14rpx;
  padding: 0 22rpx;
  border: 2rpx solid #e8d8c3;
  border-radius: 14rpx;
  background: #fcf7ed;
  color: #2b1713;
  font-size: 30rpx;
}

.primary-button {
  width: 100%;
  height: 98rpx;
  margin: 30rpx 0 0;
  border: 0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
}

.primary-button::after {
  border: 0;
}

.primary-button {
  background: #a64b3e;
  color: #ffffff;
}

.primary-button[disabled] {
  background: #a64b3e;
  color: #ffffff;
  opacity: 0.72;
}

.profile-panel {
  padding: 30rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: #a64b3e;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 800;
}

.avatar-image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  flex: 0 0 96rpx;
  background: #e8d8c3;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.profile-name {
  display: block;
  color: #2b1713;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.3;
}

.profile-email {
  display: block;
  margin-top: 8rpx;
  color: #7b6f68;
  font-size: 25rpx;
  line-height: 1.35;
  word-break: break-all;
}

.name-edit-row {
  min-width: 0;
}

.name-input {
  width: 100%;
  height: 88rpx;
  min-height: 44px;
  padding: 0 18rpx;
  border: 2rpx solid #e8d8c3;
  border-radius: 16rpx;
  background: #fcf7ed;
  color: #2b1713;
  font-size: 30rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.profile-actions {
  width: 148rpx;
  min-width: 0;
  display: grid;
  gap: 10rpx;
}

.profile-actions > button {
  width: 100%;
  min-width: 0;
}

.mini-button,
.edit-name-button {
  margin: 0;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

.mini-button::after,
.edit-name-button::after {
  border: 0;
}

.mini-button {
  height: 88rpx;
  min-height: 44px;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.mini-button.ghost {
  background: #fff3ef;
  color: #8f3e35;
}

.mini-button.primary,
.edit-name-button {
  background: #a64b3e;
  color: #ffffff;
}

.edit-name-button {
  flex: 0 0 96rpx;
  width: 96rpx;
  min-width: 0;
  height: 88rpx;
  min-height: 44px;
  padding: 0;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.mini-button[disabled],
.edit-name-button[disabled] {
  opacity: 0.66;
}

.section {
  margin-top: 30rpx;
}

.section-title {
  display: block;
  margin-bottom: 16rpx;
  color: #7b4a40;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.action-card {
  width: 100%;
  min-height: 112rpx;
  margin: 0;
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border: 2rpx solid #e8d8c3;
  color: inherit;
  text-align: left;
  line-height: normal;
}

.action-card::after,
.settings-disclosure::after,
.voice-option::after {
  border: 0;
}

.action-title {
  display: block;
  color: #2b1713;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.action-meta {
  display: block;
  margin-top: 10rpx;
  color: #7b6f68;
  font-size: 25rpx;
  line-height: 1.35;
}

.project-overview {
  padding: 28rpx 30rpx;
}

.project-overview-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.project-overview-main {
  min-width: 0;
}

.overview-stats {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.overview-stat {
  min-height: 104rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: #fcf7ed;
  box-sizing: border-box;
}

.overview-stat-value {
  display: block;
  color: #2b1713;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.15;
}

.overview-stat-value.small {
  font-size: 34rpx;
  line-height: 1.25;
}

.overview-stat-label {
  display: block;
  margin-top: 14rpx;
  color: #7b4a40;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
}

.overview-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

.overview-button {
  height: 88rpx;
  min-height: 44px;
  margin: 0;
  border: 0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
}

.overview-button::after {
  border: 0;
}

.overview-button.primary {
  background: #a64b3e;
  color: #ffffff;
}

.overview-button[disabled] {
  opacity: 0.62;
}

.setting-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.setting-header .section-title {
  margin-bottom: 0;
}

.setting-current {
  flex: 0 0 auto;
  color: #a64b3e;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.setting-current.ok {
  color: var(--ui-success-text);
}

.setting-current.warn {
  color: #b84a5a;
}

.stats-refresh {
  min-width: 72rpx;
  text-align: right;
}

.voice-options {
  padding: 12rpx;
  display: grid;
  gap: 10rpx;
}

.settings-card {
  padding: 10rpx 28rpx;
}

.switch-row {
  min-height: 126rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
}

.switch-copy {
  flex: 1;
  min-width: 0;
}

.settings-disclosure {
  width: 100%;
  min-height: 44px;
  margin: 0;
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  border: 2rpx solid #e8d8c3;
  border-radius: 24rpx;
  background: #fff;
  color: inherit;
  text-align: left;
  line-height: normal;
  box-shadow: 0 12rpx 32rpx rgba(64, 43, 24, 0.07);
  transition: transform 140ms ease-out;
}

.settings-disclosure:active {
  transform: scale(0.98);
}

.settings-disclosure-copy {
  min-width: 0;
  flex: 1;
}

.settings-disclosure-action {
  flex: 0 0 auto;
  color: #a64b3e;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.3;
}

.disclosure-content {
  margin-top: 16rpx;
}

.settings-subsection {
  margin-top: 18rpx;
}

.voice-option {
  width: 100%;
  min-height: 44px;
  margin: 0;
  padding: 20rpx 22rpx;
  border: 2rpx solid transparent;
  border-radius: 18rpx;
  background: transparent;
  color: inherit;
  text-align: left;
  line-height: normal;
}

.voice-option.selected {
  border-color: #a64b3e;
  background: #fff9f3;
}

.voice-label {
  display: block;
  color: #2b1713;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.voice-desc {
  display: block;
  margin-top: 8rpx;
  color: #7b6f68;
  font-size: 24rpx;
  line-height: 1.35;
}

.chevron {
  color: #a64b3e;
  font-size: 58rpx;
  line-height: 1;
}

.logout-button {
  width: 100%;
  height: 94rpx;
  margin: 38rpx 0 0;
  border: 0;
  border-radius: 24rpx;
  background: #fff1f3;
  color: #b84a5a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
}

.logout-button::after {
  border: 0;
}

.logout-button[disabled] {
  opacity: 0.66;
}

.me-page.large-text {
  padding: 28rpx 24rpx 120rpx;
}

.me-page.large-text .panel-copy,
.me-page.large-text .action-meta,
.me-page.large-text .voice-desc,
.me-page.large-text .profile-email,
.me-page.large-text .setting-current,
.me-page.large-text .settings-disclosure-action {
  font-size: 30rpx;
  line-height: 1.5;
}

.me-page.large-text .section-title,
.me-page.large-text .field-label,
.me-page.large-text .overview-stat-label {
  font-size: 30rpx;
  line-height: 1.4;
}

.me-page.large-text .panel-title,
.me-page.large-text .action-title,
.me-page.large-text .profile-name,
.me-page.large-text .voice-label {
  font-size: 38rpx;
  line-height: 1.4;
}

.me-page.large-text .field-input,
.me-page.large-text .name-input {
  min-height: 48px;
  font-size: 32rpx;
}

.me-page.large-text .primary-button,
.me-page.large-text .logout-button,
.me-page.large-text .overview-button,
.me-page.large-text .mini-button,
.me-page.large-text .edit-name-button {
  min-height: 48px;
  font-size: 30rpx;
  line-height: 1.35;
}

.me-page.large-text .edit-name-button {
  flex-basis: 112rpx;
  width: 112rpx;
}

.me-page.large-text .overview-stat-value {
  font-size: 48rpx;
}

.me-page.large-text .overview-stat-value.small {
  font-size: 40rpx;
}

.me-page.large-text .voice-option,
.me-page.large-text .switch-row,
.me-page.large-text .action-card,
.me-page.large-text .settings-disclosure {
  min-height: 120rpx;
}

.error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff1f3;
  color: #b84a5a;
  font-size: 28rpx;
  line-height: 1.45;
}
