.me-page {
  min-height: 100vh;
  padding: 52rpx 36rpx 120rpx;
  background: #fcf7ed;
}

.header {
  margin-bottom: 30rpx;
}

.page-title {
  display: block;
  color: #2b1713;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.2;
}

.page-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #7b6f68;
  font-size: 28rpx;
  line-height: 1.4;
}

.profile-panel,
.login-panel,
.credential-panel,
.action-card,
.project-overview,
.voice-options,
.settings-card {
  border: 2rpx solid #e8d8c3;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(64, 43, 24, 0.07);
}

.login-panel {
  padding: 36rpx 32rpx;
}

.credential-panel {
  padding: 30rpx;
}

.panel-title {
  display: block;
  color: #2b1713;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
}

.panel-copy {
  display: block;
  margin-top: 14rpx;
  color: #7b6f68;
  font-size: 26rpx;
  line-height: 1.45;
}

.field {
  margin-top: 28rpx;
}

.field-label {
  display: block;
  color: #a64b3e;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.2;
}

.field-input {
  height: 92rpx;
  margin-top: 14rpx;
  padding: 0 22rpx;
  border: 2rpx solid #e8d8c3;
  border-radius: 14rpx;
  background: #fcf7ed;
  color: #2b1713;
  font-size: 30rpx;
}

.account-panel {
  margin-top: 12rpx;
}

.primary-button,
.mode-button,
.secondary-button {
  width: 100%;
  height: 98rpx;
  margin: 30rpx 0 0;
  border: 0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
}

.primary-button::after,
.mode-button::after,
.secondary-button::after {
  border: 0;
}

.primary-button {
  background: #a64b3e;
  color: #ffffff;
}

.mode-button {
  background: #fff3ef;
  color: #a64b3e;
}

.secondary-button {
  background: #2b1713;
  color: #ffffff;
}

.primary-button[disabled] {
  background: #a64b3e;
  color: #ffffff;
  opacity: 0.72;
}

.mode-button[disabled] {
  background: #fff3ef;
  color: #a64b3e;
  opacity: 0.72;
}

.secondary-button[disabled] {
  background: #2b1713;
  color: #ffffff;
  opacity: 0.72;
}

.profile-panel {
  padding: 30rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: #a64b3e;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 800;
}

.avatar-image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  flex: 0 0 96rpx;
  background: #e8d8c3;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.profile-name {
  display: block;
  color: #2b1713;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.3;
}

.profile-email {
  display: block;
  margin-top: 8rpx;
  color: #7b6f68;
  font-size: 25rpx;
  line-height: 1.35;
  word-break: break-all;
}

.name-edit-row {
  min-width: 0;
}

.name-input {
  width: 100%;
  height: 72rpx;
  padding: 0 18rpx;
  border: 2rpx solid #e8d8c3;
  border-radius: 16rpx;
  background: #fcf7ed;
  color: #2b1713;
  font-size: 30rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.profile-actions {
  width: 148rpx;
  display: grid;
  gap: 10rpx;
}

.mini-button,
.edit-name-button {
  margin: 0;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

.mini-button::after,
.edit-name-button::after {
  border: 0;
}

.mini-button {
  height: 56rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.mini-button.ghost {
  background: #fff3ef;
  color: #8f3e35;
}

.mini-button.primary,
.edit-name-button {
  background: #a64b3e;
  color: #ffffff;
}

.edit-name-button {
  width: 96rpx;
  height: 60rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.mini-button[disabled],
.edit-name-button[disabled] {
  opacity: 0.66;
}

.section {
  margin-top: 30rpx;
}

.section-title {
  display: block;
  margin-bottom: 16rpx;
  color: #7b4a40;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.action-card {
  min-height: 112rpx;
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.debug-card {
  background: #fffdf9;
}

.action-title {
  display: block;
  color: #2b1713;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.action-meta {
  display: block;
  margin-top: 10rpx;
  color: #7b6f68;
  font-size: 25rpx;
  line-height: 1.35;
}

.project-overview {
  padding: 28rpx 30rpx;
}

.project-overview-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.project-overview-main {
  min-width: 0;
}

.overview-stats {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.overview-stat {
  min-height: 104rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: #fcf7ed;
  box-sizing: border-box;
}

.overview-stat-value {
  display: block;
  color: #2b1713;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.15;
}

.overview-stat-value.small {
  font-size: 34rpx;
  line-height: 1.25;
}

.overview-stat-label {
  display: block;
  margin-top: 14rpx;
  color: #7b4a40;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
}

.overview-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

.overview-button {
  height: 76rpx;
  margin: 0;
  border: 0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
}

.overview-button::after {
  border: 0;
}

.overview-button.primary {
  background: #a64b3e;
  color: #ffffff;
}

.overview-button[disabled] {
  opacity: 0.62;
}

.setting-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.setting-header .section-title {
  margin-bottom: 0;
}

.setting-current {
  flex: 0 0 auto;
  color: #a64b3e;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.setting-current.ok {
  color: #147d64;
}

.setting-current.warn {
  color: #b84a5a;
}

.stats-refresh {
  min-width: 72rpx;
  text-align: right;
}

.voice-options {
  padding: 12rpx;
  display: grid;
  gap: 10rpx;
}

.settings-card {
  padding: 10rpx 28rpx;
}

.switch-row {
  min-height: 126rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
}

.switch-copy {
  flex: 1;
  min-width: 0;
}

.settings-divider {
  height: 1rpx;
  background: rgba(43, 23, 19, 0.08);
}

.voice-option {
  padding: 20rpx 22rpx;
  border: 2rpx solid transparent;
  border-radius: 18rpx;
}

.voice-option.selected {
  border-color: #a64b3e;
  background: #fff9f3;
}

.voice-label {
  display: block;
  color: #2b1713;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.voice-desc {
  display: block;
  margin-top: 8rpx;
  color: #7b6f68;
  font-size: 24rpx;
  line-height: 1.35;
}

.chevron {
  color: #a64b3e;
  font-size: 58rpx;
  line-height: 1;
}

.logout-button {
  width: 100%;
  height: 94rpx;
  margin: 38rpx 0 0;
  border: 0;
  border-radius: 24rpx;
  background: #fff1f3;
  color: #b84a5a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
}

.logout-button::after {
  border: 0;
}

.logout-button[disabled] {
  opacity: 0.66;
}

.error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff1f3;
  color: #b84a5a;
  font-size: 28rpx;
  line-height: 1.45;
}

.tap-hover {
  opacity: 0.82;
}
