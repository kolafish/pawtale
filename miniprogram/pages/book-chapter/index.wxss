.chapter-detail-page {
  min-height: 100vh;
  padding: 44rpx 32rpx 120rpx;
  background: #fcf7ed;
  box-sizing: border-box;
}

.top-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 28rpx;
}

.back-hit {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-mark {
  color: #a64b3e;
  font-size: 72rpx;
  line-height: 1;
}

.title-block {
  min-width: 0;
}

.page-title {
  display: block;
  color: #2b1713;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 52rpx;
}

.page-meta {
  display: block;
  margin-top: 8rpx;
  color: #7b6f68;
  font-size: 26rpx;
  line-height: 1.35;
}

.error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff1f3;
  color: #b84a5a;
  font-size: 28rpx;
  line-height: 1.45;
  word-break: break-word;
}

.empty-panel,
.hero-panel,
.section-card {
  margin-top: 24rpx;
  border: 1rpx solid #e8d8c3;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(93, 61, 42, 0.06);
  box-sizing: border-box;
}

.empty-panel {
  padding: 48rpx 34rpx;
  color: #7b6f68;
  font-size: 30rpx;
  line-height: 1.5;
}

.empty-title {
  display: block;
  color: #2b1713;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-copy {
  display: block;
  margin-top: 14rpx;
  color: #7b6f68;
  font-size: 28rpx;
  line-height: 1.5;
}

.hero-panel {
  padding: 32rpx;
  border-color: #e8d8c3;
  background: #fff9f3;
}

.chapter-kicker-row,
.section-head,
.source-head {
  display: flex;
  align-items: center;
}

.chapter-kicker-row,
.section-head {
  justify-content: space-between;
  gap: 18rpx;
}

.chapter-index {
  color: #a64b3e;
  font-size: 25rpx;
  font-weight: 600;
}

.chapter-status {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff2d9;
  color: #9a6a24;
  font-size: 24rpx;
  font-weight: 600;
}

.chapter-status.confirmed {
  background: #eef4ea;
  color: #5f7e55;
}

.chapter-title {
  display: block;
  margin-top: 16rpx;
  color: #2b1713;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 54rpx;
  word-break: break-word;
}

.chapter-meta,
.chapter-notice {
  display: block;
  margin-top: 12rpx;
  color: #7b6f68;
  font-size: 26rpx;
  line-height: 1.45;
}

.chapter-notice {
  color: #a64b3e;
  font-weight: 700;
}

.tab-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 28rpx;
  padding: 8rpx;
  border-radius: 20rpx;
  background: #f0e5d8;
}

.tab-item {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #7b6f68;
  font-size: 27rpx;
  font-weight: 600;
}

.tab-item.active {
  background: #ffffff;
  color: #a64b3e;
  box-shadow: 0 6rpx 16rpx rgba(93, 61, 42, 0.06);
}

.section-card {
  padding: 28rpx;
}

.section-head {
  margin-bottom: 18rpx;
}

.section-heading {
  flex: 1 1 auto;
  min-width: 0;
}

.section-title,
.section-hint,
.section-count {
  display: block;
}

.section-title {
  color: #2b1713;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.section-hint {
  margin-top: 6rpx;
  color: #7b6f68;
  font-size: 24rpx;
  line-height: 1.35;
}

.section-count {
  flex: 0 0 auto;
  color: #8b6a55;
  font-size: 24rpx;
  font-weight: 600;
}

.manuscript-card {
  background: #fffcf7;
  border-color: #e8d8c3;
}

.title-card,
.action-card {
  background: #fff9f3;
}

.chapter-title-input,
.draft-textarea {
  width: 100%;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e8d8c3;
  border-radius: 18rpx;
  background: #fffcf7;
  color: #3a2a25;
  font-size: 30rpx;
  line-height: 48rpx;
  box-sizing: border-box;
}

.chapter-title-input {
  height: 82rpx;
}

.draft-textarea {
  min-height: 420rpx;
}

.actions-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.actions-row.compact {
  flex-wrap: wrap;
}

.primary-button,
.ghost-button {
  min-height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 22rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.2;
}

.primary-button {
  background: #a64b3e;
  color: #ffffff;
}

.ghost-button {
  border: 1rpx solid #d8c4b2;
  background: #ffffff;
  color: #7b4a40;
}

.primary-button::after,
.ghost-button::after {
  border: 0;
}

.primary-button[disabled],
.ghost-button[disabled] {
  opacity: 0.52;
}

.draft-empty {
  min-height: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 18rpx;
  color: #7b6f68;
  font-size: 28rpx;
}

.chapter-error {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #fff1f3;
  color: #b84a5a;
  font-size: 26rpx;
  line-height: 1.45;
  word-break: break-word;
}

.chapter-error.inline {
  margin-bottom: 20rpx;
}

.chapter-action-groups {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.chapter-action-group {
  padding: 20rpx;
  border: 1rpx solid #f0e5d8;
  border-radius: 20rpx;
  background: #fffcf7;
}

.chapter-action-label {
  display: block;
  color: #2b1713;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.chapter-action-hint {
  display: block;
  margin-top: 12rpx;
  color: #7b6f68;
  font-size: 24rpx;
  line-height: 1.45;
}

.picker-button {
  margin-top: 18rpx;
  min-height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d8c4b2;
  border-radius: 22rpx;
  background: #ffffff;
  color: #7b4a40;
  font-size: 27rpx;
  font-weight: 600;
}

.picker-button.disabled {
  opacity: 0.52;
}

.split-source-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.source-main {
  flex: 1 1 auto;
  min-width: 0;
}

.source-row.selected {
  border-color: #a64b3e;
  background: #fff3ef;
}

.source-split-toggle {
  flex: 0 0 auto;
  min-width: 104rpx;
  min-height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid #d8c4b2;
  border-radius: 18rpx;
  background: #ffffff;
  color: #7b4a40;
  font-size: 24rpx;
  font-weight: 600;
}

.source-split-toggle.selected {
  border-color: #a64b3e;
  background: #a64b3e;
  color: #ffffff;
}

.source-split-toggle::after {
  border: 0;
}

.split-action {
  margin-top: 18rpx;
}

.danger-zone {
  border-color: #f3c4cc;
  background: #fff7f7;
}

.danger-button {
  min-height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 18rpx 0 0;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: #b84a5a;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.2;
}

.danger-button::after {
  border: 0;
}

.danger-button[disabled] {
  opacity: 0.52;
}

.body-text {
  display: block;
  color: #2b211d;
  font-size: 32rpx;
  line-height: 60rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

.manuscript-text {
  min-height: 240rpx;
}

.source-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.source-row {
  padding: 22rpx;
  border: 1rpx solid #f0e5d8;
  border-radius: 18rpx;
  background: #fff5f1;
}

.source-head {
  justify-content: space-between;
  gap: 16rpx;
}

.source-label {
  color: #2b1713;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.source-meta {
  flex: 0 0 auto;
  color: #7b6f68;
  font-size: 23rpx;
}

.source-text {
  display: block;
  margin-top: 10rpx;
  color: #6e5e56;
  font-size: 26rpx;
  line-height: 1.5;
  word-break: break-word;
}
