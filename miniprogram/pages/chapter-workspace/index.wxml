<view class="workspace-page">
  <view class="page-header">
    <view class="back-hit" bindtap="goBack"><text class="back-mark">‹</text></view>
    <view class="header-main">
      <text class="page-title">{{workspace ? workspace.chapter_title : "章节工作台"}}</text>
      <text class="page-meta">{{contractStatusText}}</text>
    </view>
    <button wx:if="{{activeTab !== 'overview'}}" class="audit-button" loading="{{auditBusy}}" disabled="{{auditBusy}}" bindtap="startAudit">
      {{auditBusy ? "检查中" : "重新检查"}}
    </button>
  </view>

  <view wx:if="{{error}}" class="message error-message">{{error}}</view>
  <view wx:if="{{activeTab !== 'overview'}}" class="audit-state {{auditError ? 'failed' : ''}}">
    <text class="audit-state-title">{{auditStatusText}}</text>
    <text wx:if="{{auditError}}" class="audit-state-error">{{auditError}}</text>
  </view>

  <view wx:if="{{loading && !workspace}}" class="empty-state">正在加载</view>

  <block wx:if="{{workspace}}">
    <view wx:if="{{activeTab === 'overview'}}" class="overview-section">
      <text class="overview-eyebrow">{{nextAction.eyebrow}}</text>
      <text class="overview-title">{{nextAction.title}}</text>
      <text class="overview-detail">{{nextAction.detail}}</text>
      <view wx:if="{{contractRevisionError}}" class="message error-message">{{contractRevisionError}}</view>
      <button
        wx:if="{{nextAction.actionText}}"
        class="overview-primary-action"
        loading="{{contractRevisionBusy || auditBusy || draftGenerationBusy}}"
        disabled="{{nextAction.disabled || contractRevisionBusy || auditBusy || draftGenerationBusy}}"
        bindtap="runNextAction"
      >{{nextAction.actionText}}</button>
      <button class="overview-detail-action" data-tab="structure" bindtap="changeTab">查看详细内容</button>
    </view>

    <block wx:else>
      <button class="overview-return" data-tab="overview" bindtap="changeTab">返回本章下一步</button>
      <view class="tab-bar">
        <view class="tab {{activeTab === 'structure' ? 'active' : ''}}" data-tab="structure" bindtap="changeTab">本章方向</view>
        <view class="tab {{activeTab === 'stories' ? 'active' : ''}}" data-tab="stories" bindtap="changeTab">素材内容</view>
        <view class="tab {{activeTab === 'drafts' ? 'active' : ''}}" data-tab="drafts" bindtap="changeTab">本章正文</view>
        <view class="tab {{activeTab === 'checks' ? 'active' : ''}}" data-tab="checks" bindtap="changeTab">待处理</view>
        <view class="tab {{activeTab === 'followups' ? 'active' : ''}}" data-tab="followups" bindtap="changeTab">补充问题</view>
      </view>

    <view wx:if="{{activeTab === 'structure'}}" class="content-section">
      <view wx:if="{{workspace.contract}}" class="contract-band">
        <view class="contract-heading">
          <text class="section-label">本章方向</text>
          <view class="contract-actions">
            <button
              disabled="{{contractActionBusy || structureActionBusy}}"
              bindtap="startContractEdit"
            >{{workspace.contract.status === 'confirmed' ? "调整本章内容" : "编辑本章方向"}}</button>
            <button
              wx:if="{{workspace.contract.status === 'draft'}}"
              class="compact-primary-button"
              loading="{{contractActionBusy}}"
              disabled="{{contractActionBusy || structureActionBusy}}"
              bindtap="confirmContract"
            >确认本章方向</button>
          </view>
        </view>

        <view wx:if="{{contractEditorOpen}}" class="contract-editor">
          <text class="field-label">章节目标</text>
          <textarea
            class="structure-textarea"
            value="{{contractObjective}}"
            maxlength="2000"
            auto-height
            bindinput="changeContractObjective"
          ></textarea>
          <text class="field-label">读者读完应理解什么</text>
          <textarea
            class="structure-textarea"
            value="{{contractReaderTakeaway}}"
            maxlength="2000"
            auto-height
            bindinput="changeContractReaderTakeaway"
          ></textarea>
          <text class="field-label">时间或主题范围</text>
          <input
            class="structure-input"
            value="{{contractTimeScopeText}}"
            maxlength="1000"
            bindinput="changeContractTimeScope"
          />
          <text class="field-label">核心问题</text>
          <textarea
            class="structure-textarea questions"
            value="{{contractQuestionsText}}"
            maxlength="4000"
            auto-height
            placeholder="每行一个核心问题"
            bindinput="changeContractQuestions"
          ></textarea>
          <view class="form-actions">
            <button disabled="{{contractActionBusy}}" bindtap="cancelContractEdit">取消</button>
            <button
              class="compact-primary-button"
              loading="{{contractActionBusy}}"
              disabled="{{contractActionBusy || structureActionBusy}}"
              bindtap="saveContractRevision"
            >保存新版本</button>
          </view>
        </view>
        <block wx:else>
          <text class="contract-objective">{{workspace.contract.objective}}</text>
          <text class="contract-takeaway">{{workspace.contract.reader_takeaway}}</text>
          <text wx:if="{{workspace.contract.time_scope_text}}" class="contract-scope">{{workspace.contract.time_scope_text}}</text>
          <view wx:if="{{workspace.contract.core_questions.length}}" class="contract-question-list">
            <text wx:for="{{workspace.contract.core_questions}}" wx:key="key" class="contract-question">{{index + 1}}. {{item.question}}</text>
          </view>
        </block>
        <text wx:if="{{contractActionStatus}}" class="structure-status">{{contractActionStatus}}</text>
      </view>
      <view wx:else class="contract-band empty-contract">
        <text class="empty-state">本章方向还没有确定</text>
        <button
          class="compact-primary-button"
          disabled="{{contractActionBusy}}"
          bindtap="startContractEdit"
        >整理本章方向</button>
        <view wx:if="{{contractEditorOpen}}" class="contract-editor">
          <textarea class="structure-textarea" value="{{contractObjective}}" placeholder="这章主要写什么" auto-height bindinput="changeContractObjective"></textarea>
          <textarea class="structure-textarea" value="{{contractReaderTakeaway}}" placeholder="读者读完应理解什么" auto-height bindinput="changeContractReaderTakeaway"></textarea>
          <input class="structure-input" value="{{contractTimeScopeText}}" placeholder="时间或主题范围" bindinput="changeContractTimeScope" />
          <textarea class="structure-textarea questions" value="{{contractQuestionsText}}" placeholder="核心问题，每行一个" auto-height bindinput="changeContractQuestions"></textarea>
          <view class="form-actions">
            <button disabled="{{contractActionBusy}}" bindtap="cancelContractEdit">取消</button>
            <button class="compact-primary-button" loading="{{contractActionBusy}}" disabled="{{contractActionBusy}}" bindtap="saveContractRevision">保存草稿</button>
          </view>
        </view>
      </view>

      <view class="topology-band">
        <view class="section-heading topology-heading">
          <text class="section-title">调整本章内容</text>
          <button
            disabled="{{structureActionBusy || contractActionBusy || !workspace.contract || workspace.contract.status !== 'draft'}}"
            bindtap="openSplitEditor"
          >拆分本章</button>
        </view>
        <view class="merge-controls">
          <picker
            mode="selector"
            range="{{mergeOptions}}"
            range-key="label"
            disabled="{{structureActionBusy || contractActionBusy || !mergeOptions.length}}"
            bindchange="changeMergeTarget"
          >
            <view class="merge-target-picker {{structureActionBusy || !mergeOptions.length ? 'disabled' : ''}}">{{mergeTargetTitle || "选择合并目标章节"}}</view>
          </picker>
          <button
            class="compact-danger-button"
            loading="{{structureActionBusy}}"
            disabled="{{structureActionBusy || contractActionBusy || !mergeTargetChapterId || !workspace.contract || workspace.contract.status !== 'draft'}}"
            bindtap="mergeCurrentChapter"
          >合并当前章节</button>
        </view>
        <text wx:if="{{topologyActionStatus}}" class="structure-status">{{topologyActionStatus}}</text>
        <text wx:if="{{topologyError}}" class="structure-error">{{topologyError}}</text>
      </view>

      <view class="section-heading">
        <text class="section-title">内容顺序</text>
        <text class="section-count">{{nodes.length}} 个</text>
      </view>
      <checkbox-group wx:if="{{nodes.length}}" class="node-list" bindchange="changeSplitNodeSelection">
        <view wx:for="{{nodes}}" wx:for-item="node" wx:key="id" class="node-row">
          <checkbox
            wx:if="{{splitEditorOpen}}"
            class="split-node-checkbox"
            value="{{node.id}}"
            checked="{{node.selectedForSplit}}"
            color="#a7483c"
          />
          <view class="node-order">{{index + 1}}</view>
          <view class="node-main">
            <block wx:if="{{editingNodeId === node.id}}">
              <input class="node-edit-input" value="{{editingNodeTitle}}" maxlength="120" placeholder="节点标题" bindinput="changeNodeTitle" />
              <textarea class="node-edit-purpose" value="{{editingNodePurpose}}" maxlength="500" auto-height placeholder="说明这一节点在章节中的作用" bindinput="changeNodePurpose"></textarea>
              <view class="node-required-control">
                <switch type="checkbox" checked="{{editingNodeRequired}}" color="#a7483c" bindchange="changeNodeRequired" />
                <text>关键节点</text>
              </view>
              <view class="node-edit-actions">
                <button disabled="{{structureActionBusy || contractActionBusy}}" bindtap="cancelNodeEdit">取消</button>
                <button class="compact-primary-button" loading="{{structureActionBusy}}" disabled="{{structureActionBusy || contractActionBusy}}" bindtap="saveNodeEdit">保存节点</button>
              </view>
            </block>
            <block wx:else>
              <view class="row-title-line">
                <text class="row-title">{{node.title}}</text>
                <text class="status-label">{{node.statusText}}</text>
              </view>
              <text class="row-copy">{{node.purpose}}</text>
              <text class="row-meta">{{node.storyText}}</text>
              <view wx:if="{{workspace.contract.status === 'draft' && !splitEditorOpen}}" class="node-actions">
                <button class="icon-action-button" aria-label="节点上移" data-node-id="{{node.id}}" data-direction="up" disabled="{{structureActionBusy || contractActionBusy || !node.canMoveUp}}" bindtap="moveNode">↑</button>
                <button class="icon-action-button" aria-label="节点下移" data-node-id="{{node.id}}" data-direction="down" disabled="{{structureActionBusy || contractActionBusy || !node.canMoveDown}}" bindtap="moveNode">↓</button>
                <button data-node-id="{{node.id}}" disabled="{{structureActionBusy || contractActionBusy}}" bindtap="startNodeEdit">编辑节点</button>
              </view>
            </block>
          </view>
        </view>
      </checkbox-group>
      <view wx:else class="empty-state">本章还没有安排内容顺序</view>

      <view wx:if="{{splitEditorOpen}}" class="split-editor">
        <text class="section-label">新章节方向</text>
        <input class="structure-input" value="{{splitTitle}}" maxlength="200" placeholder="新章节标题" bindinput="changeSplitTitle" />
        <textarea class="structure-textarea" value="{{splitObjective}}" maxlength="2000" auto-height placeholder="新章节目标" bindinput="changeSplitObjective"></textarea>
        <textarea class="structure-textarea" value="{{splitReaderTakeaway}}" maxlength="2000" auto-height placeholder="读者读完应理解什么" bindinput="changeSplitReaderTakeaway"></textarea>
        <input class="structure-input" value="{{splitTimeScopeText}}" maxlength="1000" placeholder="时间或主题范围" bindinput="changeSplitTimeScope" />
        <textarea class="structure-textarea questions" value="{{splitQuestionsText}}" maxlength="4000" auto-height placeholder="新章节核心问题，每行一个" bindinput="changeSplitQuestions"></textarea>
        <view class="form-actions">
          <button disabled="{{structureActionBusy}}" bindtap="cancelSplitEditor">取消</button>
          <button class="compact-primary-button" loading="{{structureActionBusy}}" disabled="{{structureActionBusy}}" bindtap="submitChapterSplit">创建新章节</button>
        </view>
      </view>
    </view>

    <view wx:elif="{{activeTab === 'stories'}}" class="content-section">
      <view class="section-heading">
        <text class="section-title">本章故事</text>
        <text class="section-count">{{stories.length}} 个</text>
      </view>
      <view wx:if="{{stories.length}}" class="story-list">
        <view wx:for="{{stories}}" wx:for-item="story" wx:key="id" class="story-item">
          <view class="row-title-line">
            <text class="story-title">{{story.title}}</text>
            <text class="status-label">{{story.statusText}}</text>
          </view>
          <text class="story-summary">{{story.summary || "暂无故事摘要"}}</text>
          <view wx:if="{{story.canDecide || story.canExcludeFromChapter}}" class="decision-actions">
            <button
              wx:if="{{story.verification_status !== 'confirmed'}}"
              class="compact-primary-button"
              data-story-id="{{story.id}}"
              data-decision="confirm"
              loading="{{story.busy}}"
              disabled="{{story.busy}}"
              bindtap="decideStory"
            >确认故事</button>
            <button
              wx:if="{{story.verification_status !== 'rejected'}}"
              class="compact-danger-button"
              data-story-id="{{story.id}}"
              data-decision="reject"
              disabled="{{story.busy}}"
              bindtap="decideStory"
            >故事有误</button>
            <button
              wx:if="{{story.canExcludeFromChapter}}"
              data-story-id="{{story.id}}"
              disabled="{{story.busy || structureActionBusy || contractActionBusy}}"
              bindtap="excludeStoryFromChapter"
            >移出本章</button>
            <picker
              wx:if="{{story.canMoveWithinChapter}}"
              mode="selector"
              range="{{story.moveTargetNodeTitles}}"
              data-story-id="{{story.id}}"
              disabled="{{story.busy || structureActionBusy || contractActionBusy}}"
              bindchange="moveStoryToNode"
            >
              <view class="picker-action {{story.busy || structureActionBusy || contractActionBusy ? 'disabled' : ''}}">移动节点</view>
            </picker>
            <picker
              wx:if="{{story.canMerge}}"
              mode="selector"
              range="{{story.mergeTargetTitles}}"
              data-story-id="{{story.id}}"
              disabled="{{story.busy || structureActionBusy || contractActionBusy}}"
              bindchange="mergeStory"
            >
              <view class="picker-action danger {{story.busy || structureActionBusy || contractActionBusy ? 'disabled' : ''}}">合并重复</view>
            </picker>
          </view>

          <view class="slot-grid">
            <view wx:for="{{story.slots}}" wx:for-item="slot" wx:key="slot_key" class="slot-row">
              <view class="slot-state">
                <text class="slot-name">{{slot.labelText}}{{slot.required ? " *" : ""}}</text>
                <text class="slot-status {{slot.statusClass}}">{{slot.statusText}}</text>
              </view>
              <view wx:if="{{slot.canResolve}}" class="slot-actions">
                <button
                  data-story-id="{{story.id}}"
                  data-slot-key="{{slot.slot_key}}"
                  data-decision="accepted_incomplete"
                  loading="{{slot.busy}}"
                  disabled="{{slot.busy}}"
                  bindtap="resolveStorySlot"
                >接受缺失</button>
                <button
                  data-story-id="{{story.id}}"
                  data-slot-key="{{slot.slot_key}}"
                  data-decision="not_applicable"
                  disabled="{{slot.busy}}"
                  bindtap="resolveStorySlot"
                >不适用</button>
              </view>
            </view>
          </view>

          <view class="claim-list">
            <view wx:for="{{story.claims}}" wx:for-item="claim" wx:key="id" class="claim-row">
              <view class="claim-head">
                <text class="claim-label">事实</text>
                <view class="claim-meta">
                  <text class="claim-review-status">{{claim.statusText}}</text>
                  <text class="claim-evidence-count">{{claim.evidenceCountText}}</text>
                </view>
              </view>
              <text class="claim-statement">{{claim.statement}}</text>
              <view wx:if="{{claim.evidence.length}}" class="evidence-list">
                <text wx:for="{{claim.evidence}}" wx:for-item="evidence" wx:key="id" class="evidence-quote">
                  {{evidence.quote || evidence.evidence_note}}
                </text>
              </view>
              <view wx:if="{{claim.canDecide}}" class="decision-actions claim-actions">
                <button
                  wx:if="{{claim.verification_status !== 'confirmed'}}"
                  class="compact-primary-button"
                  data-claim-id="{{claim.id}}"
                  data-decision="confirm"
                  loading="{{claim.busy}}"
                  disabled="{{claim.busy}}"
                  bindtap="decideClaim"
                >事实正确</button>
                <button
                  wx:if="{{claim.verification_status !== 'rejected'}}"
                  class="compact-danger-button"
                  data-claim-id="{{claim.id}}"
                  data-decision="reject"
                  disabled="{{claim.busy}}"
                  bindtap="decideClaim"
                >事实有误</button>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view wx:else class="empty-state">本章还没有加入可用的素材内容</view>

      <view class="section-heading available-story-heading">
        <text class="section-title">可加入本章</text>
        <text class="section-count">{{availableStoryMatchCount}} 个</text>
      </view>
      <view wx:if="{{availableStoryTotalCount}}" class="available-story-filter">
        <input
          class="available-story-search"
          value="{{availableStoryQuery}}"
          maxlength="80"
          placeholder="搜索人物或事情"
          bindinput="changeAvailableStoryQuery"
        />
        <button
          wx:if="{{availableStoryQuery}}"
          class="available-story-clear"
          bindtap="clearAvailableStoryQuery"
        >清空</button>
      </view>
      <view wx:if="{{contractRevisionError}}" class="message error-message">{{contractRevisionError}}</view>
      <view wx:if="{{availableStories.length && workspace.contract && workspace.contract.status === 'confirmed'}}" class="story-edit-state">
        <view class="story-edit-copy">
          <text class="story-edit-title">章节结构已确认</text>
          <text class="story-edit-hint">开始调整后，再选择要加入的内容</text>
        </view>
        <button
          class="secondary-action-button story-revision-button"
          loading="{{contractRevisionBusy}}"
          disabled="{{contractRevisionBusy}}"
          bindtap="createContractRevision"
        >开始调整</button>
      </view>
      <view wx:if="{{availableStories.length}}" class="available-story-list">
        <view wx:for="{{availableStories}}" wx:for-item="story" wx:key="id" class="available-story-row">
          <view class="available-story-main">
            <view class="row-title-line">
              <text class="story-title">{{story.title}}</text>
              <text class="status-label">{{story.statusText}}</text>
            </view>
            <text class="story-summary">{{story.summary || "暂无故事摘要"}}</text>
            <text wx:if="{{story.excluded_from_chapter}}" class="available-story-note">此前已从本章移出</text>
            <text wx:if="{{story.error}}" class="available-story-error">{{story.error}}</text>
          </view>
          <button
            wx:if="{{workspace.contract && workspace.contract.status === 'draft'}}"
            class="primary-small-button available-story-action"
            data-story-id="{{story.id}}"
            loading="{{story.busy}}"
            disabled="{{story.busy}}"
            bindtap="includeAvailableStory"
          >{{story.actionText}}</button>
        </view>
        <button
          wx:if="{{availableStoryHasMore || (showAllAvailableStories && !availableStoryQuery && availableStoryTotalCount > 8)}}"
          class="available-story-toggle"
          bindtap="toggleAvailableStories"
        >{{showAllAvailableStories ? "收起" : "查看全部"}}</button>
      </view>
      <view wx:elif="{{availableStoryQuery && !availableStories.length}}" class="empty-state">没有匹配的人物或事情</view>
      <view wx:elif="{{!workspace.contract}}" class="empty-state">确定本章方向后，可以从现有素材中加入内容</view>
      <view wx:else class="empty-state">没有其他适合加入本章的内容</view>
    </view>

    <view wx:elif="{{activeTab === 'drafts'}}" class="content-section">
      <view class="draft-toolbar">
        <view class="draft-toolbar-copy">
          <text class="section-title">本章正文</text>
          <text class="draft-toolbar-hint">{{draftBlocks.length}} 段</text>
        </view>
        <view class="draft-toolbar-actions">
          <button
            class="secondary-action-button"
            loading="{{draftGenerationBusy}}"
            disabled="{{draftGenerationBusy || revisionBlockId || !workspace.contract || workspace.contract.status !== 'confirmed'}}"
            bindtap="generateDraftBlocks"
          >
            {{draftBlocks.length ? "补齐正文" : "生成正文"}}
          </button>
          <button
            class="primary-action-button"
            loading="{{assemblingDraft}}"
            disabled="{{assemblingDraft || !draftBlocks.length}}"
            bindtap="assembleChapterDraft"
          >
            组装并确认本章
          </button>
        </view>
      </view>

      <view wx:if="{{draftGenerationStatus}}" class="draft-job-state">{{draftGenerationStatus}}</view>
      <view wx:if="{{draftError}}" class="message error-message">{{draftError}}</view>
      <view wx:if="{{draftLoading}}" class="empty-state">正在加载正文</view>
      <view wx:elif="{{draftBlocks.length}}" class="draft-block-list">
        <view wx:for="{{draftBlocks}}" wx:for-item="block" wx:key="id" class="draft-block-row {{block.freshness_status === 'stale' ? 'stale' : ''}}">
          <view class="draft-block-head">
            <view class="draft-block-heading">
              <text class="draft-block-role">{{block.roleText}}</text>
              <text class="draft-block-node">{{block.nodeTitle}}</text>
            </view>
            <view class="draft-block-badges">
              <text class="draft-status-label {{block.editorial_status}}">{{block.editorialStatusText}}</text>
              <text class="draft-status-label {{block.freshness_status}}">{{block.freshnessStatusText}}</text>
              <text wx:if="{{block.locked}}" class="draft-status-label locked">已锁定</text>
            </view>
          </view>

          <block wx:if="{{editingBlockId === block.id}}">
            <textarea
              class="draft-block-editor"
              value="{{editingBlockContent}}"
              maxlength="-1"
              auto-height
              cursor-spacing="24"
              bindinput="changeDraftBlockContent"
            />
            <view class="draft-inline-actions">
              <button class="text-action-button" bindtap="cancelDraftBlockEdit">取消</button>
              <button
                class="primary-small-button"
                data-block-id="{{block.id}}"
                loading="{{block.busy}}"
                disabled="{{block.busy}}"
                bindtap="saveDraftBlockEdit"
              >保存</button>
            </view>
          </block>
          <text wx:else class="draft-block-content">{{block.current_version.content}}</text>

          <view class="draft-block-meta">
            <text>版本 {{block.current_version.version}} · {{block.sourceCountText}}</text>
          </view>
          <view class="draft-inline-actions wrap">
            <button
              class="text-action-button"
              data-block-id="{{block.id}}"
              bindtap="toggleDraftBlockSources"
            >{{sourceBlockId === block.id ? "收起来源" : "查看来源"}}</button>
            <button
              wx:if="{{!block.isLegacy}}"
              class="text-action-button"
              data-block-id="{{block.id}}"
              disabled="{{block.busy || editingBlockId === block.id}}"
              bindtap="startDraftBlockEdit"
            >编辑</button>
            <button
              wx:if="{{!block.isLegacy && block.editorial_status !== 'confirmed'}}"
              class="text-action-button"
              data-block-id="{{block.id}}"
              loading="{{block.busy}}"
              disabled="{{block.busy}}"
              bindtap="confirmDraftBlock"
            >确认</button>
            <button
              wx:if="{{!block.isLegacy}}"
              class="text-action-button"
              data-block-id="{{block.id}}"
              loading="{{block.busy}}"
              disabled="{{block.busy}}"
              bindtap="toggleDraftBlockLock"
            >{{block.locked ? "解锁" : "锁定"}}</button>
          </view>

          <view wx:if="{{sourceBlockId === block.id}}" class="draft-source-panel">
            <text wx:if="{{!block.sourceClaims.length && !block.sourceStories.length}}" class="draft-source-empty">这段旧稿没有可查看的详细来源</text>
            <view wx:for="{{block.sourceStories}}" wx:for-item="sourceStory" wx:key="id" class="draft-source-story">
              <text class="draft-source-kind">故事</text>
              <text class="draft-source-title">{{sourceStory.title}}</text>
            </view>
            <view wx:for="{{block.sourceClaims}}" wx:for-item="sourceClaim" wx:key="id" class="draft-source-claim">
              <text class="draft-source-kind">事实依据</text>
              <text class="draft-source-statement">{{sourceClaim.statement}}</text>
              <text wx:if="{{sourceClaim.evidenceText}}" class="draft-source-evidence">{{sourceClaim.evidenceText}}</text>
            </view>
          </view>

          <view wx:if="{{!block.isLegacy}}" class="draft-revision-panel">
            <input
              class="draft-revision-input"
              value="{{block.revisionFeedback}}"
              placeholder="例如：把‘单位’改成具体名称，只调整这一段"
              maxlength="4000"
              data-block-id="{{block.id}}"
              bindinput="changeDraftRevisionFeedback"
            />
            <button
              class="secondary-action-button revision-button"
              data-block-id="{{block.id}}"
              loading="{{revisionBlockId === block.id && !revisionSuggestion}}"
              disabled="{{block.locked || block.busy || revisionBlockId || draftGenerationBusy}}"
              bindtap="requestDraftBlockRevision"
            >生成本段修改建议</button>
            <text wx:if="{{revisionBlockId === block.id && revisionStatus}}" class="draft-revision-status">{{revisionStatus}}</text>
            <view wx:if="{{revisionBlockId === block.id && revisionSuggestion}}" class="draft-suggestion">
              <text class="draft-suggestion-label">建议版本</text>
              <text class="draft-suggestion-content">{{revisionSuggestion}}</text>
              <view class="draft-inline-actions">
                <button class="text-action-button" bindtap="discardDraftBlockRevision">放弃</button>
                <button
                  class="primary-small-button"
                  data-block-id="{{block.id}}"
                  loading="{{block.busy}}"
                  disabled="{{block.busy}}"
                  bindtap="applyDraftBlockSuggestion"
                >采用建议</button>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view wx:else class="empty-state">本章还没有正文</view>
    </view>

    <view wx:elif="{{activeTab === 'checks'}}" class="content-section">
      <view wx:for="{{gapGroups}}" wx:for-item="group" wx:key="key" class="gap-section">
        <view class="section-heading">
          <text class="section-title">{{group.title}}</text>
          <text class="section-count">{{group.items.length}} 项</text>
        </view>
        <view wx:if="{{group.items.length}}" class="gap-list">
          <view wx:for="{{group.items}}" wx:for-item="gap" wx:key="id" class="gap-item severity-{{gap.severity}}">
            <view class="row-title-line">
              <text class="gap-title">{{gap.title}}</text>
              <text class="status-label">{{gap.statusText}}</text>
            </view>
            <text class="gap-description">{{gap.description}}</text>
            <text class="gap-severity">{{gap.severityText}}</text>
            <block wx:if="{{group.actionable}}">
              <input
                class="gap-note-input"
                value="{{gap.note}}"
                placeholder="处理说明（忽略问题时必填）"
                maxlength="1000"
                data-gap-id="{{gap.id}}"
                bindinput="changeGapNote"
              />
              <view class="gap-actions">
                <button data-gap-id="{{gap.id}}" data-action="resolve" disabled="{{actionBusyGapId === gap.id}}" bindtap="applyGapAction">标记已处理</button>
                <button data-gap-id="{{gap.id}}" data-action="accept-incomplete" disabled="{{actionBusyGapId === gap.id}}" bindtap="applyGapAction">接受不完整</button>
                <button data-gap-id="{{gap.id}}" data-action="not-applicable" disabled="{{actionBusyGapId === gap.id}}" bindtap="applyGapAction">不适用</button>
                <button data-gap-id="{{gap.id}}" data-action="dismiss" disabled="{{actionBusyGapId === gap.id}}" bindtap="applyGapAction">忽略</button>
              </view>
            </block>
            <text wx:elif="{{gap.resolution_note}}" class="resolution-note">{{gap.resolution_note}}</text>
          </view>
        </view>
        <view wx:else class="empty-row">{{group.emptyText}}</view>
      </view>
    </view>

    <view wx:else class="content-section">
      <view class="section-heading">
        <text class="section-title">本章补访问题</text>
        <text class="section-count">{{followupTasks.length}} 项</text>
      </view>
      <view wx:if="{{followupError}}" class="message error-message">{{followupError}}</view>
      <view wx:if="{{followupLoading}}" class="empty-state">正在加载补访问题</view>
      <view wx:elif="{{followupTasks.length}}" class="followup-list">
        <view wx:for="{{followupTasks}}" wx:for-item="task" wx:key="id" class="followup-item">
          <view class="row-title-line">
            <text class="followup-priority">{{task.priorityText}}</text>
            <text class="status-label">{{task.statusText}}</text>
          </view>
          <text class="followup-question">{{task.question}}</text>
          <button
            wx:if="{{task.canInterview}}"
            class="followup-interview-button"
            data-task-id="{{task.id}}"
            loading="{{startingFollowupTaskId === task.id}}"
            disabled="{{startingFollowupTaskId === task.id}}"
            bindtap="startHumanFollowupInterview"
          >
            {{task.actionText}}
          </button>
        </view>
      </view>
      <view wx:else class="empty-state">本章目前没有待补访的问题</view>
    </view>
    </block>
  </block>
</view>
