<view class="workspace-page">
  <view class="ui-page-context-row">
    <text class="ui-page-context">{{workspace ? workspace.chapter_title : "本章正文"}} · 当前一步</text>
    <button class="workspace-home-action" bindtap="openBookHome">书稿首页</button>
  </view>

  <view wx:if="{{error}}" class="message error-message">{{error}}</view>
  <view wx:if="{{loading && !workspace}}" class="loading-state">正在读取本章</view>

  <block wx:if="{{workspace}}">
    <view class="status-card" id="chapter-status">
      <text class="section-kicker">本章进度</text>
      <text class="status-title">{{readinessTitle}}</text>
      <text class="status-detail">{{readinessDetail}}</text>
      <view
        wx:if="{{nextAction.actionText}}"
        class="primary-action {{nextAction.disabled || processBusy || startingIssueId !== '' ? 'is-disabled' : ''}}"
        aria-role="button"
        aria-disabled="{{nextAction.disabled || processBusy || startingIssueId !== ''}}"
        bindtap="runNextAction"
      >{{processBusy || startingIssueId !== "" ? "正在处理…" : nextAction.actionText}}</view>
    </view>

    <view wx:if="{{sectionViews.length}}" class="content-card structure-card" id="chapter-structure">
      <view class="structure-heading">
        <view>
          <text class="section-kicker">本章结构</text>
          <text class="section-title">小节与对应讲述</text>
        </view>
        <text class="section-structure-summary">{{sectionStructureSummary}}</text>
      </view>

      <view class="structure-tools">
        <text class="structure-tools-detail">仅在讲述分组不合适时使用；这一步不会直接生成正文，可能需要几分钟。</text>
        <view
          class="structure-regenerate-action {{regeneratingSections || processBusy || rewritingDraft || confirmingChapter || savingDraft || movingMaterialId !== '' || editingSectionId !== '' ? 'is-disabled' : ''}}"
          aria-role="button"
          aria-disabled="{{regeneratingSections || processBusy || rewritingDraft || confirmingChapter || savingDraft || movingMaterialId !== '' || editingSectionId !== ''}}"
          bindtap="regenerateSections"
        >{{regeneratingSections ? "正在重新整理…" : "重新整理小节分组"}}</view>
      </view>

      <view class="section-list">
        <view wx:for="{{sectionViews}}" wx:key="id" class="section-item {{item.requires_user_assignment ? 'is-unassigned' : ''}}">
          <view
            class="section-toggle"
            data-id="{{item.id}}"
            aria-role="button"
            aria-label="{{item.expanded ? '收起' : '展开'}}小节 {{item.title}}"
            bindtap="toggleSection"
          >
            <view class="section-index">
              <text>{{item.indexText}}</text>
            </view>
            <view class="section-copy">
              <text class="section-name">{{item.title}}</text>
              <text class="section-meta">{{item.typeText}} · {{item.metaText}}</text>
            </view>
            <text class="section-expand-mark">{{item.expanded ? "收起" : "查看"}}</text>
          </view>

          <view wx:if="{{item.expanded}}" class="section-material-list">
            <text wx:if="{{item.assignmentHint}}" class="pending-section-hint">{{item.assignmentHint}}</text>
            <view wx:for="{{item.visibleMaterials}}" wx:key="utterance_id" wx:for-item="material" class="section-material">
              <text class="section-material-index">{{material.indexText}}</text>
              <text class="section-material-text" selectable>{{material.text}}</text>
              <picker
                wx:if="{{item.requires_user_assignment}}"
                mode="selector"
                range="{{material.assignmentOptions}}"
                range-key="title"
                data-utterance-id="{{material.utterance_id}}"
                disabled="{{movingMaterialId !== '' || processBusy || regeneratingSections || rewritingDraft}}"
                bindchange="moveUnassignedMaterial"
              >
                <view
                  class="material-assignment-action {{movingMaterialId !== '' || processBusy || regeneratingSections || rewritingDraft ? 'is-disabled' : ''}}"
                  aria-role="button"
                  aria-disabled="{{movingMaterialId !== '' || processBusy || regeneratingSections || rewritingDraft}}"
                >{{movingMaterialId === material.utterance_id ? "正在移动…" : "选择归属小节"}}</view>
              </picker>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="content-card draft-card" id="chapter-draft">
      <view class="draft-heading">
        <view>
          <text class="section-kicker">本章正文</text>
          <text class="section-title">{{workspace.draft_sections.length ? "按小节通读，最后整章确认" : "完成当前步骤，生成小节正文"}}</text>
        </view>
        <text wx:if="{{workspace.completion_summary.state === 'confirmed'}}" class="confirmed-badge">已确认</text>
      </view>

      <view wx:if="{{workspace.draft_needs_rewrite && workspace.draft_sections.length}}" class="rewrite-notice">
        <text class="rewrite-notice-title">{{rewriteNoticeTitle}}</text>
        <text class="rewrite-notice-detail">{{rewriteNoticeDetail}}</text>
        <view
          class="rewrite-action {{!workspace.can_rewrite_draft || rewritingDraft || processBusy || startingIssueId !== '' || confirmingChapter || savingDraft || editingSectionId !== '' ? 'is-disabled' : ''}}"
          aria-role="button"
          aria-disabled="{{!workspace.can_rewrite_draft || rewritingDraft || processBusy || startingIssueId !== '' || confirmingChapter || savingDraft || editingSectionId !== ''}}"
          bindtap="rewriteChapter"
        >{{rewritingDraft ? "正在生成…" : "重新生成小节正文"}}</view>
      </view>

      <view wx:if="{{workspace.draft_sections.length}}" class="draft-section-list">
        <view
          wx:for="{{workspace.draft_sections}}"
          wx:key="section_id"
          class="draft-section-card"
        >
          <view class="draft-section-heading">
            <view class="draft-section-number">小节 {{index + 1}}</view>
            <text class="draft-section-title">{{item.title}}</text>
            <text class="draft-section-meta">{{item.used_material_ids.length}} 条讲述整理</text>
          </view>

          <block wx:if="{{editingSectionId === item.section_id}}">
            <textarea
              class="draft-editor"
              value="{{editingSectionContent}}"
              maxlength="-1"
              auto-height
              cursor-spacing="24"
              aria-label="编辑小节 {{item.title}}"
              bindinput="changeDraftSectionContent"
            />
            <view class="edit-actions">
              <button
                class="secondary-action"
                disabled="{{savingDraft}}"
                bindtap="cancelDraftSectionEdit"
              >取消</button>
              <button
                class="secondary-action strong"
                loading="{{savingDraft}}"
                disabled="{{savingDraft}}"
                bindtap="saveDraftSectionEdit"
              >保存这一小节</button>
            </view>
          </block>
          <block wx:else>
            <text class="draft-content">{{item.content}}</text>
            <button
              class="text-action"
              data-id="{{item.section_id}}"
              disabled="{{confirmingChapter || rewritingDraft || editingSectionId !== ''}}"
              bindtap="startDraftSectionEdit"
            >修改这一小节</button>
          </block>
        </view>
      </view>

      <view wx:else class="draft-empty">
        <block wx:if="{{workspace.draft_content}}">
          <text class="empty-title">{{draftRecoveryTitle}}</text>
          <text class="empty-detail">{{draftRecoveryDetail}}</text>
          <view
            class="primary-action draft-recovery-action {{draftRecoveryActionDisabled || processBusy || rewritingDraft || startingIssueId !== '' || confirmingChapter || savingDraft || editingSectionId !== '' ? 'is-disabled' : ''}}"
            aria-role="button"
            aria-disabled="{{draftRecoveryActionDisabled || processBusy || rewritingDraft || startingIssueId !== '' || confirmingChapter || savingDraft || editingSectionId !== ''}}"
            bindtap="runDraftRecoveryAction"
          >{{processBusy || rewritingDraft || startingIssueId !== "" ? "正在处理…" : draftRecoveryActionText}}</view>
        </block>
        <block wx:else>
          <text class="empty-title">正文还没有准备好</text>
          <text class="empty-detail">先完成上面的当前步骤，系统会自动整理正文。</text>
        </block>
      </view>

      <view
        wx:if="{{workspace.draft_sections.length && workspace.completion_summary.state === 'draft_ready'}}"
        class="primary-action confirm-chapter-action {{!canConfirmChapter || confirmingChapter || editingSectionId !== '' ? 'is-disabled' : ''}}"
        aria-role="button"
        aria-disabled="{{!canConfirmChapter || confirmingChapter || editingSectionId !== ''}}"
        bindtap="confirmChapter"
      >{{confirmingChapter ? "正在确认…" : "确认本章正文"}}</view>

      <view wx:if="{{workspace.completion_summary.state === 'confirmed'}}" class="chapter-finished">
        <text class="chapter-finished-title">本章已完成</text>
        <text class="chapter-finished-detail">正文已经收入书稿，可以返回查看其他章节或生成全书。</text>
        <view class="primary-action" aria-role="button" bindtap="returnToBookFlow">完成，返回全书进度</view>
      </view>
    </view>
  </block>
</view>
