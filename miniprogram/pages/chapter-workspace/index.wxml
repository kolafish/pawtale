<view class="workspace-page">
  <view class="page-header">
    <view class="back-hit" bindtap="goBack" role="button" aria-label="返回">
      <text class="back-mark">‹</text>
    </view>
    <view class="header-main">
      <text class="page-title">{{workspace ? workspace.chapter_title : "本章正文"}}</text>
      <text class="page-meta">只处理当前最重要的一步</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="message error-message">{{error}}</view>
  <view wx:if="{{loading && !workspace}}" class="loading-state">正在读取本章</view>

  <block wx:if="{{workspace}}">
    <view class="status-card">
      <text class="section-kicker">本章进度</text>
      <text class="status-title">{{readinessTitle}}</text>
      <text class="status-detail">{{readinessDetail}}</text>
      <button
        wx:if="{{nextAction.actionText}}"
        class="primary-action"
        loading="{{processBusy || startingIssueId !== ''}}"
        disabled="{{nextAction.disabled || processBusy || startingIssueId !== ''}}"
        bindtap="runNextAction"
      >{{nextAction.actionText}}</button>
    </view>

    <view wx:if="{{sectionViews.length}}" class="content-card structure-card">
      <view class="structure-heading">
        <view>
          <text class="section-kicker">本章结构</text>
          <text class="section-title">小节与对应讲述</text>
        </view>
        <text class="section-structure-summary">{{sectionStructureSummary}}</text>
      </view>

      <view class="section-list">
        <view wx:for="{{sectionViews}}" wx:key="id" class="section-item">
          <button
            class="section-toggle"
            data-id="{{item.id}}"
            aria-label="{{item.expanded ? '收起' : '展开'}}小节 {{item.title}}"
            bindtap="toggleSection"
          >
            <view class="section-index">
              <text>{{item.indexText}}</text>
            </view>
            <view class="section-copy">
              <text class="section-name">{{item.title}}</text>
              <text class="section-meta">{{item.typeText}} · {{item.metaText}}</text>
            </view>
            <text class="section-expand-mark">{{item.expanded ? "收起" : "查看"}}</text>
          </button>

          <view wx:if="{{item.expanded}}" class="section-material-list">
            <view wx:for="{{item.visibleMaterials}}" wx:key="utterance_id" wx:for-item="material" class="section-material">
              <text class="section-material-index">{{material.indexText}}</text>
              <text class="section-material-text" selectable>{{material.text}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="content-card draft-card" id="chapter-draft">
      <view class="draft-heading">
        <view>
          <text class="section-kicker">本章正文</text>
          <text class="section-title">通读后一次确认</text>
        </view>
        <text wx:if="{{workspace.completion_summary.state === 'confirmed'}}" class="confirmed-badge">已确认</text>
      </view>

      <view wx:if="{{workspace.draft_needs_rewrite}}" class="rewrite-notice">
        <text class="rewrite-notice-title">{{rewriteNoticeTitle}}</text>
        <text class="rewrite-notice-detail">{{rewriteNoticeDetail}}</text>
        <button
          class="rewrite-action"
          loading="{{rewritingDraft}}"
          disabled="{{!workspace.can_rewrite_draft || rewritingDraft || processBusy || startingIssueId !== '' || confirmingChapter || savingDraft || editingDraft}}"
          bindtap="rewriteChapter"
        >按现有素材重写</button>
      </view>

      <view wx:if="{{workspace.draft_content}}" class="draft-body">
        <block wx:if="{{editingDraft}}">
          <textarea
            class="draft-editor"
            value="{{editingDraftContent}}"
            maxlength="-1"
            auto-height
            cursor-spacing="24"
            bindinput="changeDraftContent"
          />
          <view class="edit-actions">
            <button
              class="secondary-action"
              disabled="{{savingDraft}}"
              bindtap="cancelDraftEdit"
            >取消</button>
            <button
              class="secondary-action strong"
              loading="{{savingDraft}}"
              disabled="{{savingDraft}}"
              bindtap="saveDraftEdit"
            >保存修改</button>
          </view>
        </block>
        <block wx:else>
          <text class="draft-content">{{workspace.draft_content}}</text>
          <button
            class="text-action"
            disabled="{{confirmingChapter || rewritingDraft}}"
            bindtap="startDraftEdit"
          >修改本章正文</button>
        </block>
      </view>

      <view wx:else class="draft-empty">
        <text class="empty-title">正文还没有准备好</text>
        <text class="empty-detail">先完成上面的当前步骤，系统会自动整理正文。</text>
      </view>

      <button
        wx:if="{{workspace.draft_content && workspace.completion_summary.state === 'draft_ready'}}"
        class="primary-action confirm-chapter-action"
        loading="{{confirmingChapter}}"
        disabled="{{!canConfirmChapter || confirmingChapter || editingDraft}}"
        bindtap="confirmChapter"
      >确认本章正文</button>
    </view>
  </block>
</view>
