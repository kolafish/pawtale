<view class="workspace-page">
  <view class="page-header">
    <view class="back-hit" bindtap="goBack" role="button" aria-label="返回">
      <text class="back-mark">‹</text>
    </view>
    <view class="header-main">
      <text class="page-title">{{workspace ? workspace.chapter_title : "本章正文"}}</text>
      <text class="page-meta">只处理当前最重要的一步</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="message error-message">{{error}}</view>
  <view wx:if="{{loading && !workspace}}" class="loading-state">正在读取本章</view>

  <block wx:if="{{workspace}}">
    <view class="status-card">
      <text class="section-kicker">本章进度</text>
      <text class="status-title">{{readinessTitle}}</text>
      <text class="status-detail">{{readinessDetail}}</text>
      <button
        wx:if="{{nextAction.actionText && nextAction.kind !== 'confirm_fact'}}"
        class="primary-action"
        loading="{{processBusy || startingTaskId !== ''}}"
        disabled="{{nextAction.disabled || processBusy || startingTaskId !== ''}}"
        bindtap="runNextAction"
      >{{nextAction.actionText}}</button>
    </view>

    <view wx:if="{{confirmation}}" class="content-card confirmation-card" id="chapter-confirmation">
      <text class="section-kicker">请确认一处事实</text>
      <text class="section-title">{{confirmation.question}}</text>
      <text wx:if="{{confirmation.detail}}" class="section-detail">{{confirmation.detail}}</text>
      <textarea
        class="confirmation-input"
        value="{{confirmation.statement}}"
        placeholder="请写下准确说法"
        maxlength="1000"
        auto-height
        cursor-spacing="24"
        bindinput="changeConfirmationStatement"
      />
      <button
        class="primary-action"
        loading="{{confirmingFact}}"
        disabled="{{confirmingFact || !confirmation.statement}}"
        bindtap="saveConfirmation"
      >保存并继续整理</button>
    </view>

    <view class="content-card draft-card" id="chapter-draft">
      <view class="draft-heading">
        <view>
          <text class="section-kicker">本章正文</text>
          <text class="section-title">通读后一次确认</text>
        </view>
        <text wx:if="{{workspace.completion_summary.state === 'confirmed'}}" class="confirmed-badge">已确认</text>
      </view>

      <view wx:if="{{draftBlocks.length}}" class="draft-list">
        <view
          wx:for="{{draftBlocks}}"
          wx:key="id"
          class="draft-row {{item.freshness_status === 'stale' ? 'stale' : ''}}"
        >
          <view class="draft-row-head">
            <text class="draft-section-title">{{item.sectionTitle}}</text>
            <text class="draft-status">{{item.statusText}}</text>
          </view>

          <block wx:if="{{editingBlockId === item.id}}">
            <textarea
              class="draft-editor"
              value="{{editingBlockContent}}"
              maxlength="-1"
              auto-height
              cursor-spacing="24"
              bindinput="changeDraftBlockContent"
            />
            <view class="edit-actions">
              <button class="secondary-action" bindtap="cancelDraftBlockEdit">取消</button>
              <button
                class="secondary-action strong"
                data-block-id="{{item.id}}"
                loading="{{item.busy}}"
                disabled="{{item.busy}}"
                bindtap="saveDraftBlockEdit"
              >保存修改</button>
            </view>
          </block>

          <block wx:else>
            <text class="draft-content">{{item.current_version.content}}</text>
            <button
              wx:if="{{item.locked}}"
              class="text-action"
              data-block-id="{{item.id}}"
              loading="{{item.busy}}"
              disabled="{{item.busy}}"
              bindtap="unlockLegacyBlock"
            >解除保护后修改</button>
            <button
              wx:elif="{{item.freshness_status === 'current'}}"
              class="text-action"
              data-block-id="{{item.id}}"
              disabled="{{editingBlockId !== ''}}"
              bindtap="startDraftBlockEdit"
            >修改这一段</button>
          </block>
        </view>
      </view>

      <view wx:else class="draft-empty">
        <text class="empty-title">正文还没有准备好</text>
        <text class="empty-detail">先完成上面的当前步骤，系统会自动整理正文。</text>
      </view>

      <button
        wx:if="{{draftBlocks.length && workspace.completion_summary.state === 'draft_ready'}}"
        class="primary-action confirm-chapter-action"
        loading="{{confirmingChapter}}"
        disabled="{{!canConfirmChapter || confirmingChapter || editingBlockId !== ''}}"
        bindtap="confirmChapter"
      >确认本章正文</button>
    </view>
  </block>
</view>
