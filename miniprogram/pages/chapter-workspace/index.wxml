<view class="{{pageClass}}">
  <view class="ui-page-context-row">
    <text class="ui-page-context">{{workspace ? workspace.chapter_title : "本章正文"}} · {{focusedSectionId ? "当前小节" : "当前一步"}}</text>
    <button class="workspace-home-action" bindtap="openBookHome">书稿首页</button>
  </view>

  <view wx:if="{{error}}" class="message error-message">{{error}}</view>
  <view wx:if="{{loading && !workspace}}" class="loading-state">正在读取本章</view>

  <block wx:if="{{workspace}}">
    <view wx:if="{{!focusedSectionId}}" class="status-card ui-card ui-card-borderless" id="chapter-status">
      <text class="section-kicker">本章进度</text>
      <text class="status-title">{{readinessTitle}}</text>
      <text class="status-detail">{{readinessDetail}}</text>
      <view wx:if="{{chapterPreparationJob}}" class="chapter-preparation-status">
        <ai-task-progress
          title="{{chapterPreparationTitle}}"
          detail="{{chapterPreparationDetail}}"
          mode="{{chapterPreparationProgressMode}}"
          progress="{{chapterPreparationProgress}}"
          can-cancel="{{chapterPreparationJob.can_cancel}}"
          cancel-text="取消处理"
          bindcancel="cancelChapterPreparation"
        />
      </view>
      <view
        wx:if="{{nextAction.actionText}}"
        class="primary-action {{nextAction.disabled || operationKind !== '' || editingSectionId !== '' ? 'is-disabled' : ''}}"
        aria-role="button"
        aria-disabled="{{nextAction.disabled || operationKind !== '' || editingSectionId !== ''}}"
        bindtap="runNextAction"
      >{{operationKind !== "" ? "正在处理…" : nextAction.actionText}}</view>
      <view
        wx:if="{{workspace.completion_summary.state === 'confirmed'}}"
        class="structure-regenerate-action {{operationKind !== '' ? 'is-disabled' : ''}}"
        aria-role="button"
        aria-disabled="{{operationKind !== ''}}"
        bindtap="openSectionStructure"
      >调整小节结构</view>
    </view>

    <view
      wx:if="{{requiredIssues.length || optionalIssues.length}}"
      class="content-card suggestions-card ui-card ui-card-borderless"
      id="chapter-suggestions"
    >
      <view
        class="structure-heading"
        aria-role="button"
        aria-label="{{suggestionsExpanded ? '收起' : '展开'}}{{focusedSectionId ? '本章建议' : '审阅建议'}}"
        bindtap="toggleSuggestions"
      >
        <view>
          <text class="section-kicker">{{focusedSectionId ? "本章建议" : "审阅建议"}}</text>
          <text class="section-title">{{focusedSectionId ? "还可以补充的内容" : "必须确认与可选补充"}}</text>
        </view>
        <view class="structure-heading-meta">
          <text class="suggestion-count">{{focusedSectionId ? "可选补充 " + optionalIssues.length + " 项" : "必须 " + requiredIssues.length + " · 可选 " + optionalIssues.length}}</text>
          <text class="structure-expand-mark">{{suggestionsExpanded ? "收起" : "查看全部"}}</text>
        </view>
      </view>

      <block wx:if="{{suggestionsExpanded}}">
        <completion-issue-list
          project-id="{{projectId}}"
          project-title="{{workspace.chapter_title}}"
          chapter-id="{{chapterId}}"
          required-issues="{{requiredIssues}}"
          optional-issues="{{optionalIssues}}"
          disabled="{{operationKind !== '' || editingSectionId !== ''}}"
          bindrefresh="loadPageData"
        />
      </block>
    </view>

    <view class="content-card draft-card ui-card ui-card-borderless" id="chapter-sections">
      <view class="draft-heading">
        <view>
          <text class="section-kicker">{{focusedSectionId ? "小节详情" : "本章小节"}}</text>
          <text class="section-title">{{focusedSectionId ? focusedSectionTitle : "讲述素材与当前正文"}}</text>
          <text class="section-structure-summary">{{sectionStructureSummary}}</text>
        </view>
        <view class="draft-heading-actions">
          <text wx:if="{{!focusedSectionId && workspace.completion_summary.state === 'confirmed'}}" class="confirmed-badge">已确认</text>
          <view
            wx:if="{{focusedSectionId}}"
            class="chapter-read-action ui-pressable"
            aria-role="button"
            aria-label="查看{{focusedSectionTitle}}的图片和视频"
            bindtap="openFocusedSectionMedia"
          >图片与视频</view>
          <view
            wx:elif="{{workspace.draft_version_id && workspace.draft_content}}"
            class="chapter-read-action {{operationKind !== '' || editingSectionId !== '' ? 'is-disabled' : ''}}"
            aria-role="button"
            aria-disabled="{{operationKind !== '' || editingSectionId !== ''}}"
            bindtap="openChapterPreview"
          >整章预览</view>
        </view>
      </view>

      <view wx:if="{{!focusedSectionId && sectionViews.length}}" class="structure-tools">
        <text class="structure-tools-detail">每个小节里同时显示原始讲述和当前正文；展开后可以修改正文，或把这个小节并入上一小节。</text>
        <view wx:if="{{sectionRegenerationJob}}" class="section-regeneration-status">
          <ai-task-progress
            title="{{sectionRegenerationTitle}}"
            detail="{{sectionRegenerationDetail}}"
            mode="{{sectionRegenerationProgressMode}}"
            progress="{{sectionRegenerationProgress}}"
            can-cancel="{{sectionRegenerationJob.can_cancel}}"
            cancel-text="取消整理"
            bindcancel="cancelSectionRegeneration"
          />
        </view>
        <view
          class="structure-regenerate-action {{operationKind !== '' || editingSectionId !== '' ? 'is-disabled' : ''}}"
          aria-role="button"
          aria-disabled="{{operationKind !== '' || editingSectionId !== ''}}"
          bindtap="regenerateSections"
        >{{operationKind === "regenerate_sections" ? "正在重新整理…" : "重新整理小节分组"}}</view>
      </view>

      <view wx:if="{{!focusedSectionId && workspace.draft_needs_rewrite && workspace.draft_sections.length}}" class="rewrite-notice">
        <text class="rewrite-notice-title">{{rewriteNoticeTitle}}</text>
        <text class="rewrite-notice-detail">{{rewriteNoticeDetail}}</text>
        <text wx:if="{{retainedDraftSectionCount}}" class="rewrite-notice-detail">调整前另有 {{retainedDraftSectionCount}} 个小节的旧正文保留在历史版本中，不会误放到当前小节。</text>
        <view
          wx:if="{{chapterPreparationJob && chapterPreparationJob.operation === 'rewrite'}}"
          class="rewrite-task-status"
        >
          <ai-task-progress
            title="{{chapterPreparationTitle}}"
            detail="{{chapterPreparationDetail}}"
            mode="{{chapterPreparationProgressMode}}"
            progress="{{chapterPreparationProgress}}"
            can-cancel="{{chapterPreparationJob.can_cancel}}"
            cancel-text="取消生成"
            bindcancel="cancelChapterPreparation"
          />
        </view>
        <view
          class="rewrite-action {{!workspace.can_rewrite_draft || operationKind !== '' || editingSectionId !== '' ? 'is-disabled' : ''}}"
          aria-role="button"
          aria-disabled="{{!workspace.can_rewrite_draft || operationKind !== '' || editingSectionId !== ''}}"
          bindtap="rewriteChapter"
        >{{operationKind === "rewrite_chapter" ? rewriteDraftBusyText : rewriteDraftActionText}}</view>
      </view>

      <view wx:if="{{sectionViews.length}}" class="section-list unified-section-list">
        <view
          wx:for="{{sectionViews}}"
          wx:key="id"
          id="chapter-section-{{item.id}}"
          class="section-item {{item.requires_user_assignment ? 'is-unassigned' : ''}}"
        >
          <view
            wx:if="{{!focusedSectionId}}"
            class="section-toggle"
            data-id="{{item.id}}"
            aria-role="button"
            aria-label="{{item.expanded ? '收起' : '展开'}}小节 {{item.title}}的讲述和正文"
            bindtap="toggleSection"
          >
            <view class="section-index"><text>{{item.indexText}}</text></view>
            <view class="section-copy">
              <text class="section-name">{{item.title}}</text>
              <text class="section-meta">{{item.typeText}} · {{item.metaText}}</text>
            </view>
            <text class="section-expand-mark">{{item.expanded ? "收起" : "查看"}}</text>
          </view>
          <view wx:else class="section-focus-heading">
            <view class="section-index"><text>{{item.indexText}}</text></view>
            <view class="section-copy">
              <text class="section-name">本节内容</text>
              <text class="section-meta">{{item.typeText}} · {{item.metaText}}</text>
            </view>
          </view>

          <block wx:if="{{item.expanded}}">
            <view class="section-material-list">
              <text class="section-content-label">{{item.requires_user_assignment ? "待归类讲述" : "原始讲述"}}</text>
              <text wx:if="{{item.assignmentHint}}" class="pending-section-hint">{{item.assignmentHint}}</text>
              <view wx:for="{{item.visibleMaterials}}" wx:key="utterance_id" wx:for-item="material" class="section-material">
                <view
                  class="section-material-open"
                  data-utterance-id="{{material.utterance_id}}"
                  aria-role="button"
                  aria-label="{{item.requires_user_assignment ? '编辑或删除' : '查看与修改'}}{{material.indexText}}"
                  bindtap="openMaterialEditor"
                >
                  <view class="section-material-open-copy">
                    <text class="section-material-index">{{material.indexText}}</text>
                    <text class="section-material-text">{{material.text}}</text>
                  </view>
                  <text class="section-material-open-action">{{item.requires_user_assignment ? "编辑或删除" : "查看与修改"}} ›</text>
                </view>
                <picker
                  wx:if="{{item.requires_user_assignment}}"
                  mode="selector"
                  range="{{material.assignmentOptions}}"
                  range-key="title"
                  data-utterance-id="{{material.utterance_id}}"
                  disabled="{{operationKind !== '' || editingSectionId !== ''}}"
                  bindchange="moveUnassignedMaterial"
                >
                  <view
                    class="material-assignment-action {{operationKind !== '' || editingSectionId !== '' ? 'is-disabled' : ''}}"
                    aria-role="button"
                    aria-disabled="{{operationKind !== '' || editingSectionId !== ''}}"
                  >{{operationKind === "move_material" && operationTargetId === material.utterance_id ? "正在移动…" : "选择归属小节"}}</view>
                </picker>
              </view>
            </view>

            <block wx:if="{{!item.requires_user_assignment}}">
              <block wx:if="{{editingSectionId === item.id && editingMode === 'manual'}}">
            <view class="draft-section-body">
              <textarea
                class="draft-editor"
                value="{{editingSectionContent}}"
                maxlength="-1"
                auto-height
                cursor-spacing="24"
                aria-label="编辑小节 {{item.title}}"
                bindinput="changeDraftSectionContent"
              />
              <view class="edit-actions">
                <button
                  class="secondary-action"
                  disabled="{{operationKind !== ''}}"
                  bindtap="cancelDraftSectionEdit"
                >取消</button>
                <button
                  class="secondary-action strong"
                  loading="{{operationKind === 'save_draft_section'}}"
                  disabled="{{operationKind === 'save_draft_section'}}"
                  bindtap="saveDraftSectionEdit"
                >保存这一小节</button>
              </view>
            </view>
              </block>
              <block wx:elif="{{item.hasDraft}}">
                <view class="draft-section-actions">
              <view
                class="draft-section-action {{operationKind !== '' || editingSectionId !== '' || (audioPhase !== 'idle' && audioTarget !== item.id) ? 'is-disabled' : ''}}"
                data-id="{{item.id}}"
                aria-role="button"
                aria-disabled="{{operationKind !== '' || editingSectionId !== '' || (audioPhase !== 'idle' && audioTarget !== item.id)}}"
                bindtap="playDraftSection"
              >{{audioPhase === "preparing" && audioTarget === item.id ? "准备朗读…" : (audioPhase === "playing" && audioTarget === item.id ? "停止朗读" : "朗读")}}</view>
              <view
                class="draft-section-action {{operationKind !== '' || editingSectionId !== '' ? 'is-disabled' : ''}}"
                data-id="{{item.id}}"
                aria-role="button"
                aria-disabled="{{operationKind !== '' || editingSectionId !== ''}}"
                bindtap="startDraftSectionEdit"
              >手动修改</view>
              <view
                class="draft-section-action regenerate {{operationKind !== '' || editingSectionId !== '' ? 'is-disabled' : ''}}"
                data-id="{{item.id}}"
                aria-role="button"
                aria-disabled="{{operationKind !== '' || editingSectionId !== ''}}"
                bindtap="startDraftSectionAIEdit"
              >AI 改正文</view>
                </view>
                <view class="draft-section-body">
                  <text class="section-content-label">当前正文{{item.draftNeedsUpdate ? "（待更新）" : ""}}</text>
                  <text class="draft-content" selectable>{{item.draftContent}}</text>
                </view>
              </block>
              <view wx:else class="draft-section-body draft-section-missing">
                <text class="section-content-label">当前正文</text>
                <text class="empty-detail">尚未生成这一小节的正文。完成页面顶部的当前步骤后会按原始讲述生成。</text>
              </view>

              <view
                wx:if="{{!focusedSectionId && item.mergeTargetId}}"
                class="section-merge-action {{operationKind !== '' || editingSectionId !== '' ? 'is-disabled' : ''}}"
                data-source-id="{{item.id}}"
                data-source-title="{{item.title}}"
                data-target-id="{{item.mergeTargetId}}"
                data-target-title="{{item.mergeTargetTitle}}"
                aria-role="button"
                aria-disabled="{{operationKind !== '' || editingSectionId !== ''}}"
                bindtap="mergeSectionIntoPrevious"
              >
                <text class="section-merge-action-title">与上一小节合并</text>
                <text class="section-merge-action-detail">并入“{{item.mergeTargetTitle}}”</text>
              </view>
            </block>
          </block>
        </view>
      </view>

      <view wx:if="{{!focusedSectionId && !workspace.draft_sections.length}}" class="draft-empty">
        <block wx:if="{{workspace.draft_content}}">
          <text class="empty-title">{{draftRecoveryTitle}}</text>
          <text class="empty-detail">{{draftRecoveryDetail}}</text>
          <view
            wx:if="{{chapterPreparationJob && chapterPreparationJob.operation === 'rewrite'}}"
            class="draft-recovery-task-status"
          >
            <ai-task-progress
              title="{{chapterPreparationTitle}}"
              detail="{{chapterPreparationDetail}}"
              mode="{{chapterPreparationProgressMode}}"
              progress="{{chapterPreparationProgress}}"
              can-cancel="{{chapterPreparationJob.can_cancel}}"
              cancel-text="取消生成"
              bindcancel="cancelChapterPreparation"
            />
          </view>
          <view
            class="primary-action draft-recovery-action {{draftRecoveryActionDisabled || operationKind !== '' || editingSectionId !== '' ? 'is-disabled' : ''}}"
            aria-role="button"
            aria-disabled="{{draftRecoveryActionDisabled || operationKind !== '' || editingSectionId !== ''}}"
            bindtap="runDraftRecoveryAction"
          >{{operationKind === "rewrite_chapter" ? rewriteDraftBusyText : (operationKind !== "" ? "正在处理…" : draftRecoveryActionText)}}</view>
        </block>
        <block wx:else>
          <text class="empty-title">正文还没有准备好</text>
          <text class="empty-detail">先完成上面的当前步骤，系统会自动整理正文。</text>
        </block>
      </view>

      <view
        wx:if="{{!focusedSectionId && workspace.draft_sections.length && workspace.completion_summary.state === 'draft_ready'}}"
        class="primary-action confirm-chapter-action {{!canConfirmChapter || operationKind !== '' || editingSectionId !== '' ? 'is-disabled' : ''}}"
        aria-role="button"
        aria-disabled="{{!canConfirmChapter || operationKind !== '' || editingSectionId !== ''}}"
        bindtap="confirmChapter"
      >{{operationKind === "confirm_chapter" ? "正在确认…" : "确认本章正文"}}</view>

      <view wx:if="{{!focusedSectionId && workspace.completion_summary.state === 'confirmed'}}" class="chapter-finished">
        <text class="chapter-finished-title">本章已确认</text>
        <text class="chapter-finished-detail">正文已经收入书稿。仍可重新分组或手动合并小节；调整后本章会回到待生成状态，需要重新确认。</text>
        <view class="primary-action" aria-role="button" bindtap="returnToBookFlow">返回全书进度</view>
      </view>
    </view>
  </block>
</view>
