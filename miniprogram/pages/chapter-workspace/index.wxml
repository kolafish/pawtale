<view class="workspace-page">
  <view class="ui-page-context-row">
    <text class="ui-page-context">{{workspace ? workspace.chapter_title : "本章正文"}} · 当前一步</text>
    <button class="workspace-home-action" bindtap="openBookHome">书稿首页</button>
  </view>

  <view wx:if="{{error}}" class="message error-message">{{error}}</view>
  <view wx:if="{{loading && !workspace}}" class="loading-state">正在读取本章</view>

  <block wx:if="{{workspace}}">
    <view class="status-card" id="chapter-status">
      <text class="section-kicker">本章进度</text>
      <text class="status-title">{{readinessTitle}}</text>
      <text class="status-detail">{{readinessDetail}}</text>
      <view wx:if="{{chapterPreparationJob}}" class="chapter-preparation-status">
        <ai-task-progress
          title="{{chapterPreparationTitle}}"
          detail="{{chapterPreparationDetail}}"
          mode="{{chapterPreparationProgressMode}}"
          progress="{{chapterPreparationProgress}}"
          can-cancel="{{chapterPreparationJob.can_cancel}}"
          cancel-text="取消处理"
          bindcancel="cancelChapterPreparation"
        />
      </view>
      <view
        wx:if="{{nextAction.actionText}}"
        class="primary-action {{nextAction.disabled || operationKind !== '' || editingSectionId !== '' ? 'is-disabled' : ''}}"
        aria-role="button"
        aria-disabled="{{nextAction.disabled || operationKind !== '' || editingSectionId !== ''}}"
        bindtap="runNextAction"
      >{{operationKind !== "" ? "正在处理…" : nextAction.actionText}}</view>
    </view>

    <view wx:if="{{sectionViews.length}}" class="content-card structure-card {{structureExpanded ? 'is-expanded' : 'is-collapsed'}}" id="chapter-structure">
      <view
        class="structure-heading"
        aria-role="button"
        aria-label="{{structureExpanded ? '收起' : '查看'}}小节分组与对应讲述"
        bindtap="toggleStructure"
      >
        <view>
          <text class="section-kicker">素材分组</text>
          <text class="section-title">小节与对应讲述</text>
        </view>
        <view class="structure-heading-meta">
          <text class="section-structure-summary">{{sectionStructureSummary}}</text>
          <text class="structure-expand-mark">{{structureExpanded ? "收起" : "查看"}}</text>
        </view>
      </view>

      <block wx:if="{{structureExpanded}}">
        <view class="structure-tools">
          <text class="structure-tools-detail">这里只重新划分讲述属于哪个小节，不会生成正文；仅在分组不合适时使用，可能需要几分钟。</text>
          <view wx:if="{{sectionRegenerationJob}}" class="section-regeneration-status">
            <ai-task-progress
              title="{{sectionRegenerationTitle}}"
              detail="{{sectionRegenerationDetail}}"
              mode="{{sectionRegenerationProgressMode}}"
              progress="{{sectionRegenerationProgress}}"
              can-cancel="{{sectionRegenerationJob.can_cancel}}"
              cancel-text="取消整理"
              bindcancel="cancelSectionRegeneration"
            />
          </view>
          <view
            class="structure-regenerate-action {{operationKind !== '' || editingSectionId !== '' ? 'is-disabled' : ''}}"
            aria-role="button"
            aria-disabled="{{operationKind !== '' || editingSectionId !== ''}}"
            bindtap="regenerateSections"
          >{{operationKind === "regenerate_sections" ? "正在重新整理…" : "重新整理小节分组"}}</view>
        </view>

        <view class="section-list">
          <view wx:for="{{sectionViews}}" wx:key="id" class="section-item {{item.requires_user_assignment ? 'is-unassigned' : ''}}">
            <view
              class="section-toggle"
              data-id="{{item.id}}"
              aria-role="button"
              aria-label="{{item.expanded ? '收起' : '展开'}}小节 {{item.title}}"
              bindtap="toggleSection"
            >
              <view class="section-index">
                <text>{{item.indexText}}</text>
              </view>
              <view class="section-copy">
                <text class="section-name">{{item.title}}</text>
                <text class="section-meta">{{item.typeText}} · {{item.metaText}}</text>
              </view>
              <text class="section-expand-mark">{{item.expanded ? "收起" : "查看"}}</text>
            </view>

            <view wx:if="{{item.expanded}}" class="section-material-list">
              <text wx:if="{{item.assignmentHint}}" class="pending-section-hint">{{item.assignmentHint}}</text>
              <view wx:for="{{item.visibleMaterials}}" wx:key="utterance_id" wx:for-item="material" class="section-material">
                <view
                  wx:if="{{item.requires_user_assignment}}"
                  class="section-material-open"
                  data-utterance-id="{{material.utterance_id}}"
                  aria-role="button"
                  aria-label="编辑或删除{{material.indexText}}"
                  bindtap="openMaterialEditor"
                >
                  <view class="section-material-open-copy">
                    <text class="section-material-index">{{material.indexText}}</text>
                    <text class="section-material-text">{{material.text}}</text>
                  </view>
                  <text class="section-material-open-action">编辑或删除 ›</text>
                </view>
                <block wx:else>
                  <text class="section-material-index">{{material.indexText}}</text>
                  <text class="section-material-text" selectable>{{material.text}}</text>
                </block>
                <picker
                  wx:if="{{item.requires_user_assignment}}"
                  mode="selector"
                  range="{{material.assignmentOptions}}"
                  range-key="title"
                  data-utterance-id="{{material.utterance_id}}"
                  disabled="{{operationKind !== '' || editingSectionId !== ''}}"
                  bindchange="moveUnassignedMaterial"
                >
                  <view
                    class="material-assignment-action {{operationKind !== '' || editingSectionId !== '' ? 'is-disabled' : ''}}"
                    aria-role="button"
                    aria-disabled="{{operationKind !== '' || editingSectionId !== ''}}"
                  >{{operationKind === "move_material" && operationTargetId === material.utterance_id ? "正在移动…" : "选择归属小节"}}</view>
                </picker>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>

    <view class="content-card draft-card" id="chapter-draft">
      <view class="draft-heading">
        <view>
          <text class="section-kicker">本章正文</text>
          <text class="section-title">{{workspace.draft_sections.length ? "按小节通读，最后整章确认" : "完成当前步骤，生成小节正文"}}</text>
        </view>
        <text wx:if="{{workspace.completion_summary.state === 'confirmed'}}" class="confirmed-badge">已确认</text>
      </view>

      <view wx:if="{{workspace.draft_needs_rewrite && workspace.draft_sections.length}}" class="rewrite-notice">
        <text class="rewrite-notice-title">{{rewriteNoticeTitle}}</text>
        <text class="rewrite-notice-detail">{{rewriteNoticeDetail}}</text>
        <view
          wx:if="{{chapterPreparationJob && chapterPreparationJob.operation === 'rewrite'}}"
          class="rewrite-task-status"
        >
          <ai-task-progress
            title="{{chapterPreparationTitle}}"
            detail="{{chapterPreparationDetail}}"
            mode="{{chapterPreparationProgressMode}}"
            progress="{{chapterPreparationProgress}}"
            can-cancel="{{chapterPreparationJob.can_cancel}}"
            cancel-text="取消生成"
            bindcancel="cancelChapterPreparation"
          />
        </view>
        <view
          class="rewrite-action {{!workspace.can_rewrite_draft || operationKind !== '' || editingSectionId !== '' ? 'is-disabled' : ''}}"
          aria-role="button"
          aria-disabled="{{!workspace.can_rewrite_draft || operationKind !== '' || editingSectionId !== ''}}"
          bindtap="rewriteChapter"
        >{{operationKind === "rewrite_chapter" ? rewriteDraftBusyText : rewriteDraftActionText}}</view>
      </view>

      <view wx:if="{{workspace.draft_sections.length}}" class="draft-section-list">
        <view
          wx:for="{{draftSectionViews}}"
          wx:key="section_id"
          class="draft-section-card {{item.expanded ? 'is-expanded' : ''}}"
        >
          <view class="draft-section-heading">
            <view
              class="draft-section-heading-copy"
              data-id="{{item.section_id}}"
              aria-role="button"
              aria-label="{{item.expanded ? '收起' : '展开'}}小节 {{item.title}}正文"
              bindtap="toggleDraftSection"
            >
              <view>
                <view class="draft-section-number">小节 {{item.indexText}}</view>
                <text class="draft-section-title">{{item.title}}</text>
                <text class="draft-section-meta">{{item.metaText}}</text>
              </view>
              <text class="draft-section-expand-mark">{{item.expanded ? "收起正文" : "展开正文"}}</text>
            </view>
          </view>

          <block wx:if="{{editingSectionId === item.section_id && editingMode === 'manual'}}">
            <view class="draft-section-body">
              <textarea
                class="draft-editor"
                value="{{editingSectionContent}}"
                maxlength="-1"
                auto-height
                cursor-spacing="24"
                aria-label="编辑小节 {{item.title}}"
                bindinput="changeDraftSectionContent"
              />
              <view class="edit-actions">
                <button
                  class="secondary-action"
                  disabled="{{operationKind !== ''}}"
                  bindtap="cancelDraftSectionEdit"
                >取消</button>
                <button
                  class="secondary-action strong"
                  loading="{{operationKind === 'save_draft_section'}}"
                  disabled="{{operationKind === 'save_draft_section'}}"
                  bindtap="saveDraftSectionEdit"
                >保存这一小节</button>
              </view>
            </view>
          </block>
          <block wx:elif="{{editingSectionId === item.section_id && editingMode === 'ai'}}">
            <view class="draft-section-body">
              <view class="draft-ai-editor">
                <text class="draft-ai-editor-title">告诉 AI 这节怎么改</text>
                <text class="draft-ai-editor-hint">可以说或输入修改要求。AI 会参考当前正文和原始讲述，只修改这一小节。</text>
                <textarea
                  class="draft-editor draft-ai-instruction"
                  value="{{draftSectionAIInstruction}}"
                  maxlength="800"
                  auto-height
                  cursor-spacing="24"
                  disabled="{{draftSectionVoicePhase !== 'idle' || operationKind !== ''}}"
                  placeholder="例如：保留事情经过，把语气写得更平实；删掉重复的回忆，但不要增加新事实。"
                  aria-label="输入小节 AI 修改要求"
                  bindinput="changeDraftSectionAIInstruction"
                />
                <view
                  wx:if="{{draftSectionVoicePhase !== 'idle' || (operationKind === 'revise_draft_section_with_ai' && operationTargetId === item.section_id)}}"
                  class="draft-ai-status"
                >
                  <view class="draft-ai-status-dot"></view>
                  <text>{{draftSectionVoicePhase === "listening" ? "正在听你说修改要求…" : (draftSectionVoicePhase === "transcribing" ? "正在识别语音…" : "AI 正在按要求修改这一小节…")}}</text>
                </view>
                <view class="edit-actions draft-ai-actions">
                  <button
                    class="secondary-action voice-instruction-action {{draftSectionVoicePhase === 'listening' ? 'is-listening' : ''}}"
                    loading="{{draftSectionVoicePhase === 'transcribing'}}"
                    disabled="{{draftSectionVoicePhase === 'transcribing' || operationKind !== ''}}"
                    bindtap="toggleDraftSectionVoiceInstruction"
                  >{{draftSectionVoicePhase === "listening" ? "结束录音" : "语音说要求"}}</button>
                  <button
                    class="secondary-action strong"
                    loading="{{operationKind === 'revise_draft_section_with_ai' && operationTargetId === item.section_id}}"
                    disabled="{{draftSectionAIInstruction === '' || draftSectionVoicePhase !== 'idle' || operationKind !== ''}}"
                    bindtap="submitDraftSectionAIInstruction"
                  >按要求修改</button>
                </view>
                <view class="edit-actions draft-ai-secondary-actions">
                  <button
                    class="secondary-action draft-ai-text-action"
                    disabled="{{draftSectionVoicePhase !== 'idle' || operationKind !== ''}}"
                    bindtap="cancelDraftSectionEdit"
                  >取消</button>
                </view>
              </view>
            </view>
          </block>
          <block wx:else>
            <view class="draft-section-actions">
              <view
                class="draft-section-action {{operationKind !== '' || editingSectionId !== '' || (audioPhase !== 'idle' && audioSectionId !== item.section_id) ? 'is-disabled' : ''}}"
                data-id="{{item.section_id}}"
                aria-role="button"
                aria-disabled="{{operationKind !== '' || editingSectionId !== '' || (audioPhase !== 'idle' && audioSectionId !== item.section_id)}}"
                bindtap="playDraftSection"
              >{{audioPhase === "preparing" && audioSectionId === item.section_id ? "准备朗读…" : (audioPhase === "playing" && audioSectionId === item.section_id ? "停止朗读" : "朗读")}}</view>
              <view
                class="draft-section-action {{operationKind !== '' || editingSectionId !== '' ? 'is-disabled' : ''}}"
                data-id="{{item.section_id}}"
                aria-role="button"
                aria-disabled="{{operationKind !== '' || editingSectionId !== ''}}"
                bindtap="startDraftSectionEdit"
              >手动修改</view>
              <view
                class="draft-section-action regenerate {{operationKind !== '' || editingSectionId !== '' ? 'is-disabled' : ''}}"
                data-id="{{item.section_id}}"
                aria-role="button"
                aria-disabled="{{operationKind !== '' || editingSectionId !== ''}}"
                bindtap="startDraftSectionAIEdit"
              >AI 修改</view>
            </view>
            <view wx:if="{{item.expanded}}" class="draft-section-body">
              <text class="draft-content" selectable>{{item.content}}</text>
            </view>
          </block>
        </view>
      </view>

      <view wx:else class="draft-empty">
        <block wx:if="{{workspace.draft_content}}">
          <text class="empty-title">{{draftRecoveryTitle}}</text>
          <text class="empty-detail">{{draftRecoveryDetail}}</text>
          <view
            wx:if="{{chapterPreparationJob && chapterPreparationJob.operation === 'rewrite'}}"
            class="draft-recovery-task-status"
          >
            <ai-task-progress
              title="{{chapterPreparationTitle}}"
              detail="{{chapterPreparationDetail}}"
              mode="{{chapterPreparationProgressMode}}"
              progress="{{chapterPreparationProgress}}"
              can-cancel="{{chapterPreparationJob.can_cancel}}"
              cancel-text="取消生成"
              bindcancel="cancelChapterPreparation"
            />
          </view>
          <view
            class="primary-action draft-recovery-action {{draftRecoveryActionDisabled || operationKind !== '' || editingSectionId !== '' ? 'is-disabled' : ''}}"
            aria-role="button"
            aria-disabled="{{draftRecoveryActionDisabled || operationKind !== '' || editingSectionId !== ''}}"
            bindtap="runDraftRecoveryAction"
          >{{operationKind === "rewrite_chapter" ? rewriteDraftBusyText : (operationKind !== "" ? "正在处理…" : draftRecoveryActionText)}}</view>
        </block>
        <block wx:else>
          <text class="empty-title">正文还没有准备好</text>
          <text class="empty-detail">先完成上面的当前步骤，系统会自动整理正文。</text>
        </block>
      </view>

      <view
        wx:if="{{workspace.draft_sections.length && workspace.completion_summary.state === 'draft_ready'}}"
        class="primary-action confirm-chapter-action {{!canConfirmChapter || operationKind !== '' || editingSectionId !== '' ? 'is-disabled' : ''}}"
        aria-role="button"
        aria-disabled="{{!canConfirmChapter || operationKind !== '' || editingSectionId !== ''}}"
        bindtap="confirmChapter"
      >{{operationKind === "confirm_chapter" ? "正在确认…" : "确认本章正文"}}</view>

      <view wx:if="{{workspace.completion_summary.state === 'confirmed'}}" class="chapter-finished">
        <text class="chapter-finished-title">本章已完成</text>
        <text class="chapter-finished-detail">正文已经收入书稿，可以返回查看其他章节或生成全书。</text>
        <view class="primary-action" aria-role="button" bindtap="returnToBookFlow">完成，返回全书进度</view>
      </view>
    </view>
  </block>
</view>
