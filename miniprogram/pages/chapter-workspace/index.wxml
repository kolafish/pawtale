<view class="workspace-page">
  <view class="page-header">
    <view class="back-hit" bindtap="goBack"><text class="back-mark">‹</text></view>
    <view class="header-main">
      <text class="page-title">{{workspace ? workspace.chapter_title : "章节情况"}}</text>
      <text class="page-meta">先看全章，再决定下一步</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="message error-message">{{error}}</view>
  <view wx:if="{{loading && !workspace}}" class="loading-state">正在读取本章内容</view>

  <block wx:if="{{workspace}}">
    <view class="summary-band">
      <view class="summary-heading">
        <text class="section-eyebrow">本章完整情况</text>
        <text class="summary-title">{{readinessTitle}}</text>
        <text class="summary-detail">{{readinessDetail}}</text>
      </view>
      <view class="summary-grid">
        <view class="summary-cell">
          <text class="summary-number">{{recordedCount}}</text>
          <text class="summary-label">件事已讲清</text>
        </view>
        <view class="summary-cell important">
          <text class="summary-number">{{mustConfirmCount}}</text>
          <text class="summary-label">件需要确认</text>
        </view>
        <view class="summary-cell optional">
          <text class="summary-number">{{suggestionCount}}</text>
          <text class="summary-label">个可选补充</text>
        </view>
        <view class="summary-cell accepted">
          <text class="summary-number">{{acceptedIncompleteCount}}</text>
          <text class="summary-label">项已接受现状</text>
        </view>
      </view>
    </view>

    <view wx:if="{{workspace.contract}}" class="chapter-direction">
      <text class="section-eyebrow">这章准备写</text>
      <text class="direction-title">{{workspace.contract.objective}}</text>
      <text wx:if="{{workspace.contract.reader_takeaway}}" class="direction-detail">{{workspace.contract.reader_takeaway}}</text>
      <view wx:if="{{outlineTitles.length}}" class="outline-line">
        <text wx:for="{{outlineTitles}}" wx:key="*this" class="outline-item">{{index + 1}}. {{item}}</text>
      </view>
    </view>

    <view class="next-action-band">
      <text class="section-eyebrow">{{nextAction.eyebrow}}</text>
      <text class="next-action-title">{{nextAction.title}}</text>
      <text class="next-action-detail">{{nextAction.detail}}</text>
      <button
        wx:if="{{nextAction.actionText}}"
        class="primary-action"
        loading="{{contractBusy || auditBusy || draftGenerationBusy}}"
        disabled="{{nextAction.disabled || contractBusy || auditBusy || draftGenerationBusy}}"
        bindtap="runNextAction"
      >{{nextAction.actionText}}</button>
      <view wx:if="{{auditError}}" class="message error-message">{{auditError}}</view>
    </view>

    <view wx:if="{{editorialGaps.length}}" class="content-section" id="editorial-fixes">
      <view class="section-heading">
        <view>
          <text class="section-eyebrow">已有素材可以处理</text>
          <text class="section-title">不需要继续采访</text>
        </view>
        <text class="section-count">{{editorialCount}} 处</text>
      </view>
      <view wx:for="{{editorialGaps}}" wx:key="id" class="suggestion-row">
        <text class="suggestion-title">{{item.title}}</text>
        <text class="suggestion-detail">{{item.description}}</text>
        <button class="row-action" bindtap="openEditorialFix">{{item.actionText}}</button>
      </view>
    </view>

    <view wx:if="{{directions.length}}" class="content-section" id="directions">
      <view class="section-heading">
        <view>
          <text class="section-eyebrow">您来选择</text>
          <text class="section-title">想从哪个方向继续讲</text>
        </view>
        <text class="section-count">最多显示 3 个</text>
      </view>
      <view class="direction-list">
        <view wx:for="{{directions}}" wx:key="id" class="direction-row">
          <view class="direction-copy">
            <text class="direction-state">{{item.statusText}}</text>
            <text class="direction-question">{{item.question}}</text>
            <text wx:if="{{item.contextText}}" class="direction-context">{{item.contextText}}</text>
          </view>
          <button
            class="row-action"
            data-task-id="{{item.id}}"
            loading="{{startingFollowupTaskId === item.id}}"
            disabled="{{startingFollowupTaskId !== ''}}"
            bindtap="startFollowupInterview"
          >{{item.actionText}}</button>
        </view>
      </view>
    </view>

    <view wx:if="{{confirmations.length || reviewGaps.length}}" class="content-section" id="confirmations">
      <view class="section-heading">
        <view>
          <text class="section-eyebrow">成书前要核对</text>
          <text class="section-title">需要您确认的内容</text>
        </view>
        <text class="section-count">{{mustConfirmCount}} 件</text>
      </view>

      <view wx:for="{{confirmations}}" wx:key="id" class="confirmation-row">
        <text class="confirmation-label">刚才的回答还不能准确对应</text>
        <text class="confirmation-title">{{item.question}}</text>
        <text wx:if="{{item.answerText}}" class="confirmation-answer">您刚才说：{{item.answerText}}</text>
        <button
          class="row-action"
          data-task-id="{{item.taskId}}"
          loading="{{startingFollowupTaskId === item.taskId}}"
          disabled="{{startingFollowupTaskId !== ''}}"
          bindtap="startFollowupInterview"
        >再说明一句</button>
      </view>

      <view wx:for="{{reviewGaps}}" wx:key="id" class="confirmation-row">
        <text class="confirmation-label">请确认是否准确</text>
        <text class="confirmation-title">{{item.title}}</text>
        <text class="confirmation-answer">{{item.description}}</text>
        <button
          wx:if="{{item.taskId}}"
          class="row-action explain-action"
          data-task-id="{{item.taskId}}"
          loading="{{startingFollowupTaskId === item.taskId}}"
          disabled="{{startingFollowupTaskId !== ''}}"
          bindtap="startFollowupInterview"
        >通过语音说明</button>
        <input
          class="gap-resolution-input"
          value="{{item.resolutionText}}"
          placeholder="如：正确的是十八岁，十九岁是记错了"
          maxlength="1000"
          data-gap-id="{{item.id}}"
          bindinput="changeGapResolution"
        />
        <view class="confirmation-actions">
          <button data-gap-id="{{item.id}}" data-action="resolve" disabled="{{actionBusyGapId !== ''}}" bindtap="applyGapAction">保存正确说法</button>
          <button data-gap-id="{{item.id}}" data-action="accept-incomplete" disabled="{{actionBusyGapId !== ''}}" bindtap="applyGapAction">先按现有内容</button>
          <button data-gap-id="{{item.id}}" data-action="not-applicable" disabled="{{actionBusyGapId !== ''}}" bindtap="applyGapAction">与本章无关</button>
        </view>
      </view>
    </view>

    <view class="content-section">
      <view class="section-heading">
        <view>
          <text class="section-eyebrow">已经掌握</text>
          <text class="section-title">本章目前讲清的内容</text>
        </view>
        <text class="section-count">{{recordedCount}} 件</text>
      </view>
      <view wx:if="{{recordedStories.length}}" class="recorded-list">
        <view wx:for="{{recordedStories}}" wx:key="id" class="recorded-row">
          <text class="recorded-title">{{item.title}}</text>
          <text wx:if="{{item.summary}}" class="recorded-summary">{{item.summary}}</text>
        </view>
      </view>
      <text wx:else class="empty-copy">本章还没有可用于成书的讲述。</text>
    </view>

    <view wx:if="{{appliedAnswerUpdates.length}}" class="content-section update-section">
      <view class="section-heading">
        <view>
          <text class="section-eyebrow">最近变化</text>
          <text class="section-title">回答已经放回本章</text>
        </view>
      </view>
      <view wx:for="{{appliedAnswerUpdates}}" wx:key="id" class="update-row">
        <text class="update-question">{{item.question}}</text>
        <text class="update-summary">{{item.summaryText}}</text>
      </view>
    </view>

    <view class="content-section draft-section" id="chapter-draft">
      <view class="draft-heading">
        <view>
          <text class="section-eyebrow">本章正文</text>
          <text class="section-title">通读和修改</text>
        </view>
        <view class="draft-actions">
          <button
            class="secondary-action"
            loading="{{draftGenerationBusy}}"
            disabled="{{draftGenerationBusy || editingBlockId || revisionBlockId || !workspace.contract || workspace.contract.status !== 'confirmed'}}"
            bindtap="generateDraftBlocks"
          >{{draftBlocks.length ? "重新整理" : "生成正文"}}</button>
          <button
            class="secondary-action strong"
            loading="{{assemblingDraft}}"
            disabled="{{assemblingDraft || editingBlockId || revisionBlockId || !canAssembleDraft}}"
            bindtap="assembleChapterDraft"
          >确认本章正文</button>
        </view>
      </view>

      <text wx:if="{{draftGenerationStatus}}" class="job-state">{{draftGenerationStatus}}</text>
      <view wx:if="{{draftError}}" class="message error-message">{{draftError}}</view>
      <view wx:if="{{draftBlocks.length}}" class="draft-list">
        <view wx:for="{{draftBlocks}}" wx:key="id" class="draft-row {{item.freshness_status === 'stale' ? 'stale' : ''}}">
          <view class="draft-row-head">
            <text class="draft-section-title">{{item.sectionTitle}}</text>
            <text class="draft-status">{{item.statusText}}</text>
          </view>
          <block wx:if="{{editingBlockId === item.id}}">
            <textarea
              class="draft-editor"
              value="{{editingBlockContent}}"
              maxlength="-1"
              auto-height
              cursor-spacing="24"
              bindinput="changeDraftBlockContent"
            />
            <view class="edit-actions">
              <button bindtap="cancelDraftBlockEdit">取消</button>
              <button class="save" data-block-id="{{item.id}}" loading="{{item.busy}}" disabled="{{item.busy}}" bindtap="saveDraftBlockEdit">保存修改</button>
            </view>
          </block>
          <block wx:else>
            <text class="draft-content">{{item.current_version.content}}</text>
            <view class="draft-inline-actions">
              <button class="text-action" data-block-id="{{item.id}}" bindtap="toggleDraftBlockSources">
                {{sourceBlockId === item.id ? "收起依据" : "查看依据"}}
              </button>
              <button
                wx:if="{{item.editorial_status !== 'confirmed' && item.freshness_status !== 'stale'}}"
                class="text-action"
                data-block-id="{{item.id}}"
                loading="{{item.busy}}"
                disabled="{{item.busy || revisionBlockId}}"
                bindtap="confirmDraftBlock"
              >这段可以</button>
              <button
                class="text-action"
                data-block-id="{{item.id}}"
                loading="{{item.busy}}"
                disabled="{{item.busy || revisionBlockId}}"
                bindtap="toggleDraftBlockProtection"
              >{{item.locked ? "解除保护" : "保护这段"}}</button>
              <button
                wx:if="{{!item.locked}}"
                class="text-action"
                data-block-id="{{item.id}}"
                disabled="{{item.busy || revisionBlockId}}"
                bindtap="startDraftBlockEdit"
              >编辑这一段</button>
            </view>
            <view wx:if="{{sourceBlockId === item.id}}" class="draft-source-panel">
              <text class="draft-source-summary">{{item.sourceCountText}}</text>
              <view wx:for="{{item.sourceStories}}" wx:for-item="sourceStory" wx:key="id" class="draft-source-row">
                <text class="draft-source-kind">相关讲述</text>
                <text class="draft-source-title">{{sourceStory.title}}</text>
              </view>
              <view wx:for="{{item.sourceFacts}}" wx:for-item="sourceFact" wx:key="id" class="draft-source-row">
                <text class="draft-source-kind">正文依据</text>
                <text class="draft-source-title">{{sourceFact.statement}}</text>
                <text wx:if="{{sourceFact.evidenceText}}" class="draft-source-quote">原话：{{sourceFact.evidenceText}}</text>
              </view>
            </view>
            <view class="draft-revision-panel">
              <input
                class="draft-revision-input"
                value="{{item.revisionFeedback}}"
                placeholder="例如：把单位改成具体名称，只调整这一段"
                maxlength="4000"
                data-block-id="{{item.id}}"
                bindinput="changeDraftRevisionFeedback"
              />
              <button
                class="revision-action"
                data-block-id="{{item.id}}"
                loading="{{revisionBlockId === item.id && !revisionSuggestion}}"
                disabled="{{item.locked || item.busy || revisionBlockId || draftGenerationBusy || editingBlockId}}"
                bindtap="requestDraftBlockRevision"
              >按修改意见生成建议</button>
              <text wx:if="{{revisionBlockId === item.id && revisionStatus}}" class="revision-status">{{revisionStatus}}</text>
              <view wx:if="{{revisionBlockId === item.id && revisionSuggestion}}" class="draft-suggestion">
                <text class="suggestion-label">建议版本</text>
                <text class="suggestion-content">{{revisionSuggestion}}</text>
                <view class="edit-actions">
                  <button bindtap="discardDraftBlockRevision">放弃</button>
                  <button class="save" data-block-id="{{item.id}}" loading="{{item.busy}}" disabled="{{item.busy}}" bindtap="applyDraftBlockSuggestion">采用建议</button>
                </view>
              </view>
            </view>
          </block>
        </view>
      </view>
      <text wx:else class="empty-copy">确认本章方向后，就可以根据现有讲述生成正文。</text>
    </view>
  </block>
</view>
