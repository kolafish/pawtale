.workspace-page {
  min-height: 100vh;
  padding: 34rpx 30rpx 112rpx;
  box-sizing: border-box;
  background: #f7f4ee;
  color: #2b211e;
}

.page-header,
.draft-heading,
.edit-actions {
  display: flex;
  align-items: center;
}

.page-header {
  gap: 18rpx;
}

.back-hit {
  width: 88rpx;
  height: 88rpx;
  margin-left: -18rpx;
  flex: 0 0 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-mark {
  color: #a64b3e;
  font-size: 68rpx;
  line-height: 1;
}

.header-main {
  min-width: 0;
  flex: 1 1 auto;
}

.page-title,
.page-meta,
.section-kicker,
.status-title,
.status-detail,
.section-title,
.section-detail,
.rewrite-notice-title,
.rewrite-notice-detail,
.section-structure-summary,
.section-name,
.section-meta,
.section-material-index,
.section-material-text,
.draft-section-title,
.draft-section-meta,
.draft-content,
.empty-title,
.empty-detail,
.loading-state {
  display: block;
  overflow-wrap: anywhere;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 52rpx;
  text-wrap: balance;
}

.page-meta {
  margin-top: 4rpx;
  color: #756963;
  font-size: 24rpx;
  line-height: 34rpx;
}

.loading-state {
  padding: 160rpx 20rpx;
  color: #756963;
  font-size: 28rpx;
  line-height: 42rpx;
  text-align: center;
}

.status-card,
.content-card {
  margin-top: 30rpx;
  padding: 34rpx 30rpx;
  box-sizing: border-box;
  border: 1rpx solid #ded6cd;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(71, 50, 42, 0.05);
}

.status-card {
  border-left: 6rpx solid #a64b3e;
}

.section-kicker {
  color: #8b5b43;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.status-title {
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 58rpx;
  text-wrap: balance;
}

.status-detail,
.section-detail {
  margin-top: 14rpx;
  color: #675d58;
  font-size: 27rpx;
  line-height: 44rpx;
  text-wrap: pretty;
}

.section-title {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-wrap: balance;
}

.structure-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20rpx;
}

.section-structure-summary {
  flex: 0 0 auto;
  max-width: 100%;
  padding-top: 4rpx;
  color: #756963;
  font-size: 23rpx;
  line-height: 34rpx;
  font-variant-numeric: tabular-nums;
}

.section-list {
  margin-top: 24rpx;
  border-top: 1rpx solid #e8e1d9;
}

.section-item {
  border-bottom: 1rpx solid #e8e1d9;
}

.section-toggle {
  width: 100%;
  min-height: 104rpx;
  margin: 0;
  padding: 20rpx 2rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
  border-radius: 0;
  background: transparent;
  color: #2b211e;
  text-align: left;
  transition-property: opacity, transform;
  transition-duration: 120ms;
  transition-timing-function: ease-out;
}

.section-toggle::after {
  border: 0;
}

.section-toggle:active {
  opacity: 0.72;
  transform: scale(0.96);
}

.section-index {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #f3e8e1;
  color: #8f4439;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 32rpx;
  font-variant-numeric: tabular-nums;
}

.section-copy {
  min-width: 0;
  flex: 1 1 auto;
}

.section-name {
  color: #382c28;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-wrap: balance;
}

.section-meta {
  margin-top: 4rpx;
  color: #786c66;
  font-size: 23rpx;
  line-height: 34rpx;
  font-variant-numeric: tabular-nums;
}

.section-expand-mark {
  flex: 0 0 auto;
  color: #9a4b3f;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.section-material-list {
  margin: 0 0 22rpx 66rpx;
  padding: 4rpx 22rpx;
  border-radius: 12rpx;
  background: #faf7f2;
  box-shadow:
    0 0 0 1rpx rgba(77, 56, 47, 0.05),
    0 2rpx 6rpx rgba(77, 56, 47, 0.04);
}

.section-material {
  padding: 18rpx 0;
}

.section-material + .section-material {
  border-top: 1rpx solid #e8e1d9;
}

.section-material-index {
  color: #8f5c48;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 32rpx;
  font-variant-numeric: tabular-nums;
}

.section-material-text {
  margin-top: 6rpx;
  color: #5c504a;
  font-size: 25rpx;
  line-height: 40rpx;
  white-space: pre-wrap;
  text-wrap: pretty;
}

.primary-action,
.secondary-action,
.text-action {
  min-height: 88rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  transition: transform 120ms ease, opacity 120ms ease, background-color 120ms ease;
}

.primary-action {
  width: 100%;
  margin: 28rpx 0 0;
  padding: 16rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #a64b3e;
  color: #ffffff;
  line-height: 40rpx;
}

.primary-action:active,
.secondary-action:active,
.text-action:active {
  transform: scale(0.96);
}

.primary-action::after,
.secondary-action::after,
.text-action::after {
  border: 0;
}

button[disabled] {
  opacity: 0.46;
}

.draft-editor {
  width: 100%;
  min-height: 150rpx;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  border: 1rpx solid #d9cec3;
  border-radius: 12rpx;
  background: #ffffff;
  color: #2b211e;
  font-size: 28rpx;
  line-height: 44rpx;
}

.draft-heading {
  justify-content: space-between;
  gap: 20rpx;
}

.rewrite-notice {
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #fbf3ed;
  box-shadow:
    0 0 0 1rpx rgba(96, 55, 43, 0.06),
    0 2rpx 4rpx -2rpx rgba(96, 55, 43, 0.08),
    0 6rpx 16rpx rgba(96, 55, 43, 0.05);
}

.rewrite-notice-title {
  color: #713c32;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-wrap: balance;
  font-variant-numeric: tabular-nums;
}

.rewrite-notice-detail {
  margin-top: 10rpx;
  color: #675d58;
  font-size: 25rpx;
  line-height: 40rpx;
  text-wrap: pretty;
}

.rewrite-action {
  width: 100%;
  min-height: 88rpx;
  margin: 22rpx 0 0;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #fffaf6;
  color: #8f4439;
  box-shadow: 0 0 0 1rpx rgba(143, 68, 57, 0.16);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
  transition-property: transform, opacity, box-shadow;
  transition-duration: 120ms;
  transition-timing-function: ease-out;
}

.rewrite-action::after {
  border: 0;
}

.rewrite-action:active {
  transform: scale(0.96);
}

.confirmed-badge {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #e4f0e9;
  color: #39705a;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.draft-section-list {
  margin-top: 26rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #e5ded6;
}

.draft-section-card {
  padding: 28rpx 26rpx;
  border-radius: 16rpx;
  background: #faf7f2;
  box-shadow:
    0 0 0 1rpx rgba(77, 56, 47, 0.06),
    0 2rpx 5rpx -2rpx rgba(77, 56, 47, 0.08),
    0 8rpx 20rpx rgba(77, 56, 47, 0.04);
}

.draft-section-card + .draft-section-card {
  margin-top: 22rpx;
}

.draft-section-heading {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #e5ded6;
}

.draft-section-number {
  color: #8f5c48;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 32rpx;
  font-variant-numeric: tabular-nums;
}

.draft-section-title {
  margin-top: 6rpx;
  color: #382c28;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 46rpx;
  text-wrap: balance;
}

.draft-section-meta {
  margin-top: 6rpx;
  color: #786c66;
  font-size: 23rpx;
  line-height: 34rpx;
  font-variant-numeric: tabular-nums;
}

.draft-content {
  margin-top: 22rpx;
  color: #403531;
  font-size: 29rpx;
  line-height: 52rpx;
  white-space: pre-wrap;
  text-wrap: pretty;
}

.text-action {
  width: auto;
  min-width: 184rpx;
  margin: 20rpx 0 0;
  padding: 14rpx 24rpx;
  background: #f3ece6;
  color: #8f4439;
  line-height: 40rpx;
}

.edit-actions {
  margin-top: 18rpx;
  justify-content: flex-end;
  gap: 16rpx;
}

.secondary-action {
  min-width: 150rpx;
  margin: 0;
  padding: 14rpx 22rpx;
  background: #f1ebe5;
  color: #675d58;
  line-height: 40rpx;
}

.secondary-action.strong {
  background: #a64b3e;
  color: #ffffff;
}

.draft-empty {
  padding: 70rpx 10rpx 54rpx;
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.empty-detail {
  margin-top: 12rpx;
  color: #756963;
  font-size: 25rpx;
  line-height: 40rpx;
}

.confirm-chapter-action {
  margin-top: 32rpx;
}

.message {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  line-height: 40rpx;
}

.error-message {
  background: #fff0ed;
  color: #9c3d32;
}
