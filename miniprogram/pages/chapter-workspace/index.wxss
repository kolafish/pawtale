@import "../../templates/reading-share.wxss";
.workspace-page {
  padding: 22rpx 30rpx 112rpx;
  color: var(--ui-text-primary);
}

.draft-heading,
.edit-actions {
  display: flex;
  align-items: center;
}

.section-kicker,
.status-title,
.status-detail,
.section-title,
.rewrite-notice-title,
.rewrite-notice-detail,
.section-structure-summary,
.section-name,
.section-meta,
.section-material-index,
.section-material-text,
.section-content-label,
.empty-title,
.empty-detail,
.loading-state {
  display: block;
  overflow-wrap: anywhere;
}

.loading-state {
  padding: 160rpx 20rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  line-height: 42rpx;
  text-align: center;
}

.content-card {
  margin-top: 26rpx;
  padding: 30rpx;
}

.story-detail-summary {
  min-height: 80rpx;
  margin-top: 2rpx;
  padding: 0 2rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.story-detail-summary-text {
  min-width: 0;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  font-variant-numeric: tabular-nums;
  text-wrap: pretty;
}

.story-media-action {
  min-height: 80rpx;
  margin-right: -10rpx;
  padding: 0 10rpx 0 14rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 34rpx;
  white-space: nowrap;
}

.story-media-icon {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
}

.story-media-arrow {
  margin-left: -2rpx;
  color: var(--ui-text-secondary);
  font-size: 32rpx;
  font-weight: 300;
  line-height: 34rpx;
}

.focused-story-card,
.focused-memories-card {
  padding: 32rpx 30rpx;
}

.focused-story-card {
  margin-top: 10rpx;
}

.focused-memories-card {
  margin-top: 22rpx;
}

.focused-card-label,
.focused-story-content,
.focused-memory-index,
.focused-memory-preview {
  display: block;
  overflow-wrap: anywhere;
}

.focused-card-label {
  color: var(--ui-section-title);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  letter-spacing: 0.03em;
  line-height: 38rpx;
}

.focused-story-content {
  margin-top: 16rpx;
  overflow: visible;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 30rpx;
  line-height: 56rpx;
  white-space: pre-wrap;
  text-wrap: pretty;
}

.focused-story-content.is-collapsed {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 8;
}

.focused-story-expand {
  min-height: 80rpx;
  margin: 4rpx auto -4rpx;
  padding: 10rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-caption);
  font-weight: 600;
  line-height: 34rpx;
}

.focused-story-expand-icon {
  display: inline-block;
  font-size: var(--ui-font-action);
  font-weight: 400;
  line-height: 30rpx;
  transform: translateY(-2rpx) rotate(0deg);
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: ease-out;
}

.focused-story-expand-icon.is-expanded {
  transform: translateY(2rpx) rotate(180deg);
}

.focused-story-actions {
  margin-top: 12rpx;
  padding-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.focused-story-action {
  min-width: 0;
  min-height: 86rpx;
  padding: 10rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface);
  color: var(--ui-text-secondary);
  box-shadow: var(--ui-control-shadow);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
}

.focused-story-action.is-accent {
  color: var(--ui-accent-strong);
  box-shadow:
    0 0 0 1rpx var(--ui-accent-border),
    0 2rpx 6rpx rgba(63, 47, 37, 0.035);
}

.focused-story-action-icon {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
}

.focused-story-editor {
  margin-top: 18rpx;
}

.focused-story-empty .empty-detail {
  margin-top: 14rpx;
  text-align: left;
}

.focused-memories-heading {
  min-height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.focused-memories-count {
  flex: 0 0 auto;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-caption);
  line-height: 34rpx;
  font-variant-numeric: tabular-nums;
}

.focused-memory-list {
  margin-top: 12rpx;
}

.focused-memory-row {
  width: 100%;
  min-height: 126rpx;
  padding: 20rpx 2rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.focused-memory-row + .focused-memory-row {
  border-top: 1rpx solid var(--ui-divider);
}

.focused-memory-copy {
  min-width: 0;
  flex: 1 1 auto;
}

.focused-memory-index {
  color: var(--ui-section-title);
  font-size: var(--ui-font-caption);
  font-weight: 700;
  line-height: 32rpx;
  font-variant-numeric: tabular-nums;
}

.focused-memory-preview {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  white-space: pre-wrap;
  text-wrap: pretty;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.focused-memory-arrow {
  width: 48rpx;
  height: 64rpx;
  flex: 0 0 48rpx;
  padding-left: 2rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-text-secondary);
  font-size: 40rpx;
  font-weight: 300;
  line-height: 48rpx;
}

.chapter-hero {
  position: relative;
  min-height: 392rpx;
  margin-top: 10rpx;
  padding: 36rpx 30rpx 30rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 92% 14%, rgba(226, 232, 209, 0.48), rgba(255, 253, 250, 0) 42%),
    var(--ui-surface);
}

.chapter-hero-copy {
  position: relative;
  z-index: 1;
  min-height: 226rpx;
  padding-right: 210rpx;
}

.chapter-hero-kicker {
  display: block;
  min-width: 0;
  color: var(--ui-accent-strong);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 38rpx;
  text-wrap: balance;
}

.chapter-story-count,
.chapter-story-detail,
.friendly-section-title,
.story-overview-name,
.story-overview-meta,
.editing-entry-title,
.editing-entry-detail {
  display: block;
  overflow-wrap: anywhere;
}

.chapter-story-count {
  margin-top: 14rpx;
  font-family: var(--ui-font-editorial);
  font-size: 54rpx;
  font-weight: 700;
  line-height: 68rpx;
  text-wrap: balance;
  font-variant-numeric: tabular-nums;
}

.chapter-story-detail {
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: 42rpx;
  text-wrap: pretty;
}

.chapter-growth-image {
  position: absolute;
  top: 28rpx;
  right: -10rpx;
  width: 240rpx;
  height: 240rpx;
  opacity: 0.9;
}

.chapter-read-primary {
  position: relative;
  z-index: 1;
  width: 100%;
  min-height: 96rpx;
  margin-top: 24rpx;
  padding: 14rpx 22rpx 14rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: rgba(255, 253, 250, 0.88);
  color: var(--ui-accent-strong);
  box-shadow:
    0 0 0 1rpx var(--ui-accent-border),
    0 8rpx 22rpx rgba(78, 58, 45, 0.07);
  font-size: var(--ui-font-action);
  font-weight: 700;
  line-height: 42rpx;
}

.chapter-primary-label {
  display: block;
  text-align: center;
}

.chapter-primary-arrow {
  position: absolute;
  right: 20rpx;
  width: 50rpx;
  height: 50rpx;
  padding-left: 2rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--ui-accent-surface);
  color: var(--ui-accent-strong);
  box-shadow: 0 0 0 1rpx rgba(182, 93, 73, 0.08);
  font-size: 38rpx;
  font-weight: 400;
  line-height: 46rpx;
}

.chapter-next-primary {
  background: linear-gradient(135deg, var(--ui-accent), var(--ui-accent-strong));
  color: var(--ui-on-accent);
  box-shadow:
    0 0 0 1rpx rgba(148, 69, 53, 0.10),
    0 12rpx 28rpx rgba(148, 69, 53, 0.18);
}

.chapter-hero-followup {
  min-height: 80rpx;
  margin-top: 10rpx;
  padding: 10rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-body);
  font-weight: 700;
  line-height: var(--ui-line-body);
  transition-property: transform, opacity;
  transition-duration: 150ms;
}

.chapter-hero-followup:active {
  transform: scale(0.96);
}

.chapter-hero-followup.is-disabled {
  opacity: 0.55;
}

.friendly-section-title {
  min-width: 0;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 46rpx;
  text-wrap: balance;
}

.story-overview-list {
  margin-top: 18rpx;
}

.story-overview-row {
  width: 100%;
  min-height: 112rpx;
  padding: 18rpx 2rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.story-overview-row + .story-overview-row {
  border-top: 1rpx solid var(--ui-divider);
}

.story-overview-index {
  width: 58rpx;
  min-height: 58rpx;
  flex: 0 0 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-accent-strong);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  letter-spacing: 0.04em;
  line-height: 38rpx;
  font-variant-numeric: tabular-nums;
}

.story-overview-copy {
  min-width: 0;
  flex: 1 1 auto;
}

.story-overview-name {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-list-title);
  font-weight: 700;
  line-height: 1.4;
  text-wrap: balance;
}

.story-overview-meta {
  margin-top: 4rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-caption);
  line-height: 34rpx;
  font-variant-numeric: tabular-nums;
}

.story-overview-arrow {
  width: 44rpx;
  height: 56rpx;
  flex: 0 0 44rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: var(--ui-text-secondary);
  font-size: 42rpx;
  font-weight: 300;
  line-height: 52rpx;
}

.friendly-suggestions-card {
  padding-bottom: 26rpx;
}

.editing-entry {
  min-height: 112rpx;
  margin-top: 26rpx;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.editing-entry-icon {
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--ui-surface-subtle);
  color: var(--ui-warning-text);
  font-family: var(--ui-font-editorial);
  font-size: 34rpx;
  line-height: 1;
}

.editing-entry-title {
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-action);
  font-weight: 700;
  line-height: 42rpx;
}

.editing-entry-copy {
  min-width: 0;
  flex: 1 1 auto;
}

.editing-entry-detail {
  margin-top: 2rpx;
  color: var(--ui-warning-text);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  font-variant-numeric: tabular-nums;
}

.editing-entry-mark {
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-text-secondary);
}

.editing-entry-chevron {
  width: 16rpx;
  height: 16rpx;
  margin-top: -8rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg);
  transform-origin: center;
  transition: transform 180ms ease, margin 180ms ease;
}

.editing-entry-chevron.is-expanded {
  margin-top: 8rpx;
  transform: rotate(225deg);
}

.workspace-page.large-text .chapter-hero-copy {
  min-height: 250rpx;
  padding-right: 0;
}

.workspace-page.large-text .chapter-growth-image {
  top: 18rpx;
  right: -34rpx;
  opacity: 0.16;
}

.workspace-page.large-text .chapter-hero-kicker,
.workspace-page.large-text .story-overview-meta {
  font-size: var(--ui-font-large-meta);
  line-height: 42rpx;
}

.workspace-page.large-text .story-overview-index {
  font-size: var(--ui-font-large-body);
  line-height: 44rpx;
}

.workspace-page.large-text .chapter-story-count {
  font-size: 58rpx;
  line-height: 74rpx;
}

.workspace-page.large-text .chapter-story-detail,
.workspace-page.large-text .friendly-section-title,
.workspace-page.large-text .story-overview-name,
.workspace-page.large-text .editing-entry-title {
  font-size: var(--ui-font-large-list-title);
  line-height: 48rpx;
}

.workspace-page.large-text .story-detail-summary-text,
.workspace-page.large-text .story-media-action,
.workspace-page.large-text .focused-card-label,
.workspace-page.large-text .focused-memories-count,
.workspace-page.large-text .focused-memory-index {
  font-size: var(--ui-font-large-meta);
  line-height: 42rpx;
}

.workspace-page.large-text .focused-story-content {
  font-size: 34rpx;
  line-height: 62rpx;
}

.workspace-page.large-text .focused-memory-preview {
  font-size: var(--ui-font-large-meta);
  line-height: 46rpx;
}

.workspace-page.large-text .focused-story-action,
.workspace-page.large-text .focused-story-expand {
  font-size: var(--ui-font-large-caption);
  line-height: 38rpx;
}

.chapter-preparation-status,
.section-regeneration-status {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: var(--ui-radius-inner);
  background: rgba(255, 253, 250, 0.72);
  box-shadow: inset 0 0 0 1rpx rgba(88, 112, 82, 0.1);
}

.section-kicker {
  color: var(--ui-section-title);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  letter-spacing: 0.04em;
  line-height: 34rpx;
}

.status-title {
  margin-top: 10rpx;
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-page-title);
  font-weight: 700;
  line-height: 58rpx;
  text-wrap: balance;
}

.status-detail {
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: 44rpx;
  text-wrap: pretty;
}

.section-title {
  margin-top: 8rpx;
  font-family: var(--ui-font-editorial);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-wrap: balance;
}

.section-structure-summary {
  max-width: 100%;
  padding-top: 4rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  font-variant-numeric: tabular-nums;
}

.structure-expand-mark {
  flex: 0 0 auto;
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 36rpx;
}

.structure-tools-detail {
  display: block;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  text-wrap: pretty;
}

.structure-actions {
  margin-top: 8rpx;
}

.structure-regenerate-action {
  width: 100%;
  min-height: 96rpx;
  padding: 14rpx 2rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-top: 1rpx solid var(--ui-divider);
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-action);
  font-weight: 600;
  line-height: 40rpx;
}

.structure-regenerate-arrow {
  color: var(--ui-text-secondary);
  font-size: 38rpx;
  font-weight: 300;
  line-height: 46rpx;
}

.rewrite-action {
  width: 100%;
  min-height: 88rpx;
  margin-top: 18rpx;
  padding: 14rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
  font-size: var(--ui-font-action);
  font-weight: 700;
  line-height: 40rpx;
}

.section-list {
  margin-top: 22rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.section-item {
  border-bottom: 1rpx solid var(--ui-divider);
}

.section-item.is-unassigned {
  margin: 18rpx 0;
  overflow: hidden;
  border-bottom: 0;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-warning-surface);
  box-shadow: inset 0 0 0 1rpx rgba(134, 98, 49, 0.1);
}

.section-item.is-unassigned .section-toggle {
  padding-right: 20rpx;
  padding-left: 20rpx;
}

.section-item.is-unassigned .section-index {
  border-radius: 50%;
  color: var(--ui-warning-text);
  box-shadow: inset 0 0 0 1rpx rgba(134, 98, 49, 0.2);
}

.section-item.is-unassigned .section-material-list {
  margin-right: 20rpx;
  margin-left: 20rpx;
  border-left-color: rgba(134, 98, 49, 0.22);
}

.section-toggle {
  width: 100%;
  min-height: 104rpx;
  margin: 0;
  padding: 20rpx 2rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-radius: 0;
  background: transparent;
  color: var(--ui-text-primary);
  text-align: left;
}

.section-index {
  width: 58rpx;
  min-height: 58rpx;
  flex: 0 0 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-accent-strong);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  letter-spacing: 0.04em;
  line-height: 38rpx;
  font-variant-numeric: tabular-nums;
}

.section-copy {
  min-width: 0;
  flex: 1 1 auto;
  text-align: left;
}

.section-name {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-section-title);
  font-weight: 700;
  line-height: 1.4;
  text-wrap: balance;
}

.section-meta {
  margin-top: 4rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-caption);
  line-height: 34rpx;
  font-variant-numeric: tabular-nums;
}

.section-expand-mark {
  flex: 0 0 auto;
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 36rpx;
}

.section-expand-chevron {
  display: inline-block;
  min-width: 24rpx;
  color: var(--ui-text-secondary);
  font-size: 30rpx;
  font-weight: 400;
  text-align: right;
}

.section-heading-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.section-story-open-action,
.section-title-edit-action {
  min-height: 88rpx;
  margin-left: 76rpx;
  padding: 12rpx 2rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-top: 1rpx solid var(--ui-divider);
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  font-weight: 600;
  line-height: 34rpx;
}

.section-story-open-action {
  color: var(--ui-accent-strong);
}

.section-material-list {
  margin: 0 0 24rpx 66rpx;
  padding: 0 0 0 24rpx;
  border-left: 2rpx solid var(--ui-accent-border);
}

.section-content-label {
  padding-top: 14rpx;
  color: var(--ui-section-title);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-body);
  font-weight: 700;
  letter-spacing: 0.03em;
  line-height: 34rpx;
}

.section-material {
  padding: 16rpx 0;
}

.section-material + .section-material {
  border-top: 1rpx solid var(--ui-divider);
}

.section-material-open {
  width: 100%;
  min-height: 88rpx;
  padding: 4rpx 2rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.section-material-open-copy {
  min-width: 0;
  flex: 1 1 auto;
}

.section-material-open-action {
  flex: 0 0 auto;
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 34rpx;
}

.section-material-index {
  color: var(--ui-section-title);
  font-size: var(--ui-font-caption);
  font-weight: 700;
  line-height: 32rpx;
  font-variant-numeric: tabular-nums;
}

.section-material-text {
  margin-top: 6rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  white-space: pre-wrap;
  text-wrap: pretty;
}

.pending-section-hint {
  display: block;
  padding: 16rpx 0 4rpx;
  color: var(--ui-warning-text);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  text-wrap: pretty;
}

.material-assignment-action {
  width: 100%;
  min-height: 88rpx;
  margin-top: 14rpx;
  padding: 14rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface);
  color: var(--ui-warning-text);
  box-shadow: inset 0 0 0 1rpx rgba(134, 98, 49, 0.2);
  font-size: var(--ui-font-action);
  font-weight: 700;
  line-height: 40rpx;
}

.section-merge-action {
  min-height: 88rpx;
  margin: 14rpx 0 8rpx 66rpx;
  padding: 14rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
}

.section-merge-action-title {
  font-size: var(--ui-font-action);
  font-weight: 700;
  line-height: 36rpx;
}

.section-merge-action-detail {
  min-width: 0;
  overflow: hidden;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.primary-action,
.secondary-action {
  min-height: 88rpx;
  border-radius: var(--ui-radius-control);
  font-size: var(--ui-font-action);
  font-weight: 700;
  line-height: 40rpx;
}

.primary-action {
  width: 100%;
  margin: 26rpx 0 0;
  padding: 14rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-accent-strong);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
}

.is-disabled,
button[disabled] {
  pointer-events: none;
  opacity: 0.46;
}

.is-disabled:active,
button[disabled]:active {
  transform: none;
}

.draft-editor {
  width: 100%;
  height: 360rpx;
  min-height: 150rpx;
  max-height: 45vh;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border: 0;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
  color: var(--ui-text-primary);
  box-shadow: inset 0 0 0 1rpx var(--ui-border);
  font-size: var(--ui-font-action);
  line-height: 48rpx;
}

.draft-heading {
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.draft-heading > view:first-child {
  min-width: 0;
  flex: 1 1 auto;
}

.draft-heading-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
}

.chapter-read-action {
  min-height: 88rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.rewrite-notice {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
  box-shadow: inset 0 0 0 1rpx rgba(54, 42, 34, 0.05);
}

.rewrite-notice-title {
  color: var(--ui-section-title);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-list-title);
  font-weight: 700;
  line-height: 1.4;
  text-wrap: balance;
  font-variant-numeric: tabular-nums;
}

.rewrite-notice-detail {
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  text-wrap: pretty;
}

.rewrite-task-status,
.draft-recovery-task-status {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.edit-actions {
  margin-top: 18rpx;
  justify-content: flex-end;
  gap: 14rpx;
}

.secondary-action {
  min-width: 144rpx;
  margin: 0;
  padding: 12rpx 20rpx;
  border: 0;
  background: var(--ui-surface);
  color: var(--ui-text-secondary);
  box-shadow: inset 0 0 0 1rpx var(--ui-border);
}

.secondary-action.strong {
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-accent-strong);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
}

.draft-empty {
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
  box-shadow: inset 0 0 0 1rpx rgba(54, 42, 34, 0.05);
  text-align: center;
}

.empty-title {
  font-family: var(--ui-font-editorial);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.empty-detail {
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  text-wrap: pretty;
}

.draft-recovery-action {
  margin-top: 24rpx;
}

.chapter-finished {
  margin-top: 30rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.chapter-finished-action {
  min-height: 96rpx;
  padding: 18rpx 2rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.chapter-finished-copy {
  min-width: 0;
  flex: 1 1 auto;
}

.chapter-finished-title,
.chapter-finished-detail {
  display: block;
}

.chapter-finished-title {
  color: var(--ui-success-text);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-list-title);
  font-weight: 700;
  line-height: 1.4;
}

.chapter-finished-detail {
  margin-top: 4rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
}

.chapter-finished-arrow {
  width: 44rpx;
  height: 56rpx;
  flex: 0 0 44rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: var(--ui-text-secondary);
  font-size: 42rpx;
  font-weight: 300;
  line-height: 52rpx;
}

.message {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--ui-radius-inner);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
}

.error-message {
  background: var(--ui-accent-surface);
  color: var(--ui-danger-text);
}

.candidate-content,
.candidate-diff-content {
  display: block;
  padding: 22rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-body);
  line-height: 54rpx;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.candidate-content {
  margin: 22rpx 0;
}

.candidate-summary {
  display: block;
  color: var(--ui-text-secondary);
}

.candidate-summary {
  margin-top: 14rpx;
  font-size: var(--ui-font-meta);
  font-variant-numeric: tabular-nums;
  line-height: 38rpx;
  text-wrap: pretty;
}

.candidate-diff {
  margin: 22rpx 0;
}

.candidate-diff-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 18rpx;
  margin-bottom: 14rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-caption);
  line-height: 34rpx;
}

.candidate-diff-legend-item {
  white-space: nowrap;
}

.candidate-diff-marker {
  margin-right: 6rpx;
  padding: 2rpx 6rpx;
  border-radius: 6rpx;
  font-size: var(--ui-font-caption);
  font-weight: 700;
  line-height: 28rpx;
}

.candidate-diff-marker.is-modified,
.candidate-diff-segment.is-modified {
  background: var(--ui-warning-surface);
  color: var(--ui-warning-text);
}

.candidate-diff-marker.is-added,
.candidate-diff-segment.is-added {
  background: var(--ui-success-surface);
  color: var(--ui-success-text);
}

.candidate-diff-marker.is-deleted,
.candidate-diff-segment.is-deleted {
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
}

.candidate-diff-segment.is-deleted {
  text-decoration: line-through;
  text-decoration-thickness: 2rpx;
}

@media (prefers-reduced-motion: reduce) {
  .editing-entry-chevron,
  .focused-story-expand-icon {
    transition: none;
  }
}

.chapter-more-action, .chapter-audio-stop {
  min-height: 44px;
  margin: 12rpx 0 0;
  padding: 0 12rpx;
  border: 0;
  background: transparent;
  box-shadow: none;
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-meta);
  line-height: 1.4;
}
.chapter-more-action {
  display: inline-flex;
  width: auto;
  align-items: center;
  align-self: flex-start;
}
.chapter-audio-notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  line-height: 1.5;
}
.chapter-audio-stop {
  margin-top: 0;
}
.workspace-page.large-text .chapter-more-action, .workspace-page.large-text .chapter-audio-stop, .workspace-page.large-text .chapter-audio-notice {
  min-height: 48px;
  font-size: var(--ui-font-large-meta);
}
