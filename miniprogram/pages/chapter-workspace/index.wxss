.workspace-page {
  min-height: 100vh;
  padding: 34rpx 30rpx 112rpx;
  box-sizing: border-box;
  background: #f7f4ee;
  color: #2b211e;
}

.page-header,
.draft-heading,
.edit-actions {
  display: flex;
  align-items: center;
}

.page-header {
  gap: 18rpx;
}

.back-hit {
  width: 88rpx;
  height: 88rpx;
  margin-left: -18rpx;
  flex: 0 0 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-mark {
  color: #a64b3e;
  font-size: 68rpx;
  line-height: 1;
}

.header-main {
  min-width: 0;
  flex: 1 1 auto;
}

.page-title,
.page-meta,
.section-kicker,
.status-title,
.status-detail,
.section-title,
.section-detail,
.draft-content,
.empty-title,
.empty-detail,
.loading-state {
  display: block;
  overflow-wrap: anywhere;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 52rpx;
  text-wrap: balance;
}

.page-meta {
  margin-top: 4rpx;
  color: #756963;
  font-size: 24rpx;
  line-height: 34rpx;
}

.loading-state {
  padding: 160rpx 20rpx;
  color: #756963;
  font-size: 28rpx;
  line-height: 42rpx;
  text-align: center;
}

.status-card,
.content-card {
  margin-top: 30rpx;
  padding: 34rpx 30rpx;
  box-sizing: border-box;
  border: 1rpx solid #ded6cd;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(71, 50, 42, 0.05);
}

.status-card {
  border-left: 6rpx solid #a64b3e;
}

.section-kicker {
  color: #8b5b43;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.status-title {
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 58rpx;
  text-wrap: balance;
}

.status-detail,
.section-detail {
  margin-top: 14rpx;
  color: #675d58;
  font-size: 27rpx;
  line-height: 44rpx;
  text-wrap: pretty;
}

.section-title {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-wrap: balance;
}

.primary-action,
.secondary-action,
.text-action {
  min-height: 88rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  transition: transform 120ms ease, opacity 120ms ease, background-color 120ms ease;
}

.primary-action {
  width: 100%;
  margin: 28rpx 0 0;
  padding: 16rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #a64b3e;
  color: #ffffff;
  line-height: 40rpx;
}

.primary-action:active,
.secondary-action:active,
.text-action:active {
  transform: scale(0.96);
}

.primary-action::after,
.secondary-action::after,
.text-action::after {
  border: 0;
}

button[disabled] {
  opacity: 0.46;
}

.draft-editor {
  width: 100%;
  min-height: 150rpx;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  border: 1rpx solid #d9cec3;
  border-radius: 12rpx;
  background: #ffffff;
  color: #2b211e;
  font-size: 28rpx;
  line-height: 44rpx;
}

.draft-heading {
  justify-content: space-between;
  gap: 20rpx;
}

.confirmed-badge {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #e4f0e9;
  color: #39705a;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.draft-body {
  margin-top: 26rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #e5ded6;
}

.draft-content {
  color: #403531;
  font-size: 29rpx;
  line-height: 52rpx;
  white-space: pre-wrap;
  text-wrap: pretty;
}

.text-action {
  width: auto;
  min-width: 184rpx;
  margin: 20rpx 0 0;
  padding: 14rpx 24rpx;
  background: #f3ece6;
  color: #8f4439;
  line-height: 40rpx;
}

.edit-actions {
  margin-top: 18rpx;
  justify-content: flex-end;
  gap: 16rpx;
}

.secondary-action {
  min-width: 150rpx;
  margin: 0;
  padding: 14rpx 22rpx;
  background: #f1ebe5;
  color: #675d58;
  line-height: 40rpx;
}

.secondary-action.strong {
  background: #a64b3e;
  color: #ffffff;
}

.draft-empty {
  padding: 70rpx 10rpx 54rpx;
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.empty-detail {
  margin-top: 12rpx;
  color: #756963;
  font-size: 25rpx;
  line-height: 40rpx;
}

.confirm-chapter-action {
  margin-top: 32rpx;
}

.message {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  line-height: 40rpx;
}

.error-message {
  background: #fff0ed;
  color: #9c3d32;
}
