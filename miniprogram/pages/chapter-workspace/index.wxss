.workspace-page {
  min-height: 100vh;
  padding: 36rpx 30rpx 100rpx;
  background: #f7f4ee;
  color: #2b211e;
  box-sizing: border-box;
}

.page-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.back-hit {
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-mark {
  color: #a64b3e;
  font-size: 64rpx;
  line-height: 1;
}

.header-main {
  flex: 1 1 auto;
  min-width: 0;
}

.page-title,
.page-meta {
  display: block;
  overflow-wrap: anywhere;
}

.page-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.page-meta {
  margin-top: 4rpx;
  color: #756963;
  font-size: 24rpx;
  line-height: 34rpx;
}

.audit-button {
  flex: 0 0 auto;
  min-width: 160rpx;
  height: 68rpx;
  margin: 0;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #a64b3e;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 68rpx;
}

.audit-button::after,
.gap-actions button::after {
  border: 0;
}

.audit-button[disabled] {
  background: #cbb8ae;
  color: #ffffff;
}

.audit-state,
.message {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-left: 6rpx solid #527a6a;
  background: #edf5f0;
}

.audit-state.failed,
.error-message {
  border-left-color: #b84a5a;
  background: #fff0f2;
}

.audit-state-title,
.audit-state-error {
  display: block;
  font-size: 26rpx;
  line-height: 38rpx;
}

.audit-state-title {
  color: #345b4c;
  font-weight: 600;
}

.audit-state.failed .audit-state-title,
.audit-state-error,
.error-message {
  color: #a53e50;
}

.audit-state-error {
  margin-top: 6rpx;
  overflow-wrap: anywhere;
}

.overview-section {
  margin-top: 42rpx;
  padding: 42rpx 0 34rpx;
  border-top: 1rpx solid #d8d0c7;
  border-bottom: 1rpx solid #d8d0c7;
}

.overview-eyebrow,
.overview-title,
.overview-detail {
  display: block;
  overflow-wrap: anywhere;
}

.overview-eyebrow {
  color: #8b5b43;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.overview-title {
  margin-top: 16rpx;
  color: #2b211e;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 58rpx;
}

.overview-detail {
  margin-top: 18rpx;
  color: #675d58;
  font-size: 29rpx;
  line-height: 46rpx;
}

.overview-primary-action {
  width: 100%;
  min-height: 92rpx;
  margin: 36rpx 0 0;
  padding: 14rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: #a64b3e;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
  box-sizing: border-box;
}

.overview-primary-action::after,
.overview-detail-action::after,
.overview-return::after {
  border: 0;
}

.overview-primary-action[disabled] {
  background: #cbb8ae;
  color: #ffffff;
}

.overview-detail-action,
.overview-return {
  margin: 22rpx 0 0;
  padding: 8rpx 0;
  background: transparent;
  color: #756963;
  font-size: 25rpx;
  line-height: 36rpx;
}

.overview-detail-action {
  width: 100%;
  text-align: center;
}

.overview-return {
  width: auto;
  text-align: left;
}

.tab-bar {
  margin-top: 26rpx;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  border-bottom: 1rpx solid #d8d0c7;
}

.tab {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 5rpx solid transparent;
  color: #756963;
  font-size: 23rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.tab.active {
  border-bottom-color: #a64b3e;
  color: #842f27;
}

.content-section {
  padding-top: 28rpx;
}

.contract-band {
  padding: 26rpx 0 28rpx;
  border-bottom: 1rpx solid #d8d0c7;
}

.section-label,
.contract-objective,
.contract-takeaway {
  display: block;
}

.section-label {
  color: #8b5b43;
  font-size: 23rpx;
  font-weight: 700;
}

.contract-objective {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.contract-takeaway {
  margin-top: 10rpx;
  color: #675d58;
  font-size: 27rpx;
  line-height: 42rpx;
}

.section-heading,
.row-title-line,
.claim-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.section-heading {
  margin: 30rpx 0 16rpx;
}

.section-title {
  font-size: 31rpx;
  font-weight: 700;
}

.section-count,
.row-meta,
.claim-evidence-count {
  color: #7a706a;
  font-size: 24rpx;
}

.node-list,
.story-list,
.gap-list,
.followup-list,
.draft-block-list {
  border-top: 1rpx solid #d8d0c7;
}

.draft-toolbar,
.draft-block-head,
.draft-block-meta,
.draft-inline-actions {
  display: flex;
  align-items: center;
}

.draft-toolbar,
.draft-block-head,
.draft-block-meta {
  justify-content: space-between;
  gap: 18rpx;
}

.draft-toolbar {
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid #d8d0c7;
}

.draft-toolbar-copy {
  min-width: 0;
}

.draft-toolbar-hint {
  display: block;
  margin-top: 6rpx;
  color: #756963;
  font-size: 23rpx;
  line-height: 32rpx;
}

.draft-toolbar-actions {
  flex: 0 0 auto;
  display: flex;
  gap: 10rpx;
}

.primary-action-button,
.secondary-action-button,
.primary-small-button,
.text-action-button {
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 8rpx;
  font-weight: 600;
}

.primary-action-button,
.secondary-action-button {
  min-height: 68rpx;
  padding: 8rpx 18rpx;
  font-size: 23rpx;
  line-height: 32rpx;
}

.primary-action-button,
.primary-small-button {
  border: 1rpx solid #a64b3e;
  background: #a64b3e;
  color: #ffffff;
}

.secondary-action-button {
  border: 1rpx solid #b99e91;
  background: #ffffff;
  color: #7e3c32;
}

.primary-action-button::after,
.secondary-action-button::after,
.primary-small-button::after,
.text-action-button::after {
  border: 0;
}

.primary-action-button[disabled],
.secondary-action-button[disabled],
.primary-small-button[disabled],
.text-action-button[disabled] {
  border-color: #d5cdc6;
  background: #eeeae5;
  color: #a29a94;
}

.draft-job-state {
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border-left: 5rpx solid #527a6a;
  background: #edf5f0;
  color: #345b4c;
  font-size: 24rpx;
  line-height: 36rpx;
}

.draft-block-row {
  padding: 28rpx 0 30rpx;
  border-bottom: 1rpx solid #d8d0c7;
}

.draft-block-row.stale {
  border-left: 5rpx solid #b67a20;
  padding-left: 18rpx;
}

.draft-block-heading {
  flex: 1 1 auto;
  min-width: 0;
}

.draft-block-role,
.draft-block-node,
.draft-block-content,
.draft-source-title,
.draft-source-statement,
.draft-source-evidence,
.draft-revision-status,
.draft-suggestion-label,
.draft-suggestion-content {
  display: block;
  overflow-wrap: anywhere;
}

.draft-block-role {
  color: #8b5b43;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.draft-block-node {
  margin-top: 4rpx;
  color: #2b211e;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.draft-block-badges {
  flex: 0 1 auto;
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 6rpx;
}

.draft-status-label {
  padding: 4rpx 9rpx;
  border-radius: 6rpx;
  background: #eee8df;
  color: #645a54;
  font-size: 20rpx;
  line-height: 28rpx;
}

.draft-status-label.confirmed,
.draft-status-label.current {
  background: #e7f1eb;
  color: #35604e;
}

.draft-status-label.stale {
  background: #fff2dd;
  color: #8c5b12;
}

.draft-status-label.locked {
  background: #e8e3ef;
  color: #5e4d73;
}

.draft-block-content {
  margin-top: 20rpx;
  color: #332824;
  font-size: 29rpx;
  line-height: 48rpx;
  white-space: pre-wrap;
}

.draft-block-editor {
  width: 100%;
  min-height: 220rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #bdaea4;
  border-radius: 8rpx;
  background: #ffffff;
  color: #332824;
  font-size: 28rpx;
  line-height: 46rpx;
  box-sizing: border-box;
}

.draft-block-meta {
  margin-top: 16rpx;
  color: #7a706a;
  font-size: 22rpx;
  line-height: 32rpx;
}

.draft-inline-actions {
  margin-top: 14rpx;
  justify-content: flex-end;
  gap: 10rpx;
}

.draft-inline-actions.wrap {
  justify-content: flex-start;
  flex-wrap: wrap;
}

.text-action-button,
.primary-small-button {
  min-width: 108rpx;
  min-height: 60rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  line-height: 30rpx;
}

.text-action-button {
  border: 1rpx solid #cabdb4;
  background: #ffffff;
  color: #6e3b32;
}

.draft-source-panel,
.draft-revision-panel {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-left: 5rpx solid #608273;
  background: #f1f5f2;
}

.draft-source-story,
.draft-source-claim {
  padding: 12rpx 0;
}

.draft-source-story + .draft-source-story,
.draft-source-claim + .draft-source-claim,
.draft-source-story + .draft-source-claim {
  border-top: 1rpx solid #d7e2dc;
}

.draft-source-kind,
.draft-suggestion-label {
  color: #315947;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.draft-source-title,
.draft-source-statement {
  margin-top: 5rpx;
  color: #332824;
  font-size: 25rpx;
  line-height: 38rpx;
}

.draft-source-evidence {
  margin-top: 8rpx;
  color: #68706c;
  font-size: 23rpx;
  line-height: 36rpx;
}

.draft-source-empty {
  color: #756963;
  font-size: 24rpx;
  line-height: 36rpx;
}

.draft-revision-panel {
  border-left-color: #8b5b43;
  background: #f8f1e9;
}

.draft-revision-input {
  width: 100%;
  height: 72rpx;
  padding: 0 18rpx;
  border: 1rpx solid #cdbcae;
  border-radius: 8rpx;
  background: #ffffff;
  color: #332824;
  font-size: 24rpx;
  box-sizing: border-box;
}

.revision-button {
  margin-top: 12rpx;
}

.draft-revision-status {
  margin-top: 14rpx;
  color: #795748;
  font-size: 23rpx;
  line-height: 36rpx;
}

.draft-suggestion {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #ddcfc3;
}

.draft-suggestion-content {
  margin-top: 8rpx;
  color: #332824;
  font-size: 27rpx;
  line-height: 44rpx;
  white-space: pre-wrap;
}

.node-row {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #d8d0c7;
}

.node-order {
  flex: 0 0 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e8ddd2;
  color: #694c3c;
  font-size: 23rpx;
  font-weight: 700;
}

.node-main {
  flex: 1 1 auto;
  min-width: 0;
}

.row-title,
.story-title,
.gap-title {
  min-width: 0;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 42rpx;
  overflow-wrap: anywhere;
}

.status-label {
  flex: 0 0 auto;
  padding: 5rpx 10rpx;
  border-radius: 8rpx;
  background: #eee8df;
  color: #645a54;
  font-size: 21rpx;
  line-height: 30rpx;
}

.row-copy,
.row-meta,
.story-summary,
.claim-statement,
.gap-description,
.resolution-note {
  display: block;
  margin-top: 8rpx;
  line-height: 42rpx;
  overflow-wrap: anywhere;
}

.row-copy,
.story-summary,
.gap-description {
  color: #5e5550;
  font-size: 26rpx;
}

.story-item,
.gap-item,
.followup-item {
  padding: 26rpx 0;
  border-bottom: 1rpx solid #d8d0c7;
}

.available-story-heading {
  margin-top: 44rpx;
}

.story-edit-state,
.available-story-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.story-edit-state {
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid #d8d0c7;
}

.story-edit-copy,
.available-story-main {
  flex: 1 1 auto;
  min-width: 0;
}

.story-edit-title,
.story-edit-hint,
.available-story-note,
.available-story-error {
  display: block;
  overflow-wrap: anywhere;
}

.story-edit-title {
  color: #443833;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.story-edit-hint,
.available-story-note {
  margin-top: 5rpx;
  color: #7a706a;
  font-size: 22rpx;
  line-height: 32rpx;
}

.available-story-error {
  margin-top: 7rpx;
  color: #a53e50;
  font-size: 22rpx;
  line-height: 32rpx;
}

.story-revision-button {
  flex: 0 0 auto;
}

.available-story-list {
  border-top: 1rpx solid #d8d0c7;
}

.available-story-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #d8d0c7;
}

.available-story-action {
  flex: 0 0 auto;
  min-width: 142rpx;
}

.followup-priority {
  color: #8b5b43;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.followup-question {
  display: block;
  overflow-wrap: anywhere;
}

.followup-question {
  margin-top: 14rpx;
  color: #2b211e;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 46rpx;
}

.followup-interview-button {
  min-width: 220rpx;
  min-height: 72rpx;
  margin: 20rpx 0 0;
  padding: 8rpx 24rpx;
  border: 0;
  border-radius: 10rpx;
  background: #a64b3e;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 36rpx;
  transition-property: transform, background-color, opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.followup-interview-button::after {
  border: 0;
}

.followup-interview-button[disabled] {
  opacity: 0.66;
}

.slot-grid {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx 22rpx;
}

.slot-row {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx dashed #ded7cf;
}

.slot-name,
.slot-status {
  font-size: 23rpx;
  line-height: 32rpx;
}

.slot-name {
  min-width: 0;
  overflow-wrap: anywhere;
}

.slot-status.missing {
  color: #b13f4f;
}

.slot-status.partial {
  color: #966313;
}

.slot-status.sufficient,
.slot-status.accepted {
  color: #39705a;
}

.claim-list {
  margin-top: 20rpx;
}

.claim-row {
  padding: 18rpx 20rpx;
  border-left: 5rpx solid #608273;
  background: #f1f5f2;
}

.claim-row + .claim-row {
  margin-top: 12rpx;
}

.claim-label {
  color: #315947;
  font-size: 23rpx;
  font-weight: 700;
}

.claim-statement {
  color: #332824;
  font-size: 26rpx;
}

.evidence-list {
  margin-top: 12rpx;
}

.evidence-quote {
  display: block;
  padding-top: 10rpx;
  border-top: 1rpx solid #d7e2dc;
  color: #5d625f;
  font-size: 24rpx;
  line-height: 38rpx;
}

.gap-section + .gap-section {
  margin-top: 42rpx;
}

.gap-item {
  padding-left: 18rpx;
  border-left: 5rpx solid #8b8179;
}

.gap-item.severity-high {
  border-left-color: #b5414f;
}

.gap-item.severity-medium {
  border-left-color: #b67a20;
}

.gap-severity {
  display: block;
  margin-top: 10rpx;
  color: #806f65;
  font-size: 22rpx;
  font-weight: 600;
}

.gap-note-input {
  width: 100%;
  height: 72rpx;
  margin-top: 18rpx;
  padding: 0 18rpx;
  border: 1rpx solid #cfc4ba;
  border-radius: 10rpx;
  background: #ffffff;
  color: #332824;
  font-size: 25rpx;
  box-sizing: border-box;
}

.gap-actions {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.gap-actions button {
  width: 100%;
  min-height: 64rpx;
  margin: 0;
  padding: 8rpx 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #c9b9ae;
  border-radius: 10rpx;
  background: #ffffff;
  color: #6e3b32;
  font-size: 23rpx;
  line-height: 32rpx;
  box-sizing: border-box;
}

.gap-actions button[disabled] {
  color: #aaa09a;
  background: #eeeae5;
}

.resolution-note {
  padding: 12rpx 16rpx;
  background: #edf5f0;
  color: #3d6554;
  font-size: 24rpx;
}

.empty-state,
.empty-row {
  padding: 34rpx 0;
  color: #7a706a;
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
}

@media (max-width: 360px) {
  .page-header {
    flex-wrap: wrap;
  }

  .audit-button {
    margin-left: 82rpx;
  }

  .slot-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .draft-toolbar,
  .draft-block-head {
    align-items: flex-start;
    flex-direction: column;
  }

  .draft-toolbar-actions {
    width: 100%;
  }

  .draft-toolbar-actions button {
    flex: 1 1 0;
  }
}
