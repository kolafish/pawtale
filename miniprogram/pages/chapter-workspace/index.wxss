.workspace-page {
  padding: 22rpx 30rpx 112rpx;
  color: var(--ui-text-primary);
}

.workspace-home-action {
  flex: 0 0 auto;
  min-height: 88rpx;
  margin: 0;
  padding: 0 8rpx 0 18rpx;
  border: 0;
  background: transparent;
  color: var(--ui-accent-strong);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.draft-heading,
.edit-actions {
  display: flex;
  align-items: center;
}

.section-kicker,
.status-title,
.status-detail,
.section-title,
.rewrite-notice-title,
.rewrite-notice-detail,
.section-structure-summary,
.section-name,
.section-meta,
.section-material-index,
.section-material-text,
.section-content-label,
.draft-content,
.empty-title,
.empty-detail,
.loading-state {
  display: block;
  overflow-wrap: anywhere;
}

.loading-state {
  padding: 160rpx 20rpx;
  color: var(--ui-text-secondary);
  font-size: 28rpx;
  line-height: 42rpx;
  text-align: center;
}

.status-card,
.content-card {
  margin-top: 26rpx;
  padding: 30rpx;
}

.status-card {
  background:
    linear-gradient(135deg, rgba(234, 241, 230, 0.94), rgba(255, 253, 250, 0.96));
}

.chapter-preparation-status {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: var(--ui-radius-inner);
  background: rgba(255, 253, 250, 0.72);
  box-shadow: inset 0 0 0 1rpx rgba(88, 112, 82, 0.1);
}

.section-kicker {
  color: var(--ui-section-title);
  font-family: var(--ui-font-editorial);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  line-height: 34rpx;
}

.status-title {
  margin-top: 10rpx;
  font-family: var(--ui-font-editorial);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 58rpx;
  text-wrap: balance;
}

.status-detail {
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: 27rpx;
  line-height: 44rpx;
  text-wrap: pretty;
}

.section-title {
  margin-top: 8rpx;
  font-family: var(--ui-font-editorial);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-wrap: balance;
}

.structure-heading {
  width: 100%;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 18rpx;
  transition-property: opacity;
  transition-duration: 120ms;
  transition-timing-function: ease-out;
}

.structure-heading:active {
  opacity: 0.72;
}

.structure-heading-meta {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 10rpx 16rpx;
}

.section-structure-summary {
  max-width: 100%;
  padding-top: 4rpx;
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  line-height: 34rpx;
  font-variant-numeric: tabular-nums;
}

.structure-expand-mark {
  flex: 0 0 auto;
  color: var(--ui-accent-strong);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.suggestion-count {
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  line-height: 34rpx;
  font-variant-numeric: tabular-nums;
}

.structure-tools {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
  box-shadow: inset 0 0 0 1rpx rgba(54, 42, 34, 0.05);
}

.structure-tools-detail {
  display: block;
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  line-height: 38rpx;
  text-wrap: pretty;
}

.section-regeneration-status {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.structure-regenerate-action,
.rewrite-action {
  width: 100%;
  min-height: 88rpx;
  margin-top: 18rpx;
  padding: 14rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.section-list {
  margin-top: 22rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.section-item {
  border-bottom: 1rpx solid var(--ui-divider);
}

.section-item.is-unassigned {
  margin: 18rpx 0;
  overflow: hidden;
  border-bottom: 0;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-warning-surface);
  box-shadow: inset 0 0 0 1rpx rgba(134, 98, 49, 0.1);
}

.section-item.is-unassigned .section-toggle {
  padding-right: 20rpx;
  padding-left: 20rpx;
}

.section-item.is-unassigned .section-index {
  color: var(--ui-warning-text);
  box-shadow: inset 0 0 0 1rpx rgba(134, 98, 49, 0.2);
}

.section-item.is-unassigned .section-material-list {
  margin-right: 20rpx;
  margin-left: 20rpx;
  border-left-color: rgba(134, 98, 49, 0.22);
}

.section-toggle,
.section-focus-heading {
  width: 100%;
  min-height: 104rpx;
  margin: 0;
  padding: 20rpx 2rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-radius: 0;
  background: transparent;
  color: var(--ui-text-primary);
  text-align: left;
}

.section-index {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--ui-accent-strong);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 32rpx;
  font-variant-numeric: tabular-nums;
}

.section-copy {
  min-width: 0;
  flex: 1 1 auto;
  text-align: left;
}

.section-name {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-wrap: balance;
}

.section-meta {
  margin-top: 4rpx;
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  line-height: 34rpx;
  font-variant-numeric: tabular-nums;
}

.section-expand-mark {
  flex: 0 0 auto;
  color: var(--ui-accent-strong);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.section-heading-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.section-rename-action {
  min-width: 80rpx;
  min-height: 88rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.section-material-list {
  margin: 0 0 24rpx 66rpx;
  padding: 0 0 0 24rpx;
  border-left: 2rpx solid var(--ui-accent-border);
}

.section-content-label {
  padding-top: 14rpx;
  color: var(--ui-section-title);
  font-family: var(--ui-font-editorial);
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 0.03em;
  line-height: 34rpx;
}

.section-material {
  padding: 16rpx 0;
}

.section-material + .section-material {
  border-top: 1rpx solid var(--ui-divider);
}

.section-material-open {
  width: 100%;
  min-height: 88rpx;
  padding: 4rpx 2rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.section-material-open-copy {
  min-width: 0;
  flex: 1 1 auto;
}

.section-material-open-action {
  flex: 0 0 auto;
  color: var(--ui-accent-strong);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.section-material-index {
  color: var(--ui-section-title);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 32rpx;
  font-variant-numeric: tabular-nums;
}

.section-material-text {
  margin-top: 6rpx;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 40rpx;
  white-space: pre-wrap;
  text-wrap: pretty;
}

.pending-section-hint {
  display: block;
  padding: 16rpx 0 4rpx;
  color: var(--ui-warning-text);
  font-size: 24rpx;
  line-height: 38rpx;
  text-wrap: pretty;
}

.material-assignment-action {
  width: 100%;
  min-height: 88rpx;
  margin-top: 14rpx;
  padding: 14rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface);
  color: var(--ui-warning-text);
  box-shadow: inset 0 0 0 1rpx rgba(134, 98, 49, 0.2);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.section-merge-action {
  min-height: 88rpx;
  margin: 14rpx 0 8rpx 66rpx;
  padding: 14rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
}

.section-merge-action-title {
  font-size: 25rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.section-merge-action-detail {
  min-width: 0;
  overflow: hidden;
  color: var(--ui-text-secondary);
  font-size: 22rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.primary-action,
.secondary-action {
  min-height: 88rpx;
  border-radius: var(--ui-radius-control);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.primary-action {
  width: 100%;
  margin: 26rpx 0 0;
  padding: 14rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-accent-strong);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
}

.is-disabled,
button[disabled] {
  pointer-events: none;
  opacity: 0.46;
}

.is-disabled:active,
button[disabled]:active {
  transform: none;
}

.draft-editor {
  width: 100%;
  min-height: 150rpx;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border: 0;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
  color: var(--ui-text-primary);
  box-shadow: inset 0 0 0 1rpx var(--ui-border);
  font-size: 28rpx;
  line-height: 48rpx;
}

.draft-heading {
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.draft-heading > view:first-child {
  min-width: 0;
  flex: 1 1 auto;
}

.draft-heading-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
}

.chapter-read-action {
  min-height: 88rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-accent-strong);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.rewrite-notice {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
  box-shadow: inset 0 0 0 1rpx rgba(54, 42, 34, 0.05);
}

.rewrite-notice-title {
  color: var(--ui-section-title);
  font-family: var(--ui-font-editorial);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-wrap: balance;
  font-variant-numeric: tabular-nums;
}

.rewrite-notice-detail {
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 40rpx;
  text-wrap: pretty;
}

.rewrite-task-status,
.draft-recovery-task-status {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.confirmed-badge {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--ui-success-surface);
  color: var(--ui-success-text);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.draft-section-actions {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.draft-section-action {
  min-width: 112rpx;
  min-height: 88rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface);
  color: var(--ui-text-secondary);
  box-shadow: inset 0 0 0 1rpx var(--ui-border);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.draft-section-action.regenerate {
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-accent-strong);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
}

.draft-section-body {
  margin-top: 20rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.draft-section-body .draft-editor {
  margin-top: 0;
}

.draft-content {
  margin-top: 10rpx;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 30rpx;
  line-height: 56rpx;
  white-space: pre-wrap;
  text-wrap: pretty;
}

.draft-section-missing .empty-detail {
  margin-top: 8rpx;
  text-align: left;
}

.edit-actions {
  margin-top: 18rpx;
  justify-content: flex-end;
  gap: 14rpx;
}

.secondary-action {
  min-width: 144rpx;
  margin: 0;
  padding: 12rpx 20rpx;
  border: 0;
  background: var(--ui-surface);
  color: var(--ui-text-secondary);
  box-shadow: inset 0 0 0 1rpx var(--ui-border);
}

.secondary-action.strong {
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-accent-strong);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
}

.draft-empty {
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
  box-shadow: inset 0 0 0 1rpx rgba(54, 42, 34, 0.05);
  text-align: center;
}

.empty-title {
  font-family: var(--ui-font-editorial);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.empty-detail {
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 40rpx;
  text-wrap: pretty;
}

.draft-recovery-action {
  margin-top: 24rpx;
}

.confirm-chapter-action {
  margin-top: 30rpx;
}

.chapter-finished {
  margin-top: 30rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.chapter-finished-title,
.chapter-finished-detail {
  display: block;
}

.chapter-finished-title {
  color: var(--ui-success-text);
  font-family: var(--ui-font-editorial);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.chapter-finished-detail {
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.message {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--ui-radius-inner);
  font-size: 25rpx;
  line-height: 40rpx;
}

.error-message {
  background: var(--ui-accent-surface);
  color: var(--ui-danger-text);
}

.candidate-content {
  display: block;
  margin: 22rpx 0;
  padding: 22rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 29rpx;
  line-height: 54rpx;
  white-space: pre-wrap;
}
