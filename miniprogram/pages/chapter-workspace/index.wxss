.workspace-page {
  padding: 24rpx 30rpx 112rpx;
  color: var(--ui-text-primary);
}

.workspace-home-action {
  flex: 0 0 auto;
  min-height: 44px;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 999rpx;
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 44px;
  box-shadow: 0 0 0 1rpx rgba(143, 64, 55, 0.16);
}

.workspace-home-action::after {
  border: 0;
}

.draft-heading,
.edit-actions {
  display: flex;
  align-items: center;
}

.section-kicker,
.status-title,
.status-detail,
.section-title,
.section-detail,
.rewrite-notice-title,
.rewrite-notice-detail,
.section-structure-summary,
.section-name,
.section-meta,
.section-material-index,
.section-material-text,
.section-content-label,
.draft-content,
.empty-title,
.empty-detail,
.loading-state {
  display: block;
  overflow-wrap: anywhere;
}

.loading-state {
  padding: 160rpx 20rpx;
  color: var(--ui-text-secondary);
  font-size: 28rpx;
  line-height: 42rpx;
  text-align: center;
}

.status-card,
.content-card {
  margin-top: 30rpx;
  padding: 34rpx 30rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 24rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow);
}

.status-card {
  border-left: 6rpx solid var(--ui-accent);
}

.chapter-preparation-status {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: var(--ui-surface-subtle);
}

.chapter-finished {
  margin-top: 30rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.chapter-finished-title,
.chapter-finished-detail {
  display: block;
}

.chapter-finished-title {
  color: var(--ui-success-text);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.chapter-finished-detail {
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.section-kicker {
  color: var(--ui-warning-text);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.status-title {
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 58rpx;
  text-wrap: balance;
}

.status-detail,
.section-detail {
  margin-top: 14rpx;
  color: var(--ui-text-secondary);
  font-size: 27rpx;
  line-height: 44rpx;
  text-wrap: pretty;
}

.section-title {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-wrap: balance;
}

.structure-heading {
  width: 100%;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20rpx;
  transition-property: opacity;
  transition-duration: 120ms;
  transition-timing-function: ease-out;
}

.structure-heading:active {
  opacity: 0.72;
}

.structure-heading-meta {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 12rpx 18rpx;
}

.section-structure-summary {
  flex: 0 0 auto;
  max-width: 100%;
  padding-top: 4rpx;
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  line-height: 34rpx;
  font-variant-numeric: tabular-nums;
}

.structure-expand-mark {
  flex: 0 0 auto;
  color: var(--ui-accent-strong);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.suggestion-count {
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  line-height: 34rpx;
  font-variant-numeric: tabular-nums;
}

.structure-tools {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: var(--ui-surface-subtle);
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.05),
    0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.structure-tools-detail {
  display: block;
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  line-height: 38rpx;
  text-wrap: pretty;
}

.section-regeneration-status {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.structure-regenerate-action {
  width: 100%;
  min-height: 88rpx;
  margin: 18rpx 0 0;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  box-shadow: 0 0 0 1rpx rgba(143, 64, 55, 0.16);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 40rpx;
  transition-property: transform, opacity, box-shadow;
  transition-duration: 120ms;
  transition-timing-function: ease-out;
}

.structure-regenerate-action::after {
  border: 0;
}

.structure-regenerate-action:active {
  transform: scale(0.96);
}

.section-list {
  margin-top: 24rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.section-item {
  border-bottom: 1rpx solid var(--ui-divider);
}

.section-item.is-unassigned {
  margin: 20rpx 0;
  overflow: hidden;
  border-bottom: 0;
  border-radius: 32rpx;
  background: var(--ui-warning-surface);
  box-shadow:
    0 0 0 1rpx rgba(160, 108, 37, 0.12),
    0 4rpx 12rpx rgba(116, 78, 28, 0.06);
}

.section-item.is-unassigned .section-toggle {
  padding-right: 20rpx;
  padding-left: 20rpx;
}

.section-item.is-unassigned .section-index {
  background: var(--ui-warning-surface);
  color: var(--ui-warning-text);
}

.section-item.is-unassigned .section-material-list {
  margin-right: 20rpx;
  margin-left: 20rpx;
  background: var(--ui-surface);
}

.section-toggle {
  width: 100%;
  min-height: 104rpx;
  margin: 0;
  padding: 20rpx 2rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 18rpx;
  box-sizing: border-box;
  border-radius: 0;
  background: transparent;
  color: var(--ui-text-primary);
  text-align: left;
  transition-property: opacity, transform;
  transition-duration: 120ms;
  transition-timing-function: ease-out;
}

.section-toggle::after {
  border: 0;
}

.section-toggle:active {
  opacity: 0.72;
  transform: scale(0.96);
}

.section-index {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--ui-accent-surface);
  color: var(--ui-accent-strong);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 32rpx;
  font-variant-numeric: tabular-nums;
}

.section-copy {
  min-width: 0;
  flex: 1 1 auto;
  text-align: left;
}

.section-name {
  color: var(--ui-text-primary);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-wrap: balance;
}

.section-meta {
  margin-top: 4rpx;
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  line-height: 34rpx;
  font-variant-numeric: tabular-nums;
}

.section-expand-mark {
  flex: 0 0 auto;
  color: var(--ui-accent-strong);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.section-material-list {
  margin: 0 0 22rpx 66rpx;
  padding: 4rpx 22rpx;
  border-radius: 12rpx;
  background: var(--ui-surface-subtle);
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.05),
    0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.section-content-label {
  padding-top: 14rpx;
  color: var(--ui-section-title);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.section-merge-action {
  min-height: 88rpx;
  margin: 14rpx 0 8rpx;
  padding: 14rpx 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-radius: 12rpx;
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  box-shadow: 0 0 0 1rpx rgba(143, 64, 55, 0.14);
  transition-property: transform, opacity, box-shadow;
  transition-duration: 120ms;
  transition-timing-function: ease-out;
}

.section-merge-action:active {
  transform: scale(0.96);
}

.section-merge-action-title {
  font-size: 25rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.section-merge-action-detail {
  min-width: 0;
  overflow: hidden;
  color: var(--ui-text-secondary);
  font-size: 22rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-material {
  padding: 18rpx 0;
}

.section-material-open {
  width: 100%;
  min-height: 88rpx;
  padding: 4rpx 2rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-radius: 12rpx;
  transition-property: transform, opacity;
  transition-duration: 120ms;
  transition-timing-function: ease-out;
}

.section-material-open:active {
  transform: scale(0.96);
  opacity: 0.72;
}

.section-material-open-copy {
  min-width: 0;
  flex: 1 1 auto;
}

.section-material-open-action {
  flex: 0 0 auto;
  color: var(--ui-accent-strong);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.section-material + .section-material {
  border-top: 1rpx solid var(--ui-divider);
}

.section-material-index {
  color: var(--ui-section-title);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 32rpx;
  font-variant-numeric: tabular-nums;
}

.section-material-text {
  margin-top: 6rpx;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 40rpx;
  white-space: pre-wrap;
  text-wrap: pretty;
}

.pending-section-hint {
  display: block;
  padding: 18rpx 0 4rpx;
  color: var(--ui-warning-text);
  font-size: 24rpx;
  line-height: 38rpx;
  text-wrap: pretty;
}

.material-assignment-action {
  width: 100%;
  min-height: 88rpx;
  margin-top: 16rpx;
  padding: 16rpx 22rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: var(--ui-warning-surface);
  color: var(--ui-warning-text);
  box-shadow: 0 0 0 1rpx rgba(128, 82, 37, 0.16);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 40rpx;
  transition-property: transform, opacity, box-shadow;
  transition-duration: 120ms;
  transition-timing-function: ease-out;
}

.material-assignment-action:active {
  transform: scale(0.96);
}

.primary-action,
.secondary-action {
  min-height: 88rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  transition-property: transform, opacity, background-color;
  transition-duration: 120ms;
  transition-timing-function: ease-out;
}

.primary-action {
  width: 100%;
  margin: 28rpx 0 0;
  padding: 16rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ui-accent);
  color: var(--ui-on-accent);
  line-height: 40rpx;
}

.is-disabled {
  pointer-events: none;
  opacity: 0.46;
}

.primary-action:active,
.secondary-action:active {
  transform: scale(0.96);
}

.primary-action::after,
.secondary-action::after {
  border: 0;
}

button[disabled] {
  opacity: 0.46;
}

.draft-editor {
  width: 100%;
  min-height: 150rpx;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--ui-border);
  border-radius: 12rpx;
  background: var(--ui-surface);
  color: var(--ui-text-primary);
  font-size: 28rpx;
  line-height: 44rpx;
}

.draft-heading {
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.draft-heading > view:first-child {
  min-width: 0;
  flex: 1 1 auto;
}

.draft-heading-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
}

.chapter-read-action {
  min-height: 80rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: var(--ui-accent-surface);
  color: var(--ui-accent-strong);
  box-shadow: 0 0 0 1rpx rgba(143, 64, 55, 0.12);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
  transition-property: transform, opacity, background-color;
  transition-duration: 140ms;
  transition-timing-function: ease-out;
}

.chapter-read-action:active {
  transform: scale(0.96);
}

.chapter-read-action.is-disabled:active {
  transform: none;
}

.rewrite-notice {
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: var(--ui-surface-subtle);
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.06),
    0 2rpx 4rpx -2rpx rgba(0, 0, 0, 0.08),
    0 6rpx 16rpx rgba(0, 0, 0, 0.05);
}

.rewrite-notice-title {
  color: var(--ui-section-title);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-wrap: balance;
  font-variant-numeric: tabular-nums;
}

.rewrite-notice-detail {
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 40rpx;
  text-wrap: pretty;
}

.rewrite-task-status,
.draft-recovery-task-status {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.rewrite-action {
  width: 100%;
  min-height: 88rpx;
  margin: 22rpx 0 0;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  box-shadow: 0 0 0 1rpx rgba(143, 64, 55, 0.16);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
  transition-property: transform, opacity, box-shadow;
  transition-duration: 120ms;
  transition-timing-function: ease-out;
}

.rewrite-action::after {
  border: 0;
}

.rewrite-action:active {
  transform: scale(0.96);
}

.confirmed-badge {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--ui-success-surface);
  color: var(--ui-success-text);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.draft-section-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.draft-section-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 116rpx;
  min-height: 40px;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: var(--ui-surface-subtle);
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 36rpx;
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.05);
  transition-property: transform, opacity, background-color;
  transition-duration: 160ms;
  transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
}

.draft-section-action.regenerate {
  background: var(--ui-accent-surface);
  color: var(--ui-accent-strong);
}

.draft-section-action:active {
  transform: scale(0.96);
}

.draft-section-action.is-disabled {
  opacity: 0.48;
}

.draft-section-action.is-disabled:active {
  transform: none;
}

.draft-section-body {
  margin-top: 20rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.draft-section-body .draft-editor {
  margin-top: 0;
}

.draft-ai-editor-title,
.draft-ai-editor-hint {
  display: block;
}

.draft-ai-editor-title {
  color: var(--ui-text-primary);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-wrap: balance;
}

.draft-ai-editor-hint {
  margin-top: 8rpx;
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  line-height: 38rpx;
  text-wrap: pretty;
}

.draft-ai-editor voice-text-editor {
  display: block;
  margin-top: 20rpx;
}

.draft-content {
  margin-top: 10rpx;
  color: var(--ui-text-primary);
  font-size: 29rpx;
  line-height: 52rpx;
  white-space: pre-wrap;
  text-wrap: pretty;
}

.draft-section-missing .empty-detail {
  margin-top: 8rpx;
  text-align: left;
}

.edit-actions {
  margin-top: 18rpx;
  justify-content: flex-end;
  gap: 16rpx;
}

.secondary-action {
  min-width: 150rpx;
  margin: 0;
  padding: 14rpx 22rpx;
  background: var(--ui-surface-subtle);
  color: var(--ui-text-secondary);
  line-height: 40rpx;
}

.secondary-action.strong {
  background: var(--ui-accent);
  color: var(--ui-on-accent);
}

.draft-empty {
  margin-top: 26rpx;
  padding: 30rpx 26rpx;
  border-radius: 18rpx;
  background: var(--ui-surface-subtle);
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.05),
    0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.empty-detail {
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 40rpx;
  text-wrap: pretty;
}

.draft-recovery-action {
  margin-top: 24rpx;
}

.confirm-chapter-action {
  margin-top: 32rpx;
}

.message {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  line-height: 40rpx;
}

.error-message {
  background: var(--ui-accent-surface);
  color: var(--ui-danger-text);
}
