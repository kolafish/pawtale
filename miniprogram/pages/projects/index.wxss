.projects-page {
  min-height: 100vh;
  padding: 28rpx 36rpx 120rpx;
  background: #fcf7ed;
}

.error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff1f3;
  color: #b84a5a;
  font-size: 28rpx;
  line-height: 1.45;
}

.action-bar {
  margin-bottom: 28rpx;
}

.primary-button,
.ghost-button,
.more-button {
  border: 0;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  line-height: 1;
}

.primary-button::after,
.ghost-button::after,
.more-button::after {
  border: 0;
}

.primary-button {
  width: 100%;
  height: 96rpx;
  background: #a64b3e;
  color: #ffffff;
  font-size: 32rpx;
}

.project-card,
.empty-panel {
  margin-top: 24rpx;
  padding: 30rpx;
  border: 2rpx solid #e8d8c3;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 10rpx 28rpx rgba(64, 43, 24, 0.06);
}

.project-card.active {
  border-color: #a64b3e;
  background: #fff9f3;
}

.project-card {
  transition-property: transform, background-color, border-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.project-card-hover {
  transform: scale(0.98);
  border-color: #d8c0a6;
  background: #fff9f3;
}

.project-main {
  min-width: 0;
}

.project-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.project-title {
  flex: 1;
  min-width: 0;
  color: #2b1713;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
}

.active-badge {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff3ef;
  color: #a64b3e;
  font-size: 22rpx;
  font-weight: 700;
}

.project-meta {
  display: block;
  margin-top: 12rpx;
  color: #7b6f68;
  font-size: 26rpx;
  line-height: 1.35;
}

.project-hint {
  display: block;
  margin-top: 14rpx;
  color: #a64b3e;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

.project-actions {
  display: flex;
  justify-content: flex-end;
  gap: 18rpx;
  margin-top: 26rpx;
}

.ghost-button,
.more-button {
  min-width: 176rpx;
  height: 88rpx;
  margin: 0;
  font-size: 28rpx;
}

.ghost-button {
  background: #fff9f3;
  color: #a64b3e;
}

.more-button {
  background: #f5eee7;
  color: #5c4b43;
}

.project-action-hover {
  transform: scale(0.96);
  opacity: 0.86;
}

.empty-panel {
  color: #7b6f68;
  font-size: 30rpx;
  text-align: center;
}

.bottom-spacer {
  height: 40rpx;
}
