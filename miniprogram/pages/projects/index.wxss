@import "../../styles/support-forms.wxss";

.projects-page {
  padding: 28rpx 36rpx 120rpx;
}

.error {
  margin-bottom: 24rpx;
}

.action-bar {
  margin-bottom: 28rpx;
}

.primary-button,
.ghost-button,
.more-button {
  font-weight: 700;
}

.primary-button {
  width: 100%;
  min-height: 88rpx;
  gap: 10rpx;
  border-radius: var(--ui-radius-control);
  background: transparent;
  color: var(--ui-accent-strong);
  font-size: 29rpx;
  box-shadow: inset 0 0 0 2rpx var(--ui-accent-border);
}

.create-mark {
  font-size: 38rpx;
  font-weight: 500;
  line-height: 1;
  transform: translateY(-1rpx);
}

.project-card,
.empty-panel {
  margin-top: 20rpx;
  padding: 28rpx;
}

.project-card.active {
  background: var(--ui-success-surface);
  box-shadow: none;
}

.project-card-hover {
  transform: scale(0.96);
  background: var(--ui-accent-surface-subtle);
  box-shadow: var(--ui-card-shadow-raised);
}

.project-main,
.project-title {
  min-width: 0;
}

.project-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.project-title {
  flex: 1;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
  text-wrap: balance;
}

.active-badge {
  flex: 0 0 auto;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 250, 0.72);
  color: var(--ui-success-text);
  font-size: 22rpx;
  font-weight: 700;
}

.project-meta,
.project-hint {
  display: block;
  line-height: 1.4;
  text-wrap: pretty;
}

.project-meta {
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
}

.project-hint {
  margin-top: 12rpx;
  color: var(--ui-accent);
  font-size: 23rpx;
  font-weight: 600;
}

.project-card.active .project-hint {
  color: var(--ui-success-text);
}

.project-actions {
  margin-top: 22rpx;
  padding-top: 4rpx;
  border-top: 1rpx solid var(--ui-divider);
  display: flex;
  justify-content: flex-end;
  gap: 4rpx;
}

.ghost-button,
.more-button {
  min-width: 144rpx;
  min-height: 88rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: transparent;
  font-size: 26rpx;
}

.ghost-button {
  color: var(--ui-accent-strong);
}

.more-button {
  color: var(--ui-text-secondary);
}

.project-action-hover {
  transform: scale(0.96);
  background: rgba(255, 253, 250, 0.58);
}

.empty-panel {
  color: var(--ui-text-secondary);
  font-size: 29rpx;
  text-align: center;
}

.bottom-spacer {
  height: 40rpx;
}
