.projects-page {
  min-height: 100vh;
  padding: 44rpx 36rpx 120rpx;
  background: #fffaf2;
}

.top-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 28rpx;
}

.back-hit {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-mark {
  color: #9f4a3c;
  font-size: 72rpx;
  line-height: 1;
}

.page-title {
  color: #24100b;
  font-size: 44rpx;
  font-weight: 800;
}

.error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff1f2;
  color: #b4234a;
  font-size: 28rpx;
  line-height: 1.45;
}

.action-bar {
  margin-bottom: 28rpx;
}

.primary-button,
.small-primary,
.ghost-button {
  border: 0;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  line-height: 1;
}

.primary-button::after,
.small-primary::after,
.ghost-button::after {
  border: 0;
}

.primary-button {
  width: 100%;
  height: 96rpx;
  background: #9f4a3c;
  color: #ffffff;
  font-size: 32rpx;
}

.project-card,
.empty-panel {
  margin-top: 24rpx;
  padding: 30rpx;
  border: 2rpx solid #f0dac0;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 10rpx 28rpx rgba(64, 43, 24, 0.06);
}

.project-card.active {
  border-color: #9f4a3c;
  background: #fff6f1;
}

.project-main {
  min-width: 0;
}

.project-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.project-title {
  flex: 1;
  min-width: 0;
  color: #24100b;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
}

.active-badge {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff1ec;
  color: #9f4a3c;
  font-size: 22rpx;
  font-weight: 700;
}

.project-meta {
  display: block;
  margin-top: 12rpx;
  color: #685b55;
  font-size: 26rpx;
  line-height: 1.35;
}

.project-actions,
.rename-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 26rpx;
}

.ghost-button,
.small-primary {
  height: 78rpx;
  font-size: 28rpx;
}

.ghost-button {
  background: #fff6f1;
  color: #9f4a3c;
}

.small-primary {
  background: #9f4a3c;
  color: #ffffff;
}

.small-primary.disabled {
  background: #f0dac0;
  color: #6d817d;
}

.rename-box {
  margin-top: 24rpx;
}

.rename-input {
  height: 88rpx;
  padding: 0 22rpx;
  border: 2rpx solid #f2cbbb;
  border-radius: 18rpx;
  background: #ffffff;
  color: #24100b;
  font-size: 30rpx;
}

.empty-panel {
  color: #685b55;
  font-size: 30rpx;
  text-align: center;
}

.bottom-spacer {
  height: 40rpx;
}
