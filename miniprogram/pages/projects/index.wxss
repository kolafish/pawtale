.projects-page {
  padding: 28rpx 36rpx 120rpx;
}

.error {
  margin-bottom: 24rpx;
}

.action-bar {
  margin-bottom: 28rpx;
}

.primary-button,
.ghost-button,
.more-button {
  border: 0;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  line-height: 1;
}

.primary-button::after,
.ghost-button::after,
.more-button::after {
  border: 0;
}

.primary-button {
  width: 100%;
  height: 96rpx;
  background: var(--ui-accent);
  color: var(--ui-on-accent);
  font-size: 32rpx;
}

.project-card,
.empty-panel {
  margin-top: 24rpx;
  padding: 30rpx;
  border: 2rpx solid var(--ui-border);
  border-radius: 28rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow);
}

.project-card.active {
  border-color: var(--ui-accent);
  background: var(--ui-accent-surface-subtle);
}

.project-card {
  transition-property: transform, background-color, border-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.project-card-hover {
  transform: scale(0.98);
  border-color: var(--ui-accent-border);
  background: var(--ui-accent-surface-subtle);
}

.project-main {
  min-width: 0;
}

.project-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.project-title {
  flex: 1;
  min-width: 0;
  color: var(--ui-text-primary);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
}

.active-badge {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--ui-accent-surface);
  color: var(--ui-accent);
  font-size: 22rpx;
  font-weight: 700;
}

.project-meta {
  display: block;
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  line-height: 1.35;
}

.project-hint {
  display: block;
  margin-top: 14rpx;
  color: var(--ui-accent);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

.project-actions {
  display: flex;
  justify-content: flex-end;
  gap: 18rpx;
  margin-top: 26rpx;
}

.ghost-button,
.more-button {
  min-width: 176rpx;
  height: 88rpx;
  margin: 0;
  font-size: 28rpx;
}

.ghost-button {
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-accent);
}

.more-button {
  background: var(--ui-surface-subtle);
  color: var(--ui-value-text);
}

.project-action-hover {
  transform: scale(0.96);
  opacity: 0.86;
}

.empty-panel {
  color: var(--ui-text-secondary);
  font-size: 30rpx;
  text-align: center;
}

.bottom-spacer {
  height: 40rpx;
}
