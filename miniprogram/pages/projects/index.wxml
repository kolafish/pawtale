<view class="ui-page-shell {{pageClass}}">
  <view wx:if="{{error}}" class="error ui-error-banner">{{error}}</view>

  <view class="action-bar">
    <view
      id="create-project-action"
      class="primary-button support-action ui-block-action ui-pressable {{busy ? 'is-disabled' : ''}}"
      aria-role="button"
      aria-disabled="{{busy}}"
      bindtap="createProject"
    >
      <text class="create-mark" aria-hidden="true">＋</text>
      <text>{{busy ? "处理中" : "新建回忆录"}}</text>
    </view>
  </view>

  <view wx:if="{{loading && !projects.length}}" class="empty-panel ui-card">
    <text>正在加载</text>
  </view>

  <view wx:elif="{{!projects.length}}" class="empty-panel ui-card">
    <text>暂无回忆录</text>
  </view>

  <view
    wx:for="{{projects}}"
    wx:key="id"
    class="project-card ui-card {{item.active ? 'active' : 'ui-pressable'}}"
    data-id="{{item.id}}"
    bindtap="activateProject"
    hover-class="{{item.active ? 'none' : 'project-card-hover'}}"
    aria-role="button"
    aria-disabled="{{busy}}"
    aria-label="{{item.active ? ('当前回忆录，' + item.title) : ('切换到回忆录，' + item.title)}}"
  >
    <view class="project-main">
      <view class="project-title-row">
        <text class="project-title">{{item.title}}</text>
        <text wx:if="{{item.active}}" class="active-badge">当前</text>
      </view>
      <text class="project-meta">{{item.profileSummary || "资料未填写"}} · {{item.wordCountText}} · {{item.updatedText || "刚刚"}}</text>
      <text class="project-hint">{{item.active ? "当前正在使用" : "点击卡片切换为当前回忆录"}}</text>
    </view>

    <view class="project-actions">
      <button
        class="ghost-button support-action ui-pressable"
        data-id="{{item.id}}"
        catchtap="openProjectEdit"
        hover-class="project-action-hover"
      >
        编辑设置
      </button>
      <button
        wx:if="{{item.canDelete}}"
        class="more-button support-action ui-pressable"
        data-id="{{item.id}}"
        disabled="{{busy}}"
        catchtap="openProjectMore"
        hover-class="project-action-hover"
      >
        {{deletingId === item.id ? "处理中" : "更多"}}
      </button>
    </view>
  </view>

  <view class="bottom-spacer"></view>
</view>
