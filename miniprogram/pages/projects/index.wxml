<view class="projects-page">
  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="action-bar">
    <button class="primary-button" bindtap="createProject" loading="{{busy}}">
      {{busy ? "处理中" : "新建回忆录"}}
    </button>
  </view>

  <view wx:if="{{loading && !projects.length}}" class="empty-panel">
    <text>正在加载</text>
  </view>

  <view wx:elif="{{!projects.length}}" class="empty-panel">
    <text>暂无回忆录</text>
  </view>

  <view wx:for="{{projects}}" wx:key="id" class="project-card {{item.active ? 'active' : ''}}">
    <view class="project-main">
      <view class="project-title-row">
        <text class="project-title">{{item.title}}</text>
        <text wx:if="{{item.active}}" class="active-badge">当前</text>
      </view>
      <text class="project-meta">{{item.profileSummary || "资料未填写"}} · {{item.wordCountText}} · {{item.updatedText || "刚刚"}}</text>
    </view>

    <view class="project-actions">
      <button class="ghost-button" data-id="{{item.id}}" bindtap="openProjectEdit">编辑</button>
      <button
        class="small-primary {{item.active ? 'disabled' : ''}}"
        data-id="{{item.id}}"
        bindtap="activateProject"
      >
        {{item.active ? "使用中" : "切换"}}
      </button>
      <button
        class="danger-button {{item.canDelete ? '' : 'disabled'}}"
        data-id="{{item.id}}"
        disabled="{{!item.canDelete || busy}}"
        bindtap="deleteProject"
      >
        {{deletingId === item.id ? "删除中" : "删除"}}
      </button>
    </view>
  </view>

  <view class="bottom-spacer"></view>
</view>
