.progress-page {
  padding: 28rpx 34rpx 88rpx;
}

.refresh-button,
.continue-button {
  margin: 0;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

.refresh-button::after,
.continue-button::after {
  border: 0;
}

.refresh-button {
  width: 128rpx;
  height: var(--ui-hit-size);
  border-radius: 18rpx;
  background: var(--ui-surface);
  color: var(--ui-accent);
  font-size: 25rpx;
  box-shadow: var(--ui-card-shadow);
}

.summary-grid {
  margin-top: 34rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.summary-item,
.section,
.session-card {
  border: 2rpx solid var(--ui-border);
  border-radius: 24rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow-raised);
}

.summary-item {
  min-height: 152rpx;
  padding: 28rpx;
}

.summary-value {
  display: block;
  color: var(--ui-text-primary);
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1;
}

.summary-label {
  display: block;
  margin-top: 18rpx;
  color: var(--ui-text-secondary);
  font-size: 26rpx;
}

.section {
  margin-top: 28rpx;
  padding: 28rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--ui-text-primary);
  font-size: 32rpx;
  font-weight: 800;
}

.section-meta {
  color: var(--ui-value-text);
  font-size: 26rpx;
}

.module-row {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: var(--ui-accent-surface-subtle);
}

.module-title {
  display: block;
  color: var(--ui-section-title);
  font-size: 30rpx;
  font-weight: 800;
}

.module-meta,
.session-meta,
.last-message,
.empty-state {
  display: block;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 1.45;
}

.module-meta {
  margin-top: 10rpx;
}

.session-card {
  margin-top: 22rpx;
  padding: 24rpx;
  box-shadow: none;
}

.session-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.session-title {
  display: block;
  color: var(--ui-text-primary);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.session-meta {
  margin-top: 8rpx;
}

.continue-button {
  width: 120rpx;
  height: 80rpx;
  border-radius: 18rpx;
  background: var(--ui-accent-surface);
  color: var(--ui-accent);
  font-size: 25rpx;
  flex: 0 0 auto;
}

.continue-button[disabled] {
  opacity: 0.45;
}

.session-stats {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.session-stats text {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-value-text);
  font-size: 24rpx;
  font-weight: 800;
}

.last-message {
  margin-top: 18rpx;
}

.empty-state {
  margin-top: 22rpx;
}

.error {
  margin-top: 24rpx;
  font-size: 26rpx;
}
