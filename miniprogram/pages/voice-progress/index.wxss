.overview-page {
  padding: 28rpx 30rpx 96rpx;
  color: var(--ui-text-primary);
  -webkit-font-smoothing: antialiased;
}

.refresh-button {
  width: 128rpx;
  height: var(--ui-hit-size);
  border-radius: 18rpx;
  background: var(--ui-surface);
  color: var(--ui-accent);
  font-size: 25rpx;
  font-weight: 800;
  box-shadow: var(--ui-card-shadow);
}

.summary-grid {
  margin-top: 32rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.summary-item,
.section,
.session-card {
  border: 2rpx solid var(--ui-border);
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow-raised);
}

.summary-item {
  min-height: 152rpx;
  padding: 28rpx;
  border-radius: 24rpx;
}

.summary-value {
  display: block;
  color: var(--ui-text-primary);
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1;
}

.summary-label {
  display: block;
  margin-top: 18rpx;
  color: var(--ui-text-secondary);
  font-size: 26rpx;
}

.section {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 28rpx;
}

.section-header,
.topic-heading,
.session-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.section-kicker,
.section-title,
.topic-detail,
.map-note-title,
.map-note-text,
.module-title,
.topic-title,
.topic-intent,
.state-detail {
  display: block;
  overflow-wrap: anywhere;
}

.section-kicker {
  color: var(--ui-accent);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.section-title {
  color: var(--ui-text-primary);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.topic-headline {
  margin-top: 10rpx;
  font-size: 40rpx;
  line-height: 54rpx;
  text-wrap: balance;
}

.topic-detail {
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: 28rpx;
  line-height: 42rpx;
  text-wrap: pretty;
}

.section-meta {
  color: var(--ui-value-text);
  font-size: 26rpx;
  line-height: 44rpx;
}

.map-note {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: var(--ui-accent-surface-subtle);
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.05);
}

.map-note-title {
  color: var(--ui-accent-strong);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.map-note-text {
  margin-top: 8rpx;
  color: var(--ui-value-text);
  font-size: 26rpx;
  line-height: 40rpx;
  text-wrap: pretty;
}

.module-list,
.topic-list {
  display: flex;
  flex-direction: column;
}

.module-list {
  gap: 32rpx;
  margin-top: 32rpx;
}

.module-title {
  color: var(--ui-text-secondary);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.topic-list {
  gap: 18rpx;
  margin-top: 14rpx;
}

.topic-item {
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--ui-page-background);
  box-shadow: 0 0 0 1rpx var(--ui-border);
}

.topic-title {
  min-width: 0;
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 46rpx;
  text-wrap: balance;
}

.state-chip {
  flex: 0 0 auto;
  max-width: 220rpx;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: var(--ui-surface-subtle);
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
}

.topic-item.already_shared .state-chip {
  background: var(--ui-success-surface);
  color: var(--ui-success-text);
}

.topic-item.enough_for_now .state-chip {
  background: #edf1f5;
  color: #53677a;
}

.topic-item.not_applicable .state-chip,
.topic-item.do_not_discuss .state-chip {
  background: #f2edeb;
  color: var(--ui-text-secondary);
}

.topic-intent {
  margin-top: 14rpx;
  color: var(--ui-text-primary);
  font-size: 27rpx;
  line-height: 42rpx;
  text-wrap: pretty;
}

.state-detail {
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 38rpx;
  text-wrap: pretty;
}

.topic-start-action,
.topic-choice-action {
  width: 100%;
  min-height: 88rpx;
  margin-top: 20rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 40rpx;
  transition-property: transform, background-color, box-shadow, opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.topic-start-action {
  background: var(--ui-accent);
  color: var(--ui-on-accent);
  box-shadow: 0 7rpx 16rpx rgba(143, 64, 55, 0.16);
}

.topic-choice-action {
  margin-top: 14rpx;
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-accent-strong);
  box-shadow: 0 0 0 1rpx rgba(168, 79, 67, 0.14);
}

.topic-start-action-hover,
.topic-choice-action-hover {
  transform: scale(0.96);
}

.topic-start-action-hover {
  background: var(--ui-accent-strong);
  box-shadow: 0 4rpx 10rpx rgba(143, 64, 55, 0.12);
}

.topic-choice-action-hover {
  background: var(--ui-accent-surface);
}

.session-card {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  box-shadow: none;
}

.session-copy {
  min-width: 0;
  flex: 1;
}

.session-title {
  display: block;
  color: var(--ui-text-primary);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.session-meta,
.last-message,
.empty-state {
  display: block;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 1.45;
}

.session-meta {
  margin-top: 8rpx;
}

.continue-button {
  width: 120rpx;
  height: 80rpx;
  border-radius: 18rpx;
  background: var(--ui-accent-surface);
  color: var(--ui-accent);
  font-size: 25rpx;
  font-weight: 800;
  flex: 0 0 auto;
}

.session-stats {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.session-stats text {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-value-text);
  font-size: 24rpx;
  font-weight: 800;
}

.last-message,
.empty-state {
  margin-top: 18rpx;
}

.empty-state text {
  display: block;
}

.error {
  margin-top: 24rpx;
  font-size: 26rpx;
}

.large-text .topic-headline {
  font-size: 48rpx;
  line-height: 64rpx;
}

.large-text .topic-detail,
.large-text .map-note-text,
.large-text .topic-intent {
  font-size: 34rpx;
  line-height: 52rpx;
}

.large-text .topic-title {
  font-size: 40rpx;
  line-height: 54rpx;
}

.large-text .state-detail,
.large-text .topic-start-action,
.large-text .topic-choice-action {
  font-size: 32rpx;
  line-height: 48rpx;
}
