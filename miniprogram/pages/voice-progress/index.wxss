.progress-page {
  min-height: 100vh;
  padding: 42rpx 34rpx 88rpx;
  background: #fcf7ed;
}

.top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.page-title {
  display: block;
  color: #2b1713;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}

.page-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #7b6f68;
  font-size: 26rpx;
  line-height: 1.35;
}

.refresh-button,
.continue-button {
  margin: 0;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

.refresh-button::after,
.continue-button::after {
  border: 0;
}

.refresh-button {
  width: 116rpx;
  height: 68rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: #a64b3e;
  font-size: 25rpx;
  box-shadow: 0 8rpx 22rpx rgba(64, 43, 24, 0.08);
}

.summary-grid {
  margin-top: 34rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.summary-item,
.section,
.session-card {
  border: 2rpx solid #e8d8c3;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(64, 43, 24, 0.08);
}

.summary-item {
  min-height: 152rpx;
  padding: 28rpx;
}

.summary-value {
  display: block;
  color: #a64b3e;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1;
}

.summary-label {
  display: block;
  margin-top: 18rpx;
  color: #7b6f68;
  font-size: 26rpx;
}

.section {
  margin-top: 28rpx;
  padding: 28rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: #2b1713;
  font-size: 32rpx;
  font-weight: 800;
}

.section-meta {
  color: #a64b3e;
  font-size: 26rpx;
}

.module-row {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #fff9f3;
}

.module-title {
  display: block;
  color: #7b4a40;
  font-size: 30rpx;
  font-weight: 800;
}

.module-meta,
.session-meta,
.last-message,
.empty-state {
  display: block;
  color: #7b6f68;
  font-size: 25rpx;
  line-height: 1.45;
}

.module-meta {
  margin-top: 10rpx;
}

.session-card {
  margin-top: 22rpx;
  padding: 24rpx;
  box-shadow: none;
}

.session-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.session-title {
  display: block;
  color: #2b1713;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.session-meta {
  margin-top: 8rpx;
}

.continue-button {
  width: 108rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #fff3ef;
  color: #a64b3e;
  font-size: 25rpx;
  flex: 0 0 auto;
}

.continue-button[disabled] {
  opacity: 0.45;
}

.session-stats {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.session-stats text {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff9f3;
  color: #a64b3e;
  font-size: 24rpx;
  font-weight: 800;
}

.last-message {
  margin-top: 18rpx;
}

.empty-state {
  margin-top: 22rpx;
}

.error {
  margin-top: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff1f3;
  color: #b84a5a;
  font-size: 26rpx;
  line-height: 1.45;
}
