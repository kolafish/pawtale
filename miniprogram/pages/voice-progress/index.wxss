.overview-page {
  padding: 28rpx 30rpx 96rpx;
  color: var(--ui-text-primary);
  -webkit-font-smoothing: antialiased;
}

.refresh-button {
  width: 150rpx;
  padding: 0;
  white-space: nowrap;
  height: var(--ui-hit-size);
  border-radius: 18rpx;
  background: var(--ui-surface);
  color: var(--ui-accent);
  font-size: var(--ui-font-action);
  font-weight: 800;
  box-shadow: var(--ui-card-shadow);
}

.summary-grid {
  margin-top: 32rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0;
  padding: 8rpx;
  overflow: hidden;
  background: var(--ui-success-surface);
}

.summary-item {
  min-height: 128rpx;
  padding: 24rpx;
}

.summary-item:nth-child(odd) {
  border-right: 1rpx solid rgba(88, 112, 82, 0.14);
}

.summary-item:nth-child(-n + 2) {
  border-bottom: 1rpx solid rgba(88, 112, 82, 0.14);
}

.summary-value {
  display: block;
  color: var(--ui-success-text);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
}

.summary-label {
  display: block;
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
}

.section {
  margin-top: 28rpx;
  padding: 28rpx;
}

.section-header,
.topic-heading,
.session-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.section-kicker,
.section-title,
.topic-detail,
.map-note-title,
.map-note-text,
.module-title,
.topic-title,
.topic-intent,
.state-detail {
  display: block;
  overflow-wrap: anywhere;
}

.section-kicker {
  color: var(--ui-accent);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 36rpx;
}

.section-title {
  color: var(--ui-text-primary);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.topic-headline {
  margin-top: 10rpx;
  font-size: var(--ui-font-page-title);
  line-height: 54rpx;
  text-wrap: balance;
}

.topic-detail {
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: 42rpx;
  text-wrap: pretty;
}

.section-meta {
  color: var(--ui-value-text);
  font-size: var(--ui-font-meta);
  line-height: 44rpx;
}

.map-note {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: var(--ui-accent-surface-subtle);
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.05);
}

.map-note-title {
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-list-title);
  font-weight: 700;
  line-height: 1.4;
}

.map-note-text {
  margin-top: 8rpx;
  color: var(--ui-value-text);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  text-wrap: pretty;
}

.module-list,
.topic-list {
  display: flex;
  flex-direction: column;
}

.module-list {
  gap: 32rpx;
  margin-top: 32rpx;
}

.module-title {
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-section-title);
  font-weight: 700;
  line-height: 1.4;
}

.topic-list {
  gap: 18rpx;
  margin-top: 14rpx;
}

.topic-item {
  padding: 24rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
  box-shadow: var(--ui-control-shadow);
}

.topic-title {
  min-width: 0;
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 46rpx;
  text-wrap: balance;
}

.state-chip {
  flex: 0 0 auto;
  max-width: 220rpx;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: var(--ui-surface-subtle);
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-caption);
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
}

.topic-item.already_shared .state-chip {
  background: var(--ui-success-surface);
  color: var(--ui-success-text);
}

.topic-item.enough_for_now .state-chip {
  background: var(--ui-info-surface);
  color: var(--ui-info-text);
}

.topic-item.not_applicable .state-chip,
.topic-item.do_not_discuss .state-chip {
  background: #f2edeb;
  color: var(--ui-text-secondary);
}

.topic-intent {
  margin-top: 14rpx;
  color: var(--ui-text-primary);
  font-size: var(--ui-font-body);
  line-height: 42rpx;
  text-wrap: pretty;
}

.state-detail {
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  text-wrap: pretty;
}

.topic-start-action,
.topic-choice-action {
  width: 100%;
  min-height: 88rpx;
  margin-top: 20rpx;
  padding: 0 20rpx;
  border-radius: var(--ui-radius-control);
  font-size: var(--ui-font-action);
  font-weight: 700;
  line-height: 40rpx;
  transition-property: transform, background-color, box-shadow, opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.topic-start-action {
  justify-content: space-between;
  padding-left: 24rpx;
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  box-shadow: var(--ui-control-shadow);
}

.topic-start-action::after { content: "›"; color: var(--ui-accent); font-size: 36rpx; font-weight: 400; }

.topic-choice-action {
  margin-top: 14rpx;
  background: transparent;
  color: var(--ui-text-secondary);
  box-shadow: 0 0 0 1rpx var(--ui-divider) inset;
}

.topic-start-action-hover,
.topic-choice-action-hover {
  transform: scale(0.96);
}

.topic-start-action-hover {
  background: var(--ui-accent-surface-subtle);
  box-shadow: 0 0 0 1rpx var(--ui-accent-border) inset;
}

.topic-choice-action-hover {
  background: var(--ui-accent-surface);
}

.session-card {
  margin-top: 22rpx;
  padding: 24rpx;
  background: var(--ui-surface-soft);
  box-shadow: var(--ui-control-shadow);
}

.session-copy {
  min-width: 0;
  flex: 1;
}

.session-title {
  display: block;
  color: var(--ui-text-primary);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.session-meta,
.last-message,
.empty-state {
  display: block;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
}

.session-meta {
  margin-top: 8rpx;
  font-variant-numeric: tabular-nums;
}

.continue-button {
  width: 150rpx;
  padding: 0;
  white-space: nowrap;
  height: 80rpx;
  border-radius: 18rpx;
  background: var(--ui-accent-surface);
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-action);
  font-weight: 800;
  flex: 0 0 auto;
}

.session-stats {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  font-variant-numeric: tabular-nums;
}

.session-stats text {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-value-text);
  font-size: var(--ui-font-body);
  font-weight: 800;
}

.last-message,
.empty-state {
  margin-top: 18rpx;
}

.empty-state text {
  display: block;
}

.error {
  margin-top: 24rpx;
  font-size: var(--ui-font-body);
}

.large-text .topic-headline {
  font-size: 48rpx;
  line-height: 64rpx;
}

.large-text .topic-detail,
.large-text .map-note-text,
.large-text .topic-intent {
  font-size: 34rpx;
  line-height: 52rpx;
}

.large-text .topic-title {
  font-size: 40rpx;
  line-height: 54rpx;
}

.large-text .state-detail,
.large-text .topic-start-action,
.large-text .topic-choice-action {
  font-size: var(--ui-font-large-list-title);
  line-height: 48rpx;
}
