<view class="page stack">
  <view class="stack">
    <text class="eyebrow">编辑</text>
    <text class="title">调整回答和校正稿</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="surface stack">
    <text class="eyebrow">访谈问题</text>
    <text class="body-text">{{questionPrompt || "暂无问题"}}</text>
  </view>

  <view class="stack">
    <text class="eyebrow">我的回答</text>
    <textarea
      class="textarea"
      value="{{transcriptText}}"
      maxlength="-1"
      bindinput="onTranscriptInput"
    />
  </view>

  <view class="stack">
    <text class="eyebrow">校正后的回答</text>
    <textarea
      class="textarea editor-draft"
      value="{{draftText}}"
      maxlength="-1"
      bindinput="onDraftInput"
    />
  </view>

  <view class="button-row">
    <button class="button button-secondary" loading="{{saving}}" bindtap="saveEditsOnly">
      保存
    </button>
    <button class="button button-primary" loading="{{saving}}" bindtap="saveAndContinue">
      保存并继续
    </button>
  </view>
</view>
