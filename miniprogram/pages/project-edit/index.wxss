@import "../../styles/support-forms.wxss";

.project-edit-page {
  --ui-fixed-action-space: max(244rpx, 152px);
  padding: 28rpx 36rpx 0;
}

.form-panel {
  padding: 12rpx 30rpx 30rpx;
}

.field {
  padding-top: 24rpx;
}

.field + .field {
  margin-top: 28rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: var(--ui-text-primary);
  font-size: var(--ui-font-list-title);
  font-weight: 800;
  line-height: 1.4;
}

.field-hint {
  display: block;
  margin: -4rpx 0 12rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  text-wrap: pretty;
}

.text-input {
  font-size: var(--ui-font-action);
}

.sharing-setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 44px;
}

.sharing-setting-label {
  margin-bottom: 0;
}

.sharing-setting-row switch {
  flex-shrink: 0;
  padding: 6px 0;
}

.sharing-setting-status {
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
}

.sharing-setting-error {
  display: block;
  margin-top: 12rpx;
  color: var(--ui-danger-text);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
}

.segmented {
  padding: 6rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-subtle);
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6rpx;
}

.segment {
  min-height: 88rpx;
  border-radius: 14rpx;
  color: var(--ui-value-text);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--ui-font-action);
  font-weight: 800;
}

.segment.selected {
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  box-shadow: var(--ui-control-shadow);
}

.mode-list {
  margin-top: 16rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
  overflow: hidden;
}

.mode-option {
  position: relative;
  min-height: 112rpx;
  padding: 22rpx 72rpx 22rpx 24rpx;
}

.mode-option + .mode-option {
  border-top: 1rpx solid var(--ui-divider);
}

.mode-option.selected {
  background: var(--ui-success-surface);
}

.mode-title,
.mode-desc {
  display: block;
  text-wrap: pretty;
}

.mode-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-meta);
  font-weight: 800;
  line-height: 1.35;
}

.mode-desc {
  margin-top: 8rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
}

.option-check {
  position: absolute;
  top: 50%;
  right: 24rpx;
  width: 36rpx;
  height: 36rpx;
  margin-top: -18rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 250, 0.72);
  color: var(--ui-success-text);
  font-size: var(--ui-font-meta);
  font-weight: 800;
  line-height: 36rpx;
  text-align: center;
}

.actions {
  --ui-fixed-action-inline: 36rpx;
  --ui-fixed-action-background: var(--ui-page-background);
  border-top: 1rpx solid var(--ui-divider);
}

.save-error {
  margin-bottom: 16rpx;
}

.save-status {
  display: block;
  margin-bottom: 16rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  line-height: var(--ui-line-meta);
}

.action-buttons {
  display: grid;
  grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
  gap: 14rpx;
}

.ghost-button,
.primary-button {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  min-height: var(--ui-hit-size);
  padding: 12rpx 8rpx;
  white-space: normal;
  line-height: 1.4;
  border-radius: var(--ui-radius-control);
  background: transparent;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-action);
}

.primary-button {
  background: var(--ui-accent-strong);
  color: var(--ui-on-accent);
}

.ghost-button[disabled],
.primary-button[disabled] {
  opacity: 0.66;
}

.large-text .field-label { font-size: var(--ui-font-large-list-title); }
.large-text .field-hint { font-size: var(--ui-font-large-body); }
.large-text .save-status { font-size: var(--ui-font-large-meta); }
