.project-edit-page {
  min-height: 100vh;
  padding: 44rpx 36rpx 120rpx;
  background: #fffaf2;
}

.top-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 28rpx;
}

.back-hit {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-mark {
  color: #9f4a3c;
  font-size: 72rpx;
  line-height: 1;
}

.title-block {
  min-width: 0;
}

.page-title {
  display: block;
  color: #24100b;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}

.page-meta {
  display: block;
  margin-top: 8rpx;
  color: #685b55;
  font-size: 26rpx;
  line-height: 1.35;
}

.error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff1f2;
  color: #b4234a;
  font-size: 28rpx;
  line-height: 1.45;
}

.form-panel {
  padding: 32rpx;
  border: 2rpx solid #f0dac0;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(64, 43, 24, 0.07);
}

.field + .field {
  margin-top: 30rpx;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: #7a3b31;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.text-input {
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #efd6c4;
  border-radius: 18rpx;
  background: #fffaf2;
  color: #24100b;
  font-size: 30rpx;
  box-sizing: border-box;
}

.segmented {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.segment,
.mode-option {
  border: 2rpx solid #f0dac0;
  border-radius: 18rpx;
  background: #fffaf2;
  color: #5b4038;
}

.segment {
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
}

.segment.selected,
.mode-option.selected {
  border-color: #9f4a3c;
  background: #fff1ec;
  color: #7a3b31;
}

.mode-list {
  display: grid;
  gap: 16rpx;
}

.mode-option {
  padding: 24rpx;
}

.mode-title {
  display: block;
  color: #24100b;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.mode-desc {
  display: block;
  margin-top: 10rpx;
  color: #685b55;
  font-size: 25rpx;
  line-height: 1.4;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 32rpx;
}

.ghost-button,
.primary-button {
  height: 92rpx;
  margin: 0;
  border: 0;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
}

.ghost-button::after,
.primary-button::after {
  border: 0;
}

.ghost-button {
  background: #fff1ec;
  color: #8a4034;
}

.primary-button {
  background: #9f4a3c;
  color: #ffffff;
}

.ghost-button[disabled],
.primary-button[disabled] {
  opacity: 0.66;
}
