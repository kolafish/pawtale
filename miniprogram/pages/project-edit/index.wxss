.project-edit-page {
  min-height: 100vh;
  padding: 28rpx 36rpx 120rpx;
  background: var(--ui-page-background);
}

.error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
  font-size: 28rpx;
  line-height: 1.45;
}

.form-panel {
  padding: 32rpx;
  border: 2rpx solid var(--ui-border);
  border-radius: 24rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow);
}

.field + .field {
  margin-top: 30rpx;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: var(--ui-section-title);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.text-input {
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--ui-border);
  border-radius: 18rpx;
  background: var(--ui-page-background);
  color: var(--ui-text-primary);
  font-size: 30rpx;
  box-sizing: border-box;
}

.segmented {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.segment,
.mode-option {
  border: 2rpx solid var(--ui-border);
  border-radius: 18rpx;
  background: var(--ui-page-background);
  color: var(--ui-value-text);
}

.segment {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
}

.segment.selected,
.mode-option.selected {
  border-color: var(--ui-accent);
  background: var(--ui-accent-surface);
  color: var(--ui-section-title);
}

.mode-list {
  display: grid;
  gap: 16rpx;
}

.mode-option {
  padding: 24rpx;
}

.mode-title {
  display: block;
  color: var(--ui-text-primary);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.mode-desc {
  display: block;
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 1.4;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 32rpx;
}

.ghost-button,
.primary-button {
  height: 92rpx;
  margin: 0;
  border: 0;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
}

.ghost-button::after,
.primary-button::after {
  border: 0;
}

.ghost-button {
  background: var(--ui-accent-surface);
  color: var(--ui-accent-strong);
}

.primary-button {
  background: var(--ui-accent);
  color: var(--ui-on-accent);
}

.ghost-button[disabled],
.primary-button[disabled] {
  opacity: 0.66;
}
