@import "../../styles/support-forms.wxss";

.project-edit-page {
  padding: 28rpx 36rpx 120rpx;
}

.error {
  margin-bottom: 24rpx;
}

.form-panel {
  padding: 12rpx 30rpx 30rpx;
}

.field {
  padding-top: 24rpx;
}

.field + .field {
  margin-top: 28rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: var(--ui-text-primary);
  font-size: var(--ui-font-list-title);
  font-weight: 800;
  line-height: 1.4;
}

.field-hint {
  display: block;
  margin: -4rpx 0 12rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  text-wrap: pretty;
}

.text-input {
  font-size: var(--ui-font-action);
}

.segmented {
  padding: 6rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-subtle);
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6rpx;
}

.segment {
  min-height: 88rpx;
  border-radius: 14rpx;
  color: var(--ui-value-text);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--ui-font-action);
  font-weight: 800;
}

.segment.selected {
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  box-shadow: var(--ui-control-shadow);
}

.mode-list {
  margin-top: 16rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
  overflow: hidden;
}

.mode-option {
  position: relative;
  min-height: 112rpx;
  padding: 22rpx 72rpx 22rpx 24rpx;
}

.mode-option + .mode-option {
  border-top: 1rpx solid var(--ui-divider);
}

.mode-option.selected {
  background: var(--ui-success-surface);
}

.mode-title,
.mode-desc {
  display: block;
  text-wrap: pretty;
}

.mode-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.mode-desc {
  margin-top: 8rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
}

.option-check {
  position: absolute;
  top: 50%;
  right: 24rpx;
  width: 36rpx;
  height: 36rpx;
  margin-top: -18rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 250, 0.72);
  color: var(--ui-success-text);
  font-size: var(--ui-font-meta);
  font-weight: 800;
  line-height: 36rpx;
  text-align: center;
}

.actions {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.ghost-button,
.primary-button {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  min-height: 88rpx;
  border-radius: var(--ui-radius-control);
  background: transparent;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-action);
}

.primary-button {
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  box-shadow: inset 0 0 0 2rpx var(--ui-accent-border);
}

.ghost-button[disabled],
.primary-button[disabled] {
  opacity: 0.66;
}

.large-text .field-label { font-size: var(--ui-font-large-list-title); }
.large-text .field-hint { font-size: var(--ui-font-large-body); }
