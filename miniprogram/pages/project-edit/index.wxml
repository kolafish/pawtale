<view class="ui-page-shell {{pageClass}}" style="{{actionDockHeight ? 'padding-bottom: ' + actionDockHeight + 'px' : ''}}">

  <view class="form-panel ui-card">
    <view class="field">
      <text class="field-label">回忆录名称</text>
      <input
        id="project-title-input"
        class="text-input support-form-input"
        value="{{title}}"
        disabled="{{loading || saving}}"
        cursor-spacing="{{actionDockHeight || 144}}"
        maxlength="40"
        placeholder="例如：母亲的回忆"
        bindinput="changeTitle"
      />
    </view>

    <view class="field">
      <text class="field-label">主人公称呼</text>
      <input
        id="project-narrator-name-input"
        class="text-input support-form-input"
        value="{{narratorName}}"
        disabled="{{loading || saving}}"
        cursor-spacing="{{actionDockHeight || 144}}"
        maxlength="40"
        placeholder="例如：爷爷"
        bindinput="changeNarratorName"
      />
    </view>

    <view class="field">
      <text class="field-label">性别</text>
      <view class="segmented" aria-role="radiogroup" aria-label="主人公性别">
        <view
          wx:for="{{genderOptions}}"
          wx:key="value"
          class="segment ui-pressable {{narratorGender === item.value ? 'selected' : ''}}"
          data-gender="{{item.value}}"
          bindtap="selectGender"
          aria-disabled="{{loading || saving}}"
          aria-role="radio"
          aria-checked="{{narratorGender === item.value}}"
          aria-label="{{item.label}}"
        >
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="field">
      <text class="field-label">籍贯</text>
      <input
        id="project-origin-input"
        class="text-input support-form-input"
        value="{{narratorOrigin}}"
        disabled="{{loading || saving}}"
        cursor-spacing="{{actionDockHeight || 144}}"
        maxlength="40"
        placeholder="例如：四川成都"
        bindinput="changeOrigin"
      />
    </view>

    <view class="field">
      <text class="field-label">年龄</text>
      <input
        id="project-age-input"
        class="text-input support-form-input"
        value="{{narratorAgeText}}"
        type="number"
        disabled="{{loading || saving}}"
        cursor-spacing="{{actionDockHeight || 144}}"
        maxlength="3"
        placeholder="例如：72"
        bindinput="changeAge"
      />
    </view>

    <view wx:if="{{projectId}}" class="field">
      <view class="sharing-setting-row">
        <text class="field-label sharing-setting-label">分享全书</text>
        <switch wx:if="{{bookShareState !== 'error'}}" checked="{{bookShareEnabled}}" color="#a35445" aria-label="分享全书"
          disabled="{{loading || saving || bookShareBusy || bookShareState !== 'ready'}}" bindchange="toggleBookShare" />
        <text wx:if="{{bookShareState === 'error'}}" class="sharing-setting-status" aria-live="polite">状态待确认</text>
      </view>
      <text class="mode-desc">即时生效。开启后，收到分享的人可阅读全书。关闭后，旧全书链接失效，选文和整章分享不受影响。</text>
      <text wx:if="{{bookShareBusy}}" class="mode-desc" aria-live="polite">正在更新分享设置…</text>
      <text wx:elif="{{bookShareState === 'loading'}}" class="mode-desc">正在读取分享状态…</text>
      <text wx:elif="{{bookShareState === 'unavailable'}}" class="mode-desc">还没有全书稿，生成后可开启。</text>
      <text wx:if="{{bookShareState === 'ready' && bookSharePendingTarget !== null}}" class="mode-desc" aria-live="polite">设置可能仍在处理中，当前显示最近读取的状态。请稍后刷新确认。</text>
      <text wx:if="{{bookShareError}}" class="sharing-setting-error" aria-live="polite">{{bookShareError}}</text>
      <button wx:if="{{bookShareState === 'error' || bookSharePendingTarget !== null}}" class="ghost-button support-action" bindtap="loadBookShareSetting" disabled="{{saving || bookShareBusy || bookShareState === 'loading'}}">{{bookShareState === 'error' ? '重试读取分享状态' : '刷新分享状态'}}</button>
    </view>

    <view class="field">
      <text class="field-label">默认访谈方式</text>
      <text class="mode-desc">用于之后的讲述；书稿补充先选问题。</text>
      <view class="mode-list" aria-role="radiogroup" aria-label="默认访谈方式">
        <view
          wx:for="{{narrationOptions}}"
          wx:key="value"
          id="default-mode-{{item.value}}"
          class="mode-option ui-pressable {{defaultNarrationMode === item.value ? 'selected' : ''}}"
          data-mode="{{item.value}}"
          bindtap="selectNarrationMode"
          aria-disabled="{{loading || saving}}"
          aria-role="radio"
          aria-checked="{{defaultNarrationMode === item.value}}"
          aria-label="{{item.label}}，{{item.description}}"
        >
          <text class="mode-title">{{item.label}}</text>
          <text class="mode-desc">{{item.description}}</text>
          <text wx:if="{{defaultNarrationMode === item.value}}" class="option-check" aria-hidden="true">✓</text>
        </view>
      </view>
    </view>

    <view class="field">
      <text class="field-label">素材与正文润色强度</text>
      <text class="mode-desc">用于新增或重新处理的文字，已有文字不变。</text>
      <view class="mode-list" aria-role="radiogroup" aria-label="素材与正文润色强度">
        <view
          wx:for="{{transcriptPolishOptions}}"
          wx:key="value"
          id="polish-level-{{item.value}}"
          class="mode-option ui-pressable {{transcriptPolishLevel === item.value ? 'selected' : ''}}"
          data-polish="{{item.value}}"
          bindtap="selectTranscriptPolishLevel"
          aria-disabled="{{loading || saving}}"
          aria-role="radio"
          aria-checked="{{transcriptPolishLevel === item.value}}"
          aria-label="{{item.label}}，{{item.description}}"
        >
          <text class="mode-title">{{item.label}}</text>
          <text class="mode-desc">{{item.description}}</text>
          <text wx:if="{{transcriptPolishLevel === item.value}}" class="option-check" aria-hidden="true">✓</text>
        </view>
      </view>
    </view>
    <view class="field">
      <text class="field-label">默认分享视频风格</text>
      <text class="mode-desc">制作视频时可重新选择。</text>
      <view class="mode-list" aria-role="radiogroup" aria-label="默认分享视频风格">
        <view
          wx:for="{{shareVideoStyleOptions}}"
          wx:key="value"
          class="mode-option ui-pressable {{shareVideoStyle === item.value ? 'selected' : ''}}"
          data-video-style="{{item.value}}"
          bindtap="selectShareVideoStyle"
          aria-disabled="{{loading || saving}}"
          aria-role="radio"
          aria-checked="{{shareVideoStyle === item.value}}"
          aria-label="{{item.label}}，{{item.description}}"
        >
          <text class="mode-title">{{item.label}}</text>
          <text class="mode-desc">{{item.description}}</text>
          <text wx:if="{{shareVideoStyle === item.value}}" class="option-check" aria-hidden="true">✓</text>
        </view>
      </view>
    </view>
  </view>

  <view id="project-edit-actions" class="actions ui-fixed-action-dock">
    <view wx:if="{{error}}" class="save-error ui-error-banner" aria-live="assertive">{{error}}</view>
    <text class="save-status" aria-live="polite">{{loading ? "正在读取回忆录…" : saving ? "正在保存…" : hasUnsavedChanges ? "有修改未保存" : projectId ? "修改后请保存" : "填写后保存回忆录"}}</text>
    <view class="action-buttons">
      <button id="project-cancel-action" class="ghost-button support-action ui-pressable" disabled="{{saving || loading || bookShareBusy}}" bindtap="cancel">取消</button>
      <button id="project-save-action" class="primary-button support-action ui-pressable" loading="{{saving}}" disabled="{{saving || loading || bookShareBusy}}" bindtap="saveProject">
        {{saving ? "保存中" : "保存"}}
      </button>
    </view>
  </view>
</view>
