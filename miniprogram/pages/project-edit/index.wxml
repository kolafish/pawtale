<view class="{{pageClass}}">
  <view class="ui-page-context-row">
    <text class="ui-page-context">资料会用于语音访谈和小余追问</text>
  </view>

  <view wx:if="{{error}}" class="error ui-error-banner">{{error}}</view>

  <view class="form-panel ui-card">
    <view class="field">
      <text class="field-label ui-section-heading">回忆录名称</text>
      <input
        id="project-title-input"
        class="text-input"
        value="{{title}}"
        maxlength="40"
        placeholder="例如：母亲的回忆"
        bindinput="changeTitle"
      />
    </view>

    <view class="field">
      <text class="field-label ui-section-heading">性别</text>
      <view class="segmented">
        <view
          wx:for="{{genderOptions}}"
          wx:key="value"
          class="segment {{narratorGender === item.value ? 'selected' : ''}}"
          data-gender="{{item.value}}"
          bindtap="selectGender"
        >
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="field">
      <text class="field-label ui-section-heading">籍贯</text>
      <input
        id="project-origin-input"
        class="text-input"
        value="{{narratorOrigin}}"
        maxlength="40"
        placeholder="例如：四川成都"
        bindinput="changeOrigin"
      />
    </view>

    <view class="field">
      <text class="field-label ui-section-heading">年龄</text>
      <input
        id="project-age-input"
        class="text-input"
        value="{{narratorAgeText}}"
        type="number"
        maxlength="3"
        placeholder="例如：72"
        bindinput="changeAge"
      />
    </view>

    <view class="field">
      <text class="field-label ui-section-heading">AI 的默认引导方式</text>
      <text class="mode-desc">仅设置 AI 的默认方式；四种讲述方式在首页选择。</text>
      <view class="mode-list">
        <view
          wx:for="{{guidanceOptions}}"
          wx:key="value"
          class="mode-option {{defaultGuidanceMode === item.value ? 'selected' : ''}}"
          data-mode="{{item.value}}"
          bindtap="selectGuidanceMode"
        >
          <text class="mode-title">{{item.label}}</text>
          <text class="mode-desc">{{item.value === 'guided_interview' ? '小余按人物、事件、地点和主题追问' : '讲述者按自己的节奏说'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="actions">
    <button id="project-cancel-action" class="ghost-button" disabled="{{saving || loading}}" bindtap="cancel">取消</button>
    <button id="project-save-action" class="primary-button" loading="{{saving}}" disabled="{{saving || loading}}" bindtap="saveProject">
      {{saving ? "保存中" : "保存"}}
    </button>
  </view>
</view>
