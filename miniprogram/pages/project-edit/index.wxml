<view class="ui-page-shell {{pageClass}}">
  <view class="ui-page-context-row">
    <text class="ui-page-context">资料和默认访谈方式会用于之后的新讲述</text>
  </view>

  <view wx:if="{{error}}" class="error ui-error-banner">{{error}}</view>

  <view class="form-panel ui-card">
    <view class="field">
      <text class="field-label ui-section-heading">回忆录名称</text>
      <input
        id="project-title-input"
        class="text-input support-form-input"
        value="{{title}}"
        maxlength="40"
        placeholder="例如：母亲的回忆"
        bindinput="changeTitle"
      />
    </view>

    <view class="field">
      <text class="field-label ui-section-heading">主人公称呼</text>
      <input
        id="project-narrator-name-input"
        class="text-input support-form-input"
        value="{{narratorName}}"
        maxlength="40"
        placeholder="例如：爷爷"
        bindinput="changeNarratorName"
      />
    </view>

    <view class="field">
      <text class="field-label ui-section-heading">性别</text>
      <view class="segmented">
        <view
          wx:for="{{genderOptions}}"
          wx:key="value"
          class="segment ui-pressable {{narratorGender === item.value ? 'selected' : ''}}"
          data-gender="{{item.value}}"
          bindtap="selectGender"
        >
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="field">
      <text class="field-label ui-section-heading">籍贯</text>
      <input
        id="project-origin-input"
        class="text-input support-form-input"
        value="{{narratorOrigin}}"
        maxlength="40"
        placeholder="例如：四川成都"
        bindinput="changeOrigin"
      />
    </view>

    <view class="field">
      <text class="field-label ui-section-heading">年龄</text>
      <input
        id="project-age-input"
        class="text-input support-form-input"
        value="{{narratorAgeText}}"
        type="number"
        maxlength="3"
        placeholder="例如：72"
        bindinput="changeAge"
      />
    </view>

    <view class="field">
      <text class="field-label ui-section-heading">默认访谈方式</text>
      <text class="mode-desc">以后从首页开始会使用这个方式；书稿补充会先进入待补问题列表，进行中的讲述不会改变。</text>
      <view class="mode-list" aria-role="radiogroup" aria-label="默认访谈方式">
        <view
          wx:for="{{narrationOptions}}"
          wx:key="value"
          id="default-mode-{{item.value}}"
          class="mode-option ui-pressable {{defaultNarrationMode === item.value ? 'selected' : ''}}"
          data-mode="{{item.value}}"
          bindtap="selectNarrationMode"
          aria-role="radio"
          aria-checked="{{defaultNarrationMode === item.value}}"
          aria-label="{{item.label}}，{{item.description}}"
        >
          <text class="mode-title">{{item.label}}</text>
          <text class="mode-desc">{{item.description}}</text>
          <text wx:if="{{defaultNarrationMode === item.value}}" class="option-check" aria-hidden="true">✓</text>
        </view>
      </view>
    </view>
  </view>

  <view class="actions">
    <button id="project-cancel-action" class="ghost-button support-action ui-pressable" disabled="{{saving || loading}}" bindtap="cancel">取消</button>
    <button id="project-save-action" class="primary-button support-action ui-pressable" loading="{{saving}}" disabled="{{saving || loading}}" bindtap="saveProject">
      {{saving ? "保存中" : "保存"}}
    </button>
  </view>
</view>
