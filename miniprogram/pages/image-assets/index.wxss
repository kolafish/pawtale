.image-assets-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 30rpx 36rpx;
  background: #fcf7ed;
  color: #2b1713;
}

.error {
  margin-bottom: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: #fff1f3;
  color: #b84a5a;
  font-size: 26rpx;
  line-height: 1.45;
}

.summary-card {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 24rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 42rpx rgba(63, 45, 35, 0.08);
}

.summary-item {
  min-height: 112rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
  padding: 14rpx;
  border-radius: 18rpx;
  background: #fbf4eb;
}

.summary-value {
  font-size: 42rpx;
  font-weight: 900;
  color: #2f1712;
  font-variant-numeric: tabular-nums;
}

.summary-label {
  font-size: 23rpx;
  color: #7c6e66;
}

.empty-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 42rpx 34rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 42rpx rgba(63, 45, 35, 0.08);
}

.empty-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #2b1713;
}

.empty-copy {
  font-size: 27rpx;
  color: #76685f;
  line-height: 1.55;
}

.asset-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.asset-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 42rpx rgba(63, 45, 35, 0.08);
}

.asset-main {
  display: flex;
  gap: 20rpx;
}

.asset-thumb {
  flex: 0 0 178rpx;
  width: 178rpx;
  height: 178rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: #f2e7dc;
  outline: 1rpx solid rgba(0, 0, 0, 0.1);
  transition-property: transform, opacity;
  transition-duration: 160ms;
}

.asset-thumb:active {
  transform: scale(0.96);
}

.asset-image,
.asset-placeholder {
  width: 178rpx;
  height: 178rpx;
}

.asset-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9d8d84;
  font-size: 26rpx;
  font-weight: 700;
}

.asset-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.asset-title-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.asset-title {
  min-width: 0;
  flex: 1;
  color: #2b1713;
  font-size: 32rpx;
  font-weight: 850;
  line-height: 1.28;
}

.asset-status {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f3eadf;
  color: #7c6e66;
  font-size: 22rpx;
  font-weight: 800;
}

.asset-status.included {
  background: var(--ui-success-surface);
  color: var(--ui-success-text);
}

.asset-meta,
.asset-placement,
.asset-source {
  font-size: 24rpx;
  line-height: 1.45;
  color: #7a6b63;
}

.asset-placement {
  color: #8f463c;
  font-weight: 700;
}

.asset-source {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.caption-box {
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #fbf4eb;
}

.caption-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #6e5d55;
}

.caption-input {
  width: 100%;
  min-height: 92rpx;
  box-sizing: border-box;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #fffdf8;
  color: #2b1713;
  font-size: 27rpx;
  line-height: 1.5;
}

.minor-button {
  min-height: 44px;
  margin: 16rpx 0 0;
  padding: 0 22rpx;
  border: 0;
  border-radius: 18rpx;
  background: #ffffff;
  color: #7b4a40;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.asset-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.action-button {
  min-width: 150rpx;
  min-height: 44px;
  margin: 0;
  padding: 0 20rpx;
  border: 0;
  border-radius: 18rpx;
  background: #fff5f1;
  color: #8f463c;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 76rpx;
  text-align: center;
  transition-property: transform, opacity;
  transition-duration: 160ms;
}

.action-button::after,
.minor-button::after {
  border: 0;
}

.action-button:active,
.minor-button:active {
  transform: scale(0.96);
}

.primary-action {
  background: #2f1712;
  color: #fffaf2;
}

.action-button.danger {
  background: #fff1f3;
  color: #b84a5a;
}

.asset-secondary-actions {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eadfd4;
}

.asset-details-toggle {
  width: 100%;
  min-height: 44px;
  margin: 14rpx 0 0;
  padding: 10rpx 12rpx;
  border: 0;
  background: transparent;
  color: #7b4a40;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.45;
  transition: transform 140ms ease-out;
}

.asset-details-toggle::after {
  border: 0;
}

.asset-details-toggle:active {
  transform: scale(0.98);
}

.action-button.disabled,
.action-button[disabled],
.minor-button[disabled] {
  opacity: 0.58;
}

.bottom-spacer {
  height: 48rpx;
}
