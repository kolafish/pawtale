.image-assets-page {
  padding: 28rpx 30rpx 36rpx;
  color: var(--ui-text-primary);
}

.error {
  margin-bottom: 20rpx;
  padding: 20rpx 22rpx;
  font-size: var(--ui-font-body);
}

.summary-card {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  margin-bottom: 24rpx;
  padding: 18rpx 10rpx;
  border-radius: var(--ui-radius-card);
  background: var(--ui-success-surface);
}

.summary-item {
  min-height: 112rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 5rpx;
  padding: 12rpx 8rpx;
}

.summary-item + .summary-item {
  border-left: 1rpx solid rgba(88, 112, 82, 0.16);
}

.summary-value {
  font-size: 42rpx;
  font-weight: 900;
  color: var(--ui-text-primary);
  font-variant-numeric: tabular-nums;
}

.summary-label {
  font-size: var(--ui-font-caption);
  color: var(--ui-text-secondary);
}

.empty-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 42rpx 34rpx;
  border-radius: 24rpx;
  background: linear-gradient(140deg, var(--ui-success-surface), var(--ui-surface));
  box-shadow: var(--ui-card-shadow);
}

.empty-title {
  font-family: var(--ui-font-editorial);
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ui-text-primary);
}

.empty-copy {
  font-size: var(--ui-font-body);
  color: var(--ui-text-secondary);
  line-height: 1.55;
}

.asset-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.asset-section-title {
  display: block;
  margin: 8rpx 4rpx 16rpx;
  color: var(--ui-section-title);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-section-title);
  font-weight: 700;
}

.video-section-title {
  margin-top: 30rpx;
}

.asset-card {
  padding: 24rpx;
  border-radius: var(--ui-radius-card);
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow-raised);
}

.asset-main {
  display: flex;
  gap: 20rpx;
}

.asset-thumb {
  flex: 0 0 178rpx;
  width: 178rpx;
  height: 178rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: var(--ui-surface-subtle);
  outline: 1rpx solid rgba(0, 0, 0, 0.1);
  outline-offset: -1rpx;
  transition-property: transform, opacity;
  transition-duration: 160ms;
}

.asset-thumb:active {
  transform: scale(0.96);
}

.video-thumb {
  background: var(--ui-accent-surface-subtle);
}

.asset-image,
.asset-placeholder {
  display: block;
  width: 178rpx;
  height: 178rpx;
}

.asset-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: var(--ui-text-muted);
  font-size: var(--ui-font-body);
  font-weight: 700;
}

.asset-placeholder.failed {
  color: var(--ui-danger-text);
}

.asset-placeholder-hint {
  font-size: var(--ui-font-caption);
  font-weight: 600;
}

.asset-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.asset-title-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.asset-title {
  min-width: 0;
  flex: 1;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.28;
}

.asset-status {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: var(--ui-surface-subtle);
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-caption);
  font-weight: 800;
}

.asset-status.included {
  background: var(--ui-success-surface);
  color: var(--ui-success-text);
}

.asset-status.outdated {
  background: var(--ui-warning-surface);
  color: var(--ui-warning-text);
}

.video-remake-button {
  margin-top: 18rpx;
}

.asset-meta,
.asset-placement,
.asset-source {
  font-size: var(--ui-font-meta);
  line-height: 1.45;
  color: var(--ui-text-secondary);
}

.asset-placement {
  color: var(--ui-value-text);
  font-weight: 700;
}

.asset-source {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.caption-box {
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: var(--ui-surface-soft);
}

.caption-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: var(--ui-font-meta);
  font-weight: 800;
  color: var(--ui-text-secondary);
}

.caption-input {
  width: 100%;
  min-height: 92rpx;
  box-sizing: border-box;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: var(--ui-surface);
  box-shadow: inset 0 0 0 1rpx rgba(54, 42, 34, 0.055);
  color: var(--ui-text-primary);
  font-size: var(--ui-font-body);
  line-height: 1.5;
}

.minor-button {
  min-height: 44px;
  margin: 16rpx 0 0;
  padding: 0 22rpx;
  border: 0;
  border-radius: 18rpx;
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-section-title);
  font-size: var(--ui-font-action);
  font-weight: 800;
  line-height: 72rpx;
}

.asset-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.action-button {
  min-width: 150rpx;
  min-height: 44px;
  margin: 0;
  padding: 0 20rpx;
  border: 0;
  border-radius: 18rpx;
  background: var(--ui-surface-soft);
  box-shadow: var(--ui-control-shadow);
  color: var(--ui-value-text);
  font-size: var(--ui-font-action);
  font-weight: 800;
  line-height: 76rpx;
  text-align: center;
}

.action-button::before {
  content: "";
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: var(--ui-accent-border);
}

.primary-action {
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-accent-strong);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
}

.primary-action::before {
  background: var(--ui-accent);
}

.action-button.danger {
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
}

.asset-secondary-actions {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.asset-details-toggle {
  width: 100%;
  min-height: 44px;
  position: relative;
  margin: 16rpx 0 0;
  padding: 16rpx 42rpx 10rpx 12rpx;
  border: 0;
  border-top: 1rpx solid var(--ui-divider);
  background: transparent;
  color: var(--ui-section-title);
  font-size: var(--ui-font-body);
  font-weight: 700;
  line-height: var(--ui-line-body);
}

.asset-details-toggle::after {
  content: "›";
  position: absolute;
  right: 12rpx;
  color: var(--ui-text-muted);
  font-size: 36rpx;
  font-weight: 300;
}

.video-preview-card {
  margin-bottom: 24rpx;
}

.video-preview-heading {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.video-preview-close {
  flex-shrink: 0;
  min-width: 112rpx;
}

.video-preview {
  display: block;
  width: 100%;
  border-radius: 18rpx;
  background: #171513;
  outline: 1rpx solid rgba(0, 0, 0, 0.1);
}

.action-button.disabled,
.action-button[disabled],
.minor-button[disabled] {
  opacity: 0.58;
}

.bottom-spacer {
  height: 48rpx;
}
