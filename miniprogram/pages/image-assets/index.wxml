<page-meta page-style="--ui-navigation-height: {{navigationHeight || 0}}px;" />
<brand-navigation title="{{navigationTitle || '图片素材'}}" page-class="{{pageClass || homePageClass}}" bindlayout="onNavigationLayout" />
<import src="../../templates/video-playback.wxml" />
<view class="ui-page-shell {{pageClass}}">
  <view class="ui-page-context-row">
    <text class="ui-page-context">{{contextText}}</text>
  </view>

  <view wx:if="{{error}}" class="error ui-error-banner">
    <text>{{error}}</text>
    <button class="ui-button ui-share-more" bindtap="loadImageAssets" disabled="{{loading || placingTarget || deletingTarget}}">重新读取</button>
  </view>

  <view wx:if="{{!error || items.length || videos.length}}" class="summary-card">
    <block wx:if="{{isStoryMaterialView}}">
      <view class="summary-item">
        <text class="summary-value">{{items.length + videos.length}}</text>
        <text class="summary-label">全部素材</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">{{items.length}}</text>
        <text class="summary-label">图片</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">{{videos.length}}</text>
        <text class="summary-label">视频</text>
      </view>
    </block>
    <block wx:else>
      <view class="summary-item">
        <text class="summary-value">{{total}}</text>
        <text class="summary-label">全部图片</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">{{includedCount}}</text>
        <text class="summary-label">已入书</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">{{unusedCount}}</text>
        <text class="summary-label">待选择</text>
      </view>
    </block>
  </view>

  <view wx:if="{{videoPreviewPath}}" class="asset-card video-preview-card">
    <view class="video-preview-heading">
      <text class="asset-title">{{videoPreviewTitle}}</text>
      <button class="action-button video-preview-close ui-button" bindtap="closeVideoPreview">关闭</button>
    </view>
    <video
      id="memoir-video"
      class="video-preview {{videoPreviewPortrait ? 'is-portrait' : ''}}"
      src="{{videoPreviewPath}}"
      bindloadedmetadata="markVideoPreviewShape"
      bindplay="applyVideoPlaybackRate"
      bindfullscreenchange="closeVideoSpeedMenu"
      bindended="closeVideoSpeedMenu"
      controls
      show-center-play-btn
      show-fullscreen-btn
      object-fit="contain"
    >
      <template is="videoPlaybackSpeed" data="{{videoPlaybackRate, videoPlaybackRates, videoSpeedMenuOpen}}" />
    </video>
  </view>

  <view wx:if="{{loading && !items.length && !videos.length}}" class="empty-card">
    <text class="empty-title">正在同步素材</text>
  </view>

  <view wx:elif="{{!error && !items.length && !videos.length}}" class="empty-card">
    <text class="empty-title">{{isStoryMaterialView ? "这里还没有素材" : "还没有图片素材"}}</text>
    <text wx:if="{{!isStoryMaterialView}}" class="empty-copy">到讲述详情选一段话生成插图。</text>
  </view>

  <text wx:if="{{isStoryMaterialView && items.length}}" class="asset-section-title">图片</text>
  <view wx:if="{{items.length}}" class="asset-list">
    <view wx:for="{{items}}" wx:key="id" class="asset-card">
      <view class="asset-main">
        <view
          class="asset-thumb"
          data-id="{{item.id}}"
          aria-role="button"
          aria-label="{{item.thumbnailState === 'failed' ? '重新加载图片预览' : '查看图片预览'}}"
          bindtap="previewAsset"
        >
          <image
            wx:if="{{item.localPath}}"
            class="asset-image"
            src="{{item.localPath}}"
            mode="aspectFill"
            data-id="{{item.id}}"
            binderror="onThumbnailError"
          />
          <view wx:else class="asset-placeholder {{item.thumbnailState}}">
            <text wx:if="{{item.thumbnailState === 'loading'}}">加载中</text>
            <block wx:elif="{{item.thumbnailState === 'failed'}}">
              <text>预览失败</text>
              <text class="asset-placeholder-hint">点按重试</text>
            </block>
            <text wx:elif="{{item.status === 'ready'}}">点按预览</text>
            <text wx:else>图片</text>
          </view>
        </view>
        <view class="asset-copy">
          <view class="asset-title-row">
            <text class="asset-title">{{item.titleText}}</text>
            <button class="asset-delete ui-button" data-id="{{item.id}}" loading="{{deletingTarget === item.id}}"
              disabled="{{!!placingTarget || !!deletingTarget}}" bindtap="deleteAsset" aria-label="删除图片素材">删除</button>
          </view>
        </view>
      </view>

      <photo-caption-editor wx:if="{{item.source_type === 'manual_upload'}}" project-id="{{projectId}}" asset-id="{{item.id}}" caption="{{item.caption}}"
        disabled="{{!!placingTarget || !!deletingTarget}}" bindsaved="onPhotoCaptionSaved" />

      <view class="asset-placement-summary">
        <text class="asset-status {{item.include_in_book ? 'included' : ''}}">{{item.include_in_book ? '✓ 已入书' : item.statusText}}</text>
        <text wx:if="{{item.include_in_book}}" class="asset-placement">{{item.placementText}}</text>
      </view>

      <view class="asset-actions">
        <button wx:if="{{!item.include_in_book}}" class="action-button primary-action ui-button" data-id="{{item.id}}"
          loading="{{placingTarget === item.id}}" disabled="{{!!placingTarget || !!deletingTarget || item.status !== 'ready'}}"
          bindtap="placeNearSource">加入书稿</button>
        <button class="action-button {{item.include_in_book ? 'primary-action' : ''}} ui-button" data-id="{{item.id}}"
          disabled="{{!!placingTarget || !!deletingTarget || item.status !== 'ready'}}"
          aria-expanded="{{item.detailsExpanded}}" bindtap="toggleAssetDetails">{{item.detailsExpanded ? '收起选项' : (item.include_in_book ? '调整位置' : '选择位置')}}</button>
        <button wx:if="{{item.include_in_book}}" class="action-button ui-button" data-id="{{item.id}}"
          loading="{{placingTarget === item.id}}" disabled="{{!!placingTarget || !!deletingTarget}}" bindtap="removeFromBook">移出书稿</button>
      </view>

      <view wx:if="{{item.detailsExpanded}}" class="asset-more">
        <text class="asset-position-hint">{{item.sourceIds.length ? '已关联正文素材，多张插图可自动分散。' : '请选择对应的正文素材，图片会放在素材附近。'}}</text>
        <picker wx:if="{{materialOptions.length}}" range="{{materialOptions}}" range-key="label" data-id="{{item.id}}"
          disabled="{{!!placingTarget || !!deletingTarget || item.status !== 'ready'}}" bindchange="chooseSourceMaterial">
          <view class="asset-position-option ui-pressable">选择对应素材<text aria-hidden="true">›</text></view>
        </picker>
        <picker wx:if="{{item.sourceIds.length}}" range="{{['自动分散', '素材前面', '素材中间', '素材后面']}}"
          value="{{item.inlinePositionIndex}}" data-id="{{item.id}}" disabled="{{!!placingTarget || !!deletingTarget || item.status !== 'ready'}}" bindchange="chooseSourcePosition">
          <view class="asset-position-option ui-pressable">{{['自动分散到素材附近', '素材前面', '素材中间', '素材后面'][item.inlinePositionIndex]}}<text aria-hidden="true">›</text></view>
        </picker>
        <picker wx:if="{{chapterOptions.length}}" range="{{chapterOptions}}" range-key="label" data-id="{{item.id}}"
          disabled="{{!!placingTarget || !!deletingTarget || item.status !== 'ready'}}" bindchange="placeInChapter">
          <view class="asset-position-option ui-pressable">放到章节开头<text aria-hidden="true">›</text></view>
        </picker>
        <button class="asset-position-option ui-button" data-id="{{item.id}}" disabled="{{!!placingTarget || !!deletingTarget || item.status !== 'ready'}}" bindtap="placeInAppendix">
          <view>书末相册<text class="asset-position-hint">集中放在全书最后</text></view><text aria-hidden="true">›</text>
        </button>
      </view>
    </view>
  </view>

  <text wx:if="{{videos.length}}" class="asset-section-title video-section-title">视频</text>
  <view wx:if="{{videos.length}}" class="asset-list">
    <view
      wx:for="{{videos}}"
      wx:key="id"
      class="asset-card ui-pressable"
      data-id="{{item.id}}"
      aria-role="button"
      aria-label="播放{{item.isCurrent ? '' : '旧版'}}{{item.title}}"
      bindtap="previewVideo"
    >
      <view class="asset-main">
        <view class="asset-thumb video-thumb">
          <view class="asset-placeholder">
            <text>视频</text>
            <text class="asset-placeholder-hint">点按播放</text>
          </view>
        </view>
        <view class="asset-copy">
          <view class="asset-title-row">
            <text class="asset-title">{{item.title}}</text>
            <text class="asset-status {{item.isCurrent ? 'included' : 'outdated'}}">{{item.isCurrent ? '可预览' : '旧版视频'}}</text>
          </view>
          <text class="asset-meta">分享视频</text>
          <text class="asset-source">{{item.detail}}</text>
          <text wx:if="{{!item.isCurrent}}" class="asset-placement">讲述内容已变化，重新制作后再分享</text>
          <text class="asset-placement">{{previewingVideoId === item.id ? "加载中" : "播放视频 ›"}}</text>
        </view>
      </view>
      <button wx:if="{{!item.isCurrent}}" class="action-button primary-action video-remake-button" data-id="{{item.id}}" catchtap="remakeVideo">重新制作</button>
    </view>
  </view>

  <view class="bottom-spacer"></view>
</view>
