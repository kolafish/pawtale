<view class="image-assets-page ui-page-shell">
  <view class="ui-page-context-row">
    <text class="ui-page-context">统一管理生成图片，选择可入书的插图</text>
  </view>

  <view wx:if="{{error}}" class="error ui-error-banner">{{error}}</view>

  <view class="summary-card">
    <view class="summary-item">
      <text class="summary-value">{{total}}</text>
      <text class="summary-label">全部图片</text>
    </view>
    <view class="summary-item">
      <text class="summary-value">{{includedCount}}</text>
      <text class="summary-label">已入书</text>
    </view>
    <view class="summary-item">
      <text class="summary-value">{{unusedCount}}</text>
      <text class="summary-label">待选择</text>
    </view>
  </view>

  <view wx:if="{{loading && !items.length}}" class="empty-card">
    <text class="empty-title">正在同步图片素材</text>
    <text class="empty-copy">生成过的分享视频背景会自动收集到这里。</text>
  </view>

  <view wx:elif="{{!items.length}}" class="empty-card">
    <text class="empty-title">还没有图片素材</text>
    <text class="empty-copy">之后生成分享视频背景、章节插图或封面候选时，会自动出现在这里。</text>
  </view>

  <view wx:else class="asset-list">
    <view wx:for="{{items}}" wx:key="id" class="asset-card">
      <view class="asset-main">
        <view class="asset-thumb" data-id="{{item.id}}" bindtap="previewAsset">
          <image wx:if="{{item.localPath}}" class="asset-image" src="{{item.localPath}}" mode="aspectFill" />
          <view wx:else class="asset-placeholder">
            <text>图片</text>
          </view>
        </view>
        <view class="asset-copy">
          <view class="asset-title-row">
            <text class="asset-title">{{item.titleText}}</text>
            <text class="asset-status {{item.include_in_book ? 'included' : ''}}">{{item.statusText}}</text>
          </view>
          <text class="asset-meta">{{item.sourceLabel}} · {{item.createdAtText}}</text>
          <text class="asset-placement">{{item.placementText}}</text>
          <text wx:if="{{item.source_quote}}" class="asset-source">来源：{{item.source_quote}}</text>
        </view>
      </view>

      <view wx:if="{{item.detailsExpanded}}" class="caption-box">
        <text class="caption-label">图片说明</text>
        <textarea
          class="caption-input"
          value="{{item.captionDraft}}"
          data-id="{{item.id}}"
          maxlength="500"
          auto-height
          placeholder="写一句会放进书里的图片说明"
          bindinput="onCaptionInput"
        />
        <button
          class="minor-button"
          data-id="{{item.id}}"
          loading="{{savingTarget === item.id}}"
          disabled="{{savingTarget === item.id || !item.captionChanged}}"
          bindtap="saveCaption"
        >
          {{item.captionChanged ? "保存说明" : "说明已保存"}}
        </button>

        <view class="asset-secondary-actions">
          <button
            class="action-button danger"
            data-id="{{item.id}}"
            loading="{{deletingTarget === item.id}}"
            disabled="{{deletingTarget === item.id}}"
            bindtap="deleteAsset"
          >
            删除图片素材
          </button>
        </view>
      </view>

      <view class="asset-actions">
        <button
          wx:if="{{item.source_utterance_id}}"
          class="action-button primary-action"
          data-id="{{item.id}}"
          loading="{{placingTarget === item.id}}"
          disabled="{{placingTarget === item.id || item.status !== 'ready'}}"
          bindtap="placeNearSource"
        >
          放在素材附近
        </button>
        <picker
          wx:if="{{chapterOptions.length}}"
          range="{{chapterOptions}}"
          range-key="label"
          data-id="{{item.id}}"
          disabled="{{placingTarget === item.id || item.status !== 'ready'}}"
          bindchange="placeInChapter"
        >
          <view class="action-button {{!item.source_utterance_id ? 'primary-action' : ''}} {{placingTarget === item.id || item.status !== 'ready' ? 'disabled' : ''}}">
            {{item.source_utterance_id ? "放到章节开头" : "放入章节"}}
          </view>
        </picker>
        <button
          wx:if="{{!item.source_utterance_id}}"
          class="action-button"
          data-id="{{item.id}}"
          loading="{{placingTarget === item.id}}"
          disabled="{{placingTarget === item.id || item.status !== 'ready'}}"
          bindtap="placeInAppendix"
        >
          加入图录
        </button>
        <button
          wx:if="{{item.enabledPlacements.length}}"
          class="action-button"
          data-id="{{item.id}}"
          loading="{{placingTarget === item.id}}"
          disabled="{{placingTarget === item.id}}"
          bindtap="removeFromBook"
        >
          移出书稿
        </button>
      </view>

      <view
        class="asset-details-toggle ui-block-action ui-pressable"
        data-id="{{item.id}}"
        aria-role="button"
        aria-expanded="{{item.detailsExpanded}}"
        bindtap="toggleAssetDetails"
      >
        {{item.detailsExpanded ? "收起图片说明与更多操作" : "编辑图片说明与更多操作"}}
      </view>
    </view>
  </view>

  <view class="bottom-spacer"></view>
</view>
