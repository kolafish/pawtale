.transcripts-page {
  padding: 28rpx var(--ui-page-inline) 120rpx;
}

.search-panel,
.error {
  margin-bottom: 24rpx;
}

.search-box {
  min-height: 88rpx;
  padding: 0 10rpx 0 22rpx;
  border-radius: var(--ui-radius-card);
  background: var(--ui-surface);
  box-shadow: var(--ui-control-shadow);
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.search-mark {
  flex: 0 0 auto;
  color: var(--ui-accent);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.search-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 88rpx;
  color: var(--ui-text-primary);
  font-size: var(--ui-font-action);
  line-height: 88rpx;
}

.search-clear,
.voice-search-button {
  flex: 0 0 auto;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  color: var(--ui-accent-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--ui-font-action);
  font-weight: 700;
  line-height: 1;
  transition-property: transform, opacity, background-color;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.search-clear {
  width: 88rpx;
  max-width: 88rpx;
  padding: 0;
}

.voice-search-button {
  width: 116rpx;
  min-width: 116rpx;
  max-width: 116rpx;
  padding: 0 10rpx;
  gap: 6rpx;
  background: transparent;
  white-space: nowrap;
}

.voice-search-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.72;
}

.voice-search-button.recording {
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
}

.voice-search-button[disabled] {
  background: var(--ui-surface-subtle);
  color: var(--ui-text-muted);
}

.search-control-hover {
  opacity: 0.78;
  transform: scale(0.96);
}

.search-chips {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.search-chip {
  max-width: 100%;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--ui-surface-subtle);
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-caption);
  font-weight: 700;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.search-summary {
  display: block;
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  text-wrap: pretty;
}

.voice-search-status {
  color: var(--ui-accent-strong);
  font-weight: 700;
}

.empty-panel,
.transcript-swipe-row {
  margin-top: 24rpx;
}

.empty-panel {
  padding: 48rpx 34rpx;
  color: var(--ui-text-secondary);
  font-size: 30rpx;
  line-height: 1.55;
}

.empty-title,
.empty-copy,
.record-meta,
.record-title,
.summary-preview {
  display: block;
}

.empty-title,
.record-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-weight: 700;
  text-wrap: balance;
}

.empty-title {
  font-size: 36rpx;
  line-height: 1.4;
}

.empty-copy {
  margin-top: 14rpx;
  text-wrap: pretty;
}

.login-button,
.empty-secondary-button,
.load-more {
  position: relative;
  width: 100%;
  min-height: 88rpx;
  margin-top: 26rpx;
  padding: 14rpx 64rpx 14rpx 22rpx;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  box-shadow: var(--ui-control-shadow);
  display: flex;
  align-items: center;
  justify-content: flex-start;
  font-size: var(--ui-font-action);
  font-weight: 700;
  line-height: 1.4;
  text-align: left;
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.login-button::after,
.empty-secondary-button::after,
.load-more::after {
  content: "›";
  position: absolute;
  top: 50%;
  right: 24rpx;
  color: var(--ui-accent);
  font-size: 38rpx;
  font-weight: 400;
  transform: translateY(-52%);
}

.empty-secondary-button-hover {
  background: var(--ui-accent-surface-subtle);
  transform: scale(0.96);
}

.transcript-swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: var(--ui-radius-card);
  box-shadow: var(--ui-card-shadow);
}

.swipe-delete {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  width: 144rpx;
  min-width: 144rpx;
  max-width: 144rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.swipe-delete[disabled] {
  opacity: 0.6;
}

.transcript-card {
  position: relative;
  padding: 24rpx 28rpx 22rpx;
  border-radius: 0;
  box-shadow: none;
  transition-property: background-color, transform;
  transition-duration: 180ms;
  transition-timing-function: ease-out;
}

.transcript-swipe-row.is-swiped .transcript-card {
  transform: translateX(-144rpx);
}

.transcript-card-hover {
  background: var(--ui-surface-soft);
}

.transcript-swipe-row.highlighted {
  box-shadow:
    0 0 0 2rpx var(--ui-accent-border),
    var(--ui-card-shadow-raised);
}

.transcript-card.recovery-pending {
  background: var(--ui-surface);
}

.record-meta {
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  line-height: 1.45;
  overflow-wrap: anywhere;
  font-variant-numeric: tabular-nums;
}

.record-title {
  margin-top: 6rpx;
  font-size: 32rpx;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.summary-preview {
  margin-top: 10rpx;
  color: var(--ui-value-text);
  font-size: var(--ui-font-body);
  line-height: 1.55;
  overflow-wrap: anywhere;
  text-wrap: pretty;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.search-hit-true {
  background: var(--ui-warning-surface);
  color: var(--ui-text-primary);
  font-weight: 700;
}

.recovery-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.small-primary {
  flex: 0 0 auto;
  min-width: 220rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 0;
  border-radius: var(--ui-radius-control);
  background: var(--ui-accent);
  color: var(--ui-on-accent);
  box-shadow:
    0 0 0 1rpx rgba(148, 69, 53, 0.12),
    0 6rpx 14rpx rgba(148, 69, 53, 0.14);
  font-size: var(--ui-font-body);
  font-weight: 700;
  line-height: var(--ui-line-body);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  white-space: nowrap;
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.small-primary[disabled] {
  opacity: 0.52;
}

.small-primary:active {
  transform: scale(0.96);
}

.record-footer {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.record-status {
  flex: 1 1 auto;
  min-width: 0;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  font-weight: 500;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.detail-action {
  flex: 0 0 auto;
  color: var(--ui-accent-strong);
  font-size: 38rpx;
  font-weight: 400;
  line-height: 1;
  white-space: nowrap;
  transform: translateY(-2rpx);
}

.load-more {
  margin-top: 28rpx;
}

.bottom-spacer {
  height: 20rpx;
}

.transcripts-page.large-text {
  padding: 28rpx 24rpx 120rpx;
}

.transcripts-page.large-text .search-summary,
.transcripts-page.large-text .record-meta {
  font-size: var(--ui-font-large-body);
  line-height: 1.5;
}

.transcripts-page.large-text .search-box,
.transcripts-page.large-text .search-input,
.transcripts-page.large-text .search-clear,
.transcripts-page.large-text .voice-search-button {
  min-height: 96rpx;
}

.transcripts-page.large-text .search-input {
  height: 96rpx;
  font-size: var(--ui-font-large-list-title);
  line-height: 96rpx;
}

.transcripts-page.large-text .voice-search-button {
  width: 142rpx;
  min-width: 142rpx;
  max-width: 142rpx;
}

.transcripts-page.large-text .search-chip,
.transcripts-page.large-text .record-status {
  font-size: var(--ui-font-large-meta);
}

.transcripts-page.large-text .detail-action {
  font-size: 42rpx;
}

.transcripts-page.large-text .record-title,
.transcripts-page.large-text .empty-title {
  font-size: 40rpx;
  line-height: 1.45;
}

.transcripts-page.large-text .summary-preview,
.transcripts-page.large-text .empty-copy,
.transcripts-page.large-text .empty-panel {
  font-size: 34rpx;
  line-height: 1.7;
}

.transcripts-page.large-text .small-primary,
.transcripts-page.large-text .load-more,
.transcripts-page.large-text .login-button,
.transcripts-page.large-text .empty-secondary-button {
  min-height: 96rpx;
  font-size: var(--ui-font-large-body);
}
