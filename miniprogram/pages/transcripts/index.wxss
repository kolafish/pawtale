.transcripts-page {
  min-height: 100vh;
  padding: 44rpx 36rpx 120rpx;
  background: #fffaf2;
}

.top-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 28rpx;
}

.back-hit {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-mark {
  color: #9f4a3c;
  font-size: 72rpx;
  line-height: 1;
}

.title-block {
  min-width: 0;
}

.page-title {
  display: block;
  color: #24100b;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}

.page-meta {
  display: block;
  margin-top: 8rpx;
  color: #685b55;
  font-size: 26rpx;
  line-height: 1.35;
}

.error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff1f2;
  color: #b4234a;
  font-size: 28rpx;
  line-height: 1.45;
  word-break: break-word;
}

.empty-panel,
.transcript-card {
  margin-top: 24rpx;
  border: 2rpx solid #f0dac0;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 28rpx rgba(64, 43, 24, 0.06);
}

.empty-panel {
  padding: 48rpx 34rpx;
  color: #685b55;
  font-size: 30rpx;
  line-height: 1.5;
}

.empty-title {
  display: block;
  color: #24100b;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-copy {
  display: block;
  margin-top: 14rpx;
}

.guest-panel .empty-copy {
  line-height: 1.5;
}

.login-button {
  width: 100%;
  height: 84rpx;
  margin: 28rpx 0 0;
  border: 0;
  border-radius: 20rpx;
  background: #9f4a3c;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
}

.login-button::after {
  border: 0;
}

.transcript-card {
  padding: 30rpx;
}

.record-head,
.section-head,
.actions-row {
  display: flex;
  align-items: center;
}

.record-head {
  justify-content: space-between;
  gap: 22rpx;
}

.record-title {
  display: block;
  color: #24100b;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
}

.record-project {
  display: block;
  margin-top: 8rpx;
  color: #7a3b31;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
}

.record-meta {
  display: block;
  margin-top: 10rpx;
  color: #685b55;
  font-size: 24rpx;
  line-height: 1.35;
}

.book-status {
  display: inline-flex;
  max-width: 100%;
  margin-top: 12rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #fff8ef;
  color: #7a6255;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-word;
}

.book-status.included {
  background: #fff1ec;
  color: #8a4034;
}

.record-count {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #fff1ec;
  color: #9f4a3c;
  font-size: 24rpx;
  font-weight: 800;
}

.question-box,
.raw-box,
.display-box,
.edit-box {
  margin-top: 26rpx;
}

.section-head {
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 14rpx;
}

.section-title {
  color: #7a3b31;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.section-count {
  color: #9f4a3c;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
}

.question-text,
.raw-text,
.display-text {
  display: block;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  color: #3a2119;
  font-size: 28rpx;
  line-height: 1.55;
  word-break: break-word;
}

.question-text {
  background: #fffaf2;
  border: 2rpx solid #f0dac0;
}

.raw-text {
  background: #fff6f1;
}

.display-text {
  background: #ffffff;
  border: 2rpx solid #f0dac0;
}

.transcript-textarea {
  width: 100%;
  min-height: 180rpx;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  border: 2rpx solid #efd6c4;
  border-radius: 18rpx;
  background: #ffffff;
  color: #24100b;
  font-size: 30rpx;
  line-height: 1.55;
}

.actions-row {
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 26rpx;
}

.ghost-button,
.danger-button,
.small-primary,
.load-more {
  min-width: 148rpx;
  height: 76rpx;
  margin: 0;
  border: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
}

.ghost-button,
.danger-button,
.small-primary {
  flex: 1 1 148rpx;
}

.ghost-button::after,
.danger-button::after,
.small-primary::after,
.load-more::after {
  border: 0;
}

.ghost-button {
  background: #fff1ec;
  color: #8a4034;
}

.small-primary {
  background: #9f4a3c;
  color: #ffffff;
}

.danger-button {
  background: #fff1f2;
  color: #b4234a;
}

.ghost-button[disabled],
.danger-button[disabled],
.small-primary[disabled],
.load-more[disabled] {
  opacity: 0.62;
}

.load-more {
  width: 100%;
  margin-top: 28rpx;
  background: #ffffff;
  color: #9f4a3c;
  box-shadow: 0 8rpx 22rpx rgba(64, 43, 24, 0.08);
}

.bottom-spacer {
  height: 20rpx;
}
