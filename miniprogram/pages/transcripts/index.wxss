.transcripts-page {
  min-height: 100vh;
  padding: 28rpx 32rpx 120rpx;
  background: var(--ui-page-background);
}

.search-panel {
  margin-bottom: 24rpx;
}

.search-box {
  min-height: 84rpx;
  box-sizing: border-box;
  padding: 0 16rpx 0 24rpx;
  border: 1rpx solid var(--ui-border);
  border-radius: 22rpx;
  background: var(--ui-surface);
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.search-mark {
  flex: 0 0 auto;
  color: var(--ui-accent);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
}

.search-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 80rpx;
  color: var(--ui-text-primary);
  font-size: 28rpx;
  line-height: 80rpx;
}

.search-clear {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 80rpx;
  min-width: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--ui-accent-surface);
  color: var(--ui-accent-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1;
  transition: transform 150ms ease-out, opacity 150ms ease-out;
}

.search-clear::after {
  border: 0;
}

.voice-search-button {
  flex: 0 0 132rpx;
  width: 132rpx;
  min-width: 0;
  height: 80rpx;
  min-height: 44px;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 16rpx;
  background: var(--ui-accent);
  color: var(--ui-on-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  transition: transform 150ms ease-out, opacity 150ms ease-out;
}

.voice-search-button.recording {
  background: var(--ui-danger-text);
}

.voice-search-button[disabled] {
  background: var(--ui-switch-off);
  color: rgba(255, 255, 255, 0.86);
}

.voice-search-button::after {
  border: 0;
}

.search-control-hover {
  opacity: 0.86;
  transform: scale(0.96);
}

.search-chips {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.search-chip {
  max-width: 100%;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--ui-surface-subtle);
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-word;
}

.search-summary {
  display: block;
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  line-height: 1.35;
}

.voice-search-status {
  color: var(--ui-accent);
  font-weight: 800;
}

.error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
  font-size: 28rpx;
  line-height: 1.45;
  word-break: break-word;
}

.empty-panel,
.transcript-card {
  margin-top: 24rpx;
  border: 1rpx solid var(--ui-border);
  border-radius: 24rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow);
}

.empty-panel {
  padding: 48rpx 34rpx;
  color: var(--ui-text-secondary);
  font-size: 30rpx;
  line-height: 1.5;
}

.empty-title {
  display: block;
  color: var(--ui-text-primary);
  font-size: 34rpx;
  font-weight: 700;
}

.empty-copy {
  display: block;
  margin-top: 14rpx;
}

.guest-panel .empty-copy {
  line-height: 1.5;
}

.login-button {
  width: 100%;
  height: 84rpx;
  margin: 28rpx 0 0;
  border: 0;
  border-radius: 20rpx;
  background: var(--ui-accent);
  color: var(--ui-on-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
}

.login-button::after,
.empty-secondary-button::after {
  border: 0;
}

.transcript-card {
  padding: 30rpx;
  transition-property: transform, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.transcript-card-hover {
  background: var(--ui-surface);
  transform: scale(0.985);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.05);
}

.transcript-card.highlighted {
  border-color: var(--ui-accent);
  box-shadow: 0 12rpx 30rpx rgba(168, 79, 67, 0.14);
}

.transcript-card.recovery-pending {
  border-color: var(--ui-accent-border);
  background: var(--ui-surface);
}

.record-title {
  display: block;
  margin-top: 10rpx;
  color: var(--ui-text-primary);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 50rpx;
  word-break: break-word;
}

.record-meta {
  display: block;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 1.4;
  word-break: break-word;
}

.book-status {
  display: inline-flex;
  flex: 0 1 auto;
  max-width: 100%;
  color: var(--ui-warning-text);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 38rpx;
  word-break: break-word;
}

.book-status.included {
  color: var(--ui-success-text);
}

.book-status.pending {
  color: var(--ui-text-secondary);
}

.summary-preview {
  display: block;
  margin-top: 16rpx;
  color: var(--ui-text-primary);
  font-size: 28rpx;
  line-height: 46rpx;
  word-break: break-word;
}

.search-hit-true {
  background: var(--ui-warning-surface);
  color: var(--ui-text-primary);
  font-weight: 800;
}

.recovery-row {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: var(--ui-surface-subtle);
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.recovery-notice {
  flex: 1 1 auto;
  min-width: 0;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 38rpx;
}

.small-primary,
.load-more {
  min-width: 0;
  height: 80rpx;
  min-height: 40px;
  margin: 0;
  padding: 0 12rpx;
  border: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.small-primary {
  flex: 0 0 auto;
  min-width: 168rpx;
  padding: 0 22rpx;
}

.small-primary::after,
.load-more::after {
  border: 0;
}

.small-primary {
  background: var(--ui-accent);
  color: var(--ui-on-accent);
}

.record-footer {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--ui-divider);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.detail-action {
  flex: 0 0 auto;
  color: var(--ui-accent);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 38rpx;
  white-space: nowrap;
}

.empty-secondary-button {
  width: 100%;
  min-height: 84rpx;
  margin: 26rpx 0 0;
  padding: 16rpx 28rpx;
  border: 0;
  border-radius: 20rpx;
  background: var(--ui-surface-subtle);
  color: var(--ui-accent-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-align: center;
  white-space: nowrap;
  transition: transform 150ms ease-out, background-color 150ms ease-out;
}

.empty-secondary-button-hover {
  background: var(--ui-border);
  transform: scale(0.96);
}

.small-primary[disabled],
.load-more[disabled] {
  opacity: 0.62;
}

.load-more {
  width: 100%;
  margin-top: 28rpx;
  background: var(--ui-surface);
  color: var(--ui-accent);
  box-shadow: var(--ui-card-shadow);
}

.bottom-spacer {
  height: 20rpx;
}

.transcripts-page.large-text {
  padding: 28rpx 24rpx 120rpx;
}

.transcripts-page.large-text .search-summary,
.transcripts-page.large-text .record-meta {
  font-size: 30rpx;
  line-height: 1.45;
}

.transcripts-page.large-text .search-box {
  min-height: 96rpx;
}

.transcripts-page.large-text .search-input {
  height: 92rpx;
  font-size: 32rpx;
  line-height: 92rpx;
}

.transcripts-page.large-text .search-clear,
.transcripts-page.large-text .voice-search-button {
  min-height: 48px;
  font-size: 28rpx;
}

.transcripts-page.large-text .search-chip,
.transcripts-page.large-text .book-status,
.transcripts-page.large-text .detail-action {
  font-size: 28rpx;
  line-height: 40rpx;
}

.transcripts-page.large-text .transcript-card {
  padding: 32rpx 28rpx;
}

.transcripts-page.large-text .record-title,
.transcripts-page.large-text .empty-title {
  font-size: 40rpx;
  line-height: 54rpx;
}

.transcripts-page.large-text .summary-preview,
.transcripts-page.large-text .empty-copy,
.transcripts-page.large-text .empty-panel {
  font-size: 34rpx;
  line-height: 1.65;
}

.transcripts-page.large-text .small-primary,
.transcripts-page.large-text .load-more,
.transcripts-page.large-text .login-button,
.transcripts-page.large-text .empty-secondary-button {
  min-height: 48px;
  font-size: 30rpx;
  line-height: 1.35;
}

.transcripts-page.large-text .recovery-notice {
  font-size: 30rpx;
  line-height: 46rpx;
}
