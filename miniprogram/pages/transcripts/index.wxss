.transcripts-page {
  min-height: 100vh;
  padding: 28rpx 32rpx 120rpx;
  background: #fcf7ed;
}

.search-panel {
  margin-bottom: 24rpx;
}

.search-box {
  min-height: 84rpx;
  box-sizing: border-box;
  padding: 0 16rpx 0 24rpx;
  border: 1rpx solid #e8d8c3;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.search-mark {
  flex: 0 0 auto;
  color: #a64b3e;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
}

.search-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 80rpx;
  color: #3a2a25;
  font-size: 28rpx;
  line-height: 80rpx;
}

.search-clear {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 80rpx;
  min-width: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: #f8e8e2;
  color: #8f3e35;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1;
  transition: transform 150ms ease-out, opacity 150ms ease-out;
}

.search-clear::after {
  border: 0;
}

.voice-search-button {
  flex: 0 0 132rpx;
  width: 132rpx;
  min-width: 0;
  height: 80rpx;
  min-height: 44px;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 16rpx;
  background: #a64b3e;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  transition: transform 150ms ease-out, opacity 150ms ease-out;
}

.voice-search-button.recording {
  background: #b84a5a;
}

.voice-search-button[disabled] {
  background: #d8b7a8;
  color: rgba(255, 255, 255, 0.86);
}

.voice-search-button::after {
  border: 0;
}

.search-control-hover {
  opacity: 0.86;
  transform: scale(0.94);
}

.search-chips {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.search-chip {
  max-width: 100%;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f3efea;
  color: #7a6b60;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-word;
}

.search-summary {
  display: block;
  margin-top: 12rpx;
  color: #7b6f68;
  font-size: 24rpx;
  line-height: 1.35;
}

.voice-search-status {
  color: #a64b3e;
  font-weight: 800;
}

.error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff1f3;
  color: #b84a5a;
  font-size: 28rpx;
  line-height: 1.45;
  word-break: break-word;
}

.empty-panel,
.transcript-card {
  margin-top: 24rpx;
  border: 1rpx solid #e8d8c3;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(93, 61, 42, 0.06);
}

.empty-panel {
  padding: 48rpx 34rpx;
  color: #7b6f68;
  font-size: 30rpx;
  line-height: 1.5;
}

.empty-title {
  display: block;
  color: #2b1713;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-copy {
  display: block;
  margin-top: 14rpx;
}

.guest-panel .empty-copy {
  line-height: 1.5;
}

.login-button {
  width: 100%;
  height: 84rpx;
  margin: 28rpx 0 0;
  border: 0;
  border-radius: 20rpx;
  background: #a64b3e;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
}

.login-button::after,
.empty-secondary-button::after {
  border: 0;
}

.transcript-card {
  padding: 30rpx;
  transition-property: transform, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.transcript-card-hover {
  background: #fffdf9;
  transform: scale(0.985);
  box-shadow: 0 4rpx 14rpx rgba(93, 61, 42, 0.05);
}

.transcript-card.highlighted {
  border-color: #a64b3e;
  box-shadow: 0 12rpx 30rpx rgba(166, 75, 62, 0.14);
}

.transcript-card.recovery-pending {
  border-color: #e6cdb9;
  background: #fffdf9;
}

.record-title {
  display: block;
  margin-top: 10rpx;
  color: #2b1713;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 50rpx;
  word-break: break-word;
}

.record-meta {
  display: block;
  color: #7b6f68;
  font-size: 25rpx;
  line-height: 1.4;
  word-break: break-word;
}

.book-status {
  display: inline-flex;
  flex: 0 1 auto;
  max-width: 100%;
  color: #9a6a24;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 38rpx;
  word-break: break-word;
}

.book-status.included {
  color: #a64b3e;
}

.book-status.pending {
  color: #74675e;
}

.summary-preview {
  display: block;
  margin-top: 16rpx;
  color: #3a2a25;
  font-size: 28rpx;
  line-height: 46rpx;
  word-break: break-word;
}

.search-hit-true {
  background: #ffe7a3;
  color: #2b1713;
  font-weight: 800;
}

.recovery-row {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f8f2e8;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.recovery-notice {
  flex: 1 1 auto;
  min-width: 0;
  color: #6c5c53;
  font-size: 25rpx;
  line-height: 38rpx;
}

.small-primary,
.load-more {
  min-width: 0;
  height: 80rpx;
  min-height: 40px;
  margin: 0;
  padding: 0 12rpx;
  border: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

.small-primary {
  flex: 0 0 auto;
  min-width: 168rpx;
  padding: 0 22rpx;
}

.small-primary::after,
.load-more::after {
  border: 0;
}

.small-primary {
  background: #a64b3e;
  color: #ffffff;
}

.record-footer {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(43, 23, 19, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.detail-action {
  flex: 0 0 auto;
  color: #a64b3e;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 38rpx;
  white-space: nowrap;
}

.empty-secondary-button {
  width: 100%;
  min-height: 84rpx;
  margin: 26rpx 0 0;
  padding: 16rpx 28rpx;
  border: 0;
  border-radius: 20rpx;
  background: #f5eee7;
  color: #8f3e35;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-align: center;
  white-space: nowrap;
  transition: transform 150ms ease-out, background-color 150ms ease-out;
}

.empty-secondary-button-hover {
  background: #ede3da;
  transform: scale(0.96);
}

.small-primary[disabled],
.load-more[disabled] {
  opacity: 0.62;
}

.load-more {
  width: 100%;
  margin-top: 28rpx;
  background: #ffffff;
  color: #a64b3e;
  box-shadow: 0 8rpx 22rpx rgba(64, 43, 24, 0.08);
}

.bottom-spacer {
  height: 20rpx;
}

.transcripts-page.large-text {
  padding: 28rpx 24rpx 120rpx;
}

.transcripts-page.large-text .search-summary,
.transcripts-page.large-text .record-meta {
  font-size: 30rpx;
  line-height: 1.45;
}

.transcripts-page.large-text .search-box {
  min-height: 96rpx;
}

.transcripts-page.large-text .search-input {
  height: 92rpx;
  font-size: 32rpx;
  line-height: 92rpx;
}

.transcripts-page.large-text .search-clear,
.transcripts-page.large-text .voice-search-button {
  min-height: 48px;
  font-size: 28rpx;
}

.transcripts-page.large-text .search-chip,
.transcripts-page.large-text .book-status,
.transcripts-page.large-text .detail-action {
  font-size: 28rpx;
  line-height: 40rpx;
}

.transcripts-page.large-text .transcript-card {
  padding: 32rpx 28rpx;
}

.transcripts-page.large-text .record-title,
.transcripts-page.large-text .empty-title {
  font-size: 40rpx;
  line-height: 54rpx;
}

.transcripts-page.large-text .summary-preview,
.transcripts-page.large-text .empty-copy,
.transcripts-page.large-text .empty-panel {
  font-size: 34rpx;
  line-height: 1.65;
}

.transcripts-page.large-text .small-primary,
.transcripts-page.large-text .load-more,
.transcripts-page.large-text .login-button,
.transcripts-page.large-text .empty-secondary-button {
  min-height: 48px;
  font-size: 30rpx;
  line-height: 1.35;
}

.transcripts-page.large-text .recovery-notice {
  font-size: 30rpx;
  line-height: 46rpx;
}
