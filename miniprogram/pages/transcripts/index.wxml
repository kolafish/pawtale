<view class="ui-page-shell {{pageClass}}">
  <view class="ui-page-context-row">
    <text class="ui-page-context">{{pageMetaText}}</text>
  </view>

  <text wx:if="{{pickForVideo && activeProjectId}}" class="pick-video-hint">选一段讲述，再从里面挑出想做成视频的几句话。</text>

  <view wx:if="{{activeProjectId}}" class="search-panel">
    <view class="search-box">
      <text class="search-mark">⌕</text>
      <input
        class="search-input"
        type="text"
        value="{{searchInput}}"
        placeholder="搜索人名、地点、事件、年份"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <button
        wx:if="{{showSearchClear}}"
        class="search-clear"
        bindtap="clearSearch"
        hover-class="search-control-hover"
        aria-label="清除搜索"
      >×</button>
      <button
        class="{{voiceSearchButtonClass}}"
        bindtap="startVoiceSearch"
        loading="{{voiceSearchTranscribing}}"
        disabled="{{voiceSearchDisabled}}"
        hover-class="search-control-hover"
        aria-label="{{voiceSearchRecording ? '停止语音搜索' : (voiceSearchTranscribing ? '正在识别语音搜索' : '开始语音搜索')}}"
      >
        <image class="voice-search-icon" src="/assets/memoir-microphone.png" mode="aspectFit" aria-hidden="true" />
        <text>{{voiceSearchButtonText}}</text>
      </button>
    </view>
    <view wx:if="{{showSearchChips}}" class="search-chips">
      <text
        wx:for="{{searchChips}}"
        wx:for-item="chip"
        wx:for-index="chipIndex"
        wx:key="chipIndex"
        class="search-chip"
      >{{chip.text}}</text>
    </view>
    <text wx:if="{{hasSearchCriteria}}" class="search-summary">{{searchResultText}}</text>
    <text wx:if="{{voiceSearchStatusText}}" class="search-summary voice-search-status">{{voiceSearchStatusText}}</text>
  </view>

  <view wx:if="{{error}}" class="error ui-error-banner">{{error}}</view>

  <view wx:if="{{needsLogin}}" class="empty-panel guest-panel ui-card">
    <text class="empty-title">浏览讲述记录</text>
    <text class="empty-copy">登录后可以查看语音聊天保存的识别原文、整理文字、音频时长和是否已收录到章节。</text>
    <view
      class="login-button ui-block-action ui-pressable"
      aria-role="button"
      bindtap="openLogin"
    >登录后查看</view>
  </view>

  <view wx:elif="{{showNoProjectPanel}}" class="empty-panel ui-card">
    <text class="empty-title">还没有回忆录</text>
    <text class="empty-copy">先创建一本回忆录，完成语音聊天后，讲述记录会显示在这里。</text>
    <view
      class="login-button ui-block-action ui-pressable"
      aria-role="button"
      bindtap="createProject"
    >创建回忆录</view>
  </view>

  <view wx:elif="{{showLoadingEmpty}}" class="empty-panel ui-card">
    <text>{{loadingEmptyText}}</text>
  </view>

  <view wx:elif="{{showSearchEmpty}}" class="empty-panel ui-card">
    <text class="empty-title">没有找到相关记录</text>
    <text class="empty-copy">没有匹配“{{searchDisplayText}}”的讲述记录。</text>
    <view
      class="empty-secondary-button ui-block-action"
      bindtap="clearSearch"
      hover-class="empty-secondary-button-hover"
      aria-role="button"
    >清除搜索，查看全部</view>
  </view>

  <view wx:elif="{{showGenericEmpty}}" class="empty-panel ui-card">
    <text class="empty-title">暂无讲述记录</text>
    <text class="empty-copy">完成一次语音聊天后，保存的语音和文字会显示在这里。</text>
  </view>

  <view
    wx:for="{{items}}"
    wx:key="id"
    id="{{item.anchorId}}"
    class="transcript-swipe-row {{openSwipeId === item.id ? 'is-swiped' : ''}} {{highlightedId === item.id ? 'highlighted' : ''}}"
    data-id="{{item.id}}"
    bindtouchstart="onCardTouchStart"
    bindtouchend="onCardTouchEnd"
    bindtouchcancel="onCardTouchCancel"
  >
    <button
      class="swipe-delete"
      data-id="{{item.id}}"
      catchtap="deleteTranscript"
      disabled="{{deletingId !== '' || openSwipeId !== item.id}}"
      aria-hidden="{{openSwipeId !== item.id}}"
      aria-label="删除{{item.summaryTitleText}}"
    ><text>删除</text></button>
    <view
      class="{{item.cardClass}} ui-card"
      data-id="{{item.id}}"
      bindtap="openTranscriptDetail"
      hover-class="transcript-card-hover"
      aria-role="button"
      aria-label="{{item.cardAriaLabel}}"
    >
      <text class="record-meta">{{item.recordMetaText}}</text>
      <text class="record-title">{{item.summaryTitleText}}</text>

      <text class="summary-preview">
        <text
          wx:for="{{item.summarySegments}}"
          wx:for-item="segment"
          wx:for-index="segmentIndex"
          wx:key="segmentIndex"
          class="search-hit-{{segment.highlight}}"
        >{{segment.text}}</text>
      </text>

      <view
        wx:if="{{item.canRecoverTranscription}}"
        class="recovery-row"
        catchtap="stopCardTap"
      >
        <button
          class="small-primary"
          data-id="{{item.id}}"
          catchtap="recoverTranscript"
          loading="{{item.recoverButtonLoading}}"
          disabled="{{item.recoverButtonDisabled}}"
        >
          <text>{{item.recoverButtonText}}</text>
        </button>
      </view>
      <view class="record-footer">
        <text class="record-status">{{item.storyStatusText}}</text>
        <text class="detail-action" aria-hidden="true">›</text>
      </view>
    </view>
  </view>

  <view
    wx:if="{{showLoadMore}}"
    class="load-more ui-block-action ui-pressable {{loading ? 'is-disabled' : ''}}"
    aria-role="button"
    aria-disabled="{{loading}}"
    bindtap="loadMore"
  >
    {{loading ? "正在加载…" : "加载更多"}}
  </view>

  <view class="bottom-spacer"></view>
</view>
