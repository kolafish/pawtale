<view class="transcripts-page">
  <view class="top-row">
    <view class="back-hit" bindtap="openHome">
      <text class="back-mark">‹</text>
    </view>
    <view class="title-block">
      <text class="page-title">讲述记录</text>
      <text class="page-meta">{{pageMetaText}}</text>
    </view>
  </view>

  <view wx:if="{{activeProjectId}}" class="search-panel">
    <view class="search-box">
      <text class="search-mark">⌕</text>
      <input
        class="search-input"
        type="text"
        value="{{searchInput}}"
        placeholder="搜索人名、地点、事件、年份"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <button wx:if="{{showSearchClear}}" class="search-clear" bindtap="clearSearch">×</button>
      <button
        class="{{voiceSearchButtonClass}}"
        bindtap="startVoiceSearch"
        loading="{{voiceSearchTranscribing}}"
        disabled="{{voiceSearchDisabled}}"
      >
        {{voiceSearchButtonText}}
      </button>
    </view>
    <view wx:if="{{showSearchChips}}" class="search-chips">
      <text
        wx:for="{{searchChips}}"
        wx:for-item="chip"
        wx:for-index="chipIndex"
        wx:key="chipIndex"
        class="search-chip"
      >{{chip.text}}</text>
    </view>
    <text wx:if="{{hasSearchCriteria}}" class="search-summary">{{searchResultText}}</text>
    <text wx:if="{{voiceSearchStatusText}}" class="search-summary voice-search-status">{{voiceSearchStatusText}}</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view wx:if="{{needsLogin}}" class="empty-panel guest-panel">
    <text class="empty-title">浏览讲述记录</text>
    <text class="empty-copy">登录后可以查看语音聊天保存的识别原文、整理文字、音频时长和是否已收录到章节。</text>
    <button class="login-button" bindtap="openLogin">登录后查看</button>
  </view>

  <view wx:elif="{{showNoProjectPanel}}" class="empty-panel">
    <text class="empty-title">还没有回忆录</text>
    <text class="empty-copy">先创建一本回忆录，完成语音聊天后，讲述记录会显示在这里。</text>
    <button class="login-button" bindtap="createProject">创建回忆录</button>
  </view>

  <view wx:elif="{{showLoadingEmpty}}" class="empty-panel">
    <text>{{loadingEmptyText}}</text>
  </view>

  <view wx:elif="{{showSearchEmpty}}" class="empty-panel">
    <text class="empty-title">没有找到相关记录</text>
    <text class="empty-copy">没有匹配“{{searchDisplayText}}”的讲述记录。</text>
  </view>

  <view wx:elif="{{showGenericEmpty}}" class="empty-panel">
    <text class="empty-title">暂无讲述记录</text>
    <text class="empty-copy">完成一次语音聊天后，保存的语音和文字会显示在这里。</text>
  </view>

  <view
    wx:for="{{items}}"
    wx:key="id"
    id="{{item.anchorId}}"
    class="{{item.cardClass}}"
    data-id="{{item.id}}"
    bindtap="openTranscriptDetail"
  >
    <view class="record-head">
      <view class="record-main">
        <text class="record-title">{{item.summaryTitleText}}</text>
        <text class="record-meta">{{item.recordMetaText}}</text>
        <text wx:if="{{item.transcriptionStatusText}}" class="transcription-status">{{item.transcriptionStatusText}}</text>
        <text class="{{item.bookStatusClass}}">{{item.bookInclusionText}}</text>
      </view>
      <text class="{{item.recordCountClass}}">{{item.recordCountText}}</text>
    </view>

    <text class="summary-preview">
      <text
        wx:for="{{item.summarySegments}}"
        wx:for-item="segment"
        wx:for-index="segmentIndex"
        wx:key="segmentIndex"
        class="search-hit-{{segment.highlight}}"
      >{{segment.text}}</text>
    </text>

    <view class="actions-row list-actions" catchtap="stopCardTap">
      <button
        class="danger-button"
        data-id="{{item.id}}"
        catchtap="deleteTranscript"
        loading="{{item.deleteButtonLoading}}"
        disabled="{{item.deleteButtonDisabled}}"
      >
        {{item.deleteButtonText}}
      </button>
      <button
        wx:if="{{item.needsBookPlanConfirmation}}"
        class="small-primary"
        catchtap="openBook"
      >
        先确认章节
      </button>
      <picker
        wx:if="{{!item.canRecoverTranscription && item.canAssignChapterSource}}"
        class="chapter-move-picker"
        range="{{item.chapterAssignOptions}}"
        range-key="label"
        data-id="{{item.id}}"
        disabled="{{item.assignPickerDisabled}}"
        bindchange="assignTranscriptChapter"
        catchtap="stopCardTap"
      >
        <view class="{{item.assignPickerActionClass}}">
          {{item.assignPickerText}}
        </view>
      </picker>
      <button
        wx:if="{{item.canRecoverTranscription}}"
        class="small-primary"
        data-id="{{item.id}}"
        catchtap="recoverTranscript"
        loading="{{item.recoverButtonLoading}}"
        disabled="{{item.recoverButtonDisabled}}"
      >
        {{item.recoverButtonText}}
      </button>
      <button
        wx:if="{{!item.canRecoverTranscription}}"
        class="small-primary"
        data-id="{{item.id}}"
        catchtap="openTranscriptEdit"
        disabled="{{item.editButtonDisabled}}"
      >
        编辑整理文字
      </button>
    </view>
  </view>

  <button
    wx:if="{{showLoadMore}}"
    class="load-more"
    loading="{{loading}}"
    disabled="{{loading}}"
    bindtap="loadMore"
  >
    加载更多
  </button>

  <view class="bottom-spacer"></view>
</view>
