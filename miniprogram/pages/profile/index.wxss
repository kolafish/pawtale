.profile-page {
  min-height: 100vh;
  padding: 58rpx 36rpx 190rpx;
  background: #fffaf2;
}

.profile-head {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.avatar-mark {
  width: 136rpx;
  height: 136rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border: 4rpx solid #f0cfa8;
  border-radius: 50%;
  background: #fff7ea;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 136rpx;
  overflow: hidden;
}

.avatar-mark::after {
  border: 0;
}

.avatar-logo {
  width: 92rpx;
  height: 92rpx;
}

.avatar-photo {
  width: 136rpx;
  height: 136rpx;
}

.profile-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 12rpx;
}

.profile-name-input {
  width: 100%;
  height: 58rpx;
  min-height: 58rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: #24100b;
  font-size: 50rpx;
  font-weight: 900;
  line-height: 1.15;
}

.profile-note {
  color: #70625d;
  font-size: 28rpx;
  line-height: 1.45;
}

.profile-save-action {
  width: 184rpx;
  height: 64rpx;
  margin: 6rpx 0 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 18rpx;
  background: #128577;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
}

.profile-save-action::after {
  border: 0;
}

.error {
  margin-top: 28rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff1f2;
  color: #b4234a;
  font-size: 28rpx;
  line-height: 1.45;
}

.summary-panel,
.login-panel,
.settings-panel {
  margin-top: 34rpx;
  padding: 32rpx;
  border: 2rpx solid #f0dac0;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 18rpx 44rpx rgba(64, 43, 24, 0.08);
}

.summary-panel {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  text-align: center;
}

.login-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.login-main {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 12rpx;
}

.login-status {
  color: #b4234a;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.25;
}

.login-status-ready {
  color: #128577;
}

.login-action {
  min-width: 176rpx;
  height: 72rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 0;
  border-radius: 18rpx;
  background: #128577;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
  flex: 0 0 auto;
}

.login-action::after {
  border: 0;
}

.summary-value {
  color: #128577;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1;
}

.summary-label {
  display: block;
  margin-top: 12rpx;
  color: #70625d;
  font-size: 26rpx;
}

.section-title {
  color: #24100b;
  font-size: 34rpx;
  font-weight: 900;
}

.service-row {
  min-height: 86rpx;
  margin-top: 20rpx;
  border-top: 1rpx solid #eadfce;
  color: #24100b;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 800;
}

.service-main {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 8rpx;
}

.service-note {
  color: #70625d;
  font-size: 24rpx;
  font-weight: 600;
}

.chevron {
  color: #128577;
  font-size: 54rpx;
  line-height: 1;
}
