.profile-page {
  min-height: 100vh;
  padding: 58rpx 36rpx 190rpx;
  background: #fffaf2;
}

.profile-head {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.avatar-mark {
  width: 136rpx;
  height: 136rpx;
  border: 4rpx solid #f0cfa8;
  border-radius: 50%;
  background: #fff7ea;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 136rpx;
}

.profile-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 12rpx;
}

.profile-name {
  color: #24100b;
  font-size: 50rpx;
  font-weight: 900;
  line-height: 1.15;
}

.profile-note {
  color: #70625d;
  font-size: 28rpx;
  line-height: 1.45;
}

.summary-panel,
.settings-panel {
  margin-top: 34rpx;
  padding: 32rpx;
  border: 2rpx solid #f0dac0;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 18rpx 44rpx rgba(64, 43, 24, 0.08);
}

.summary-panel {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  text-align: center;
}

.summary-value {
  color: #128577;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1;
}

.summary-label {
  display: block;
  margin-top: 12rpx;
  color: #70625d;
  font-size: 26rpx;
}

.section-title {
  color: #24100b;
  font-size: 34rpx;
  font-weight: 900;
}

.font-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 26rpx;
}

.font-option {
  min-height: 144rpx;
  border: 2rpx solid #d8eee8;
  border-radius: 20rpx;
  background: #f3fbf8;
  color: #145f57;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.font-option.active {
  border-color: #128577;
  background: #e8f7f3;
}

.font-sample {
  color: #128577;
  font-weight: 900;
  line-height: 1;
}

.font-sample.standard {
  font-size: 34rpx;
}

.font-sample.large {
  font-size: 44rpx;
}

.font-sample.extra {
  font-size: 54rpx;
}

.service-row {
  min-height: 86rpx;
  margin-top: 20rpx;
  border-top: 1rpx solid #eadfce;
  color: #24100b;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 800;
}

.chevron {
  color: #128577;
  font-size: 54rpx;
  line-height: 1;
}
