<view class="profile-page">
  <view class="profile-head">
    <button class="avatar-mark" open-type="chooseAvatar" bindchooseavatar="chooseAvatar">
      <image
        class="avatar-logo {{avatarDraftUrl || avatarUrl ? 'avatar-photo' : ''}}"
        src="{{avatarDraftUrl || avatarUrl || '/assets/memoir-gramophone.png'}}"
        mode="aspectFill"
      />
      <text wx:if="{{!avatarDraftUrl && !avatarUrl}}" class="avatar-hint">头像</text>
    </button>
    <view class="profile-copy">
      <input
        class="profile-name-input"
        type="nickname"
        value="{{profileNameDraft}}"
        placeholder="点击填写微信昵称"
        placeholder-class="profile-name-placeholder"
        maxlength="24"
        bindinput="onNicknameInput"
        bindblur="onNicknameInput"
      />
      <text class="profile-note">{{activeProjectTitle || "微信用户的回忆录"}}</text>
      <button
        class="profile-save-action"
        bindtap="saveWechatProfile"
        loading="{{syncingProfile}}"
        disabled="{{syncingProfile || loadingIdentity || !canSaveProfile}}"
      >
        {{syncingProfile ? "保存中" : "保存头像昵称"}}
      </button>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="summary-panel">
    <view>
      <text class="summary-value">{{storyCount}}</text>
      <text class="summary-label">故事卡</text>
    </view>
    <view>
      <text class="summary-value">{{progressPercent}}%</text>
      <text class="summary-label">完成度</text>
    </view>
  </view>

  <view class="settings-panel">
    <text class="section-title">服务</text>
    <view class="service-row" bindtap="openProjects">
      <view class="service-main">
        <text>我的回忆录</text>
        <text class="service-note">{{projectCount ? projectCount + " 本" : "加载中"}}</text>
      </view>
      <text class="chevron">›</text>
    </view>
  </view>

  <view class="settings-panel">
    <text class="section-title">朗读设置</text>
    <view class="service-row" bindtap="openTtsVoiceSettings">
      <view class="service-main">
        <text>朗读声音</text>
        <text class="service-note">{{ttsVoiceLabel || "磁性男声"}}</text>
      </view>
      <text class="chevron">›</text>
    </view>
    <view class="service-row" bindtap="openTtsSpeedSettings">
      <view class="service-main">
        <text>朗读倍速</text>
        <text class="service-note">{{ttsSpeedLabel || "1x"}}</text>
      </view>
      <text class="chevron">›</text>
    </view>
  </view>

  <view class="bottom-nav">
    <view class="bottom-nav-item" bindtap="openHome">
      <view class="nav-mark home-mark"></view>
      <text>首页</text>
    </view>
    <view class="bottom-nav-item" bindtap="openWorkbench">
      <view class="nav-mark grid-mark"></view>
      <text>工作台</text>
    </view>
    <view class="bottom-nav-item active">
      <view class="nav-mark user-mark"></view>
      <text>我的</text>
    </view>
  </view>
</view>
