<view class="qa-page">
  <view class="top-bar">
    <text class="page-title">问答记录</text>
    <text class="top-action" bindtap="toggleSelectionMode">{{selectionMode ? "取消" : "选择"}}</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="summary-panel">
    <view class="summary-item">
      <text class="summary-value">{{loading ? "..." : totalCount}}</text>
      <text class="summary-label">已回答</text>
    </view>
    <view class="summary-item warm">
      <text class="summary-value warm-text">{{loading ? "..." : audioCount}}</text>
      <text class="summary-label">含录音</text>
    </view>
  </view>

  <view wx:if="{{selectionMode}}" class="selection-toolbar">
    <text class="selection-count">已选 {{selectedCount}}</text>
    <view class="toolbar-actions">
      <button class="toolbar-button" bindtap="selectAllRecords">
        {{allSelected ? "取消全选" : "全选"}}
      </button>
      <button class="toolbar-button danger" loading="{{deleting}}" disabled="{{!selectedCount || deleting}}" bindtap="deleteSelectedRecords">
        删除
      </button>
    </view>
  </view>

  <view class="qa-list">
    <view class="list-header">
      <text>访谈问答</text>
      <text class="record-count">{{records.length}}</text>
    </view>

    <view wx:if="{{loading}}" class="empty-state">
      <text>正在加载问答记录</text>
    </view>
    <view wx:elif="{{!records.length}}" class="empty-state">
      <text>还没有问答记录。先完成一次访谈，语音和转写文字会整理到这里。</text>
    </view>

    <view wx:for="{{records}}" wx:key="id" class="qa-card {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="openRecord" hover-class="tap-hover">
      <view class="record-meta">
        <text>{{item.sessionTitle}}</text>
        <text>{{item.createdAtText}}</text>
      </view>
      <view class="record-main">
        <view wx:if="{{selectionMode}}" class="select-mark {{item.selected ? 'checked' : ''}}"></view>
        <view class="record-copy">
          <text class="question-text">{{item.question}}</text>
          <text class="answer-preview">{{item.answerPreview || "暂无转写文字"}}</text>
        </view>
      </view>
      <view class="record-footer">
        <text class="audio-pill {{item.hasAudio ? '' : 'muted'}}">{{item.audioLabel}}</text>
        <text wx:if="{{selectionMode && item.selected}}" class="detail-link">已选择</text>
        <text wx:elif="{{selectionMode}}" class="detail-link">选择</text>
        <text wx:else class="detail-link">详情</text>
      </view>
    </view>
  </view>

  <view class="bottom-nav">
    <view class="bottom-nav-item" bindtap="openHome">
      <view class="nav-mark home-mark"></view>
      <text>首页</text>
    </view>
    <view class="bottom-nav-item" bindtap="openWorkbench">
      <view class="nav-mark grid-mark"></view>
      <text>工作台</text>
    </view>
    <view class="bottom-nav-item active">
      <view class="nav-mark chat-mark"></view>
      <text>问答</text>
    </view>
    <view class="bottom-nav-item" bindtap="openProfile">
      <view class="nav-mark user-mark"></view>
      <text>我的</text>
    </view>
  </view>
</view>
