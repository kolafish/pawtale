<view class="qa-page">
  <view class="top-bar">
    <text class="page-title">问答记录</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="summary-panel">
    <view class="summary-item">
      <text class="summary-value">{{loading ? "..." : totalCount}}</text>
      <text class="summary-label">已回答</text>
    </view>
    <view class="summary-item warm">
      <text class="summary-value warm-text">{{loading ? "..." : audioCount}}</text>
      <text class="summary-label">含录音</text>
    </view>
  </view>

  <view class="qa-list">
    <view class="list-header">
      <text>访问问答</text>
      <text class="record-count">{{records.length}}</text>
    </view>

    <view wx:if="{{loading}}" class="empty-state">
      <text>正在加载问答记录</text>
    </view>
    <view wx:elif="{{!records.length}}" class="empty-state">
      <text>还没有问答记录。先完成一次访谈，语音和转写文字会整理到这里。</text>
    </view>

    <view wx:for="{{records}}" wx:key="id" class="qa-card">
      <view class="record-meta">
        <text>{{item.sessionTitle}}</text>
        <text>{{item.createdAtText}}</text>
      </view>
      <text class="question-text">{{item.question}}</text>
      <text class="answer-preview">{{item.transcriptEdited || item.answerPreview || "暂无转写文字"}}</text>

      <view class="record-footer">
        <text class="audio-pill {{item.hasAudio ? '' : 'muted'}}">
          {{item.audioLabel}}
        </text>
        <text class="detail-link" data-id="{{item.id}}" bindtap="toggleRecord">
          {{item.expanded ? "收起" : "查看全文"}}
        </text>
      </view>

      <view wx:if="{{item.expanded}}" class="detail-panel">
        <view wx:if="{{item.detailLoading}}" class="detail-loading">正在加载完整问答</view>
        <view wx:else>
          <text class="detail-label">转写文字</text>
          <text class="detail-text">{{item.transcriptEdited || item.answerPreview || "暂无转写文字"}}</text>

          <view wx:if="{{item.transcriptRaw && item.transcriptRaw !== item.transcriptEdited}}" class="raw-block">
            <text class="detail-label">ASR 原文</text>
            <text class="detail-text muted-text">{{item.transcriptRaw}}</text>
          </view>

          <view class="audio-row">
            <view>
              <text class="detail-label">语音</text>
              <text class="audio-state">{{item.hasAudio ? (item.audioDurationText || "已保存录音") : "未录音"}}</text>
            </view>
            <button
              wx:if="{{item.hasAudio}}"
              class="play-button"
              data-id="{{item.id}}"
              loading="{{item.detailLoading}}"
              bindtap="playAudio"
            >
              {{item.playing ? "停止" : "播放"}}
            </button>
          </view>

          <text wx:if="{{item.audioError}}" class="audio-error">{{item.audioError}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-nav">
    <view class="bottom-nav-item" bindtap="openHome">
      <view class="nav-mark home-mark"></view>
      <text>首页</text>
    </view>
    <view class="bottom-nav-item" bindtap="openWorkbench">
      <view class="nav-mark grid-mark"></view>
      <text>工作台</text>
    </view>
    <view class="bottom-nav-item active">
      <view class="nav-mark chat-mark"></view>
      <text>问答</text>
    </view>
    <view class="bottom-nav-item" bindtap="openProfile">
      <view class="nav-mark user-mark"></view>
      <text>我的</text>
    </view>
  </view>
</view>
