.qa-detail-page {
  min-height: 100vh;
  padding: 32rpx 36rpx 72rpx;
  background: #fffaf2;
}

.top-bar {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.back-hit {
  position: absolute;
  left: -12rpx;
  top: 10rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-mark {
  color: #9f4a3c;
  font-size: 70rpx;
  line-height: 1;
}

.page-title {
  color: #24100b;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.25;
}

.surface {
  margin-top: 30rpx;
  padding: 34rpx 30rpx;
  border: 2rpx solid #f0dac0;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 10rpx 28rpx rgba(64, 43, 24, 0.06);
}

.eyebrow,
.muted,
.detail-label {
  color: #685b55;
  font-size: 26rpx;
  font-weight: 700;
}

.question-text {
  display: block;
  margin-top: 18rpx;
  color: #9f4a3c;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.5;
}

.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title {
  color: #24100b;
  font-size: 34rpx;
  font-weight: 800;
}

.play-button,
.record-button {
  width: 100%;
  min-height: 96rpx;
  margin-top: 26rpx;
  border-radius: 24rpx;
  background: #9f4a3c;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 96rpx;
}

.record-button {
  background: #111827;
}

.record-button-active {
  background: #be123c;
}

.play-button::after,
.record-button::after,
.text-button::after,
.action-button::after {
  border: 0;
}

.textarea {
  width: 100%;
  min-height: 300rpx;
  margin-top: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #fff8ee;
  color: #2d1710;
  font-size: 30rpx;
  line-height: 1.6;
}

.raw-block {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #fffdf8;
}

.raw-text {
  display: block;
  margin-top: 10rpx;
  color: #6f574f;
  font-size: 28rpx;
  line-height: 1.55;
}

.draft-text {
  display: block;
  margin-top: 22rpx;
  color: #2d1710;
  font-size: 30rpx;
  line-height: 1.65;
}

.text-button {
  margin: 24rpx 0 0;
  padding: 0;
  background: transparent;
  color: #9f4a3c;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.button-row {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.action-button {
  flex: 1;
  height: 96rpx;
  margin: 0;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 96rpx;
}

.action-button.primary {
  background: #9f4a3c;
  color: #ffffff;
}

.action-button.secondary {
  background: #fff1ec;
  color: #9f4a3c;
}

.audio-error,
.error {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #fff1f2;
  color: #be123c;
  font-size: 26rpx;
  line-height: 1.5;
}

.error {
  margin-bottom: 28rpx;
}
