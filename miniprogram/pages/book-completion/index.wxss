.completion-page {
  padding: 28rpx 30rpx 80rpx;
  color: var(--ui-text-primary);
}

.flow-context {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.flow-context-label {
  min-width: 0;
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
  overflow-wrap: anywhere;
}

.flow-context-action {
  flex: 0 0 auto;
  min-height: 44px;
  margin: 0;
  padding: 0 6rpx 0 18rpx;
  border: 0;
  background: transparent;
  color: var(--ui-accent-strong);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 44px;
}

.page-intro {
  margin-top: 18rpx;
  padding: 24rpx 26rpx 26rpx;
  border-radius: var(--ui-radius-card);
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow);
}

.page-kicker,
.page-title,
.page-detail,
.progress-text,
.chapter-title,
.chapter-headline,
.chapter-detail {
  display: block;
  overflow-wrap: anywhere;
}

.page-kicker {
  color: var(--ui-accent);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.page-title {
  margin-top: 8rpx;
  font-family: var(--ui-font-editorial);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: 0.02em;
  text-wrap: balance;
}

.page-detail {
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: 28rpx;
  line-height: 42rpx;
  text-wrap: pretty;
}

.progress-text {
  margin-top: 14rpx;
  color: var(--ui-success-text);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 38rpx;
  font-variant-numeric: tabular-nums;
}

.chapter-list {
  padding-top: 10rpx;
}

.book-review {
  margin: 28rpx 0 12rpx;
  padding: 30rpx 26rpx;
  border-radius: var(--ui-radius-card);
  background: var(--ui-surface);
  box-shadow:
    inset 0 4rpx 0 rgba(182, 93, 73, 0.58),
    var(--ui-card-shadow);
}

.book-review-kicker,
.book-review-title,
.book-review-summary,
.review-group-title,
.review-list-item,
.review-complete {
  display: block;
  overflow-wrap: anywhere;
}

.book-review-kicker {
  color: var(--ui-accent);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.book-review-title {
  margin-top: 8rpx;
  font-family: var(--ui-font-editorial);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 46rpx;
}

.book-review-summary {
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.book-review-summary {
  margin-top: 16rpx;
}

.review-group {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.review-group-title {
  color: var(--ui-text-primary);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.review-list-item {
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  line-height: 40rpx;
  font-variant-numeric: tabular-nums;
}

.review-complete {
  margin-top: 24rpx;
  color: var(--ui-success-text);
  font-size: 26rpx;
  line-height: 40rpx;
}

.editorial-actions {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.editorial-actions-detail,
.editorial-action-title,
.editorial-action-reason,
.editorial-actions-warning {
  display: block;
}

.editorial-actions-detail {
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 38rpx;
}

.editorial-action {
  min-height: 88rpx;
  margin-top: 16rpx;
  padding: 22rpx;
  border: 0;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
  box-shadow: var(--ui-control-shadow);
}

.editorial-action.selected {
  background: var(--ui-accent-surface-subtle);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
}

.editorial-action-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.editorial-action-type,
.editorial-action-check {
  color: var(--ui-accent-strong);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.editorial-action-title {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
  font-variant-numeric: tabular-nums;
}

.editorial-action-reason {
  margin-top: 8rpx;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 38rpx;
}

.editorial-actions-warning {
  margin-top: 16rpx;
  color: var(--ui-danger-text);
  font-size: 24rpx;
  line-height: 36rpx;
}

.completion-notice {
  margin: 28rpx 0 12rpx;
  padding: 28rpx 26rpx;
  border-radius: var(--ui-radius-card);
  background: var(--ui-success-surface);
  box-shadow: var(--ui-card-shadow);
}

.completion-notice-title,
.completion-notice-detail {
  display: block;
}

.completion-notice-title {
  color: var(--ui-success-text);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-wrap: balance;
}

.completion-notice-detail {
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  line-height: 40rpx;
  text-wrap: pretty;
}

.book-review-progress,
.bulk-check-progress,
.revision-progress {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface);
  box-shadow: inset 4rpx 0 0 var(--ui-accent);
}

.book-review-progress.failed,
.bulk-check-progress.failed,
.revision-progress.failed {
  background: var(--ui-danger-surface);
  box-shadow: inset 4rpx 0 0 var(--ui-danger-text);
}

.book-review-progress.cancelled,
.bulk-check-progress.cancelled,
.revision-progress.cancelled {
  background: var(--ui-surface-subtle);
  box-shadow: inset 4rpx 0 0 var(--ui-text-muted);
}

.book-review-progress.succeeded,
.bulk-check-progress.succeeded,
.revision-progress.succeeded {
  background: var(--ui-success-surface);
  box-shadow: inset 4rpx 0 0 var(--ui-success-text);
}

.book-ready-action,
.recheck-book-action,
.revision-action {
  min-height: 84rpx;
  margin-top: 22rpx;
  padding: 0 18rpx 0 22rpx;
  border: 0;
  border-radius: var(--ui-radius-inner);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-control-shadow);
  color: var(--ui-text-primary);
  font-size: 26rpx;
  font-weight: 600;
  text-align: left;
  transition-property: transform, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.book-ready-action {
  background: var(--ui-accent-surface-subtle);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
  color: var(--ui-accent-strong);
}

.revision-action {
  background: var(--ui-accent-surface-subtle);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
  color: var(--ui-accent-strong);
}

.completion-notice .book-ready-action + .recheck-book-action {
  background: rgba(255, 253, 250, 0.72);
  color: var(--ui-success-text);
}

.book-review .book-ready-action + .recheck-book-action {
  background: var(--ui-surface-soft);
  color: var(--ui-accent);
}

.book-ready-action:active,
.recheck-book-action:active,
.revision-action:active {
  transform: scale(0.96);
}

.book-ready-action:active {
  background: var(--ui-accent-surface);
}

.recheck-book-action:active {
  background: var(--ui-success-surface);
}

.revision-action:active {
  background: var(--ui-accent-surface);
}

.row-action-mark {
  flex: 0 0 auto;
  color: var(--ui-accent);
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 40rpx;
  font-weight: 400;
  line-height: 1;
}

.chapter-item {
  margin-top: 16rpx;
  padding: 26rpx 26rpx 20rpx;
  border-radius: var(--ui-radius-card);
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow);
  transition-property: transform, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.chapter-item:active {
  transform: scale(0.96);
  box-shadow: var(--ui-control-shadow);
}

.chapter-item[aria-disabled="true"]:active {
  transform: none;
  box-shadow: var(--ui-card-shadow);
}

.chapter-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.chapter-order,
.chapter-state {
  font-size: 24rpx;
  line-height: 34rpx;
}

.chapter-order {
  color: var(--ui-text-secondary);
  font-variant-numeric: tabular-nums;
}

.chapter-state {
  color: var(--ui-accent);
  font-weight: 700;
}

.chapter-item.confirmed .chapter-state {
  color: var(--ui-success-text);
}

.chapter-item.preparing .chapter-state,
.chapter-item.not_started .chapter-state {
  color: #53677a;
}

.chapter-title {
  margin-top: 10rpx;
  font-family: var(--ui-font-editorial);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 50rpx;
  text-wrap: balance;
}

.chapter-headline {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 44rpx;
}

.chapter-detail {
  margin-top: 8rpx;
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  line-height: 40rpx;
  text-wrap: pretty;
}

.chapter-action {
  min-height: 68rpx;
  margin-top: 18rpx;
  padding: 10rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  box-sizing: border-box;
  border-top: 1rpx solid var(--ui-divider);
  color: var(--ui-accent);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 38rpx;
}

.chapter-item.not_started:active .chapter-action,
.chapter-item.needs_input:active .chapter-action,
.chapter-item.draft_ready:active .chapter-action,
.chapter-item.confirmed:active .chapter-action,
.chapter-item.failed:active .chapter-action {
  color: var(--ui-accent-strong);
}

.chapter-action.disabled {
  color: var(--ui-text-muted);
}

.chapter-action-mark {
  color: currentColor;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 1;
}

.error-strip,
.loading-state,
.empty-state {
  margin-top: 30rpx;
  padding: 26rpx 24rpx;
  font-size: 27rpx;
  line-height: 42rpx;
}

.error-strip {
  border-left: 6rpx solid var(--ui-danger-text);
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
}

.loading-state {
  color: var(--ui-text-secondary);
}

.empty-state {
  color: var(--ui-text-secondary);
  text-align: center;
}

.empty-state text {
  display: block;
}
