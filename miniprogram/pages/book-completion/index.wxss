.completion-page {
  padding: 36rpx 30rpx 80rpx;
  color: var(--ui-text-primary);
}

.flow-context {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.flow-context-label {
  min-width: 0;
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
  overflow-wrap: anywhere;
}

.flow-context-action {
  flex: 0 0 auto;
  min-height: 44px;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 999rpx;
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 44px;
  box-shadow: 0 0 0 1rpx rgba(143, 64, 55, 0.16);
}

.flow-context-action::after,
.book-ready-action::after {
  border: 0;
}

.page-intro {
  padding: 18rpx 4rpx 34rpx;
  border-bottom: 1rpx solid var(--ui-divider);
}

.page-kicker,
.page-title,
.page-detail,
.progress-text,
.chapter-title,
.chapter-headline,
.chapter-detail {
  display: block;
  overflow-wrap: anywhere;
}

.page-kicker {
  color: var(--ui-accent);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.page-title {
  margin-top: 12rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 58rpx;
  text-wrap: balance;
}

.page-detail {
  margin-top: 16rpx;
  color: var(--ui-text-secondary);
  font-size: 28rpx;
  line-height: 42rpx;
  text-wrap: pretty;
}

.progress-text {
  margin-top: 20rpx;
  color: var(--ui-success-text);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 38rpx;
  font-variant-numeric: tabular-nums;
}

.chapter-list {
  padding-top: 10rpx;
}

.book-review {
  margin: 28rpx 0 12rpx;
  padding: 30rpx 26rpx;
  border-left: 6rpx solid var(--ui-accent);
  background: var(--ui-surface);
}

.book-review-kicker,
.book-review-title,
.book-review-summary,
.review-group-title,
.review-list-item,
.review-complete {
  display: block;
  overflow-wrap: anywhere;
}

.book-review-kicker {
  color: var(--ui-accent);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.book-review-title {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 46rpx;
}

.book-review-summary {
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.book-review-summary {
  margin-top: 16rpx;
}

.review-group {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.review-group-title {
  color: var(--ui-text-primary);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.review-list-item {
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.review-complete {
  margin-top: 24rpx;
  color: var(--ui-success-text);
  font-size: 26rpx;
  line-height: 40rpx;
}

.editorial-actions {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.editorial-actions-detail,
.editorial-action-title,
.editorial-action-reason,
.editorial-actions-warning {
  display: block;
}

.editorial-actions-detail {
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 38rpx;
}

.editorial-action {
  min-height: 88rpx;
  margin-top: 16rpx;
  padding: 22rpx;
  border: 1rpx solid var(--ui-border);
  border-radius: 10rpx;
  background: var(--ui-surface-subtle);
}

.editorial-action.selected {
  border-color: var(--ui-accent);
  background: var(--ui-accent-surface);
}

.editorial-action-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.editorial-action-type,
.editorial-action-check {
  color: var(--ui-accent-strong);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.editorial-action-title {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.editorial-action-reason {
  margin-top: 8rpx;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 38rpx;
}

.editorial-actions-warning {
  margin-top: 16rpx;
  color: var(--ui-danger-text);
  font-size: 24rpx;
  line-height: 36rpx;
}

.completion-notice {
  margin: 28rpx 0 12rpx;
  padding: 28rpx 26rpx;
  border-left: 6rpx solid var(--ui-success-text);
  border-radius: 8rpx;
  background: var(--ui-success-surface);
}

.completion-notice-title,
.completion-notice-detail {
  display: block;
}

.completion-notice-title {
  color: var(--ui-success-text);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-wrap: balance;
}

.completion-notice-detail {
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  line-height: 40rpx;
  text-wrap: pretty;
}

.book-review-progress,
.bulk-check-progress,
.answer-application-progress {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: var(--ui-surface);
  box-shadow: inset 4rpx 0 0 var(--ui-accent);
}

.book-review-progress.failed,
.bulk-check-progress.failed,
.answer-application-progress.failed {
  background: var(--ui-danger-surface);
  box-shadow: inset 4rpx 0 0 var(--ui-danger-text);
}

.book-review-progress.cancelled,
.bulk-check-progress.cancelled,
.answer-application-progress.cancelled {
  background: var(--ui-surface-subtle);
  box-shadow: inset 4rpx 0 0 var(--ui-text-muted);
}

.book-review-progress.succeeded,
.bulk-check-progress.succeeded,
.answer-application-progress.succeeded {
  background: var(--ui-success-surface);
  box-shadow: inset 4rpx 0 0 var(--ui-success-text);
}

.book-ready-action,
.recheck-book-action,
.apply-answers-action {
  min-height: 88rpx;
  margin-top: 22rpx;
  border: 0;
  border-radius: 8rpx;
  background: var(--ui-success-text);
  color: var(--ui-on-accent);
  font-size: 28rpx;
  font-weight: 700;
  transition-property: transform, background-color;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.book-ready-action {
  background: var(--ui-accent);
  color: var(--ui-on-accent);
}

.recheck-book-action::after {
  border: 0;
}

.answer-application {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid var(--ui-border);
  border-radius: 12rpx;
  background: var(--ui-surface-subtle);
}

.answer-application.applied {
  border-color: rgba(94, 119, 88, 0.28);
  background: var(--ui-success-surface);
}

.answer-application-title,
.answer-application-detail {
  display: block;
  overflow-wrap: anywhere;
}

.answer-application-title {
  color: var(--ui-text-primary);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-wrap: balance;
}

.answer-application-detail {
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  line-height: 40rpx;
  text-wrap: pretty;
}

.apply-answers-action {
  background: var(--ui-accent);
  color: var(--ui-on-accent);
}

.completion-notice .book-ready-action + .recheck-book-action {
  background: transparent;
  color: var(--ui-success-text);
  box-shadow: inset 0 0 0 1rpx rgba(94, 119, 88, 0.28);
}

.book-review .book-ready-action + .recheck-book-action {
  background: transparent;
  color: var(--ui-accent);
  box-shadow: inset 0 0 0 1rpx rgba(143, 64, 55, 0.28);
}

.book-ready-action:active,
.recheck-book-action:active,
.apply-answers-action:active {
  transform: scale(0.96);
}

.book-ready-action:active {
  background: var(--ui-accent-strong);
}

.recheck-book-action:active {
  background: var(--ui-success-surface);
}

.apply-answers-action:active {
  background: var(--ui-accent-strong);
}

.chapter-item {
  padding: 34rpx 4rpx 38rpx;
  border-bottom: 1rpx solid var(--ui-divider);
}

.chapter-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.chapter-order,
.chapter-state {
  font-size: 24rpx;
  line-height: 34rpx;
}

.chapter-order {
  color: var(--ui-text-secondary);
}

.chapter-state {
  color: var(--ui-accent);
  font-weight: 700;
}

.chapter-item.confirmed .chapter-state {
  color: var(--ui-success-text);
}

.chapter-item.preparing .chapter-state,
.chapter-item.not_started .chapter-state {
  color: #53677a;
}

.chapter-title {
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 50rpx;
  text-wrap: balance;
}

.chapter-headline {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 44rpx;
}

.chapter-detail {
  margin-top: 8rpx;
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  line-height: 40rpx;
  text-wrap: pretty;
}

.chapter-action {
  min-height: 88rpx;
  margin-top: 26rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid var(--ui-accent);
  border-radius: 8rpx;
  color: var(--ui-accent);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
  text-align: center;
  transition-property: transform, background-color;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.chapter-item.not_started:active .chapter-action,
.chapter-item.needs_input:active .chapter-action,
.chapter-item.draft_ready:active .chapter-action,
.chapter-item.confirmed:active .chapter-action,
.chapter-item.failed:active .chapter-action {
  transform: scale(0.96);
  background: var(--ui-accent-surface-subtle);
}

.chapter-action.disabled {
  border-color: var(--ui-border);
  color: var(--ui-text-muted);
}

.error-strip,
.loading-state,
.empty-state {
  margin-top: 30rpx;
  padding: 26rpx 24rpx;
  font-size: 27rpx;
  line-height: 42rpx;
}

.error-strip {
  border-left: 6rpx solid var(--ui-danger-text);
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
}

.loading-state {
  color: var(--ui-text-secondary);
}

.empty-state {
  color: var(--ui-text-secondary);
  text-align: center;
}

.empty-state text {
  display: block;
}
