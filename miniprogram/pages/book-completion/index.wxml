<page-meta page-style="--ui-navigation-height: {{navigationHeight || 0}}px;" />
<brand-navigation title="{{navigationTitle || '书稿建议'}}" page-class="{{pageClass || homePageClass}}" bindlayout="onNavigationLayout" />
<view class="ui-page-shell {{pageClass}}">
  <view class="flow-context">
    <text class="flow-context-label">{{projectTitle || "我的回忆录"}}</text>
    <button class="flow-context-action ui-pressable" bindtap="openBookHome">‹ 书稿首页</button>
  </view>

  <view class="page-intro">
    <text class="page-title">书稿建议</text>
    <text wx:if="{{bulkCheckVisible || blockingIssueCount || bookReviewProgress.visible}}" class="progress-text">{{progressText}}</text>
    <text wx:if="{{blockingIssueCount}}" class="confirmation-notice">{{blockingIssueCount}} 项待核对，相关章节暂未入书。</text>
  </view>

  <view wx:if="{{error}}" class="error-strip">{{error}}</view>
  <view wx:if="{{loading}}" class="loading-state">正在查看全书...</view>

  <view wx:else class="chapter-list">
    <view wx:if="{{canReviewBook || bookReview || bookReviewProgress.visible || requiredBookIssues.length || optionalBookIssues.length}}" class="book-review">
      <text class="book-review-title">
        全书审阅
      </text>

      <view
        wx:if="{{bookReviewProgress.visible}}"
        class="book-review-progress {{bookReviewProgress.className}}"
      >
        <ai-task-progress
          title="{{bookReviewProgress.title}}"
          detail="{{bookReviewProgress.detail}}"
          mode="{{bookReviewProgress.progressMode}}"
          progress="{{bookReviewProgress.progress}}"
          can-cancel="{{bookReviewProgress.canCancel && !bookReviewCancelling}}"
          cancel-text="停止全书检查"
          bindcancel="cancelBookReview"
        />
      </view>

      <block wx:if="{{bookReview && bookReview.status === 'ready'}}">
        <button class="flow-context-action" bindtap="toggleReviewDetails" aria-expanded="{{reviewDetailsExpanded}}">{{reviewDetailsExpanded ? '收起审阅详情' : '查看审阅详情'}}</button>
        <view wx:if="{{reviewDetailsExpanded}}">
          <text class="book-review-summary">{{bookReview.review.summary}}</text>

          <view wx:if="{{bookReview.review.strengths.length}}" class="review-group">
            <text class="review-group-title">已经成立的部分</text>
            <text
              wx:for="{{bookReview.review.strengths}}"
              wx:key="*this"
              class="review-list-item"
            >{{index + 1}}. {{item}}</text>
          </view>

          <view wx:if="{{bookReview.review.structure_guidance.length}}" class="review-group">
            <text class="review-group-title">可以完善</text>
            <text
              wx:for="{{bookReview.review.structure_guidance}}"
              wx:key="*this"
              class="review-list-item"
            >{{index + 1}}. {{item}}</text>
          </view>

        </view>
        <view
          wx:if="{{editorialActionViews.length || (revisionJob && revisionJob.answer_count && !revisionJob.already_applied)}}"
          class="editorial-actions"
        >
          <text class="review-group-title">选择要处理的内容</text>
          <text class="editorial-actions-detail">
            选择后先预览，再确认修改。
          </text>
          <view
            wx:if="{{revisionJob && revisionJob.answer_count && !revisionJob.already_applied}}"
            class="editorial-action {{includeBookReviewAnswers ? 'selected' : ''}}"
            bindtap="toggleBookReviewAnswers"
            aria-role="checkbox"
            aria-checked="{{includeBookReviewAnswers}}"
          >
            <view class="editorial-action-heading">
              <text class="editorial-action-type">问题回答</text>
              <text class="editorial-action-check">{{includeBookReviewAnswers ? "已选择" : "选择"}}</text>
            </view>
            <text class="editorial-action-title">使用已保存的 {{revisionJob.answer_count}} 条回答</text>
          </view>
          <view
            wx:for="{{editorialActionViews}}"
            wx:key="id"
            class="editorial-action {{item.selected ? 'selected' : ''}}"
            data-action-id="{{item.id}}"
            bindtap="toggleEditorialAction"
            aria-role="checkbox"
            aria-checked="{{item.selected}}"
          >
            <view class="editorial-action-heading">
              <text class="editorial-action-type">{{item.typeLabel}}</text>
              <text class="editorial-action-check">{{item.selected ? "已选择" : "选择"}}</text>
            </view>
            <text class="editorial-action-title">{{item.title}}</text>
            <text class="editorial-action-reason">{{item.reason}}</text>
          </view>
          <view
            wx:if="{{revisionProgress.visible}}"
            class="revision-progress {{revisionProgress.className}}"
          >
            <ai-task-progress
              title="{{revisionProgress.title}}"
              detail="{{revisionProgress.detail}}"
              mode="{{revisionProgress.progressMode}}"
              can-cancel="{{revisionProgress.canCancel && !revisionCancelling}}"
              cancel-text="停止生成"
              bindcancel="cancelBookRevision"
            />
          </view>
          <text
            wx:if="{{requiredBookIssues.length}}"
            class="editorial-actions-warning"
          >待确认章节暂不参与修改，其他章节可继续整理。</text>
          <view
            wx:if="{{revisionJob && revisionJob.proposal_status === 'ready' && revisionJob.proposal_id}}"
            class="revision-action ui-block-action ui-pressable"
            aria-role="button"
            bindtap="openBookRevision"
          >
            <text>{{revisionJob.proposal_phase === "plan_ready" ? "查看修改思路" : "查看修改预览"}}</text>
            <text class="row-action-mark">›</text>
          </view>
          <view
            wx:else
            class="revision-action ui-block-action ui-pressable {{(!includeBookReviewAnswers && !selectedEditorialActionIds.length) || generatingRevision || revisionCancelling ? 'is-disabled' : ''}}"
            aria-role="button"
            aria-disabled="{{(!includeBookReviewAnswers && !selectedEditorialActionIds.length) || generatingRevision || revisionCancelling}}"
            bindtap="generateBookRevision"
          >
            <text>{{includeBookReviewAnswers || selectedEditorialActionIds.length ? "处理已选内容" : "请先选择内容"}}</text>
            <text class="row-action-mark">›</text>
          </view>
        </view>

        <text
          wx:if="{{!requiredBookIssues.length && !optionalBookIssues.length}}"
          class="review-complete"
        >没有待处理的跨章问题。</text>
      </block>

      <text wx:elif="{{bookReview}}" class="book-review-summary">
        {{bookReview.error_message || "本次全书检查没有完成，可以重新检查。"}}
      </text>
      <text wx:else class="book-review-summary">
        检查全书重复、衔接和内容取舍。
      </text>

      <completion-issue-list
        project-id="{{projectId}}"
        project-title="{{projectTitle}}"
        required-issues="{{requiredBookIssues}}"
        optional-issues="{{optionalBookIssues}}"
        allow-required-confirmation="{{true}}"
        book-confirmation-mode="{{true}}"
        bindrefresh="loadOverview"
      />

      <view
        wx:if="{{bookReview && bookReview.status === 'ready'}}"
        class="book-ready-action ui-block-action ui-pressable"
        aria-role="button"
        bindtap="openBookHome"
      ><text>返回书稿</text><text class="row-action-mark">›</text></view>
      <view
        wx:if="{{canReviewBook && (!bookReview || bookReview.status !== 'ready')}}"
        class="recheck-book-action ui-block-action ui-pressable {{checkingBook || bookReviewCancelling ? 'is-disabled' : ''}}"
        aria-role="button"
        aria-disabled="{{checkingBook || bookReviewCancelling}}"
        bindtap="reviewBook"
      ><text>{{checkingBook ? "正在检查全书…" : "检查全书"}}</text><text class="row-action-mark">›</text></view>
    </view>

    <view wx:if="{{bulkCheckVisible}}" class="completion-notice">
      <text class="completion-notice-title">{{bulkCheckTitle}}</text>
      <text class="completion-notice-detail">{{bulkCheckDetail}}</text>
      <view
        wx:if="{{bulkCheckProgress.visible}}"
        class="bulk-check-progress {{bulkCheckProgress.className}}"
      >
        <ai-task-progress
          title="{{bulkCheckProgress.title}}"
          detail="{{bulkCheckProgress.detail}}"
          mode="{{bulkCheckProgress.progressMode}}"
          progress="{{bulkCheckProgress.progress}}"
          can-cancel="{{bulkCheckProgress.canCancel && !bulkCheckCancelling}}"
          cancel-text="停止后续检查"
          bindcancel="cancelBulkCheck"
        />
      </view>
      <view
        class="recheck-book-action ui-block-action ui-pressable {{recheckingAll || bulkCheckCancelling ? 'is-disabled' : ''}}"
        aria-role="button"
        aria-disabled="{{recheckingAll || bulkCheckCancelling}}"
        bindtap="checkPendingChapters"
      ><text>{{recheckingAll ? "正在检查章节…" : bulkCheckActionText}}</text><text class="row-action-mark">›</text></view>
    </view>

    <block
      wx:for="{{chapters}}"
      wx:key="chapter_id"
    >
    <view
      wx:if="{{item.needsAttention}}"
      class="{{item.chapterClass}}"
      data-chapter-id="{{item.chapter_id}}"
      bindtap="tapChapter"
      aria-role="button"
      aria-disabled="{{item.disabled}}"
    >
      <view class="chapter-heading">
        <text class="chapter-order">第 {{index + 1}} 章</text>
        <text class="chapter-state">{{item.stateText}}</text>
      </view>
      <text class="chapter-title">{{item.title}}</text>
      <text wx:if="{{item.blocking_issue_count}}" class="confirmation-notice">{{item.blocking_issue_count}} 项待核对，处理后可入书。</text>
      <text class="chapter-headline">{{item.headline}}</text>
      <text class="chapter-detail">{{item.detail}}</text>
      <view class="chapter-action {{item.disabled ? 'disabled' : ''}}">
        <text>{{item.actionText}}</text><text class="chapter-action-mark">›</text>
      </view>
    </view>
    </block>

  <view wx:if="{{automationEventLoading || automationEventError || automationEventItems.length}}" class="automation-panel ui-card">
    <view class="automation-head">
      <view class="automation-details-toggle ui-pressable" bindtap="toggleAutomationDetails" aria-role="button" aria-expanded="{{automationDetailsExpanded}}" aria-label="{{automationDetailsExpanded ? '收起整理进度详情' : '展开整理进度详情'}}">
        <text class="automation-title">整理进度</text>
        <text aria-hidden="true">{{automationDetailsExpanded ? '⌃' : '⌄'}}</text>
      </view>
      <view class="automation-head-actions">
        <button
          wx:if="{{automationDismissibleCount}}"
          class="automation-clear"
          loading="{{automationEventClearing}}"
          disabled="{{automationEventClearing || automationEventBusyTarget}}"
          bindtap="acknowledgeDismissibleAutomationEvents"
        >
          全部收起
        </button>
        <text class="automation-count">{{automationEventLoading ? "同步中" : automationEventItems.length + " 条"}}</text>
      </view>
    </view>
    <text wx:if="{{automationEventError}}" class="automation-error">{{automationEventError}}</text>
    <view wx:for="{{automationEventItems}}" wx:key="id" class="automation-item {{item.eventType}}">
      <view class="automation-item-main">
        <view class="automation-item-title-row">
          <text class="automation-item-title">{{item.titleText}}</text>
          <text class="automation-item-status">{{item.statusText}}</text>
        </view>
        <text wx:if="{{automationDetailsExpanded || item.status === 'needs_review'}}" class="automation-item-summary">{{item.summaryText}}</text>
        <text wx:if="{{item.detailText}}" class="automation-item-detail">{{item.detailText}}</text>
        <text wx:if="{{automationDetailsExpanded}}" class="automation-item-meta">{{item.metaText}}</text>
      </view>
      <button
        class="automation-ack"
        data-id="{{item.id}}"
        data-event-ids="{{item.eventIdsText}}"
        data-action="{{item.actionKind}}"
        loading="{{item.busy}}"
        disabled="{{automationEventClearing || automationEventBusyTarget || !item.canAct}}"
        bindtap="acknowledgeAutomationEvent"
      >
        {{item.actionText}}
      </button>
    </view>
  </view>

    <view class="book-rebuild-entry ui-pressable" aria-role="button" bindtap="openBookRegeneration">重新整理书稿 <text>›</text></view>

    <view wx:if="{{!chapters.length}}" class="empty-state">
      <text>这本书还没有章节。</text>
      <text>先到书稿页确定章节，再回来补全。</text>
      <view
        class="book-ready-action ui-block-action ui-pressable"
        aria-role="button"
        bindtap="openBookHome"
      ><text>返回书稿</text><text class="row-action-mark">›</text></view>
    </view>
  </view>
</view>
