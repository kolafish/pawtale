<view class="completion-page ui-page-shell">
  <view class="flow-context">
    <text class="flow-context-label">{{projectTitle || "我的回忆录"}} · 全书进度</text>
    <button class="flow-context-action" bindtap="openBookHome">书稿首页</button>
  </view>

  <view class="page-intro">
    <text class="page-kicker">整理成书</text>
    <text class="page-title">{{headline}}</text>
    <text class="page-detail">{{detail}}</text>
    <text wx:if="{{progressText}}" class="progress-text">{{progressText}}</text>
  </view>

  <view wx:if="{{error}}" class="error-strip">{{error}}</view>
  <view wx:if="{{loading}}" class="loading-state">正在查看全书...</view>

  <view wx:else class="chapter-list">
    <view wx:if="{{allChaptersConfirmed}}" class="book-review">
      <text class="book-review-kicker">全书审阅</text>
      <text class="book-review-title">
        {{bookReview && bookReview.status === "ready" ? "检查跨章衔接与取舍" : "章节已确认，再看全书"}}
      </text>

      <view
        wx:if="{{bookReviewProgressVisible}}"
        class="book-review-progress {{bookReviewProgressClass}}"
      >
        <ai-task-progress
          title="{{bookReviewProgressTitle}}"
          detail="{{bookReviewProgressDetail}}"
          mode="{{bookReviewProgressMode}}"
          progress="{{bookReviewProgressPercent}}"
          can-cancel="{{bookReviewCanCancel && !bookReviewCancelling}}"
          cancel-text="停止全书检查"
          bindcancel="cancelBookReview"
        />
      </view>

      <block wx:if="{{bookReview && bookReview.status === 'ready'}}">
        <text class="book-review-summary">{{bookReview.review.summary}}</text>

        <view wx:if="{{bookReview.review.strengths.length}}" class="review-group">
          <text class="review-group-title">已经成立的部分</text>
          <text
            wx:for="{{bookReview.review.strengths}}"
            wx:key="*this"
            class="review-list-item"
          >{{index + 1}}. {{item}}</text>
        </view>

        <view wx:if="{{bookReview.review.structure_guidance.length}}" class="review-group">
          <text class="review-group-title">编辑建议，可自行取舍</text>
          <text
            wx:for="{{bookReview.review.structure_guidance}}"
            wx:key="*this"
            class="review-list-item"
          >{{index + 1}}. {{item}}</text>
        </view>

        <view wx:if="{{editorialActionViews.length}}" class="editorial-actions">
          <text class="review-group-title">可生成修改预览</text>
          <text class="editorial-actions-detail">
            只执行您选中的建议。确认预览前，当前书稿不会改变。
          </text>
          <view
            wx:for="{{editorialActionViews}}"
            wx:key="id"
            class="editorial-action {{item.selected ? 'selected' : ''}}"
            data-action-id="{{item.id}}"
            bindtap="toggleEditorialAction"
            aria-role="checkbox"
            aria-checked="{{item.selected}}"
          >
            <view class="editorial-action-heading">
              <text class="editorial-action-type">{{item.typeLabel}}</text>
              <text class="editorial-action-check">{{item.selected ? "已选择" : "选择"}}</text>
            </view>
            <text class="editorial-action-title">{{item.title}}</text>
            <text class="editorial-action-reason">{{item.reason}}</text>
          </view>
          <view
            wx:if="{{editorialRevisionProgressVisible}}"
            class="answer-application-progress {{editorialRevisionProgressClass}}"
          >
            <ai-task-progress
              title="{{editorialRevisionProgressTitle}}"
              detail="{{editorialRevisionProgressDetail}}"
              mode="{{editorialRevisionProgressClass === 'active' ? 'indeterminate' : 'hidden'}}"
              can-cancel="{{editorialRevisionCanCancel && !editorialRevisionCancelling}}"
              cancel-text="停止生成"
              bindcancel="cancelEditorialRevision"
            />
          </view>
          <text
            wx:if="{{requiredBookIssues.length}}"
            class="editorial-actions-warning"
          >请先处理完需要确认的问题，再执行全书编辑建议。</text>
          <text
            wx:elif="{{answerApplicationJob && answerApplicationJob.answer_count && !answerApplicationJob.already_applied}}"
            class="editorial-actions-warning"
          >请先处理根据问题回答生成的修改预览，再执行全书编辑建议。</text>
          <view
            wx:if="{{editorialRevisionJob && editorialRevisionJob.proposal_status === 'ready' && editorialRevisionJob.proposal_id}}"
            class="apply-answers-action ui-block-action ui-pressable"
            aria-role="button"
            bindtap="openEditorialRevision"
          >查看全书修改预览</view>
          <view
            wx:else
            class="apply-answers-action ui-block-action ui-pressable {{!selectedEditorialActionIds.length || generatingEditorialRevision || editorialRevisionCancelling || requiredBookIssues.length || (answerApplicationJob && answerApplicationJob.answer_count && !answerApplicationJob.already_applied) ? 'is-disabled' : ''}}"
            aria-role="button"
            aria-disabled="{{!selectedEditorialActionIds.length || generatingEditorialRevision || editorialRevisionCancelling || requiredBookIssues.length || (answerApplicationJob && answerApplicationJob.answer_count && !answerApplicationJob.already_applied)}}"
            bindtap="generateEditorialRevision"
          >{{selectedEditorialActionIds.length ? "生成所选修改预览" : "请先选择建议"}}</view>
        </view>

        <view wx:if="{{bookOutputAvailable}}" class="review-book-settings">
          <text class="review-book-settings-copy">
            如果问题只是书名、全书定位或出版信息不合适，可以直接修改，不需要录音补讲。
          </text>
          <view
            class="review-book-settings-action ui-block-action ui-pressable"
            aria-role="button"
            bindtap="openBookSettings"
          >调整书名与成书信息</view>
        </view>

        <completion-issue-list
          project-id="{{projectId}}"
          project-title="{{projectTitle}}"
          required-issues="{{requiredBookIssues}}"
          optional-issues="{{optionalBookIssues}}"
          allow-required-confirmation="{{true}}"
          bindrefresh="loadOverview"
        />

        <view
          wx:if="{{answerApplicationJob && answerApplicationJob.answer_count && !requiredBookIssues.length}}"
          class="answer-application {{answerApplicationJob.already_applied ? 'applied' : ''}}"
        >
          <text class="answer-application-title">
            {{answerApplicationJob.already_applied
              ? "回答已经写入书稿"
              : (answerApplicationJob.proposal_status === "ready"
                ? "修改预览已经生成"
                : answerApplicationJob.answer_count + " 条回答已经保存")}}
          </text>
          <text class="answer-application-detail">
            {{answerApplicationJob.already_applied
              ? (answerApplicationJob.summary || "相关章节已经根据您的回答完成调整，并保留了原来的书稿版本。")
              : (answerApplicationJob.proposal_status === "ready"
                ? (answerApplicationJob.summary || "请先查看修改前后内容，确认后才会写入书稿。")
                : "可以根据这些回答生成修改预览，确认前不会改变当前书稿。")}}
          </text>
          <view
            wx:if="{{answerApplicationProgressVisible}}"
            class="answer-application-progress {{answerApplicationProgressClass}}"
          >
            <ai-task-progress
              title="{{answerApplicationProgressTitle}}"
              detail="{{answerApplicationProgressDetail}}"
              mode="{{answerApplicationProgressMode}}"
              can-cancel="{{answerApplicationCanCancel && !answerApplicationCancelling}}"
              cancel-text="停止调整"
              bindcancel="cancelAnswerApplication"
            />
          </view>
          <view
            wx:if="{{answerApplicationJob.already_applied}}"
            class="apply-answers-action ui-block-action ui-pressable"
            aria-role="button"
            bindtap="openAdjustedBook"
          >查看调整后的书稿</view>
          <view
            wx:elif="{{answerApplicationJob.proposal_status === 'ready' && answerApplicationJob.proposal_id}}"
            class="apply-answers-action ui-block-action ui-pressable"
            aria-role="button"
            bindtap="openBookRevision"
          >查看修改预览</view>
          <view
            wx:elif="{{answerApplicationJob.can_apply}}"
            class="apply-answers-action ui-block-action ui-pressable {{applyingAnswers || answerApplicationCancelling ? 'is-disabled' : ''}}"
            aria-role="button"
            aria-disabled="{{applyingAnswers || answerApplicationCancelling}}"
            bindtap="applyBookReviewAnswers"
          >{{answerApplicationJob.can_retry ? "重新生成修改预览" : "生成修改预览"}}</view>
        </view>

        <text
          wx:if="{{!requiredBookIssues.length && !optionalBookIssues.length}}"
          class="review-complete"
        >没有需要用户处理的跨章问题。</text>
      </block>

      <text wx:elif="{{bookReview}}" class="book-review-summary">
        {{bookReview.error_message || "本次全书检查没有完成，可以重新检查。"}}
      </text>
      <text wx:else class="book-review-summary">
        检查跨章重复、断裂、人物突现、篇幅失衡和需要您决定的取舍，不会按固定数量凑问题。
      </text>

      <view
        wx:if="{{bookReview && bookReview.status === 'ready' && !requiredBookIssues.length && (!answerApplicationJob || !answerApplicationJob.answer_count || answerApplicationJob.already_applied)}}"
        class="book-ready-action ui-block-action ui-pressable"
        aria-role="button"
        bindtap="openBookHome"
      >返回书稿</view>
      <view
        class="recheck-book-action ui-block-action ui-pressable {{checkingBook || bookReviewCancelling ? 'is-disabled' : ''}}"
        aria-role="button"
        aria-disabled="{{checkingBook || bookReviewCancelling}}"
        bindtap="reviewBook"
      >{{checkingBook ? "正在检查全书…" : (bookReview ? "重新检查全书" : "检查全书")}}</view>
    </view>

    <view wx:if="{{bulkCheckVisible}}" class="completion-notice">
      <text class="completion-notice-title">{{bulkCheckTitle}}</text>
      <text class="completion-notice-detail">{{bulkCheckDetail}}</text>
      <view
        wx:if="{{bulkCheckProgressVisible}}"
        class="bulk-check-progress {{bulkCheckProgressClass}}"
      >
        <ai-task-progress
          title="{{bulkCheckProgressTitle}}"
          detail="{{bulkCheckProgressDetail}}"
          mode="{{bulkCheckProgressMode}}"
          progress="{{bulkCheckProgressPercent}}"
          can-cancel="{{bulkCheckCanCancel && !bulkCheckCancelling}}"
          cancel-text="停止后续检查"
          bindcancel="cancelBulkCheck"
        />
      </view>
      <view
        class="recheck-book-action ui-block-action ui-pressable {{recheckingAll || bulkCheckCancelling ? 'is-disabled' : ''}}"
        aria-role="button"
        aria-disabled="{{recheckingAll || bulkCheckCancelling}}"
        bindtap="checkPendingChapters"
      >{{recheckingAll ? "正在检查章节…" : bulkCheckActionText}}</view>
    </view>

    <view
      wx:for="{{chapters}}"
      wx:key="chapter_id"
      class="{{item.chapterClass}}"
      data-chapter-id="{{item.chapter_id}}"
      bindtap="tapChapter"
      aria-role="button"
      aria-disabled="{{item.disabled}}"
    >
      <view class="chapter-heading">
        <text class="chapter-order">第 {{index + 1}} 章</text>
        <text class="chapter-state">{{item.stateText}}</text>
      </view>
      <text class="chapter-title">{{item.title}}</text>
      <text class="chapter-headline">{{item.headline}}</text>
      <text class="chapter-detail">{{item.detail}}</text>
      <view class="chapter-action {{item.disabled ? 'disabled' : ''}}">
        {{item.actionText}}
      </view>
    </view>

    <view wx:if="{{!chapters.length}}" class="empty-state">
      <text>这本书还没有章节。</text>
      <text>先到书稿页确定章节，再回来补全。</text>
      <view
        class="book-ready-action ui-block-action ui-pressable"
        aria-role="button"
        bindtap="openBookHome"
      >返回书稿</view>
    </view>
  </view>
</view>
