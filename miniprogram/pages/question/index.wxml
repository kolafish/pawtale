<view class="page stack">
  <view class="stack">
    <text class="eyebrow">{{sessionTitle}}</text>
    <text class="title">当前问题</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="surface stack">
    <text class="body-text">{{prompt || "正在获取问题"}}</text>
    <text wx:if="{{isCompleted}}" class="muted">本轮访谈已经完成。</text>
  </view>

  <textarea
    class="textarea"
    value="{{answerText}}"
    placeholder="写下你的回答"
    maxlength="-1"
    disabled="{{isCompleted || submitting}}"
    bindinput="onAnswerInput"
  />

  <view class="button-row">
    <button class="button button-secondary" disabled="{{isCompleted || submitting}}" bindtap="skipCurrentQuestion">
      跳过
    </button>
    <button class="button button-primary" loading="{{submitting}}" disabled="{{isCompleted}}" bindtap="submitAnswer">
      提交回答
    </button>
  </view>
</view>
