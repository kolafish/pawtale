<view class="page stack">
  <view class="stack">
    <text class="eyebrow">{{sessionTitle}}</text>
    <text class="title">当前问题</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="surface stack">
    <text class="body-text">{{prompt || "正在获取问题"}}</text>
    <text wx:if="{{isCompleted}}" class="muted">暂时没有新的问题，可以先回首页看看整理结果。</text>
  </view>

  <view class="recorder surface">
    <button
      wx:if="{{!recording}}"
      class="record-button"
      disabled="{{isCompleted || submitting || uploadingAudio || transcribingAudio || syncingSegment}}"
      loading="{{uploadingAudio || transcribingAudio || syncingSegment}}"
      bindtap="startRecording"
    >
      <block wx:if="{{uploadingAudio}}">保存中</block>
      <block wx:elif="{{transcribingAudio}}">转写中</block>
      <block wx:elif="{{syncingSegment}}">添加中</block>
      <block wx:else>开始录音</block>
    </button>
    <button
      wx:else
      class="record-button record-button-active"
      bindtap="stopRecording"
    >
      停止录音
    </button>

    <view wx:if="{{audioSummary}}" class="audio-row">
      <text class="audio-state">{{audioSummary}}</text>
    </view>
  </view>

  <view wx:if="{{answerSegments.length}}" class="segments surface">
    <view class="segments-header">
      <text class="section-title">已记录分段</text>
      <text class="segment-count">{{answerSegments.length}} 段</text>
    </view>
    <view wx:for="{{answerSegments}}" wx:key="localId" class="segment-item">
      <view class="segment-meta">
        <text class="segment-index">第 {{index + 1}} 段</text>
        <text class="segment-status">{{item.statusText}}</text>
        <text wx:if="{{item.durationLabel}}" class="segment-duration">{{item.durationLabel}}</text>
      </view>
      <textarea
        class="segment-textarea"
        value="{{item.text}}"
        placeholder="这段还没有转写文字，可以先补写"
        maxlength="-1"
        disabled="{{isCompleted || submitting}}"
        data-local-id="{{item.localId}}"
        bindinput="onSegmentInput"
      />
      <text wx:if="{{item.errorMessage}}" class="segment-error">{{item.errorMessage}}</text>
    </view>
  </view>

  <textarea
    class="textarea"
    value="{{answerText}}"
    placeholder="{{answerSegments.length ? '补充一段文字' : '写下你的回答，或先录一段'}}"
    maxlength="-1"
    disabled="{{isCompleted || submitting || recording || uploadingAudio || transcribingAudio || syncingSegment}}"
    bindinput="onAnswerInput"
  />

  <view class="button-row">
    <button class="button button-secondary" disabled="{{isCompleted || submitting || recording || uploadingAudio || transcribingAudio || syncingSegment}}" bindtap="skipCurrentQuestion">
      跳过
    </button>
    <button class="button button-primary" loading="{{submitting}}" disabled="{{isCompleted || recording || uploadingAudio || transcribingAudio || syncingSegment}}" bindtap="submitAnswer">
      提交回答
    </button>
  </view>
</view>
