<view class="page stack">
  <view class="stack">
    <text class="eyebrow">{{sessionTitle}}</text>
    <text class="title">当前问题</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="surface stack">
    <text class="body-text">{{prompt || "正在获取问题"}}</text>
    <text wx:if="{{isCompleted}}" class="muted">本轮访谈已经完成。</text>
  </view>

  <view class="recorder surface">
    <button
      wx:if="{{!recording}}"
      class="record-button"
      disabled="{{isCompleted || submitting || uploadingAudio}}"
      loading="{{uploadingAudio}}"
      bindtap="startRecording"
    >
      {{uploadingAudio ? "保存中" : "开始录音"}}
    </button>
    <button
      wx:else
      class="record-button record-button-active"
      bindtap="stopRecording"
    >
      停止录音
    </button>

    <view wx:if="{{audioSummary}}" class="audio-row">
      <text class="audio-state">{{audioSummary}}</text>
      <button class="text-button" disabled="{{submitting}}" bindtap="clearRecordedAudio">重新录音</button>
    </view>
  </view>

  <textarea
    class="textarea"
    value="{{answerText}}"
    placeholder="写下你的回答"
    maxlength="-1"
    disabled="{{isCompleted || submitting || recording || uploadingAudio}}"
    bindinput="onAnswerInput"
  />

  <view class="button-row">
    <button class="button button-secondary" disabled="{{isCompleted || submitting || recording || uploadingAudio}}" bindtap="skipCurrentQuestion">
      跳过
    </button>
    <button class="button button-primary" loading="{{submitting}}" disabled="{{isCompleted || recording || uploadingAudio}}" bindtap="submitAnswer">
      提交回答
    </button>
  </view>
</view>
