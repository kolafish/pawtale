<view class="revision-page ui-page-shell">
  <view wx:if="{{loading}}" class="state-card">正在准备修改预览...</view>
  <view wx:elif="{{error && !proposal}}" class="ui-error-banner">{{error}}</view>

  <block wx:elif="{{proposal}}">
    <view class="revision-intro">
      <text class="revision-kicker">书稿修改预览</text>
      <text class="revision-title">确认前，当前书稿不会改变</text>
      <text class="revision-summary">{{proposal.summary}}</text>
      <text class="revision-meta ui-tabular">
        {{proposal.comparison.chapter_order_changed ? "包含章节顺序调整；" : ""}}正文涉及 {{proposal.comparison.changed_chapter_count}} 章、{{proposal.comparison.changed_section_count}} 个小节
      </text>
      <text wx:if="{{proposal.status === 'stale'}}" class="status-notice error">
        当前书稿已经变化，这版预览不能再确认，请返回后重新生成。
      </text>
      <text wx:elif="{{proposal.status === 'applied'}}" class="status-notice success">
        这版修改已经写入书稿，并保留了修改前版本。
      </text>
      <text wx:elif="{{proposal.status === 'dismissed'}}" class="status-notice">
        这版修改已经放弃，当前书稿没有改变。
      </text>
    </view>

    <view class="mode-switch" aria-label="预览范围">
      <view
        class="mode-option ui-pressable {{mode === 'changes' ? 'active' : ''}}"
        data-mode="changes"
        bindtap="switchMode"
      >只看修改处</view>
      <view
        class="mode-option ui-pressable {{mode === 'whole' ? 'active' : ''}}"
        data-mode="whole"
        bindtap="switchMode"
      >查看全书</view>
    </view>

    <view class="version-switch" aria-label="预览版本">
      <view
        class="version-option ui-pressable {{previewVersion === 'before' ? 'active' : ''}}"
        data-version="before"
        bindtap="switchPreviewVersion"
      >修改前</view>
      <view
        class="version-option ui-pressable {{previewVersion === 'after' ? 'active' : ''}}"
        data-version="after"
        bindtap="switchPreviewVersion"
      >修改后</view>
    </view>

    <view wx:if="{{mode === 'changes'}}" class="changed-list">
      <view
        wx:if="{{proposal.comparison.chapter_order_changed}}"
        class="changed-chapter order-comparison"
      >
        <text class="chapter-label">章节顺序</text>
        <text class="chapter-title">调整前</text>
        <text
          wx:for="{{proposal.comparison.before_chapter_order}}"
          wx:key="chapter_id"
          class="order-item"
        >{{index + 1}}. {{item.title}}</text>
        <text class="chapter-title order-after-title">调整后</text>
        <text
          wx:for="{{proposal.comparison.after_chapter_order}}"
          wx:key="chapter_id"
          class="order-item"
        >{{index + 1}}. {{item.title}}</text>
      </view>
      <view
        wx:for="{{changedChapters}}"
        wx:key="chapter_id"
        wx:for-item="chapter"
        class="changed-chapter"
      >
        <text class="chapter-label">修改章节</text>
        <text class="chapter-title">{{chapter.title}}</text>
        <view
          wx:for="{{chapter.sections}}"
          wx:key="section_id"
          wx:for-item="section"
          class="changed-section"
        >
          <text class="section-label">小节</text>
          <text class="section-title">{{section.title}}</text>
          <text class="section-content" selectable>{{section.display_content}}</text>
        </view>
      </view>
      <view
        wx:if="{{!changedChapters.length && !proposal.comparison.chapter_order_changed}}"
        class="state-card"
      >
        已核对所选修改，正文和章节顺序没有变化。
      </view>
    </view>

    <view wx:elif="{{wholeLoading}}" class="state-card">正在加载整书预览...</view>

    <view wx:else class="whole-book">
      <view
        wx:for="{{wholeChapters}}"
        wx:key="chapter_id"
        wx:for-item="chapter"
        class="whole-chapter"
      >
        <text class="chapter-label">{{chapter.index_text}}</text>
        <text class="chapter-title">{{chapter.title}}</text>
        <view
          wx:for="{{chapter.sections}}"
          wx:key="section_id"
          wx:for-item="section"
          class="whole-section"
        >
          <text class="section-title">{{section.title}}</text>
          <text class="section-content" selectable>{{section.content}}</text>
        </view>
        <text wx:if="{{!chapter.sections.length}}" class="section-content" selectable>{{chapter.content}}</text>
      </view>
    </view>

    <view wx:if="{{proposal.can_apply}}" class="revision-intro feedback-card">
      <text class="chapter-label">继续调整</text>
      <text class="chapter-title">这版还需要怎么改？</text>
      <text class="revision-summary">
        输入或说出意见，AI 会更新当前预览；确认使用前不会写入正式书稿。
      </text>
      <textarea
        class="feedback-input"
        value="{{feedbackText}}"
        maxlength="1000"
        disabled="{{busy || feedbackBusy || feedbackVoicePhase !== 'idle'}}"
        placeholder="请输入希望保留或继续调整的内容"
        bindinput="changeFeedbackText"
      />
      <view class="feedback-actions">
        <view
          class="feedback-voice secondary-action ui-block-action ui-pressable {{feedbackVoicePhase === 'listening' ? 'recording' : ''}} {{busy || feedbackBusy || feedbackVoicePhase === 'transcribing' ? 'is-disabled' : ''}}"
          aria-role="button"
          aria-disabled="{{busy || feedbackBusy || feedbackVoicePhase === 'transcribing'}}"
          bindtap="toggleFeedbackVoice"
        >{{feedbackVoicePhase === "listening" ? "结束录音" : (feedbackVoicePhase === "transcribing" ? "正在识别…" : "语音输入")}}</view>
        <view
          class="primary-action ui-block-action ui-pressable {{busy || feedbackBusy || feedbackVoicePhase !== 'idle' ? 'is-disabled' : ''}}"
          aria-role="button"
          aria-disabled="{{busy || feedbackBusy || feedbackVoicePhase !== 'idle'}}"
          bindtap="submitFeedback"
        >{{feedbackBusy ? "正在调整…" : "按意见调整"}}</view>
      </view>
      <text wx:if="{{feedbackBusy}}" class="revision-meta">
        AI 正在更新修改预览，离开页面后任务也会继续。
      </text>
    </view>

    <view wx:if="{{error}}" class="ui-error-banner">{{error}}</view>

    <view class="revision-actions">
      <view
        wx:if="{{proposal.can_apply}}"
        class="primary-action ui-block-action ui-pressable {{busy || feedbackBusy || feedbackVoicePhase !== 'idle' ? 'is-disabled' : ''}}"
        aria-role="button"
        aria-disabled="{{busy || feedbackBusy || feedbackVoicePhase !== 'idle'}}"
        bindtap="applyRevision"
      >{{feedbackBusy ? "请等待调整完成" : (busy ? "正在确认…" : "确认使用这版修改")}}</view>
      <view
        wx:if="{{proposal.can_dismiss}}"
        class="secondary-action ui-block-action ui-pressable {{busy || feedbackBusy || feedbackVoicePhase !== 'idle' ? 'is-disabled' : ''}}"
        aria-role="button"
        aria-disabled="{{busy || feedbackBusy || feedbackVoicePhase !== 'idle'}}"
        bindtap="dismissRevision"
      >放弃这版修改</view>
      <view
        wx:if="{{proposal.status === 'applied'}}"
        class="primary-action ui-block-action ui-pressable"
        aria-role="button"
        bindtap="openAppliedBook"
      >查看修改后的书稿</view>
    </view>
  </block>
</view>
