.revision-page {
  padding: 32rpx 28rpx 72rpx;
  color: var(--ui-text-primary);
}

.revision-intro,
.changed-chapter,
.whole-chapter,
.state-card {
  border-radius: 20rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow);
}

.revision-intro {
  padding: 36rpx 30rpx;
}

.revision-kicker,
.revision-title,
.revision-summary,
.revision-meta,
.status-notice,
.chapter-label,
.chapter-title,
.section-label,
.section-title,
.section-content {
  display: block;
  overflow-wrap: anywhere;
}

.revision-kicker,
.chapter-label,
.section-label {
  color: var(--ui-section-title);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.revision-title {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 54rpx;
  text-wrap: balance;
}

.revision-summary,
.status-notice {
  text-wrap: pretty;
}

.revision-summary {
  margin-top: 18rpx;
  color: var(--ui-text-secondary);
  font-size: 27rpx;
  line-height: 42rpx;
}

.revision-meta {
  margin-top: 16rpx;
  color: var(--ui-text-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}

.status-notice {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 10rpx;
  background: var(--ui-surface-subtle);
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 38rpx;
}

.status-notice.success {
  background: var(--ui-success-surface);
  color: var(--ui-success-text);
}

.status-notice.error {
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
}

.mode-switch,
.version-switch {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: var(--ui-surface-subtle);
}

.version-switch {
  position: sticky;
  top: 16rpx;
  z-index: 4;
  box-shadow: var(--ui-card-shadow-raised);
}

.mode-option,
.version-option {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  color: var(--ui-text-secondary);
  font-size: 27rpx;
  font-weight: 700;
}

.mode-option.active,
.version-option.active {
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  box-shadow: var(--ui-control-shadow);
}

.changed-list,
.whole-book {
  margin-top: 24rpx;
}

.changed-chapter,
.whole-chapter {
  margin-top: 20rpx;
  padding: 30rpx 26rpx;
}

.chapter-title {
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 48rpx;
  text-wrap: balance;
}

.changed-section,
.whole-section {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.section-title {
  margin-top: 4rpx;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-wrap: balance;
}

.section-content {
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: 28rpx;
  line-height: 48rpx;
  white-space: pre-wrap;
}

.order-after-title {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.order-item {
  display: block;
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: 27rpx;
  line-height: 42rpx;
}

.state-card {
  margin-top: 24rpx;
  padding: 30rpx;
  color: var(--ui-text-secondary);
  font-size: 27rpx;
  line-height: 42rpx;
}

.revision-page .ui-error-banner {
  margin-top: 24rpx;
}

.feedback-card {
  margin-top: 30rpx;
}

.feedback-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 176rpx;
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: var(--ui-surface-subtle);
  color: var(--ui-text-primary);
  font-size: 27rpx;
  line-height: 42rpx;
}

.feedback-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.feedback-actions .secondary-action {
  margin-top: 0;
}

.feedback-voice.recording {
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
}

.revision-actions {
  margin-top: 30rpx;
}

.primary-action,
.secondary-action {
  border-radius: 12rpx;
  font-size: 29rpx;
  font-weight: 800;
}

.primary-action {
  background: var(--ui-accent);
  color: var(--ui-on-accent);
}

.secondary-action {
  margin-top: 16rpx;
  background: var(--ui-surface);
  color: var(--ui-text-secondary);
  box-shadow: var(--ui-control-shadow);
}
