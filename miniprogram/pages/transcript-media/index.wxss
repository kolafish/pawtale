@import "../../styles/transcript-record.wxss";

.share-video-card {
  background: var(--ui-surface);
}

.share-video-count {
  width: 210rpx;
  max-width: 210rpx;
}

.share-video-count.ready,
.share-video-count.succeeded {
  color: var(--ui-success-text);
}

.share-video-count.running,
.share-video-count.pending {
  color: var(--ui-warning-text);
}

.share-video-count.failed {
  color: var(--ui-danger-text);
}

.share-video-state,
.share-video-error {
  padding: 20rpx;
  border-radius: var(--ui-radius-inner);
  font-size: var(--ui-font-body);
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.share-video-state {
  background: var(--ui-surface-subtle);
  color: var(--ui-text-secondary);
}

.share-video-error {
  margin-bottom: 18rpx;
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
}

.share-video-segments {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.share-video-segment {
  position: relative;
  min-height: 88rpx;
  padding: 18rpx 58rpx 18rpx 20rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
  box-shadow: var(--ui-control-shadow);
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.share-video-segment::after,
.share-video-background-option::after {
  content: "";
  position: absolute;
  top: 50%;
  right: 20rpx;
  width: 18rpx;
  height: 18rpx;
  border: 2rpx solid var(--ui-border);
  border-radius: 50%;
  transform: translateY(-50%);
}

.share-video-segment:active,
.share-video-background-option:active {
  transform: scale(0.96);
}

.share-video-segment.selected,
.share-video-background-option.selected {
  background: var(--ui-success-surface);
  box-shadow: 0 0 0 1rpx rgba(88, 112, 82, 0.1);
}

.share-video-segment.selected::after,
.share-video-background-option.selected::after {
  border-color: var(--ui-success-text);
  background: var(--ui-success-text);
  box-shadow: inset 0 0 0 5rpx var(--ui-success-surface);
}

.share-video-segment.disabled {
  opacity: 0.5;
}

.share-video-segment-text,
.share-video-segment-meta,
.share-video-selection-text,
.share-video-selection-meta,
.voice-edit-label,
.share-video-background-help,
.share-video-background-label,
.share-video-background-desc,
.custom-background-status,
.share-video-job-title,
.share-video-job-meta {
  display: block;
}

.share-video-segment-text,
.share-video-selection-text {
  color: var(--ui-text-primary);
  font-size: var(--ui-font-body);
  line-height: 1.58;
  overflow-wrap: anywhere;
}

.share-video-segment-meta,
.share-video-selection-meta {
  margin-top: 7rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-caption);
  font-weight: 700;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
}

.share-video-selection {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-success-surface);
}

.share-video-selection-head,
.share-video-background-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.share-video-selection-text {
  margin-top: 10rpx;
  font-family: var(--ui-font-editorial);
}

.share-video-selection-meta {
  color: var(--ui-success-text);
}

.voice-edit-label {
  color: var(--ui-section-title);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 1.4;
}

.share-video-background {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.share-video-background-current {
  color: var(--ui-value-text);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 1.4;
}

.share-video-background-help {
  margin-top: 8rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  text-wrap: pretty;
}

.share-video-background-options {
  margin-top: 14rpx;
  display: grid;
  gap: 10rpx;
}

.share-video-background-option {
  position: relative;
  min-height: 88rpx;
  padding: 16rpx 58rpx 16rpx 18rpx;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface-soft);
  box-shadow: var(--ui-control-shadow);
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.share-video-background-label {
  color: var(--ui-text-primary);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 1.4;
}

.share-video-background-desc {
  margin-top: 4rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  text-wrap: pretty;
}

.custom-background-panel {
  padding: 22rpx;
  border: 0;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
}

.custom-background-preview-wrap {
  width: 100%;
  height: 336rpx;
  margin-top: 16rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: var(--ui-surface-subtle);
}

.custom-background-preview {
  display: block;
  width: 100%;
  height: 100%;
  outline: 1rpx solid rgba(0, 0, 0, 0.1);
  outline-offset: -1rpx;
}

.custom-background-status {
  margin-top: 12rpx;
  color: var(--ui-section-title);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.custom-background-status.muted {
  color: var(--ui-text-secondary);
  font-weight: 400;
}

.share-video-actions {
  flex-direction: column;
  align-items: stretch;
}

.share-video-actions .primary-button,
.share-video-actions .ghost-button {
  width: 100%;
  flex: none;
  justify-content: flex-start;
  text-align: left;
}

.material-image-button {
  color: var(--ui-accent-strong);
}

.share-video-task-progress {
  display: block;
  margin-top: 18rpx;
}

.share-video-job {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-subtle);
}

.share-video-job.succeeded {
  background: var(--ui-success-surface);
}

.share-video-job.failed {
  background: var(--ui-danger-surface);
}

.share-video-job-title {
  color: var(--ui-section-title);
  font-size: var(--ui-font-list-title);
  font-weight: 700;
  line-height: 1.4;
}

.share-video-job.succeeded .share-video-job-title {
  color: var(--ui-success-text);
}

.share-video-job.failed .share-video-job-title {
  color: var(--ui-danger-text);
}

.share-video-job-meta {
  margin-top: 6rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-caption);
  line-height: 1.4;
}

.material-image-job {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.material-image-job-copy {
  min-width: 0;
  flex: 1;
}

.material-image-toolbox-link {
  flex: 0 0 auto;
  min-height: 88rpx;
  padding: 0 8rpx;
}

.share-video-preview {
  width: 100%;
  height: 360rpx;
  margin-top: 18rpx;
  border-radius: var(--ui-radius-inner);
  overflow: hidden;
  background: var(--ui-text-primary);
  outline: 1rpx solid rgba(0, 0, 0, 0.1);
  outline-offset: -1rpx;
  box-shadow: var(--ui-card-shadow);
}

.share-video-preview.is-portrait {
  display: block;
  height: 64vh;
}

.share-video-result-card .share-video-preview,
.share-video-result-card .share-video-task-progress {
  margin-top: 0;
}

.share-video-forward {
  width: 100%;
  margin-top: 22rpx;
}

.share-video-forward-hint {
  display: block;
  margin-top: 10rpx;
}

.share-video-more {
  display: block;
  margin: 18rpx auto 0;
}

.share-video-result-actions {
  margin-top: 22rpx;
}

.share-video-result-failed .primary-button,
.share-video-retry {
  width: 100%;
  margin-top: 18rpx;
}

.detail-page.large-text .share-video-state,
.detail-page.large-text .share-video-error,
.detail-page.large-text .share-video-background-label,
.detail-page.large-text .custom-background-status,
.detail-page.large-text .share-video-job-title,
.detail-page.large-text .voice-edit-label {
  font-size: var(--ui-font-large-body);
  line-height: 1.55;
}

.detail-page.large-text .share-video-segment-text,
.detail-page.large-text .share-video-selection-text {
  font-size: 34rpx;
  line-height: 1.7;
}

.detail-page.large-text .share-video-segment-meta,
.detail-page.large-text .share-video-selection-meta,
.detail-page.large-text .share-video-background-current,
.detail-page.large-text .share-video-background-desc,
.detail-page.large-text .share-video-background-help,
.detail-page.large-text .share-video-job-meta {
  font-size: var(--ui-font-large-meta);
  line-height: 1.5;
}

.share-video-hook {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
}

.share-video-hook-copy {
  flex: 1;
  min-width: 0;
}

.share-video-hook-text {
  display: block;
  margin-top: 6rpx;
  color: var(--ui-text-primary);
  font-size: var(--ui-font-body);
  line-height: 1.5;
}
