<import src="../../templates/share-likes.wxml" />
<import src="../../templates/video-playback.wxml" />
<view class="ui-page-shell {{pageClass}}">
  <view class="ui-page-context-row">
    <text class="ui-page-context">{{item ? (item.project_title || "我的回忆录") : "做成图片或视频"}}</text>
  </view>

  <view wx:if="{{error}}" class="error ui-error-banner">{{error}}</view>

  <view wx:if="{{needsLogin}}" class="empty-panel">
    <text class="empty-title">登录后制作图片和视频</text>
    <text class="empty-copy">登录后选择讲述片段制作。</text>
    <view class="primary-button login-entry-action ui-block-action ui-pressable" aria-role="button" bindtap="openLogin">
      前往登录
    </view>
  </view>

  <view wx:elif="{{loading && !item}}" class="empty-panel">
    <text>正在加载</text>
  </view>

  <view wx:elif="{{!item}}" class="empty-panel">
    <text class="empty-title">没有找到这段讲述</text>
    <text class="empty-copy">这条讲述记录可能已删除，或不属于当前账号。</text>
  </view>

  <view wx:elif="{{viewMode === 'create' && item.canRecoverTranscription}}" class="empty-panel">
    <text class="empty-title">转写完成后再制作</text>
    <text class="empty-copy">原音已保存，文字恢复后即可制作。</text>
  </view>

  <block wx:else>
    <block wx:if="{{viewMode === 'video'}}">
      <view class="hero-panel">
        <text class="record-title">{{shareVideoJob ? (shareVideoJob.title || item.titleText) : "分享视频"}}</text>
        <text class="record-meta">来自“{{item.titleText}}”的口述回忆</text>
      </view>

      <view class="section-card share-video-card share-video-result-card">
        <view wx:if="{{loading && !shareVideoJob}}" class="share-video-state">正在打开视频</view>
        <view wx:if="{{shareVideoError && (!shareVideoJob || shareVideoJob.status !== 'failed')}}" class="share-video-error">{{shareVideoError}}</view>

        <ai-task-progress
          wx:if="{{shareVideoCreating && !shareVideoJob}}"
          class="share-video-task-progress"
          title="{{shareVideoStatusText || '正在创建视频任务'}}"
          detail="提交成功后会继续显示制作进度"
          mode="indeterminate"
        />
        <block wx:elif="{{shareVideoJob && shareVideoJob.status === 'succeeded'}}">
          <video
            wx:if="{{shareVideoStreamUrl}}"
            id="memoir-video"
            class="share-video-preview {{shareVideoPreviewPortrait ? 'is-portrait' : ''}}"
            src="{{shareVideoStreamUrl}}"
            bindloadedmetadata="markShareVideoPreviewShape"
            binderror="markShareVideoStreamError"
            bindplay="applyVideoPlaybackRate"
            bindfullscreenchange="closeVideoSpeedMenu"
            bindended="closeVideoSpeedMenu"
            controls
            show-center-play-btn
            enable-progress-gesture
            object-fit="contain"
          >
            <template is="videoPlaybackSpeed" data="{{videoPlaybackRate, videoPlaybackRates, videoSpeedMenuOpen}}" />
          </video>
          <view class="ui-share-actions share-video-forward">
            <button
              class="ui-share-primary"
              open-type="{{shareVideoJob.output.share_enabled ? 'share' : ''}}"
              bindtap="prepareVideoShare"
              loading="{{shareCardPreparing}}"
              disabled="{{shareVideoSharing || shareVideoDeleting || shareCardPreparing}}"
            >分享给好友</button>
            <button class="ui-share-more" aria-label="分享更多操作" bindtap="openShareVideoMoreActions" disabled="{{shareVideoSharing || shareVideoDeleting || shareCardPreparing}}">···</button>
          </view>
          <text class="record-meta share-video-forward-hint">本视频 · 好友点开即可观看；可在更多中停止分享。导出的文件无法撤回。</text>
          <view class="actions-row share-video-actions share-video-result-actions">
            <button
              class="ghost-button"
              bindtap="saveShareVideoToAlbum"
              loading="{{shareVideoSharing && shareVideoStatusText === '正在保存到相册'}}"
              disabled="{{shareVideoSharing || shareVideoDeleting || shareCardPreparing}}"
            >保存到相册</button>
            <button
              class="ghost-button"
              bindtap="shareGeneratedVideo"
              loading="{{shareVideoSharing && shareVideoStatusText === '正在准备分享'}}"
              disabled="{{shareVideoSharing || shareVideoDeleting || shareCardPreparing}}"
            >发送视频文件</button>
          </view>
          <view wx:if="{{shareVideoLikeCount}}" class="share-video-likes">
            <template is="shareLikeList" data="{{count: shareVideoLikeCount, likers: shareVideoLikers}}" />
          </view>
        </block>

        <block wx:elif="{{shareVideoJob && (shareVideoJob.status === 'pending' || shareVideoJob.status === 'running')}}">
          <ai-task-progress
            wx:if="{{shareVideoPolling}}"
            class="share-video-task-progress"
            title="{{shareVideoStatusText || '正在生成视频'}}"
            detail="配图和合成可能需要几分钟，完成后可先预览，再决定是否分享"
            mode="indeterminate"
          />
          <button wx:else class="ghost-button share-video-retry" bindtap="refreshShareVideoJob">重新查看进度</button>
        </block>

        <view wx:elif="{{shareVideoJob && shareVideoJob.status === 'failed'}}" class="share-video-result-failed">
          <text class="share-video-job-title">{{shareVideoStatusText || '视频生成失败'}}</text>
          <button class="primary-button" bindtap="remakeShareVideo">重新制作</button>
          <button class="ghost-button share-video-retry" bindtap="deleteShareVideo" loading="{{shareVideoDeleting}}" disabled="{{shareVideoDeleting}}">删除这次失败的记录</button>
        </view>
        <view wx:elif="{{!loading}}" class="share-video-state">暂时无法查看这段视频</view>
      </view>
    </block>

    <view wx:if="{{viewMode === 'create'}}" class="hero-panel">
      <text class="record-title">做成图片或视频</text>
      <text class="record-meta">来自“{{item.titleText}}”</text>
    </view>

    <view wx:if="{{viewMode === 'create'}}" class="section-card share-video-card">
      <view class="section-head">
        <view class="section-heading">
          <text class="section-title">选择文字片段</text>
          <text class="section-hint">点选起止句，中间自动选上</text>
        </view>
        <text class="section-count share-video-count {{(materialImageCreating || materialImagePolling) ? materialImageStatusClass : ((shareVideoCreating || shareVideoPolling || shareVideoDownloadingPreview) ? shareVideoStatusClass : (materialImageStatusClass || shareVideoStatusClass))}}">
          {{(materialImageCreating || materialImagePolling) ? (materialImageStatusText || "图片生成中") : ((shareVideoCreating || shareVideoPolling || shareVideoDownloadingPreview) ? (shareVideoStatusText || "视频生成中") : (materialImageStatusText || shareVideoStatusText || "未生成"))}}
        </text>
      </view>

      <view wx:if="{{shareVideoLoadingContext}}" class="share-video-state">
        <text>正在加载讲述文字</text>
      </view>
      <block wx:else>
        <view wx:if="{{shareVideoError}}" class="share-video-error">
          <text>{{shareVideoError}}</text>
        </view>
        <view wx:if="{{materialImageError}}" class="share-video-error">
          <text>{{materialImageError}}</text>
        </view>
        <view wx:if="{{shareVideoSegments.length}}" class="share-video-segments" aria-label="选择连续文字片段">
          <view
            wx:for="{{shareVideoSegments}}"
            wx:for-item="segment"
            wx:for-index="segmentIndex"
            wx:key="segmentIndex"
            class="share-video-segment {{segment.className}}"
            data-index="{{segment.arrayIndex}}"
            bindtap="selectShareVideoSegment"
            aria-role="button"
            aria-pressed="{{segment.selected}}"
            aria-disabled="{{!segment.selectable}}"
          >
            <text class="share-video-segment-text">{{segment.text}}</text>
            <text class="share-video-segment-meta">{{segment.timeRangeText}} · {{segment.durationText}}</text>
          </view>
        </view>
        <view wx:if="{{shareVideoSelectedText}}" class="share-video-selection">
          <view class="share-video-selection-head">
            <text class="voice-edit-label">已选片段</text>
            <button
              class="text-action-button"
              bindtap="clearShareVideoSelection"
              disabled="{{shareVideoCreating || shareVideoPolling || shareVideoDownloadingPreview || shareVideoSharing || shareVideoPhotoBusy || materialImageCreating || materialImagePolling}}"
            >
              重选
            </button>
          </view>
          <text class="share-video-selection-text">{{shareVideoSelectedText}}</text>
          <text class="share-video-selection-meta">{{shareVideoSelectedMetaText}}</text>
        </view>

        <view wx:if="{{shareVideoSelectedText && shareVideoHookChoices.length}}" class="share-video-hook">
          <view class="share-video-hook-copy">
            <text class="voice-edit-label">开场一句</text>
            <text class="share-video-hook-text">{{shareVideoHookText ? '“' + shareVideoHookText + '”' : '自动挑一句最打动人的话'}}</text>
          </view>
          <button class="text-action-button" bindtap="chooseShareVideoHook" disabled="{{shareVideoCreating || shareVideoPolling}}">换一句</button>
        </view>

        <view class="share-video-background">
          <view class="share-video-background-head">
            <text class="voice-edit-label">本次视频风格</text>
            <text class="share-video-background-current">{{shareVideoStyleLabel}}</text>
          </view>
          <view class="share-video-background-options" aria-role="radiogroup" aria-label="本次视频风格">
            <view
              wx:for="{{shareVideoStyleOptions}}"
              wx:key="value"
              class="share-video-background-option {{item.value === shareVideoStyle ? 'selected' : ''}}"
              data-video-style="{{item.value}}"
              bindtap="selectShareVideoStyle"
              aria-role="radio"
              aria-checked="{{item.value === shareVideoStyle}}"
              aria-label="{{item.label}}，{{item.description}}"
            >
              <text class="share-video-background-label">{{item.label}}</text>
              <text class="share-video-background-desc">{{item.description}}</text>
            </view>
          </view>
          <text wx:if="{{shareVideoStyleUnavailable}}" class="share-video-background-help">AI配图暂不可用，请选择「自己配图」。</text>
        </view>

        <view wx:if="{{shareVideoUsesIllustration}}" class="share-video-background">
          <view class="share-video-background-head">
            <text class="voice-edit-label">画风和张数</text>
            <button class="text-action-button" bindtap="toggleShareVideoMoreSettings">{{shareVideoMoreSettingsOpen ? "收起" : "调整"}}</button>
          </view>
          <text wx:if="{{!shareVideoMoreSettingsOpen}}" class="share-video-background-help">{{shareVideoBackgroundStyleLabel}}，张数：{{shareVideoBackgroundModeLabel}}</text>
        </view>

        <view wx:if="{{shareVideoBackgroundUsesAi}}" class="share-video-background">
          <view class="share-video-background-head">
            <text class="voice-edit-label">人物背景（选填）</text>
          </view>
          <text class="share-video-background-help">人物身份、年龄和关系（选填）。</text>
          <textarea
            class="share-video-note-input"
            value="{{shareVideoBackgroundNote}}"
            bindinput="changeShareVideoBackgroundNote"
            placeholder="例如：我和妹妹，那年我十岁"
            maxlength="300"
            auto-height
            cursor-spacing="24"
            disabled="{{shareVideoCreating || shareVideoPolling}}"
          />
        </view>

        <view wx:if="{{shareVideoUsesIllustration && shareVideoMoreSettingsOpen}}" class="share-video-background">
          <view class="share-video-background-head">
            <text class="voice-edit-label">插图风格</text>
            <text class="share-video-background-current">{{shareVideoBackgroundStyleLabel}}</text>
          </view>
          <text class="share-video-background-help">画风示意，内容按讲述生成。</text>
          <view class="share-video-background-options" aria-role="radiogroup" aria-label="插图风格">
            <view
              wx:for="{{shareVideoBackgroundStyleOptions}}"
              wx:key="value"
              class="share-video-background-option share-video-style-option {{item.value === shareVideoBackgroundStyle ? 'selected' : ''}}"
              data-background-style="{{item.value}}"
              bindtap="selectShareVideoBackgroundStyle"
              aria-role="radio"
              aria-checked="{{item.value === shareVideoBackgroundStyle}}"
              aria-label="{{item.label}}，{{item.description}}"
            >
              <image wx:if="{{item.previewImage}}" class="share-video-style-preview" src="{{item.previewImage}}" mode="aspectFill" aria-hidden="true" />
              <view class="share-video-style-copy">
                <text class="share-video-background-label">{{item.label}}</text>
                <text class="share-video-background-desc">{{item.description}}</text>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{shareVideoBackgroundUsesAi && shareVideoMoreSettingsOpen}}" class="share-video-background">
          <view class="share-video-background-head">
            <text class="voice-edit-label">视频画面模式</text>
            <text class="share-video-background-current">{{shareVideoBackgroundModeLabel}}</text>
          </view>
          <view class="share-video-background-options" aria-role="radiogroup" aria-label="视频画面模式">
            <view
              wx:for="{{shareVideoBackgroundModeOptions}}"
              wx:key="value"
              class="share-video-background-option {{item.value === shareVideoBackgroundMode ? 'selected' : ''}}"
              data-background-mode="{{item.value}}"
              bindtap="selectShareVideoBackgroundMode"
              aria-role="radio"
              aria-checked="{{item.value === shareVideoBackgroundMode}}"
              aria-label="{{item.label}}，{{item.description}}"
            >
              <text class="share-video-background-label">{{item.label}}</text>
              <text class="share-video-background-desc">{{item.description}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{shareVideoBackgroundUsesCustom}}" class="share-video-background custom-background-panel">
          <view class="share-video-background-head">
            <text class="voice-edit-label">视频里的照片</text>
            <text class="share-video-background-current">{{shareVideoPhotoIds.length}}/{{shareVideoPhotoMaxCount}}</text>
          </view>
          <share-video-photos
            project-id="{{item.project_id}}"
            photo-ids="{{shareVideoPhotoIds}}"
            max-count="{{shareVideoPhotoMaxCount}}"
            disabled="{{shareVideoCreating || shareVideoPolling || shareVideoDownloadingPreview || shareVideoSharing || materialImageCreating || materialImagePolling}}"
            bindchange="changeShareVideoPhotos"
            bindbusy="markShareVideoPhotoBusy"
            binderror="showShareVideoPhotoError"
          />
        </view>

        <view class="actions-row share-video-actions">
          <button
            class="ghost-button material-image-button"
            bindtap="createMaterialImage"
            loading="{{materialImageCreating || materialImagePolling}}"
            disabled="{{!shareVideoSelectedText || materialImageCreating || materialImagePolling || shareVideoCreating || shareVideoPolling || shareVideoDownloadingPreview || shareVideoSharing || shareVideoPhotoBusy}}"
          >
            {{materialImageCreating || materialImagePolling ? "生成中" : "生成图片"}}
          </button>
          <view wx:if="{{shareVideoSelectedText && !shareVideoSelectedCanGenerate}}" class="share-video-error" aria-live="polite">
            <text>{{shareVideoStatusText}}，请调整所选句子后再生成视频。</text>
          </view>
          <button
            class="primary-button"
            bindtap="createShareVideo"
            loading="{{shareVideoCreating || shareVideoPolling || shareVideoDownloadingPreview}}"
            disabled="{{!shareVideoSelectedCanGenerate || shareVideoStyleUnavailable || shareVideoCreating || shareVideoPolling || shareVideoDownloadingPreview || shareVideoSharing || shareVideoPhotoBusy || materialImageCreating || materialImagePolling}}"
          >
            {{shareVideoDownloadingPreview ? "准备预览" : (shareVideoCreating || shareVideoPolling ? "生成中" : "生成视频")}}
          </button>
        </view>

        <ai-task-progress
          wx:if="{{materialImageCreating || materialImagePolling}}"
          class="share-video-task-progress"
          title="{{materialImageStatusText || '正在生成图片'}}"
          detail="完成后会自动放入图片素材，默认不收入书稿"
          mode="indeterminate"
        />
        <view wx:elif="{{materialImageJob}}" class="share-video-job {{materialImageStatusClass}} material-image-job">
          <view class="material-image-job-copy">
            <text class="share-video-job-title">{{materialImageStatusText}}</text>
            <text wx:if="{{materialImageJob.status === 'succeeded'}}" class="share-video-job-meta">尚未入书，可到图片素材中选择位置。</text>
          </view>
          <button
            wx:if="{{materialImageJob.status === 'succeeded'}}"
            class="text-action-button material-image-toolbox-link"
            bindtap="openImageAssets"
          >
            去图片素材
          </button>
        </view>

        <ai-task-progress
          wx:if="{{shareVideoCreating}}"
          class="share-video-task-progress"
          title="{{shareVideoStatusText || '正在生成视频'}}"
          detail="{{shareVideoSelectedMetaText}}"
          mode="indeterminate"
        />
      </block>
    </view>
  </block>

  <view class="bottom-spacer"></view>
</view>
