.voice-authorization-page {
  --ui-fixed-action-space: 168rpx;
  padding-top: 28rpx;
  padding-right: 36rpx;
  padding-left: 36rpx;
}

.agreement-panel {
  padding: 32rpx;
}

.section + .section {
  margin-top: 30rpx;
}

.paragraph {
  display: block;
  margin-top: 12rpx;
  color: var(--ui-text-primary);
  font-size: 29rpx;
  line-height: 1.65;
  word-break: break-word;
}

.actions {
  --ui-fixed-action-inline: 36rpx;
  --ui-fixed-action-background: rgba(255, 250, 242, 0.96);
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
  gap: 18rpx;
}

.ghost-button,
.primary-button {
  height: 96rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.ghost-button {
  background: var(--ui-accent-surface);
  color: var(--ui-section-title);
}

.primary-button {
  background: var(--ui-accent);
  color: var(--ui-on-accent);
}
