.voice-authorization-page {
  min-height: 100vh;
  padding: 44rpx 36rpx 160rpx;
  background: #fffaf2;
  box-sizing: border-box;
}

.header {
  margin-bottom: 26rpx;
}

.page-title {
  display: block;
  color: #24100b;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.2;
}

.page-meta {
  display: block;
  margin-top: 10rpx;
  color: #685b55;
  font-size: 25rpx;
  line-height: 1.35;
}

.agreement-panel {
  padding: 32rpx;
  border: 2rpx solid #f0dac0;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(64, 43, 24, 0.07);
}

.section + .section {
  margin-top: 30rpx;
}

.section-title {
  display: block;
  color: #7a3b31;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.paragraph {
  display: block;
  margin-top: 12rpx;
  color: #24100b;
  font-size: 29rpx;
  line-height: 1.65;
  word-break: break-word;
}

.actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 36rpx 42rpx;
  background: rgba(255, 250, 242, 0.96);
  border-top: 2rpx solid #f0dac0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
  gap: 18rpx;
  box-sizing: border-box;
}

.ghost-button,
.primary-button {
  height: 96rpx;
  margin: 0;
  border: 0;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
}

.ghost-button::after,
.primary-button::after {
  border: 0;
}

.ghost-button {
  background: #fff1ec;
  color: #7a3b31;
}

.primary-button {
  background: #9f4a3c;
  color: #ffffff;
}
