<view class="ui-page-shell {{pageClass}}">
  <view wx:if="{{loading && !video}}" class="empty-panel">
    <text class="empty-copy">正在打开视频</text>
  </view>

  <view wx:elif="{{error && !video}}" class="empty-panel">
    <text class="empty-title">{{error}}</text>
    <button class="ghost-button shared-video-action" bindtap="loadVideo">重新加载</button>
    <button class="primary-button shared-video-action" bindtap="openHome">看看老余口述</button>
  </view>

  <block wx:elif="{{video}}">
    <image wx:if="{{!videoUrl}}" class="shared-video is-portrait" src="{{posterUrl}}" mode="aspectFill" />
    <block wx:elif="{{ended}}">
      <image
        class="shared-video is-portrait"
        src="{{endFrameUrl}}"
        mode="aspectFit"
        show-menu-by-longpress
        aria-label="视频结尾，长按识别小程序码"
      />
      <button class="ghost-button shared-video-action" bindtap="replayVideo">重新播放</button>
    </block>
    <video
      wx:else
      class="shared-video {{portrait ? 'is-portrait' : ''}}"
      src="{{videoUrl}}"
      poster="{{posterUrl}}"
      bindloadedmetadata="markVideoShape"
      bindended="holdEndFrame"
      binderror="markVideoError"
      controls
      autoplay
      show-center-play-btn
      enable-progress-gesture
      object-fit="contain"
    />
    <view wx:if="{{error}}" class="error ui-error-banner">{{error}}</view>
    <button wx:if="{{error}}" class="ghost-button shared-video-action" bindtap="loadVideo">重新加载</button>
    <button class="ui-button shared-video-invitation" bindtap="openHome" hover-class="ui-accent-action-hover" aria-label="也为家里的长辈留下一本回忆录，去讲讲故事">
      <view class="shared-video-invitation-title">
        <text>也为家里的长辈，</text>
        <text>留下一本回忆录</text>
      </view>
      <view class="shared-video-invitation-art" aria-hidden="true">
        <image src="/assets/memoir-book-header.png" mode="widthFix" aria-hidden="true" />
      </view>
      <view class="shared-video-invitation-action">
        <text>去讲讲故事</text><text aria-hidden="true">→</text>
      </view>
    </button>
    <button wx:if="{{video.book_share_token}}" class="ghost-button shared-video-action" bindtap="openBook">阅读这本回忆录</button>
  </block>
</view>
