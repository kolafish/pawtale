<import src="../../templates/share-likes.wxml" />
<import src="../../templates/video-playback.wxml" />
<view class="ui-page-shell {{pageClass}}">
  <text wx:if="{{sharePreview}}" class="share-preview-notice">好友将看到这些内容</text>
  <view wx:if="{{loading && !video}}" class="empty-panel">
    <text class="empty-copy">正在打开视频</text>
  </view>

  <view wx:elif="{{error && !video}}" class="empty-panel">
    <text class="empty-title">{{error}}</text>
    <button wx:if="{{retryable}}" class="ui-share-primary" bindtap="loadVideo">重试</button>
    <button class="primary-button shared-video-action" bindtap="openHome">返回首页</button>
  </view>

  <block wx:elif="{{video}}">
    <image wx:if="{{!videoUrl}}" class="shared-video is-portrait" src="{{posterUrl}}" mode="aspectFill" />
    <block wx:elif="{{ended}}">
      <image
        class="shared-video is-portrait"
        src="{{endFrameUrl}}"
        mode="aspectFit"
        show-menu-by-longpress
        aria-label="视频结尾，长按识别小程序码"
      />
      <button class="ghost-button shared-video-action" bindtap="replayVideo">重新播放</button>
    </block>
    <video
      wx:else
      id="memoir-video"
      class="shared-video {{portrait ? 'is-portrait' : ''}}"
      src="{{videoUrl}}"
      poster="{{posterUrl}}"
      bindloadedmetadata="markVideoShape"
      bindended="holdEndFrame"
      binderror="markVideoError"
      bindplay="applyVideoPlaybackRate"
      bindfullscreenchange="closeVideoSpeedMenu"
      controls
      autoplay
      show-center-play-btn
      enable-progress-gesture
      object-fit="contain"
    >
      <template is="videoPlaybackSpeed" data="{{videoPlaybackRate, videoPlaybackRates, videoSpeedMenuOpen}}" />
    </video>
    <view wx:if="{{error}}" class="error ui-error-banner">{{error}}</view>
    <button wx:if="{{error}}" class="ghost-button shared-video-action" bindtap="loadVideo">重新加载</button>
    <view class="shared-video-heading"><text class="shared-video-title">{{video.title}}</text><text wx:if="{{video.narrator_name}}">{{video.narrator_name}} 口述</text></view>
    <template is="shareLikeBar" data="{{shareLikeVisible, shareLiked, shareCanLike, shareLikeBusy, shareLikeAvatars, shareLikeText, shareLikeProfileMissing, shareForward: !sharePreview}}" />
  </block>
  <view wx:if="{{responseCode && !sharePreview}}" hidden="{{loading || error || !video}}">
    <share-response-form id="shared-response" video-code="{{responseCode}}" bindunavailable="onResponseUnavailable" />
  </view>
  <button wx:if="{{video && !sharePreview}}" class="ui-share-more" bindtap="openHome">我也想讲故事</button>
</view>
