@import "../../styles/transcript-record.wxss";

.shared-video {
  display: block;
  width: 100%;
  height: 420rpx;
  border-radius: var(--ui-radius-card);
  background: #000;
}

.shared-video.is-portrait {
  height: 72vh;
}

.shared-video-action {
  margin-top: 20rpx;
}

/* Override style v2's button:not([size=mini]) width and auto margins. */
.shared-video-invitation.ui-button {
  position: relative;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  width: 100%;
  margin: 16rpx 0 0;
  padding: 24rpx;
  overflow: hidden;
  border-radius: var(--ui-radius-card);
  background: linear-gradient(135deg, var(--ui-surface-soft), var(--ui-accent-surface-subtle));
  box-shadow: var(--ui-control-shadow);
  text-align: left;
}

.shared-video-invitation-title {
  position: relative;
  min-width: 0;
  color: var(--ui-accent-strong);
  font-family: var(--ui-font-editorial);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.5;
}

.shared-video-invitation-title text {
  display: block;
}

.shared-video-invitation-art {
  position: absolute;
  right: 96rpx;
  bottom: -20rpx;
  width: 360rpx;
  height: 160rpx;
  opacity: 0.16;
  pointer-events: none;
}

.shared-video-invitation-action {
  position: relative;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: max(88rpx, 44px);
  padding: 12rpx 16rpx;
  border-radius: var(--ui-radius-control);
  background: var(--ui-accent-surface);
  color: var(--ui-accent-strong);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
  white-space: nowrap;
}

.detail-page.large-text .shared-video-invitation-title {
  font-size: 38rpx;
}

.detail-page.large-text .shared-video-invitation-action {
  font-size: var(--ui-font-large-caption);
}
