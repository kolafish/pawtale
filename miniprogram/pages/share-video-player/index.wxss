@import "../../styles/transcript-record.wxss";

.shared-video {
  display: block;
  width: 100%;
  height: 420rpx;
  border-radius: var(--ui-radius-card);
  background: #000;
}

.shared-video.is-portrait {
  height: 72vh;
}

.shared-video-info {
  margin-top: 24rpx;
  padding: 28rpx 28rpx 28rpx 52rpx;
  background: var(--ui-surface);
  box-shadow:
    0 0 0 1rpx rgba(54, 42, 34, 0.025),
    0 6rpx 18rpx rgba(63, 47, 37, 0.035);
}

.shared-video-info::before {
  top: 32rpx;
  left: 20rpx;
  height: 40rpx;
  border-radius: 999rpx;
}

.shared-video-info .record-title {
  font-family: var(--ui-font-sans);
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.shared-video-info .record-meta {
  margin-top: 10rpx;
  font-size: 26rpx;
}

.shared-video-action {
  margin-top: 20rpx;
}

/* Override style v2's button:not([size=mini]) width and auto margins. */
.shared-video-invitation.ui-button {
  position: relative;
  display: block;
  width: 100%;
  margin: 20rpx 0 0;
  padding: 30rpx 32rpx 24rpx;
  overflow: hidden;
  border-radius: var(--ui-radius-card);
  background: linear-gradient(135deg, var(--ui-surface-soft), var(--ui-accent-surface-subtle));
  box-shadow: var(--ui-control-shadow);
  text-align: center;
}

.shared-video-invitation::before {
  content: "";
  position: absolute;
  right: -40rpx;
  bottom: 18rpx;
  width: 430rpx;
  height: 60rpx;
  border-top: 3rpx solid rgba(182, 93, 73, 0.08);
  border-radius: 50%;
  transform: rotate(-5deg);
  pointer-events: none;
}

.shared-video-invitation-title {
  color: var(--ui-accent-strong);
  font-family: var(--ui-font-editorial);
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.4;
}

.shared-video-invitation-title text {
  display: block;
}

.shared-video-invitation-footer {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 12rpx;
}

.shared-video-invitation-art {
  position: relative;
  flex: 0 0 168rpx;
  height: 96rpx;
  overflow: hidden;
  pointer-events: none;
}

.shared-video-invitation-art image {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 310rpx;
  height: 108rpx;
}

.shared-video-invitation-action {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 10rpx;
  padding-bottom: 4rpx;
  color: var(--ui-accent-strong);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
  white-space: nowrap;
}

.detail-page.large-text .shared-video-info .record-title {
  font-size: 40rpx;
}

.detail-page.large-text .shared-video-invitation-title {
  font-size: 46rpx;
}

.detail-page.large-text .shared-video-info .record-meta,
.detail-page.large-text .shared-video-invitation-action {
  font-size: var(--ui-font-large-caption);
}
