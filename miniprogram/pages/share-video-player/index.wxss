@import "../../templates/share-likes.wxss";
@import "../../templates/video-playback.wxss";
@import "../../styles/transcript-record.wxss";

.shared-video {
  display: block;
  width: 100%;
  height: 420rpx;
  border-radius: var(--ui-radius-card);
  background: #000;
}

.shared-video.is-portrait {
  height: 72vh;
}

.shared-video-action {
  margin-top: 20rpx;
}

.shared-video-heading { display: flex; flex-direction: column; gap: 12rpx; margin: 24rpx 0; color: var(--ui-text-secondary); }
.shared-video-title { color: var(--ui-text-primary); font-size: 36rpx; font-weight: 700; line-height: 1.5; overflow-wrap: anywhere; }
.share-preview-notice { display: block; padding: 16rpx 0; color: var(--ui-text-secondary); text-align: center; }
