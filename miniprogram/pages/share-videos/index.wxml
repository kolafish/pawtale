<view class="ui-page-shell {{pageClass}}">
  <view class="ui-page-context-row">
    <text class="ui-page-context">我的回忆录</text>
  </view>

  <view class="hero-panel video-library-hero">
    <text class="record-title">我的分享视频</text>
    <text class="record-meta">{{total ? '已生成 ' + total + ' 段视频，点开可以预览和分享。' : '讲述做成的视频，会收集在这里。'}}</text>
  </view>

  <view wx:if="{{needsLogin}}" class="empty-panel">
    <text class="empty-title">登录后查看分享视频</text>
    <button class="primary-button video-library-action" bindtap="openLogin">前往登录</button>
  </view>

  <view wx:elif="{{!projectId && !loading}}" class="empty-panel">
    <text class="empty-title">还没有回忆录</text>
    <text class="empty-copy">创建回忆录并完成讲述后，就可以制作分享视频。</text>
  </view>

  <block wx:else>
    <view wx:if="{{error}}" class="error ui-error-banner">{{error}}</view>
    <button wx:if="{{error}}" class="ghost-button video-library-action" bindtap="retryLoad">重新加载</button>

    <view wx:if="{{taskItems.length}}" class="video-library-tasks">
      <text class="section-title">视频制作进度</text>
      <view class="video-library-list">
        <view wx:for="{{taskItems}}" wx:key="id" class="section-card video-library-card">
          <text class="video-library-title">《{{item.title}}》</text>
          <text class="video-library-progress {{item.status === 'failed' ? 'is-failed' : ''}}">{{item.status === 'failed' ? '制作失败：' + item.statusText : item.statusText}}</text>
          <text class="video-library-quote">“{{item.selected_text}}”</text>
          <view class="video-library-card-foot">
            <text class="video-library-date">{{item.styleLabel}}</text>
            <button class="video-library-open ui-button" data-id="{{item.id}}" data-utterance-id="{{item.utterance_id}}" bindtap="openVideo">{{item.status === 'failed' ? '查看详情' : '查看进度'}} ›</button>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{loading && !items.length && !taskItems.length}}" class="empty-panel">
      <text>正在读取分享视频</text>
    </view>
    <view wx:elif="{{!items.length && !taskItems.length && !error}}" class="empty-panel">
      <text class="empty-title">还没有分享视频</text>
      <text class="empty-copy">讲述完成后，适合分享的片段可以做成带原声、插图和字幕的视频。</text>
    </view>

    <view wx:if="{{items.length}}" class="video-library-list">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="section-card video-library-card video-library-item ui-pressable"
        data-id="{{item.id}}"
        data-utterance-id="{{item.utterance_id}}"
        bindtap="openVideo"
        aria-role="button"
        aria-label="查看视频《{{item.title}}》"
      >
        <view class="video-library-thumb">
          <image wx:if="{{item.thumbnailUrl}}" class="video-library-thumb-image" src="{{item.thumbnailUrl}}" mode="aspectFill" lazy-load />
          <text class="video-library-duration ui-tabular">{{item.durationText}}</text>
        </view>
        <view class="video-library-body">
          <text class="video-library-title">《{{item.title}}》</text>
          <text class="video-library-quote">“{{item.selected_text}}”</text>
          <text class="video-library-date">{{item.styleLabel}} · {{item.completedAtText}}</text>
        </view>
      </view>
    </view>

    <button wx:if="{{hasMore}}" class="ghost-button video-library-more" bindtap="loadMore" loading="{{loading}}" disabled="{{loading}}">查看更多视频</button>
  </block>

  <view class="bottom-spacer"></view>
</view>
