<page-meta page-style="--ui-navigation-height: {{navigationHeight || 0}}px;" />
<brand-navigation title="{{navigationTitle || '我的分享'}}" page-class="{{pageClass || homePageClass}}" bindlayout="onNavigationLayout" />
<view class="ui-page-shell {{pageClass}}">
  <view class="ui-page-context-row">
    <text class="ui-page-context">我的回忆录</text>
  </view>

  <view class="ui-version-switch library-tabs" aria-role="radiogroup" aria-label="分享类型">
    <view class="ui-version-option ui-pressable {{!cardsOpen ? 'active' : ''}}" aria-role="radio" aria-checked="{{!cardsOpen}}" data-tab="videos" bindtap="switchLibrary">视频</view>
    <view class="ui-version-option ui-pressable {{cardsOpen ? 'active' : ''}}" aria-role="radio" aria-checked="{{cardsOpen}}" data-tab="cards" bindtap="switchLibrary">卡片</view>
  </view>
  <text wx:if="{{total && !cardsOpen}}" class="record-meta">共 {{total}} 段</text>

  <view wx:if="{{needsLogin}}" class="empty-panel">
    <text class="empty-title">登录后查看我的分享</text>
    <button class="primary-button video-library-action" bindtap="openLogin">前往登录</button>
  </view>

  <view wx:elif="{{!projectId && !loading}}" class="empty-panel">
    <text class="empty-title">还没有回忆录</text>
    <text class="empty-copy">创建回忆录并讲述后即可制作。</text>
  </view>

  <block wx:elif="{{cardsOpen}}">
    <text wx:if="{{loading}}" class="record-meta">正在读取卡片…</text>
    <view wx:if="{{error}}" class="ui-error-banner">{{error}}<button bindtap="refreshLibrary">重新读取</button></view>
    <view wx:if="{{!cards.length && !loading && !error}}" class="empty-panel">还没有分享卡片。可在书稿里分享全书、章节或选文。</view>
    <view wx:for="{{cards}}" wx:key="id" class="section-card video-library-card">
      <view class="library-card-link ui-pressable" data-id="{{item.id}}" bindtap="openCard" aria-role="button" aria-label="查看《{{item.title}}》">
        <text class="video-library-title">{{item.title}}</text>
        <text aria-hidden="true" class="library-card-chevron">›</text>
      </view>
      <view class="record-meta library-card-meta">
        <text>{{item.scopeText}} · {{item.timeText}}</text>
        <text wx:if="{{item.scope === 'excerpt'}}">{{item.allow_book_link ? "全书开放时可续读" : "仅此段"}}</text>
      </view>
      <view class="ui-share-actions library-card-actions">
        <button wx:if="{{item.scope === 'excerpt'}}" class="ui-share-primary" data-id="{{item.id}}" open-type="share">再次分享</button>
        <button wx:else class="ui-share-primary" data-id="{{item.id}}" bindtap="openCard">查看并转发</button>
        <button class="ui-share-more" data-id="{{item.id}}" bindtap="stopCard" disabled="{{!!deletingId}}">停止分享</button>
      </view>
    </view>
    <button wx:if="{{moreCards}}" bindtap="loadMoreCards" disabled="{{loading}}">查看更多卡片</button>
  </block>
  <block wx:else>
    <button class="primary-button video-library-action video-library-pick" bindtap="pickClip">挑一段做视频</button>
    <view wx:if="{{error}}" class="error ui-error-banner">{{error}}</view>
    <button wx:if="{{error}}" class="ghost-button video-library-action" bindtap="retryLoad">重新加载</button>

    <view wx:if="{{taskItems.length}}" class="video-library-tasks">
      <text class="section-title">视频制作进度</text>
      <view class="video-library-list">
        <view wx:for="{{taskItems}}" wx:key="id" class="section-card video-library-card">
          <text class="video-library-title">《{{item.title}}》</text>
          <text class="video-library-progress {{item.status === 'failed' ? 'is-failed' : ''}}">{{item.status === 'failed' ? '制作失败：' + item.statusText : item.statusText}}</text>
          <view class="video-library-card-foot">
            <text class="video-library-date">{{item.styleLabel}}</text>
            <view class="video-library-task-actions">
              <button wx:if="{{item.status === 'failed'}}" class="video-library-delete ui-button" data-id="{{item.id}}" bindtap="deleteFailedVideo" loading="{{deletingId === item.id}}" disabled="{{!!deletingId}}">删除</button>
              <button class="video-library-open ui-button" data-id="{{item.id}}" data-utterance-id="{{item.utterance_id}}" bindtap="openVideo">{{item.status === 'failed' ? '查看详情' : '查看进度'}} ›</button>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{loading && !items.length && !taskItems.length}}" class="empty-panel">
      <text>正在读取分享视频</text>
    </view>
    <view wx:elif="{{!items.length && !taskItems.length && !error}}" class="empty-panel">
      <text class="empty-title">还没有分享视频</text>
      <text class="empty-copy">挑一段讲述，做成视频发给家人。</text>
    </view>

    <view wx:if="{{items.length}}" class="video-library-list">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="section-card video-library-card video-library-item ui-pressable"
        data-id="{{item.id}}"
        data-utterance-id="{{item.utterance_id}}"
        bindtap="openVideo"
        aria-role="button"
        aria-label="查看视频《{{item.title}}》"
      >
        <view class="video-library-thumb">
          <image wx:if="{{item.thumbnailUrl}}" class="video-library-thumb-image" src="{{item.thumbnailUrl}}" mode="aspectFill" lazy-load />
          <text class="video-library-duration ui-tabular">{{item.durationText}}</text>
        </view>
        <view class="video-library-body">
          <text class="video-library-title">《{{item.title}}》</text>
          <text class="video-library-date">{{item.styleLabel}}</text>
          <text class="video-library-date video-library-time">{{item.completedAtText}}</text>
          <text wx:if="{{item.like_count}}" class="video-library-likes">♥ {{item.like_count}} 位家人点赞</text>
        </view>
      </view>
    </view>

    <button wx:if="{{hasMore}}" class="ghost-button video-library-more" bindtap="loadMore" loading="{{loading}}" disabled="{{loading}}">查看更多视频</button>
  </block>

  <view class="bottom-spacer"></view>
</view>
