@import "../../styles/transcript-record.wxss";

.library-tabs .ui-version-option {
  min-height: var(--ui-hit-size);
}

.library-card-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: var(--ui-hit-size);
}

.library-card-chevron {
  color: var(--ui-text-muted);
}

.library-card-meta {
  display: flex;
  flex-wrap: wrap;
  column-gap: 16rpx;
}

.library-card-actions {
  justify-content: space-between;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.library-card-actions .ui-share-primary,
.library-card-actions .ui-share-more {
  flex: 0 0 auto;
  margin: 0;
  box-sizing: border-box;
  width: auto;
  min-height: var(--ui-hit-size);
  white-space: nowrap;
}

.library-card-actions .ui-share-more {
  font-weight: 500;
}

.video-library-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.video-library-tasks {
  margin-bottom: 24rpx;
}

.video-library-tasks .section-title {
  display: block;
  margin-bottom: 16rpx;
}

.video-library-progress {
  display: block;
  margin-top: 12rpx;
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-body);
  line-height: 1.6;
}

.video-library-progress.is-failed {
  color: var(--ui-danger-text);
}

.video-library-card {
  padding: 24rpx;
}

.video-library-card-foot {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.video-library-title,
.video-library-date {
  display: block;
}

.video-library-title {
  min-width: 0;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-action);
  font-weight: 750;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.video-library-item {
  display: flex;
  gap: 22rpx;
}

.video-library-thumb {
  position: relative;
  flex: 0 0 168rpx;
  height: 224rpx;
  border-radius: var(--ui-radius-inner);
  overflow: hidden;
  background: var(--ui-text-primary);
}

.video-library-thumb-image {
  width: 100%;
  height: 100%;
}

.video-library-duration {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.55);
  font-size: var(--ui-font-meta);
  line-height: 1.5;
}

.video-library-body {
  flex: 1;
  min-width: 0;
}

.video-library-item .video-library-date {
  margin-top: 14rpx;
}

.video-library-item .video-library-time {
  margin-top: 4rpx;
}

.video-library-likes {
  display: block;
  margin-top: 4rpx;
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-meta);
}

.video-library-card-foot {
  align-items: center;
  margin-top: 18rpx;
}

.video-library-date {
  color: var(--ui-text-muted);
  font-size: var(--ui-font-meta);
}

.video-library-open {
  min-height: 44px;
  margin: 0;
  padding: 10rpx 18rpx;
  border-radius: 16rpx;
  color: var(--ui-accent-strong);
  background: var(--ui-accent-surface-subtle);
  font-size: var(--ui-font-meta);
  font-weight: 750;
}

.video-library-more,
.video-library-action {
  width: 100%;
  margin-top: 22rpx;
}

.video-library-task-actions {
  display: flex;
  gap: 12rpx;
}

.video-library-delete {
  min-height: 44px;
  margin: 0;
  padding: 10rpx 18rpx;
  border-radius: 16rpx;
  color: var(--ui-danger-text);
  background: transparent;
  font-size: var(--ui-font-meta);
}
