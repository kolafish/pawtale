<view class="workbench-page">
  <view class="top-bar">
    <view class="back-hit" bindtap="backHome">
      <text class="back-mark">‹</text>
    </view>
    <text class="page-title">工作台</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="stat-grid">
    <view class="stat-card" bindtap="openStories" hover-class="tap-hover">
      <view class="stat-icon book-icon"></view>
      <text class="stat-label">本周故事</text>
      <text class="stat-value">{{hasDashboardData ? weeklyStoryCount : "..."}}</text>
    </view>
    <view class="stat-card warm" bindtap="openStories" hover-class="tap-hover">
      <view class="stat-icon hourglass-icon"></view>
      <text class="stat-label">待确认</text>
      <text class="stat-value warm-text">{{hasDashboardData ? pendingReviewCount : "..."}}</text>
    </view>
    <view class="stat-card" bindtap="openStories" hover-class="tap-hover">
      <view class="stat-icon bookmark-icon"></view>
      <text class="stat-label">已成章节</text>
      <text class="stat-value">{{hasDashboardData ? confirmedStoryCount : "..."}}</text>
    </view>
  </view>

  <view class="continue-panel">
    <view class="section-heading">
      <text>继续整理</text>
      <view class="heading-line"></view>
    </view>
    <text class="panel-subtitle">接着上次的内容，继续记录您的故事吧</text>
    <view class="primary-action {{loading ? 'primary-action-disabled' : ''}}" bindtap="continueInterview">
      <image class="action-art-icon" src="/assets/memoir-microphone.png" mode="aspectFit" />
      <text class="primary-action-text">{{loading ? "加载中" : "继续讲述"}}</text>
    </view>
  </view>

  <view class="memoir-panel" bindtap="openStories" hover-class="tap-hover">
    <view class="memoir-row">
      <view>
        <text class="memoir-title">我的回忆录</text>
        <text class="memoir-subtitle">童年、求学、成家</text>
      </view>
      <text class="chevron">›</text>
    </view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{hasDashboardData ? progressPercent : 0}}%;"></view>
    </view>
    <view wx:if="{{hasDashboardData}}" class="progress-value">{{progressPercent}}%</view>
    <view wx:else class="progress-value">加载中</view>
  </view>

  <view class="memory-panel">
    <view class="story-list-header">
      <text>访谈摘要</text>
    </view>
    <text class="memory-summary">{{summaryText || "回答后会在这里生成本次访谈摘要。"}}</text>
  </view>

  <view class="memory-panel">
    <view class="story-list-header">
      <text>覆盖度地图</text>
      <text class="story-count">{{coverage.length}}</text>
    </view>
    <view wx:if="{{!coverage.length}}" class="empty-state">
      <text>还没有覆盖度数据。完成一次访谈整理后会自动更新。</text>
    </view>
    <view wx:for="{{coverage}}" wx:key="topic_id" class="coverage-item">
      <view class="memoir-row">
        <text class="coverage-title">{{item.name}}</text>
        <text class="coverage-score">{{item.coverage_score}}%</text>
      </view>
      <view class="progress-track compact-track">
        <view class="progress-fill {{item.status}}" style="width: {{item.coverage_score}}%;"></view>
      </view>
    </view>
  </view>

  <view class="memory-panel">
    <view class="story-list-header">
      <text>记忆卡片</text>
      <text class="story-count">{{memoryCards.length}}</text>
    </view>
    <view wx:if="{{!memoryCards.length}}" class="empty-state">
      <text>还没有人物、事件、地点和主题记忆。</text>
    </view>
    <view wx:for="{{memoryCards}}" wx:key="title" class="memory-card">
      <text class="story-question">{{item.title}}</text>
      <text class="story-preview">{{item.detail}}</text>
      <text class="memory-status">{{item.status === "confirmed" ? "已确认" : item.status === "rejected" ? "已拒绝" : "待确认"}}</text>
    </view>
  </view>

  <view class="memory-panel">
    <view class="story-list-header">
      <text>待确认与下一问</text>
      <text class="story-count">{{openQuestions.length + candidates.length}}</text>
    </view>
    <view wx:if="{{!openQuestions.length && !candidates.length}}" class="empty-state">
      <text>暂无待确认问题或推荐下一问。</text>
    </view>
    <view wx:for="{{openQuestions}}" wx:key="id" class="memory-card">
      <text class="story-question">{{item.question}}</text>
      <text class="story-preview">{{item.reason || item.question_type}}</text>
    </view>
    <view wx:for="{{candidates}}" wx:key="id" class="candidate-card">
      <text class="story-question">{{item.question}}</text>
      <text class="story-preview">{{item.reason}}</text>
    </view>
  </view>

  <view class="story-list">
    <view class="story-list-header" bindtap="openStories" hover-class="tap-hover">
      <text>故事卡</text>
      <text class="story-count">{{hasStoryData ? stories.length : "..."}}</text>
    </view>
    <view wx:if="{{!hasStoryData && loading || !hasStoryData && refreshing}}" class="empty-state">
      <text>正在加载故事卡</text>
    </view>
    <view wx:elif="{{hasStoryData && !stories.length}}" class="empty-state">
      <text>还没有故事卡。先回答一个问题，工作台会自动整理到这里。</text>
    </view>
    <view wx:for="{{stories}}" wx:key="id" class="story-card">
      <text class="story-question">{{item.question_prompt}}</text>
      <text class="story-preview">{{item.draft_preview || item.answer_preview}}</text>
      <view class="story-meta">
        <text>{{item.draft_status === "accepted" ? "已成章" : item.draft_status === "draft" ? "待确认" : "已回答"}}</text>
        <text wx:if="{{item.duration_seconds}}">{{item.duration_seconds}} 秒</text>
      </view>
    </view>
  </view>

  <view class="bottom-nav">
    <view class="bottom-nav-item" bindtap="openHome">
      <view class="nav-mark home-mark"></view>
      <text>首页</text>
    </view>
    <view class="bottom-nav-item active">
      <view class="nav-mark grid-mark"></view>
      <text>工作台</text>
    </view>
    <view class="bottom-nav-item" bindtap="openFeedback">
      <view class="nav-mark chat-mark"></view>
      <text>反馈</text>
    </view>
    <view class="bottom-nav-item" bindtap="openProfile">
      <view class="nav-mark user-mark"></view>
      <text>我的</text>
    </view>
  </view>
</view>
