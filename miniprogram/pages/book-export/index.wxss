  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}
.layout-cover-art.journal .layout-cover-title,
.layout-cover-art.warm-journal .layout-cover-title { color: #694637; }
.layout-cover-art.journal .layout-cover-kicker,
.layout-cover-art.journal .layout-cover-credit,
.layout-cover-art.warm-journal .layout-cover-kicker,
.layout-cover-art.warm-journal .layout-cover-credit { color: #694637; }
.layout-cover-art.modern .layout-cover-kicker,
.layout-cover-art.modern .layout-cover-credit,
.layout-cover-art.modern-minimal .layout-cover-kicker,
.layout-cover-art.modern-minimal .layout-cover-credit { color: #f2eee4; font-family: sans-serif; }
.layout-cover-art.modern .layout-cover-title,
.layout-cover-art.modern-minimal .layout-cover-title { color: #f2eee4; font-family: sans-serif; }
