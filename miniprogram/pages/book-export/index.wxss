}
.layout-option-main.has-cover .layout-sample { width: 176rpx; height: 249rpx; flex-basis: 176rpx; }
.layout-sample {
  box-sizing: border-box;
  width: 150rpx;
  height: 228rpx;
  flex: 0 0 150rpx;
  overflow: hidden;
  padding: 16rpx 14rpx;
