.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx;
  background: var(--ui-page-background);
  color: var(--ui-text-primary);
}

.book-export-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.export-hero,
.state-card,
.export-settings,
.manuscript-card,
.advanced-card,
.preview-card {
  box-sizing: border-box;
  border: 1rpx solid var(--ui-border);
  border-radius: 12rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow);
}

.export-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 28rpx;
}

.eyebrow,
.hero-title,
.hero-meta,
.version-pill,
.notice,
.section-title,
.setting-title,
.setting-meta,
.setting-value,
.toc-item,
.preview-count,
.chapter-title,
.chapter-excerpt,
.export-action-hint,
.section-count,
.manuscript-title,
.manuscript-subtitle,
.manuscript-meta,
.advanced-title,
.advanced-meta,
.advanced-value,
.structure-title,
.structure-meta,
.structure-status,
.chapter-index,
.chapter-intro,
.chapter-quote,
.chapter-quote-source,
.back-matter-kind,
.back-matter-title,
.back-matter-preview,
.book-output-text,
.state-card {
  display: block;
}

.eyebrow {
  margin-bottom: 8rpx;
  color: var(--ui-section-title);
  font-size: 24rpx;
}

.hero-title {
  color: var(--ui-text-primary);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.28;
}

.hero-meta {
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
}

.version-pill {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--ui-accent-surface);
  color: var(--ui-value-text);
  font-size: 22rpx;
  line-height: 1.4;
}

.notice {
  padding: 18rpx 22rpx;
  border: 1rpx solid var(--ui-border);
  border-radius: 10rpx;
  background: var(--ui-surface);
  color: var(--ui-value-text);
  font-size: 25rpx;
  line-height: 1.5;
}

.notice.warn {
  border-color: var(--ui-warning-text);
  background: var(--ui-warning-surface);
  color: var(--ui-warning-text);
}

.notice.subtle {
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-text-secondary);
}

.state-card {
  padding: 30rpx;
  color: var(--ui-text-secondary);
  font-size: 27rpx;
  line-height: 1.6;
}

.state-card.error {
  border-color: var(--ui-danger-text);
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
}

.state-action {
  width: 100%;
  min-height: 44px;
}

.ghost-button.state-action {
  margin-top: 20rpx;
}

.export-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(180rpx, 1fr));
  gap: 16rpx;
}

.export-action-hint {
  margin-top: -8rpx;
  padding: 0 4rpx;
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  line-height: 1.45;
}

.primary-button,
.ghost-button,
.text-button {
  margin: 0;
  border-radius: 10rpx;
  font-size: 26rpx;
  line-height: 2.6;
}

.primary-button {
  background: var(--ui-accent);
  color: var(--ui-on-accent);
}

.ghost-button {
  border: 1rpx solid var(--ui-border);
  background: var(--ui-surface);
  color: var(--ui-value-text);
}

.primary-button,
.ghost-button {
  min-height: 80rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.35;
  text-align: center;
}

.text-button {
  padding: 0;
  background: transparent;
  color: var(--ui-accent);
  line-height: 1.6;
}

.text-button::after {
  border: 0;
}

.reader-entry-action {
  min-height: 44px;
  margin: -10rpx -12rpx -10rpx 0;
  padding: 10rpx 12rpx;
  font-weight: 700;
}

.settings-toggle {
  width: 100%;
  min-height: 44px;
  margin: 0;
  padding: 24rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border: 0;
  border-radius: 12rpx;
  background: var(--ui-surface);
  color: var(--ui-text-primary);
  text-align: left;
  box-shadow:
    0 0 0 1rpx var(--ui-border),
    0 10rpx 24rpx rgba(0, 0, 0, 0.06);
  transition: transform 140ms ease-out;
}

.settings-toggle::after {
  border: 0;
}

.settings-toggle:active {
  transform: scale(0.96);
}

.settings-toggle-copy {
  min-width: 0;
  flex: 1;
}

.settings-toggle-title,
.settings-toggle-meta,
.settings-toggle-action {
  display: block;
}

.settings-toggle-title {
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.4;
}

.settings-toggle-meta {
  margin-top: 6rpx;
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  line-height: 1.45;
}

.settings-toggle-action {
  flex: 0 0 auto;
  color: var(--ui-accent);
  font-size: 25rpx;
  font-weight: 700;
}

.ghost-button.compact {
  flex-shrink: 0;
  min-width: 168rpx;
  padding: 0 18rpx;
}

.book-design-panel {
  padding: 26rpx;
  border: 1rpx solid var(--ui-border);
  border-radius: 12rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow);
  box-sizing: border-box;
}

.book-design-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.book-editorial-copy-notice {
  min-height: 88rpx;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border: 1rpx solid rgba(168, 79, 67, 0.2);
  border-radius: 12rpx;
  background: var(--ui-accent-surface);
  box-sizing: border-box;
  transition-property: transform, opacity;
  transition-duration: 120ms;
  transition-timing-function: ease-out;
}

.book-editorial-copy-notice:active {
  opacity: 0.82;
  transform: scale(0.96);
}

.book-editorial-copy-notice-text {
  flex: 1;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 1.5;
}

.book-editorial-copy-notice-action {
  flex-shrink: 0;
  color: var(--ui-accent-strong);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.4;
}

.book-design-title,
.book-design-meta,
.book-design-save-status,
.book-metadata-label,
.book-cover-style-label,
.book-cover-style-detail {
  display: block;
}

.book-design-title {
  color: var(--ui-text-primary);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}

.book-design-meta {
  margin-top: 6rpx;
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  line-height: 1.4;
}

.book-design-save-status {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--ui-surface-subtle);
  color: var(--ui-value-text);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
}

.book-design-save-status.saving {
  color: var(--ui-text-secondary);
}

.book-title-editor {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.book-title-input {
  min-width: 0;
  flex: 1;
  height: 78rpx;
  padding: 0 20rpx;
  border: 2rpx solid var(--ui-border);
  border-radius: 12rpx;
  background: var(--ui-surface);
  color: var(--ui-text-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 78rpx;
  box-sizing: border-box;
}

.book-title-ai {
  flex-shrink: 0;
  height: 80rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 0;
  border-radius: 10rpx;
  background: var(--ui-accent-surface);
  color: var(--ui-accent-strong);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 80rpx;
}

.book-title-ai::after {
  border: 0;
}

.book-title-suggestion-list {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.book-title-suggestion {
  max-width: 100%;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: var(--ui-accent-surface);
  color: var(--ui-accent-strong);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  box-sizing: border-box;
}

.book-title-suggestion text {
  word-break: break-word;
}

.book-metadata-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
}

.book-metadata-field {
  margin-top: 16rpx;
}

.book-metadata-grid .book-metadata-field {
  margin-top: 0;
}

.book-metadata-label {
  margin-bottom: 8rpx;
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.35;
}

.book-metadata-label-row {
  min-height: 46rpx;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.book-metadata-label-row .book-metadata-label {
  margin-bottom: 0;
}

.book-editorial-generate {
  height: 80rpx;
  min-width: 112rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 2rpx solid var(--ui-border);
  border-radius: 999rpx;
  background: var(--ui-page-background);
  color: var(--ui-accent);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 76rpx;
  box-sizing: border-box;
}

.book-editorial-generate::after {
  border: 0;
}

.book-metadata-input,
.book-metadata-textarea {
  width: 100%;
  min-height: 72rpx;
  padding: 16rpx 18rpx;
  border: 2rpx solid var(--ui-border);
  border-radius: 12rpx;
  background: var(--ui-surface);
  color: var(--ui-text-primary);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.45;
  box-sizing: border-box;
}

.book-metadata-input {
  height: 72rpx;
  padding-top: 0;
  padding-bottom: 0;
  line-height: 72rpx;
}

.book-metadata-textarea {
  min-height: 150rpx;
}

.book-metadata-textarea.compact {
  min-height: 94rpx;
}

.book-cover-style-picker {
  margin-top: 18rpx;
  min-height: 80rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid var(--ui-border);
  border-radius: 12rpx;
  background: var(--ui-surface);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  box-sizing: border-box;
}

.book-cover-preview {
  position: relative;
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 106rpx;
  padding: 12rpx 8rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.16);
  border-radius: 8rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.book-cover-preview-title {
  position: relative;
  z-index: 1;
  display: block;
  color: var(--ui-text-primary);
  font-size: 14rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
  word-break: break-word;
}

.book-cover-preview.classic-plain {
  background: linear-gradient(180deg, #fbf1de 0%, #f4dfc3 100%);
}

.book-cover-preview.warm-gray {
  background: linear-gradient(180deg, #ece8df 0%, #d8d0c2 100%);
}

.book-cover-preview.dark-album {
  background: #3b302a;
}

.book-cover-preview.dark-album .book-cover-preview-title,
.book-cover-preview.navy-gilt .book-cover-preview-title {
  color: #f7eadc;
}

.book-cover-preview.moonlit-courtyard {
  background: linear-gradient(180deg, #eef2ea 0%, #d9dfd4 58%, #c2b59d 100%);
}

.book-cover-preview.moonlit-courtyard::after {
  content: "";
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  bottom: 14rpx;
  height: 22rpx;
  border-top: 3rpx solid rgba(0, 0, 0, 0.42);
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.22);
}

.book-cover-preview.navy-gilt {
  border-color: #bfa46c;
  background: #182b46;
}

.book-cover-preview.navy-gilt::after {
  content: "";
  position: absolute;
  inset: 8rpx;
  border: 2rpx solid #bfa46c;
}

.book-cover-style-copy {
  min-width: 0;
  flex: 1;
}

.book-cover-style-label {
  color: var(--ui-text-primary);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.35;
}

.book-cover-style-detail {
  margin-top: 4rpx;
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  line-height: 1.4;
  word-break: break-word;
}

.book-cover-style-value {
  flex-shrink: 0;
  color: var(--ui-value-text);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
}

.save-design-button {
  width: 100%;
  margin-top: 18rpx;
}

.manuscript-card {
  padding: 26rpx;
}

.advanced-card {
  padding: 26rpx;
}

.advanced-row {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 10rpx;
  background: var(--ui-surface);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.advanced-copy {
  min-width: 0;
  flex: 1;
}

.advanced-title {
  color: var(--ui-text-primary);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}

.advanced-meta {
  margin-top: 4rpx;
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  line-height: 1.45;
}

.advanced-value {
  flex-shrink: 0;
  color: var(--ui-value-text);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.advanced-value.muted {
  color: var(--ui-text-muted);
  font-weight: 600;
}

.manuscript-section + .manuscript-section {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.section-count {
  flex-shrink: 0;
  color: var(--ui-section-title);
  font-size: 24rpx;
  line-height: 1.35;
}

.manuscript-cover-summary {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 10rpx;
  background: var(--ui-surface);
}

.manuscript-title {
  color: var(--ui-text-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.45;
}

.manuscript-subtitle,
.manuscript-meta,
.structure-meta,
.chapter-intro,
.back-matter-preview {
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  line-height: 1.55;
}

.manuscript-subtitle,
.manuscript-meta {
  margin-top: 6rpx;
}

.structure-list,
.manuscript-chapter-list,
.back-matter-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.structure-row,
.back-matter-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx;
  border-radius: 10rpx;
  background: var(--ui-surface);
}

.structure-main,
.back-matter-main {
  min-width: 0;
  flex: 1;
}

.structure-title,
.back-matter-title {
  color: var(--ui-text-primary);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}

.structure-status,
.back-matter-kind {
  flex-shrink: 0;
  color: var(--ui-accent);
  font-size: 23rpx;
  line-height: 1.45;
}

.manuscript-chapter {
  padding: 20rpx;
  border-radius: 10rpx;
  background: var(--ui-surface);
}

.chapter-heading {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.chapter-index {
  flex-shrink: 0;
  color: var(--ui-section-title);
  font-size: 23rpx;
  line-height: 1.4;
}

.chapter-intro {
  margin-top: 10rpx;
}

.chapter-quote {
  margin-top: 12rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid var(--ui-accent-border);
  color: var(--ui-value-text);
  font-size: 24rpx;
  line-height: 1.55;
}

.chapter-quote-source {
  margin-top: 6rpx;
  color: var(--ui-section-title);
  font-size: 22rpx;
  line-height: 1.4;
}

.export-settings {
  overflow: hidden;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 18rpx;
  padding: 24rpx 26rpx;
  border-bottom: 1rpx solid var(--ui-divider);
}

.setting-row:last-child {
  border-bottom: 0;
}

.setting-title {
  color: var(--ui-text-primary);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.setting-meta {
  margin-top: 6rpx;
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  line-height: 1.45;
}

.setting-value {
  flex-shrink: 0;
  color: var(--ui-value-text);
  font-size: 25rpx;
  white-space: nowrap;
}

.preview-card {
  padding: 26rpx;
}

.section-head,
.preview-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.section-title {
  color: var(--ui-text-primary);
  font-size: 32rpx;
  font-weight: 700;
}

.version-link {
  color: var(--ui-accent);
  font-size: 25rpx;
}

.toc-list,
.chapter-preview-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 22rpx;
}

.toc-group {
  min-width: 0;
}

.toc-item {
  color: var(--ui-value-text);
  font-size: 26rpx;
  line-height: 1.5;
}

.toc-small-section {
  display: block;
  margin-top: 6rpx;
  margin-left: 26rpx;
  padding-left: 18rpx;
  border-left: 2rpx solid var(--ui-border);
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
  word-break: break-word;
}

.preview-toggle-row {
  margin-top: 26rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.preview-count {
  color: var(--ui-text-secondary);
  font-size: 25rpx;
}

.chapter-preview {
  padding: 20rpx;
  border-radius: 10rpx;
  background: var(--ui-surface);
}

.chapter-title {
  color: var(--ui-text-primary);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
}

.chapter-small-section-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 16rpx;
}

.chapter-small-section + .chapter-small-section {
  padding-top: 18rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.chapter-small-section-title {
  display: block;
  color: var(--ui-value-text);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.45;
  word-break: break-word;
}

.chapter-excerpt {
  display: block;
  margin-top: 10rpx;
  color: var(--ui-value-text);
  font-size: 25rpx;
  line-height: 1.65;
}

.book-output-text {
  margin-top: 22rpx;
  color: var(--ui-value-text);
  font-size: 26rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}
