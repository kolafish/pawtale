.layout-cover-art {
  box-sizing: border-box;
  position: relative;
  width: 176rpx;
  height: 249rpx;
  overflow: hidden;
  border-radius: 10rpx;
  outline: 1rpx solid rgba(0, 0, 0, 0.1);
