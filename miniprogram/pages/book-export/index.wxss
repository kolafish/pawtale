.page {
  padding: 28rpx 30rpx calc(72rpx + env(safe-area-inset-bottom));
  color: var(--ui-text-primary);
}

.book-export-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.export-hero,
.overview-card,
.detail-card {
  padding: 28rpx;
}

.export-hero {
  overflow: hidden;
  background: linear-gradient(150deg, #fffdfa 45%, #f9f5ef);
}

.hero-main,
.hero-actions,
.detail-heading,
.list-row,
.detail-setting-row,
.detail-info-row {
  display: flex;
  align-items: center;
}

.hero-main {
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-copy,
.row-copy {
  min-width: 0;
  flex: 1;
}

.hero-title,
.hero-subtitle,
.hero-meta,
.section-title,
.section-description,
.row-title,
.row-detail,
.row-value,
.state-card,
.notice,
.save-status {
  display: block;
}

.hero-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 45rpx;
  font-weight: 700;
  line-height: 1.25;
  word-break: break-word;
  text-wrap: balance;
}

.hero-subtitle {
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  text-wrap: pretty;
}

.hero-meta {
  margin-top: 18rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  font-variant-numeric: tabular-nums;
}

.hero-cover {
  position: relative;
  width: 168rpx;
  height: 226rpx;
  flex: 0 0 168rpx;
  padding: 28rpx 15rpx;
  overflow: hidden;
  border-radius: 13rpx;
  outline: 1rpx solid rgba(0, 0, 0, 0.1);
  outline-offset: -1rpx;
  box-shadow: 5rpx 12rpx 24rpx rgba(54, 42, 34, 0.13);
  background: linear-gradient(180deg, #fbf1de, #f4dfc3);
}

.hero-cover.classic-plain { background: linear-gradient(180deg, #fbf1de, #f4dfc3); }
.hero-cover.warm-gray,
.layout-cover-art.warm-gray { background: linear-gradient(180deg, #ece8df, #d8d0c2); }
.hero-cover.dark-album,
.layout-cover-art.dark-album { background: #3b302a; }
.hero-cover.moonlit-courtyard,
.layout-cover-art.moonlit-courtyard { background: linear-gradient(180deg, #eef2ea, #d9dfd4 58%, #c2b59d); }
.hero-cover.navy-gilt,
.layout-cover-art.navy-gilt { background: #182b46; }
.hero-cover.dark-album .hero-cover-title,
.hero-cover.navy-gilt .hero-cover-title { color: #f7eadc; }
.hero-cover-image { position: absolute; inset: 0; width: 100%; height: 100%; }
.hero-cover.heritage-classic .hero-cover-title,
.hero-cover.warm-journal .hero-cover-title,
.hero-cover.modern-minimal .hero-cover-title {
  position: absolute;
  top: 36%;
  right: 13rpx;
  left: 13rpx;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}
.hero-cover.heritage-classic .hero-cover-title { color: #4f3928; }
.hero-cover.warm-journal .hero-cover-title { color: #694637; }
.hero-cover.modern-minimal .hero-cover-title { color: #f2eee4; font-family: sans-serif; }

.hero-cover-branch {
  position: absolute;
  right: -26rpx;
  bottom: -18rpx;
  width: 180rpx;
  height: 180rpx;
  opacity: 0.35;
}

.hero-cover-title {
  position: relative;
  z-index: 1;
  display: block;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: center;
  word-break: break-word;
}

.hero-actions {
  gap: 16rpx;
  margin-top: 25rpx;
}

.hero-action {
  min-width: 0;
  min-height: 84rpx;
  flex: 1;
  padding: 18rpx 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 999rpx;
  font-size: var(--ui-font-action);
  font-weight: 700;
  text-align: center;
}

.hero-action.primary { background: var(--ui-accent-strong); color: #fff; }
.hero-action.secondary { color: var(--ui-accent-strong); box-shadow: inset 0 0 0 2rpx var(--ui-accent-border); }
.hero-action text { font-size: var(--ui-font-action); font-weight: 400; }

.section-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-section-title);
  font-weight: 700;
  line-height: 1.4;
  text-wrap: balance;
}

.section-description {
  margin-top: 4rpx;
  margin-bottom: 11rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  text-wrap: pretty;
}

.list-row {
  box-sizing: border-box;
  width: 100%;
  min-height: 92rpx;
  justify-content: space-between;
  gap: 12rpx;
  margin: 0;
  padding: 15rpx 4rpx;
  border: 0;
  border-radius: 0;
  border-bottom: 1rpx solid var(--ui-divider);
  background: transparent;
  color: var(--ui-text-primary);
  text-align: left;
  line-height: 1.35;
}

.list-row::after { border: 0; }
.list-row:last-child { border-bottom: 0; }
.export-row { min-height: 106rpx; }
.export-row.is-disabled { pointer-events: none; opacity: 0.62; }
.section-entry { cursor: pointer; }
.row-title { font-size: var(--ui-font-list-title); font-weight: 600; line-height: 1.4; }
.row-detail { margin-top: 4rpx; color: var(--ui-text-secondary); font-size: var(--ui-font-body); line-height: var(--ui-line-body); text-wrap: pretty; }
.row-value { max-width: 42%; margin-left: auto; overflow: hidden; color: var(--ui-text-secondary); font-size: var(--ui-font-meta); line-height: var(--ui-line-meta); text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.row-arrow { flex: 0 0 auto; color: var(--ui-text-muted); font-size: 36rpx; font-weight: 300; line-height: 1; }
.row-busy { flex: 0 0 auto; color: var(--ui-accent-strong); font-size: var(--ui-font-caption); }

.notice,
.state-card {
  padding: 22rpx 26rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: 1.5;
}
.notice { border-radius: var(--ui-radius-inner); background: var(--ui-surface); box-shadow: var(--ui-control-shadow); }
.notice.warn,
.state-card.error { background: var(--ui-warning-surface); color: var(--ui-warning-text); }
.state-action,
.detail-action {
  min-height: 88rpx;
  margin: 20rpx 0 0;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: var(--ui-radius-control);
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-action);
  font-weight: 700;
}
.state-action::after,
.detail-action::after { border: 0; }

.subpage-back {
  min-height: 96rpx;
  padding: 18rpx 8rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-action);
  font-weight: 700;
}
.subpage-back-arrow {
  min-width: 36rpx;
  font-size: 42rpx;
  font-weight: 400;
  line-height: 1;
  text-align: center;
}
.detail-heading { justify-content: space-between; gap: 12rpx; }
.save-status { color: var(--ui-text-secondary); font-size: var(--ui-font-caption); }
.detail-setting-row { min-height: 118rpx; justify-content: space-between; gap: 18rpx; }
.detail-info-row { min-height: 86rpx; justify-content: space-between; gap: 16rpx; border-bottom: 1rpx solid var(--ui-divider); font-size: var(--ui-font-body); }
.detail-info-row text:last-child { color: var(--ui-text-secondary); text-align: right; }
.advanced-action { margin-top: 22rpx; }
.advanced-action .row-detail { margin-top: 8rpx; }

.layout-preview-note { display: block; margin: 8rpx 0; color: var(--ui-accent-strong); font-size: var(--ui-font-caption); line-height: 1.5; }

.layout-current {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
}

.layout-current text:last-child {
  color: var(--ui-accent-strong);
  font-weight: 700;
}

.layout-option-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin: 8rpx 0 30rpx;
}

.layout-option {
  padding: 20rpx;
  border-radius: 24rpx;
  background: var(--ui-surface-soft);
  box-shadow: inset 0 0 0 1rpx rgba(54, 42, 34, 0.055);
}

.layout-option.is-selected {
  background: var(--ui-accent-surface-subtle);
  box-shadow: inset 0 0 0 2rpx var(--ui-accent-border);
}

.layout-option-main {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.layout-option-main.has-cover {
  flex-direction: column;
  align-items: stretch;
  gap: 15rpx;
}

.layout-option-visuals { display: flex; flex: 0 0 auto; }
.layout-option-main.has-cover .layout-option-visuals { justify-content: center; gap: 16rpx; }
.layout-cover-preview,
.layout-option-main.has-cover .layout-interior-preview { width: 176rpx; flex: 0 0 176rpx; }
.layout-cover-art {
  box-sizing: border-box;
  position: relative;
  width: 176rpx;
  height: 249rpx;
  overflow: hidden;
  border-radius: 10rpx;
  outline: 1rpx solid rgba(0, 0, 0, 0.1);
  outline-offset: -1rpx;
  background: #f5ecdc;
  box-shadow: 3rpx 6rpx 14rpx rgba(54, 42, 34, 0.12);
}
.layout-cover-image { position: absolute; inset: 0; width: 100%; height: 100%; }
.layout-cover-art.classic-plain { background: #f5ebdb; }
.layout-cover-rule { position: absolute; right: 16rpx; left: 16rpx; height: 1rpx; background: rgba(199, 179, 156, 0.8); }
.layout-cover-rule.top { top: 18rpx; }
.layout-cover-rule.bottom { bottom: 18rpx; }
.layout-cover-kicker,
.layout-cover-credit {
  position: absolute;
  z-index: 1;
  right: 12rpx;
  left: 12rpx;
  color: #4f3928;
  font-family: var(--ui-font-editorial);
  font-size: 9rpx;
  line-height: 1.3;
  text-align: center;
}
.layout-cover-kicker { top: 23%; letter-spacing: 1rpx; }
.layout-cover-credit { bottom: 14%; }
.layout-cover-title {
  position: absolute;
  z-index: 1;
  top: 35%;
  right: 13rpx;
  left: 13rpx;
  display: -webkit-box;
  overflow: hidden;
  color: #4f3928;
  font-family: var(--ui-font-editorial);
  font-size: 17rpx;
  font-weight: 700;
  line-height: 1.45;
  text-align: center;
  word-break: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}
.layout-cover-art.journal .layout-cover-title,
.layout-cover-art.warm-journal .layout-cover-title { color: #694637; }
.layout-cover-art.journal .layout-cover-kicker,
.layout-cover-art.journal .layout-cover-credit,
.layout-cover-art.warm-journal .layout-cover-kicker,
.layout-cover-art.warm-journal .layout-cover-credit { color: #694637; }
.layout-cover-art.modern .layout-cover-kicker,
.layout-cover-art.modern .layout-cover-credit,
.layout-cover-art.modern-minimal .layout-cover-kicker,
.layout-cover-art.modern-minimal .layout-cover-credit { color: #f2eee4; font-family: sans-serif; }
.layout-cover-art.modern .layout-cover-title,
.layout-cover-art.modern-minimal .layout-cover-title { color: #f2eee4; font-family: sans-serif; }
.layout-cover-art.dark-album text,
.layout-cover-art.navy-gilt text { color: #f7eadc; }
.layout-preview-caption {
  display: block;
  margin-top: 7rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-caption);
  line-height: 1.3;
  text-align: center;
}
.layout-option-main.has-cover .layout-sample { width: 176rpx; height: 249rpx; flex-basis: 176rpx; }

.layout-sample {
  box-sizing: border-box;
  width: 150rpx;
  height: 228rpx;
  flex: 0 0 150rpx;
  overflow: hidden;
  padding: 16rpx 14rpx;
  border-radius: 10rpx;
  outline: 1rpx solid rgba(0, 0, 0, 0.1);
  outline-offset: -1rpx;
  background: #fffdfa;
  box-shadow: 3rpx 6rpx 14rpx rgba(54, 42, 34, 0.12);
  color: #473c35;
}

.layout-sample text { display: block; }
.layout-sample-kicker { font-size: 12rpx; line-height: 1.4; }
.layout-sample-title {
  display: -webkit-box !important;
  overflow: hidden;
  margin-top: 7rpx;
  font-family: var(--ui-font-editorial);
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.layout-sample-ornament-art {
  width: 100%;
  height: 38rpx;
  margin: 6rpx 0;
}
.layout-sample-ornament-art image { display: block; width: 100%; height: 100%; }
.layout-sample-body {
  display: -webkit-box !important;
  overflow: hidden;
  font-size: 10rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.layout-sample-section {
  overflow: hidden;
  margin-top: 9rpx;
  padding-top: 6rpx;
  border-top: 1rpx solid rgba(71, 60, 53, 0.18);
  font-family: var(--ui-font-editorial);
  font-size: 10rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.layout-sample-quote {
  display: -webkit-box !important;
  overflow: hidden;
  margin-top: 7rpx;
  padding-left: 5rpx;
  border-left: 2rpx solid #b8a795;
  font-size: 9rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.layout-sample.classic .layout-sample-body { margin-top: 14rpx; -webkit-line-clamp: 4; }
.layout-sample.classic .layout-sample-section { border-top: 0; }
.layout-sample.classic .layout-sample-quote { padding-left: 0; border-left: 0; }
.layout-sample.heritage { background: #faf5e8; color: #503f30; }
.layout-sample.heritage .layout-sample-kicker,
.layout-sample.heritage .layout-sample-title { text-align: center; }
.layout-sample.heritage .layout-sample-kicker { color: #8b6643; letter-spacing: 2rpx; }
.layout-sample.heritage .layout-sample-title { margin-top: 10rpx; font-size: 20rpx; }
.layout-sample.heritage .layout-sample-section { border-color: #c8ad84; text-align: center; }
.layout-sample.heritage .layout-sample-quote { border-color: #c8ad84; }
.layout-sample.journal { background: #fff8f2; color: #6b4c42; }
.layout-sample.journal .layout-sample-kicker { color: #a46350; }
.layout-sample.journal .layout-sample-title { font-size: 20rpx; color: #914f41; }
.layout-sample.journal .layout-sample-section { border-color: #e4c6b6; color: #914f41; }
.layout-sample.journal .layout-sample-quote {
  padding: 4rpx 5rpx;
  border-color: #bf806a;
  background: #f9ebe2;
  color: #80594f;
}
.layout-sample.modern { background: #f8fafb; color: #233d4a; }
.layout-sample.modern .layout-sample-kicker,
.layout-sample.modern .layout-sample-title,
.layout-sample.modern .layout-sample-body,
.layout-sample.modern .layout-sample-section,
.layout-sample.modern .layout-sample-quote { font-family: sans-serif; }
.layout-sample.modern .layout-sample-kicker { color: #2f6874; font-size: 24rpx; font-weight: 700; line-height: 1; }
.layout-sample.modern .layout-sample-title { margin-top: 5rpx; font-size: 18rpx; }
.layout-sample.modern .layout-sample-section { border-color: #a9c1c6; color: #2f6874; }
.layout-sample.modern .layout-sample-quote { border-color: #a9c1c6; }

.layout-option-copy { min-width: 0; flex: 1; }
.layout-option-title {
  display: block;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-list-title);
  font-weight: 700;
  line-height: 1.4;
}
.layout-option-description {
  display: block;
  margin-top: 7rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
}
.layout-selected-label {
  display: inline-block;
  margin-top: 13rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: var(--ui-accent-surface);
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-caption);
  font-weight: 700;
}
.layout-option-actions { display: flex; gap: 12rpx; margin-top: 18rpx; }
.layout-action {
  box-sizing: border-box;
  min-width: 0;
  min-height: 40px;
  flex: 1;
  margin: 0;
  padding: 14rpx 8rpx;
  border: 0;
  border-radius: var(--ui-radius-control);
  font-size: var(--ui-font-body);
  font-weight: 700;
  line-height: 1.35;
  transition-property: transform;
  transition-duration: 150ms;
}
.layout-action::after { border: 0; }
.layout-action:active { transform: scale(0.96); }
.layout-action.preview { background: #fff; color: var(--ui-accent-strong); box-shadow: inset 0 0 0 1rpx var(--ui-accent-border); }
.layout-action.select { background: var(--ui-accent-strong); color: #fff; }
.layout-action[disabled] { opacity: 0.55; }
.layout-feedback { display: block; margin-top: 12rpx; color: var(--ui-text-secondary); font-size: var(--ui-font-caption); line-height: 1.5; }
.layout-feedback.error { color: var(--ui-accent-strong); }
.layout-custom-panel { margin-top: 8rpx; padding: 22rpx; border-radius: 24rpx; background: var(--ui-surface-soft); box-shadow: inset 0 0 0 1rpx rgba(54, 42, 34, 0.055); }
.layout-custom-controls { margin-top: 14rpx; }
.layout-custom-row {
  min-height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--ui-divider);
  color: var(--ui-text-primary);
  font-size: var(--ui-font-body);
}
.layout-custom-row text:last-child { color: var(--ui-text-secondary); }
.layout-custom-hint { display: block; margin-top: 12rpx; color: var(--ui-accent-strong); font-size: var(--ui-font-caption); }
.layout-content-title { display: block; margin-top: 12rpx; color: var(--ui-text-primary); font-size: var(--ui-font-list-title); font-weight: 700; }

.ui-accessible-page.large-text .layout-option-description,
.ui-accessible-page.large-text .layout-custom-row,
.ui-accessible-page.large-text .layout-action { font-size: var(--ui-font-large-body); }

.book-metadata-label-row { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.save-design-button {
  width: 100%;
  min-height: 88rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-control);
  background: var(--ui-accent-surface-subtle);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-action);
  font-weight: 700;
}

.ui-accessible-page.large-text .row-title,
.ui-accessible-page.large-text .hero-action { font-size: var(--ui-font-large-body); }
.ui-accessible-page.large-text .row-detail,
.ui-accessible-page.large-text .row-value { font-size: var(--ui-font-large-caption); }
.ui-accessible-page.large-text .list-row { min-height: 112rpx; }

.book-title-editor {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.book-title-sync-hint {
  display: block;
  margin-top: 20rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  text-wrap: pretty;
}

.book-title-input,
.book-metadata-input,
.book-metadata-textarea {
  box-sizing: border-box;
  width: 100%;
  border: 0;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface-soft);
  box-shadow: inset 0 0 0 1rpx rgba(54, 42, 34, 0.055);
  color: var(--ui-text-primary);
  font-size: var(--ui-font-meta);
  line-height: 1.45;
}

.book-title-input {
  min-width: 0;
  height: 88rpx;
  flex: 1;
  padding: 0 20rpx;
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-list-title);
  font-weight: 700;
  line-height: 88rpx;
}

.book-title-ai {
  min-height: 88rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: var(--ui-radius-control);
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-action);
  font-weight: 700;
  line-height: 1.35;
}

.book-title-ai {
  width: 184rpx;
  min-width: 184rpx;
  max-width: 184rpx;
  padding: 0 12rpx;
  flex: 0 0 184rpx;
}

.book-title-suggestion-list {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.book-title-suggestion {
  max-width: 100%;
  min-height: 88rpx;
  padding: 0 17rpx;
  border-radius: 999rpx;
  background: var(--ui-accent-surface);
  color: var(--ui-accent-strong);
  display: inline-flex;
  align-items: center;
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 1.35;
}

.book-title-suggestion text {
  word-break: break-word;
}

.book-metadata-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
}

.book-metadata-field {
  margin-top: 16rpx;
}

.book-metadata-grid .book-metadata-field {
  margin-top: 0;
}

.book-metadata-label {
  margin-bottom: 8rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-caption);
  font-weight: 700;
  line-height: 1.35;
}

.book-metadata-label-row {
  min-height: 50rpx;
  margin-bottom: 8rpx;
}

.book-metadata-label-row .book-metadata-label {
  margin-bottom: 0;
}

.editorial-detail-card {
  padding-top: 22rpx;
}

.book-editorial-save-row {
  min-height: 34rpx;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
}

.book-editorial-status-error {
  display: block;
  margin: 8rpx 0;
  color: var(--ui-warning-text);
  font-size: var(--ui-font-caption);
  line-height: 1.4;
}

.book-editorial-section {
  margin-top: 12rpx;
}

.book-editorial-section + .book-editorial-section {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.book-editorial-label-row {
  min-height: 80rpx;
  margin-bottom: 2rpx;
}

.book-editorial-label-row .book-editorial-label {
  color: var(--ui-text-primary);
  font-size: 30rpx;
  font-weight: 600;
}

.book-editorial-generate {
  min-height: 80rpx;
  margin: 0;
  padding: 0 0 0 16rpx;
  flex: 0 0 auto;
  gap: 5rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  color: var(--ui-accent-strong);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.35;
}

.book-editorial-generate-arrow {
  font-size: 34rpx;
  font-weight: 300;
  line-height: 1;
}

.book-editorial-job-status {
  min-height: 42rpx;
  margin: 0 0 10rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-caption);
  line-height: 1.4;
}

.book-editorial-job-dot {
  width: 12rpx;
  height: 12rpx;
  flex: 0 0 12rpx;
  border-radius: 50%;
  background: currentColor;
}

.book-editorial-job-status.pending { color: var(--ui-warning-text); }
.book-editorial-job-status.running { color: var(--ui-accent-strong); }
.book-editorial-job-status.succeeded { color: var(--ui-success-text); }
.book-editorial-job-status.failed,
.book-editorial-job-status.skipped { color: var(--ui-danger-text); }

.book-editorial-job-error {
  width: 100%;
  padding-left: 20rpx;
  word-break: break-word;
}

.ui-accessible-page.large-text .book-editorial-job-status {
  font-size: var(--ui-font-large-caption);
}

.book-metadata-input,
.book-metadata-textarea {
  min-height: 88rpx;
  padding: 16rpx 18rpx;
  font-weight: 600;
}

.book-metadata-input {
  height: 88rpx;
  padding-top: 0;
  padding-bottom: 0;
  line-height: 88rpx;
}

.book-metadata-textarea {
  min-height: 146rpx;
}

.book-metadata-textarea.compact {
  min-height: 92rpx;
}

.book-editorial-textarea,
.book-editorial-textarea.compact {
  min-height: 86rpx;
  padding: 4rpx 0 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 1.55;
}

.book-editorial-textarea.compact {
  min-height: 50rpx;
}

.ui-accessible-page.large-text .book-title-suggestion {
  min-height: 96rpx;
  font-size: var(--ui-font-large-meta);
}

.ui-accessible-page.large-text .book-metadata-input {
  height: 96rpx;
  line-height: 96rpx;
}
