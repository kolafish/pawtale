.page {
  padding: 28rpx 30rpx 64rpx;
  color: var(--ui-text-primary);
}

.book-export-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.eyebrow,
.hero-title,
.hero-meta,
.version-pill,
.notice,
.section-title,
.setting-title,
.setting-meta,
.toc-item,
.preview-count,
.chapter-title,
.chapter-excerpt,
.export-action-title,
.export-action-meta,
.export-action-hint,
.section-count,
.manuscript-title,
.manuscript-subtitle,
.manuscript-meta,
.advanced-title,
.advanced-meta,
.advanced-value,
.structure-title,
.structure-meta,
.structure-status,
.chapter-index,
.chapter-intro,
.chapter-quote,
.chapter-quote-source,
.back-matter-kind,
.back-matter-title,
.back-matter-preview,
.book-output-text,
.state-card {
  display: block;
}

.export-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #eef3e9 0%, var(--ui-surface) 78%);
}

.export-hero-copy {
  min-width: 0;
  flex: 1;
}

.eyebrow {
  margin-bottom: 10rpx;
  color: var(--ui-section-title);
  font-family: var(--ui-font-editorial);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.eyebrow::after {
  content: "";
  display: block;
  width: 38rpx;
  height: 3rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  background: var(--ui-accent);
}

.hero-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.32;
  overflow-wrap: anywhere;
  text-wrap: balance;
}

.hero-meta {
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}

.version-pill {
  flex: 0 0 auto;
  padding: 8rpx 15rpx;
  border-radius: 999rpx;
  background: var(--ui-success-surface);
  color: var(--ui-success-text);
  font-size: 22rpx;
  line-height: 1.4;
}

.notice {
  padding: 18rpx 22rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface);
  box-shadow: var(--ui-control-shadow);
  color: var(--ui-value-text);
  font-size: 25rpx;
  line-height: 1.5;
  text-wrap: pretty;
}

.notice.warn {
  background: var(--ui-warning-surface);
  color: var(--ui-warning-text);
  box-shadow: none;
}

.notice.subtle {
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-text-secondary);
  box-shadow: none;
}

.state-card {
  padding: 30rpx;
  color: var(--ui-text-secondary);
  font-size: 27rpx;
  line-height: 1.6;
}

.state-card.error {
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
}

.primary-button,
.ghost-button,
.text-button {
  margin: 0;
  border: 0;
  color: var(--ui-value-text);
  font-size: 26rpx;
}

.primary-button,
.ghost-button {
  min-height: 88rpx;
  padding: 0 20rpx;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface);
  box-shadow: var(--ui-control-shadow);
  line-height: 1.35;
  text-align: center;
}

.primary-button {
  color: var(--ui-accent-strong);
}

.text-button {
  min-height: 88rpx;
  padding: 8rpx 12rpx;
  background: transparent;
  color: var(--ui-accent);
  line-height: 1.4;
}

.state-action,
.save-design-button {
  width: 100%;
}

.ghost-button.state-action {
  margin-top: 20rpx;
}

.export-section-title {
  margin: 4rpx 4rpx 0;
}

.export-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.export-action-row {
  width: 100%;
  min-height: 108rpx;
  padding: 16rpx 18rpx;
  justify-content: flex-start;
  gap: 18rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface);
  box-shadow: var(--ui-control-shadow);
  text-align: left;
}

.export-action-mark {
  width: 62rpx;
  height: 62rpx;
  flex: 0 0 62rpx;
  border-radius: 50%;
  background: var(--ui-accent-surface);
  color: var(--ui-accent-strong);
  font-family: var(--ui-font-editorial);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 62rpx;
  text-align: center;
}

.primary-button .export-action-mark {
  background: var(--ui-accent);
  color: var(--ui-on-accent);
}

.export-action-copy {
  min-width: 0;
  flex: 1;
}

.export-action-title {
  color: var(--ui-text-primary);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
}

.export-action-meta {
  margin-top: 3rpx;
  color: var(--ui-text-secondary);
  font-size: 22rpx;
  line-height: 1.4;
}

.ui-accessible-page.large-text .export-action-row {
  min-height: 124rpx;
}

.ui-accessible-page.large-text .export-action-title {
  font-size: 32rpx;
}

.ui-accessible-page.large-text .export-action-meta {
  font-size: 28rpx;
  line-height: 1.45;
}

.export-action-arrow {
  flex: 0 0 auto;
  padding-right: 2rpx;
  color: var(--ui-text-muted);
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
}

.export-action-hint {
  margin-top: -6rpx;
  padding: 0 6rpx;
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  line-height: 1.45;
}

.settings-toggle {
  width: 100%;
  min-height: 104rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface);
  box-shadow: var(--ui-control-shadow);
  color: var(--ui-text-primary);
}

.settings-toggle-copy,
.advanced-copy,
.book-editorial-copy-notice-copy,
.book-cover-style-copy,
.structure-main,
.back-matter-main {
  min-width: 0;
  flex: 1;
}

.settings-toggle-title,
.settings-toggle-meta,
.settings-toggle-action,
.book-design-title,
.book-design-meta,
.book-design-save-status,
.book-metadata-label,
.book-cover-style-label,
.book-cover-style-detail {
  display: block;
}

.settings-toggle-title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.settings-toggle-meta {
  margin-top: 5rpx;
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  line-height: 1.45;
}

.settings-toggle-action {
  flex: 0 0 auto;
  color: var(--ui-accent);
  font-size: 24rpx;
  font-weight: 700;
}

.book-design-panel,
.manuscript-card,
.advanced-card,
.preview-card {
  padding: 26rpx;
}

.book-design-head,
.section-head,
.preview-toggle-row,
.book-editorial-copy-notice-head,
.book-metadata-label-row,
.chapter-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.book-design-head {
  align-items: flex-start;
}

.book-design-title,
.section-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.4;
  text-wrap: balance;
}

.book-design-meta,
.advanced-meta,
.setting-meta,
.manuscript-subtitle,
.manuscript-meta,
.structure-meta,
.chapter-intro,
.back-matter-preview {
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  line-height: 1.52;
  text-wrap: pretty;
}

.book-design-meta,
.advanced-meta,
.manuscript-subtitle,
.manuscript-meta {
  margin-top: 5rpx;
}

.book-design-save-status {
  flex: 0 0 auto;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: var(--ui-success-surface);
  color: var(--ui-success-text);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.4;
}

.book-design-save-status.saving {
  color: var(--ui-text-secondary);
}

.book-editorial-copy-notice {
  min-height: 96rpx;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-radius: var(--ui-radius-inner);
  background: linear-gradient(135deg, var(--ui-success-surface), var(--ui-surface));
}

.book-editorial-copy-notice-title,
.book-editorial-copy-notice-status {
  color: var(--ui-accent-strong);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.book-editorial-copy-notice-text,
.book-editorial-copy-notice-detail {
  display: block;
  margin-top: 5rpx;
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  line-height: 1.45;
}

.book-editorial-copy-notice-detail {
  color: var(--ui-danger-text);
}

.book-editorial-copy-notice-action {
  flex: 0 0 auto;
  color: var(--ui-accent-strong);
  font-size: 23rpx;
  font-weight: 700;
}

.book-title-editor {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.book-title-input,
.book-metadata-input,
.book-metadata-textarea {
  box-sizing: border-box;
  width: 100%;
  border: 0;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface-soft);
  box-shadow: inset 0 0 0 1rpx rgba(54, 42, 34, 0.055);
  color: var(--ui-text-primary);
  font-size: 26rpx;
  line-height: 1.45;
}

.book-title-input {
  min-width: 0;
  height: 88rpx;
  flex: 1;
  padding: 0 20rpx;
  font-family: var(--ui-font-editorial);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.book-title-ai,
.book-editorial-generate {
  min-height: 88rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: var(--ui-radius-control);
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-accent-strong);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.35;
}

.book-title-ai {
  flex: 0 0 auto;
}

.book-title-suggestion-list {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.book-title-suggestion {
  max-width: 100%;
  min-height: 88rpx;
  padding: 0 17rpx;
  border-radius: 999rpx;
  background: var(--ui-accent-surface);
  color: var(--ui-accent-strong);
  display: inline-flex;
  align-items: center;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.35;
}

.book-title-suggestion text {
  word-break: break-word;
}

.book-metadata-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
}

.book-metadata-field {
  margin-top: 16rpx;
}

.book-metadata-grid .book-metadata-field {
  margin-top: 0;
}

.book-metadata-label {
  margin-bottom: 8rpx;
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.35;
}

.book-metadata-label-row {
  min-height: 50rpx;
  margin-bottom: 8rpx;
}

.book-metadata-label-row .book-metadata-label {
  margin-bottom: 0;
}

.book-editorial-generate {
  min-width: 112rpx;
}

.book-metadata-input,
.book-metadata-textarea {
  min-height: 88rpx;
  padding: 16rpx 18rpx;
  font-weight: 600;
}

.book-metadata-input {
  height: 88rpx;
  padding-top: 0;
  padding-bottom: 0;
  line-height: 88rpx;
}

.book-metadata-textarea {
  min-height: 146rpx;
}

.book-metadata-textarea.compact {
  min-height: 92rpx;
}

.ui-accessible-page.large-text .book-title-suggestion {
  min-height: 96rpx;
  font-size: 28rpx;
}

.ui-accessible-page.large-text .book-metadata-input {
  height: 96rpx;
  line-height: 96rpx;
}

.book-cover-style-picker {
  min-height: 128rpx;
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
  box-shadow: var(--ui-control-shadow);
}

.book-cover-preview {
  position: relative;
  width: 76rpx;
  height: 106rpx;
  flex: 0 0 76rpx;
  padding: 12rpx 8rpx;
  overflow: hidden;
  border-radius: 10rpx;
  outline: 1rpx solid rgba(0, 0, 0, 0.1);
  outline-offset: -1rpx;
}

.book-cover-preview-title {
  position: relative;
  z-index: 1;
  display: block;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 14rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
  word-break: break-word;
}

.book-cover-preview.classic-plain {
  background: linear-gradient(180deg, #fbf1de, #f4dfc3);
}

.book-cover-preview.warm-gray {
  background: linear-gradient(180deg, #ece8df, #d8d0c2);
}

.book-cover-preview.dark-album {
  background: #3b302a;
}

.book-cover-preview.moonlit-courtyard {
  background: linear-gradient(180deg, #eef2ea, #d9dfd4 58%, #c2b59d);
}

.book-cover-preview.navy-gilt {
  background: #182b46;
  box-shadow: inset 0 0 0 2rpx #bfa46c;
}

.book-cover-preview.dark-album .book-cover-preview-title,
.book-cover-preview.navy-gilt .book-cover-preview-title {
  color: #f7eadc;
}

.book-cover-preview.moonlit-courtyard::after {
  content: "";
  position: absolute;
  right: 12rpx;
  bottom: 14rpx;
  left: 12rpx;
  height: 22rpx;
  border-top: 3rpx solid rgba(0, 0, 0, 0.42);
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.22);
}

.book-cover-preview.navy-gilt::after {
  content: "";
  position: absolute;
  inset: 8rpx;
  border: 2rpx solid #bfa46c;
}

.book-cover-style-label {
  color: var(--ui-text-primary);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.35;
}

.book-cover-style-detail {
  margin-top: 4rpx;
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  line-height: 1.4;
  word-break: break-word;
}

.book-cover-style-value,
.section-count,
.preview-count {
  flex: 0 0 auto;
  color: var(--ui-section-title);
  font-size: 23rpx;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
}

.save-design-button {
  margin-top: 18rpx;
  border-radius: var(--ui-radius-control);
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-accent-strong);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
  font-weight: 700;
}

.manuscript-section + .manuscript-section {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.manuscript-cover-summary {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-success-surface);
}

.manuscript-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.45;
}

.structure-list,
.manuscript-chapter-list,
.back-matter-list,
.toc-list,
.chapter-preview-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.structure-row,
.back-matter-row,
.manuscript-chapter,
.chapter-preview,
.advanced-row {
  padding: 18rpx 20rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
}

.structure-row,
.back-matter-row,
.advanced-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.advanced-row {
  min-height: 96rpx;
  margin-top: 14rpx;
  align-items: center;
}

.advanced-title,
.structure-title,
.back-matter-title {
  color: var(--ui-text-primary);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}

.advanced-value,
.structure-status,
.back-matter-kind {
  flex: 0 0 auto;
  color: var(--ui-accent);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.45;
}

.advanced-value.muted {
  color: var(--ui-text-muted);
  font-weight: 600;
}

.ghost-button.compact {
  min-width: 160rpx;
  flex: 0 0 auto;
  background: var(--ui-surface);
}

.chapter-heading {
  justify-content: flex-start;
  align-items: baseline;
}

.chapter-index {
  flex: 0 0 auto;
  color: var(--ui-section-title);
  font-size: 23rpx;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
}

.chapter-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.45;
}

.chapter-intro {
  margin-top: 9rpx;
}

.chapter-quote {
  margin-top: 12rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid var(--ui-accent-border);
  color: var(--ui-value-text);
  font-family: var(--ui-font-editorial);
  font-size: 24rpx;
  line-height: 1.6;
}

.chapter-quote-source {
  margin-top: 6rpx;
  color: var(--ui-section-title);
  font-family: initial;
  font-size: 22rpx;
  line-height: 1.4;
}

.export-settings {
  overflow: hidden;
  background: var(--ui-success-surface);
  box-shadow: none;
}

.setting-row {
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.setting-row > view {
  min-width: 0;
  flex: 1;
}

.setting-title {
  color: var(--ui-text-primary);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
}

.reader-entry-action {
  margin: -8rpx -10rpx -8rpx 0;
  font-weight: 700;
}

.toc-group {
  min-width: 0;
  padding-left: 18rpx;
  border-left: 3rpx solid var(--ui-accent-border);
}

.toc-item {
  color: var(--ui-value-text);
  font-size: 26rpx;
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}

.toc-small-section {
  display: block;
  margin: 6rpx 0 0 22rpx;
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
  word-break: break-word;
}

.preview-toggle-row {
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.chapter-small-section-list {
  margin-top: 15rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.chapter-small-section + .chapter-small-section {
  padding-top: 17rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.chapter-small-section-title {
  display: block;
  color: var(--ui-value-text);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.45;
  word-break: break-word;
}

.chapter-excerpt {
  margin-top: 9rpx;
  color: var(--ui-value-text);
  font-size: 25rpx;
  line-height: 1.65;
  text-wrap: pretty;
}

.book-output-text {
  margin-top: 22rpx;
  color: var(--ui-value-text);
  font-family: var(--ui-font-editorial);
  font-size: 26rpx;
  line-height: 1.78;
  white-space: pre-wrap;
}
