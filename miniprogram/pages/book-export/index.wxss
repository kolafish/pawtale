.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx;
  background: #fcf7ed;
  color: #332822;
}

.book-export-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.export-hero,
.state-card,
.export-settings,
.preview-card {
  box-sizing: border-box;
  border: 1rpx solid #ead9c8;
  border-radius: 12rpx;
  background: #fffaf3;
  box-shadow: 0 10rpx 24rpx rgba(93, 59, 40, 0.06);
}

.export-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 28rpx;
}

.eyebrow,
.hero-title,
.hero-meta,
.version-pill,
.notice,
.section-title,
.setting-title,
.setting-meta,
.setting-value,
.toc-item,
.preview-count,
.chapter-title,
.chapter-excerpt,
.book-output-text,
.state-card {
  display: block;
}

.eyebrow {
  margin-bottom: 8rpx;
  color: #9b6a52;
  font-size: 24rpx;
}

.hero-title {
  color: #2f241f;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.28;
}

.hero-meta {
  margin-top: 10rpx;
  color: #7b6f68;
  font-size: 26rpx;
  line-height: 1.5;
}

.version-pill {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f1e1d2;
  color: #6f5144;
  font-size: 22rpx;
  line-height: 1.4;
}

.notice {
  padding: 18rpx 22rpx;
  border: 1rpx solid #e5d2c1;
  border-radius: 10rpx;
  background: #fffdf8;
  color: #6f5144;
  font-size: 25rpx;
  line-height: 1.5;
}

.notice.warn {
  border-color: #e7b1a6;
  background: #fff5f2;
  color: #a64b3e;
}

.notice.subtle {
  background: #f7efe7;
  color: #7b6f68;
}

.state-card {
  padding: 30rpx;
  color: #7b6f68;
  font-size: 27rpx;
  line-height: 1.6;
}

.state-card.error {
  border-color: #e7b1a6;
  color: #a64b3e;
}

.export-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(180rpx, 1fr));
  gap: 16rpx;
}

.primary-button,
.ghost-button,
.text-button {
  margin: 0;
  border-radius: 10rpx;
  font-size: 26rpx;
  line-height: 2.6;
}

.primary-button {
  background: #a64b3e;
  color: #fff;
}

.ghost-button {
  border: 1rpx solid #d7bba8;
  background: #fffaf3;
  color: #6f5144;
}

.text-button {
  padding: 0;
  background: transparent;
  color: #a64b3e;
  line-height: 1.6;
}

.text-button::after {
  border: 0;
}

.book-design-panel {
  padding: 26rpx;
  border: 1rpx solid #ead9c8;
  border-radius: 12rpx;
  background: #fffaf3;
  box-shadow: 0 10rpx 24rpx rgba(93, 59, 40, 0.06);
  box-sizing: border-box;
}

.book-design-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.book-design-title,
.book-design-meta,
.book-design-save-status,
.book-metadata-label,
.book-cover-style-label,
.book-cover-style-detail {
  display: block;
}

.book-design-title {
  color: #332822;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}

.book-design-meta {
  margin-top: 6rpx;
  color: #7b6f68;
  font-size: 24rpx;
  line-height: 1.4;
}

.book-design-save-status {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff5f1;
  color: #8a4035;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
}

.book-design-save-status.saving {
  color: #6f625b;
}

.book-title-editor {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.book-title-input {
  min-width: 0;
  flex: 1;
  height: 78rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e8d8c3;
  border-radius: 12rpx;
  background: #fffdf9;
  color: #2f241f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 78rpx;
  box-sizing: border-box;
}

.book-title-ai {
  flex-shrink: 0;
  height: 68rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 0;
  border-radius: 10rpx;
  background: #fff3ef;
  color: #8f3e35;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 68rpx;
}

.book-title-ai::after {
  border: 0;
}

.book-title-suggestion-list {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.book-title-suggestion {
  max-width: 100%;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #fff3ef;
  color: #8f3e35;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  box-sizing: border-box;
}

.book-title-suggestion text {
  word-break: break-word;
}

.book-metadata-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
}

.book-metadata-field {
  margin-top: 16rpx;
}

.book-metadata-grid .book-metadata-field {
  margin-top: 0;
}

.book-metadata-label {
  margin-bottom: 8rpx;
  color: #7b6f68;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.35;
}

.book-metadata-label-row {
  min-height: 46rpx;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.book-metadata-label-row .book-metadata-label {
  margin-bottom: 0;
}

.book-editorial-generate {
  height: 52rpx;
  min-width: 112rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 2rpx solid #d9c5ae;
  border-radius: 999rpx;
  background: #fcf7ed;
  color: #a64b3e;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 48rpx;
  box-sizing: border-box;
}

.book-editorial-generate::after {
  border: 0;
}

.book-metadata-input,
.book-metadata-textarea {
  width: 100%;
  min-height: 72rpx;
  padding: 16rpx 18rpx;
  border: 2rpx solid #e8d8c3;
  border-radius: 12rpx;
  background: #fffdf9;
  color: #2f241f;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.45;
  box-sizing: border-box;
}

.book-metadata-input {
  height: 72rpx;
  padding-top: 0;
  padding-bottom: 0;
  line-height: 72rpx;
}

.book-metadata-textarea {
  min-height: 150rpx;
}

.book-metadata-textarea.compact {
  min-height: 94rpx;
}

.book-cover-style-picker {
  margin-top: 18rpx;
  min-height: 76rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid #ead9c7;
  border-radius: 12rpx;
  background: #fffdf9;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  box-sizing: border-box;
}

.book-cover-preview {
  position: relative;
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 106rpx;
  padding: 12rpx 8rpx;
  border: 2rpx solid rgba(80, 56, 38, 0.16);
  border-radius: 8rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.book-cover-preview-title {
  position: relative;
  z-index: 1;
  display: block;
  color: #2d1b15;
  font-size: 14rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
  word-break: break-word;
}

.book-cover-preview.classic-plain {
  background: linear-gradient(180deg, #fbf1de 0%, #f4dfc3 100%);
}

.book-cover-preview.warm-gray {
  background: linear-gradient(180deg, #ece8df 0%, #d8d0c2 100%);
}

.book-cover-preview.dark-album {
  background: #3b302a;
}

.book-cover-preview.dark-album .book-cover-preview-title,
.book-cover-preview.navy-gilt .book-cover-preview-title {
  color: #f7eadc;
}

.book-cover-preview.moonlit-courtyard {
  background: linear-gradient(180deg, #eef2ea 0%, #d9dfd4 58%, #c2b59d 100%);
}

.book-cover-preview.moonlit-courtyard::after {
  content: "";
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  bottom: 14rpx;
  height: 22rpx;
  border-top: 3rpx solid rgba(76, 62, 50, 0.42);
  border-bottom: 2rpx solid rgba(76, 62, 50, 0.22);
}

.book-cover-preview.navy-gilt {
  border-color: #bfa46c;
  background: #182b46;
}

.book-cover-preview.navy-gilt::after {
  content: "";
  position: absolute;
  inset: 8rpx;
  border: 2rpx solid #bfa46c;
}

.book-cover-style-copy {
  min-width: 0;
  flex: 1;
}

.book-cover-style-label {
  color: #2f241f;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.35;
}

.book-cover-style-detail {
  margin-top: 4rpx;
  color: #7b6f68;
  font-size: 23rpx;
  line-height: 1.4;
  word-break: break-word;
}

.book-cover-style-value {
  flex-shrink: 0;
  color: #a64b3e;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
}

.save-design-button {
  width: 100%;
  margin-top: 18rpx;
}

.export-settings {
  overflow: hidden;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 18rpx;
  padding: 24rpx 26rpx;
  border-bottom: 1rpx solid #f0e2d4;
}

.setting-row:last-child {
  border-bottom: 0;
}

.setting-title {
  color: #332822;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.setting-meta {
  margin-top: 6rpx;
  color: #7b6f68;
  font-size: 24rpx;
  line-height: 1.45;
}

.setting-value {
  flex-shrink: 0;
  color: #a64b3e;
  font-size: 25rpx;
  white-space: nowrap;
}

.preview-card {
  padding: 26rpx;
}

.section-head,
.preview-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.section-title {
  color: #332822;
  font-size: 32rpx;
  font-weight: 700;
}

.version-link {
  color: #a64b3e;
  font-size: 25rpx;
}

.toc-list,
.chapter-preview-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 22rpx;
}

.toc-item {
  color: #6f5144;
  font-size: 26rpx;
  line-height: 1.5;
}

.preview-toggle-row {
  margin-top: 26rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0e2d4;
}

.preview-count {
  color: #7b6f68;
  font-size: 25rpx;
}

.chapter-preview {
  padding: 20rpx;
  border-radius: 10rpx;
  background: #fffdf8;
}

.chapter-title {
  color: #332822;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
}

.chapter-excerpt {
  margin-top: 10rpx;
  color: #6f5144;
  font-size: 25rpx;
  line-height: 1.65;
}

.book-output-text {
  margin-top: 22rpx;
  color: #4d3d34;
  font-size: 26rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}
