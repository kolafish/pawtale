.page {
  padding: 28rpx 30rpx calc(72rpx + env(safe-area-inset-bottom));
  color: var(--ui-text-primary);
}
.book-export-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}
.overview-card,
.detail-card {
