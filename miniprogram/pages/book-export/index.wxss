.page {
  padding: 28rpx 30rpx calc(72rpx + env(safe-area-inset-bottom));
  color: var(--ui-text-primary);
}

.book-export-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.export-hero,
.overview-card,
.detail-card {
  padding: 28rpx;
}

.export-hero {
  overflow: hidden;
  background: linear-gradient(150deg, #fffdfa 45%, #f9f5ef);
}

.hero-main,
.hero-actions,
.detail-heading,
.list-row,
.detail-setting-row,
.detail-info-row {
  display: flex;
  align-items: center;
}

.hero-main {
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-copy,
.row-copy,
.book-cover-style-copy,
.book-editorial-copy-notice-copy {
  min-width: 0;
  flex: 1;
}

.hero-title,
.hero-subtitle,
.hero-meta,
.section-title,
.section-description,
.row-title,
.row-detail,
.row-value,
.state-card,
.notice,
.save-status {
  display: block;
}

.hero-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 45rpx;
  font-weight: 700;
  line-height: 1.25;
  word-break: break-word;
  text-wrap: balance;
}

.hero-subtitle {
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  text-wrap: pretty;
}

.hero-meta {
  margin-top: 18rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  font-variant-numeric: tabular-nums;
}

.hero-cover {
  position: relative;
  width: 168rpx;
  height: 226rpx;
  flex: 0 0 168rpx;
  padding: 28rpx 15rpx;
  overflow: hidden;
  border-radius: 13rpx;
  outline: 1rpx solid rgba(0, 0, 0, 0.1);
  outline-offset: -1rpx;
  box-shadow: 5rpx 12rpx 24rpx rgba(54, 42, 34, 0.13);
  background: linear-gradient(180deg, #fbf1de, #f4dfc3);
}

.hero-cover.classic-plain { background: linear-gradient(180deg, #fbf1de, #f4dfc3); }
.hero-cover.warm-gray { background: linear-gradient(180deg, #ece8df, #d8d0c2); }
.hero-cover.dark-album { background: #3b302a; }
.hero-cover.moonlit-courtyard { background: linear-gradient(180deg, #eef2ea, #d9dfd4 58%, #c2b59d); }
.hero-cover.navy-gilt { background: #182b46; }
.hero-cover.dark-album .hero-cover-title,
.hero-cover.navy-gilt .hero-cover-title { color: #f7eadc; }

.hero-cover-branch {
  position: absolute;
  right: -26rpx;
  bottom: -18rpx;
  width: 180rpx;
  height: 180rpx;
  opacity: 0.35;
}

.hero-cover-title {
  position: relative;
  z-index: 1;
  display: block;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: center;
  word-break: break-word;
}

.hero-actions {
  gap: 16rpx;
  margin-top: 25rpx;
}

.hero-action {
  min-width: 0;
  min-height: 84rpx;
  flex: 1;
  padding: 18rpx 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 999rpx;
  font-size: var(--ui-font-action);
  font-weight: 700;
  text-align: center;
}

.hero-action.primary { background: var(--ui-accent-strong); color: #fff; }
.hero-action.secondary { color: var(--ui-accent-strong); box-shadow: inset 0 0 0 2rpx var(--ui-accent-border); }
.hero-action text { font-size: var(--ui-font-action); font-weight: 400; }

.section-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-section-title);
  font-weight: 700;
  line-height: 1.4;
  text-wrap: balance;
}

.section-description {
  margin-top: 4rpx;
  margin-bottom: 11rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  text-wrap: pretty;
}

.list-row {
  box-sizing: border-box;
  width: 100%;
  min-height: 92rpx;
  justify-content: space-between;
  gap: 12rpx;
  margin: 0;
  padding: 15rpx 4rpx;
  border: 0;
  border-radius: 0;
  border-bottom: 1rpx solid var(--ui-divider);
  background: transparent;
  color: var(--ui-text-primary);
  text-align: left;
  line-height: 1.35;
}

.list-row::after { border: 0; }
.list-row:last-child { border-bottom: 0; }
.export-row { min-height: 106rpx; }
.export-row.is-disabled { pointer-events: none; opacity: 0.62; }
.section-entry { cursor: pointer; }
.row-title { font-size: var(--ui-font-list-title); font-weight: 600; line-height: 1.4; }
.row-detail { margin-top: 4rpx; color: var(--ui-text-secondary); font-size: var(--ui-font-body); line-height: var(--ui-line-body); text-wrap: pretty; }
.row-value { max-width: 42%; margin-left: auto; overflow: hidden; color: var(--ui-text-secondary); font-size: var(--ui-font-meta); line-height: var(--ui-line-meta); text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.row-arrow { flex: 0 0 auto; color: var(--ui-text-muted); font-size: 36rpx; font-weight: 300; line-height: 1; }
.row-busy { flex: 0 0 auto; color: var(--ui-accent-strong); font-size: var(--ui-font-caption); }

.notice,
.state-card {
  padding: 22rpx 26rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: 1.5;
}
.notice { border-radius: var(--ui-radius-inner); background: var(--ui-surface); box-shadow: var(--ui-control-shadow); }
.notice.warn,
.state-card.error { background: var(--ui-warning-surface); color: var(--ui-warning-text); }
.state-action,
.detail-action {
  min-height: 88rpx;
  margin: 20rpx 0 0;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: var(--ui-radius-control);
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-action);
  font-weight: 700;
}
.state-action::after,
.detail-action::after { border: 0; }

.subpage-back {
  min-height: 96rpx;
  padding: 18rpx 8rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-action);
  font-weight: 700;
}
.subpage-back-arrow {
  min-width: 36rpx;
  font-size: 42rpx;
  font-weight: 400;
  line-height: 1;
  text-align: center;
}
.detail-heading { justify-content: space-between; gap: 12rpx; }
.save-status { color: var(--ui-text-secondary); font-size: var(--ui-font-caption); }
.detail-setting-row { min-height: 118rpx; justify-content: space-between; gap: 18rpx; }
.detail-info-row { min-height: 86rpx; justify-content: space-between; gap: 16rpx; border-bottom: 1rpx solid var(--ui-divider); font-size: var(--ui-font-body); }
.detail-info-row text:last-child { color: var(--ui-text-secondary); text-align: right; }
.advanced-action { margin-top: 22rpx; }
.advanced-action .row-detail { margin-top: 8rpx; }

.book-editorial-copy-notice-head,
.book-metadata-label-row { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.save-design-button {
  width: 100%;
  min-height: 88rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-control);
  background: var(--ui-accent-surface-subtle);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-action);
  font-weight: 700;
}

.ui-accessible-page.large-text .row-title,
.ui-accessible-page.large-text .hero-action { font-size: var(--ui-font-large-body); }
.ui-accessible-page.large-text .row-detail,
.ui-accessible-page.large-text .row-value { font-size: var(--ui-font-large-caption); }
.ui-accessible-page.large-text .list-row { min-height: 112rpx; }

.book-editorial-copy-notice {
  min-height: 96rpx;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-accent-surface-subtle);
}

.book-editorial-copy-notice-title,
.book-editorial-copy-notice-status {
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-body);
  font-weight: 700;
  line-height: var(--ui-line-body);
}

.book-editorial-copy-notice-text,
.book-editorial-copy-notice-detail {
  display: block;
  margin-top: 5rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
}

.book-editorial-copy-notice-detail {
  color: var(--ui-danger-text);
}

.book-editorial-copy-notice-action {
  flex: 0 0 auto;
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-action);
  font-weight: 700;
}

.book-title-editor {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.book-title-sync-hint {
  display: block;
  margin-top: 20rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  text-wrap: pretty;
}

.book-title-input,
.book-metadata-input,
.book-metadata-textarea {
  box-sizing: border-box;
  width: 100%;
  border: 0;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface-soft);
  box-shadow: inset 0 0 0 1rpx rgba(54, 42, 34, 0.055);
  color: var(--ui-text-primary);
  font-size: var(--ui-font-meta);
  line-height: 1.45;
}

.book-title-input {
  min-width: 0;
  height: 88rpx;
  flex: 1;
  padding: 0 20rpx;
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-list-title);
  font-weight: 700;
  line-height: 88rpx;
}

.book-title-ai {
  min-height: 88rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: var(--ui-radius-control);
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-action);
  font-weight: 700;
  line-height: 1.35;
}

.book-title-ai {
  width: 184rpx;
  min-width: 184rpx;
  max-width: 184rpx;
  padding: 0 12rpx;
  flex: 0 0 184rpx;
}

.book-title-suggestion-list {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.book-title-suggestion {
  max-width: 100%;
  min-height: 88rpx;
  padding: 0 17rpx;
  border-radius: 999rpx;
  background: var(--ui-accent-surface);
  color: var(--ui-accent-strong);
  display: inline-flex;
  align-items: center;
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 1.35;
}

.book-title-suggestion text {
  word-break: break-word;
}

.book-metadata-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
}

.book-metadata-field {
  margin-top: 16rpx;
}

.book-metadata-grid .book-metadata-field {
  margin-top: 0;
}

.book-metadata-label {
  margin-bottom: 8rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-caption);
  font-weight: 700;
  line-height: 1.35;
}

.book-metadata-label-row {
  min-height: 50rpx;
  margin-bottom: 8rpx;
}

.book-metadata-label-row .book-metadata-label {
  margin-bottom: 0;
}

.editorial-detail-card {
  padding-top: 22rpx;
}

.book-editorial-save-row {
  min-height: 34rpx;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
}

.book-editorial-section {
  margin-top: 12rpx;
}

.book-editorial-section + .book-editorial-section {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.book-editorial-label-row {
  min-height: 80rpx;
  margin-bottom: 2rpx;
}

.book-editorial-label-row .book-editorial-label {
  color: var(--ui-text-primary);
  font-size: 30rpx;
  font-weight: 600;
}

.book-editorial-generate {
  min-height: 80rpx;
  margin: 0;
  padding: 0 0 0 16rpx;
  flex: 0 0 auto;
  gap: 5rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  color: var(--ui-accent-strong);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.35;
}

.book-editorial-generate-arrow {
  font-size: 34rpx;
  font-weight: 300;
  line-height: 1;
}

.book-metadata-input,
.book-metadata-textarea {
  min-height: 88rpx;
  padding: 16rpx 18rpx;
  font-weight: 600;
}

.book-metadata-input {
  height: 88rpx;
  padding-top: 0;
  padding-bottom: 0;
  line-height: 88rpx;
}

.book-metadata-textarea {
  min-height: 146rpx;
}

.book-metadata-textarea.compact {
  min-height: 92rpx;
}

.book-editorial-textarea,
.book-editorial-textarea.compact {
  min-height: 86rpx;
  padding: 4rpx 0 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 1.55;
}

.book-editorial-textarea.compact {
  min-height: 50rpx;
}

.ui-accessible-page.large-text .book-title-suggestion {
  min-height: 96rpx;
  font-size: var(--ui-font-large-meta);
}

.ui-accessible-page.large-text .book-metadata-input {
  height: 96rpx;
  line-height: 96rpx;
}

.book-cover-style-picker {
  min-height: 128rpx;
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
  box-shadow: var(--ui-control-shadow);
}

.book-cover-preview {
  position: relative;
  width: 76rpx;
  height: 106rpx;
  flex: 0 0 76rpx;
  padding: 12rpx 8rpx;
  overflow: hidden;
  border-radius: 10rpx;
  outline: 1rpx solid rgba(0, 0, 0, 0.1);
  outline-offset: -1rpx;
}

.book-cover-preview-title {
  position: relative;
  z-index: 1;
  display: block;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 14rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
  word-break: break-word;
}

.book-cover-preview.classic-plain {
  background: linear-gradient(180deg, #fbf1de, #f4dfc3);
}

.book-cover-preview.warm-gray {
  background: linear-gradient(180deg, #ece8df, #d8d0c2);
}

.book-cover-preview.dark-album {
  background: #3b302a;
}

.book-cover-preview.moonlit-courtyard {
  background: linear-gradient(180deg, #eef2ea, #d9dfd4 58%, #c2b59d);
}

.book-cover-preview.navy-gilt {
  background: #182b46;
  box-shadow: inset 0 0 0 2rpx #bfa46c;
}

.book-cover-preview.dark-album .book-cover-preview-title,
.book-cover-preview.navy-gilt .book-cover-preview-title {
  color: #f7eadc;
}

.book-cover-preview.moonlit-courtyard::after {
  content: "";
  position: absolute;
  right: 12rpx;
  bottom: 14rpx;
  left: 12rpx;
  height: 22rpx;
  border-top: 3rpx solid rgba(0, 0, 0, 0.42);
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.22);
}

.book-cover-preview.navy-gilt::after {
  content: "";
  position: absolute;
  inset: 8rpx;
  border: 2rpx solid #bfa46c;
}

.book-cover-style-label {
  display: block;
  color: var(--ui-text-primary);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 1.35;
}

.book-cover-style-detail {
  display: block;
  margin-top: 4rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  word-break: break-word;
}
