}
.detail-heading,
.list-row,
.detail-setting-row,
.detail-info-row {
  display: flex;
  align-items: center;
}
.row-copy {
  min-width: 0;
  flex: 1;
}
.section-title,
.section-description,
.row-title,
.row-detail,
.row-value,
.state-card,
.notice,
