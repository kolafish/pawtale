<view class="page book-export-page">
  <view wx:if="{{loading}}" class="state-card">
    <text>正在加载全书...</text>
  </view>

  <view wx:elif="{{error}}" class="state-card error">
    <text>{{error}}</text>
  </view>

  <block wx:else>
    <view class="export-hero">
      <view>
        <text class="eyebrow">全书导出</text>
        <text class="hero-title">{{bookManuscriptTitle || bookPreviewTitle || planTitle}}</text>
        <text class="hero-meta">
          {{totalChapterCount}} 章 · {{bookCharCount || 0}} 字 · {{bookContent ? "已生成书稿" : "尚未生成书稿"}}
        </text>
      </view>
      <text wx:if="{{bookVersionText}}" class="version-pill">{{bookVersionText}}</text>
    </view>

    <view wx:if="{{bookStaleNotice}}" class="notice warn">{{bookStaleNotice}}</view>
    <view wx:elif="{{exportNotice}}" class="notice">{{exportNotice}}</view>
    <view wx:if="{{bookVersionNotice}}" class="notice subtle">{{bookVersionNotice}}</view>

    <view wx:if="{{!bookContent}}" class="state-card">
      <text>回到成书页生成全书后，可以在这里预览和导出。</text>
    </view>

    <block wx:else>
      <view class="export-actions">
        <button
          class="primary-button"
          data-format="pdf"
          loading="{{bookExportBusyTarget === 'book-export:pdf:' + bookExportLayout}}"
          disabled="{{bookStaleNotice || bookExportBusyTarget}}"
          bindtap="downloadBookOutputExport"
        >
          阅读版 PDF
        </button>
        <button
          class="ghost-button"
          data-format="pdf"
          data-layout="large_print"
          loading="{{bookExportBusyTarget === 'book-export:pdf:large_print'}}"
          disabled="{{bookStaleNotice || bookExportBusyTarget}}"
          bindtap="downloadBookOutputExport"
        >
          打印版 PDF
        </button>
        <button
          class="ghost-button"
          data-format="txt"
          loading="{{bookExportBusyTarget === 'book-export:txt:standard'}}"
          disabled="{{bookStaleNotice || bookExportBusyTarget}}"
          bindtap="downloadBookOutputExport"
        >
          导出文本
        </button>
      </view>

      <view class="book-design-panel">
        <view class="book-design-head">
          <view>
            <text class="book-design-title">成书信息</text>
            <text class="book-design-meta">{{bookCoverStyleLabel}} · {{bookOutput && bookOutput.latest_version ? "已生成" : "待生成"}}</text>
          </view>
          <text class="book-design-save-status {{bookTitleSaving ? 'saving' : ''}}">{{bookDesignSaveStatusText}}</text>
        </view>

        <view class="book-title-editor">
          <input
            class="book-title-input"
            value="{{bookTitleInput}}"
            placeholder="输入书名"
            maxlength="40"
            disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
            bindinput="changeBookTitle"
          />
          <button
            class="book-title-ai"
            loading="{{bookTitleSuggesting}}"
            disabled="{{bookTitleSuggesting || bookTitleSaving || bookViewingHistoricalVersion || !bookContent}}"
            bindtap="suggestBookTitles"
          >
            {{bookTitleSuggesting ? "起名中" : "小余起名"}}
          </button>
        </view>

        <view wx:if="{{bookTitleSuggestions.length}}" class="book-title-suggestion-list">
          <view
            wx:for="{{bookTitleSuggestions}}"
            wx:key="*this"
            class="book-title-suggestion"
            data-title="{{item}}"
            bindtap="chooseBookTitleSuggestion"
          >
            <text>{{item}}</text>
          </view>
        </view>

        <view class="book-metadata-grid">
          <view class="book-metadata-field">
            <text class="book-metadata-label">副标题</text>
            <input
              class="book-metadata-input"
              value="{{bookSubtitleInput}}"
              placeholder="根据口述访谈整理"
              maxlength="80"
              disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
              data-key="subtitle"
              bindinput="changeBookMetadataField"
            />
          </view>
          <view class="book-metadata-field">
            <text class="book-metadata-label">口述人</text>
            <input
              class="book-metadata-input"
              value="{{bookNarratorNameInput}}"
              placeholder="例如：爷爷 / 外婆 / 某某"
              maxlength="40"
              disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
              data-key="narrator_name"
              bindinput="changeBookMetadataField"
            />
          </view>
          <view class="book-metadata-field">
            <text class="book-metadata-label">整理人</text>
            <input
              class="book-metadata-input"
              value="{{bookPreparedByInput}}"
              placeholder="家人整理"
              maxlength="40"
              disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
              data-key="prepared_by"
              bindinput="changeBookMetadataField"
            />
          </view>
        </view>

        <view class="book-metadata-field">
          <view class="book-metadata-label-row">
            <text class="book-metadata-label">前言</text>
            <button
              class="book-editorial-generate"
              data-target="preface"
              loading="{{bookEditorialCopyBusyTarget === 'preface'}}"
              disabled="{{bookTitleSaving || bookViewingHistoricalVersion || bookEditorialCopyBusyTarget === 'preface' || !bookContent}}"
              bindtap="regenerateBookEditorialCopy"
            >
              重写
            </button>
          </view>
          <textarea
            class="book-metadata-textarea"
            value="{{bookPrefaceInput}}"
            placeholder="写给家人看的开篇说明"
            maxlength="600"
            auto-height
            disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
            data-key="preface"
            bindinput="changeBookMetadataField"
          />
        </view>

        <view class="book-metadata-field">
          <view class="book-metadata-label-row">
            <text class="book-metadata-label">后记</text>
            <button
              class="book-editorial-generate"
              data-target="afterword"
              loading="{{bookEditorialCopyBusyTarget === 'afterword'}}"
              disabled="{{bookTitleSaving || bookViewingHistoricalVersion || bookEditorialCopyBusyTarget === 'afterword' || !bookContent}}"
              bindtap="regenerateBookEditorialCopy"
            >
              重写
            </button>
          </view>
          <textarea
            class="book-metadata-textarea"
            value="{{bookAfterwordInput}}"
            placeholder="作为整本书结尾的一段话"
            maxlength="600"
            auto-height
            disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
            data-key="afterword"
            bindinput="changeBookMetadataField"
          />
        </view>

        <view class="book-metadata-field">
          <view class="book-metadata-label-row">
            <text class="book-metadata-label">封底摘录</text>
            <button
              class="book-editorial-generate"
              data-target="back_cover_quote"
              loading="{{bookEditorialCopyBusyTarget === 'back_cover_quote'}}"
              disabled="{{bookTitleSaving || bookViewingHistoricalVersion || bookEditorialCopyBusyTarget === 'back_cover_quote' || !bookContent}}"
              bindtap="regenerateBookEditorialCopy"
            >
              重写
            </button>
          </view>
          <textarea
            class="book-metadata-textarea compact"
            value="{{bookBackCoverQuoteInput}}"
            placeholder="可以放一句正文原话"
            maxlength="80"
            auto-height
            disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
            data-key="back_cover_quote"
            bindinput="changeBookMetadataField"
          />
        </view>

        <picker
          mode="selector"
          range="{{bookCoverStyleOptions}}"
          range-key="label"
          value="{{bookCoverStyleIndex}}"
          disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
          bindchange="changeBookCoverStyle"
        >
          <view class="book-cover-style-picker">
            <view class="book-cover-preview {{bookCoverStylePreviewClass}}">
              <text class="book-cover-preview-title">{{bookTitleInput || bookPreviewTitle || "回忆录"}}</text>
            </view>
            <view class="book-cover-style-copy">
              <text class="book-cover-style-label">封面风格</text>
              <text class="book-cover-style-detail">{{bookCoverStyleDetailText}}</text>
            </view>
            <text class="book-cover-style-value">{{bookCoverStyleLabel}}</text>
          </view>
        </picker>

        <button
          class="ghost-button save-design-button"
          loading="{{bookTitleSaving}}"
          disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
          bindtap="saveBookDesignSettings"
        >
          保存成书信息
        </button>
      </view>

      <view class="export-settings">
        <picker
          class="setting-picker"
          mode="selector"
          range="{{bookExportLayoutOptions}}"
          range-key="label"
          value="{{bookExportLayoutIndex}}"
          bindchange="changeBookExportLayout"
        >
          <view class="setting-row">
            <view>
              <text class="setting-title">PDF 排版</text>
              <text class="setting-meta">{{bookExportLayoutDetailText}}</text>
            </view>
            <text class="setting-value">{{bookExportLayoutLabel}}</text>
          </view>
        </picker>
        <view class="setting-row">
          <view>
            <text class="setting-title">原始讲述索引</text>
            <text class="setting-meta">附上原始讲述，方便以后核对和补充；分享或打印可关闭</text>
          </view>
          <switch
            checked="{{bookExportShowSourceAppendix}}"
            color="#A64B3E"
            bindchange="toggleBookExportSourceAppendix"
          />
        </view>
      </view>

      <view class="preview-card">
        <view class="section-head">
          <text class="section-title">全书预览</text>
          <picker
            wx:if="{{bookVersionOptions.length > 1}}"
            mode="selector"
            range="{{bookVersionOptions}}"
            range-key="label"
            value="{{bookSelectedVersionIndex}}"
            bindchange="changeBookOutputVersion"
          >
            <text class="version-link">历史版本</text>
          </picker>
        </view>

        <view wx:if="{{bookPreviewTocItems.length}}" class="toc-list">
          <text wx:for="{{bookPreviewTocItems}}" wx:key="id" class="toc-item">
            {{item.indexText}} {{item.title}}
          </text>
        </view>

        <view class="preview-toggle-row">
          <text class="preview-count">{{bookPreviewChapters.length}} 章预览</text>
          <button class="text-button" bindtap="toggleBookPreviewChapters">
            {{bookPreviewChaptersExpanded ? "收起" : "展开"}}
          </button>
        </view>
        <view wx:if="{{bookPreviewChaptersExpanded && bookPreviewChapters.length}}" class="chapter-preview-list">
          <view wx:for="{{bookPreviewChapters}}" wx:key="id" class="chapter-preview">
            <text class="chapter-title">{{item.title}}</text>
            <text class="chapter-excerpt">{{item.excerpt}}</text>
          </view>
        </view>
        <text wx:if="{{!bookPreviewChapters.length}}" class="book-output-text" selectable>{{bookContent}}</text>
      </view>
    </block>
  </block>
</view>
