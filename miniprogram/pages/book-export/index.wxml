<view class="ui-page-shell {{pageClass}}">
  <view wx:if="{{loading}}" class="state-card ui-card">正在打开这本书…</view>
  <view wx:elif="{{loadError}}" class="state-card error ui-card">{{loadError}}</view>
  <block wx:else>
    <view wx:if="{{error}}" class="notice warn">{{error}}</view>
    <view wx:if="{{bookStaleNotice}}" class="notice warn">{{bookStaleNotice}}</view>
    <view wx:if="{{bookVersionNotice && activeSection === 'history'}}" class="notice">{{bookVersionNotice}}</view>

    <view wx:if="{{!bookContent}}" class="state-card ui-card">
      <text>这本书还没有完成。完成书稿后，就可以在这里阅读和导出。</text>
      <view class="state-action ui-pressable" aria-role="button" bindtap="openBookHome">返回书稿</view>
    </view>
    <block wx:else>
      <block wx:if="{{!activeSection}}">
        <view class="export-hero ui-card">
          <view class="hero-main">
            <view class="hero-copy">
              <text class="hero-title">{{bookManuscriptTitle || bookPreviewTitle || planTitle}}</text>
              <text class="hero-subtitle">{{bookNarratorNameInput ? bookNarratorNameInput + '口述回忆录' : '口述回忆录'}}</text>
              <text class="hero-meta">{{totalChapterCount}}章 · {{bookCharCount || 0}}字</text>
            </view>
            <view class="hero-cover {{bookCoverStylePreviewClass}}" aria-hidden="true">
              <image wx:if="{{bookCoverStylePreviewImage}}" class="hero-cover-image" src="{{bookCoverStylePreviewImage}}" mode="aspectFill" />
              <image wx:else class="hero-cover-branch" src="/assets/book-reader/hero-branch.png" mode="aspectFit" />
              <text class="hero-cover-title">{{bookManuscriptTitle || bookPreviewTitle || planTitle}}</text>
            </view>
          </view>
          <view class="hero-actions">
            <view class="hero-action primary ui-pressable" aria-role="button" bindtap="openBookReader">读这本书 <text>→</text></view>
            <view class="hero-action secondary ui-pressable" aria-role="button" bindtap="openBookNarration">朗读全书 <text>→</text></view>
          </view>
        </view>

        <view class="overview-card ui-card">
          <text class="section-title">导出这本书</text>
          <text class="section-description">{{exportNotice || "生成文件，留存或分享给家人。"}}</text>
          <view class="list-row export-row ui-pressable {{bookStaleNotice || bookExportBusyTarget ? 'is-disabled' : ''}}" aria-role="button" aria-disabled="{{bookStaleNotice || bookExportBusyTarget}}" data-format="pdf" data-layout="standard" bindtap="downloadBookOutputExport">
            <view class="row-copy"><text class="row-title">阅读版 PDF</text><text class="row-detail">适合手机和平板阅读</text></view><text wx:if="{{bookExportBusyTarget === 'book-export:pdf:standard'}}" class="row-busy">生成中…</text><text wx:else class="row-arrow">›</text>
          </view>
          <view class="list-row export-row ui-pressable {{bookStaleNotice || bookExportBusyTarget ? 'is-disabled' : ''}}" aria-role="button" aria-disabled="{{bookStaleNotice || bookExportBusyTarget}}" data-format="pdf" data-layout="large_print" bindtap="downloadBookOutputExport">
            <view class="row-copy"><text class="row-title">打印版 PDF</text><text class="row-detail">适合打印和装订</text></view><text wx:if="{{bookExportBusyTarget === 'book-export:pdf:large_print'}}" class="row-busy">生成中…</text><text wx:else class="row-arrow">›</text>
          </view>
          <view class="list-row export-row ui-pressable {{bookStaleNotice || bookExportBusyTarget ? 'is-disabled' : ''}}" aria-role="button" aria-disabled="{{bookStaleNotice || bookExportBusyTarget}}" data-format="txt" bindtap="downloadBookOutputExport">
            <view class="row-copy"><text class="row-title">纯文本</text><text class="row-detail">方便继续修改和保存</text></view><text wx:if="{{bookExportBusyTarget === 'book-export:txt:standard'}}" class="row-busy">生成中…</text><text wx:else class="row-arrow">›</text>
          </view>
          <view class="list-row section-entry ui-pressable" aria-role="button" data-section="export" bindtap="openSection">
            <view class="row-copy"><text class="row-title">导出设置</text><text class="row-detail">是否附上整理记录与原始讲述</text></view><text class="row-arrow">›</text>
          </view>
        </view>

        <view class="overview-card ui-card">
          <text class="section-title">书的设置</text>
          <view class="list-row section-entry ui-pressable" aria-role="button" data-section="title" bindtap="openSection"><text class="row-title">书名与信息</text><text class="row-value">{{bookManuscriptTitle || bookPreviewTitle}}</text><text class="row-arrow">›</text></view>
          <view class="list-row section-entry ui-pressable" aria-role="button" data-section="editorial" bindtap="openSection"><text class="row-title">前言与后记</text><text class="row-value">{{bookPrefaceInput && bookAfterwordInput ? '已填写' : '待完善'}}</text><text class="row-arrow">›</text></view>
          <view class="list-row section-entry ui-pressable" aria-role="button" data-section="layout" bindtap="openSection"><text class="row-title">封面与版式</text><text class="row-value">{{bookManuscriptTemplateLabel}}</text><text class="row-arrow">›</text></view>
          <view class="list-row section-entry ui-pressable" aria-role="button" data-section="history" bindtap="openSection"><text class="row-title">历史版本</text><text class="row-value">{{bookVersionOptions.length}}个版本</text><text class="row-arrow">›</text></view>
          <view class="list-row section-entry ui-pressable" aria-role="button" data-section="advanced" bindtap="openSection"><text class="row-title">高级整理</text><text class="row-arrow">›</text></view>
        </view>
      </block>

      <block wx:else>
        <view class="subpage-back ui-pressable" aria-role="button" bindtap="closeSection">
          <text class="subpage-back-arrow" aria-hidden="true">‹</text><text>返回我的书</text>
        </view>
        <view wx:if="{{activeSection === 'export'}}" class="detail-card ui-card">
          <text class="section-title">导出设置</text>
          <text class="section-description">设置会应用于下次导出的 PDF。</text>
          <view class="detail-setting-row">
            <view class="row-copy"><text class="row-title">附上整理记录与原始讲述</text><text class="row-detail">阅读版默认关闭，需要核对时可打开</text></view>
            <switch checked="{{bookExportShowSourceAppendix}}" color="#a35445" bindchange="toggleBookExportSourceAppendix" />
          </view>
        </view>

        <view wx:if="{{activeSection === 'title'}}" class="detail-card ui-card">
          <view class="detail-heading"><text class="section-title">书名与信息</text><text class="save-status">{{bookDesignSaveStatusText}}</text></view>
          <text class="book-title-sync-hint">这里修改的书名，也会同步为回忆录名称</text>
        <view class="book-title-editor">
          <input
            class="book-title-input"
            value="{{bookTitleInput}}"
            placeholder="输入书名"
            maxlength="40"
            disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
            bindinput="changeBookTitle"
          />
          <button
            class="book-title-ai ui-button"
            loading="{{bookTitleSuggesting}}"
            disabled="{{bookTitleSuggesting || bookTitleSaving || bookViewingHistoricalVersion || !bookContent}}"
            bindtap="suggestBookTitles"
          >
            {{bookTitleSuggesting ? "起名中" : "小余起名"}}
          </button>
        </view>

        <view wx:if="{{bookTitleSuggestions.length}}" class="book-title-suggestion-list">
          <view
            wx:for="{{bookTitleSuggestions}}"
            wx:key="*this"
            class="book-title-suggestion ui-pressable"
            data-title="{{item}}"
            bindtap="chooseBookTitleSuggestion"
          >
            <text>{{item}}</text>
          </view>
        </view>

        <view class="book-metadata-grid">
          <view class="book-metadata-field">
            <text class="book-metadata-label">副标题</text>
            <input
              class="book-metadata-input"
              value="{{bookSubtitleInput}}"
              placeholder="根据口述访谈整理"
              maxlength="80"
              disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
              data-key="subtitle"
              bindinput="changeBookMetadataField"
            />
          </view>
          <view class="book-metadata-field">
            <text class="book-metadata-label">口述人</text>
            <input
              class="book-metadata-input"
              value="{{bookNarratorNameInput}}"
              placeholder="例如：爷爷 / 外婆 / 某某"
              maxlength="40"
              disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
              data-key="narrator_name"
              bindinput="changeBookMetadataField"
            />
          </view>
          <view class="book-metadata-field">
            <text class="book-metadata-label">整理人</text>
            <input
              class="book-metadata-input"
              value="{{bookPreparedByInput}}"
              placeholder="家人整理"
              maxlength="40"
              disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
              data-key="prepared_by"
              bindinput="changeBookMetadataField"
            />
          </view>
        </view>
        <view
          class="save-design-button ui-block-action ui-pressable {{bookTitleSaving || bookViewingHistoricalVersion ? 'is-disabled' : ''}}"
          aria-role="button"
          aria-disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
          bindtap="saveBookDesignSettings"
        >
          {{bookTitleSaving ? "正在保存…" : "保存书名与信息"}}
        </view>
        </view>

        <view wx:if="{{activeSection === 'editorial'}}" class="detail-card editorial-detail-card ui-card">
          <view class="book-editorial-save-row"><text class="save-status">{{bookDesignSaveStatusText}}</text></view>
        <text wx:if="{{bookEditorialCopyStatusError}}" class="book-editorial-status-error">{{bookEditorialCopyStatusError}}</text>
        <view class="book-metadata-field book-editorial-section">
          <view class="book-metadata-label-row book-editorial-label-row">
            <text class="book-metadata-label book-editorial-label">前言</text>
            <button
              class="book-editorial-generate ui-button"
              data-target="preface"
              loading="{{bookEditorialCopyBusyTarget === 'preface'}}"
              disabled="{{bookTitleSaving || bookViewingHistoricalVersion || bookEditorialCopyBusyTarget || bookEditorialCopyJobs.preface.active || !bookContent}}"
              bindtap="regenerateBookEditorialCopy"
            >
              {{bookEditorialCopyBusyTarget === 'preface' ? "正在提交…" : (bookEditorialCopyJobs.preface.active ? "任务进行中" : "请小余重写")}}<text wx:if="{{bookEditorialCopyBusyTarget !== 'preface' && !bookEditorialCopyJobs.preface.active}}" class="book-editorial-generate-arrow">›</text>
            </button>
          </view>
          <view wx:if="{{bookEditorialCopyJobs.preface.visible}}" class="book-editorial-job-status {{bookEditorialCopyJobs.preface.status}}">
            <view class="book-editorial-job-dot" aria-hidden="true"></view>
            <text>{{bookEditorialCopyJobs.preface.statusText}}</text>
            <text wx:if="{{bookEditorialCopyJobs.preface.errorText}}" class="book-editorial-job-error">{{bookEditorialCopyJobs.preface.errorText}}</text>
          </view>
          <textarea
            class="book-metadata-textarea book-editorial-textarea"
            value="{{bookPrefaceInput}}"
            placeholder="写给家人看的开篇说明"
            maxlength="600"
            auto-height
            disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
            data-key="preface"
            bindinput="changeBookMetadataField"
          />
        </view>

        <view class="book-metadata-field book-editorial-section">
          <view class="book-metadata-label-row book-editorial-label-row">
            <text class="book-metadata-label book-editorial-label">后记</text>
            <button
              class="book-editorial-generate ui-button"
              data-target="afterword"
              loading="{{bookEditorialCopyBusyTarget === 'afterword'}}"
              disabled="{{bookTitleSaving || bookViewingHistoricalVersion || bookEditorialCopyBusyTarget || bookEditorialCopyJobs.afterword.active || !bookContent}}"
              bindtap="regenerateBookEditorialCopy"
            >
              {{bookEditorialCopyBusyTarget === 'afterword' ? "正在提交…" : (bookEditorialCopyJobs.afterword.active ? "任务进行中" : "请小余重写")}}<text wx:if="{{bookEditorialCopyBusyTarget !== 'afterword' && !bookEditorialCopyJobs.afterword.active}}" class="book-editorial-generate-arrow">›</text>
            </button>
          </view>
          <view wx:if="{{bookEditorialCopyJobs.afterword.visible}}" class="book-editorial-job-status {{bookEditorialCopyJobs.afterword.status}}">
            <view class="book-editorial-job-dot" aria-hidden="true"></view>
            <text>{{bookEditorialCopyJobs.afterword.statusText}}</text>
            <text wx:if="{{bookEditorialCopyJobs.afterword.errorText}}" class="book-editorial-job-error">{{bookEditorialCopyJobs.afterword.errorText}}</text>
          </view>
          <textarea
            class="book-metadata-textarea book-editorial-textarea"
            value="{{bookAfterwordInput}}"
            placeholder="作为整本书结尾的一段话"
            maxlength="600"
            auto-height
            disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
            data-key="afterword"
            bindinput="changeBookMetadataField"
          />
        </view>

        <view class="book-metadata-field book-editorial-section">
          <view class="book-metadata-label-row book-editorial-label-row">
            <text class="book-metadata-label book-editorial-label">封底摘要</text>
            <button
              class="book-editorial-generate ui-button"
              data-target="back_cover_quote"
              loading="{{bookEditorialCopyBusyTarget === 'back_cover_quote'}}"
              disabled="{{bookTitleSaving || bookViewingHistoricalVersion || bookEditorialCopyBusyTarget || bookEditorialCopyJobs.back_cover_quote.active || !bookContent}}"
              bindtap="regenerateBookEditorialCopy"
            >
              {{bookEditorialCopyBusyTarget === 'back_cover_quote' ? "正在提交…" : (bookEditorialCopyJobs.back_cover_quote.active ? "任务进行中" : "请小余重写")}}<text wx:if="{{bookEditorialCopyBusyTarget !== 'back_cover_quote' && !bookEditorialCopyJobs.back_cover_quote.active}}" class="book-editorial-generate-arrow">›</text>
            </button>
          </view>
          <view wx:if="{{bookEditorialCopyJobs.back_cover_quote.visible}}" class="book-editorial-job-status {{bookEditorialCopyJobs.back_cover_quote.status}}">
            <view class="book-editorial-job-dot" aria-hidden="true"></view>
            <text>{{bookEditorialCopyJobs.back_cover_quote.statusText}}</text>
            <text wx:if="{{bookEditorialCopyJobs.back_cover_quote.errorText}}" class="book-editorial-job-error">{{bookEditorialCopyJobs.back_cover_quote.errorText}}</text>
          </view>
          <textarea
            class="book-metadata-textarea book-editorial-textarea compact"
            value="{{bookBackCoverQuoteInput}}"
            placeholder="写一句适合放在封底的话"
            maxlength="80"
            auto-height
            disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
            data-key="back_cover_quote"
            bindinput="changeBookMetadataField"
          />
        </view>
        </view>

        <view wx:if="{{activeSection === 'layout'}}" class="detail-card ui-card">
          <text class="section-title">封面与版式</text>
          <text wx:if="{{bookManuscriptAvailable}}" class="section-description">挑选一套封面、封底和内页。预览 PDF 不会保存选择，点使用后才会应用到这本书。</text>
          <text wx:else class="section-description">这份旧书稿还没有版式结构。请先更新书稿，再选择或预览版式。</text>
          <text wx:if="{{bookManuscriptAvailable && bookStaleNotice}}" class="layout-preview-note">章节已有更新；预览使用上次保存的书稿。</text>
          <view wx:if="{{bookManuscriptAvailable}}" class="layout-current"><text>当前版式</text><text>{{bookManuscriptTemplateLabel}}</text></view>
          <view wx:if="{{bookManuscriptAvailable}}" class="layout-option-list">
            <view wx:for="{{bookLayoutOptions}}" wx:key="value" wx:for-item="option" class="layout-option {{bookLayoutTemplate === option.value && bookCoverStyle === option.coverStyle ? 'is-selected' : ''}}">
              <view class="layout-option-main has-cover">
                <view class="layout-option-visuals">
                  <view class="layout-cover-preview">
                    <view class="layout-cover-art {{option.previewClass}}" aria-hidden="true">
                      <image class="layout-cover-image" src="{{option.coverPreviewImage}}" mode="aspectFill" />
                      <text class="layout-cover-kicker">家庭回忆录</text>
                      <text class="layout-cover-title">{{bookTitleInput || bookPreviewTitle || '回忆录'}}</text>
                      <text class="layout-cover-credit">整理：{{bookPreparedByInput || '家人'}}</text>
                    </view>
                    <text class="layout-preview-caption">封面</text>
                  </view>
                  <view class="layout-interior-preview">
                    <view class="layout-sample {{option.previewClass}}" aria-hidden="true">
                      <text class="layout-sample-kicker">{{option.value === 'modern_minimal' ? '01' : '第一章'}}</text>
                      <text class="layout-sample-title">{{bookLayoutSampleTitle}}</text>
                      <view class="layout-sample-ornament-art"><image src="{{option.ornamentThumbnail}}" mode="aspectFit" /></view>
                      <text class="layout-sample-body">{{bookLayoutSampleExcerpt}}</text>
                      <text class="layout-sample-section">{{bookLayoutSampleSectionTitle}}</text>
                      <text class="layout-sample-quote">{{bookLayoutSampleQuote}}</text>
                    </view>
                    <text class="layout-preview-caption">内页</text>
                  </view>
                </view>
                <view class="layout-option-copy">
                  <text class="layout-option-title">{{option.label}}</text>
                  <text class="layout-option-description">{{option.description}}</text>
                  <text wx:if="{{bookLayoutTemplate === option.value && bookCoverStyle === option.coverStyle}}" class="layout-selected-label">当前使用</text>
                </view>
              </view>
              <view class="layout-option-actions">
                <button class="layout-action preview ui-button" data-template="{{option.value}}" bindtap="previewBookLayout" loading="{{bookLayoutBusyTarget === 'preview:' + option.value}}" disabled="{{bookLayoutBusyTarget !== '' || bookExportBusyTarget !== ''}}">预览 PDF</button>
                <button class="layout-action select ui-button" data-template="{{option.value}}" bindtap="selectBookLayout" loading="{{bookLayoutBusyTarget === 'save:' + option.value}}" disabled="{{bookLayoutBusyTarget !== '' || bookExportBusyTarget !== '' || bookTitleSaving || bookViewingHistoricalVersion || (bookLayoutTemplate === option.value && bookCoverStyle === option.coverStyle)}}">{{bookLayoutTemplate === option.value && bookCoverStyle === option.coverStyle ? '已使用' : '使用此版式'}}</button>
              </view>
              <text wx:if="{{bookLayoutFeedbackTarget === option.value && bookLayoutFeedbackText}}" class="layout-feedback {{bookLayoutFeedbackError ? 'error' : ''}}">{{bookLayoutFeedbackText}}</text>
            </view>
          </view>
          <view wx:if="{{bookManuscriptAvailable}}" class="layout-custom-panel">
            <text class="layout-option-title">自定义阅读排版</text>
            <text class="layout-option-description">保留当前封面，调整正文的字号、行距和页边距。</text>
            <text wx:if="{{bookLayoutTemplate === 'custom'}}" class="layout-selected-label">当前使用</text>
            <view class="layout-custom-controls">
              <picker mode="selector" range="{{bookLayoutFontScaleOptions}}" range-key="label" value="{{bookLayoutFontScaleIndex}}" data-key="font_scale" bindchange="changeBookCustomLayout" disabled="{{bookLayoutBusyTarget !== ''}}">
                <view class="layout-custom-row"><text>正文字号</text><text>{{bookLayoutFontScaleOptions[bookLayoutFontScaleIndex].label}} ›</text></view>
              </picker>
              <picker mode="selector" range="{{bookLayoutLineSpacingOptions}}" range-key="label" value="{{bookLayoutLineSpacingIndex}}" data-key="line_spacing" bindchange="changeBookCustomLayout" disabled="{{bookLayoutBusyTarget !== ''}}">
                <view class="layout-custom-row"><text>行距</text><text>{{bookLayoutLineSpacingOptions[bookLayoutLineSpacingIndex].label}} ›</text></view>
              </picker>
              <picker mode="selector" range="{{bookLayoutPageMarginOptions}}" range-key="label" value="{{bookLayoutPageMarginIndex}}" data-key="page_margin" bindchange="changeBookCustomLayout" disabled="{{bookLayoutBusyTarget !== ''}}">
                <view class="layout-custom-row"><text>页边距</text><text>{{bookLayoutPageMarginOptions[bookLayoutPageMarginIndex].label}} ›</text></view>
              </picker>
              <text wx:if="{{bookLayoutTemplate === 'custom' && bookLayoutCustomChanged}}" class="layout-custom-hint">调整尚未保存，预览满意后点保存调整。</text>
            </view>
            <view class="layout-option-actions">
              <button class="layout-action preview ui-button" data-template="custom" bindtap="previewBookLayout" loading="{{bookLayoutBusyTarget === 'preview:custom'}}" disabled="{{bookLayoutBusyTarget !== '' || bookExportBusyTarget !== ''}}">预览 PDF</button>
              <button class="layout-action select ui-button" data-template="custom" bindtap="selectBookLayout" loading="{{bookLayoutBusyTarget === 'save:custom'}}" disabled="{{bookLayoutBusyTarget !== '' || bookExportBusyTarget !== '' || bookTitleSaving || bookViewingHistoricalVersion || (bookLayoutTemplate === 'custom' && !bookLayoutCustomChanged)}}">{{bookLayoutTemplate === 'custom' && !bookLayoutCustomChanged ? '已使用' : '保存调整'}}</button>
            </view>
            <text wx:if="{{bookLayoutFeedbackTarget === 'custom' && bookLayoutFeedbackText}}" class="layout-feedback {{bookLayoutFeedbackError ? 'error' : ''}}">{{bookLayoutFeedbackText}}</text>
          </view>
          <text class="layout-content-title">书稿内容</text>
          <view class="detail-info-row"><text>章节</text><text>{{totalChapterCount}}章</text></view>
          <view class="detail-info-row"><text>前言</text><text>{{bookPrefaceInput ? '已填写' : '未填写'}}</text></view>
          <view class="detail-info-row"><text>后记</text><text>{{bookAfterwordInput ? '已填写' : '未填写'}}</text></view>
          <view class="detail-info-row"><text>附上原始讲述</text><text>{{bookExportShowSourceAppendix ? '是' : '否'}}</text></view>
          <view class="list-row section-entry ui-pressable" aria-role="button" data-section="export" bindtap="openSection"><text class="row-title">修改导出设置</text><text class="row-arrow">›</text></view>
        </view>

        <view wx:if="{{activeSection === 'history'}}" class="detail-card ui-card">
          <text class="section-title">历史版本</text>
          <text class="section-description">选择旧版本阅读，不会改动当前书稿。</text>
          <picker mode="selector" range="{{bookVersionOptions}}" range-key="label" value="{{bookSelectedVersionIndex}}" disabled="{{bookExportBusyTarget === 'book-version'}}" bindchange="changeBookOutputVersion">
            <view class="list-row section-entry"><text class="row-title">{{bookVersionText}}</text><text class="row-arrow">›</text></view>
          </picker>
          <view class="detail-action ui-pressable" aria-role="button" bindtap="openBookReader">读这个版本 →</view>
        </view>

        <view wx:if="{{activeSection === 'advanced'}}" class="detail-card ui-card">
          <text class="section-title">高级整理</text>
          <view class="list-row section-entry ui-pressable" aria-role="button" data-section="history" bindtap="openSection"><text class="row-title">历史版本</text><text class="row-arrow">›</text></view>
          <view class="advanced-action"><text class="row-title">重新整理书稿</text><text class="row-detail">根据各章确认正文生成新版本，旧版本会保留。</text>
            <button class="detail-action ui-button" loading="{{generatingBook}}" disabled="{{generatingBook || bookTitleSaving || bookViewingHistoricalVersion || !bookContent}}" bindtap="generateBook">重新整理书稿</button>
          </view>
        </view>
      </block>
    </block>
  </block>
</view>
