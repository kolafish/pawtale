<view class="page book-export-page">
  <view wx:if="{{loading}}" class="state-card">
    <text>正在加载全书...</text>
  </view>

  <view wx:elif="{{error}}" class="state-card error">
    <text>{{error}}</text>
  </view>

  <block wx:else>
    <view class="export-hero">
      <view>
        <text class="eyebrow">预览与导出</text>
        <text class="hero-title">{{bookManuscriptTitle || bookPreviewTitle || planTitle}}</text>
        <text class="hero-meta">
          {{totalChapterCount}} 章 · {{bookCharCount || 0}} 字 · {{bookContent ? "已生成书稿" : "尚未生成书稿"}}
        </text>
      </view>
      <text wx:if="{{bookVersionOptions.length > 1}}" class="version-pill">有历史版本</text>
    </view>

    <view wx:if="{{bookStaleNotice}}" class="notice warn">{{bookStaleNotice}}</view>
    <view wx:elif="{{exportNotice}}" class="notice">{{exportNotice}}</view>
    <view wx:if="{{bookVersionNotice}}" class="notice subtle">{{bookVersionNotice}}</view>

    <view wx:if="{{!bookContent}}" class="state-card">
      <text>回到书稿页生成全书后，可以在这里预览和导出。</text>
    </view>

    <block wx:else>
      <view class="preview-card">
        <view class="section-head">
          <text class="section-title">全书预览</text>
        </view>

        <view wx:if="{{bookPreviewTocItems.length}}" class="toc-list">
          <view wx:for="{{bookPreviewTocItems}}" wx:key="id" wx:for-item="chapter" class="toc-group">
            <text class="toc-item">{{chapter.indexText}} {{chapter.title}}</text>
            <text
              wx:for="{{chapter.sections}}"
              wx:key="id"
              wx:for-item="section"
              class="toc-small-section"
            >
              {{section.indexText}} {{section.title}}
            </text>
          </view>
        </view>

        <view class="preview-toggle-row">
          <text class="preview-count">{{bookPreviewChapters.length}} 章预览</text>
          <button class="text-button" bindtap="toggleBookPreviewChapters">
            {{bookPreviewChaptersExpanded ? "收起" : "展开"}}
          </button>
        </view>
        <view wx:if="{{bookPreviewChaptersExpanded && bookPreviewChapters.length}}" class="chapter-preview-list">
          <view wx:for="{{bookPreviewChapters}}" wx:key="id" wx:for-item="chapter" class="chapter-preview">
            <text class="chapter-title">{{chapter.title}}</text>
            <view wx:if="{{chapter.sections.length}}" class="chapter-small-section-list">
              <view
                wx:for="{{chapter.sections}}"
                wx:key="id"
                wx:for-item="section"
                class="chapter-small-section"
              >
                <text class="chapter-small-section-title">{{section.title}}</text>
                <text class="chapter-excerpt">{{section.excerpt}}</text>
              </view>
            </view>
            <text wx:else class="chapter-excerpt">{{chapter.excerpt}}</text>
          </view>
        </view>
        <text wx:if="{{!bookPreviewChapters.length}}" class="book-output-text" selectable>{{bookContent}}</text>
      </view>

      <view class="export-settings">
        <view class="setting-row">
          <view>
            <text class="setting-title">原始讲述索引</text>
            <text class="setting-meta">附上原始讲述，方便以后核对和补充；分享或打印可关闭</text>
          </view>
          <switch
            checked="{{bookExportShowSourceAppendix}}"
            color="#A64B3E"
            bindchange="toggleBookExportSourceAppendix"
          />
        </view>
      </view>

      <view class="export-actions">
        <button
          class="primary-button"
          data-action="reading_pdf"
          data-format="pdf"
          data-layout="standard"
          loading="{{bookExportBusyTarget === 'book-export:pdf:standard'}}"
          disabled="{{bookStaleNotice || bookExportBusyTarget}}"
          bindtouchstart="previewExportActionHint"
          bindtap="downloadBookOutputExport"
        >
          阅读版 PDF
        </button>
        <button
          class="ghost-button"
          data-action="print_pdf"
          data-format="pdf"
          data-layout="large_print"
          loading="{{bookExportBusyTarget === 'book-export:pdf:large_print'}}"
          disabled="{{bookStaleNotice || bookExportBusyTarget}}"
          bindtouchstart="previewExportActionHint"
          bindtap="downloadBookOutputExport"
        >
          打印版 PDF
        </button>
        <button
          class="ghost-button"
          data-action="text"
          data-format="txt"
          loading="{{bookExportBusyTarget === 'book-export:txt:standard'}}"
          disabled="{{bookStaleNotice || bookExportBusyTarget}}"
          bindtouchstart="previewExportActionHint"
          bindtap="downloadBookOutputExport"
        >
          导出文本
        </button>
      </view>
      <text class="export-action-hint">{{exportActionHintText}}</text>

      <view class="book-design-panel">
        <view class="book-design-head">
          <view>
            <text class="book-design-title">成书信息</text>
            <text class="book-design-meta">{{bookCoverStyleLabel}} · {{bookOutput && bookOutput.latest_version ? "已生成" : "待生成"}}</text>
          </view>
          <text class="book-design-save-status {{bookTitleSaving ? 'saving' : ''}}">{{bookDesignSaveStatusText}}</text>
        </view>

        <view class="book-title-editor">
          <input
            class="book-title-input"
            value="{{bookTitleInput}}"
            placeholder="输入书名"
            maxlength="40"
            disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
            bindinput="changeBookTitle"
          />
          <button
            class="book-title-ai"
            loading="{{bookTitleSuggesting}}"
            disabled="{{bookTitleSuggesting || bookTitleSaving || bookViewingHistoricalVersion || !bookContent}}"
            bindtap="suggestBookTitles"
          >
            {{bookTitleSuggesting ? "起名中" : "小余起名"}}
          </button>
        </view>

        <view wx:if="{{bookTitleSuggestions.length}}" class="book-title-suggestion-list">
          <view
            wx:for="{{bookTitleSuggestions}}"
            wx:key="*this"
            class="book-title-suggestion"
            data-title="{{item}}"
            bindtap="chooseBookTitleSuggestion"
          >
            <text>{{item}}</text>
          </view>
        </view>

        <view class="book-metadata-grid">
          <view class="book-metadata-field">
            <text class="book-metadata-label">副标题</text>
            <input
              class="book-metadata-input"
              value="{{bookSubtitleInput}}"
              placeholder="根据口述访谈整理"
              maxlength="80"
              disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
              data-key="subtitle"
              bindinput="changeBookMetadataField"
            />
          </view>
          <view class="book-metadata-field">
            <text class="book-metadata-label">口述人</text>
            <input
              class="book-metadata-input"
              value="{{bookNarratorNameInput}}"
              placeholder="例如：爷爷 / 外婆 / 某某"
              maxlength="40"
              disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
              data-key="narrator_name"
              bindinput="changeBookMetadataField"
            />
          </view>
          <view class="book-metadata-field">
            <text class="book-metadata-label">整理人</text>
            <input
              class="book-metadata-input"
              value="{{bookPreparedByInput}}"
              placeholder="家人整理"
              maxlength="40"
              disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
              data-key="prepared_by"
              bindinput="changeBookMetadataField"
            />
          </view>
        </view>

        <view class="book-metadata-field">
          <view class="book-metadata-label-row">
            <text class="book-metadata-label">前言</text>
            <button
              class="book-editorial-generate"
              data-target="preface"
              loading="{{bookEditorialCopyBusyTarget === 'preface'}}"
              disabled="{{bookTitleSaving || bookViewingHistoricalVersion || bookEditorialCopyBusyTarget === 'preface' || !bookContent}}"
              bindtap="regenerateBookEditorialCopy"
            >
              重写
            </button>
          </view>
          <textarea
            class="book-metadata-textarea"
            value="{{bookPrefaceInput}}"
            placeholder="写给家人看的开篇说明"
            maxlength="600"
            auto-height
            disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
            data-key="preface"
            bindinput="changeBookMetadataField"
          />
        </view>

        <view class="book-metadata-field">
          <view class="book-metadata-label-row">
            <text class="book-metadata-label">后记</text>
            <button
              class="book-editorial-generate"
              data-target="afterword"
              loading="{{bookEditorialCopyBusyTarget === 'afterword'}}"
              disabled="{{bookTitleSaving || bookViewingHistoricalVersion || bookEditorialCopyBusyTarget === 'afterword' || !bookContent}}"
              bindtap="regenerateBookEditorialCopy"
            >
              重写
            </button>
          </view>
          <textarea
            class="book-metadata-textarea"
            value="{{bookAfterwordInput}}"
            placeholder="作为整本书结尾的一段话"
            maxlength="600"
            auto-height
            disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
            data-key="afterword"
            bindinput="changeBookMetadataField"
          />
        </view>

        <view class="book-metadata-field">
          <view class="book-metadata-label-row">
            <text class="book-metadata-label">封底摘录</text>
            <button
              class="book-editorial-generate"
              data-target="back_cover_quote"
              loading="{{bookEditorialCopyBusyTarget === 'back_cover_quote'}}"
              disabled="{{bookTitleSaving || bookViewingHistoricalVersion || bookEditorialCopyBusyTarget === 'back_cover_quote' || !bookContent}}"
              bindtap="regenerateBookEditorialCopy"
            >
              重写
            </button>
          </view>
          <textarea
            class="book-metadata-textarea compact"
            value="{{bookBackCoverQuoteInput}}"
            placeholder="可以放一句正文原话"
            maxlength="80"
            auto-height
            disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
            data-key="back_cover_quote"
            bindinput="changeBookMetadataField"
          />
        </view>

        <picker
          mode="selector"
          range="{{bookCoverStyleOptions}}"
          range-key="label"
          value="{{bookCoverStyleIndex}}"
          disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
          bindchange="changeBookCoverStyle"
        >
          <view class="book-cover-style-picker">
            <view class="book-cover-preview {{bookCoverStylePreviewClass}}">
              <text class="book-cover-preview-title">{{bookTitleInput || bookPreviewTitle || "回忆录"}}</text>
            </view>
            <view class="book-cover-style-copy">
              <text class="book-cover-style-label">封面风格</text>
              <text class="book-cover-style-detail">{{bookCoverStyleDetailText}}</text>
            </view>
            <text class="book-cover-style-value">{{bookCoverStyleLabel}}</text>
          </view>
        </picker>

        <button
          class="ghost-button save-design-button"
          loading="{{bookTitleSaving}}"
          disabled="{{bookTitleSaving || bookViewingHistoricalVersion}}"
          bindtap="saveBookDesignSettings"
        >
          保存成书信息
        </button>
      </view>

      <view wx:if="{{bookManuscriptAvailable}}" class="manuscript-card">
        <view class="manuscript-section">
          <view class="section-head">
            <text class="section-title">书稿设置</text>
            <text class="section-count">{{bookManuscriptTemplateLabel}}</text>
          </view>
          <view class="manuscript-cover-summary">
            <text class="manuscript-title">{{bookManuscriptTitle}}</text>
            <text class="manuscript-subtitle">{{bookManuscriptSubtitle}}</text>
          </view>
          <text class="manuscript-meta">{{bookManuscriptSettingsText}}</text>
        </view>

        <view class="manuscript-section">
          <view class="section-head">
            <text class="section-title">书籍结构</text>
            <text class="section-count">{{bookManuscriptStructureItems.length}} 项</text>
          </view>
          <view class="structure-list">
            <view
              wx:for="{{bookManuscriptStructureItems}}"
              wx:for-item="item"
              wx:key="id"
              class="structure-row"
            >
              <view class="structure-main">
                <text class="structure-title">{{item.title}}</text>
                <text class="structure-meta">{{item.metaText}}</text>
              </view>
              <text class="structure-status">{{item.statusText}}</text>
            </view>
          </view>
        </view>

        <view class="manuscript-section">
          <view class="section-head">
            <text class="section-title">章节书稿</text>
            <text class="section-count">{{bookManuscriptChapterItems.length}} 章</text>
          </view>
          <view class="manuscript-chapter-list">
            <view
              wx:for="{{bookManuscriptChapterItems}}"
              wx:for-item="chapter"
              wx:key="id"
              class="manuscript-chapter"
            >
              <view class="chapter-heading">
                <text class="chapter-index">{{chapter.indexText}}</text>
                <text class="chapter-title">{{chapter.title}}</text>
              </view>
              <text wx:if="{{chapter.metaText}}" class="manuscript-meta">{{chapter.metaText}}</text>
              <text wx:if="{{chapter.intro}}" class="chapter-intro">{{chapter.intro}}</text>
              <view wx:if="{{chapter.quoteText}}" class="chapter-quote">
                <text>“{{chapter.quoteText}}”</text>
                <text wx:if="{{chapter.quoteSourceText}}" class="chapter-quote-source">{{chapter.quoteSourceText}}</text>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{bookManuscriptBackMatterItems.length}}" class="manuscript-section">
          <view class="section-head">
            <text class="section-title">附录与说明</text>
            <text class="section-count">{{bookManuscriptBackMatterItems.length}} 项</text>
          </view>
          <view class="back-matter-list">
            <view
              wx:for="{{bookManuscriptBackMatterItems}}"
              wx:for-item="item"
              wx:key="id"
              class="back-matter-row"
            >
              <text class="back-matter-kind">{{item.kindText}}</text>
              <view class="back-matter-main">
                <text class="back-matter-title">{{item.title}}</text>
                <text class="back-matter-preview">{{item.contentPreview}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="advanced-card">
        <view class="section-head">
          <text class="section-title">历史版本与重新整理</text>
          <text class="section-count">高级操作</text>
        </view>

        <picker
          wx:if="{{bookVersionOptions.length > 1}}"
          mode="selector"
          range="{{bookVersionOptions}}"
          range-key="label"
          value="{{bookSelectedVersionIndex}}"
          bindchange="changeBookOutputVersion"
        >
          <view class="advanced-row">
            <view class="advanced-copy">
              <text class="advanced-title">历史版本：{{bookVersionText}}</text>
              <text class="advanced-meta">可以切回旧版本预览，不会改动当前书稿。</text>
            </view>
            <text class="advanced-value">查看</text>
          </view>
        </picker>

        <view wx:else class="advanced-row">
          <view class="advanced-copy">
            <text class="advanced-title">历史版本</text>
            <text class="advanced-meta">当前还没有历史版本。</text>
          </view>
          <text class="advanced-value muted">暂无</text>
        </view>

        <view class="advanced-row">
          <view class="advanced-copy">
            <text class="advanced-title">重新整理一版</text>
            <text class="advanced-meta">当前书稿会保留，新版本完成后可在历史版本里查看。</text>
          </view>
          <button
            class="ghost-button compact"
            loading="{{generatingBook}}"
            disabled="{{generatingBook || bookTitleSaving || bookViewingHistoricalVersion || !bookContent}}"
            bindtap="generateBook"
          >
            重新整理
          </button>
        </view>
      </view>
    </block>
  </block>
</view>
