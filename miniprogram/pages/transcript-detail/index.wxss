.detail-page {
  min-height: 100vh;
  padding: 44rpx 36rpx 120rpx;
  background: #f7f3ed;
  box-sizing: border-box;
}

.top-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 28rpx;
}

.back-hit {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-mark {
  color: #9f4a3c;
  font-size: 72rpx;
  line-height: 1;
}

.title-block {
  min-width: 0;
}

.page-title {
  display: block;
  color: #24100b;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}

.page-meta {
  display: block;
  margin-top: 8rpx;
  color: #685b55;
  font-size: 26rpx;
  line-height: 1.35;
}

.error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff1f2;
  color: #b4234a;
  font-size: 28rpx;
  line-height: 1.45;
  word-break: break-word;
}

.empty-panel,
.hero-panel,
.section-card {
  margin-top: 24rpx;
  border: 2rpx solid #e7d8c9;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10rpx 28rpx rgba(64, 43, 24, 0.06);
  box-sizing: border-box;
}

.empty-panel {
  padding: 48rpx 34rpx;
  color: #685b55;
  font-size: 30rpx;
  line-height: 1.5;
}

.empty-title {
  display: block;
  color: #24100b;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-copy {
  display: block;
  margin-top: 14rpx;
}

.hero-panel {
  padding: 32rpx 30rpx;
  border-color: #dfc8b8;
  background: #fffdf9;
}

.record-title {
  display: block;
  color: #24100b;
  font-size: 40rpx;
  font-weight: 850;
  line-height: 1.32;
  word-break: break-word;
}

.record-meta {
  display: block;
  margin-top: 12rpx;
  color: #685b55;
  font-size: 25rpx;
  line-height: 1.4;
}

.book-status {
  display: inline-flex;
  max-width: 100%;
  margin-top: 16rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #f4f1ec;
  color: #62554d;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-word;
}

.book-status.included {
  background: #edf6ef;
  color: #2f6f4e;
}

.section-card {
  padding: 28rpx;
}

.evidence-card {
  background: #f8f5f1;
  border-color: #e4d9cf;
}

.manuscript-card,
.edit-card {
  background: #ffffff;
  border-color: #dfc8b8;
}

.section-head,
.actions-row {
  display: flex;
  align-items: center;
}

.section-head {
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 16rpx;
}

.section-heading {
  flex: 1 1 auto;
  min-width: 0;
}

.section-title {
  display: block;
  color: #7a3b31;
  font-size: 29rpx;
  font-weight: 850;
  line-height: 1.3;
}

.section-hint {
  display: block;
  margin-top: 6rpx;
  color: #6f625a;
  font-size: 23rpx;
  line-height: 1.35;
  word-break: break-word;
}

.section-count {
  flex: 0 0 auto;
  max-width: 260rpx;
  color: #9f4a3c;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: right;
  word-break: break-word;
}

.body-text {
  display: block;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  color: #3a2119;
  font-size: 29rpx;
  line-height: 1.6;
  word-break: break-word;
}

.question-text {
  background: #f8f5f1;
  border: 2rpx solid #e4d9cf;
}

.raw-text {
  background: #f1ede8;
  color: #4d4038;
}

.display-text {
  background: #ffffff;
  border: 2rpx solid #e7d8c9;
}

.transcript-textarea {
  width: 100%;
  min-height: 260rpx;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  border: 2rpx solid #efd6c4;
  border-radius: 18rpx;
  background: #ffffff;
  color: #24100b;
  font-size: 30rpx;
  line-height: 1.55;
}

.actions-row {
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.primary-actions {
  justify-content: flex-start;
}

.primary-button,
.ghost-button,
.danger-button {
  min-width: 168rpx;
  height: 76rpx;
  margin: 0;
  border: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 850;
  line-height: 1;
  box-sizing: border-box;
}

.primary-button,
.ghost-button {
  flex: 1 1 180rpx;
}

.primary-button::after,
.ghost-button::after,
.danger-button::after {
  border: 0;
}

.primary-button {
  background: #9f4a3c;
  color: #ffffff;
}

.ghost-button {
  background: #fff1ec;
  color: #8a4034;
}

.danger-button {
  width: 100%;
  background: #fff1f2;
  color: #b4234a;
}

.primary-button[disabled],
.ghost-button[disabled],
.danger-button[disabled],
.picker-action.disabled {
  opacity: 0.62;
}

.picker-action {
  width: 100%;
}

.voice-edit-block {
  margin-top: 16rpx;
}

.voice-edit-label,
.voice-edit-confidence,
.voice-edit-change-reason {
  display: block;
  color: #7a6255;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
}

.voice-edit-text {
  display: block;
  margin-top: 8rpx;
  color: #3a2119;
  font-size: 27rpx;
  line-height: 1.55;
  word-break: break-word;
}

.voice-edit-confidence {
  margin-top: 8rpx;
  color: #9f4a3c;
}

.voice-edit-changes,
.voice-edit-inline-diff {
  margin-top: 18rpx;
}

.voice-edit-change {
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #fffaf2;
}

.voice-edit-change + .voice-edit-change {
  margin-top: 12rpx;
}

.voice-edit-change-text {
  display: block;
  color: #7a3b31;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.45;
  word-break: break-word;
}

.voice-edit-change-reason {
  margin-top: 6rpx;
  font-weight: 700;
}

.voice-edit-inline-diff {
  padding: 18rpx;
  border: 2rpx solid #f0dac0;
  border-radius: 16rpx;
  background: #ffffff;
}

.voice-edit-diff-text {
  display: block;
  margin-top: 10rpx;
  color: #3a2119;
  font-size: 28rpx;
  line-height: 1.65;
  word-break: break-word;
}

.voice-edit-diff-segment.delete {
  padding: 0 4rpx;
  border-radius: 6rpx;
  background: #fff1f2;
  color: #b4234a;
  text-decoration: line-through;
}

.voice-edit-diff-segment.insert {
  padding: 0 4rpx;
  border-radius: 6rpx;
  background: #e9f7ef;
  color: #2f7a54;
  font-weight: 800;
}

.danger-card {
  margin-top: 40rpx;
  border-color: #f4c2ca;
  background: #fff8f9;
}

.danger-title {
  color: #b4234a;
}

.danger-hint {
  color: #9f334b;
}

.bottom-spacer {
  height: 20rpx;
}
