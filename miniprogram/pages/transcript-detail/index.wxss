@import "../../styles/transcript-record.wxss";

.hero-panel::before {
  display: none;
}

.hero-status {
  display: inline-flex;
  max-width: 100%;
  margin-top: 16rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.hero-status.ready {
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-accent-strong);
}

.hero-status.pending {
  background: var(--ui-warning-surface);
  color: var(--ui-warning-text);
}

.hero-status-copy {
  display: block;
  margin-top: 16rpx;
  color: var(--ui-text-secondary);
  font-size: 27rpx;
  line-height: 1.6;
  text-wrap: pretty;
}

.detail-page .section-title {
  color: var(--ui-text-primary);
}

.detail-page .primary-button {
  background: var(--ui-accent);
  color: var(--ui-on-accent);
  box-shadow:
    0 0 0 1rpx rgba(148, 69, 53, 0.12),
    0 6rpx 14rpx rgba(148, 69, 53, 0.14);
}

.offline-asr-detail,
.offline-asr-error,
.edit-before-label,
.edit-before-text,
.edit-assistant-title,
.edit-assistant-hint,
.voice-edit-message,
.edit-reference-label,
.edit-reference-text,
.danger-panel-title,
.danger-panel-copy,
.repair-panel-title,
.repair-panel-copy {
  display: block;
}

.edit-assistant-title {
  color: var(--ui-section-title);
  font-family: var(--ui-font-editorial);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
  text-wrap: balance;
}

.edit-assistant-hint {
  margin-top: 4rpx;
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  line-height: 1.45;
  text-wrap: pretty;
}

.section-link {
  flex: 0 0 auto;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: -20rpx -16rpx -20rpx 0;
  padding: 0 16rpx;
  border: 0;
  border-radius: var(--ui-radius-control);
  background: transparent;
  color: var(--ui-accent-strong);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
  transition-property: transform, opacity, background-color;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.section-link:active {
  background: var(--ui-accent-surface-subtle);
  transform: scale(0.96);
}

.section-link[disabled] {
  opacity: 0.52;
  transform: none;
}

.playback-track {
  width: 100%;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--ui-surface-subtle);
  overflow: hidden;
}

.playback-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--ui-accent);
  transition-property: width;
  transition-duration: 160ms;
  transition-timing-function: ease-out;
}

.playback-time-row {
  margin-top: 14rpx;
  display: flex;
  justify-content: space-between;
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
}

.playback-actions {
  margin-top: 18rpx;
}

.manuscript-card {
  padding-bottom: 34rpx;
}

.raw-material-card,
.question-card {
  background: var(--ui-surface);
}

.body-text {
  display: block;
  color: var(--ui-text-primary);
  font-size: 29rpx;
  line-height: 1.72;
  overflow-wrap: anywhere;
}

.display-text {
  padding-top: 18rpx;
  border-top: 1rpx solid var(--ui-divider);
  font-family: var(--ui-font-editorial);
  font-size: 31rpx;
}

.raw-text,
.question-text {
  padding: 22rpx 24rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-subtle);
  color: var(--ui-value-text);
}

.question-text.collapsed {
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.inline-actions {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.edit-version-switch {
  margin-top: 0;
  margin-bottom: 18rpx;
}

.edit-before-panel,
.edit-reference-panel,
.edit-assistant {
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
}

.edit-before-panel {
  min-height: 260rpx;
  padding: 24rpx;
}

.edit-before-label,
.edit-reference-label {
  color: var(--ui-text-secondary);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.4;
}

.edit-before-text,
.edit-reference-text {
  margin-top: 10rpx;
  color: var(--ui-text-primary);
  font-size: 29rpx;
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.transcript-textarea {
  width: 100%;
  min-height: 260rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--ui-accent-border);
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface);
  color: var(--ui-text-primary);
  font-size: 30rpx;
  line-height: 1.6;
}

.edit-assistant {
  margin-top: 20rpx;
  padding: 22rpx;
}

.edit-assistant voice-text-editor {
  display: block;
  margin-top: 16rpx;
}

.voice-edit-message {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-accent-strong);
  font-size: 24rpx;
  line-height: 1.45;
  text-wrap: pretty;
}

.edit-reference-toggle,
.material-location-action {
  position: relative;
  min-height: 88rpx;
  margin-top: 18rpx;
  padding: 14rpx 64rpx 14rpx 22rpx;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  box-shadow: var(--ui-control-shadow);
  justify-content: flex-start;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}

.edit-reference-toggle::after,
.material-location-action::after {
  content: "›";
  position: absolute;
  right: 24rpx;
  top: 50%;
  color: var(--ui-accent);
  font-size: 38rpx;
  font-weight: 400;
  transform: translateY(-52%);
}

.edit-reference-panel {
  margin-top: 14rpx;
  padding: 20rpx 22rpx;
}

.material-location-summary {
  padding: 22rpx 24rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
}

.material-location-title,
.material-location-description {
  display: block;
}

.material-location-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.45;
  text-wrap: balance;
}

.material-location-description {
  margin-top: 8rpx;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 1.55;
  text-wrap: pretty;
}

.material-location-summary.has-path .material-location-description {
  margin-bottom: 14rpx;
}

.material-location-row {
  min-height: 76rpx;
  padding: 14rpx 0;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.material-location-row + .material-location-row {
  border-top: 1rpx solid var(--ui-divider);
}

.material-location-label {
  flex: 0 0 72rpx;
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.material-location-value {
  flex: 1 1 auto;
  min-width: 0;
  color: var(--ui-text-primary);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 40rpx;
  overflow-wrap: anywhere;
}

.material-location-action {
  width: 100%;
  box-sizing: border-box;
  transition-property: transform, opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.material-location-action:active,
.material-assignment-picker:active {
  transform: scale(0.96);
}

.material-location-action.is-disabled,
.material-assignment-picker.is-disabled {
  opacity: 0.52;
}

.material-assignment-editor {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-page-background);
}

.material-assignment-state,
.material-assignment-error {
  display: block;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  font-size: 25rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.material-assignment-state {
  background: var(--ui-surface);
  color: var(--ui-text-secondary);
}

.material-assignment-error,
.offline-asr-error {
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
}

.material-assignment-picker {
  min-height: 88rpx;
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface);
  box-shadow: var(--ui-control-shadow);
  display: flex;
  align-items: center;
  gap: 14rpx;
  transition-property: transform, opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.material-assignment-picker-copy {
  flex: 1 1 auto;
  min-width: 0;
}

.material-assignment-label,
.material-assignment-value {
  display: block;
}

.material-assignment-label {
  color: var(--ui-text-secondary);
  font-size: 22rpx;
  line-height: 1.35;
}

.material-assignment-value {
  margin-top: 4rpx;
  color: var(--ui-text-primary);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.material-assignment-chevron {
  flex: 0 0 auto;
  color: var(--ui-accent);
  font-size: 42rpx;
  line-height: 1;
}

.audio-play-button {
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 14rpx 24rpx;
  border: 0;
  border-radius: var(--ui-radius-control);
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-accent-strong);
  box-shadow: var(--ui-control-shadow);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.audio-play-button:active {
  transform: scale(0.96);
}

.audio-play-button[disabled] {
  opacity: 0.52;
  transform: none;
}

.playback-body {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.media-tools-card {
  min-height: 116rpx;
  padding: 24rpx 64rpx 24rpx 26rpx;
  background: linear-gradient(105deg, var(--ui-surface), var(--ui-accent-surface-subtle));
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.media-tools-copy {
  min-width: 0;
  flex: 1;
}

.media-tools-action {
  flex: 0 0 auto;
  color: var(--ui-accent-strong);
  font-size: 26rpx;
  font-weight: 700;
}

.more-actions-card {
  margin-top: 40rpx;
  background: var(--ui-surface-soft);
}

.more-actions-head {
  min-height: 88rpx;
  margin: -18rpx -10rpx;
  padding: 18rpx 10rpx;
}

.more-actions-toggle {
  flex: 0 0 auto;
  color: var(--ui-accent-strong);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.offline-asr-panel,
.repair-panel,
.danger-panel {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: var(--ui-radius-inner);
}

.offline-asr-panel {
  background: var(--ui-surface-subtle);
}

.offline-asr-status.pending,
.offline-asr-status.running {
  color: var(--ui-warning-text);
}

.offline-asr-status.succeeded {
  color: var(--ui-accent-strong);
}

.offline-asr-status.failed,
.offline-asr-error {
  color: var(--ui-danger-text);
}

.offline-asr-detail,
.offline-asr-error {
  color: var(--ui-value-text);
  font-size: 26rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.offline-asr-error {
  margin-top: 10rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
}

.repair-panel {
  background: var(--ui-warning-surface);
}

.danger-panel {
  background: var(--ui-danger-surface);
}

.repair-panel + .danger-panel {
  margin-top: 16rpx;
}

.repair-panel-title,
.danger-panel-title {
  font-family: var(--ui-font-editorial);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
}

.repair-panel-title,
.repair-panel-copy {
  color: var(--ui-warning-text);
}

.danger-panel-title,
.danger-panel-copy {
  color: var(--ui-danger-text);
}

.repair-panel-copy,
.danger-panel-copy {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
  text-wrap: pretty;
}

.repair-button,
.danger-button {
  width: 100%;
  min-height: 88rpx;
  margin-top: 18rpx;
  padding: 14rpx 24rpx;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface);
  box-shadow: var(--ui-control-shadow);
  display: flex;
  align-items: center;
  justify-content: flex-start;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}

.repair-button {
  color: var(--ui-warning-text);
}

.danger-button {
  color: var(--ui-danger-text);
}

.detail-page.large-text .edit-assistant-title,
.detail-page.large-text .repair-panel-title,
.detail-page.large-text .danger-panel-title,
.detail-page.large-text .material-location-title {
  font-size: 34rpx;
  line-height: 1.45;
}

.detail-page.large-text .edit-assistant-hint,
.detail-page.large-text .offline-asr-detail,
.detail-page.large-text .offline-asr-error,
.detail-page.large-text .repair-panel-copy,
.detail-page.large-text .danger-panel-copy,
.detail-page.large-text .hero-status-copy,
.detail-page.large-text .material-location-description,
.detail-page.large-text .material-location-label,
.detail-page.large-text .material-assignment-label {
  font-size: 30rpx;
  line-height: 1.55;
}

.detail-page.large-text .body-text,
.detail-page.large-text .edit-before-text,
.detail-page.large-text .edit-reference-text,
.detail-page.large-text .material-location-value,
.detail-page.large-text .material-assignment-value {
  font-size: 34rpx;
  line-height: 1.7;
}

.detail-page.large-text .transcript-textarea {
  min-height: 360rpx;
  font-size: 34rpx;
  line-height: 1.7;
}

.detail-page.large-text .hero-status,
.detail-page.large-text .playback-time-row,
.detail-page.large-text .more-actions-toggle {
  font-size: 28rpx;
}

.detail-page.large-text .material-location-action,
.detail-page.large-text .material-assignment-picker,
.detail-page.large-text .audio-play-button,
.detail-page.large-text .section-link,
.detail-page.large-text .repair-button,
.detail-page.large-text .danger-button {
  min-height: 96rpx;
  font-size: 30rpx;
}
