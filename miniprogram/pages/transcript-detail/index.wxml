<view class="ui-page-shell {{pageClass}}">
  <view class="ui-page-context-row">
    <text class="ui-page-context">{{item ? (item.project_title || "我的回忆录") : "讲述记录"}}</text>
  </view>

  <view wx:if="{{error && item}}" class="error ui-error-banner">{{error}}</view>

  <view wx:if="{{needsLogin}}" class="empty-panel">
    <text class="empty-title">登录后查看讲述</text>
    <text class="empty-copy">登录后可以核对原始讲述、成书文字和音频资料。</text>
    <view
      class="primary-button login-entry-action ui-block-action ui-pressable"
      aria-role="button"
      bindtap="openLogin"
    >登录后查看</view>
  </view>

  <view wx:elif="{{loading && !item}}" class="empty-panel">
    <text>正在加载</text>
  </view>

  <view wx:elif="{{error && !item}}" class="empty-panel">
    <text class="empty-title">{{utteranceId ? "暂时无法读取这段讲述" : "无法打开这段讲述"}}</text>
    <text class="empty-copy">{{error}}</text>
    <view wx:if="{{utteranceId}}" class="actions-row">
      <button class="primary-button" loading="{{loading}}" disabled="{{loading}}" bindtap="loadTranscript">重新加载</button>
    </view>
  </view>

  <view wx:elif="{{!item}}" class="empty-panel">
    <text class="empty-title">没有找到这段讲述</text>
    <text class="empty-copy">这条讲述记录可能已删除，或不属于当前账号。</text>
  </view>

  <block wx:else>
    <view class="hero-panel">
      <text class="record-title">{{item.titleText}}</text>
      <text class="record-meta">{{item.recordMetaText}}</text>
      <text wx:if="{{!item.isEditing}}" class="hero-status {{item.heroStatusClass}}">{{item.heroStatusText}}</text>
      <text wx:if="{{!item.isEditing && item.transcriptionNoticeText}}" class="hero-status-copy">{{item.transcriptionNoticeText}}</text>
      <view wx:if="{{!item.isEditing && item.canRecoverTranscription}}" class="actions-row primary-actions">
        <button
          class="primary-button"
          bindtap="recoverTranscript"
          loading="{{recovering}}"
          disabled="{{recovering || saving || deleting || convertingQuestionToAnswer}}"
        >
          {{recovering ? "正在转成文字" : "把录音转成文字"}}
        </button>
      </view>
    </view>

    <view wx:if="{{!item.isEditing}}" class="section-card manuscript-card">
      <view class="section-head">
        <view class="section-heading">
          <text class="section-title">成书文字</text>
          <text class="section-hint">整理后会用于书稿</text>
        </view>
        <text wx:if="{{item.canRecoverTranscription}}" class="section-count">{{item.displayCountText}}</text>
        <button
          wx:else
          class="section-link"
          bindtap="beginEdit"
          disabled="{{saving || deleting || convertingQuestionToAnswer}}"
        >编辑 ›</button>
      </view>
      <text class="body-text display-text">
        <text
          wx:for="{{item.displaySegments}}"
          wx:for-item="segment"
          wx:for-index="segmentIndex"
          wx:key="segmentIndex"
        >{{segment.text}}</text>
      </text>
    </view>

    <view wx:else class="section-card edit-card">
      <view class="section-head">
        <view class="section-heading">
          <text class="section-title">编辑成书文字</text>
          <text class="section-hint">可直接修改，也可以让小余按要求调整</text>
        </view>
        <text class="section-count">{{editPreviewVersion === 'before' ? item.displayCountText : item.editingCharCount + ' 字'}}</text>
      </view>
      <view class="edit-version-switch ui-version-switch" aria-label="对比修改前后文字">
        <view
          class="edit-version-option ui-version-option ui-pressable {{editPreviewVersion === 'before' ? 'active' : ''}}"
          data-version="before"
          bindtap="switchEditPreviewVersion"
          aria-role="button"
          aria-pressed="{{editPreviewVersion === 'before'}}"
        >修改前</view>
        <view
          class="edit-version-option ui-version-option ui-pressable {{editPreviewVersion === 'after' ? 'active' : ''}}"
          data-version="after"
          bindtap="switchEditPreviewVersion"
          aria-role="button"
          aria-pressed="{{editPreviewVersion === 'after'}}"
        >修改后</view>
      </view>
      <view wx:if="{{editPreviewVersion === 'before'}}" class="edit-before-panel">
        <text class="edit-before-label">上次保存的成书文字</text>
        <text class="edit-before-text" selectable>{{item.savedText}}</text>
      </view>
      <textarea
        wx:else
        class="transcript-textarea"
        value="{{item.editingText}}"
        bindinput="changeText"
        maxlength="-1"
        auto-height
        cursor-spacing="24"
      />
      <view class="edit-assistant">
        <view>
          <text class="edit-assistant-title">让小余帮我改</text>
          <text class="edit-assistant-hint">进入编辑后直接说，停顿后会自动生成修改后文字；也可以输入</text>
        </view>
        <voice-text-editor
          value="{{voiceEditInstructionText}}"
          gateway-url="{{voiceEditGatewayUrl}}"
          voice-session-id="{{item.id}}"
          maxlength="1000"
          placeholder="例如：把‘清流二村’改成‘清流一村’"
          submit-text="生成修改后文字"
          busy-text="正在修改…"
          hint="结果会放到上方“修改后”草稿，保存前可与修改前对比。"
          disabled="{{saving || deleting || convertingQuestionToAnswer}}"
          busy="{{voiceEditLoading}}"
          automatic-voice-command="{{true}}"
          aria-label="输入或说出素材修改意见"
          bindchange="changeVoiceEditInstruction"
          bindsubmit="previewVoiceEdit"
        />
        <text wx:if="{{voiceEditMessage}}" class="voice-edit-message">{{voiceEditMessage}}</text>
      </view>
      <view
        class="edit-reference-toggle ui-block-action ui-pressable"
        aria-role="button"
        bindtap="toggleEditReference"
        aria-expanded="{{editReferenceExpanded}}"
      >
        {{editReferenceExpanded ? "收起原始讲述" : "查看原始讲述作为参考"}}
      </view>
      <view wx:if="{{editReferenceExpanded}}" class="edit-reference-panel">
        <text class="edit-reference-label">原始讲述</text>
        <text class="edit-reference-text">{{item.transcript_raw}}</text>
      </view>
      <view class="actions-row">
        <button class="ghost-button" bindtap="resetToRaw" disabled="{{saving || deleting || convertingQuestionToAnswer}}">恢复原始讲述</button>
        <button class="ghost-button" bindtap="cancelEdit" disabled="{{saving || deleting || convertingQuestionToAnswer}}">取消编辑</button>
        <button
          class="primary-button"
          bindtap="saveTranscript"
          loading="{{saving}}"
          disabled="{{saving || deleting || convertingQuestionToAnswer || !item.changed}}"
        >
          保存修改
        </button>
      </view>
    </view>

    <view wx:if="{{!item.isEditing}}" class="section-card raw-material-card">
      <view class="section-head">
        <view class="section-heading">
          <view class="raw-title-line">
            <text class="section-title">原始讲述</text>
            <text class="raw-inline-count">· {{item.rawCountText}}</text>
          </view>
          <text class="section-hint">保留您当时说话的样子</text>
        </view>
      </view>
      <text class="body-text raw-text {{!rawExpanded && item.rawCanExpand ? 'collapsed' : ''}}">
        <text
          wx:for="{{item.rawSegments}}"
          wx:for-item="segment"
          wx:for-index="segmentIndex"
          wx:key="segmentIndex"
        >{{segment.text}}</text>
      </text>
      <button
        wx:if="{{item.rawCanExpand}}"
        class="raw-expand-button"
        bindtap="toggleRawExpanded"
        aria-expanded="{{rawExpanded}}"
      >{{rawExpanded ? "收起原话 ∧" : "展开原话 ∨"}}</button>
    </view>

    <view wx:if="{{!item.isEditing && item.question_text}}" class="section-card question-card">
      <view class="section-head">
        <view class="section-heading">
          <text class="section-title">{{item.questionTitleText}}</text>
          <text class="section-hint">这段讲述当时回答的问题</text>
        </view>
        <text class="section-count">{{item.canPlayQuestionAudio ? "有提问语音" : "无提问语音"}}</text>
      </view>
      <text class="body-text question-text {{!questionExpanded && item.questionCanExpand ? 'collapsed' : ''}}">
        <text
          wx:for="{{item.questionSegments}}"
          wx:for-item="segment"
          wx:for-index="segmentIndex"
          wx:key="segmentIndex"
        >{{segment.text}}</text>
      </text>
      <view class="inline-actions">
        <button
          wx:if="{{item.questionCanExpand}}"
          class="text-action-button"
          bindtap="toggleQuestionExpanded"
          disabled="{{saving || deleting || convertingQuestionToAnswer}}"
        >
          {{questionExpanded ? "收起问题" : "展开完整问题"}}
        </button>
        <button
          wx:if="{{item.canPlayQuestionAudio}}"
          class="text-action-button"
          bindtap="playQuestionAudio"
          disabled="{{saving || deleting || convertingQuestionToAnswer || !item.canPlayQuestionAudio}}"
        >
          {{playingAudioKind === "question" ? "停止提问" : "听小余提问"}}
        </button>
      </view>
    </view>

    <view wx:if="{{!item.isEditing}}" class="section-card">
      <view class="section-head">
        <view class="section-heading">
          <text class="section-title">收录位置</text>
        </view>
        <button
          wx:if="{{!item.canRecoverTranscription}}"
          class="section-link"
          bindtap="toggleMaterialAssignmentEditor"
          disabled="{{saving || deleting || convertingQuestionToAnswer}}"
        >{{assignmentEditorOpen ? "收起" : "调整 ›"}}</button>
      </view>
      <view class="material-location-summary">
        <text wx:if="{{item.showLocationPath}}" class="material-location-status"><text aria-hidden="true">✓ </text>{{item.locationTitleText}}</text>
        <block wx:if="{{item.showLocationPath}}">
          <text class="material-location-title">{{item.chapterLocationText}}</text>
          <text wx:if="{{item.sectionLocationText}}" class="material-location-section">{{item.sectionLocationText}}</text>
        </block>
        <text wx:else class="material-location-title is-empty">{{item.locationTitleText}}</text>
      </view>
      <view wx:if="{{assignmentEditorOpen}}" class="material-assignment-editor">
        <text wx:if="{{assignmentLoading}}" class="material-assignment-state">正在加载可选位置…</text>
        <text wx:if="{{assignmentError}}" class="material-assignment-error">{{assignmentError}}</text>
        <block wx:if="{{!assignmentLoading && assignmentOptions.length}}">
          <picker
            mode="selector"
            range="{{assignmentOptions}}"
            range-key="label"
            value="{{assignmentIndex}}"
            disabled="{{assignmentSaving}}"
            bindchange="changeMaterialAssignment"
          >
            <view class="material-assignment-picker {{assignmentSaving ? 'is-disabled' : ''}}">
              <view class="material-assignment-picker-copy">
                <text class="material-assignment-label">移动到</text>
                <text class="material-assignment-value">{{assignmentText}}</text>
              </view>
              <text class="material-assignment-chevron">›</text>
            </view>
          </picker>
        </block>
        <view class="actions-row material-assignment-actions">
          <button
            class="ghost-button"
            disabled="{{assignmentSaving}}"
            bindtap="closeMaterialAssignmentEditor"
          >
            取消
          </button>
          <button
            class="primary-button"
            loading="{{assignmentSaving}}"
            disabled="{{assignmentLoading || assignmentSaving || !assignmentCanSave}}"
            bindtap="saveMaterialAssignment"
          >
            {{assignmentSaving ? "保存中" : "保存位置"}}
          </button>
        </view>
      </view>
    </view>

    <view wx:if="{{!item.isEditing}}" class="section-card audio-card">
      <button
        class="audio-row"
        bindtap="playAnswerAudio"
        disabled="{{saving || deleting || convertingQuestionToAnswer || !item.canPlayAnswerAudio}}"
        aria-label="{{playingAudioKind === 'answer' ? '停止播放原始音频' : '播放原始音频'}}"
      >
        <image class="audio-row-icon" src="/assets/chapter-workspace/speaker.svg" mode="aspectFit" aria-hidden="true" />
        <view class="audio-row-copy">
          <text class="section-title">原始音频</text>
          <text class="audio-row-duration">· {{item.audioText}}</text>
        </view>
        <text class="audio-row-action">{{playingAudioKind === "answer" ? "停止" : "播放"}} ›</text>
      </button>
      <view wx:if="{{answerPlaybackVisible}}" class="playback-body">
        <view class="playback-track">
          <view class="playback-fill" style="{{answerPlaybackProgressStyle}}"></view>
        </view>
        <view class="playback-time-row">
          <text>{{answerPlaybackCurrentText}}</text>
          <text>{{answerPlaybackDurationText}}</text>
        </view>
        <view class="actions-row playback-actions">
          <button
            class="ghost-button"
            bindtap="toggleAnswerPlaybackPause"
            disabled="{{!answerPlaybackCanTogglePause}}"
          >
            {{answerPlaybackPaused ? "继续播放" : "暂停"}}
          </button>
          <button
            class="ghost-button"
            bindtap="stopPlayback"
            disabled="{{!answerPlaybackCanStop}}"
          >
            {{answerPlaybackStopText}}
          </button>
        </view>
      </view>
    </view>

    <view
      wx:if="{{!item.isEditing && !item.canRecoverTranscription}}"
      class="section-card media-tools-card ui-pressable"
      bindtap="openMediaTools"
      aria-role="button"
      aria-label="打开图片或视频制作工具"
    >
      <view class="media-tools-copy">
        <text class="section-title">做成图片或视频</text>
        <text class="section-hint">把这段回忆做成可以分享的内容</text>
      </view>
      <text class="media-tools-action">制作 ›</text>
    </view>

    <view wx:if="{{!item.isEditing}}" class="section-card more-actions-card">
      <view
        class="section-head more-actions-head ui-pressable"
        bindtap="toggleMoreActionsExpanded"
        aria-role="button"
        aria-expanded="{{moreActionsExpanded}}"
      >
        <view class="section-heading">
          <text class="section-title">更多操作</text>
        </view>
        <text class="more-actions-toggle" aria-hidden="true">{{moreActionsExpanded ? "收起" : "›"}}</text>
      </view>
      <view wx:if="{{moreActionsExpanded && item.showOfflineAsr && !item.canRecoverTranscription}}" class="offline-asr-panel">
        <view class="section-head">
          <view class="section-heading">
            <text class="section-title">离线加强识别</text>
            <text class="section-hint">{{item.offlineAsrMethodText}}</text>
          </view>
          <text class="section-count offline-asr-status {{item.offlineAsrStatusClass}}">{{item.offlineAsrStatusText}}</text>
        </view>
        <text class="offline-asr-detail">{{item.offlineAsrDetailText}}</text>
        <text wx:if="{{item.offlineAsrErrorText}}" class="offline-asr-error">{{item.offlineAsrErrorText}}</text>
        <view class="actions-row offline-asr-actions">
          <button
            class="primary-button"
            bindtap="startOfflineAsr"
            loading="{{offlineAsrStarting || item.offlineAsrActive}}"
            disabled="{{offlineAsrStarting || item.offlineAsrActive || !item.canStartOfflineAsr || saving || deleting || convertingQuestionToAnswer}}"
          >
            {{offlineAsrStarting ? "正在提交" : item.offlineAsrActionText}}
          </button>
        </view>
      </view>
      <view wx:if="{{moreActionsExpanded && item.canConvertQuestionToAnswer}}" class="repair-panel">
        <text class="repair-panel-title">这段其实是回答</text>
        <text class="repair-panel-copy">如果录音时把被访者的话记成了采访者问题，可以在这里改回讲述素材。</text>
        <view
          class="repair-button ui-block-action ui-pressable {{saving || deleting || convertingQuestionToAnswer ? 'is-disabled' : ''}}"
          aria-role="button"
          aria-disabled="{{saving || deleting || convertingQuestionToAnswer}}"
          bindtap="convertCurrentQuestionToAnswer"
        >
          {{convertingQuestionToAnswer ? "正在修改" : "把这段改成回答"}}
        </view>
      </view>
      <view wx:if="{{moreActionsExpanded}}" class="danger-panel">
        <text class="danger-panel-title">删除这条讲述</text>
        <text class="danger-panel-copy">删除后，这条原始讲述会从素材库移除；如果已放入章节，相关章节会标记为需重新确认，已生成正文不会自动改写。</text>
        <view
          class="danger-button ui-block-action ui-pressable {{saving || deleting || convertingQuestionToAnswer ? 'is-disabled' : ''}}"
          aria-role="button"
          aria-disabled="{{saving || deleting || convertingQuestionToAnswer}}"
          bindtap="deleteTranscript"
        >
          {{deleting ? "正在删除…" : "删除这条讲述"}}
        </view>
      </view>
    </view>
  </block>

  <view class="bottom-spacer"></view>
</view>
