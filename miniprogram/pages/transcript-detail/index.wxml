<view class="detail-page">
  <view class="top-row">
    <view class="back-hit" bindtap="goBack">
      <text class="back-mark">‹</text>
    </view>
    <view class="title-block">
      <text class="page-title">这段讲述</text>
      <text class="page-meta">{{item ? (item.project_title || "我的回忆录") : "讲述记录"}}</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view wx:if="{{needsLogin}}" class="empty-panel">
    <text class="empty-title">登录后查看讲述</text>
    <text class="empty-copy">登录后可以核对原始讲述、成书文字和音频资料。</text>
    <button class="primary-button" bindtap="openLogin">登录后查看</button>
  </view>

  <view wx:elif="{{loading && !item}}" class="empty-panel">
    <text>正在加载</text>
  </view>

  <view wx:elif="{{!item}}" class="empty-panel">
    <text class="empty-title">没有找到这段讲述</text>
    <text class="empty-copy">这条讲述记录可能已删除，或不属于当前账号。</text>
  </view>

  <block wx:else>
    <view class="hero-panel">
      <text class="record-title">{{item.titleText}}</text>
      <text class="record-meta">{{item.recordMetaText}}</text>
      <text class="book-status {{item.isIncludedInBook ? 'included' : ''}}">{{item.bookInclusionText}}</text>
      <view class="actions-row primary-actions">
        <button
          class="primary-button"
          bindtap="beginEdit"
          disabled="{{saving || deleting || item.isEditing}}"
        >
          编辑成书文字
        </button>
        <button
          class="ghost-button"
          bindtap="playAnswerAudio"
          disabled="{{saving || deleting || !item.canPlayAnswerAudio}}"
        >
          {{playingAudioKind === "answer" ? "停止讲述" : "听讲述原音"}}
        </button>
      </view>
    </view>

    <view wx:if="{{answerPlaybackVisible}}" class="playback-panel">
      <view class="playback-head">
        <view class="section-heading">
          <text class="section-title">讲述原音</text>
          <text class="section-hint">只播放家人的这段回答</text>
        </view>
        <text class="section-count">{{answerPlaybackStatusText}}</text>
      </view>
      <view class="playback-track">
        <view class="playback-fill" style="{{answerPlaybackProgressStyle}}"></view>
      </view>
      <view class="playback-time-row">
        <text>{{answerPlaybackCurrentText}}</text>
        <text>{{answerPlaybackDurationText}}</text>
      </view>
      <view class="actions-row playback-actions">
        <button
          class="ghost-button"
          bindtap="toggleAnswerPlaybackPause"
          disabled="{{!answerPlaybackCanTogglePause}}"
        >
          {{answerPlaybackPaused ? "继续播放" : "暂停"}}
        </button>
        <button
          class="ghost-button"
          bindtap="stopPlayback"
          disabled="{{!answerPlaybackCanStop}}"
        >
          {{answerPlaybackStopText}}
        </button>
      </view>
    </view>

    <view wx:if="{{!item.isEditing}}" class="section-card manuscript-card">
      <view class="section-head">
        <view class="section-heading">
          <text class="section-title">成书文字</text>
          <text class="section-hint">这段会用于章节正文</text>
        </view>
        <text class="section-count">{{item.display_char_count}} 字</text>
      </view>
      <text class="body-text display-text">
        <text
          wx:for="{{item.displaySegments}}"
          wx:for-item="segment"
          wx:for-index="segmentIndex"
          wx:key="segmentIndex"
        >{{segment.text}}</text>
      </text>
    </view>

    <view wx:else class="section-card edit-card">
      <view class="section-head">
        <view class="section-heading">
          <text class="section-title">编辑成书文字</text>
          <text class="section-hint">修改后会更新这段章节素材</text>
        </view>
        <text class="section-count">{{item.editingCharCount}} 字</text>
      </view>
      <textarea
        class="transcript-textarea"
        value="{{item.editingText}}"
        bindinput="changeText"
        maxlength="-1"
        auto-height
        cursor-spacing="24"
      />
      <view class="actions-row">
        <button class="ghost-button" bindtap="resetToRaw" disabled="{{saving || deleting}}">恢复原始讲述</button>
        <button class="ghost-button" bindtap="cancelEdit" disabled="{{saving || deleting}}">取消</button>
        <button
          class="primary-button"
          bindtap="saveTranscript"
          loading="{{saving}}"
          disabled="{{saving || deleting || !item.changed}}"
        >
          保存
        </button>
      </view>
    </view>

    <view wx:if="{{item.question_text}}" class="section-card question-card">
      <view class="section-head">
        <view class="section-heading">
          <text class="section-title">{{item.questionTitleText}}</text>
          <text class="section-hint">这段讲述当时回答的问题</text>
        </view>
        <text class="section-count">{{item.canPlayQuestionAudio ? "有提问语音" : "无提问语音"}}</text>
      </view>
      <text class="body-text question-text {{!questionExpanded && item.questionCanExpand ? 'collapsed' : ''}}">
        <text
          wx:for="{{item.questionSegments}}"
          wx:for-item="segment"
          wx:for-index="segmentIndex"
          wx:key="segmentIndex"
        >{{segment.text}}</text>
      </text>
      <view class="inline-actions">
        <button
          wx:if="{{item.questionCanExpand}}"
          class="text-action-button"
          bindtap="toggleQuestionExpanded"
          disabled="{{saving || deleting}}"
        >
          {{questionExpanded ? "收起问题" : "展开完整问题"}}
        </button>
        <button
          wx:if="{{item.canPlayQuestionAudio}}"
          class="text-action-button"
          bindtap="playQuestionAudio"
          disabled="{{saving || deleting || !item.canPlayQuestionAudio}}"
        >
          {{playingAudioKind === "question" ? "停止提问" : "听小余提问"}}
        </button>
      </view>
    </view>

    <view class="section-card evidence-card">
      <view class="section-head">
        <view class="section-heading">
          <text class="section-title">原始讲述</text>
          <text class="section-hint">根据录音识别，保留口述痕迹</text>
        </view>
        <text class="section-count">{{item.raw_char_count}} 字</text>
      </view>
      <text class="body-text raw-text">
        <text
          wx:for="{{item.rawSegments}}"
          wx:for-item="segment"
          wx:for-index="segmentIndex"
          wx:key="segmentIndex"
        >{{segment.text}}</text>
      </text>
    </view>

    <view wx:if="{{!item.isEditing}}" class="section-card edit-tools-card">
      <view class="section-head">
        <view class="section-heading">
          <text class="section-title">修改这段文字</text>
          <text class="section-hint">可以直接编辑，也可以说出要改哪里。说完后先预览，确认后才保存。</text>
        </view>
        <text class="section-count">{{voiceEditStatusText || "可修改"}}</text>
      </view>
      <view class="actions-row edit-choice-actions">
        <button
          class="primary-button"
          bindtap="beginEdit"
          disabled="{{saving || deleting || item.isEditing}}"
        >
          手动编辑
        </button>
        <button
          class="ghost-button"
          bindtap="startVoiceEdit"
          loading="{{voiceEditLoading}}"
          disabled="{{saving || deleting || voiceEditSaving || voiceEditLoading}}"
        >
          {{voiceEditRecording ? "停止录入" : (voiceEditLoading ? "生成中" : "说修改意见")}}
        </button>
      </view>
      <text class="voice-edit-example">例如：把“身体挺硬朗”改成“身体还算硬朗”。</text>
      <view wx:if="{{voiceEditInstructionText}}" class="voice-edit-block">
        <text class="voice-edit-label">你说</text>
        <text class="voice-edit-text">{{voiceEditInstructionText}}</text>
      </view>
      <view wx:if="{{voiceEditPreview}}" class="voice-edit-block">
        <text class="voice-edit-label">小余建议</text>
        <text class="voice-edit-text">{{voiceEditPreview.replyText}}</text>
        <text class="voice-edit-confidence">可信度 {{voiceEditPreview.confidenceText}}</text>
      </view>
      <view wx:if="{{voiceEditPreview && voiceEditPreview.changes.length}}" class="voice-edit-changes">
        <view
          wx:for="{{voiceEditPreview.changes}}"
          wx:for-item="change"
          wx:for-index="changeIndex"
          wx:key="changeIndex"
          class="voice-edit-change"
        >
          <text class="voice-edit-change-text">“{{change.before}}” → “{{change.after}}”</text>
          <text wx:if="{{change.reason}}" class="voice-edit-change-reason">{{change.reason}}</text>
        </view>
      </view>
      <view wx:if="{{voiceEditPreview && voiceEditPreview.canConfirm}}" class="voice-edit-inline-diff">
        <text class="voice-edit-label">文稿变化</text>
        <text class="voice-edit-diff-text">
          <text
            wx:for="{{voiceEditPreview.diffSegments}}"
            wx:for-item="segment"
            wx:for-index="segmentIndex"
            wx:key="segmentIndex"
            class="voice-edit-diff-segment {{segment.kind}}"
          >{{segment.text}}</text>
        </text>
      </view>
      <view wx:if="{{voiceEditPreview}}" class="actions-row">
        <button
          class="ghost-button"
          bindtap="cancelVoiceEdit"
          disabled="{{voiceEditSaving}}"
        >
          取消修改
        </button>
        <button
          class="primary-button"
          bindtap="confirmVoiceEdit"
          loading="{{voiceEditSaving}}"
          disabled="{{voiceEditSaving || !voiceEditPreview.canConfirm}}"
        >
          确认保存
        </button>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view class="section-heading">
          <text class="section-title">章节位置</text>
          <text class="section-hint">{{item.bookInclusionText}}</text>
        </view>
        <text class="section-count">{{item.isIncludedInBook ? "已入章" : "未入章"}}</text>
      </view>
      <view class="actions-row">
        <picker
          wx:if="{{item.canAssignChapterSource}}"
          range="{{item.chapterAssignOptions}}"
          range-key="label"
          disabled="{{assigning || moving || saving || deleting}}"
          bindchange="assignTranscriptChapter"
        >
          <view class="primary-button picker-action {{assigning || moving || saving || deleting ? 'disabled' : ''}}">
            {{assigning ? "归入中" : "放入章节"}}
          </view>
        </picker>
        <picker
          wx:if="{{item.canMoveChapterSource}}"
          range="{{item.chapterMoveOptions}}"
          range-key="label"
          disabled="{{assigning || moving || saving || deleting}}"
          bindchange="moveTranscriptChapter"
        >
          <view class="ghost-button picker-action {{assigning || moving || saving || deleting ? 'disabled' : ''}}">
            {{moving ? "移动中" : "移动章节"}}
          </view>
        </picker>
      </view>
    </view>

    <view class="section-card more-actions-card">
      <view class="section-head more-actions-head" bindtap="toggleMoreActionsExpanded">
        <view class="section-heading">
          <text class="section-title">更多操作</text>
          <text class="section-hint">删除等低频操作收在这里</text>
        </view>
        <text class="more-actions-toggle">{{moreActionsExpanded ? "收起" : "展开"}}</text>
      </view>
      <view wx:if="{{moreActionsExpanded}}" class="danger-panel">
        <text class="danger-panel-title">删除这条讲述</text>
        <text class="danger-panel-copy">删除后，这条原始讲述会从素材库移除；如果已放入章节，相关章节会标记为需重新确认，已生成正文不会自动改写。</text>
        <button
          class="danger-button"
          bindtap="deleteTranscript"
          loading="{{deleting}}"
          disabled="{{saving || deleting}}"
        >
          删除这条讲述
        </button>
      </view>
    </view>
  </block>

  <view class="bottom-spacer"></view>
</view>
