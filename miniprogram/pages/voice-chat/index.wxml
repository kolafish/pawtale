<view class="{{voiceChatPageClass}}">
  <view class="top-bar">
    <view class="top-copy">
      <text class="mode-label">{{topModeLabel}}</text>
      <text class="top-subtitle">{{topSubtitle}}</text>
    </view>
    <button
      class="finish-button"
      loading="{{finishingSession}}"
      disabled="{{finishingSession}}"
      bindtap="finishSession"
    >
      {{finishButtonText}}
    </button>
  </view>

  <view class="topic-panel">
    <text class="topic-kicker">正在聊：</text>
    <text class="topic-title">{{topicTitleText}}</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{showErrorKindStrip}}" class="session-state-strip">
    <text class="session-state-error">{{errorKindText}}</text>
  </view>
  <view wx:if="{{showRecoveryPanel}}" class="recovery-panel">
    <text wx:if="{{recoveryNotice}}" class="recovery-text">{{recoveryNotice}}</text>
    <view wx:if="{{showRecoveryActions}}" class="recovery-actions">
      <button wx:if="{{canReconnect}}" class="recovery-button" bindtap="reconnectGateway">重新连接</button>
      <button wx:if="{{canFinishAfterDisconnect}}" class="recovery-button ghost" bindtap="finishAfterDisconnect">查看讲述记录</button>
    </view>
  </view>

  <view wx:if="{{showVoiceAuthorizationPanel}}" class="voice-auth-panel">
    <text class="voice-auth-title">开始录音前需要声纹授权</text>
    <text class="voice-auth-desc">同意后才会打开麦克风，语音会用于实时识别文字、小余语音回应、原始音频留存和回忆录成书。</text>
    <checkbox-group bindchange="changeVoiceAuthorization">
      <label class="voice-auth-row">
        <checkbox
          value="voice_authorization"
          checked="{{voiceAuthorizationAgreed}}"
          color="#a64b3e"
        />
        <view class="voice-auth-copy">
          <text>我已阅读并同意</text>
          <text class="voice-auth-link" catchtap="openVoiceAuthorization">《声纹授权协议》</text>
        </view>
      </label>
    </checkbox-group>
  </view>

  <view wx:if="{{showAssistantPanel}}" class="{{assistantPanelClass}}">
    <view class="assistant-head">
      <text class="assistant-label">{{assistantLabelText}}</text>
    </view>
    <view wx:if="{{showAssistantOpening}}" class="assistant-opening">
      <text class="assistant-context">今天可以接着讲，也可以换个方向。想不起来也没关系。</text>
      <text class="assistant-question">{{assistantQuestionText}}</text>
      <view class="assistant-topic-options">
        <button
          wx:for="{{openingTopicOptions}}"
          wx:key="id"
          class="assistant-topic-button"
          data-prompt-text="{{item.promptText}}"
          bindtap="chooseOpeningTopic"
        >
          {{item.label}}
        </button>
      </view>
    </view>
    <text wx:elif="{{showSelectedOpeningTopic}}" class="assistant-text">{{selectedOpeningTopicText}}</text>
    <view wx:elif="{{showAssistantTTS}}" class="assistant-tts-text">
      <text class="assistant-tts-spoken">{{ttsSpokenText}}</text>
      <text class="assistant-tts-current">{{ttsCurrentText}}</text>
      <text>{{ttsRemainingText}}</text>
    </view>
    <text wx:else class="assistant-text">{{assistantDisplayText}}</text>
    <view wx:if="{{showTTSProgress}}" class="tts-progress-track">
      <view class="tts-progress-fill" style="width: {{ttsProgressPercent}}%;"></view>
    </view>
    <text wx:if="{{followUpTTSError}}" class="tts-error">{{followUpTTSError}}</text>
    <view class="assistant-actions">
      <button
        wx:if="{{assistantPromptText}}"
        class="assistant-button ghost"
        loading="{{followUpTTSLoading}}"
        disabled="{{followUpTTSLoading}}"
        bindtap="playFollowUpAudio"
      >
        {{replayButtonText}}
      </button>
      <button
        class="assistant-button"
        loading="{{followUpLoading}}"
        disabled="{{followUpLoading}}"
        bindtap="regenerateFollowUp"
      >
        {{followUpButtonText}}
      </button>
      <button
        wx:if="{{showSkipFollowUp}}"
        class="assistant-button ghost"
        bindtap="skipFollowUp"
      >
        跳过
      </button>
    </view>
  </view>

  <view class="transcript-stage">
    <text class="{{stageStatusClass}}">
      {{stageStatusText}}
    </text>
    <scroll-view
      class="{{liveScrollClass}}"
      scroll-y="{{true}}"
      scroll-top="{{liveScrollTop}}"
      scroll-into-view="{{liveScrollTarget}}"
    >
      <text class="live-text">{{liveDisplayText}}</text>
      <view id="{{liveTextEndId}}" class="live-text-end"></view>
    </scroll-view>
    <view class="{{captureStripClass}}">
      <view class="capture-dot"></view>
      <text wx:if="{{recording}}">已说 {{captureDurationText}}</text>
      <text wx:else>说完后点“说完了”，我会帮您整理成文字。</text>
      <text wx:if="{{showLiveCharCount}}">本句 {{liveCharCount}} 字</text>
    </view>
    <button
      wx:if="{{showInlineHelp}}"
      class="inline-help-button"
      loading="{{followUpLoading}}"
      disabled="{{followUpLoading}}"
      bindtap="stopAndAskFollowUp"
    >
      不知道讲什么，让小余问一句
    </button>
    <view wx:if="{{recording}}" class="voice-activity">
      <view class="level-track">
        <view class="level-fill" style="width: {{audioLevelPercent}}%;"></view>
      </view>
    </view>
  </view>

  <view class="history-panel">
    <view class="history-header">
      <text>本次讲述</text>
      <text class="history-count">{{historyCountText}}</text>
    </view>
    <view wx:if="{{showHistoryEmpty}}" class="empty-state">
      <text>一句话说完后，会在这里保存下来。</text>
    </view>
    <view wx:for="{{transcriptLineViews}}" wx:key="id" class="{{item.lineClass}}">
      <text class="line-role">{{item.roleText}}</text>
      <text>{{item.text}}</text>
    </view>
  </view>

  <view class="control-bar">
    <text wx:if="{{controlHintText}}" class="control-hint">{{controlHintText}}</text>
    <view wx:if="{{showHumanRecordActions}}" class="human-record-actions">
      <button
        class="{{narratorRecordButtonClass}}"
        data-role="narrator"
        loading="{{connecting}}"
        disabled="{{micButtonDisabled}}"
        bindtap="startRecordingAsSpeaker"
      >
        <view class="role-record-icon-shell">
          <image class="role-record-icon" src="/assets/memoir-microphone.png" mode="aspectFit" />
        </view>
        <text class="role-record-text">记录被访者</text>
      </button>
      <button
        class="{{interviewerRecordButtonClass}}"
        data-role="interviewer"
        loading="{{connecting}}"
        disabled="{{micButtonDisabled}}"
        bindtap="startRecordingAsSpeaker"
      >
        <view class="role-record-icon-shell">
          <image class="role-record-icon" src="/assets/memoir-microphone.png" mode="aspectFit" />
        </view>
        <text class="role-record-text">记录采访者</text>
      </button>
    </view>
    <button
      wx:else
      class="{{micButtonClass}}"
      loading="{{connecting}}"
      disabled="{{micButtonDisabled}}"
      bindtap="toggleRecording"
    >
      <view class="mic-icon-shell">
        <image class="mic-icon" src="/assets/memoir-microphone.png" mode="aspectFit" />
      </view>
      <text class="mic-button-text">{{micButtonText}}</text>
    </button>
  </view>
</view>
