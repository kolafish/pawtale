<view class="voice-chat-page">
  <view class="top-bar">
    <view>
      <text class="mode-label">{{modeLabel}}</text>
      <text class="status-label {{status}}">{{statusText}}</text>
    </view>
    <button
      class="finish-button"
      loading="{{finishingSession}}"
      disabled="{{finishingSession}}"
      bindtap="finishSession"
    >
      {{finishingSession ? "保存中" : "保存离开"}}
    </button>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="session-state-strip">
    <block wx:if="{{error}}">
      <text class="session-state-error">{{errorKindText || statusText}}</text>
    </block>
    <block wx:else>
      <text>{{gatewayStateText}}</text>
      <text>{{persistenceStateText}}</text>
    </block>
  </view>
  <view wx:if="{{recoveryNotice || canReconnect || canFinishAfterDisconnect}}" class="recovery-panel">
    <text wx:if="{{recoveryNotice}}" class="recovery-text">{{recoveryNotice}}</text>
    <view wx:if="{{canReconnect || canFinishAfterDisconnect}}" class="recovery-actions">
      <button wx:if="{{canReconnect}}" class="recovery-button" bindtap="reconnectGateway">重新连接</button>
      <button wx:if="{{canFinishAfterDisconnect}}" class="recovery-button ghost" bindtap="finishAfterDisconnect">查看讲述记录</button>
    </view>
  </view>

  <view wx:if="{{!voiceAuthorizationAgreed}}" class="voice-auth-panel">
    <text class="voice-auth-title">开始录音前需要声纹授权</text>
    <text class="voice-auth-desc">同意后才会打开麦克风，语音会用于实时识别文字、AI 追问、原始音频留存和回忆录成书。</text>
    <checkbox-group bindchange="changeVoiceAuthorization">
      <label class="voice-auth-row">
        <checkbox
          value="voice_authorization"
          checked="{{voiceAuthorizationAgreed}}"
          color="#9f4a3c"
        />
        <view class="voice-auth-copy">
          <text>我已阅读并同意</text>
          <text class="voice-auth-link" catchtap="openVoiceAuthorization">《声纹授权协议》</text>
        </view>
      </label>
    </checkbox-group>
  </view>

  <view wx:if="{{assistantPromptText || followUpLoading || followUpError || canRequestFollowUp}}" class="assistant-panel {{followUpError ? 'error-state' : ''}}">
    <view class="assistant-head">
      <text class="assistant-label">{{assistantPromptLabel}}</text>
      <text class="assistant-state">{{followUpLoading ? "思考中" : (followUpError ? "追问失败" : (assistantPromptText ? "等待回答" : "可生成"))}}</text>
    </view>
    <view wx:if="{{followUpTTSPlaying && assistantPromptText}}" class="assistant-tts-text">
      <text class="assistant-tts-spoken">{{ttsSpokenText}}</text>
      <text class="assistant-tts-current">{{ttsCurrentText}}</text>
      <text>{{ttsRemainingText}}</text>
    </view>
    <text wx:else class="assistant-text">{{followUpLoading ? assistantLoadingText : (followUpError || assistantPromptText || assistantEmptyText)}}</text>
    <view wx:if="{{assistantPromptText && (followUpTTSStateText || followUpTTSError || followUpTTSLoading)}}" class="tts-strip {{followUpTTSError ? 'error' : ''}}">
      <text>{{followUpTTSLoading ? "正在准备 AI 语音" : (followUpTTSError || followUpTTSStateText)}}</text>
      <text wx:if="{{followUpTTSPlaying}}" class="tts-progress-text">{{ttsProgressPercent}}%</text>
    </view>
    <view class="assistant-actions">
      <button
        wx:if="{{assistantPromptText}}"
        class="assistant-button ghost"
        loading="{{followUpTTSLoading}}"
        disabled="{{followUpTTSLoading}}"
        bindtap="playFollowUpAudio"
      >
        {{followUpAudioFileId ? (followUpTTSPlaying ? "播放中" : "重播语音") : (followUpTTSError ? "重试语音" : "播放语音")}}
      </button>
      <button
        class="assistant-button"
        loading="{{followUpLoading}}"
        disabled="{{followUpLoading}}"
        bindtap="regenerateFollowUp"
      >
        {{followUpError ? (assistantPromptLabel === "AI 开场" ? "重试开场" : "重试追问") : (assistantPromptText ? (assistantPromptLabel === "AI 开场" ? "换个开场" : "换个追问") : (assistantPromptLabel === "AI 开场" ? "生成开场" : "生成追问"))}}
      </button>
      <button
        wx:if="{{assistantPromptText && !followUpLoading && !followUpError}}"
        class="assistant-button ghost"
        bindtap="skipFollowUp"
      >
        跳过
      </button>
    </view>
  </view>

  <view class="transcript-stage">
    <text class="stage-eyebrow">{{recording ? captureStateText : (followUpLoading ? (assistantPromptLabel === "AI 开场" ? "AI 正在开场" : "AI 正在追问") : "准备好了")}}</text>
    <text class="live-text">{{liveText || latestTranscriptText || (recording ? "请直接说，我会把文字显示在这里" : "点下方按钮开始回答")}}</text>
    <view class="capture-strip {{recording ? 'active' : ''}}">
      <view class="capture-dot"></view>
      <text>{{captureStateText}}</text>
      <view class="capture-metrics">
        <text>{{captureDurationText}}</text>
        <text>本句 {{liveCharCount}} 字</text>
        <text wx:if="{{captureFrameCount}}">{{captureFrameCount}} 帧</text>
        <text wx:if="{{captureFrameCount}}">{{captureKilobytes}} KB</text>
      </view>
    </view>
    <view class="voice-activity">
      <view class="level-track">
        <view class="level-fill" style="width: {{audioLevelPercent}}%;"></view>
      </view>
      <text class="auto-listen-text">{{autoListenStateText}}</text>
      <text class="auto-stop-text">{{autoStopStateText}}</text>
      <button class="auto-stop-toggle" bindtap="toggleAutoStop">
        {{autoStopEnabled ? "关闭" : "开启"}}
      </button>
    </view>
  </view>

  <view class="history-panel">
    <view class="history-header">
      <text>本次讲述</text>
      <text class="history-count">{{transcriptLines.length}} 段 · {{totalTranscriptCharCount}} 字</text>
    </view>
    <view wx:if="{{!transcriptLines.length}}" class="empty-state">
      <text>一句话说完后，会在这里保存下来。</text>
    </view>
    <view wx:for="{{transcriptLines}}" wx:key="id" class="transcript-line {{item.role === 'assistant' ? 'assistant' : 'user'}}">
      <text class="line-role">{{item.role === 'assistant' ? 'AI' : '我'}}</text>
      <text>{{item.text}}</text>
    </view>
  </view>

  <view class="control-bar">
    <button
      class="mic-button {{recording ? 'recording' : ''}}"
      loading="{{connecting}}"
      disabled="{{connecting || followUpLoading || !voiceAuthorizationAgreed}}"
      bindtap="toggleRecording"
    >
      <image class="mic-icon" src="/assets/memoir-microphone.png" mode="aspectFit" />
      <text>{{!voiceAuthorizationAgreed ? "同意后开始说话" : (connecting ? "连接中" : (followUpLoading ? "AI 思考中" : primaryActionText))}}</text>
    </button>
  </view>
</view>
