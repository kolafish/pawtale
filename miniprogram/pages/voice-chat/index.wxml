<view class="voice-chat-page">
  <view class="top-bar">
    <view class="top-copy">
      <text class="mode-label">语音访谈</text>
      <text class="top-subtitle">小余陪您慢慢讲</text>
    </view>
    <button
      class="finish-button"
      loading="{{finishingSession}}"
      disabled="{{finishingSession}}"
      bindtap="finishSession"
    >
      {{finishingSession ? "保存中" : "保存离开"}}
    </button>
  </view>

  <view class="topic-panel">
    <text class="topic-kicker">正在聊：</text>
    <text class="topic-title">{{projectTitle || "这段回忆"}}</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{error && errorKindText}}" class="session-state-strip">
    <text class="session-state-error">{{errorKindText}}</text>
  </view>
  <view wx:if="{{recoveryNotice || canReconnect || canFinishAfterDisconnect}}" class="recovery-panel">
    <text wx:if="{{recoveryNotice}}" class="recovery-text">{{recoveryNotice}}</text>
    <view wx:if="{{canReconnect || canFinishAfterDisconnect}}" class="recovery-actions">
      <button wx:if="{{canReconnect}}" class="recovery-button" bindtap="reconnectGateway">重新连接</button>
      <button wx:if="{{canFinishAfterDisconnect}}" class="recovery-button ghost" bindtap="finishAfterDisconnect">查看讲述记录</button>
    </view>
  </view>

  <view wx:if="{{!voiceAuthorizationAgreed}}" class="voice-auth-panel">
    <text class="voice-auth-title">开始录音前需要声纹授权</text>
    <text class="voice-auth-desc">同意后才会打开麦克风，语音会用于实时识别文字、小余语音回应、原始音频留存和回忆录成书。</text>
    <checkbox-group bindchange="changeVoiceAuthorization">
      <label class="voice-auth-row">
        <checkbox
          value="voice_authorization"
          checked="{{voiceAuthorizationAgreed}}"
          color="#a64b3e"
        />
        <view class="voice-auth-copy">
          <text>我已阅读并同意</text>
          <text class="voice-auth-link" catchtap="openVoiceAuthorization">《声纹授权协议》</text>
        </view>
      </label>
    </checkbox-group>
  </view>

  <view wx:if="{{!recording && (assistantPromptText || followUpLoading || followUpError || canRequestFollowUp)}}" class="assistant-panel {{followUpError ? 'error-state' : ''}}">
    <view class="assistant-head">
      <text class="assistant-label">{{followUpError ? "小余没说好" : "小余想听您讲讲"}}</text>
    </view>
    <view wx:if="{{!latestTranscriptText && !followUpLoading && !followUpError && !selectedOpeningTopicText}}" class="assistant-opening">
      <text class="assistant-context">今天可以接着讲，也可以换个方向。想不起来也没关系。</text>
      <text class="assistant-question">{{assistantPromptText || "今天想先讲哪一段？"}}</text>
      <view class="assistant-topic-options">
        <button
          wx:for="{{openingTopicOptions}}"
          wx:key="id"
          class="assistant-topic-button"
          data-prompt-text="{{item.promptText}}"
          bindtap="chooseOpeningTopic"
        >
          {{item.label}}
        </button>
      </view>
    </view>
    <text wx:elif="{{selectedOpeningTopicText}}" class="assistant-text">{{selectedOpeningTopicText}}</text>
    <view wx:elif="{{followUpTTSPlaying && assistantPromptText}}" class="assistant-tts-text">
      <text class="assistant-tts-spoken">{{ttsSpokenText}}</text>
      <text class="assistant-tts-current">{{ttsCurrentText}}</text>
      <text>{{ttsRemainingText}}</text>
    </view>
    <text wx:else class="assistant-text">{{assistantPromptText || (followUpLoading ? assistantLoadingText : (followUpError || assistantEmptyText))}}</text>
    <view wx:if="{{assistantPromptText && followUpTTSPlaying}}" class="tts-progress-track">
      <view class="tts-progress-fill" style="width: {{ttsProgressPercent}}%;"></view>
    </view>
    <text wx:if="{{followUpTTSError}}" class="tts-error">{{followUpTTSError}}</text>
    <view class="assistant-actions">
      <button
        wx:if="{{assistantPromptText}}"
        class="assistant-button ghost"
        loading="{{followUpTTSLoading}}"
        disabled="{{followUpTTSLoading}}"
        bindtap="playFollowUpAudio"
      >
        {{followUpAudioFileId ? "重听一遍" : (followUpTTSError ? "重试朗读" : "读给我听")}}
      </button>
      <button
        class="assistant-button"
        loading="{{followUpLoading}}"
        disabled="{{followUpLoading}}"
        bindtap="regenerateFollowUp"
      >
        {{followUpError ? "再问一次" : (assistantPromptText ? "换个问法" : "让小余问一句")}}
      </button>
      <button
        wx:if="{{assistantPromptText && !followUpLoading && !followUpError}}"
        class="assistant-button ghost"
        bindtap="skipFollowUp"
      >
        跳过
      </button>
    </view>
  </view>

  <view class="transcript-stage">
    <text class="stage-status {{error ? 'error' : (recording ? 'listening' : '')}}">
      {{error ? "需要处理一下" : (recording ? "我在听，您慢慢说" : (persistenceStateText === "已保存" ? "这一段已经记下来了" : ((followUpTTSPlaying || (followUpTTSLoading && assistantPromptText)) ? "小余正在读问题" : (followUpLoading ? (latestTranscriptText ? "正在帮您整理成文字" : "小余正在准备问题") : "可以开始讲了"))))}}
    </text>
    <text class="live-text">{{recording ? (liveText || "直接说就行，我会帮您记下来") : (liveText || latestTranscriptText || assistantPromptText || (followUpLoading ? "小余正在准备第一句话" : "点下方“我来说一段”"))}}</text>
    <view class="capture-strip {{recording ? 'active' : ''}}">
      <view class="capture-dot"></view>
      <text wx:if="{{recording}}">已说 {{captureDurationText}}</text>
      <text wx:else>说完后点“说完了”，我会帮您整理成文字。</text>
      <text wx:if="{{recording && liveCharCount}}">本句 {{liveCharCount}} 字</text>
    </view>
    <button
      wx:if="{{recording && !liveText && canRequestFollowUp}}"
      class="inline-help-button"
      loading="{{followUpLoading}}"
      disabled="{{followUpLoading}}"
      bindtap="stopAndAskFollowUp"
    >
      不知道讲什么，让小余问一句
    </button>
    <view wx:if="{{recording}}" class="voice-activity">
      <view class="level-track">
        <view class="level-fill" style="width: {{audioLevelPercent}}%;"></view>
      </view>
    </view>
  </view>

  <view class="history-panel">
    <view class="history-header">
      <text>本次讲述</text>
      <text class="history-count">{{transcriptLines.length}} 段 · {{totalTranscriptCharCount}} 字</text>
    </view>
    <view wx:if="{{!transcriptLines.length}}" class="empty-state">
      <text>一句话说完后，会在这里保存下来。</text>
    </view>
    <view wx:for="{{transcriptLines}}" wx:key="id" class="transcript-line {{item.role === 'assistant' ? 'assistant' : 'user'}}">
      <text class="line-role">{{item.role === 'assistant' ? '小余' : '我'}}</text>
      <text>{{item.text}}</text>
    </view>
  </view>

  <view class="control-bar">
    <text class="control-hint">{{recording ? "说完请点这里" : ((followUpLoading && !assistantPromptText) ? "小余先问一句，稍等一下。" : ((followUpLoading || followUpTTSLoading || followUpTTSPlaying) ? "点这里就可以开始说" : "说一两句也可以，我会帮您记下来。"))}}</text>
    <button
      class="mic-button {{recording ? 'recording' : ''}}"
      loading="{{connecting}}"
      disabled="{{connecting || !voiceAuthorizationAgreed}}"
      bindtap="toggleRecording"
    >
      <image class="mic-icon" src="/assets/memoir-microphone.png" mode="aspectFit" />
      <text>{{!voiceAuthorizationAgreed ? "同意后开始说话" : (connecting ? "正在准备" : (recording ? "说完了，帮我整理" : ((followUpLoading || followUpTTSLoading || followUpTTSPlaying) ? "我来讲了" : (primaryActionText === "开始说话" ? "我来说一段" : (primaryActionText === "继续说话" ? "继续讲" : primaryActionText)))))}}</text>
    </button>
  </view>
</view>
