.voice-chat-page {
  min-height: 100vh;
  padding: 34rpx 34rpx 180rpx;
  background: #f7fbf9;
}

.top-bar {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.mode-label {
  display: block;
  color: #1f352e;
  font-size: 40rpx;
  font-weight: 800;
}

.status-label {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #e9f6f1;
  color: #2e7d6b;
  font-size: 24rpx;
  font-weight: 800;
}

.status-label.error {
  background: #fff1f2;
  color: #be123c;
}

.status-label.listening {
  background: #fff1ec;
  color: #9f4a3c;
}

.finish-button {
  width: 136rpx;
  height: 72rpx;
  margin: 0;
  border: 0;
  border-radius: 20rpx;
  background: #ffffff;
  color: #9f4a3c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 22rpx rgba(37, 73, 62, 0.08);
}

.finish-button::after {
  border: 0;
}

.transcript-stage {
  min-height: 520rpx;
  margin-top: 38rpx;
  padding: 44rpx 34rpx;
  border: 2rpx solid #d6e7df;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(37, 73, 62, 0.08);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.stage-eyebrow {
  color: #2e7d6b;
  font-size: 28rpx;
  font-weight: 800;
}

.live-text {
  display: block;
  margin-top: 30rpx;
  color: #17221f;
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1.38;
  word-break: break-all;
}

.history-panel {
  margin-top: 30rpx;
  padding: 30rpx;
  border: 2rpx solid #d6e7df;
  border-radius: 24rpx;
  background: #ffffff;
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #1f352e;
  font-size: 32rpx;
  font-weight: 800;
}

.history-count {
  color: #2e7d6b;
}

.empty-state {
  margin-top: 22rpx;
  color: #5f6d69;
  font-size: 28rpx;
  line-height: 1.5;
}

.transcript-line {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f2fbf7;
  color: #17221f;
  font-size: 32rpx;
  line-height: 1.55;
}

.control-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx 34rpx 44rpx;
  background: rgba(247, 251, 249, 0.94);
  border-top: 2rpx solid #d6e7df;
}

.mic-button {
  height: 116rpx;
  margin: 0;
  border: 0;
  border-radius: 32rpx;
  background: #2e7d6b;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  font-size: 36rpx;
  font-weight: 800;
}

.mic-button.recording {
  background: #9f4a3c;
}

.mic-button::after {
  border: 0;
}

.mic-button[disabled] {
  opacity: 0.72;
}

.mic-icon {
  width: 54rpx;
  height: 54rpx;
}

.error {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #fff1f2;
  color: #be123c;
  font-size: 26rpx;
  line-height: 1.5;
}
