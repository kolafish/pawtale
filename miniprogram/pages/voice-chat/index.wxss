.voice-chat-page {
  min-height: 100vh;
  padding: 34rpx 32rpx 340rpx;
  background: #fcf7ed;
}

.top-bar {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.top-copy {
  min-width: 0;
}

.mode-label {
  display: block;
  color: #2b1713;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 52rpx;
}

.top-subtitle {
  display: block;
  margin-top: 4rpx;
  color: #7b6f68;
  font-size: 26rpx;
  line-height: 38rpx;
}

.topic-panel {
  margin-top: 18rpx;
  padding: 32rpx;
  border: 1rpx solid #e8d8c3;
  border-radius: 24rpx;
  background: #fff9f3;
  box-shadow: 0 6rpx 20rpx rgba(93, 61, 42, 0.06);
}

.topic-kicker {
  display: block;
  color: #7b6f68;
  font-size: 26rpx;
  line-height: 38rpx;
}

.topic-title {
  display: block;
  margin-top: 8rpx;
  color: #2b1713;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 52rpx;
  word-break: break-word;
}

.status-label {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eef4ea;
  color: #5f7e55;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.status-label.error {
  background: #fff1f3;
  color: #b84a5a;
}

.status-label.listening {
  background: #fff3ef;
  color: #a64b3e;
}

.finish-button {
  width: 136rpx;
  height: 72rpx;
  margin: 0;
  border: 0;
  border-radius: 22rpx;
  background: #ffffff;
  color: #7b4a40;
  border: 1rpx solid #d8c4b2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 18rpx rgba(93, 61, 42, 0.05);
}

.finish-button::after {
  border: 0;
}

.transcript-stage {
  min-height: 460rpx;
  margin-top: 28rpx;
  padding: 40rpx 32rpx;
  border: 1rpx solid #e8d8c3;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(93, 61, 42, 0.06);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.assistant-panel {
  margin-top: 24rpx;
  padding: 32rpx;
  border: 1rpx solid #e5cdbb;
  border-radius: 24rpx;
  background: #fff9f3;
  box-shadow: 0 6rpx 20rpx rgba(93, 61, 42, 0.06);
}

.assistant-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.assistant-label {
  color: #7b6f68;
  font-size: 28rpx;
  font-weight: 600;
}

.assistant-state {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f3efea;
  color: #7a6b60;
  font-size: 23rpx;
  font-weight: 600;
}

.assistant-text {
  display: block;
  margin-top: 18rpx;
  color: #2b1713;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.42;
  word-break: break-word;
}

.assistant-tts-text {
  display: block;
  margin-top: 18rpx;
  color: #2b1713;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.42;
  word-break: break-word;
}

.assistant-tts-spoken {
  color: #a64b3e;
}

.assistant-tts-current {
  margin: 0 2rpx;
  padding: 2rpx 6rpx;
  border-radius: 8rpx;
  background: #a64b3e;
  color: #ffffff;
}

.tts-strip {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #7b6f68;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.tts-strip.error {
  background: #fff1f3;
  color: #b84a5a;
}

.tts-progress-track {
  flex: 0 0 160rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #f0e5d8;
  overflow: hidden;
}

.tts-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: #a64b3e;
  transition: width 160ms ease;
}

.assistant-actions {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  flex-wrap: wrap;
}

.assistant-button {
  min-width: 168rpx;
  height: 80rpx;
  margin: 0;
  border: 0;
  border-radius: 22rpx;
  background: #ffffff;
  color: #7b4a40;
  border: 1rpx solid #d8c4b2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
}

.assistant-button::after {
  border: 0;
}

.assistant-button[disabled] {
  opacity: 0.66;
}

.assistant-button.ghost {
  background: #f8e8e2;
  border-color: transparent;
  color: #8f3e35;
}

.assistant-panel.error-state {
  border-color: #f3c4cc;
  background: #fff1f3;
}

.assistant-panel.error-state .assistant-label,
.assistant-panel.error-state .assistant-state,
.assistant-panel.error-state .assistant-text {
  color: #b84a5a;
}

.stage-eyebrow {
  color: #a64b3e;
  font-size: 28rpx;
  font-weight: 600;
}

.live-text {
  display: block;
  margin-top: 30rpx;
  color: #2b1713;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.38;
  word-break: break-all;
}

.capture-strip {
  margin-top: 34rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #fff3ef;
  color: #7b6f68;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.capture-strip.active {
  color: #a64b3e;
}

.capture-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #c7b2a0;
}

.capture-strip.active .capture-dot {
  background: #a64b3e;
  box-shadow: 0 0 0 10rpx rgba(166, 75, 62, 0.12);
}

.voice-activity {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.level-track {
  flex: 1 1 220rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #f0e5d8;
  overflow: hidden;
}

.level-fill {
  height: 100%;
  border-radius: inherit;
  background: #a64b3e;
  transition: width 120ms ease;
}

.auto-stop-text {
  color: #7b4a40;
  font-size: 24rpx;
  font-weight: 800;
}

.auto-listen-text {
  color: #a64b3e;
  font-size: 24rpx;
  font-weight: 800;
}

.auto-stop-toggle {
  min-width: 92rpx;
  height: 56rpx;
  margin: 0;
  border: 0;
  border-radius: 16rpx;
  background: #fff3ef;
  color: #a64b3e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 800;
}

.auto-stop-toggle::after {
  border: 0;
}

.history-panel {
  margin-top: 30rpx;
  padding: 32rpx;
  border: 1rpx solid #e8d8c3;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(93, 61, 42, 0.06);
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #2b1713;
  font-size: 32rpx;
  font-weight: 700;
}

.history-count {
  color: #8b6a55;
}

.empty-state {
  margin-top: 22rpx;
  color: #7b6f68;
  font-size: 28rpx;
  line-height: 1.5;
}

.transcript-line {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff9f3;
  color: #3a2a25;
  font-size: 32rpx;
  line-height: 1.55;
}

.transcript-line.assistant {
  background: #ffffff;
  border: 1rpx solid #e8d8c3;
}

.line-role {
  display: inline-flex;
  min-width: 70rpx;
  height: 42rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #a64b3e;
  color: #ffffff;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.transcript-line.assistant .line-role {
  background: #f3efea;
  color: #7a6b60;
}

.control-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 26rpx 32rpx 42rpx;
  background: rgba(252, 247, 237, 0.96);
  border-top: 1rpx solid #efe6da;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mic-button {
  width: 220rpx;
  height: 220rpx;
  margin: 0;
  border: 0;
  border-radius: 110rpx;
  background: #fff3ef;
  color: #a64b3e;
  border: 2rpx solid #e7cabb;
  box-shadow: 0 12rpx 36rpx rgba(166, 75, 62, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.mic-button.recording {
  background: #a64b3e;
  color: #ffffff;
  border-color: #a64b3e;
}

.mic-button::after {
  border: 0;
}

.mic-button[disabled] {
  opacity: 0.72;
}

.mic-icon {
  width: 72rpx;
  height: 72rpx;
}

.control-hint {
  display: block;
  margin-top: 18rpx;
  color: #7b6f68;
  font-size: 26rpx;
  line-height: 38rpx;
  text-align: center;
}

.error {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #fff1f3;
  color: #b84a5a;
  font-size: 26rpx;
  line-height: 1.5;
}

.session-state-strip {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  color: #a64b3e;
  font-size: 24rpx;
  font-weight: 800;
}

.session-state-strip text {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff3ef;
}

.session-state-strip .session-state-error {
  background: #fff1f3;
  color: #b84a5a;
}

.recovery-panel {
  margin-top: 18rpx;
  padding: 22rpx;
  border: 2rpx solid #e8d8c3;
  border-radius: 18rpx;
  background: #fff9f3;
}

.recovery-text {
  display: block;
  color: #7b4a40;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.45;
}

.recovery-actions {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.recovery-button {
  min-width: 160rpx;
  height: 64rpx;
  margin: 0;
  border: 0;
  border-radius: 16rpx;
  background: #a64b3e;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 800;
}

.recovery-button.ghost {
  background: #ffffff;
  color: #a64b3e;
}

.recovery-button::after {
  border: 0;
}

.voice-auth-panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 2rpx solid #e4c6b3;
  border-radius: 22rpx;
  background: #fff9f3;
}

.voice-auth-title {
  display: block;
  color: #7b4a40;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.voice-auth-desc {
  display: block;
  margin-top: 12rpx;
  color: #7b6f68;
  font-size: 26rpx;
  line-height: 1.5;
}

.voice-auth-row {
  margin-top: 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.voice-auth-copy {
  flex: 1;
  min-width: 0;
  color: #2b1713;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
}

.voice-auth-link {
  color: #a64b3e;
}
