.voice-chat-page {
  min-height: 100vh;
  padding: 34rpx 34rpx 180rpx;
  background: #fffaf2;
}

.top-bar {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.mode-label {
  display: block;
  color: #24100b;
  font-size: 40rpx;
  font-weight: 800;
}

.status-label {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff1ec;
  color: #9f4a3c;
  font-size: 24rpx;
  font-weight: 800;
}

.status-label.error {
  background: #fff1f2;
  color: #be123c;
}

.status-label.listening {
  background: #fff6f1;
  color: #9f4a3c;
}

.finish-button {
  width: 136rpx;
  height: 72rpx;
  margin: 0;
  border: 0;
  border-radius: 20rpx;
  background: #ffffff;
  color: #9f4a3c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 22rpx rgba(64, 43, 24, 0.08);
}

.finish-button::after {
  border: 0;
}

.transcript-stage {
  min-height: 460rpx;
  margin-top: 28rpx;
  padding: 44rpx 34rpx;
  border: 2rpx solid #f0dac0;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(64, 43, 24, 0.08);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.assistant-panel {
  margin-top: 24rpx;
  padding: 30rpx;
  border: 2rpx solid #e4c6b3;
  border-radius: 24rpx;
  background: #fff6f1;
  box-shadow: 0 12rpx 32rpx rgba(64, 43, 24, 0.07);
}

.assistant-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.assistant-label {
  color: #7a3b31;
  font-size: 28rpx;
  font-weight: 800;
}

.assistant-state {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #9f4a3c;
  font-size: 23rpx;
  font-weight: 800;
}

.assistant-text {
  display: block;
  margin-top: 18rpx;
  color: #24100b;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.42;
  word-break: break-word;
}

.assistant-tts-text {
  display: block;
  margin-top: 18rpx;
  color: #24100b;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.42;
  word-break: break-word;
}

.assistant-tts-spoken {
  color: #b85c45;
}

.assistant-tts-current {
  margin: 0 2rpx;
  padding: 2rpx 6rpx;
  border-radius: 8rpx;
  background: #9f4a3c;
  color: #ffffff;
}

.tts-strip {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #7a3b31;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.tts-strip.error {
  background: #fff1f2;
  color: #be123c;
}

.tts-progress-text {
  color: #9f4a3c;
}

.assistant-actions {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  flex-wrap: wrap;
}

.assistant-button {
  min-width: 168rpx;
  height: 70rpx;
  margin: 0;
  border: 0;
  border-radius: 18rpx;
  background: #ffffff;
  color: #9f4a3c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
}

.assistant-button::after {
  border: 0;
}

.assistant-button[disabled] {
  opacity: 0.66;
}

.assistant-button.ghost {
  background: transparent;
  color: #7a3b31;
}

.assistant-panel.error-state {
  border-color: #ffd1dc;
  background: #fff1f2;
}

.assistant-panel.error-state .assistant-label,
.assistant-panel.error-state .assistant-state,
.assistant-panel.error-state .assistant-text {
  color: #be123c;
}

.stage-eyebrow {
  color: #9f4a3c;
  font-size: 28rpx;
  font-weight: 800;
}

.live-text {
  display: block;
  margin-top: 30rpx;
  color: #24100b;
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1.38;
  word-break: break-all;
}

.capture-strip {
  margin-top: 34rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #fff6f1;
  color: #685b55;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.capture-strip.active {
  color: #9f4a3c;
}

.capture-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #c7b2a0;
}

.capture-strip.active .capture-dot {
  background: #b85c45;
  box-shadow: 0 0 0 10rpx rgba(184, 92, 69, 0.12);
}

.capture-metrics {
  margin-left: auto;
  color: #9f4a3c;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 10rpx 16rpx;
}

.voice-activity {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.level-track {
  flex: 1 1 220rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #f7e7d7;
  overflow: hidden;
}

.level-fill {
  height: 100%;
  border-radius: inherit;
  background: #b85c45;
  transition: width 120ms ease;
}

.auto-stop-text {
  color: #7a3b31;
  font-size: 24rpx;
  font-weight: 800;
}

.auto-listen-text {
  color: #9f4a3c;
  font-size: 24rpx;
  font-weight: 800;
}

.auto-stop-toggle {
  min-width: 92rpx;
  height: 56rpx;
  margin: 0;
  border: 0;
  border-radius: 16rpx;
  background: #fff1ec;
  color: #9f4a3c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 800;
}

.auto-stop-toggle::after {
  border: 0;
}

.history-panel {
  margin-top: 30rpx;
  padding: 30rpx;
  border: 2rpx solid #f0dac0;
  border-radius: 24rpx;
  background: #ffffff;
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #24100b;
  font-size: 32rpx;
  font-weight: 800;
}

.history-count {
  color: #9f4a3c;
}

.empty-state {
  margin-top: 22rpx;
  color: #685b55;
  font-size: 28rpx;
  line-height: 1.5;
}

.transcript-line {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff6f1;
  color: #24100b;
  font-size: 32rpx;
  line-height: 1.55;
}

.transcript-line.assistant {
  background: #ffffff;
  border: 2rpx solid #f0dac0;
}

.line-role {
  display: inline-flex;
  min-width: 52rpx;
  height: 42rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #9f4a3c;
  color: #ffffff;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.transcript-line.assistant .line-role {
  background: #fff1ec;
  color: #9f4a3c;
}

.control-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx 34rpx 44rpx;
  background: rgba(251, 247, 245, 0.94);
  border-top: 2rpx solid #f0dac0;
}

.mic-button {
  height: 116rpx;
  margin: 0;
  border: 0;
  border-radius: 32rpx;
  background: #9f4a3c;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  font-size: 36rpx;
  font-weight: 800;
}

.mic-button.recording {
  background: #b85c45;
}

.mic-button::after {
  border: 0;
}

.mic-button[disabled] {
  opacity: 0.72;
}

.mic-icon {
  width: 54rpx;
  height: 54rpx;
}

.error {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #fff1f2;
  color: #be123c;
  font-size: 26rpx;
  line-height: 1.5;
}

.diagnostic-strip {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  color: #9f4a3c;
  font-size: 24rpx;
  font-weight: 800;
}

.diagnostic-strip text {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff1ec;
}

.diagnostic-strip .diagnostic-error {
  background: #fff1f2;
  color: #be123c;
}

.diagnostic-strip .diagnostic-count {
  background: #ffffff;
  color: #7a3b31;
}

.diagnostic-copy {
  width: 144rpx;
  height: 54rpx;
  margin: 0;
  border: 0;
  border-radius: 16rpx;
  background: #ffffff;
  color: #9f4a3c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1;
}

.diagnostic-copy::after {
  border: 0;
}

.recovery-panel {
  margin-top: 18rpx;
  padding: 22rpx;
  border: 2rpx solid #efd6c4;
  border-radius: 18rpx;
  background: #fff6f1;
}

.recovery-text {
  display: block;
  color: #7a3b31;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.45;
}

.recovery-actions {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.recovery-button {
  min-width: 160rpx;
  height: 64rpx;
  margin: 0;
  border: 0;
  border-radius: 16rpx;
  background: #9f4a3c;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 800;
}

.recovery-button.ghost {
  background: #ffffff;
  color: #9f4a3c;
}

.recovery-button::after {
  border: 0;
}

.voice-auth-panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 2rpx solid #e4c6b3;
  border-radius: 22rpx;
  background: #fff6f1;
}

.voice-auth-title {
  display: block;
  color: #7a3b31;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.voice-auth-desc {
  display: block;
  margin-top: 12rpx;
  color: #685b55;
  font-size: 26rpx;
  line-height: 1.5;
}

.voice-auth-row {
  margin-top: 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.voice-auth-copy {
  flex: 1;
  min-width: 0;
  color: #24100b;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
}

.voice-auth-link {
  color: #9f4a3c;
}
