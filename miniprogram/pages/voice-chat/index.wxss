.voice-chat-page {
  min-height: 100vh;
  padding: 34rpx 30rpx 350rpx;
  background: #fcf7ed;
}

.top-bar {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.top-copy {
  min-width: 0;
}

.mode-label {
  display: block;
  color: #2b1713;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 58rpx;
}

.top-subtitle {
  display: block;
  margin-top: 4rpx;
  color: #7b6f68;
  font-size: 30rpx;
  line-height: 42rpx;
}

.topic-panel {
  margin-top: 18rpx;
  padding: 32rpx 34rpx;
  border: 0;
  border-radius: 30rpx;
  background: #fff9f3;
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.06),
    0 10rpx 26rpx rgba(93, 61, 42, 0.07);
}

.topic-kicker {
  display: block;
  color: #7b6f68;
  font-size: 30rpx;
  line-height: 42rpx;
}

.topic-title {
  display: block;
  margin-top: 8rpx;
  color: #2b1713;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 58rpx;
  word-break: break-word;
}

.finish-button {
  width: 156rpx;
  height: 78rpx;
  margin: 0;
  border: 0;
  border-radius: 24rpx;
  background: #ffffff;
  color: #7b4a40;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.08),
    0 6rpx 18rpx rgba(93, 61, 42, 0.05);
}

.finish-button::after {
  border: 0;
}

.transcript-stage {
  min-height: 440rpx;
  margin-top: 28rpx;
  padding: 40rpx 34rpx;
  border: 0;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.06),
    0 8rpx 18rpx -6rpx rgba(43, 23, 19, 0.10),
    0 22rpx 50rpx rgba(93, 61, 42, 0.08);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.assistant-panel {
  margin-top: 24rpx;
  padding: 34rpx;
  border: 0;
  border-radius: 32rpx;
  background: #fff9f3;
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.06),
    0 10rpx 26rpx rgba(93, 61, 42, 0.07);
}

.assistant-head {
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.assistant-label {
  display: inline-flex;
  align-items: center;
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #eef4ea;
  color: #5f7e55;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 38rpx;
}

.assistant-text {
  display: block;
  margin-top: 22rpx;
  color: #2b1713;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.48;
  word-break: break-word;
}

.assistant-tts-text {
  display: block;
  margin-top: 22rpx;
  color: #2b1713;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.48;
  word-break: break-word;
}

.assistant-opening {
  margin-top: 18rpx;
}

.assistant-context {
  display: block;
  color: #7b6f68;
  font-size: 30rpx;
  line-height: 1.55;
}

.assistant-question {
  display: block;
  margin-top: 18rpx;
  color: #2b1713;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.35;
}

.assistant-topic-options {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.assistant-topic-button {
  min-height: 68rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 999rpx;
  background: #ffffff;
  color: #7b4a40;
  box-shadow: 0 0 0 1rpx rgba(43, 23, 19, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.assistant-topic-button::after {
  border: 0;
}

.assistant-tts-spoken {
  color: #a64b3e;
}

.assistant-tts-current {
  margin: 0 2rpx;
  padding: 2rpx 6rpx;
  border-radius: 8rpx;
  background: #a64b3e;
  color: #ffffff;
}

.tts-progress-track {
  margin-top: 18rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #f0e5d8;
  overflow: hidden;
}

.tts-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: #a64b3e;
  transition: width 160ms ease;
}

.tts-error {
  display: block;
  margin-top: 16rpx;
  color: #b84a5a;
  font-size: 28rpx;
  line-height: 1.4;
}

.assistant-actions {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  flex-wrap: wrap;
}

.assistant-button {
  min-width: 180rpx;
  min-height: 86rpx;
  margin: 0;
  border: 0;
  border-radius: 24rpx;
  background: #ffffff;
  color: #7b4a40;
  box-shadow: 0 0 0 1rpx rgba(43, 23, 19, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 38rpx;
}

.assistant-button::after {
  border: 0;
}

.assistant-button[disabled] {
  opacity: 0.66;
}

.assistant-button.ghost {
  background: #f8e8e2;
  box-shadow: none;
  color: #8f3e35;
}

.assistant-panel.error-state {
  background: #fff1f3;
  box-shadow:
    0 0 0 1rpx rgba(184, 74, 90, 0.12),
    0 10rpx 26rpx rgba(184, 74, 90, 0.06);
}

.assistant-panel.error-state .assistant-label,
.assistant-panel.error-state .assistant-text {
  color: #b84a5a;
}

.stage-status {
  display: inline-flex;
  align-self: flex-start;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eef4ea;
  color: #5f7e55;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.stage-status.error {
  background: #fff1f3;
  color: #b84a5a;
}

.stage-status.listening {
  background: #fff3ef;
  color: #a64b3e;
}

.live-text {
  display: block;
  margin-top: 32rpx;
  color: #2b1713;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.42;
  word-break: break-all;
}

.capture-strip {
  margin-top: 34rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #fff3ef;
  color: #7b6f68;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.capture-strip.active {
  color: #a64b3e;
}

.capture-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #c7b2a0;
}

.capture-strip.active .capture-dot {
  background: #a64b3e;
  box-shadow: 0 0 0 10rpx rgba(166, 75, 62, 0.12);
}

.voice-activity {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.inline-help-button {
  align-self: flex-start;
  min-height: 76rpx;
  margin: 22rpx 0 0;
  border: 0;
  border-radius: 999rpx;
  background: #fff3ef;
  color: #8f3e35;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.inline-help-button::after {
  border: 0;
}

.level-track {
  flex: 1 1 220rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #f0e5d8;
  overflow: hidden;
}

.level-fill {
  height: 100%;
  border-radius: inherit;
  background: #a64b3e;
  transition: width 120ms ease;
}

.auto-stop-text {
  color: #7b4a40;
  font-size: 28rpx;
  font-weight: 800;
}

.auto-listen-text {
  color: #a64b3e;
  font-size: 28rpx;
  font-weight: 800;
}

.auto-stop-toggle {
  min-width: 92rpx;
  height: 56rpx;
  margin: 0;
  border: 0;
  border-radius: 16rpx;
  background: #fff3ef;
  color: #a64b3e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 800;
}

.auto-stop-toggle::after {
  border: 0;
}

.history-panel {
  margin-top: 30rpx;
  padding: 34rpx;
  border: 0;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.06),
    0 10rpx 26rpx rgba(93, 61, 42, 0.06);
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #2b1713;
  font-size: 34rpx;
  font-weight: 700;
}

.history-count {
  color: #8b6a55;
  font-variant-numeric: tabular-nums;
}

.empty-state {
  margin-top: 22rpx;
  color: #7b6f68;
  font-size: 30rpx;
  line-height: 1.5;
}

.transcript-line {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff9f3;
  color: #3a2a25;
  font-size: 34rpx;
  line-height: 1.55;
}

.transcript-line.assistant {
  background: #ffffff;
  box-shadow: 0 0 0 1rpx rgba(43, 23, 19, 0.06);
}

.line-role {
  display: inline-flex;
  min-width: 70rpx;
  height: 42rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #a64b3e;
  color: #ffffff;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.transcript-line.assistant .line-role {
  background: #f3efea;
  color: #7a6b60;
}

.control-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 26rpx 32rpx 42rpx;
  background: rgba(252, 247, 237, 0.96);
  box-shadow: 0 -1rpx 0 rgba(43, 23, 19, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mic-button {
  width: 100%;
  max-width: 620rpx;
  min-height: 118rpx;
  margin: 0;
  border: 0;
  border-radius: 999rpx;
  background: #fff3ef;
  color: #a64b3e;
  box-shadow:
    0 0 0 2rpx rgba(166, 75, 62, 0.16),
    0 12rpx 36rpx rgba(166, 75, 62, 0.12);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 22rpx 30rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 46rpx;
}

.mic-button.recording {
  background: #a64b3e;
  color: #ffffff;
  box-shadow:
    0 0 0 1rpx rgba(255, 255, 255, 0.18) inset,
    0 12rpx 36rpx rgba(166, 75, 62, 0.18);
}

.mic-button::after {
  border: 0;
}

.mic-button[disabled] {
  opacity: 0.72;
}

.mic-icon-shell {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: rgba(166, 75, 62, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mic-button.recording .mic-icon-shell {
  background: rgba(255, 255, 255, 0.18);
}

.mic-icon {
  width: 48rpx;
  height: 48rpx;
}

.control-hint {
  display: block;
  margin: 0 0 14rpx;
  color: #7b6f68;
  font-size: 30rpx;
  line-height: 42rpx;
  text-align: center;
}

.error {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #fff1f3;
  color: #b84a5a;
  font-size: 28rpx;
  line-height: 1.5;
}

.session-state-strip {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  color: #a64b3e;
  font-size: 28rpx;
  font-weight: 800;
}

.session-state-strip text {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff3ef;
}

.session-state-strip .session-state-error {
  background: #fff1f3;
  color: #b84a5a;
}

.recovery-panel {
  margin-top: 18rpx;
  padding: 22rpx;
  border: 0;
  border-radius: 18rpx;
  background: #fff9f3;
  box-shadow: 0 0 0 1rpx rgba(43, 23, 19, 0.08);
}

.recovery-text {
  display: block;
  color: #7b4a40;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
}

.recovery-actions {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.recovery-button {
  min-width: 160rpx;
  height: 64rpx;
  margin: 0;
  border: 0;
  border-radius: 16rpx;
  background: #a64b3e;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
}

.recovery-button.ghost {
  background: #ffffff;
  color: #a64b3e;
}

.recovery-button::after {
  border: 0;
}

.voice-auth-panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 0;
  border-radius: 28rpx;
  background: #fff9f3;
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.08),
    0 8rpx 20rpx rgba(93, 61, 42, 0.05);
}

.voice-auth-title {
  display: block;
  color: #7b4a40;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.voice-auth-desc {
  display: block;
  margin-top: 12rpx;
  color: #7b6f68;
  font-size: 30rpx;
  line-height: 1.5;
}

.voice-auth-row {
  margin-top: 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.voice-auth-copy {
  flex: 1;
  min-width: 0;
  color: #2b1713;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
}

.voice-auth-link {
  color: #a64b3e;
}
