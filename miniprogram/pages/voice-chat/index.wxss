.voice-chat-page {
  min-height: 100vh;
  padding: 34rpx 34rpx 180rpx;
  background: #fffaf2;
}

.top-bar {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.mode-label {
  display: block;
  color: #24100b;
  font-size: 40rpx;
  font-weight: 800;
}

.status-label {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff1ec;
  color: #9f4a3c;
  font-size: 24rpx;
  font-weight: 800;
}

.status-label.error {
  background: #fff1f2;
  color: #be123c;
}

.status-label.listening {
  background: #fff6f1;
  color: #9f4a3c;
}

.finish-button {
  width: 136rpx;
  height: 72rpx;
  margin: 0;
  border: 0;
  border-radius: 20rpx;
  background: #ffffff;
  color: #9f4a3c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 22rpx rgba(64, 43, 24, 0.08);
}

.finish-button::after {
  border: 0;
}

.transcript-stage {
  min-height: 520rpx;
  margin-top: 38rpx;
  padding: 44rpx 34rpx;
  border: 2rpx solid #f0dac0;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(64, 43, 24, 0.08);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.stage-eyebrow {
  color: #9f4a3c;
  font-size: 28rpx;
  font-weight: 800;
}

.live-text {
  display: block;
  margin-top: 30rpx;
  color: #24100b;
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1.38;
  word-break: break-all;
}

.capture-strip {
  margin-top: 34rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #fff6f1;
  color: #685b55;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.capture-strip.active {
  color: #9f4a3c;
}

.capture-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #c7b2a0;
}

.capture-strip.active .capture-dot {
  background: #b85c45;
  box-shadow: 0 0 0 10rpx rgba(184, 92, 69, 0.12);
}

.capture-metrics {
  margin-left: auto;
  color: #9f4a3c;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 10rpx 16rpx;
}

.history-panel {
  margin-top: 30rpx;
  padding: 30rpx;
  border: 2rpx solid #f0dac0;
  border-radius: 24rpx;
  background: #ffffff;
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #24100b;
  font-size: 32rpx;
  font-weight: 800;
}

.history-count {
  color: #9f4a3c;
}

.empty-state {
  margin-top: 22rpx;
  color: #685b55;
  font-size: 28rpx;
  line-height: 1.5;
}

.transcript-line {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff6f1;
  color: #24100b;
  font-size: 32rpx;
  line-height: 1.55;
}

.control-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx 34rpx 44rpx;
  background: rgba(251, 247, 245, 0.94);
  border-top: 2rpx solid #f0dac0;
}

.mic-button {
  height: 116rpx;
  margin: 0;
  border: 0;
  border-radius: 32rpx;
  background: #9f4a3c;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  font-size: 36rpx;
  font-weight: 800;
}

.mic-button.recording {
  background: #b85c45;
}

.mic-button::after {
  border: 0;
}

.mic-button[disabled] {
  opacity: 0.72;
}

.mic-icon {
  width: 54rpx;
  height: 54rpx;
}

.error {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #fff1f2;
  color: #be123c;
  font-size: 26rpx;
  line-height: 1.5;
}

.diagnostic-strip {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  color: #9f4a3c;
  font-size: 24rpx;
  font-weight: 800;
}

.diagnostic-strip text {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff1ec;
}

.diagnostic-strip .diagnostic-error {
  background: #fff1f2;
  color: #be123c;
}
