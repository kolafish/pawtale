.voice-chat-page {
  min-height: 100vh;
  padding: 34rpx 30rpx 350rpx;
  background: #fcf7ed;
}

.voice-chat-page.no-control-bar {
  padding-bottom: 60rpx;
}

.voice-chat-page.ai-recording-focus {
  padding-bottom: 360rpx;
}

.voice-chat-page.human-recording-focus {
  padding-bottom: 330rpx;
}

.voice-chat-page.large-text.human-recording-focus {
  padding-bottom: 380rpx;
}

.top-bar {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.top-copy {
  min-width: 0;
}

.mode-label {
  display: block;
  color: #2b1713;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 58rpx;
}

.top-subtitle {
  display: block;
  margin-top: 4rpx;
  color: #7b6f68;
  font-size: 30rpx;
  line-height: 42rpx;
}

.topic-panel {
  margin-top: 18rpx;
  padding: 32rpx 34rpx;
  border: 0;
  border-radius: 30rpx;
  background: #fff9f3;
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.06),
    0 10rpx 26rpx rgba(93, 61, 42, 0.07);
}

.topic-kicker {
  display: block;
  color: #7b6f68;
  font-size: 30rpx;
  line-height: 42rpx;
}

.topic-title {
  display: block;
  margin-top: 8rpx;
  color: #2b1713;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 58rpx;
  word-break: break-word;
}

.finish-button {
  width: 156rpx;
  height: 78rpx;
  margin: 0;
  border: 0;
  border-radius: 24rpx;
  background: #ffffff;
  color: #7b4a40;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.08),
    0 6rpx 18rpx rgba(93, 61, 42, 0.05);
}

.finish-button::after {
  border: 0;
}

.transcript-stage {
  min-height: 440rpx;
  margin-top: 28rpx;
  padding: 40rpx 34rpx;
  border: 0;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.06),
    0 8rpx 18rpx -6rpx rgba(43, 23, 19, 0.10),
    0 22rpx 50rpx rgba(93, 61, 42, 0.08);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.voice-chat-page.human-interview .transcript-stage {
  justify-content: flex-start;
}

.voice-chat-page.human-recording-focus .transcript-stage {
  min-height: 900rpx;
  padding-top: 52rpx;
  padding-bottom: 40rpx;
}

.voice-chat-page.ai-recording-focus .transcript-stage {
  min-height: 820rpx;
  padding: 44rpx 36rpx;
  border-radius: 36rpx;
  justify-content: flex-start;
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.06),
    0 14rpx 28rpx -8rpx rgba(43, 23, 19, 0.12),
    0 30rpx 68rpx rgba(93, 61, 42, 0.11);
}

.assistant-panel {
  margin-top: 24rpx;
  padding: 34rpx;
  border: 0;
  border-radius: 32rpx;
  background: #fff9f3;
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.06),
    0 10rpx 26rpx rgba(93, 61, 42, 0.07);
}

.assistant-head {
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.assistant-label {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f6eee5;
  color: #7b4a40;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 38rpx;
}

.assistant-text {
  display: block;
  margin-top: 22rpx;
  color: #2b1713;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.48;
  word-break: break-word;
}

.assistant-tts-text {
  display: block;
  margin-top: 22rpx;
  color: #2b1713;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.48;
  word-break: break-word;
}

.assistant-opening {
  margin-top: 18rpx;
}

.assistant-context {
  display: block;
  color: #7b6f68;
  font-size: 30rpx;
  line-height: 1.55;
}

.assistant-question {
  display: block;
  margin-top: 18rpx;
  color: #2b1713;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.35;
}

.assistant-topic-options {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.assistant-topic-button {
  min-height: 68rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 999rpx;
  background: #ffffff;
  color: #7b4a40;
  box-shadow: 0 0 0 1rpx rgba(43, 23, 19, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.assistant-topic-button::after {
  border: 0;
}

.assistant-tts-spoken {
  color: #a64b3e;
}

.assistant-tts-current {
  margin: 0 2rpx;
  padding: 2rpx 6rpx;
  border-radius: 8rpx;
  background: #a64b3e;
  color: #ffffff;
}

.tts-progress-track {
  margin-top: 18rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #f0e5d8;
  overflow: hidden;
}

.tts-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: #a64b3e;
  transition: width 160ms ease;
}

.tts-error {
  display: block;
  margin-top: 16rpx;
  color: #b84a5a;
  font-size: 28rpx;
  line-height: 1.4;
}

.assistant-actions {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  flex-wrap: wrap;
}

.assistant-button {
  min-width: 180rpx;
  min-height: 86rpx;
  margin: 0;
  border: 0;
  border-radius: 24rpx;
  background: #ffffff;
  color: #7b4a40;
  box-shadow: 0 0 0 1rpx rgba(43, 23, 19, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 38rpx;
}

.assistant-button::after {
  border: 0;
}

.assistant-button[disabled] {
  opacity: 0.66;
}

.assistant-button.ghost {
  background: #f8e8e2;
  box-shadow: none;
  color: #8f3e35;
}

.assistant-panel.error-state {
  background: #fff1f3;
  box-shadow:
    0 0 0 1rpx rgba(184, 74, 90, 0.12),
    0 10rpx 26rpx rgba(184, 74, 90, 0.06);
}

.assistant-panel.error-state .assistant-label,
.assistant-panel.error-state .assistant-text {
  color: #b84a5a;
}

.stage-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f6eee5;
  color: #7b4a40;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.stage-status.error {
  background: #fff1f3;
  color: #b84a5a;
}

.stage-status.listening {
  background: #fff3ef;
  color: #a64b3e;
}

.live-scroll {
  max-height: 300rpx;
  margin-top: 32rpx;
  overflow: hidden;
}

.voice-chat-page.human-interview .live-scroll {
  margin-top: 0;
}

.voice-chat-page.human-recording-focus .live-scroll,
.voice-chat-page.human-recording-focus .live-scroll.long {
  height: 650rpx;
  max-height: 650rpx;
}

.voice-chat-page.ai-recording-focus .live-scroll,
.voice-chat-page.ai-recording-focus .live-scroll.long {
  height: 620rpx;
  max-height: 620rpx;
}

.live-scroll.long {
  height: 300rpx;
}

.live-text {
  display: block;
  color: #2b1713;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.42;
  word-break: break-all;
  text-wrap: pretty;
}

.voice-chat-page.ai-recording-focus .live-text {
  font-size: 54rpx;
  line-height: 1.48;
}

.live-text.placeholder {
  color: #8a7b72;
  font-weight: 600;
}

.live-text-end {
  height: 2rpx;
}

.human-transcript-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 220rpx;
  box-sizing: border-box;
  padding: 28rpx 30rpx 24rpx;
  background: rgba(252, 247, 237, 0.96);
  z-index: 24;
  display: flex;
}

.human-transcript-sheet {
  flex: 1 1 auto;
  min-height: 0;
  padding: 42rpx 38rpx 28rpx;
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.06),
    0 20rpx 56rpx rgba(93, 61, 42, 0.16);
  display: flex;
  flex-direction: column;
}

.human-transcript-scroll {
  flex: 1 1 auto;
  min-height: 0;
  height: 100%;
  overflow: hidden;
}

.human-transcript-sheet .live-text {
  font-size: 58rpx;
  line-height: 1.45;
}

.human-transcript-footer {
  margin-top: 24rpx;
  min-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #fff3ef;
  color: #a64b3e;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.human-transcript-footer .capture-dot {
  background: #a64b3e;
  box-shadow: 0 0 0 10rpx rgba(166, 75, 62, 0.12);
}

.human-transcript-level {
  margin-top: 18rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #f0e5d8;
  overflow: hidden;
}

.capture-strip {
  margin-top: 34rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #fff3ef;
  color: #7b6f68;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.voice-chat-page.human-recording-focus .capture-strip {
  margin-top: 26rpx;
}

.voice-chat-page.ai-recording-focus .capture-strip {
  margin-top: 30rpx;
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
}

.capture-strip.active {
  color: #a64b3e;
}

.capture-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #c7b2a0;
}

.capture-strip.active .capture-dot {
  background: #a64b3e;
  box-shadow: 0 0 0 10rpx rgba(166, 75, 62, 0.12);
}

.voice-activity {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.inline-help-button {
  align-self: flex-start;
  min-height: 76rpx;
  margin: 22rpx 0 0;
  border: 0;
  border-radius: 999rpx;
  background: #fff3ef;
  color: #8f3e35;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.inline-help-button::after {
  border: 0;
}

.level-track {
  flex: 1 1 220rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #f0e5d8;
  overflow: hidden;
}

.level-fill {
  height: 100%;
  border-radius: inherit;
  background: #a64b3e;
  transition: width 120ms ease;
}

.auto-stop-text {
  color: #7b4a40;
  font-size: 28rpx;
  font-weight: 800;
}

.auto-listen-text {
  color: #a64b3e;
  font-size: 28rpx;
  font-weight: 800;
}

.auto-stop-toggle {
  min-width: 92rpx;
  height: 56rpx;
  margin: 0;
  border: 0;
  border-radius: 16rpx;
  background: #fff3ef;
  color: #a64b3e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 800;
}

.auto-stop-toggle::after {
  border: 0;
}

.history-panel {
  margin-top: 30rpx;
  padding: 34rpx;
  border: 0;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.06),
    0 10rpx 26rpx rgba(93, 61, 42, 0.06);
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #2b1713;
  font-size: 34rpx;
  font-weight: 700;
}

.history-count {
  color: #8b6a55;
  font-variant-numeric: tabular-nums;
}

.empty-state {
  margin-top: 22rpx;
  color: #7b6f68;
  font-size: 30rpx;
  line-height: 1.5;
}

.transcript-line {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff9f3;
  color: #3a2a25;
  font-size: 34rpx;
  line-height: 1.55;
}

.transcript-line.assistant {
  background: #ffffff;
  box-shadow: 0 0 0 1rpx rgba(43, 23, 19, 0.06);
}

.transcript-line.interviewer {
  background: #f4f7f8;
  color: #26353a;
  box-shadow: 0 0 0 1rpx rgba(38, 53, 58, 0.06);
}

.line-role {
  display: inline-flex;
  min-width: 70rpx;
  height: 42rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #a64b3e;
  color: #ffffff;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.transcript-line.assistant .line-role {
  background: #f3efea;
  color: #7a6b60;
}

.transcript-line.interviewer .line-role {
  background: #57727b;
  color: #ffffff;
}

.control-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  padding: 26rpx 32rpx 42rpx;
  background: rgba(252, 247, 237, 0.96);
  box-shadow: 0 -1rpx 0 rgba(43, 23, 19, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.human-record-panel {
  width: 100%;
  max-width: 660rpx;
  margin: 20rpx auto 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.role-record-button {
  box-sizing: border-box;
  min-height: 128rpx;
  margin: 0;
  border: 0;
  border-radius: 34rpx;
  background: #fff3ef;
  color: #a64b3e;
  box-shadow:
    0 0 0 2rpx rgba(166, 75, 62, 0.14),
    0 12rpx 30rpx rgba(166, 75, 62, 0.10);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 18rpx 14rpx;
  transition-property: transform, background-color, box-shadow, color;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.role-record-button.interviewer {
  background: #f4f7f8;
  color: #57727b;
  box-shadow:
    0 0 0 2rpx rgba(87, 114, 123, 0.14),
    0 12rpx 30rpx rgba(87, 114, 123, 0.08);
}

.role-record-button::after {
  border: 0;
}

.role-record-button.disabled {
  opacity: 0.72;
}

.role-record-button:active {
  transform: scale(0.96);
}

.role-record-button.disabled:active {
  transform: none;
}

.role-record-icon-shell {
  width: 58rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: rgba(166, 75, 62, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
}

.role-record-button.interviewer .role-record-icon-shell {
  background: rgba(87, 114, 123, 0.12);
}

.role-record-icon {
  width: 40rpx;
  height: 40rpx;
  transform: scale(1.35);
}

.role-record-text {
  width: 100%;
  color: inherit;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 42rpx;
  text-align: center;
  white-space: nowrap;
  word-break: keep-all;
}

.mic-button {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  max-width: 660rpx;
  min-height: 118rpx;
  margin: 0;
  border: 0;
  border-radius: 999rpx;
  background: #fff3ef;
  color: #a64b3e;
  box-shadow:
    0 0 0 2rpx rgba(166, 75, 62, 0.16),
    0 12rpx 36rpx rgba(166, 75, 62, 0.12);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 22rpx 116rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 46rpx;
  overflow: hidden;
}

.mic-button-text {
  display: block;
  flex: 0 0 100%;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  text-align: center;
  white-space: nowrap;
  word-break: keep-all;
}

.mic-button.recording {
  max-width: 686rpx;
  padding-left: 116rpx;
  padding-right: 116rpx;
  background: #a64b3e;
  color: #ffffff;
  box-shadow:
    0 0 0 1rpx rgba(255, 255, 255, 0.18) inset,
    0 12rpx 36rpx rgba(166, 75, 62, 0.18);
}

.mic-button::after {
  border: 0;
}

.mic-button.disabled {
  opacity: 0.72;
}

.mic-icon-shell {
  position: absolute;
  top: 50%;
  left: 24rpx;
  transform: translateY(-50%);
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: rgba(166, 75, 62, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mic-button.recording .mic-icon-shell {
  background: rgba(255, 255, 255, 0.18);
}

.mic-icon {
  width: 48rpx;
  height: 48rpx;
  transform: scale(1.35);
}

.control-hint {
  display: block;
  margin: 0 0 14rpx;
  color: #7b6f68;
  font-size: 30rpx;
  line-height: 42rpx;
  text-align: center;
}

.error {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #fff1f3;
  color: #b84a5a;
  font-size: 28rpx;
  line-height: 1.5;
}

.session-state-strip {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  color: #a64b3e;
  font-size: 28rpx;
  font-weight: 800;
}

.session-state-strip text {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff3ef;
}

.session-state-strip .session-state-error {
  background: #fff1f3;
  color: #b84a5a;
}

.recovery-panel {
  margin-top: 18rpx;
  padding: 22rpx;
  border: 0;
  border-radius: 18rpx;
  background: #fff9f3;
  box-shadow: 0 0 0 1rpx rgba(43, 23, 19, 0.08);
}

.recovery-text {
  display: block;
  color: #7b4a40;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
}

.recovery-actions {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.recovery-button {
  min-width: 160rpx;
  height: 64rpx;
  margin: 0;
  border: 0;
  border-radius: 16rpx;
  background: #a64b3e;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
}

.recovery-button.ghost {
  background: #ffffff;
  color: #a64b3e;
}

.recovery-button::after {
  border: 0;
}

.voice-auth-panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 0;
  border-radius: 28rpx;
  background: #fff9f3;
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.08),
    0 8rpx 20rpx rgba(93, 61, 42, 0.05);
}

.voice-auth-title {
  display: block;
  color: #7b4a40;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.voice-auth-desc {
  display: block;
  margin-top: 12rpx;
  color: #7b6f68;
  font-size: 30rpx;
  line-height: 1.5;
}

.voice-auth-row {
  margin-top: 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.voice-auth-copy {
  flex: 1;
  min-width: 0;
  color: #2b1713;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
}

.voice-auth-link {
  color: #a64b3e;
}

.voice-chat-page.large-text {
  padding: 28rpx 24rpx 410rpx;
