.topic-map-page {
  padding: 38rpx 30rpx 96rpx;
  color: var(--ui-text-primary);
  -webkit-font-smoothing: antialiased;
}

.page-intro {
  padding: 10rpx 4rpx 34rpx;
}

.page-kicker,
.page-title,
.page-detail,
.map-note-title,
.map-note-text,
.module-title,
.topic-title,
.topic-intent,
.state-detail {
  display: block;
  overflow-wrap: anywhere;
}

.page-kicker {
  color: var(--ui-accent);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.page-title {
  margin-top: 12rpx;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 60rpx;
  text-wrap: balance;
}

.page-detail {
  margin-top: 16rpx;
  color: var(--ui-text-secondary);
  font-size: 30rpx;
  line-height: 46rpx;
  text-wrap: pretty;
}

.map-note {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--ui-accent-surface-subtle);
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.05),
    0 8rpx 20rpx rgba(0, 0, 0, 0.05);
}

.map-note-title {
  color: var(--ui-accent-strong);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.map-note-text {
  margin-top: 8rpx;
  color: var(--ui-value-text);
  font-size: 27rpx;
  line-height: 42rpx;
  text-wrap: pretty;
}

.module-list {
  display: flex;
  flex-direction: column;
  gap: 38rpx;
}

.topic-module {
  min-width: 0;
}

.module-title {
  padding: 0 4rpx;
  color: var(--ui-text-secondary);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.topic-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.topic-item {
  padding: 28rpx;
  border-radius: 30rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow);
}

.topic-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.topic-title {
  min-width: 0;
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 50rpx;
  text-wrap: balance;
}

.state-chip {
  flex: 0 0 auto;
  max-width: 240rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--ui-surface-subtle);
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
}

.topic-item.already_shared .state-chip {
  background: var(--ui-success-surface);
  color: var(--ui-success-text);
}

.topic-item.enough_for_now .state-chip {
  background: #edf1f5;
  color: #53677a;
}

.topic-item.not_applicable .state-chip,
.topic-item.do_not_discuss .state-chip {
  background: #f2edeb;
  color: var(--ui-text-secondary);
}

.topic-intent {
  margin-top: 16rpx;
  color: var(--ui-text-primary);
  font-size: 29rpx;
  line-height: 44rpx;
  text-wrap: pretty;
}

.state-detail {
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  line-height: 40rpx;
  text-wrap: pretty;
}

.topic-start-action,
.topic-choice-action {
  width: 100%;
  min-height: 88rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border: 0;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 0 0 1rpx rgba(168, 79, 67, 0.14),
    0 5rpx 12rpx rgba(0, 0, 0, 0.05);
  transition-property: transform, background-color, box-shadow, opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.topic-start-action {
  background: var(--ui-accent);
  color: var(--ui-on-accent);
  box-shadow:
    0 0 0 1rpx rgba(143, 64, 55, 0.18),
    0 8rpx 18rpx rgba(143, 64, 55, 0.16);
}

.topic-choice-action {
  margin-top: 16rpx;
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-accent-strong);
}

.topic-start-action::after,
.topic-choice-action::after {
  border: 0;
}

.topic-start-action-hover,
.topic-choice-action-hover {
  transform: scale(0.96);
}

.topic-start-action-hover {
  background: var(--ui-accent-strong);
  box-shadow:
    0 0 0 1rpx rgba(143, 64, 55, 0.2),
    0 4rpx 10rpx rgba(143, 64, 55, 0.12);
}

.topic-choice-action-hover {
  background: var(--ui-accent-surface);
  box-shadow:
    0 0 0 1rpx rgba(168, 79, 67, 0.18),
    0 3rpx 8rpx rgba(0, 0, 0, 0.04);
}

.topic-start-action.disabled,
.topic-choice-action.disabled {
  opacity: 0.62;
}

.error-strip,
.loading-state,
.empty-state {
  margin-top: 24rpx;
  padding: 26rpx 24rpx;
  font-size: 28rpx;
  line-height: 42rpx;
  text-wrap: pretty;
}

.error-strip {
  border-left: 6rpx solid var(--ui-danger-text);
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
}

.loading-state,
.empty-state {
  color: var(--ui-text-secondary);
  text-align: center;
}

.empty-state text {
  display: block;
}

.large-text .page-title {
  font-size: 52rpx;
  line-height: 68rpx;
}

.large-text .page-detail,
.large-text .map-note-text,
.large-text .topic-intent {
  font-size: 34rpx;
  line-height: 52rpx;
}

.large-text .topic-title {
  font-size: 42rpx;
  line-height: 56rpx;
}

.large-text .state-detail,
.large-text .topic-start-action,
.large-text .topic-choice-action {
  font-size: 32rpx;
  line-height: 48rpx;
}
