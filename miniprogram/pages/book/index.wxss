.book-page {
  min-height: 100vh;
  padding: 44rpx 36rpx 120rpx;
  background: #fffaf2;
  box-sizing: border-box;
}

.top-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 28rpx;
}

.back-hit {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-mark {
  color: #9f4a3c;
  font-size: 72rpx;
  line-height: 1;
}

.title-block {
  min-width: 0;
  flex: 1;
}

.page-title {
  display: block;
  color: #24100b;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}

.page-meta {
  display: block;
  margin-top: 8rpx;
  color: #685b55;
  font-size: 26rpx;
  line-height: 1.35;
  word-break: break-word;
}

.error,
.chapter-error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff1f2;
  color: #b4234a;
  font-size: 28rpx;
  line-height: 1.45;
  word-break: break-word;
}

.chapter-error {
  margin: 20rpx 0 0;
  font-size: 25rpx;
}

.status-panel,
.empty-panel,
.chapter-card,
.book-output-card {
  border: 2rpx solid #f0dac0;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 10rpx 28rpx rgba(64, 43, 24, 0.06);
}

.status-panel {
  min-height: 116rpx;
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  box-sizing: border-box;
}

.status-title {
  display: block;
  color: #24100b;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-word;
}

.status-meta {
  display: block;
  margin-top: 8rpx;
  color: #685b55;
  font-size: 25rpx;
  line-height: 1.35;
}

.coverage-section {
  margin-top: 26rpx;
}

.coverage-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.coverage-copy {
  min-width: 0;
  flex: 1;
}

.coverage-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.coverage-title {
  color: #7a3b31;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-word;
}

.coverage-count {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff1ec;
  color: #8a4034;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
}

.coverage-meta {
  display: block;
  margin-top: 8rpx;
  color: #685b55;
  font-size: 24rpx;
  line-height: 1.4;
  word-break: break-word;
}

.coverage-source-list {
  margin-top: 18rpx;
}

.coverage-source-card {
  margin-top: 14rpx;
  padding: 22rpx;
  border: 2rpx solid #efd6c4;
  border-radius: 18rpx;
  background: #fffdf9;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  box-sizing: border-box;
}

.coverage-source-main {
  min-width: 0;
  flex: 1;
}

.coverage-source-time {
  display: block;
  color: #9f4a3c;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.3;
}

.coverage-source-text {
  display: block;
  margin-top: 8rpx;
  color: #3a2119;
  font-size: 26rpx;
  line-height: 1.5;
  word-break: break-word;
}

.coverage-source-actions {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.coverage-assign,
.coverage-new-chapter {
  min-width: 156rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
}

.coverage-assign,
.coverage-new-chapter {
  background: #fff1ec;
  color: #8a4034;
}

.coverage-new-chapter {
  margin: 0;
  padding: 0 16rpx;
  border: 0;
}

.coverage-new-chapter::after {
  border: 0;
}

.coverage-new-chapter[disabled] {
  opacity: 0.62;
}

.coverage-assign.loading {
  opacity: 0.62;
}

.coverage-link {
  flex: 0 0 auto;
  min-width: 136rpx;
  height: 68rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 18rpx;
  background: #9f4a3c;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 68rpx;
}

.coverage-link::after {
  border: 0;
}

.coverage-empty {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #fff8ef;
  color: #685b55;
  font-size: 25rpx;
  line-height: 1.45;
}

.status-pill,
.source-count,
.draft-status,
.draft-version,
.draft-count {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
}

.status-pill,
.draft-status.confirmed {
  background: #9f4a3c;
  color: #ffffff;
}

.source-count,
.draft-status,
.draft-version,
.draft-count {
  background: #fff1ec;
  color: #8a4034;
}

.empty-panel {
  margin-top: 24rpx;
  padding: 48rpx 34rpx;
  color: #685b55;
  font-size: 30rpx;
  line-height: 1.5;
}

.empty-icon {
  width: 92rpx;
  height: 92rpx;
  margin-bottom: 22rpx;
}

.empty-title {
  display: block;
  color: #24100b;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.3;
}

.empty-copy {
  display: block;
  margin-top: 14rpx;
  word-break: break-word;
}

.section {
  margin-top: 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 28rpx 0 16rpx;
}

.section-head.inline {
  margin: 0 0 18rpx;
}

.section-title {
  color: #7a3b31;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.section-count {
  color: #9f4a3c;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.field-block {
  margin-top: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #7a3b31;
  font-size: 26rpx;
  font-weight: 800;
}

.title-input,
.chapter-title-input,
.chapter-title-inline-input,
.summary-textarea,
.draft-textarea {
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid #efd6c4;
  border-radius: 18rpx;
  background: #ffffff;
  color: #24100b;
}

.title-input,
.chapter-title-input {
  min-height: 84rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 84rpx;
}

.chapter-title-edit-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 18rpx;
}

.chapter-title-inline-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 76rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.title-action-button {
  flex: 0 0 auto;
  min-width: 136rpx;
  height: 76rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff1ec;
  color: #8a4034;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
}

.title-action-button.primary {
  background: #9f4a3c;
  color: #ffffff;
}

.title-action-button::after {
  border: 0;
}

.title-action-button[disabled] {
  opacity: 0.62;
}

.chapter-card {
  margin-top: 22rpx;
  padding: 30rpx;
}

.book-output-card {
  margin-top: 30rpx;
  padding: 30rpx;
}

.chapter-head,
.draft-meta-row,
.actions-row {
  display: flex;
  align-items: center;
}

.chapter-head {
  justify-content: space-between;
  gap: 20rpx;
}

.chapter-title-block {
  min-width: 0;
  flex: 1;
}

.chapter-index {
  display: block;
  color: #7a3b31;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
}

.chapter-title {
  display: block;
  margin-top: 6rpx;
  color: #24100b;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-word;
}

.chapter-title-input {
  margin-top: 22rpx;
}

.summary-textarea,
.draft-textarea {
  margin-top: 18rpx;
  min-height: 150rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.55;
}

.draft-textarea {
  min-height: 260rpx;
}

.source-preview,
.chapter-summary,
.draft-empty {
  display: block;
  margin-top: 18rpx;
  color: #685b55;
  font-size: 26rpx;
  line-height: 1.45;
  word-break: break-word;
}

.source-preview {
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #fff8ef;
}

.draft-pending {
  display: block;
  margin-top: 12rpx;
  color: #8a4034;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
}

.chapter-summary {
  color: #3a2119;
}

.draft-empty {
  padding: 26rpx 24rpx;
  border-radius: 18rpx;
  background: #fff8ef;
}

.draft-editor {
  margin-top: 22rpx;
}

.book-output-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: #685b55;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
}

.book-stale-notice {
  display: block;
  margin-top: 14rpx;
  color: #8a4034;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.book-preview {
  max-height: 680rpx;
  margin-top: 20rpx;
  padding: 24rpx;
  border: 2rpx solid #efd6c4;
  border-radius: 18rpx;
  background: #fffdf9;
  overflow-y: auto;
  box-sizing: border-box;
}

.book-output-text {
  display: block;
  color: #24100b;
  font-size: 28rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}

.draft-meta-row {
  justify-content: space-between;
  gap: 14rpx;
}

.actions-row {
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 26rpx;
}

.actions-row.compact {
  margin-top: 20rpx;
}

.sticky-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 30rpx;
}

.primary-button,
.ghost-button,
.danger-button {
  min-width: 0;
  height: 80rpx;
  margin: 0;
  border: 0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 22rpx;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.2;
}

.actions-row .primary-button,
.actions-row .ghost-button,
.actions-row .danger-button {
  flex: 1 1 180rpx;
}

.sticky-actions .primary-button,
.sticky-actions .ghost-button {
  flex: 1 1 0;
}

.primary-button::after,
.ghost-button::after,
.danger-button::after {
  border: 0;
}

.primary-button {
  background: #9f4a3c;
  color: #ffffff;
}

.ghost-button {
  background: #fff1ec;
  color: #8a4034;
}

.danger-button {
  background: #fff1f2;
  color: #b4234a;
}

.primary-button[disabled],
.ghost-button[disabled],
.danger-button[disabled] {
  opacity: 0.62;
}

.bottom-spacer {
  height: 20rpx;
}
