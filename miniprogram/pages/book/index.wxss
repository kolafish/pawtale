@import "../../templates/reading-share.wxss";
.book-page {
  padding: 24rpx 32rpx 112rpx;
}
.error {
  margin-bottom: 22rpx;
}
.book-cache-banner {
  margin-bottom: 22rpx;
}
.book-cache-retry {
  margin: 12rpx 0 0;
  color: inherit;
}
.status-panel,
.empty-panel,
.chapter-card {
  width: 100%;
}
.status-panel {
  box-sizing: border-box;
}
.progress-panel {
  overflow: hidden;
  padding: 0;
}
.progress-main {
  position: relative;
  min-height: 184rpx;
  padding: 28rpx 248rpx 24rpx 30rpx;
  background: linear-gradient(105deg, rgba(255, 253, 250, 0.98) 0%, rgba(255, 253, 250, 0.91) 58%, rgba(245, 230, 224, 0.38) 100%);
}
.progress-title-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  gap: 14rpx;
}
.book-header-illustration {
  position: absolute;
  right: -18rpx;
  bottom: 8rpx;
  width: 430rpx;
  height: 172rpx;
  opacity: 0.94;
}
.status-title {
  display: block;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-page-title);
  font-weight: 700;
  line-height: 1.32;
  letter-spacing: 0.025em;
  overflow-wrap: anywhere;
  text-wrap: balance;
}
.source-count {
  flex: 0 0 auto;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  font-size: var(--ui-font-caption);
  font-weight: 700;
  line-height: 1.25;
}
.source-count {
  background: var(--ui-accent-surface);
  color: var(--ui-accent-strong);
  font-variant-numeric: tabular-nums;
}
.status-meta {
  position: relative;
  z-index: 1;
  display: block;
  overflow-wrap: anywhere;
  text-wrap: pretty;
}
.status-meta {
  margin-top: 14rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  line-height: 1.45;
  font-variant-numeric: tabular-nums;
}
.book-tts-shell {
  margin-top: 18rpx;
}
.empty-panel {
  margin-top: 22rpx;
  padding: 44rpx 32rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-action);
  line-height: 1.5;
}
.empty-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 20rpx;
  outline: 1rpx solid rgba(0, 0, 0, 0.1);
  outline-offset: -1rpx;
}
.empty-title {
  display: block;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
  text-wrap: balance;
}
.empty-copy {
  display: block;
  margin-top: 14rpx;
  overflow-wrap: anywhere;
  text-wrap: pretty;
}
.section {
  margin-top: 24rpx;
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 26rpx 0 14rpx;
}
.section-head-tools,
.section-head-copy {
  min-width: 0;
  display: flex;
  align-items: center;
}
.section-head-tools {
  flex: 0 0 auto;
  gap: 10rpx;
}
.section-head-copy {
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8rpx 14rpx;
}
.outline-read-action {
  min-width: 144rpx;
}
.chapter-section-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 164rpx;
}
.chapter-section-head .section-head-action {
  width: 164rpx;
  min-width: 0;
}
.section-head-action {
  flex: 0 0 auto;
  min-width: 164rpx;
  min-height: 80rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: var(--ui-radius-control);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ui-surface);
  box-shadow: var(--ui-control-shadow);
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-action);
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
  transition-property: transform, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}
.section-head-action-active {
  transform: scale(0.96);
  background: var(--ui-accent-surface-subtle);
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.08);
}
.section-head-action.is-locked {
  pointer-events: none;
  opacity: 0.6;
}
.section-title {
  color: var(--ui-section-title);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-section-title);
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 0.02em;
  text-wrap: balance;
}
.section-count {
  color: var(--ui-accent);
  font-size: var(--ui-font-caption);
  font-weight: 700;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
}
.section-count.saving {
  color: var(--ui-text-secondary);
}
.field-block {
  margin-top: 22rpx;
}
.field-label {
  display: block;
  margin-bottom: 11rpx;
  color: var(--ui-section-title);
  font-size: var(--ui-font-meta);
  font-weight: 700;
}
.title-input,
.chapter-title-input {
  width: 100%;
  min-height: 84rpx;
  padding: 0 22rpx;
  border: 0;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface);
  box-shadow: var(--ui-control-shadow);
  color: var(--ui-text-primary);
  box-sizing: border-box;
  font-size: var(--ui-font-list-title);
  font-weight: 600;
  line-height: 84rpx;
}
.chapter-card {
  margin-top: 16rpx;
  padding: 28rpx;
}
.chapter-head,
.actions-row,
.source-summary-row,
.structure-action-row,
.sticky-actions {
  display: flex;
  align-items: center;
}
.chapter-head {
  justify-content: space-between;
  gap: 18rpx;
}
.chapter-order-copy {
  min-width: 0;
  flex: 1;
}
.chapter-index,
.chapter-order-index,
.chapter-order-title {
  display: block;
}
.chapter-index {
  color: var(--ui-section-title);
  font-size: var(--ui-font-caption);
  font-weight: 700;
  line-height: 1.35;
  font-variant-numeric: tabular-nums;
}
.chapter-order-panel {
  overflow: hidden;
  border-radius: var(--ui-radius-card);
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow);
}
.chapter-order-row {
  min-height: 108rpx;
  padding: 14rpx 16rpx 14rpx 22rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 264rpx;
  align-items: center;
  gap: 14rpx;
  transition-property: background-color;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}
.chapter-order-row.is-saving {
  background: var(--ui-accent-surface-subtle);
}
.chapter-order-row + .chapter-order-row {
  border-top: 1rpx solid var(--ui-divider);
}
.chapter-order-index {
  color: var(--ui-text-muted);
  font-size: var(--ui-font-caption);
  font-weight: 600;
  line-height: 1.25;
  font-variant-numeric: tabular-nums;
}
.chapter-order-title {
  margin-top: 5rpx;
  color: var(--ui-text-primary);
  font-size: var(--ui-font-list-title);
  font-weight: 600;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.chapter-order-actions {
  width: 264rpx;
  min-width: 0;
  display: grid;
  grid-template-columns: 88rpx 78rpx 78rpx;
  align-items: center;
  gap: 10rpx;
}
.chapter-order-edit,
.chapter-order-button {
  width: 100%;
  min-width: 0;
  min-height: 80rpx;
  padding: 0;
  border-radius: var(--ui-radius-control);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ui-surface-soft);
  box-shadow: var(--ui-control-shadow);
  color: var(--ui-accent-strong);
  font-weight: 700;
  line-height: 1;
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}
.chapter-order-edit {
  font-size: var(--ui-font-meta);
}
.chapter-order-button {
  font-size: 32rpx;
}
.chapter-order-button-active {
  transform: scale(0.96);
  background: var(--ui-accent-surface);
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.08);
}
.chapter-order-edit.is-locked,
.chapter-order-button.is-locked,
.chapter-order-edit.is-unavailable,
.chapter-order-button.is-unavailable {
  pointer-events: none;
}
.chapter-order-edit.is-unavailable,
.chapter-order-button.is-unavailable {
  opacity: 0.42;
}
.chapter-order-button.is-saving {
  background: var(--ui-accent-surface);
  opacity: 1;
}
.chapter-title-input {
  margin-top: 20rpx;
}
.source-summary-row {
  gap: 10rpx;
  margin-top: 14rpx;
}
.source-preview {
  flex: 1;
  min-width: 0;
  display: block;
  padding: 16rpx 20rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  overflow-wrap: anywhere;
  text-wrap: pretty;
}
.source-toggle-button {
  flex: 0 0 auto;
  min-width: 188rpx;
  min-height: 80rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface);
  box-shadow: var(--ui-control-shadow);
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 1.25;
  white-space: nowrap;
}
.source-ref-list {
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface);
  box-shadow: var(--ui-control-shadow);
}
.source-ref-row {
  padding: 15rpx 16rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: var(--ui-surface);
}
.source-ref-row + .source-ref-row {
  border-top: 1rpx solid var(--ui-divider);
}
.source-ref-row.selected {
  background: var(--ui-accent-surface-subtle);
}
.source-ref-main {
  flex: 1 1 auto;
  min-width: 0;
  min-height: 88rpx;
  padding: 5rpx 7rpx;
  border-radius: 12rpx;
}
.source-ref-main-active {
  background: var(--ui-accent-surface-subtle);
}
.source-ref-label,
.source-ref-text {
  display: block;
}
.source-ref-label {
  color: var(--ui-accent);
  font-size: var(--ui-font-caption);
  font-weight: 700;
  line-height: 1.25;
}
.source-ref-text {
  margin-top: 6rpx;
  color: var(--ui-text-primary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
  overflow-wrap: anywhere;
}
.source-split-toggle {
  flex: 0 0 104rpx;
  width: 104rpx;
  min-height: 88rpx;
  margin: 1rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: var(--ui-radius-control);
  background: var(--ui-surface-soft);
  color: var(--ui-text-primary);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 1.2;
}
.source-split-toggle.selected {
  background: var(--ui-accent-surface);
  color: var(--ui-accent-strong);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
}
.source-split-toggle[disabled] {
  opacity: 0.52;
}
.guest-panel {
  margin-top: 22rpx;
}
.actions-row {
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}
.actions-row.compact {
  margin-top: 18rpx;
}
.structure-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 16rpx;
}
.structure-action-row {
  gap: 10rpx;
}
.structure-action-row .structure-button,
.structure-picker {
  flex: 1 1 0;
  min-width: 0;
}
.structure-button {
  min-height: 80rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 0;
  border-radius: var(--ui-radius-control);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ui-surface-soft);
  color: var(--ui-text-primary);
  font-size: var(--ui-font-meta);
  font-weight: 600;
  line-height: 1.25;
}
.structure-button[disabled],
.structure-button.disabled,
.picker-button.disabled {
  opacity: 0.5;
}
.picker-button {
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-accent-strong);
}
.sticky-actions {
  gap: 12rpx;
  margin-top: 26rpx;
  padding: 10rpx;
  border-radius: calc(var(--ui-radius-control) + 10rpx);
  background: rgba(255, 253, 250, 0.78);
  box-shadow: var(--ui-card-shadow);
}
.primary-button,
.ghost-button,
.danger-button {
  min-width: 0;
  min-height: 80rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 0;
  border-radius: var(--ui-radius-control);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ui-surface);
  box-shadow: var(--ui-control-shadow);
  color: var(--ui-text-primary);
  font-size: var(--ui-font-action);
  font-weight: 600;
  line-height: 1.3;
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}
.primary-button.small,
.ghost-button.small,
.danger-button.small {
  min-height: 80rpx;
  padding: 0 14rpx;
  font-size: var(--ui-font-meta);
}
.actions-row .primary-button,
.actions-row .ghost-button,
.actions-row .danger-button {
  flex: 1 1 180rpx;
}
.sticky-actions .primary-button,
.sticky-actions .ghost-button {
  flex: 1 1 0;
}
.primary-button {
  background: var(--ui-accent-surface-subtle);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
  color: var(--ui-accent-strong);
  font-weight: 700;
}
.danger-button {
  background: var(--ui-danger-surface);
  box-shadow: none;
  color: var(--ui-danger-text);
}
.primary-button:active,
.ghost-button:active,
.danger-button:active,
.structure-button:active,
.source-toggle-button:active,
.source-split-toggle:active {
  transform: scale(0.96);
}
.primary-button[disabled],
.ghost-button[disabled],
.danger-button[disabled] {
  opacity: 0.58;
  transform: none;
}
.bottom-spacer {
  height: 20rpx;
}
.book-page.large-text {
  padding: 24rpx 24rpx 112rpx;
}
.book-page.large-text .progress-main {
  min-height: 222rpx;
  padding-right: 226rpx;
}
.book-page.large-text .book-header-illustration {
  right: -24rpx;
  width: 386rpx;
  opacity: 0.78;
}
.book-page.large-text .status-title {
  font-size: 46rpx;
  line-height: 1.4;
}
.book-page.large-text .status-meta {
  font-size: var(--ui-font-large-body);
  line-height: 1.5;
}
.book-page.large-text .section-title {
  font-size: 38rpx;
  line-height: 1.45;
}
.book-page.large-text .chapter-order-title {
  font-size: 34rpx;
  line-height: 1.45;
}
.book-page.large-text .chapter-section-head {
  grid-template-columns: minmax(0, 1fr) 184rpx;
}
.book-page.large-text .chapter-section-head .section-head-action {
  width: 184rpx;
}
.book-page.large-text .chapter-order-row {
  grid-template-columns: minmax(0, 1fr);
  align-items: stretch;
  gap: 18rpx;
  padding: 22rpx 24rpx;
}
.book-page.large-text .chapter-order-actions {
  width: 100%;
  grid-template-columns: minmax(0, 1fr) 96rpx 96rpx;
}
.book-page.large-text .chapter-order-edit,
.book-page.large-text .chapter-order-button {
  min-height: 48px;
}
.book-page.large-text .source-count,
.book-page.large-text .section-count,
.book-page.large-text .chapter-order-index,
.book-page.large-text .chapter-order-edit,
.book-page.large-text .chapter-index,
.book-page.large-text .source-ref-label,
.book-page.large-text .source-split-toggle {
  font-size: var(--ui-font-large-meta);
  line-height: 1.5;
}
.book-page.large-text .source-split-toggle {
  min-height: 96rpx;
}
.book-page.large-text .source-preview,
.book-page.large-text .source-ref-text,
.book-page.large-text .field-label {
  font-size: var(--ui-font-large-meta);
  line-height: 1.5;
}
.book-page.large-text .primary-button,
.book-page.large-text .ghost-button,
.book-page.large-text .danger-button,
.book-page.large-text .section-head-action,
.book-page.large-text .source-toggle-button,
.book-page.large-text .structure-button {
  min-height: 48px;
  font-size: var(--ui-font-large-body);
  line-height: 1.35;
}

.progress-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
  padding: 0 30rpx 20rpx;
}
.hero-reading-action, .hero-share-action {
  min-height: 44px;
  margin: 0;
  padding: 0 8rpx;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: transparent;
  box-shadow: none;
  font-size: var(--ui-font-action);
  line-height: 1.4;
}
.hero-reading-action {
  color: var(--ui-accent-strong);
  font-weight: 700;
}
.hero-share-action {
  color: var(--ui-text-secondary);
}
.hero-reading-action:active, .hero-share-action:active {
  transform: scale(0.96);
}
.book-activity-notice {
  min-height: 44px;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 30rpx;
  border-top: 1rpx solid var(--ui-divider);
  color: var(--ui-warning-text);
  font-size: var(--ui-font-meta);
  line-height: var(--ui-line-body);
}
.book-activity-notice text:first-child {
  flex: 1;
}
.book-operation-list {
  margin-top: 22rpx;
  padding: 0 26rpx;
}
.book-operation-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 44px;
  padding: 22rpx 4rpx;
}
.book-operation-row + .book-operation-row {
  border-top: 1rpx solid var(--ui-divider);
}
.book-operation-copy, .chapter-directory-copy {
  min-width: 0;
  flex: 1;
}
.book-operation-title, .chapter-directory-title, .chapter-directory-meta, .chapter-directory-notice, .chapter-directory-error {
  display: block;
}
.book-operation-title, .chapter-directory-title {
  color: var(--ui-text-primary);
  font-size: var(--ui-font-list-title);
  font-weight: 600;
  line-height: 1.45;
  overflow-wrap: anywhere;
}
.chapter-directory-meta {
  margin-top: 6rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  line-height: 1.5;
}
.book-operation-notice {
  padding: 8rpx 0 0;
}
.book-row-arrow {
  flex: 0 0 auto;
  color: var(--ui-accent);
  font-size: 38rpx;
  line-height: 1;
}
.chapter-directory {
  overflow: hidden;
  padding: 0 26rpx;
}
.chapter-directory-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  min-height: 120rpx;
  padding: 24rpx 4rpx;
}
.chapter-directory-row + .chapter-directory-row {
  border-top: 1rpx solid var(--ui-divider);
}
.chapter-directory-index {
  flex: 0 0 44rpx;
  padding-top: 3rpx;
  color: var(--ui-accent);
  font-size: var(--ui-font-meta);
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}
.chapter-directory-row .book-row-arrow {
  align-self: center;
}
.chapter-directory-meta {
  font-variant-numeric: tabular-nums;
}
.chapter-directory-notice, .chapter-directory-error {
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.chapter-directory-error {
  color: var(--ui-danger-text);
}
.book-operation-row.is-disabled, .chapter-directory-row.is-disabled {
  opacity: 0.58;
}
.book-page.large-text .book-operation-title, .book-page.large-text .chapter-directory-title {
  font-size: var(--ui-font-large-body);
}
.book-page.large-text .chapter-directory-meta, .book-page.large-text .chapter-directory-notice, .book-page.large-text .chapter-directory-error, .book-page.large-text .book-operation-notice, .book-page.large-text .book-activity-notice {
  font-size: var(--ui-font-large-meta);
}
.book-page.large-text .hero-reading-action, .book-page.large-text .hero-share-action {
  min-height: 48px;
  font-size: var(--ui-font-large-body);
}
.chapter-order-toggle {
  min-height: 44px;
  background: transparent;
  box-shadow: none;
}
