  font-weight: 800;
  color: #2b1713;
}

.image-assets-entry-count {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f3eadf;
  color: #8f463c;
  font-size: 24rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.image-assets-entry-meta {
  color: #6f625c;
  font-size: 26rpx;
  line-height: 1.45;
}

.image-assets-entry-note {
  color: #9a8b82;
  font-size: 23rpx;
  line-height: 1.45;
}

.image-assets-entry-action {
