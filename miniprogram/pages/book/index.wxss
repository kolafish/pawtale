  border: 2rpx solid #f2ddc8;
  border-radius: 16rpx;
  background: #fffdf9;
}

.chapter-action-label {
  display: block;
  color: #7b4a40;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.35;
}

