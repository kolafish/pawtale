.book-page {
  min-height: 100vh;
  padding: 52rpx 36rpx 120rpx;
  background: #fffaf2;
}

.header {
  margin-bottom: 30rpx;
}

.page-title {
  display: block;
  color: #24100b;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.2;
}

.page-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #685b55;
  font-size: 28rpx;
  line-height: 1.4;
}

.book-panel,
.step-list {
  border: 2rpx solid #f0dac0;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(64, 43, 24, 0.07);
}

.book-panel {
  padding: 42rpx 34rpx;
}

.book-icon {
  width: 112rpx;
  height: 112rpx;
}

.book-title {
  display: block;
  margin-top: 26rpx;
  color: #24100b;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.18;
}

.book-copy {
  display: block;
  margin-top: 18rpx;
  color: #685b55;
  font-size: 30rpx;
  line-height: 1.5;
}

.section {
  margin-top: 30rpx;
}

.section-title {
  display: block;
  margin-bottom: 16rpx;
  color: #7a3b31;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.step-list {
  overflow: hidden;
}

.step-item {
  min-height: 112rpx;
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border-top: 2rpx solid #f7ead7;
}

.step-item:first-child {
  border-top: 0;
}

.step-index {
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: #f3e6d7;
  color: #7a3b31;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
}

.step-item.active .step-index {
  background: #9f4a3c;
  color: #ffffff;
}

.step-main {
  flex: 1;
  min-width: 0;
}

.step-title {
  display: block;
  color: #24100b;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.step-meta {
  display: block;
  margin-top: 10rpx;
  color: #685b55;
  font-size: 25rpx;
  line-height: 1.35;
}

.primary-button {
  width: 100%;
  height: 108rpx;
  margin: 44rpx 0 0;
  border: 0;
  border-radius: 28rpx;
  background: #9f4a3c;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
}

.primary-button::after {
  border: 0;
}

.primary-button[disabled] {
  opacity: 0.72;
}

.error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff1f2;
  color: #be123c;
  font-size: 26rpx;
  line-height: 1.45;
}
