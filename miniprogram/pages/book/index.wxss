}

.structure-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 18rpx;
}

.structure-action-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.structure-action-row .structure-button,
.structure-picker {
  flex: 1 1 0;
  min-width: 0;
}

.structure-button {
  height: 64rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f4efe8;
  color: #6d4d40;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
  box-sizing: border-box;
}

.structure-button::after {
  border: 0;
}

.structure-button[disabled],
.structure-button.disabled,
.picker-button.disabled {
  opacity: 0.5;
}

.picker-button {
  background: #fff3ef;
  color: #8f3e35;
}

.sticky-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 30rpx;
}

.primary-button,
.ghost-button,
.danger-button {
  min-width: 0;
  height: 80rpx;
  margin: 0;
  border: 0;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 22rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
}

.primary-button.small,
.ghost-button.small,
.danger-button.small {
  height: 64rpx;
  padding: 0 14rpx;
  border-radius: 16rpx;
  font-size: 23rpx;
}

.actions-row .primary-button,
.actions-row .ghost-button,
.actions-row .danger-button {
  flex: 1 1 180rpx;
}

.sticky-actions .primary-button,
.sticky-actions .ghost-button {
  flex: 1 1 0;
}

.primary-button::after,
.ghost-button::after,
.danger-button::after {
  border: 0;
}

.primary-button {
  background: #a64b3e;
  color: #ffffff;
}

.ghost-button {
  background: #ffffff;
  color: #7b4a40;
  border: 1rpx solid #d8c4b2;
}

.danger-button {
  background: #fff1f3;
  color: #b84a5a;
}

.image-assets-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 22rpx 0;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 42rpx rgba(63, 45, 35, 0.08);
  transition-property: transform, opacity;
  transition-duration: 160ms;
}

.image-assets-entry:active {
  transform: scale(0.96);
}

.image-assets-entry-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.image-assets-entry-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.image-assets-entry-title {
