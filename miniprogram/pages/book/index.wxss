  gap: 14rpx;
  margin-top: 26rpx;
}

.actions-row.compact {
  margin-top: 20rpx;
}

.chapter-action-groups {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.chapter-action-group {
