  color: #8f3e35;
}

.sticky-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 30rpx;
}

.primary-button,
.ghost-button,
.danger-button {
  min-width: 0;
  height: 80rpx;
  margin: 0;
  border: 0;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 22rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
}

.primary-button.small,
.ghost-button.small,
.danger-button.small {
