  min-width: 96rpx;
  min-height: 72rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #2f1712;
  color: #fffaf2;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 72rpx;
  text-align: center;
}

.primary-button[disabled],
.ghost-button[disabled],
.danger-button[disabled] {
  opacity: 0.62;
}

.bottom-spacer {
  height: 20rpx;
}
