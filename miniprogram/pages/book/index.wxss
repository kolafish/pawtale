  min-height: 40px;
  padding: 0 14rpx;
  border-radius: 16rpx;
  font-size: 23rpx;
}

.actions-row .primary-button,
.actions-row .ghost-button,
.actions-row .danger-button {
  flex: 1 1 180rpx;
}

.sticky-actions .primary-button,
.sticky-actions .ghost-button {
  flex: 1 1 0;
}

.primary-button::after,
.ghost-button::after,
.danger-button::after {
  border: 0;
}

.primary-button {
  background: #a64b3e;
  color: #ffffff;
}

.ghost-button {
  background: #ffffff;
  color: #7b4a40;
  border: 1rpx solid #d8c4b2;
}

.danger-button {
  background: #fff1f3;
  color: #b84a5a;
}

.image-assets-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 22rpx 0;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 42rpx rgba(63, 45, 35, 0.08);
  transition-property: transform, opacity;
  transition-duration: 160ms;
}

.image-assets-entry:active {
