.book-page {
  min-height: 100vh;
  padding: 44rpx 36rpx 120rpx;
  background: #fffaf2;
  box-sizing: border-box;
}

.top-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 28rpx;
}

.back-hit {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-mark {
  color: #9f4a3c;
  font-size: 72rpx;
  line-height: 1;
}

.title-block {
  min-width: 0;
  flex: 1;
}

.page-title {
  display: block;
  color: #24100b;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}

.page-meta {
  display: block;
  margin-top: 8rpx;
  color: #685b55;
  font-size: 26rpx;
  line-height: 1.35;
  word-break: break-word;
}

.error,
.chapter-error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff1f2;
  color: #b4234a;
  font-size: 28rpx;
  line-height: 1.45;
  word-break: break-word;
}

.chapter-error {
  margin: 20rpx 0 0;
  font-size: 25rpx;
}

.status-panel,
.automation-panel,
.empty-panel,
.chapter-card,
.book-output-card {
  border: 2rpx solid #f0dac0;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 10rpx 28rpx rgba(64, 43, 24, 0.06);
}

.status-panel {
  min-height: 116rpx;
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  box-sizing: border-box;
}

.status-title {
  display: block;
  color: #24100b;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-word;
}

.status-meta {
  display: block;
  margin-top: 8rpx;
  color: #685b55;
  font-size: 25rpx;
  line-height: 1.35;
}

.automation-panel {
  margin-top: 22rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.automation-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.automation-title {
  display: block;
  color: #24100b;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.automation-meta {
  display: block;
  margin-top: 6rpx;
  color: #6d5f58;
  font-size: 23rpx;
  line-height: 1.35;
}

.automation-count {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff1ec;
  color: #8a4034;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
}

.automation-error {
  display: block;
  margin-top: 16rpx;
  color: #b42348;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
}

.automation-item {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 2rpx solid #f4dfc6;
  border-radius: 18rpx;
  background: #fffaf2;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.automation-item-main {
  min-width: 0;
  flex: 1;
}

.automation-item-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.automation-item-title {
  color: #7a3b31;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
}

.automation-item-status {
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #8a4034;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
}

.automation-item-summary {
  display: block;
  margin-top: 10rpx;
  color: #3a2119;
  font-size: 25rpx;
  line-height: 1.42;
  word-break: break-word;
}

.automation-item-detail {
  display: block;
  margin-top: 8rpx;
  color: #6c4238;
  font-size: 23rpx;
  line-height: 1.38;
  word-break: break-word;
}

.automation-detail-toggle {
  display: inline-flex;
  margin-top: 12rpx;
  color: #8a4034;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.3;
}

.automation-detail-list {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.automation-detail-row {
  padding: 14rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 1rpx solid #f0dfcb;
}

.automation-detail-row-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.automation-detail-title {
  color: #3a2119;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.35;
}

.automation-detail-chapter {
  flex: 0 1 auto;
  color: #8a4034;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: right;
}

.automation-detail-preview {
  display: block;
  margin-top: 8rpx;
  color: #5a3b31;
  font-size: 22rpx;
  line-height: 1.38;
  word-break: break-word;
}

.automation-detail-meta {
  display: block;
  margin-top: 6rpx;
  color: #806c60;
  font-size: 20rpx;
  line-height: 1.3;
}

.automation-item-meta {
  display: block;
  margin-top: 8rpx;
  color: #806c60;
  font-size: 22rpx;
  line-height: 1.3;
}

.automation-ack {
  flex: 0 0 128rpx;
  width: 128rpx;
  height: 60rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 16rpx;
  background: #9f4a3c;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 60rpx;
}

.automation-ack::after {
  border: 0;
}

.automation-ack[disabled] {
  opacity: 0.58;
}

.book-voice-assistant {
  margin-top: 24rpx;
  padding: 26rpx;
  border: 2rpx solid #efd6c4;
  border-radius: 22rpx;
  background: #fff6f1;
  box-sizing: border-box;
}

.book-voice-assistant.collapsed {
  padding-bottom: 24rpx;
}

.book-voice-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 18rpx;
}

.book-voice-copy {
  min-width: 0;
  flex: 1;
}

.book-voice-title {
  display: block;
  color: #7a3b31;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.book-voice-hint {
  display: block;
  margin-top: 8rpx;
  color: #24100b;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.45;
  word-break: break-word;
}

.book-voice-status {
  display: block;
  margin-top: 6rpx;
  color: #685b55;
  font-size: 27rpx;
  line-height: 1.35;
}

.book-voice-actions {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.book-voice-button {
  min-width: 164rpx;
  height: 72rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 0;
  border-radius: 18rpx;
  background: #ffffff;
  color: #9f4a3c;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.book-voice-button.primary {
  background: #9f4a3c;
  color: #ffffff;
}

.book-voice-button::after {
  border: 0;
}

.book-voice-button[disabled] {
  opacity: 0.62;
}

.book-voice-playback {
  width: 100%;
  padding-top: 4rpx;
}

.book-voice-expanded {
  width: 100%;
  margin-top: 22rpx;
}

.book-voice-meter {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.book-voice-meter-track {
  flex: 1 1 auto;
  height: 12rpx;
  border-radius: 999rpx;
  background: #eadcc9;
  overflow: hidden;
}

.book-voice-meter-fill {
  height: 100%;
  border-radius: inherit;
  background: #2f7d63;
  transition: width 120ms ease;
}

.book-voice-meter-text {
  flex: 0 0 auto;
  color: #685b55;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.book-voice-dialog {
  width: 100%;
  padding: 20rpx 0;
  border-top: 2rpx solid #efd6c4;
  border-bottom: 2rpx solid #efd6c4;
  box-sizing: border-box;
}

.book-voice-dialog-empty {
  display: block;
  padding: 8rpx 2rpx;
  color: #6d4d40;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-word;
}

.book-voice-message {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 16rpx;
}

.book-voice-message:first-child {
  margin-top: 0;
}

.book-voice-message-role {
  flex: 0 0 58rpx;
  min-width: 58rpx;
  padding-top: 5rpx;
  color: #8a4034;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.3;
  text-align: center;
}

.book-voice-message-text {
  min-width: 0;
  max-width: 580rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  color: #24100b;
  font-size: 30rpx;
  line-height: 1.55;
  word-break: break-word;
  box-sizing: border-box;
}

.book-voice-message.user {
  justify-content: flex-end;
}

.book-voice-message.user .book-voice-message-role {
  order: 2;
  color: #2f7d63;
}

.book-voice-message.user .book-voice-message-text {
  order: 1;
  background: #eef8f2;
}

.book-voice-message.assistant .book-voice-message-text {
  background: #fffdf9;
}

.book-voice-message.assistant .book-voice-message-text.assistant-speaking {
  background: #fffaf0;
}

.book-voice-message.live .book-voice-message-text {
  border: 2rpx solid #c7e7d2;
}

.book-voice-command-preview {
  width: 100%;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid #efd6c4;
  border-radius: 18rpx;
  background: #fffdf9;
  box-sizing: border-box;
}

.book-voice-command-preview.answer {
  border-color: #c7dfd6;
  background: #f6fbf8;
}

.book-voice-command-preview.consultation {
  border-color: #ead8af;
  background: #fffaf0;
}

.book-voice-command-preview.clarification {
  border-color: #e8c4ca;
  background: #fff6f7;
}

.book-voice-command-preview.action_preview {
  border-color: #efd6c4;
  background: #fffdf9;
}

.book-voice-command-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.book-voice-command-label {
  color: #7a3b31;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.book-voice-command-state {
  flex: 0 0 auto;
  color: #8a4034;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
}

.book-voice-command-text,
.book-voice-command-summary {
  display: block;
  margin-top: 10rpx;
  color: #24100b;
  font-size: 30rpx;
  line-height: 1.55;
  word-break: break-word;
}

.book-voice-command-summary {
  color: #685b55;
}

.book-voice-command-body {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.72);
  box-sizing: border-box;
}

.book-voice-command-panel-title {
  display: block;
  color: #7a3b31;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.35;
}

.book-voice-command-body .book-voice-command-summary {
  margin-top: 8rpx;
  color: #24100b;
  font-size: 30rpx;
}

.book-voice-command-actions {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.book-voice-command-button {
  min-width: 140rpx;
  height: 66rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 16rpx;
  background: #ffffff;
  color: #9f4a3c;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 66rpx;
}

.book-voice-command-button.primary {
  background: #9f4a3c;
  color: #ffffff;
}

.book-voice-command-button::after {
  border: 0;
}

.book-voice-command-button[disabled] {
  opacity: 0.62;
}

.coverage-section {
  margin-top: 26rpx;
}

.coverage-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.coverage-copy {
  min-width: 0;
  flex: 1;
}

.coverage-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.coverage-title {
  color: #7a3b31;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-word;
}

.coverage-count {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff1ec;
  color: #8a4034;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
}

.coverage-meta {
  display: block;
  margin-top: 8rpx;
  color: #685b55;
  font-size: 24rpx;
  line-height: 1.4;
  word-break: break-word;
}

.coverage-source-list {
  margin-top: 18rpx;
}

.coverage-source-card {
  margin-top: 14rpx;
  padding: 22rpx;
  border: 2rpx solid #efd6c4;
  border-radius: 18rpx;
  background: #fffdf9;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  box-sizing: border-box;
}

.coverage-source-main {
  min-width: 0;
  flex: 1;
  padding: 4rpx;
  border-radius: 14rpx;
}

.coverage-source-main-active {
  background: #fff6f1;
}

.coverage-source-time {
  display: block;
  color: #9f4a3c;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.3;
}

.coverage-source-text {
  display: block;
  margin-top: 8rpx;
  color: #3a2119;
  font-size: 26rpx;
  line-height: 1.5;
  word-break: break-word;
}

.coverage-source-actions {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.coverage-assign {
  min-width: 156rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
}

.coverage-assign {
  background: #fff1ec;
  color: #8a4034;
}

.coverage-assign.loading {
  opacity: 0.62;
}

.coverage-link {
  flex: 0 0 auto;
  min-width: 136rpx;
  height: 68rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 18rpx;
  background: #9f4a3c;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 68rpx;
}

.coverage-link::after {
  border: 0;
}

.coverage-empty {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #fff8ef;
  color: #685b55;
  font-size: 25rpx;
  line-height: 1.45;
}

.status-pill,
.source-count,
.draft-status,
.draft-version,
.draft-count {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
}

.status-pill,
.draft-status.confirmed {
  background: #9f4a3c;
  color: #ffffff;
}

.source-count,
.draft-status,
.draft-version,
.draft-count {
  background: #fff1ec;
  color: #8a4034;
}

.empty-panel {
  margin-top: 24rpx;
  padding: 48rpx 34rpx;
  color: #685b55;
  font-size: 30rpx;
  line-height: 1.5;
}

.empty-icon {
  width: 92rpx;
  height: 92rpx;
  margin-bottom: 22rpx;
}

.empty-title {
  display: block;
  color: #24100b;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.3;
}

.empty-copy {
  display: block;
  margin-top: 14rpx;
  word-break: break-word;
}

.section {
  margin-top: 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 28rpx 0 16rpx;
}

.section-head.inline {
  margin: 0 0 18rpx;
}

.section-title {
  color: #7a3b31;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.section-count {
  color: #9f4a3c;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.field-block {
  margin-top: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #7a3b31;
  font-size: 26rpx;
  font-weight: 800;
}

.title-input,
.chapter-title-input,
.chapter-title-inline-input,
.draft-textarea {
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid #efd6c4;
  border-radius: 18rpx;
  background: #ffffff;
  color: #24100b;
}

.title-input,
.chapter-title-input {
  min-height: 84rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 84rpx;
}

.chapter-title-edit-row {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 14rpx;
  margin-top: 18rpx;
}

.chapter-title-inline-input {
  min-height: 84rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 84rpx;
}

.chapter-title-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.title-action-button {
  flex: 1 1 0;
  min-width: 136rpx;
  height: 76rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff1ec;
  color: #8a4034;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
}

.title-action-button.primary {
  background: #9f4a3c;
  color: #ffffff;
}

.title-action-button::after {
  border: 0;
}

.title-action-button[disabled] {
  opacity: 0.62;
}

.chapter-card {
  margin-top: 22rpx;
  padding: 30rpx;
}

.book-output-card {
  margin-top: 30rpx;
  padding: 30rpx;
}

.chapter-head,
.draft-meta-row,
.actions-row {
  display: flex;
  align-items: center;
}

.chapter-head {
  justify-content: space-between;
  gap: 20rpx;
}

.chapter-title-block {
  min-width: 0;
  flex: 1;
}

.chapter-title-block .source-count {
  display: inline-flex;
  margin-top: 8rpx;
}

.chapter-index {
  display: block;
  color: #7a3b31;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
}

.chapter-title {
  display: block;
  margin-top: 6rpx;
  color: #24100b;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-word;
}

.chapter-title-input {
  margin-top: 22rpx;
}

.draft-textarea {
  margin-top: 18rpx;
  min-height: 150rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.55;
}

.draft-textarea {
  min-height: 260rpx;
}

.source-preview,
.draft-empty {
  display: block;
  margin-top: 18rpx;
  color: #685b55;
  font-size: 26rpx;
  line-height: 1.45;
  word-break: break-word;
}

.source-preview {
  flex: 1;
  min-width: 0;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #fff8ef;
}

.source-summary-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.source-toggle-button {
  flex: 0 0 auto;
  min-width: 212rpx;
  height: 68rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff1ec;
  color: #8a4034;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
  box-sizing: border-box;
  white-space: nowrap;
