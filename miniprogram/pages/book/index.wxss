.book-page {
  min-height: 100vh;
  padding: 28rpx 32rpx 120rpx;
  background: #fcf7ed;
  box-sizing: border-box;
}

.book-share-button {
  flex: 0 0 156rpx;
  width: 156rpx;
  min-width: 0;
  height: var(--ui-hit-size);
  min-height: 44px;
  margin: 2rpx 0 0;
  border: 0;
  border-radius: 999rpx;
  background: #fffdf9;
  color: #8f3e35;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  white-space: nowrap;
  box-shadow:
    0 0 0 1rpx rgba(166, 75, 62, 0.16),
    0 6rpx 14rpx rgba(93, 61, 42, 0.06);
  transition-property: transform, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.book-share-button::after {
  border: 0;
}

.book-share-button-hover {
  background: #fff6f0;
  transform: scale(0.96);
  box-shadow:
    0 0 0 1rpx rgba(166, 75, 62, 0.20),
    0 4rpx 10rpx rgba(93, 61, 42, 0.05);
}

.error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff1f3;
  color: #b84a5a;
  font-size: 28rpx;
  line-height: 1.45;
  word-break: break-word;
}

.status-panel,
.automation-panel,
.empty-panel,
.chapter-card {
  width: 100%;
  border: 1rpx solid #e8d8c3;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(93, 61, 42, 0.06);
  box-sizing: border-box;
}

.status-panel {
  min-height: 116rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  box-sizing: border-box;
}

.progress-panel {
  flex-direction: column;
  align-items: stretch;
}

.progress-main {
  min-width: 0;
}

.progress-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.progress-actions {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 12rpx;
}

.progress-actions > button {
  width: 100%;
  min-width: 0;
}

.workspace-tabs {
  display: flex;
  gap: 8rpx;
  margin: 24rpx 0;
  padding: 8rpx;
  border: 1rpx solid rgba(98, 64, 54, 0.16);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.68);
}

.workspace-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  box-sizing: border-box;
  min-height: 44px;
  margin: 0;
  padding: 12rpx 20rpx;
  border: 0;
  border-radius: 8rpx;
  background: transparent;
  color: #765f57;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
}

.workspace-tab::after {
  border: 0;
}

.workspace-tab.active {
  background: #fff;
  color: #4a211b;
  box-shadow: 0 4rpx 12rpx rgba(75, 43, 33, 0.1);
}

.workspace-tab-count {
  min-width: 34rpx;
  padding: 2rpx 9rpx;
  border-radius: 999rpx;
  background: #f8e8e3;
  color: #a3483d;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
}

.status-title {
  display: block;
  color: #2b1713;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 46rpx;
  word-break: break-word;
}

.status-meta {
  display: block;
  margin-top: 8rpx;
  color: #7b6f68;
  font-size: 26rpx;
  line-height: 38rpx;
}

.progress-note {
  display: block;
  margin-top: 10rpx;
  color: #a64b3e;
  font-size: 24rpx;
  line-height: 34rpx;
}

.automation-panel {
  margin-top: 22rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.automation-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.automation-title {
  display: block;
  color: #2b1713;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.automation-meta {
  display: block;
  margin-top: 6rpx;
  color: #6d5f58;
  font-size: 23rpx;
  line-height: 1.35;
}

.automation-count {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff3ef;
  color: #8f3e35;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
}

.automation-head-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.automation-clear {
  min-width: 128rpx;
  min-height: 80rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  color: #9c463b;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 80rpx;
}

.automation-clear::after {
  border: 0;
}

.automation-clear[disabled] {
  color: #a59a94;
  background: transparent;
}

.automation-error {
  display: block;
  margin-top: 16rpx;
  color: #b42348;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
}

.automation-item {
  margin-top: 14rpx;
  padding: 16rpx;
  border: 2rpx solid #f4dfc6;
  border-radius: 18rpx;
  background: #fcf7ed;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.automation-item-main {
  min-width: 0;
  flex: 1;
}

.automation-item-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.automation-item-title {
  color: #7b4a40;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
}

.automation-item-status {
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #8f3e35;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
}

.automation-item-summary {
  display: block;
  margin-top: 10rpx;
  color: #3a2119;
  font-size: 25rpx;
  line-height: 1.42;
  word-break: break-word;
}

.automation-item-detail {
  display: block;
  margin-top: 8rpx;
  color: #6c4238;
  font-size: 23rpx;
  line-height: 1.38;
  word-break: break-word;
}

.automation-item-suggestion {
  display: block;
  margin-top: 10rpx;
  padding: 10rpx 12rpx;
  border-radius: 10rpx;
  background: #fff8ef;
  color: #7b4a40;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
  word-break: break-word;
}

.automation-suggestions {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.automation-suggestion-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 10rpx 12rpx;
  border-radius: 10rpx;
  background: #fff8ef;
}

.automation-suggestion-label {
  flex: 0 0 auto;
  padding: 3rpx 8rpx;
  border-radius: 6rpx;
  background: #7b4a40;
  color: #fff8ef;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1.25;
}

.automation-suggestion-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}

.automation-suggestion-body {
  color: #5f3229;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.36;
  word-break: break-word;
}

.automation-suggestion-chapter {
  color: #8e675c;
  font-size: 20rpx;
  line-height: 1.25;
}

.automation-detail-toggle {
  display: inline-flex;
  margin-top: 12rpx;
  color: #8f3e35;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.3;
}

.automation-detail-list {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.automation-detail-row {
  padding: 14rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 1rpx solid #f0dfcb;
}

.automation-detail-row-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.automation-detail-title {
  color: #3a2119;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.35;
}

.automation-detail-chapter {
  flex: 0 1 auto;
  color: #8f3e35;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: right;
}

.automation-detail-preview {
  display: block;
  margin-top: 8rpx;
  color: #5a3b31;
  font-size: 22rpx;
  line-height: 1.38;
  word-break: break-word;
}

.automation-detail-meta {
  display: block;
  margin-top: 6rpx;
  color: #806c60;
  font-size: 20rpx;
  line-height: 1.3;
}

.automation-item-meta {
  display: block;
  margin-top: 8rpx;
  color: #806c60;
  font-size: 22rpx;
  line-height: 1.3;
}

.automation-ack {
  flex: 0 0 128rpx;
  width: 128rpx;
  height: 80rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 16rpx;
  background: #a64b3e;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 80rpx;
}

.automation-ack::after {
  border: 0;
}

.automation-ack[disabled] {
  opacity: 0.58;
}

.status-pill,
.source-count,
.draft-status,
.draft-version,
.draft-count {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
}

.status-pill {
  background: #a64b3e;
  color: #ffffff;
}

.draft-status.confirmed,
.chapter-summary-status.confirmed {
  background: var(--ui-success-surface);
  color: var(--ui-success-text);
}

.source-count,
.draft-status,
.draft-version,
.draft-count {
  background: #fff3ef;
  color: #8f3e35;
}

.empty-panel {
  margin-top: 24rpx;
  padding: 48rpx 34rpx;
  color: #7b6f68;
  font-size: 30rpx;
  line-height: 1.5;
}

.empty-icon {
  width: 92rpx;
  height: 92rpx;
  margin-bottom: 22rpx;
}

.empty-title {
  display: block;
  color: #2b1713;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.3;
}

.empty-copy {
  display: block;
  margin-top: 14rpx;
  word-break: break-word;
}

.section {
  margin-top: 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 28rpx 0 16rpx;
}

.chapter-section-head {
  align-items: center;
}

.section-head-copy {
  min-width: 0;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
}

.section-head-action {
  flex: 0 0 auto;
  min-width: 168rpx;
  height: 80rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff7f2;
  color: #8f3e35;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.06),
    0 4rpx 10rpx rgba(93, 61, 42, 0.05);
  transition-property: transform, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.section-head-action::after {
  border: 0;
}

.section-head-action-active {
  background: #fff0e8;
  transform: scale(0.96);
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.08);
}

.section-head-action[disabled] {
  opacity: 0.5;
}

.section-title {
  color: #7b4a40;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
}

.section-count {
  color: #a64b3e;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.field-block {
  margin-top: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #7b4a40;
  font-size: 26rpx;
  font-weight: 800;
}

.title-input,
.chapter-title-input {
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid #e8d8c3;
  border-radius: 18rpx;
  background: #ffffff;
  color: #2b1713;
}

.title-input,
.chapter-title-input {
  min-height: 84rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 84rpx;
}

.chapter-card {
  margin-top: 22rpx;
  padding: 32rpx;
}

.chapter-card.summary {
  padding: 28rpx;
}

.chapter-head,
.actions-row {
  display: flex;
  align-items: center;
}

.chapter-head {
  justify-content: space-between;
  gap: 20rpx;
}

.chapter-summary-card {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.chapter-order-panel {
  overflow: hidden;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.06),
    0 6rpx 20rpx rgba(93, 61, 42, 0.06);
}

.chapter-order-row {
  min-height: 112rpx;
  padding: 16rpx 18rpx 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
}

.chapter-order-row + .chapter-order-row {
  border-top: 1rpx solid rgba(43, 23, 19, 0.08);
}

.chapter-order-copy {
  min-width: 0;
  flex: 1;
}

.chapter-order-index,
.chapter-order-title {
  display: block;
}

.chapter-order-index {
  color: #8f6d62;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.25;
}

.chapter-order-title {
  margin-top: 5rpx;
  color: #2b1713;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
  word-break: break-word;
}

.chapter-order-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.chapter-order-edit,
.chapter-order-button {
  height: 80rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff7f2;
  color: #8f3e35;
  font-weight: 800;
  line-height: 1;
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.06);
  transition-property: transform, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.chapter-order-edit {
  width: 92rpx;
  font-size: 23rpx;
}

.chapter-order-button {
  width: 80rpx;
  font-size: 34rpx;
}

.chapter-order-edit::after,
.chapter-order-button::after {
  border: 0;
}

.chapter-order-button-active {
  background: #fff0e8;
  transform: scale(0.96);
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.08);
}

.chapter-order-edit[disabled],
.chapter-order-button[disabled] {
  opacity: 0.42;
}

.chapter-summary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.chapter-summary-title-block {
  min-width: 0;
  flex: 1;
}

.chapter-summary-title {
  display: block;
  margin-top: 5rpx;
  color: #2b1713;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 46rpx;
  word-break: break-word;
}

.chapter-summary-meta {
  display: block;
  margin-top: 6rpx;
  color: #7b6f68;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
}

.chapter-summary-status {
  flex: 0 0 auto;
  max-width: 176rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff2d9;
  color: #9a6a24;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.25;
  text-align: center;
  box-sizing: border-box;
}

.chapter-summary-status text {
  display: block;
}

.chapter-summary-status-hint {
  margin-top: 2rpx;
  font-size: 18rpx;
  font-weight: 600;
}

.chapter-summary-error,
.chapter-audio-status {
  display: block;
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.35;
}

.chapter-summary-error {
  color: #8f3e35;
  font-weight: 700;
}

.chapter-audio-status {
  color: #7b6f68;
  font-weight: 600;
}

.chapter-summary-actions {
  width: 100%;
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 176rpx;
  gap: 12rpx;
}

.chapter-summary-actions .primary-button,
.chapter-summary-actions .ghost-button {
  width: 100%;
  min-width: 0;
}

.chapter-index {
  display: block;
  color: #7b4a40;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
}

.chapter-title-input {
  margin-top: 22rpx;
}

.source-preview {
  display: block;
  margin-top: 18rpx;
  color: #7b6f68;
  font-size: 26rpx;
  line-height: 1.45;
  word-break: break-word;
}

.source-preview {
  flex: 1;
  min-width: 0;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #fff8ef;
}

.source-summary-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.source-toggle-button {
  flex: 0 0 auto;
  min-width: 212rpx;
  height: 80rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff3ef;
  color: #8f3e35;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
  box-sizing: border-box;
  white-space: nowrap;
}

.source-toggle-button::after {
  border: 0;
}

.source-ref-list {
  margin-top: 14rpx;
  border: 2rpx solid #f2ddc8;
  border-radius: 18rpx;
  overflow: hidden;
}

.source-ref-row {
  padding: 16rpx 18rpx;
  border-top: 2rpx solid #f7eadc;
  background: #fffdf9;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  box-sizing: border-box;
}

.source-ref-row:first-child {
  border-top: 0;
}

.source-ref-row.selected {
  background: #fff9f3;
}

.source-ref-main {
  flex: 1 1 auto;
  min-width: 0;
  padding: 6rpx 8rpx;
  border-radius: 12rpx;
}

.source-ref-main-active {
  background: #fff9f3;
}

.source-ref-label {
  display: block;
  color: #a64b3e;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.25;
}

.source-ref-text {
  display: block;
  margin-top: 6rpx;
  color: #3a2119;
  font-size: 25rpx;
  line-height: 1.38;
  word-break: break-word;
}

.source-split-toggle {
  flex: 0 0 112rpx;
  width: 112rpx;
  height: 80rpx;
  margin: 2rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f4efe8;
  color: #6d4d40;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.2;
}

.source-split-toggle.selected {
  background: #a64b3e;
  color: #ffffff;
}

.source-split-toggle::after {
  border: 0;
}

.source-split-toggle[disabled] {
  opacity: 0.56;
}

.draft-pending {
  display: block;
  margin-top: 12rpx;
  color: #8f3e35;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
}

.draft-pending.compact {
  margin-top: 0;
  font-size: 23rpx;
}

.guest-panel {
  margin-top: 24rpx;
  padding: 46rpx 34rpx;
}

.guest-steps {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #fff8ef;
}

.guest-steps text {
  display: block;
  color: #3a2119;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.55;
}

.tts-progress-bar {
  height: 8rpx;
  border-radius: 999rpx;
  background: #eadcc9;
  overflow: hidden;
}

.tts-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: #a64b3e;
  transition: width 180ms ease;
}

.tts-highlight-text {
  display: block;
  margin-top: 18rpx;
  color: #2b1713;
  font-size: 28rpx;
  line-height: 1.68;
  white-space: pre-wrap;
  word-break: break-word;
}

.tts-spoken {
  color: #8f8078;
}

.tts-current {
  padding: 2rpx 4rpx;
  border-radius: 6rpx;
  background: #ffe08a;
  color: #2b1713;
  font-weight: 800;
}

.tts-remaining {
  color: #2b1713;
}

.actions-row {
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 26rpx;
}

.actions-row.compact {
  margin-top: 20rpx;
}

.structure-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 18rpx;
}

.structure-action-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.structure-action-row .structure-button,
.structure-picker {
  flex: 1 1 0;
  min-width: 0;
}

.structure-button {
  height: 80rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f4efe8;
  color: #6d4d40;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
  box-sizing: border-box;
}

.structure-button::after {
  border: 0;
}

.structure-button[disabled],
.structure-button.disabled,
.picker-button.disabled {
