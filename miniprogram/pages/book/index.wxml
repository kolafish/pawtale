<view class="book-page">
  <view class="top-row">
    <view class="back-hit" bindtap="openHome">
      <text class="back-mark">‹</text>
    </view>
    <view class="title-block">
      <text class="page-title">成书</text>
      <text class="page-meta">{{projectTitle || "我的回忆录"}} · {{stageText}}</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view wx:if="{{needsLogin}}" class="empty-panel guest-panel">
    <image class="empty-icon" src="/assets/memoir-gramophone.png" mode="aspectFit" />
    <text class="empty-title">浏览整理成书</text>
    <text class="empty-copy">登录后可以把讲述记录归入章节，确认章节正文，再生成全书和章节朗读。</text>
    <view class="guest-steps">
      <text>1. 先生成章节规划</text>
      <text>2. 再逐章整理正文</text>
      <text>3. 最后合成全书朗读</text>
    </view>
    <view class="actions-row">
      <button class="primary-button" bindtap="openLogin">登录后整理</button>
      <button class="ghost-button" bindtap="openHome">返回首页</button>
    </view>
  </view>

  <block wx:else>
  <view wx:if="{{!projectId}}" class="empty-panel">
    <image class="empty-icon" src="/assets/memoir-gramophone.png" mode="aspectFit" />
    <text class="empty-title">还没有回忆录</text>
    <text class="empty-copy">先创建一本回忆录并设置讲述资料，完成语音聊天后再整理成书。</text>
    <view class="actions-row">
      <button class="primary-button" bindtap="createProject">创建回忆录</button>
      <button class="ghost-button" bindtap="openHome">返回首页</button>
    </view>
  </view>

  <block wx:else>
  <view class="status-panel">
    <view>
      <text class="status-title">{{planTitle || "整理成书"}}</text>
      <text class="status-meta">{{progressText}}</text>
    </view>
    <text class="status-pill">{{stageText}}</text>
  </view>

  <view wx:if="{{automationEventLoading || automationEventError || automationEventItems.length}}" class="automation-panel">
    <view class="automation-head">
      <view>
        <text class="automation-title">AI 自动处理</text>
        <text class="automation-meta">记录 AI 已自动整理、补写或发现的问题</text>
      </view>
      <text class="automation-count">{{automationEventLoading ? "同步中" : automationEventItems.length + " 条"}}</text>
    </view>
    <text wx:if="{{automationEventError}}" class="automation-error">{{automationEventError}}</text>
    <view wx:for="{{automationEventItems}}" wx:key="id" class="automation-item {{item.eventType}}">
      <view class="automation-item-main">
        <view class="automation-item-title-row">
          <text class="automation-item-title">{{item.titleText}}</text>
          <text class="automation-item-status">{{item.statusText}}</text>
        </view>
        <text class="automation-item-summary">{{item.summaryText}}</text>
        <text wx:if="{{item.detailText}}" class="automation-item-detail">{{item.detailText}}</text>
        <view
          wx:if="{{item.hasDetails}}"
          class="automation-detail-toggle"
          data-id="{{item.id}}"
          bindtap="toggleAutomationEventDetails"
        >
          <text>{{item.detailToggleText}}</text>
        </view>
        <view wx:if="{{item.hasDetails && item.detailExpanded}}" class="automation-detail-list">
          <view wx:for="{{item.detailItems}}" wx:key="id" wx:for-item="detail" class="automation-detail-row">
            <view class="automation-detail-row-head">
              <text class="automation-detail-title">{{detail.titleText}}</text>
              <text class="automation-detail-chapter">{{detail.chapterText}}</text>
            </view>
            <text wx:if="{{detail.previewText}}" class="automation-detail-preview">{{detail.previewText}}</text>
            <text wx:if="{{detail.metaText}}" class="automation-detail-meta">{{detail.metaText}}</text>
          </view>
        </view>
        <text class="automation-item-meta">{{item.metaText}}</text>
      </view>
      <button
        class="automation-ack"
        data-id="{{item.id}}"
        data-event-ids="{{item.eventIdsText}}"
        data-action="{{item.actionKind}}"
        data-utterance-id="{{item.primaryUtteranceId}}"
        loading="{{item.busy}}"
        disabled="{{item.busy || !item.canAct}}"
        bindtap="acknowledgeAutomationEvent"
      >
        {{item.actionText}}
      </button>
    </view>
  </view>

  <view wx:if="{{plan}}" class="book-voice-assistant {{bookVoiceAssistantExpanded ? 'expanded' : 'collapsed'}}">
    <view class="book-voice-header">
      <view class="book-voice-copy">
        <text class="book-voice-title">成书语音助手</text>
        <text class="book-voice-hint">{{bookVoiceAssistantHint}}</text>
        <text class="book-voice-status">{{bookVoiceAssistantStatusText}}</text>
      </view>
      <view class="book-voice-actions">
        <button
          class="book-voice-button"
          loading="{{ttsBusyTarget === 'outline'}}"
          disabled="{{loading || generatingPlan || confirmingPlan || updatingPlanStructure || ttsBusyTarget}}"
          bindtap="playBookOutlineAudio"
        >
          {{ttsBusyTarget === "outline" ? "准备目录" : (playingTarget === "outline" ? "停止目录" : "听目录")}}
        </button>
        <button
          class="book-voice-button primary"
          loading="{{bookVoiceAssistantBusy && !bookVoiceAssistantSpeakingLineId}}"
          disabled="{{loading || generatingPlan || confirmingPlan || updatingPlanStructure || generatingBook || (bookVoiceAssistantBusy && !bookVoiceAssistantSpeakingLineId)}}"
          bindtap="startBookVoiceCommand"
        >
          {{bookVoiceAssistantListening ? "停止" : (bookVoiceAssistantBusy ? (bookVoiceAssistantSpeakingLineId ? "打断 AI" : "处理中") : "语音修改")}}
        </button>
      </view>
    </view>

    <view wx:if="{{bookVoiceAssistantExpanded}}" class="book-voice-expanded">
      <view class="book-voice-meter">
        <view class="book-voice-meter-track">
          <view class="book-voice-meter-fill" style="width: {{bookVoiceAudioLevelPercent}}%;"></view>
        </view>
        <text class="book-voice-meter-text">{{bookVoiceCaptureStateText}}</text>
      </view>

      <view class="book-voice-dialog">
        <view
          wx:for="{{bookVoiceTranscriptLines}}"
          wx:key="id"
          class="book-voice-message {{item.role === 'assistant' ? 'assistant' : 'user'}}"
        >
          <text class="book-voice-message-role">{{item.role === "assistant" ? "AI" : "我"}}</text>
          <block wx:if="{{item.id === bookVoiceAssistantSpeakingLineId && bookTTSActiveTarget === 'book-voice-assistant'}}">
            <text class="book-voice-message-text assistant-speaking" selectable>
              <text class="tts-spoken">{{bookTTSSpokenText}}</text>
              <text wx:if="{{bookTTSCurrentText}}" class="tts-current">{{bookTTSCurrentText}}</text>
              <text class="tts-remaining">{{bookTTSRemainingText}}</text>
            </text>
          </block>
          <block wx:else>
            <text class="book-voice-message-text">{{item.text}}</text>
          </block>
        </view>
        <view wx:if="{{bookVoiceLiveText}}" class="book-voice-message user live">
          <text class="book-voice-message-role">我</text>
          <text class="book-voice-message-text">{{bookVoiceLiveText}}</text>
        </view>
        <text wx:if="{{!bookVoiceTranscriptLines.length && !bookVoiceLiveText}}" class="book-voice-dialog-empty">
          点击语音修改后，我会实时显示你说的话和 AI 的回复。
        </text>
      </view>

      <view wx:if="{{playingTarget === 'outline' && bookTTSActiveTarget === 'outline'}}" class="book-voice-playback">
        <view class="tts-progress-bar">
          <view class="tts-progress-fill" style="width: {{bookTTSProgressPercent}}%;"></view>
        </view>
        <text class="tts-highlight-text" selectable>
          <text class="tts-spoken">{{bookTTSSpokenText}}</text>
          <text wx:if="{{bookTTSCurrentText}}" class="tts-current">{{bookTTSCurrentText}}</text>
          <text class="tts-remaining">{{bookTTSRemainingText}}</text>
        </text>
      </view>

      <view wx:if="{{bookVoiceCommandText || bookVoiceCommandDetailText || bookVoiceCommandSummary}}" class="book-voice-command-preview {{bookVoiceCommandResponseKind || 'action_preview'}}">
        <view class="book-voice-command-head">
          <text class="book-voice-command-label">{{bookVoiceCommandIntentLabel || "已识别"}}</text>
          <text class="book-voice-command-state">{{bookVoiceCommandStateText || (bookVoiceCommandRequiresConfirmation ? "待确认" : "已识别")}}</text>
        </view>
        <text wx:if="{{bookVoiceCommandText}}" class="book-voice-command-text">“{{bookVoiceCommandText}}”</text>
        <view wx:if="{{bookVoiceCommandDetailText || bookVoiceCommandSummary}}" class="book-voice-command-body">
          <text wx:if="{{bookVoiceCommandPanelTitle}}" class="book-voice-command-panel-title">{{bookVoiceCommandPanelTitle}}</text>
          <text class="book-voice-command-summary">{{bookVoiceCommandDetailText || bookVoiceCommandSummary}}</text>
        </view>
        <view wx:if="{{bookVoiceCommandCanExecute || bookVoiceCommandUndoText || bookVoiceCommandRequiresConfirmation}}" class="book-voice-command-actions">
          <button
            wx:if="{{!bookVoiceCommandUndoText}}"
            class="book-voice-command-button"
            disabled="{{bookVoiceCommandExecuting || updatingPlanStructure}}"
            bindtap="clearBookVoiceCommandPreview"
          >
            取消
          </button>
          <button
            wx:if="{{bookVoiceCommandCanExecute}}"
            class="book-voice-command-button primary"
            loading="{{bookVoiceCommandExecuting}}"
            disabled="{{bookVoiceCommandExecuting || updatingPlanStructure}}"
            bindtap="executeBookVoiceCommand"
          >
            {{bookVoiceCommandActionText}}
          </button>
          <button
            wx:if="{{bookVoiceCommandUndoText}}"
            class="book-voice-command-button"
            loading="{{bookVoiceCommandExecuting}}"
            disabled="{{bookVoiceCommandExecuting || updatingPlanStructure}}"
            bindtap="undoBookVoiceCommand"
          >
            {{bookVoiceCommandUndoText}}
          </button>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{sourceCoverageNotice}}" class="coverage-section">
    <view class="coverage-head">
      <view class="coverage-copy">
        <view class="coverage-title-row">
          <text class="coverage-title">待收录讲述</text>
          <text class="coverage-count">{{uncoveredSourceDisplayText}}</text>
        </view>
        <text class="coverage-meta">{{sourceCoverageNotice}}，新录音不会自动改动已确认章节和全书。</text>
      </view>
      <button class="coverage-link" bindtap="openTranscripts">讲述记录</button>
    </view>

    <view wx:if="{{plan && chapterPickerOptions.length && uncoveredSources.length}}" class="coverage-source-list">
      <view wx:for="{{uncoveredSources}}" wx:key="utterance_id" class="coverage-source-card">
        <view
          class="coverage-source-main"
          data-id="{{item.utterance_id}}"
          bindtap="openTranscripts"
          hover-class="coverage-source-main-active"
        >
          <text class="coverage-source-time">{{item.createdAtText}}</text>
          <text class="coverage-source-text">{{item.previewText}}</text>
        </view>
        <view class="coverage-source-actions">
          <picker
            mode="selector"
            range="{{chapterPickerOptions}}"
            range-key="label"
            data-id="{{item.utterance_id}}"
            disabled="{{assigningSourceId || updatingPlanStructure}}"
            bindchange="assignUncoveredSource"
          >
            <view class="coverage-assign {{assigningSourceId === item.utterance_id ? 'loading' : ''}}">
              {{assigningSourceId === item.utterance_id ? "归入中" : "归入章节"}}
            </view>
          </picker>
        </view>
      </view>
    </view>

    <view wx:elif="{{!plan}}" class="coverage-empty">
      <text>生成章节规划后可以收录这些讲述。</text>
    </view>
  </view>

  <view wx:if="{{loading && !plan}}" class="empty-panel">
    <text>正在加载</text>
  </view>

  <view wx:elif="{{!plan}}" class="empty-panel">
    <image class="empty-icon" src="/assets/memoir-gramophone.png" mode="aspectFit" />
    <text class="empty-title">从讲述记录生成章节</text>
    <text class="empty-copy">系统会先把当前回忆录里的讲述内容划分为若干章节。你确认章节后，再逐章生成正文。</text>
    <view class="actions-row">
      <button
        class="primary-button"
        loading="{{generatingPlan}}"
        disabled="{{loading || generatingPlan || !projectId}}"
        bindtap="generatePlan"
      >
        生成章节规划
      </button>
      <button class="ghost-button" disabled="{{generatingPlan}}" bindtap="openTranscripts">
        查看记录
      </button>
    </view>
  </view>

  <view wx:elif="{{stage === 'plan_draft'}}" class="section">
    <view class="field-block">
      <text class="field-label">目录名称</text>
      <input
        class="title-input"
        value="{{planTitle}}"
        bindinput="changePlanTitle"
        maxlength="120"
      />
    </view>

    <view class="section-head">
      <text class="section-title">确认章节</text>
      <text class="section-count">{{chapters.length}} 章</text>
    </view>

    <view wx:for="{{chapters}}" wx:key="id" id="chapter-editor-{{item.id}}" class="chapter-card">
      <view class="chapter-head">
        <text class="chapter-index">第 {{index + 1}} 章</text>
        <text class="source-count">{{item.sourceCount}} 条素材</text>
      </view>

      <input
        class="chapter-title-input"
        value="{{item.editingTitle}}"
        data-id="{{item.id}}"
        bindinput="changeChapterTitle"
        maxlength="80"
      />

      <view class="source-summary-row">
        <text class="source-preview">{{item.sourceSummary}}</text>
        <button
          wx:if="{{item.sourceViews.length}}"
          class="source-toggle-button"
          data-id="{{item.id}}"
          bindtap="toggleChapterSources"
        >
          {{item.sourceToggleText}}
        </button>
      </view>

      <view wx:if="{{item.sourceViews.length && item.sourceListExpanded}}" class="source-ref-list">
        <view wx:for="{{item.sourceViews}}" wx:for-item="source" wx:key="utterance_id" class="source-ref-row {{source.splitSelected ? 'selected' : ''}}">
          <view
            class="source-ref-main"
            data-id="{{source.utterance_id}}"
            bindtap="openTranscripts"
            hover-class="coverage-source-main-active"
          >
            <text class="source-ref-label">{{source.labelText}}</text>
            <text class="source-ref-text">{{source.previewText}}</text>
          </view>
          <button
            wx:if="{{item.sourceViews.length > 1}}"
            class="source-split-toggle {{source.splitSelected ? 'selected' : ''}}"
            data-id="{{item.id}}"
            data-utterance-id="{{source.utterance_id}}"
            bindtap="toggleSplitSource"
            disabled="{{confirmingPlan || updatingPlanStructure}}"
          >
            {{source.splitSelected ? "已选" : "选择"}}
          </button>
        </view>
      </view>

      <view class="structure-actions">
        <view class="structure-action-row">
          <button
            class="structure-button"
            data-id="{{item.id}}"
            data-direction="up"
            bindtap="moveChapter"
            disabled="{{confirmingPlan || updatingPlanStructure || !item.canMoveUp}}"
          >
            上移
          </button>
          <button
            class="structure-button"
            data-id="{{item.id}}"
            data-direction="down"
            bindtap="moveChapter"
            disabled="{{confirmingPlan || updatingPlanStructure || !item.canMoveDown}}"
          >
            下移
          </button>
        </view>
        <view class="structure-action-row">
          <picker
            class="structure-picker"
            range="{{item.mergeTargetOptions}}"
            range-key="label"
            data-id="{{item.id}}"
            disabled="{{confirmingPlan || updatingPlanStructure || !item.mergeTargetOptions.length}}"
            bindchange="mergeChapterInto"
          >
            <view class="structure-button picker-button {{confirmingPlan || updatingPlanStructure || !item.mergeTargetOptions.length ? 'disabled' : ''}}">
              合并到
            </view>
          </picker>
          <button
            class="structure-button picker-button"
            data-id="{{item.id}}"
            disabled="{{confirmingPlan || updatingPlanStructure || !item.canSplitSelectedSources}}"
            bindtap="splitSelectedChapterSources"
          >
            {{item.splitActionText}}
          </button>
        </view>
      </view>

      <view class="actions-row compact">
        <button
          class="ghost-button"
          data-id="{{item.id}}"
          loading="{{titleBusyTarget === item.id}}"
          bindtap="generateChapterTitle"
          disabled="{{confirmingPlan || generatingPlan || titleBusyTarget || updatingPlanStructure}}"
        >
          {{titleBusyTarget === item.id ? "起名中" : "AI 起名"}}
        </button>
        <button
          class="danger-button"
          data-id="{{item.id}}"
          bindtap="removeChapter"
          disabled="{{confirmingPlan || updatingPlanStructure || chapters.length <= 1}}"
        >
          删除本章·保留讲述
        </button>
      </view>
    </view>

    <view class="sticky-actions">
      <button
        class="ghost-button"
        loading="{{generatingPlan}}"
        disabled="{{generatingPlan || confirmingPlan}}"
        bindtap="generatePlan"
      >
        重新规划
      </button>
      <button
        class="primary-button"
        loading="{{confirmingPlan}}"
        disabled="{{generatingPlan || confirmingPlan || !chapters.length}}"
        bindtap="confirmPlan"
      >
        确认章节
      </button>
    </view>
  </view>

  <view wx:else class="section">
    <view class="section-head">
      <text class="section-title">逐章成稿</text>
      <text class="section-count">{{confirmedDraftCount}}/{{totalChapterCount}} 已确认</text>
    </view>

    <view wx:for="{{chapters}}" wx:key="id" id="chapter-editor-{{item.id}}" class="chapter-card">
      <view class="chapter-head">
        <view class="chapter-title-block">
          <text class="chapter-index">第 {{index + 1}} 章</text>
          <text class="source-count">{{item.sourceCount}} 条素材</text>
        </view>
        <text class="draft-status {{item.draft && item.draft.status === 'confirmed' ? 'confirmed' : ''}}">
          {{item.draftStatusText}}
        </text>
      </view>

      <view class="chapter-title-edit-row">
        <input
          class="chapter-title-inline-input"
          value="{{item.editingTitle}}"
          placeholder="输入章节名"
          data-id="{{item.id}}"
          bindinput="changeChapterTitle"
          maxlength="80"
          disabled="{{updatingPlanStructure || titleBusyTarget === item.id}}"
        />
        <view class="chapter-title-actions">
          <button
            class="title-action-button"
            data-id="{{item.id}}"
            loading="{{titleBusyTarget === item.id}}"
            bindtap="generateChapterTitle"
            disabled="{{updatingPlanStructure || item.draftBusy || titleBusyTarget}}"
          >
            {{titleBusyTarget === item.id ? "起名中" : "AI 起名"}}
          </button>
          <button
            class="title-action-button primary"
            data-id="{{item.id}}"
            bindtap="saveChapterTitle"
            disabled="{{updatingPlanStructure || item.draftBusy || titleBusyTarget}}"
          >
            保存章名
          </button>
        </view>
      </view>

      <view class="source-summary-row">
        <text class="source-preview">{{item.sourceSummary}}</text>
        <button
          wx:if="{{item.sourceViews.length}}"
          class="source-toggle-button"
          data-id="{{item.id}}"
          bindtap="toggleChapterSources"
        >
          {{item.sourceToggleText}}
        </button>
      </view>
      <view wx:if="{{item.sourceViews.length && item.sourceListExpanded}}" class="source-ref-list">
        <view wx:for="{{item.sourceViews}}" wx:for-item="source" wx:key="utterance_id" class="source-ref-row {{source.splitSelected ? 'selected' : ''}}">
          <view
            class="source-ref-main"
            data-id="{{source.utterance_id}}"
            bindtap="openTranscripts"
            hover-class="coverage-source-main-active"
          >
            <text class="source-ref-label">{{source.labelText}}</text>
            <text class="source-ref-text">{{source.previewText}}</text>
          </view>
          <button
            wx:if="{{item.sourceViews.length > 1}}"
            class="source-split-toggle {{source.splitSelected ? 'selected' : ''}}"
            data-id="{{item.id}}"
            data-utterance-id="{{source.utterance_id}}"
            bindtap="toggleSplitSource"
            disabled="{{updatingPlanStructure || item.draftBusy}}"
          >
            {{source.splitSelected ? "已选" : "选择"}}
          </button>
        </view>
      </view>
      <text wx:if="{{item.sourceChangeNotice}}" class="draft-pending">{{item.sourceChangeNotice}}</text>

      <view class="structure-actions">
        <view class="structure-action-row">
          <button
            class="structure-button"
            data-id="{{item.id}}"
            data-direction="up"
            bindtap="moveChapter"
            disabled="{{updatingPlanStructure || item.draftBusy || !item.canMoveUp}}"
          >
            上移
          </button>
          <button
            class="structure-button"
            data-id="{{item.id}}"
            data-direction="down"
            bindtap="moveChapter"
            disabled="{{updatingPlanStructure || item.draftBusy || !item.canMoveDown}}"
          >
            下移
          </button>
        </view>
        <view class="structure-action-row">
          <picker
            class="structure-picker"
            range="{{item.mergeTargetOptions}}"
            range-key="label"
            data-id="{{item.id}}"
            disabled="{{updatingPlanStructure || item.draftBusy || !item.mergeTargetOptions.length}}"
            bindchange="mergeChapterInto"
          >
            <view class="structure-button picker-button {{updatingPlanStructure || item.draftBusy || !item.mergeTargetOptions.length ? 'disabled' : ''}}">
              合并到
            </view>
          </picker>
          <button
            class="structure-button picker-button"
            data-id="{{item.id}}"
            disabled="{{updatingPlanStructure || item.draftBusy || !item.canSplitSelectedSources}}"
            bindtap="splitSelectedChapterSources"
          >
            {{item.splitActionText}}
          </button>
        </view>
      </view>

      <view wx:if="{{!item.draft || !item.draft.latest_version}}" class="draft-empty">
        <text>还没有章节正文</text>
      </view>

      <view wx:else class="draft-editor">
        <view class="draft-meta-row">
          <text class="draft-version">{{item.draftVersionText}}</text>
          <text class="draft-count">{{item.draftCharCount}} 字</text>
        </view>
        <textarea
          class="draft-textarea"
          value="{{item.draftContent}}"
          data-id="{{item.id}}"
          bindinput="changeDraftContent"
          maxlength="-1"
          auto-height
          cursor-spacing="24"
        />
        <view
          wx:if="{{playingTarget === item.ttsTarget && bookTTSActiveTarget === item.ttsTarget}}"
          class="tts-highlight-card"
        >
          <view class="tts-progress-bar">
            <view class="tts-progress-fill" style="width: {{bookTTSProgressPercent}}%;"></view>
          </view>
          <text class="tts-highlight-text" selectable>
            <text class="tts-spoken">{{bookTTSSpokenText}}</text>
            <text wx:if="{{bookTTSCurrentText}}" class="tts-current">{{bookTTSCurrentText}}</text>
            <text class="tts-remaining">{{bookTTSRemainingText}}</text>
          </text>
        </view>
      </view>

      <view wx:if="{{item.draftError}}" class="chapter-error">{{item.draftError}}</view>

      <view class="actions-row">
        <button
          class="ghost-button"
          data-id="{{item.id}}"
          disabled="{{updatingPlanStructure || item.draftBusy || item.draftChanged || (item.removedSourceCount && !item.sourceCount)}}"
          bindtap="generateChapterDraft"
        >
          {{item.draftActionText}}
        </button>
        <button
          class="ghost-button"
          data-id="{{item.id}}"
          disabled="{{updatingPlanStructure || item.draftBusy || !item.draftChanged}}"
          bindtap="saveChapterDraft"
        >
          保存修改
        </button>
        <button
          class="primary-button"
          data-id="{{item.id}}"
          disabled="{{updatingPlanStructure || item.draftBusy || !item.draft || !item.draft.latest_version || item.draft.status === 'confirmed' || item.draftChanged}}"
          bindtap="confirmChapterDraft"
        >
          确认本章
        </button>
        <button
          class="ghost-button"
          data-id="{{item.id}}"
          loading="{{ttsBusyTarget === item.ttsTarget}}"
          disabled="{{updatingPlanStructure || item.draftBusy || item.draftChanged || !item.draft || !item.draft.latest_version || ttsBusyTarget}}"
          bindtap="playChapterAudio"
        >
          {{ttsBusyTarget === item.ttsTarget ? "准备朗读" : (playingTarget === item.ttsTarget ? "停止朗读" : "朗读本章")}}
        </button>
        <button
          class="danger-button"
          data-id="{{item.id}}"
          disabled="{{updatingPlanStructure || item.draftBusy || chapters.length <= 1}}"
          bindtap="deleteConfirmedChapter"
        >
          删除本章·保留讲述
        </button>
      </view>
    </view>

    <view class="book-output-card">
      <view class="section-head inline">
        <text class="section-title">全书成稿</text>
        <text class="section-count">{{bookVersionText}}</text>
      </view>

      <view wx:if="{{!allChaptersConfirmed}}" class="draft-empty">
        <text>确认所有章节后，可以把当前章节内容合成为全书。</text>
      </view>
      <view wx:elif="{{hasDraftChanges}}" class="draft-empty">
        <text>当前有未保存的章节修改，保存后再生成全书。</text>
      </view>
      <view wx:else>
        <view class="book-output-meta">
          <text>{{bookContent ? bookCharCount + " 字" : "尚未生成正文"}}</text>
          <text>按已确认章节顺序合成</text>
        </view>
        <picker
          wx:if="{{bookVersionOptions.length > 1}}"
          class="book-version-picker"
          range="{{bookVersionOptions}}"
          range-key="label"
          value="{{bookSelectedVersionIndex}}"
          bindchange="changeBookOutputVersion"
        >
          <view class="book-version-picker-button">
            <text>查看版本</text>
            <text>{{bookVersionText}}</text>
          </view>
        </picker>
        <text wx:if="{{bookVersionNotice}}" class="book-version-notice">{{bookVersionNotice}}</text>
        <text wx:if="{{bookStaleNotice}}" class="book-stale-notice">{{bookStaleNotice}}</text>

        <view wx:if="{{bookContent}}" class="book-preview">
          <block wx:if="{{playingTarget === 'book' && bookTTSActiveTarget === 'book'}}">
            <view class="tts-progress-bar">
              <view class="tts-progress-fill" style="width: {{bookTTSProgressPercent}}%;"></view>
            </view>
            <text class="tts-highlight-text book" selectable>
              <text class="tts-spoken">{{bookTTSSpokenText}}</text>
              <text wx:if="{{bookTTSCurrentText}}" class="tts-current">{{bookTTSCurrentText}}</text>
              <text class="tts-remaining">{{bookTTSRemainingText}}</text>
            </text>
          </block>
          <block wx:elif="{{bookPreviewChapters.length}}">
            <view class="book-preview-cover">
              <text class="book-preview-title">{{bookPreviewTitle}}</text>
              <text class="book-preview-subtitle">{{bookPreviewChapters.length}} 章 · {{bookCharCount}} 字</text>
            </view>
            <view class="book-preview-toc">
              <view class="book-preview-label-row">
                <text class="book-preview-label">目录</text>
                <text class="book-preview-label-meta">按当前章节顺序</text>
              </view>
              <view
                wx:for="{{bookPreviewTocItems}}"
                wx:for-item="toc"
                wx:key="id"
                class="book-toc-row"
                data-id="{{toc.chapterId}}"
                bindtap="editBookOutputChapter"
              >
                <text class="book-toc-index">{{toc.indexText}}</text>
                <view class="book-toc-main">
                  <text class="book-toc-title">{{toc.title}}</text>
                  <text class="book-toc-meta">{{toc.metaText}}</text>
                </view>
                <text class="book-toc-action">编辑</text>
              </view>
            </view>
            <view class="book-preview-chapters">
              <view
                wx:for="{{bookPreviewChapters}}"
                wx:for-item="chapter"
                wx:key="id"
                class="book-preview-chapter"
              >
                <view class="book-preview-chapter-head">
                  <view class="book-preview-chapter-title-block">
                    <text class="book-preview-chapter-index">{{chapter.indexText}}</text>
                    <text class="book-preview-chapter-title">{{chapter.title}}</text>
                  </view>
                  <button
                    class="chapter-preview-edit"
                    data-id="{{chapter.chapterId}}"
                    bindtap="editBookOutputChapter"
                  >
                    编辑本章
                  </button>
                </view>
                <text class="book-preview-chapter-meta">{{chapter.metaText}}</text>
                <text class="book-preview-chapter-content" selectable>{{chapter.content}}</text>
              </view>
            </view>
          </block>
          <text wx:else class="book-output-text" selectable>{{bookContent}}</text>
        </view>
        <view wx:else class="draft-empty">
          <text>全书会直接使用已确认章节正文，不额外扩写叙述内容。</text>
        </view>

        <view class="actions-row">
          <button
            class="primary-button"
            loading="{{generatingBook}}"
            disabled="{{updatingPlanStructure || generatingBook || ttsBusyTarget || !canGenerateBook}}"
            bindtap="generateBook"
          >
            {{bookActionText}}
          </button>
          <button
            class="ghost-button"
            loading="{{ttsBusyTarget === 'book'}}"
            disabled="{{updatingPlanStructure || generatingBook || !bookContent || hasDraftChanges || bookStaleNotice || bookViewingHistoricalVersion || ttsBusyTarget}}"
            bindtap="playBookAudio"
          >
            {{ttsBusyTarget === "book" ? "准备朗读" : (playingTarget === "book" ? "停止朗读" : "朗读全书")}}
          </button>
        </view>
      </view>
    </view>
  </view>
  </block>
  </block>

  <view class="bottom-spacer"></view>
</view>
