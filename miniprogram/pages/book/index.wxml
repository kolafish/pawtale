<view class="ui-page-shell {{pageClass}}">
  <view class="ui-page-context-row">
    <text class="ui-page-context">{{projectTitle || "我的回忆录"}} · {{stageText}}</text>
  </view>

  <view wx:if="{{error}}" class="error ui-error-banner">{{error}}</view>
  <view wx:if="{{showingCachedBook}}" class="book-cache-banner ui-error-banner">
    <text>暂时无法获取最新书稿，当前显示上次保存的内容。</text>
    <button class="book-cache-retry" size="mini" bindtap="loadBookHome">重试刷新</button>
  </view>

  <view wx:if="{{needsLogin}}" class="empty-panel guest-panel ui-card">
    <image class="empty-icon" src="/assets/memoir-gramophone.png" mode="aspectFit" />
    <text class="empty-title">浏览书稿</text>
    <text class="empty-copy">讲述保存后会在后台整理成可读草稿，登录后可以阅读、编辑和导出。</text>
    <view class="actions-row">
      <button class="primary-button" bindtap="openLogin">登录后整理</button>
      <button class="ghost-button" bindtap="openHome">返回首页</button>
    </view>
  </view>

  <block wx:else>
  <view wx:if="{{!projectId}}" class="empty-panel ui-card">
    <image class="empty-icon" src="/assets/memoir-gramophone.png" mode="aspectFit" />
    <text class="empty-title">还没有回忆录</text>
    <text class="empty-copy">先创建一本回忆录并设置讲述资料，完成语音聊天后再整理书稿。</text>
    <view class="actions-row">
      <button class="primary-button" bindtap="createProject">创建回忆录</button>
      <button class="ghost-button" bindtap="openHome">返回首页</button>
    </view>
  </view>

  <block wx:else>
  <view class="status-panel progress-panel ui-card">
    <view class="progress-main">
      <view class="progress-title-row">
        <text class="status-title">{{bookPreviewTitle || planTitle || "书稿"}}</text>
        <text class="status-pill">{{stageText}}</text>
      </view>
      <text class="status-meta">
        <text wx:if="{{bookContentAvailable && bookIncludedChapterCount < totalChapterCount}}">{{bookIncludedChapterCount}}/{{totalChapterCount}} 章可读</text>
        <text wx:else>{{totalChapterCount}} 章</text>
        · {{bookCharCount || 0}} 字 · {{bookStaleNotice ? "整本书待更新" : (bookContentAvailable ? "已生成书稿" : progressText)}}
      </text>
      <text wx:if="{{bookStaleNotice}}" class="progress-note">{{bookStaleNotice}}</text>
      <text wx:if="{{bookPartialNotice}}" class="progress-note">{{bookPartialNotice}}</text>
      <image
        class="book-header-illustration"
        src="/assets/memoir-book-header.png"
        mode="aspectFit"
        aria-hidden="true"
      />
    </view>
    <view class="progress-actions">
      <button wx:if="{{bookContentAvailable && !bookStaleNotice}}" class="primary-button small progress-action is-primary" bindtap="openBookReader">
        <text>{{bookPartialNotice ? "阅读当前书稿" : "阅读全书"}}</text><text class="progress-action-mark">›</text>
      </button>
      <button class="ghost-button small progress-action" bindtap="openBookCompletion">
        <text>查看待确认事项</text><text class="progress-action-mark">›</text>
      </button>
      <button wx:if="{{bookContentAvailable}}" class="ghost-button small progress-action" data-action="preview" bindtap="openBookExportPage">
        <text>导出与成书设置</text><text class="progress-action-mark">›</text>
      </button>
      <button wx:if="{{bookContentAvailable}}" class="ghost-button small progress-action" bindtap="openBookSharePanel">
        <text>分享给家人</text><text class="progress-action-mark">›</text>
      </button>
    </view>
    <view wx:if="{{bookSharePanelOpen}}" class="book-share-panel">
      <text class="book-share-description">{{bookShareStatusKnown ? bookShareDescription : (bookShareBusy ? '正在读取阅读链接…' : '暂时无法读取阅读链接，请重试。')}}</text>
      <view class="book-share-primary-action">
        <button wx:if="{{!bookShareStatusKnown}}" class="primary-button small" loading="{{bookShareBusy}}" disabled="{{bookShareBusy}}" bindtap="refreshBookShareStatus">重试读取</button>
        <button wx:elif="{{bookShareReady}}" class="primary-button small" open-type="share" disabled="{{bookShareBusy}}">发送给家人</button>
        <button wx:elif="{{!bookShareActive}}" class="primary-button small" loading="{{bookShareBusy}}" disabled="{{bookShareBusy}}" bindtap="createBookShare">生成阅读链接</button>
        <button wx:else class="primary-button small" disabled="{{bookShareBusy}}" bindtap="refreshBookShareStatus">重试读取</button>
      </view>
      <view wx:if="{{bookShareStatusKnown && bookShareActive}}" class="book-share-management">
        <button class="book-share-manage-button" disabled="{{bookShareBusy}}" bindtap="regenerateBookShare">重新生成</button>
        <button class="book-share-manage-button is-danger" disabled="{{bookShareBusy}}" bindtap="revokeBookShare">撤销链接</button>
      </view>
    </view>
  </view>

  <view
    wx:if="{{ttsBusyTarget || playingTarget || bookTTSActiveTarget}}"
    class="book-tts-shell"
  >
    <book-tts-player
      title="{{(ttsBusyTarget || playingTarget || bookTTSActiveTarget) === 'outline' ? '目录朗读' : ((ttsBusyTarget || playingTarget || bookTTSActiveTarget) === 'book' ? '全书朗读' : '章节朗读')}}"
      phase="{{ttsBusyTarget ? 'preparing' : (playingTarget ? 'playing' : 'completed')}}"
      progress="{{bookTTSProgressPercent}}"
      spoken-text="{{bookTTSSpokenText}}"
      current-text="{{bookTTSCurrentText}}"
      remaining-text="{{bookTTSRemainingText}}"
      bindstop="stopPlayback"
    />
  </view>

  <view class="workspace-tabs" role="tablist">
    <button
      class="workspace-tab {{bookWorkspaceView === 'chapters' ? 'active' : ''}}"
      data-view="chapters"
      aria-label="查看章节"
      bindtap="changeBookWorkspaceView"
    >
      章节
    </button>
    <button
      class="workspace-tab {{bookWorkspaceView === 'tools' ? 'active' : ''}}"
      data-view="tools"
      aria-label="查看书稿工具"
      bindtap="changeBookWorkspaceView"
    >
      工具
      <text wx:if="{{automationEventItems.length}}" class="workspace-tab-count">{{automationEventItems.length}}</text>
    </button>
  </view>

  <block wx:if="{{bookWorkspaceView === 'tools'}}">
  <view class="image-assets-entry" bindtap="openImageAssetsPage">
    <view class="image-assets-entry-copy">
      <view class="image-assets-entry-title-row">
        <text class="image-assets-entry-title">图片素材</text>
        <text class="image-assets-entry-count">{{imageAssetLoading ? "同步中" : imageAssetTotal + " 张"}}</text>
      </view>
      <text class="image-assets-entry-meta">{{imageAssetSummaryText}}</text>
      <text class="image-assets-entry-note">统一查看生成图片，选择章节插图或书末图录。</text>
    </view>
    <text class="image-assets-entry-action">管理 <text class="image-assets-entry-mark">›</text></text>
  </view>

  <view wx:if="{{automationEventLoading || automationEventError || automationEventItems.length}}" class="automation-panel ui-card">
    <view class="automation-head">
      <view>
        <text class="automation-title">整理进度</text>
        <text class="automation-meta">书稿整理状态会在这里汇总</text>
      </view>
      <view class="automation-head-actions">
        <button
          wx:if="{{automationDismissibleCount}}"
          class="automation-clear"
          loading="{{automationEventClearing}}"
          disabled="{{automationEventClearing}}"
          bindtap="acknowledgeDismissibleAutomationEvents"
        >
          全部收起
        </button>
        <text class="automation-count">{{automationEventLoading ? "同步中" : automationEventItems.length + " 条"}}</text>
      </view>
    </view>
    <text wx:if="{{automationEventError}}" class="automation-error">{{automationEventError}}</text>
    <view wx:for="{{automationEventItems}}" wx:key="id" class="automation-item {{item.eventType}}">
      <view class="automation-item-main">
        <view class="automation-item-title-row">
          <text class="automation-item-title">{{item.titleText}}</text>
          <text class="automation-item-status">{{item.statusText}}</text>
        </view>
        <text class="automation-item-summary">{{item.summaryText}}</text>
        <text wx:if="{{item.detailText}}" class="automation-item-detail">{{item.detailText}}</text>
        <view wx:if="{{item.hasSuggestions}}" class="automation-suggestions">
          <view wx:for="{{item.suggestionItems}}" wx:key="id" wx:for-item="suggestion" class="automation-suggestion-row">
            <text class="automation-suggestion-label">{{suggestion.labelText}}</text>
            <view class="automation-suggestion-copy">
              <text class="automation-suggestion-body">{{suggestion.bodyText}}</text>
              <text wx:if="{{suggestion.chapterText}}" class="automation-suggestion-chapter">{{suggestion.chapterText}}</text>
            </view>
          </view>
        </view>
        <text wx:if="{{item.suggestedActionText && !item.hasSuggestions}}" class="automation-item-suggestion">建议操作：{{item.suggestedActionText}}</text>
        <view
          wx:if="{{item.hasDetails}}"
          class="automation-detail-toggle"
          data-id="{{item.id}}"
          bindtap="toggleAutomationEventDetails"
        >
          <text>{{item.detailToggleText}}</text>
        </view>
        <view wx:if="{{item.hasDetails && item.detailExpanded}}" class="automation-detail-list">
          <view wx:for="{{item.detailItems}}" wx:key="id" wx:for-item="detail" class="automation-detail-row">
            <view class="automation-detail-row-head">
              <text class="automation-detail-title">{{detail.titleText}}</text>
              <text class="automation-detail-chapter">{{detail.chapterText}}</text>
            </view>
            <text wx:if="{{detail.previewText}}" class="automation-detail-preview">{{detail.previewText}}</text>
            <text wx:if="{{detail.metaText}}" class="automation-detail-meta">{{detail.metaText}}</text>
          </view>
        </view>
        <text class="automation-item-meta">{{item.metaText}}</text>
      </view>
      <button
        class="automation-ack"
        data-id="{{item.id}}"
        data-event-ids="{{item.eventIdsText}}"
        data-action="{{item.actionKind}}"
        data-utterance-id="{{item.primaryUtteranceId}}"
        loading="{{item.busy}}"
        disabled="{{item.busy || !item.canAct}}"
        bindtap="acknowledgeAutomationEvent"
      >
        {{item.actionText}}
      </button>
    </view>
  </view>
  </block>

  <block wx:else>
  <view wx:if="{{loading && stage === 'empty'}}" class="empty-panel ui-card">
    <text>正在加载</text>
  </view>

  <view wx:elif="{{stage === 'empty'}}" class="empty-panel ui-card">
    <image class="empty-icon" src="/assets/memoir-gramophone.png" mode="aspectFit" />
    <text class="empty-title">从讲述记录生成章节</text>
    <text class="empty-copy">系统会先把当前回忆录里的讲述内容划分为若干章节。你确认章节后，再逐章生成正文。</text>
    <view class="actions-row">
      <button
        class="primary-button"
        loading="{{generatingPlan}}"
        disabled="{{loading || generatingPlan || !projectId}}"
        bindtap="generatePlan"
      >
        {{generatingPlan ? "正在规划章节…" : "生成章节规划"}}
      </button>
      <button class="ghost-button" disabled="{{generatingPlan}}" bindtap="openTranscripts">
        查看记录
      </button>
    </view>
  </view>

  <view wx:elif="{{stage === 'plan_draft'}}" class="section">
    <view class="field-block">
      <text class="field-label">目录名称</text>
      <input
        class="title-input"
        value="{{planTitle}}"
        bindinput="changePlanTitle"
        maxlength="120"
      />
    </view>

    <view class="section-head">
      <text class="section-title">确认章节</text>
      <view class="section-head-tools">
        <text class="section-count">{{chapters.length}} 章</text>
        <button
          class="section-head-action outline-read-action"
          loading="{{ttsBusyTarget === 'outline'}}"
          disabled="{{confirmingPlan || updatingPlanStructure || (ttsBusyTarget && ttsBusyTarget !== 'outline') || (playingTarget && playingTarget !== 'outline')}}"
          bindtap="playBookOutlineAudio"
        >
          {{ttsBusyTarget === "outline" ? "准备中" : (playingTarget === "outline" ? "停止朗读" : "朗读目录")}}
        </button>
      </view>
    </view>

    <view wx:for="{{chapters}}" wx:key="id" id="chapter-editor-{{item.id}}" class="chapter-card ui-card">
      <view class="chapter-head">
        <text class="chapter-index">第 {{index + 1}} 章</text>
        <text class="source-count">{{item.sourceCount}} 条原始讲述</text>
      </view>

      <input
        class="chapter-title-input"
        value="{{item.editingTitle}}"
        data-id="{{item.id}}"
        bindinput="changeChapterTitle"
        maxlength="80"
      />

      <view class="source-summary-row">
        <text class="source-preview">{{item.sourceSummary}}</text>
        <button
          wx:if="{{item.sourceCount}}"
          class="source-toggle-button"
          data-id="{{item.id}}"
          bindtap="toggleChapterSources"
        >
          {{item.sourceToggleText}}
        </button>
      </view>

      <view wx:if="{{item.sourceViews.length && item.sourceListExpanded}}" class="source-ref-list">
        <view wx:for="{{item.sourceViews}}" wx:for-item="source" wx:key="utterance_id" class="source-ref-row {{source.splitSelected ? 'selected' : ''}}">
          <view
            class="source-ref-main"
            data-id="{{source.utterance_id}}"
            bindtap="openTranscripts"
            hover-class="source-ref-main-active"
          >
            <text class="source-ref-label">{{source.labelText}}</text>
            <text class="source-ref-text">{{source.previewText}}</text>
          </view>
          <button
            wx:if="{{item.sourceViews.length > 1}}"
            class="source-split-toggle {{source.splitSelected ? 'selected' : ''}}"
            data-id="{{item.id}}"
            data-utterance-id="{{source.utterance_id}}"
            bindtap="toggleSplitSource"
            disabled="{{confirmingPlan || updatingPlanStructure}}"
          >
            {{source.splitSelected ? "已选" : "选择"}}
          </button>
        </view>
      </view>

      <view class="structure-actions">
        <view class="structure-action-row">
          <button
            class="structure-button"
            data-id="{{item.id}}"
            data-direction="up"
            bindtap="moveChapter"
            disabled="{{confirmingPlan || updatingPlanStructure || !item.canMoveUp}}"
          >
            上移
          </button>
          <button
            class="structure-button"
            data-id="{{item.id}}"
            data-direction="down"
            bindtap="moveChapter"
            disabled="{{confirmingPlan || updatingPlanStructure || !item.canMoveDown}}"
          >
            下移
          </button>
        </view>
        <view class="structure-action-row">
          <picker
            class="structure-picker"
            range="{{item.mergeTargetOptions}}"
            range-key="label"
            data-id="{{item.id}}"
            disabled="{{confirmingPlan || updatingPlanStructure || !item.mergeTargetOptions.length}}"
            bindchange="mergeChapterInto"
          >
            <view class="structure-button picker-button {{confirmingPlan || updatingPlanStructure || !item.mergeTargetOptions.length ? 'disabled' : ''}}">
              合并到
            </view>
          </picker>
          <button
            class="structure-button picker-button"
            data-id="{{item.id}}"
            disabled="{{confirmingPlan || updatingPlanStructure || !item.canSplitSelectedSources}}"
            bindtap="splitSelectedChapterSources"
          >
            {{item.splitActionText}}
          </button>
        </view>
      </view>

      <view class="actions-row compact">
        <button
          class="ghost-button"
          data-id="{{item.id}}"
          loading="{{titleBusyTarget === item.id}}"
          bindtap="generateChapterTitle"
          disabled="{{confirmingPlan || generatingPlan || titleBusyTarget || updatingPlanStructure}}"
        >
            {{titleBusyTarget === item.id ? "起名中" : "小余起名"}}
        </button>
        <button
          class="danger-button"
          data-id="{{item.id}}"
          bindtap="removeChapter"
          disabled="{{confirmingPlan || updatingPlanStructure || chapters.length <= 1}}"
        >
          删除本章，保留讲述
        </button>
      </view>
    </view>

    <view class="sticky-actions">
      <button
        class="ghost-button"
        loading="{{generatingPlan}}"
        disabled="{{generatingPlan || confirmingPlan}}"
        bindtap="generatePlan"
      >
        {{generatingPlan ? "正在重新规划…" : "重新规划"}}
      </button>
      <button
        class="primary-button"
        loading="{{confirmingPlan}}"
        disabled="{{generatingPlan || confirmingPlan || !chapters.length}}"
        bindtap="confirmPlan"
      >
        确认章节
      </button>
    </view>
  </view>

  <view wx:else class="section">
    <view class="section-head chapter-section-head">
      <view class="section-head-copy">
        <text class="section-title">{{chapterStructureEditing ? "调整章节顺序" : "章节正文"}}</text>
        <text wx:if="{{chapterStructureEditing && updatingPlanStructure}}" class="section-count saving">正在保存顺序…</text>
        <text wx:else class="section-count">已更新 {{readyDraftCount}}/{{totalChapterCount}} 章</text>
      </view>
      <view
        class="section-head-action chapter-order-toggle {{updatingPlanStructure ? 'is-locked' : ''}}"
        hover-class="section-head-action-active"
        aria-role="button"
        aria-disabled="{{updatingPlanStructure}}"
        bindtap="toggleChapterStructureEditing"
      >
        {{chapterStructureEditing ? "完成" : "调整章节"}}
      </view>
    </view>

    <view wx:if="{{chapterStructureEditing}}" class="chapter-order-panel" aria-busy="{{updatingPlanStructure}}">
      <view
        wx:for="{{chapters}}"
        wx:key="id"
        class="chapter-order-row {{planStructureBusyChapterId === item.id ? 'is-saving' : ''}}"
      >
        <view class="chapter-order-copy">
          <text class="chapter-order-index">第 {{index + 1}} 章</text>
          <text class="chapter-order-title">{{item.editingTitle || item.title || "未命名章节"}}</text>
        </view>
        <view class="chapter-order-actions">
          <view
            class="chapter-order-edit {{item.draftBusy ? 'is-unavailable' : ''}} {{updatingPlanStructure ? 'is-locked' : ''}}"
            hover-class="chapter-order-button-active"
            aria-role="button"
            aria-label="编辑第 {{index + 1}} 章"
            aria-disabled="{{updatingPlanStructure || item.draftBusy}}"
            data-id="{{item.id}}"
            bindtap="openChapterEditor"
          >
            编辑
          </view>
          <view
            class="chapter-order-button {{!item.canMoveUp ? 'is-unavailable' : ''}} {{updatingPlanStructure ? 'is-locked' : ''}} {{planStructureBusyChapterId === item.id && planStructureBusyDirection === 'up' ? 'is-saving' : ''}}"
            hover-class="chapter-order-button-active"
            aria-role="button"
            aria-label="第 {{index + 1}} 章上移"
            aria-disabled="{{updatingPlanStructure || !item.canMoveUp}}"
            data-id="{{item.id}}"
            data-direction="up"
            bindtap="moveChapter"
          >
            {{planStructureBusyChapterId === item.id && planStructureBusyDirection === "up" ? "…" : "↑"}}
          </view>
          <view
            class="chapter-order-button {{!item.canMoveDown ? 'is-unavailable' : ''}} {{updatingPlanStructure ? 'is-locked' : ''}} {{planStructureBusyChapterId === item.id && planStructureBusyDirection === 'down' ? 'is-saving' : ''}}"
            hover-class="chapter-order-button-active"
            aria-role="button"
            aria-label="第 {{index + 1}} 章下移"
            aria-disabled="{{updatingPlanStructure || !item.canMoveDown}}"
            data-id="{{item.id}}"
            data-direction="down"
            bindtap="moveChapter"
          >
            {{planStructureBusyChapterId === item.id && planStructureBusyDirection === "down" ? "…" : "↓"}}
          </view>
        </view>
      </view>
    </view>

    <block wx:else>
      <view wx:for="{{chapters}}" wx:key="id" id="chapter-editor-{{item.id}}" class="chapter-card summary ui-card">
        <view class="chapter-summary-card">
          <view class="chapter-summary-head">
            <view class="chapter-summary-title-block">
              <text class="chapter-index">第 {{index + 1}} 章</text>
              <text class="chapter-summary-title">{{item.editingTitle || item.title || "未命名章节"}}</text>
              <text class="chapter-summary-meta">{{item.chapterSummaryMetaText}}</text>
            </view>
          </view>
          <view class="chapter-summary-guidance {{item.chapterNeedsAction ? 'needs-action' : 'is-complete'}}">
            <text class="chapter-summary-guidance-label">{{item.chapterNeedsAction ? (item.draftAvailable ? '待更新' : '整理中') : '已更新'}}</text>
            <text class="chapter-summary-guidance-text">{{item.chapterGuidanceText}}</text>
          </view>
          <text wx:if="{{item.draftError}}" class="chapter-summary-error">{{item.draftError}}</text>
          <text
            wx:if="{{ttsBusyTarget === item.ttsTarget || playingTarget === item.ttsTarget}}"
            class="chapter-audio-status"
          >
            {{ttsBusyTarget === item.ttsTarget ? "正在准备朗读..." : "正在朗读本章"}}
          </text>
          <view class="chapter-summary-actions">
            <button
              class="primary-button small"
              data-id="{{item.id}}"
              bindtap="openChapterEditor"
              loading="{{item.draftBusy}}"
              disabled="{{updatingPlanStructure || item.draftBusy}}"
            >
              {{item.draftActionText}}
            </button>
            <button
              class="ghost-button small"
              data-id="{{item.id}}"
              loading="{{ttsBusyTarget === item.ttsTarget || titleBusyTarget === item.id}}"
              bindtap="openChapterMoreActions"
              disabled="{{updatingPlanStructure || ttsBusyTarget === item.ttsTarget || titleBusyTarget === item.id}}"
            >
              {{titleBusyTarget === item.id ? "正在改名" : (ttsBusyTarget === item.ttsTarget ? "准备朗读" : (playingTarget === item.ttsTarget ? "朗读中" : "更多"))}}
            </button>
          </view>
        </view>
      </view>
    </block>

  </view>
  </block>
  </block>
  </block>

  <view class="bottom-spacer"></view>
</view>
