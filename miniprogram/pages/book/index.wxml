<view class="book-page">
  <view class="header">
    <text class="page-title">成书</text>
    <text class="page-subtitle">{{projectTitle || "我的回忆录"}}</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="book-panel">
    <image class="book-icon" src="/assets/memoir-gramophone.png" mode="aspectFit" />
    <text class="book-title">整理成书</text>
    <text class="book-copy">先确认章节，再逐章生成书稿。内容以你的叙述为主，只做分章、整理和轻度润色。</text>
  </view>

  <view class="section">
    <text class="section-title">当前进度</text>
    <view class="step-list">
      <view class="step-item active">
        <text class="step-index">1</text>
        <view class="step-main">
          <text class="step-title">章节规划</text>
          <text class="step-meta">根据已保存的转写内容划分章节</text>
        </view>
      </view>
      <view class="step-item">
        <text class="step-index">2</text>
        <view class="step-main">
          <text class="step-title">章节确认</text>
          <text class="step-meta">调整标题、顺序和内容范围</text>
        </view>
      </view>
      <view class="step-item">
        <text class="step-index">3</text>
        <view class="step-main">
          <text class="step-title">分章成稿</text>
          <text class="step-meta">每章单独生成和确认</text>
        </view>
      </view>
    </view>
  </view>

  <button class="primary-button" disabled="{{loading}}" bindtap="openTranscripts">
    查看转写内容
  </button>
</view>
