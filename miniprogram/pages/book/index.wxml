<view class="book-page">
  <view class="top-row">
    <view class="back-hit" bindtap="openHome">
      <text class="back-mark">‹</text>
    </view>
    <view class="title-block">
      <text class="page-title">成书</text>
      <text class="page-meta">{{projectTitle || "我的回忆录"}} · {{stageText}}</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view wx:if="{{needsLogin}}" class="empty-panel guest-panel">
    <image class="empty-icon" src="/assets/memoir-gramophone.png" mode="aspectFit" />
    <text class="empty-title">浏览整理成书</text>
    <text class="empty-copy">登录后可以把讲述记录归入章节，确认章节正文，再生成全书和章节朗读。</text>
    <view class="guest-steps">
      <text>1. 先生成章节规划</text>
      <text>2. 再逐章整理正文</text>
      <text>3. 最后合成全书朗读</text>
    </view>
    <view class="actions-row">
      <button class="primary-button" bindtap="openLogin">登录后整理</button>
      <button class="ghost-button" bindtap="openHome">返回首页</button>
    </view>
  </view>

  <block wx:else>
  <view wx:if="{{!projectId}}" class="empty-panel">
    <image class="empty-icon" src="/assets/memoir-gramophone.png" mode="aspectFit" />
    <text class="empty-title">还没有回忆录</text>
    <text class="empty-copy">先创建一本回忆录并设置讲述资料，完成语音聊天后再整理成书。</text>
    <view class="actions-row">
      <button class="primary-button" bindtap="createProject">创建回忆录</button>
      <button class="ghost-button" bindtap="openHome">返回首页</button>
    </view>
  </view>

  <block wx:else>
  <view class="status-panel progress-panel">
    <view class="progress-main">
      <view class="progress-title-row">
        <text class="status-title">{{bookPreviewTitle || planTitle || "整理成书"}}</text>
        <text class="status-pill">{{stageText}}</text>
      </view>
      <text class="status-meta">
        {{totalChapterCount}} 章 · {{bookCharCount || 0}} 字 · {{bookContent ? "已生成书稿" : progressText}}
      </text>
    </view>
    <view wx:if="{{stage === 'drafting'}}" class="progress-actions">
      <button
        class="primary-button small"
        data-action="preview"
        disabled="{{!bookContent || hasDraftChanges || bookStaleNotice || bookViewingHistoricalVersion}}"
        bindtap="openBookExportPage"
      >
        预览全书
      </button>
      <button
        class="ghost-button small"
        data-action="reading_pdf"
        disabled="{{updatingPlanStructure || generatingBook || !bookContent || hasDraftChanges || bookStaleNotice || bookExportBusyTarget}}"
        bindtap="openBookExportPage"
      >
        阅读版 PDF
      </button>
      <button
        class="ghost-button small"
        data-action="print_pdf"
        disabled="{{updatingPlanStructure || generatingBook || !bookContent || hasDraftChanges || bookStaleNotice || bookExportBusyTarget}}"
        bindtap="openBookExportPage"
      >
        打印版 PDF
      </button>
    </view>
  </view>

  <view wx:if="{{automationEventLoading || automationEventError || automationEventItems.length}}" class="automation-panel">
    <view class="automation-head">
      <view>
        <text class="automation-title">整理进度</text>
        <text class="automation-meta">书稿整理、补写和待确认事项会在这里汇总</text>
      </view>
      <text class="automation-count">{{automationEventLoading ? "同步中" : automationEventItems.length + " 条"}}</text>
    </view>
    <text wx:if="{{automationEventError}}" class="automation-error">{{automationEventError}}</text>
    <view wx:for="{{automationEventItems}}" wx:key="id" class="automation-item {{item.eventType}}">
      <view class="automation-item-main">
        <view class="automation-item-title-row">
          <text class="automation-item-title">{{item.titleText}}</text>
          <text class="automation-item-status">{{item.statusText}}</text>
        </view>
        <text class="automation-item-summary">{{item.summaryText}}</text>
        <text wx:if="{{item.detailText}}" class="automation-item-detail">{{item.detailText}}</text>
        <view wx:if="{{item.hasSuggestions}}" class="automation-suggestions">
          <view wx:for="{{item.suggestionItems}}" wx:key="id" wx:for-item="suggestion" class="automation-suggestion-row">
            <text class="automation-suggestion-label">{{suggestion.labelText}}</text>
            <view class="automation-suggestion-copy">
              <text class="automation-suggestion-body">{{suggestion.bodyText}}</text>
              <text wx:if="{{suggestion.chapterText}}" class="automation-suggestion-chapter">{{suggestion.chapterText}}</text>
            </view>
          </view>
        </view>
        <text wx:if="{{item.suggestedActionText && !item.hasSuggestions}}" class="automation-item-suggestion">建议操作：{{item.suggestedActionText}}</text>
        <view
          wx:if="{{item.hasDetails}}"
          class="automation-detail-toggle"
          data-id="{{item.id}}"
          bindtap="toggleAutomationEventDetails"
        >
          <text>{{item.detailToggleText}}</text>
        </view>
        <view wx:if="{{item.hasDetails && item.detailExpanded}}" class="automation-detail-list">
          <view wx:for="{{item.detailItems}}" wx:key="id" wx:for-item="detail" class="automation-detail-row">
            <view class="automation-detail-row-head">
              <text class="automation-detail-title">{{detail.titleText}}</text>
              <text class="automation-detail-chapter">{{detail.chapterText}}</text>
            </view>
            <text wx:if="{{detail.previewText}}" class="automation-detail-preview">{{detail.previewText}}</text>
            <text wx:if="{{detail.metaText}}" class="automation-detail-meta">{{detail.metaText}}</text>
          </view>
        </view>
        <text class="automation-item-meta">{{item.metaText}}</text>
      </view>
      <button
        class="automation-ack"
        data-id="{{item.id}}"
        data-event-ids="{{item.eventIdsText}}"
        data-action="{{item.actionKind}}"
        data-utterance-id="{{item.primaryUtteranceId}}"
        loading="{{item.busy}}"
        disabled="{{item.busy || !item.canAct}}"
        bindtap="acknowledgeAutomationEvent"
      >
        {{item.actionText}}
      </button>
    </view>
  </view>

  <view wx:if="{{plan}}" class="book-voice-assistant {{bookVoiceAssistantExpanded ? 'expanded' : 'collapsed'}}">
    <view class="book-voice-header">
      <view class="book-voice-copy">
        <text class="book-voice-title">对书稿说一句</text>
        <text class="book-voice-hint">例如：读一下第 2 章 / 把这一段说得朴素一点</text>
        <text class="book-voice-status">{{bookVoiceAssistantStatusText}}</text>
      </view>
      <view class="book-voice-actions">
        <button
          class="book-voice-button"
          loading="{{ttsBusyTarget === 'outline'}}"
          disabled="{{loading || generatingPlan || confirmingPlan || updatingPlanStructure || ttsBusyTarget}}"
          bindtap="playBookOutlineAudio"
        >
          {{ttsBusyTarget === "outline" ? "准备目录" : (playingTarget === "outline" ? "停止目录" : "听目录")}}
        </button>
        <button
          class="book-voice-button primary"
          loading="{{bookVoiceAssistantBusy && !bookVoiceAssistantSpeakingLineId}}"
          disabled="{{loading || generatingPlan || confirmingPlan || updatingPlanStructure || generatingBook || (bookVoiceAssistantBusy && !bookVoiceAssistantSpeakingLineId)}}"
          bindtap="startBookVoiceCommand"
        >
          {{bookVoiceAssistantListening ? "停止" : (bookVoiceAssistantBusy ? (bookVoiceAssistantSpeakingLineId ? "我想说了" : "处理中") : "语音修改")}}
        </button>
      </view>
    </view>

    <view wx:if="{{bookVoiceAssistantExpanded}}" class="book-voice-expanded">
      <view class="book-voice-meter">
        <view class="book-voice-meter-track">
          <view class="book-voice-meter-fill" style="width: {{bookVoiceAudioLevelPercent}}%;"></view>
        </view>
        <text class="book-voice-meter-text">{{bookVoiceCaptureStateText}}</text>
      </view>

      <view class="book-voice-dialog">
        <view
          wx:for="{{bookVoiceTranscriptLines}}"
          wx:key="id"
          class="book-voice-message {{item.role === 'assistant' ? 'assistant' : 'user'}}"
        >
          <text class="book-voice-message-role">{{item.role === "assistant" ? "小余" : "我"}}</text>
          <block wx:if="{{item.id === bookVoiceAssistantSpeakingLineId && bookTTSActiveTarget === 'book-voice-assistant'}}">
            <text class="book-voice-message-text assistant-speaking" selectable>
              <text class="tts-spoken">{{bookTTSSpokenText}}</text>
              <text wx:if="{{bookTTSCurrentText}}" class="tts-current">{{bookTTSCurrentText}}</text>
              <text class="tts-remaining">{{bookTTSRemainingText}}</text>
            </text>
          </block>
          <block wx:else>
            <text class="book-voice-message-text">{{item.text}}</text>
          </block>
        </view>
        <view wx:if="{{bookVoiceLiveText}}" class="book-voice-message user live">
          <text class="book-voice-message-role">我</text>
          <text class="book-voice-message-text">{{bookVoiceLiveText}}</text>
        </view>
        <text wx:if="{{!bookVoiceTranscriptLines.length && !bookVoiceLiveText}}" class="book-voice-dialog-empty">
          点击语音修改后，我会实时显示你说的话和小余的回复。
        </text>
      </view>

      <view wx:if="{{playingTarget === 'outline' && bookTTSActiveTarget === 'outline'}}" class="book-voice-playback">
        <view class="tts-progress-bar">
          <view class="tts-progress-fill" style="width: {{bookTTSProgressPercent}}%;"></view>
        </view>
        <text class="tts-highlight-text" selectable>
          <text class="tts-spoken">{{bookTTSSpokenText}}</text>
          <text wx:if="{{bookTTSCurrentText}}" class="tts-current">{{bookTTSCurrentText}}</text>
          <text class="tts-remaining">{{bookTTSRemainingText}}</text>
        </text>
      </view>

      <view wx:if="{{bookVoiceCommandText || bookVoiceCommandDetailText || bookVoiceCommandSummary}}" class="book-voice-command-preview {{bookVoiceCommandResponseKind || 'action_preview'}}">
        <view class="book-voice-command-head">
          <text class="book-voice-command-label">{{bookVoiceCommandIntentLabel || "已识别"}}</text>
          <text class="book-voice-command-state">{{bookVoiceCommandStateText || (bookVoiceCommandRequiresConfirmation ? "待确认" : "已识别")}}</text>
        </view>
        <text wx:if="{{bookVoiceCommandText}}" class="book-voice-command-text">“{{bookVoiceCommandText}}”</text>
        <view wx:if="{{bookVoiceCommandDetailText || bookVoiceCommandSummary}}" class="book-voice-command-body">
          <text wx:if="{{bookVoiceCommandPanelTitle}}" class="book-voice-command-panel-title">{{bookVoiceCommandPanelTitle}}</text>
          <text class="book-voice-command-summary">{{bookVoiceCommandDetailText || bookVoiceCommandSummary}}</text>
        </view>
        <view wx:if="{{bookVoiceCommandCanExecute || bookVoiceCommandUndoText || bookVoiceCommandRequiresConfirmation}}" class="book-voice-command-actions">
          <button
            wx:if="{{!bookVoiceCommandUndoText}}"
            class="book-voice-command-button"
            disabled="{{bookVoiceCommandExecuting || updatingPlanStructure}}"
            bindtap="clearBookVoiceCommandPreview"
          >
            取消
          </button>
          <button
            wx:if="{{bookVoiceCommandCanExecute}}"
            class="book-voice-command-button primary"
            loading="{{bookVoiceCommandExecuting}}"
            disabled="{{bookVoiceCommandExecuting || updatingPlanStructure}}"
            bindtap="executeBookVoiceCommand"
          >
            {{bookVoiceCommandActionText}}
          </button>
          <button
            wx:if="{{bookVoiceCommandUndoText}}"
            class="book-voice-command-button"
            loading="{{bookVoiceCommandExecuting}}"
            disabled="{{bookVoiceCommandExecuting || updatingPlanStructure}}"
            bindtap="undoBookVoiceCommand"
          >
            {{bookVoiceCommandUndoText}}
          </button>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{sourceCoverageNotice}}" class="coverage-section">
    <view class="coverage-head">
      <view class="coverage-copy">
        <view class="coverage-title-row">
          <text class="coverage-title">待收录讲述</text>
          <text class="coverage-count">{{uncoveredSourceDisplayText}}</text>
        </view>
        <text class="coverage-meta">{{sourceCoverageNotice}}，新录音不会自动改动已确认章节和全书。</text>
      </view>
      <button class="coverage-link" bindtap="openTranscripts">讲述记录</button>
    </view>

    <view wx:if="{{plan && chapterPickerOptions.length && uncoveredSources.length}}" class="coverage-source-list">
      <view wx:for="{{uncoveredSources}}" wx:key="utterance_id" class="coverage-source-card">
        <view
          class="coverage-source-main"
          data-id="{{item.utterance_id}}"
          bindtap="openTranscripts"
          hover-class="coverage-source-main-active"
        >
          <text class="coverage-source-time">{{item.createdAtText}}</text>
          <text class="coverage-source-text">{{item.previewText}}</text>
        </view>
        <view class="coverage-source-actions">
          <picker
            mode="selector"
            range="{{chapterPickerOptions}}"
            range-key="label"
            data-id="{{item.utterance_id}}"
            disabled="{{assigningSourceId || updatingPlanStructure}}"
            bindchange="assignUncoveredSource"
          >
            <view class="coverage-assign {{assigningSourceId === item.utterance_id ? 'loading' : ''}}">
              {{assigningSourceId === item.utterance_id ? "归入中" : "归入章节"}}
            </view>
          </picker>
        </view>
      </view>
    </view>

    <view wx:elif="{{!plan}}" class="coverage-empty">
      <text>生成章节规划后可以收录这些讲述。</text>
    </view>
  </view>

  <view wx:if="{{loading && !plan}}" class="empty-panel">
    <text>正在加载</text>
  </view>

  <view wx:elif="{{!plan}}" class="empty-panel">
    <image class="empty-icon" src="/assets/memoir-gramophone.png" mode="aspectFit" />
    <text class="empty-title">从讲述记录生成章节</text>
    <text class="empty-copy">系统会先把当前回忆录里的讲述内容划分为若干章节。你确认章节后，再逐章生成正文。</text>
    <view class="actions-row">
      <button
        class="primary-button"
        loading="{{generatingPlan}}"
        disabled="{{loading || generatingPlan || !projectId}}"
        bindtap="generatePlan"
      >
        生成章节规划
      </button>
      <button class="ghost-button" disabled="{{generatingPlan}}" bindtap="openTranscripts">
        查看记录
      </button>
    </view>
  </view>

  <view wx:elif="{{stage === 'plan_draft'}}" class="section">
    <view class="field-block">
      <text class="field-label">目录名称</text>
      <input
        class="title-input"
        value="{{planTitle}}"
        bindinput="changePlanTitle"
        maxlength="120"
      />
    </view>

    <view class="section-head">
      <text class="section-title">确认章节</text>
      <text class="section-count">{{chapters.length}} 章</text>
    </view>

    <view wx:for="{{chapters}}" wx:key="id" id="chapter-editor-{{item.id}}" class="chapter-card">
      <view class="chapter-head">
        <text class="chapter-index">第 {{index + 1}} 章</text>
        <text class="source-count">{{item.sourceCount}} 条原始讲述</text>
      </view>

      <input
        class="chapter-title-input"
        value="{{item.editingTitle}}"
        data-id="{{item.id}}"
        bindinput="changeChapterTitle"
        maxlength="80"
      />

      <view class="source-summary-row">
        <text class="source-preview">{{item.sourceSummary}}</text>
        <button
          wx:if="{{item.sourceViews.length}}"
          class="source-toggle-button"
          data-id="{{item.id}}"
          bindtap="toggleChapterSources"
        >
          {{item.sourceToggleText}}
        </button>
      </view>

      <view wx:if="{{item.sourceViews.length && item.sourceListExpanded}}" class="source-ref-list">
        <view wx:for="{{item.sourceViews}}" wx:for-item="source" wx:key="utterance_id" class="source-ref-row {{source.splitSelected ? 'selected' : ''}}">
          <view
            class="source-ref-main"
            data-id="{{source.utterance_id}}"
            bindtap="openTranscripts"
            hover-class="coverage-source-main-active"
          >
            <text class="source-ref-label">{{source.labelText}}</text>
            <text class="source-ref-text">{{source.previewText}}</text>
          </view>
          <button
            wx:if="{{item.sourceViews.length > 1}}"
            class="source-split-toggle {{source.splitSelected ? 'selected' : ''}}"
            data-id="{{item.id}}"
            data-utterance-id="{{source.utterance_id}}"
            bindtap="toggleSplitSource"
            disabled="{{confirmingPlan || updatingPlanStructure}}"
          >
            {{source.splitSelected ? "已选" : "选择"}}
          </button>
        </view>
      </view>

      <view class="structure-actions">
        <view class="structure-action-row">
          <button
            class="structure-button"
            data-id="{{item.id}}"
            data-direction="up"
            bindtap="moveChapter"
            disabled="{{confirmingPlan || updatingPlanStructure || !item.canMoveUp}}"
          >
            上移
          </button>
          <button
            class="structure-button"
            data-id="{{item.id}}"
            data-direction="down"
            bindtap="moveChapter"
            disabled="{{confirmingPlan || updatingPlanStructure || !item.canMoveDown}}"
          >
            下移
          </button>
        </view>
        <view class="structure-action-row">
          <picker
            class="structure-picker"
            range="{{item.mergeTargetOptions}}"
            range-key="label"
            data-id="{{item.id}}"
            disabled="{{confirmingPlan || updatingPlanStructure || !item.mergeTargetOptions.length}}"
            bindchange="mergeChapterInto"
          >
            <view class="structure-button picker-button {{confirmingPlan || updatingPlanStructure || !item.mergeTargetOptions.length ? 'disabled' : ''}}">
              合并到
            </view>
          </picker>
          <button
            class="structure-button picker-button"
            data-id="{{item.id}}"
            disabled="{{confirmingPlan || updatingPlanStructure || !item.canSplitSelectedSources}}"
            bindtap="splitSelectedChapterSources"
          >
            {{item.splitActionText}}
          </button>
        </view>
      </view>

      <view class="actions-row compact">
        <button
          class="ghost-button"
          data-id="{{item.id}}"
          loading="{{titleBusyTarget === item.id}}"
          bindtap="generateChapterTitle"
          disabled="{{confirmingPlan || generatingPlan || titleBusyTarget || updatingPlanStructure}}"
        >
            {{titleBusyTarget === item.id ? "起名中" : "小余起名"}}
        </button>
        <button
          class="danger-button"
          data-id="{{item.id}}"
          bindtap="removeChapter"
          disabled="{{confirmingPlan || updatingPlanStructure || chapters.length <= 1}}"
        >
          删除本章，保留讲述
        </button>
      </view>
    </view>

    <view class="sticky-actions">
      <button
        class="ghost-button"
        loading="{{generatingPlan}}"
        disabled="{{generatingPlan || confirmingPlan}}"
        bindtap="generatePlan"
      >
        重新规划
      </button>
      <button
        class="primary-button"
        loading="{{confirmingPlan}}"
        disabled="{{generatingPlan || confirmingPlan || !chapters.length}}"
        bindtap="confirmPlan"
      >
        确认章节
      </button>
    </view>
  </view>

  <view wx:else class="section">
    <view class="section-head">
      <text class="section-title">逐章成稿</text>
      <text class="section-count">{{confirmedDraftCount}}/{{totalChapterCount}} 已确认</text>
    </view>

    <view wx:for="{{chapters}}" wx:key="id" id="chapter-editor-{{item.id}}" class="chapter-card summary">
      <view class="chapter-summary-card">
        <view class="chapter-summary-head">
          <view class="chapter-summary-title-block">
            <text class="chapter-index">第 {{index + 1}} 章</text>
            <text class="chapter-summary-title">{{item.editingTitle || item.title || "未命名章节"}}</text>
            <text class="chapter-summary-meta">{{item.chapterSummaryMetaText}}</text>
          </view>
          <view class="chapter-summary-status {{item.draft && item.draft.status === 'confirmed' ? 'confirmed' : ''}}">
            <text>{{item.draftStatusText}}</text>
            <text wx:if="{{item.draft && item.draft.status === 'confirmed'}}" class="chapter-summary-status-hint">可继续修改</text>
          </view>
        </view>
        <text wx:if="{{item.sourceChangeNotice}}" class="draft-pending compact">{{item.sourceChangeNotice}}</text>
        <view class="chapter-summary-actions">
          <button
            class="primary-button small"
            data-id="{{item.id}}"
            bindtap="openChapterEditor"
            disabled="{{updatingPlanStructure || item.draftBusy}}"
          >
            编辑正文
          </button>
          <button
            class="ghost-button small"
            data-id="{{item.id}}"
            bindtap="openChapterSources"
            disabled="{{!item.sourceViews.length}}"
          >
            原始讲述
          </button>
          <button
            class="ghost-button small"
            data-id="{{item.id}}"
            loading="{{ttsBusyTarget === item.ttsTarget}}"
            disabled="{{updatingPlanStructure || item.draftBusy || item.draftChanged || !item.draft || !item.draft.latest_version || ttsBusyTarget}}"
            bindtap="playChapterAudio"
          >
            {{playingTarget === item.ttsTarget ? "停止朗读" : "朗读"}}
          </button>
        </view>
      </view>
    </view>

    <view id="book-output-card" class="book-output-card">
      <view class="section-head inline">
        <text class="section-title">全书成稿</text>
        <text class="section-count">{{bookVersionText}}</text>
      </view>

      <view wx:if="{{!allChaptersConfirmed}}" class="draft-empty">
        <text>确认所有章节后，可以把当前章节内容合成为全书。</text>
      </view>
      <view wx:elif="{{hasDraftChanges}}" class="draft-empty">
        <text>当前有未保存的章节修改，保存后再生成全书。</text>
      </view>
      <view wx:else>
        <view class="book-output-meta">
          <text>{{bookContent ? bookCharCount + " 字" : "尚未生成正文"}}</text>
          <text>按已确认章节顺序合成</text>
        </view>

        <view class="book-export-hero">
          <view class="book-export-hero-copy">
            <text class="book-export-hero-title">全书导出</text>
            <text class="book-export-hero-meta">
              {{bookContent ? "可以预览阅读版，或导出给家人阅读和打印。" : "生成全书后可以预览、导出 PDF 或文本。"}}
            </text>
          </view>
          <view class="book-export-hero-actions">
            <button
              class="primary-button small"
              disabled="{{!bookContent || hasDraftChanges || bookStaleNotice || bookViewingHistoricalVersion}}"
              bindtap="previewBookOutput"
            >
              预览全书
            </button>
            <button
              class="ghost-button small"
              data-format="pdf"
              loading="{{bookExportBusyTarget === 'book-export:pdf:' + bookExportLayout}}"
              disabled="{{updatingPlanStructure || generatingBook || !bookContent || hasDraftChanges || bookStaleNotice || bookExportBusyTarget}}"
              bindtap="downloadBookOutputExport"
            >
              阅读版 PDF
            </button>
            <button
              class="ghost-button small"
              data-format="pdf"
              data-layout="large_print"
              loading="{{bookExportBusyTarget === 'book-export:pdf:large_print'}}"
              disabled="{{updatingPlanStructure || generatingBook || !bookContent || hasDraftChanges || bookStaleNotice || bookExportBusyTarget}}"
              bindtap="downloadBookOutputExport"
            >
              打印版 PDF
            </button>
            <button
              class="ghost-button small"
              data-format="txt"
              loading="{{bookExportBusyTarget === 'book-export:txt:standard'}}"
              disabled="{{updatingPlanStructure || generatingBook || !bookContent || hasDraftChanges || bookStaleNotice || bookExportBusyTarget}}"
              bindtap="downloadBookOutputExport"
            >
              导出文本
            </button>
          </view>
          <view class="book-export-secondary-actions">
            <button
              class="ghost-button small"
              loading="{{generatingBook}}"
              disabled="{{updatingPlanStructure || generatingBook || ttsBusyTarget || !canGenerateBook}}"
              bindtap="generateBook"
            >
              {{bookActionText}}
            </button>
            <text wx:if="{{bookOutput && bookOutput.latest_version}}" class="book-export-action-hint">当前书稿会保留</text>
          </view>
          <button class="book-output-details-toggle" bindtap="toggleBookOutputDetails">
            {{bookOutputDetailsExpanded ? "收起全书设置" : "编辑全书设置"}}
          </button>
        </view>

        <view wx:if="{{bookOutputDetailsExpanded}}" class="book-output-details">
        <view class="book-design-panel">
          <view class="book-design-head">
            <view>
              <text class="book-design-title">成书信息</text>
              <text class="book-design-meta">{{bookCoverStyleLabel}} · {{bookOutput && bookOutput.latest_version ? "已生成" : "待生成"}}</text>
            </view>
            <text class="book-design-save-status {{bookTitleSaving ? 'saving' : ''}}">{{bookDesignSaveStatusText}}</text>
          </view>

          <view class="book-title-editor">
            <input
              class="book-title-input"
              value="{{bookTitleInput}}"
              placeholder="输入书名"
              maxlength="60"
              disabled="{{bookTitleSaving || generatingBook || updatingPlanStructure || bookViewingHistoricalVersion}}"
              bindinput="changeBookTitle"
            />
            <button
              class="book-title-ai"
              loading="{{bookTitleSuggesting}}"
              disabled="{{bookTitleSuggesting || bookTitleSaving || generatingBook || updatingPlanStructure || bookViewingHistoricalVersion || !allChaptersConfirmed || hasDraftChanges}}"
              bindtap="suggestBookTitles"
            >
              {{bookTitleSuggesting ? "起名中" : "小余起名"}}
            </button>
          </view>

          <view wx:if="{{bookTitleSuggestions.length}}" class="book-title-suggestion-list">
            <view
              wx:for="{{bookTitleSuggestions}}"
              wx:key="*this"
              class="book-title-suggestion"
              data-title="{{item}}"
              bindtap="chooseBookTitleSuggestion"
            >
              <text>{{item}}</text>
            </view>
          </view>

          <view class="book-metadata-grid">
            <view class="book-metadata-field">
              <text class="book-metadata-label">副标题</text>
              <input
                class="book-metadata-input"
                value="{{bookSubtitleInput}}"
                placeholder="根据口述访谈整理"
                maxlength="80"
                disabled="{{bookTitleSaving || generatingBook || updatingPlanStructure || bookViewingHistoricalVersion}}"
                data-key="subtitle"
                bindinput="changeBookMetadataField"
              />
            </view>
            <view class="book-metadata-field">
              <text class="book-metadata-label">口述人</text>
              <input
                class="book-metadata-input"
                value="{{bookNarratorNameInput}}"
                placeholder="例如：爷爷 / 外婆 / 某某"
                maxlength="40"
                disabled="{{bookTitleSaving || generatingBook || updatingPlanStructure || bookViewingHistoricalVersion}}"
                data-key="narrator_name"
                bindinput="changeBookMetadataField"
              />
            </view>
            <view class="book-metadata-field">
              <text class="book-metadata-label">整理人</text>
              <input
                class="book-metadata-input"
                value="{{bookPreparedByInput}}"
                placeholder="家人整理"
                maxlength="40"
                disabled="{{bookTitleSaving || generatingBook || updatingPlanStructure || bookViewingHistoricalVersion}}"
                data-key="prepared_by"
                bindinput="changeBookMetadataField"
              />
            </view>
          </view>

          <view class="book-metadata-field">
            <view class="book-metadata-label-row">
              <text class="book-metadata-label">前言</text>
              <button
                class="book-editorial-generate"
                data-target="preface"
                loading="{{bookEditorialCopyBusyTarget === 'preface'}}"
                disabled="{{bookTitleSaving || generatingBook || updatingPlanStructure || bookViewingHistoricalVersion || bookEditorialCopyBusyTarget === 'preface' || !bookContent}}"
                bindtap="regenerateBookEditorialCopy"
              >
                重写
              </button>
            </view>
            <textarea
              class="book-metadata-textarea"
              value="{{bookPrefaceInput}}"
              placeholder="写给家人看的开篇说明"
              maxlength="600"
              auto-height
              disabled="{{bookTitleSaving || generatingBook || updatingPlanStructure || bookViewingHistoricalVersion}}"
              data-key="preface"
              bindinput="changeBookMetadataField"
            />
          </view>

          <view class="book-metadata-field">
            <view class="book-metadata-label-row">
              <text class="book-metadata-label">后记</text>
              <button
                class="book-editorial-generate"
                data-target="afterword"
                loading="{{bookEditorialCopyBusyTarget === 'afterword'}}"
                disabled="{{bookTitleSaving || generatingBook || updatingPlanStructure || bookViewingHistoricalVersion || bookEditorialCopyBusyTarget === 'afterword' || !bookContent}}"
                bindtap="regenerateBookEditorialCopy"
              >
                重写
              </button>
            </view>
            <textarea
              class="book-metadata-textarea"
              value="{{bookAfterwordInput}}"
              placeholder="作为整本书结尾的一段话"
              maxlength="600"
              auto-height
              disabled="{{bookTitleSaving || generatingBook || updatingPlanStructure || bookViewingHistoricalVersion}}"
              data-key="afterword"
              bindinput="changeBookMetadataField"
            />
          </view>

          <view class="book-metadata-field">
            <view class="book-metadata-label-row">
              <text class="book-metadata-label">封底摘录</text>
              <button
                class="book-editorial-generate"
                data-target="back_cover_quote"
                loading="{{bookEditorialCopyBusyTarget === 'back_cover_quote'}}"
                disabled="{{bookTitleSaving || generatingBook || updatingPlanStructure || bookViewingHistoricalVersion || bookEditorialCopyBusyTarget === 'back_cover_quote' || !bookContent}}"
                bindtap="regenerateBookEditorialCopy"
              >
                重写
              </button>
            </view>
            <textarea
              class="book-metadata-textarea compact"
              value="{{bookBackCoverQuoteInput}}"
              placeholder="可以放一句正文原话"
              maxlength="80"
              auto-height
              disabled="{{bookTitleSaving || generatingBook || updatingPlanStructure || bookViewingHistoricalVersion}}"
              data-key="back_cover_quote"
              bindinput="changeBookMetadataField"
            />
          </view>

          <picker
            mode="selector"
            range="{{bookCoverStyleOptions}}"
            range-key="label"
            value="{{bookCoverStyleIndex}}"
            disabled="{{bookTitleSaving || generatingBook || updatingPlanStructure || bookViewingHistoricalVersion}}"
            bindchange="changeBookCoverStyle"
          >
            <view class="book-cover-style-picker">
              <view class="book-cover-preview {{bookCoverStylePreviewClass}}">
                <text class="book-cover-preview-title">{{bookTitleInput || bookPreviewTitle || "回忆录"}}</text>
              </view>
              <view class="book-cover-style-copy">
                <text class="book-cover-style-label">封面风格</text>
                <text class="book-cover-style-detail">{{bookCoverStyleDetailText}}</text>
              </view>
              <text class="book-cover-style-value">{{bookCoverStyleLabel}}</text>
            </view>
          </picker>
        </view>

        <picker
          wx:if="{{bookVersionOptions.length > 1}}"
          class="book-version-picker"
          range="{{bookVersionOptions}}"
          range-key="label"
          value="{{bookSelectedVersionIndex}}"
          bindchange="changeBookOutputVersion"
        >
          <view class="book-version-picker-button">
            <text>查看版本</text>
            <text>{{bookVersionText}}</text>
          </view>
        </picker>
        <text wx:if="{{bookVersionNotice}}" class="book-version-notice">{{bookVersionNotice}}</text>
        <text wx:if="{{bookStaleNotice}}" class="book-stale-notice">{{bookStaleNotice}}</text>
        <view wx:if="{{bookContent}}" class="book-export-layout">
          <picker
            class="book-export-layout-picker"
            range="{{bookExportLayoutOptions}}"
            range-key="label"
            value="{{bookExportLayoutIndex}}"
            bindchange="changeBookExportLayout"
          >
            <view class="book-export-layout-button">
              <text>PDF 排版</text>
              <text>{{bookExportLayoutLabel}}</text>
            </view>
          </picker>
          <text class="book-export-layout-detail">{{bookExportLayoutDetailText}}</text>
        </view>

        <view wx:if="{{bookContent && bookManuscriptAvailable}}" class="book-manuscript-panel">
          <view class="book-manuscript-section">
            <view class="book-manuscript-heading-row">
              <text class="book-manuscript-heading">书稿设置</text>
              <text class="book-manuscript-badge">{{bookManuscriptTemplateLabel}}</text>
            </view>
            <view class="book-manuscript-cover-preview">
              <text class="book-manuscript-title">{{bookManuscriptTitle}}</text>
              <text class="book-manuscript-subtitle">{{bookManuscriptSubtitle}}</text>
            </view>
            <text class="book-manuscript-meta">{{bookManuscriptSettingsText}}</text>
          </view>

          <view class="book-manuscript-section">
            <view class="book-manuscript-heading-row">
              <text class="book-manuscript-heading">书籍结构</text>
              <text class="book-manuscript-count">{{bookManuscriptStructureItems.length}} 项</text>
            </view>
            <view class="book-structure-list">
              <view
                wx:for="{{bookManuscriptStructureItems}}"
                wx:for-item="item"
                wx:key="id"
                class="book-structure-row"
              >
                <view class="book-structure-main">
                  <text class="book-structure-title">{{item.title}}</text>
                  <text class="book-structure-meta">{{item.metaText}}</text>
                </view>
                <text class="book-structure-status">{{item.statusText}}</text>
              </view>
            </view>
          </view>

          <view class="book-manuscript-section">
            <view class="book-manuscript-heading-row">
              <text class="book-manuscript-heading">章节书稿</text>
              <text class="book-manuscript-count">{{bookManuscriptChapterItems.length}} 章</text>
            </view>
            <view class="book-manuscript-chapter-list">
              <view
                wx:for="{{bookManuscriptChapterItems}}"
                wx:for-item="chapter"
                wx:key="id"
                class="book-manuscript-chapter"
              >
                <view class="book-manuscript-chapter-head">
                  <view class="book-manuscript-chapter-title-block">
                    <text class="book-manuscript-chapter-index">{{chapter.indexText}}</text>
                    <text class="book-manuscript-chapter-title">{{chapter.title}}</text>
                  </view>
                </view>
                <view class="book-manuscript-chapter-actions">
                  <button
                    class="chapter-preview-edit"
                    data-id="{{chapter.chapterId}}"
                    bindtap="editBookOutputChapter"
                  >
                    正文
                  </button>
                  <button
                    class="chapter-preview-edit"
                    data-id="{{chapter.chapterId}}"
                    bindtap="openBookChapterEditorialEditor"
                  >
                    文案
                  </button>
                </view>
                <text wx:if="{{chapter.metaText}}" class="book-manuscript-meta">{{chapter.metaText}}</text>
                <text wx:if="{{chapter.intro}}" class="book-manuscript-intro">{{chapter.intro}}</text>
                <view wx:if="{{chapter.quoteText}}" class="book-manuscript-quote">
                  <text>“{{chapter.quoteText}}”</text>
                  <text wx:if="{{chapter.quoteSourceText}}" class="book-manuscript-quote-source">{{chapter.quoteSourceText}}</text>
                </view>
                <view class="book-manuscript-copy-actions">
                  <button
                    class="book-editorial-generate"
                    data-id="{{chapter.chapterId}}"
                    data-target="chapter_intros"
                    loading="{{bookEditorialCopyBusyTarget === 'chapter_intros:' + chapter.chapterId}}"
                    disabled="{{bookTitleSaving || generatingBook || updatingPlanStructure || bookViewingHistoricalVersion || bookEditorialCopyBusyTarget === 'chapter_intros:' + chapter.chapterId}}"
                    bindtap="regenerateBookChapterEditorialCopy"
                  >
                    重写导语
                  </button>
                  <button
                    class="book-editorial-generate"
                    data-id="{{chapter.chapterId}}"
                    data-target="pull_quotes"
                    loading="{{bookEditorialCopyBusyTarget === 'pull_quotes:' + chapter.chapterId}}"
                    disabled="{{bookTitleSaving || generatingBook || updatingPlanStructure || bookViewingHistoricalVersion || bookEditorialCopyBusyTarget === 'pull_quotes:' + chapter.chapterId}}"
                    bindtap="regenerateBookChapterEditorialCopy"
                  >
                    重选引语
                  </button>
                </view>
                <text class="book-manuscript-preview">{{chapter.contentPreview}}</text>
              </view>
            </view>
          </view>

          <view wx:if="{{bookManuscriptBackMatterItems.length}}" class="book-manuscript-section">
            <view class="book-manuscript-heading-row">
              <text class="book-manuscript-heading">附录与说明</text>
              <text class="book-manuscript-count">{{bookManuscriptBackMatterItems.length}} 项</text>
            </view>
            <view class="book-back-matter-list">
              <view
                wx:for="{{bookManuscriptBackMatterItems}}"
                wx:for-item="item"
                wx:key="id"
                class="book-back-matter-row"
              >
                <text class="book-back-matter-kind">{{item.kindText}}</text>
                <view class="book-back-matter-main">
                  <text class="book-back-matter-title">{{item.title}}</text>
                  <text class="book-back-matter-preview">{{item.contentPreview}}</text>
                </view>
              </view>
            </view>
          </view>

          <view class="book-manuscript-section compact">
            <view class="book-manuscript-heading-row">
              <text class="book-manuscript-heading">预览与导出</text>
              <text class="book-manuscript-count">阅读 / 打印 / 文本</text>
            </view>
            <view class="book-export-source-toggle">
              <view class="book-export-source-copy">
                <text class="book-export-source-title">原始讲述索引</text>
                <text class="book-export-source-meta">附上原始讲述，方便以后核对和补充；分享或打印可关闭</text>
              </view>
              <switch
                color="#a64b3f"
                checked="{{bookExportShowSourceAppendix}}"
                bindchange="toggleBookExportSourceAppendix"
              />
            </view>
          </view>
        </view>

        <view wx:if="{{bookChapterEditorialEditorVisible}}" class="book-chapter-editorial-panel">
          <view class="book-manuscript-heading-row">
            <view class="book-chapter-editorial-title-block">
              <text class="book-manuscript-heading">章节文案</text>
              <text class="book-manuscript-meta">{{bookChapterEditorialChapterTitle}}</text>
            </view>
            <button class="chapter-preview-edit" bindtap="closeBookChapterEditorialEditor">收起</button>
          </view>
          <view class="book-metadata-field">
            <text class="book-metadata-label">章节导语</text>
            <textarea
              class="book-metadata-textarea compact"
              value="{{bookChapterEditorialIntroInput}}"
              placeholder="35-90 字，像书里的自然过渡"
              maxlength="180"
              auto-height
              disabled="{{bookEditorialCopyBusyTarget || bookTitleSaving}}"
              data-key="intro"
              bindinput="changeBookChapterEditorialField"
            />
          </view>
          <view class="book-metadata-field">
            <text class="book-metadata-label">章首引语</text>
            <textarea
              class="book-metadata-textarea compact"
              value="{{bookChapterEditorialPullQuoteInput}}"
              placeholder="优先保留原始口述原句"
              maxlength="120"
              auto-height
              disabled="{{bookEditorialCopyBusyTarget || bookTitleSaving}}"
              data-key="pull_quote"
              bindinput="changeBookChapterEditorialField"
            />
            <text wx:if="{{bookChapterEditorialSourceText}}" class="book-chapter-editorial-source">{{bookChapterEditorialSourceText}}</text>
          </view>
          <view class="actions-row compact">
            <button
              class="primary-button"
              loading="{{bookEditorialCopyBusyTarget === 'manual:' + bookChapterEditorialChapterId}}"
              disabled="{{bookEditorialCopyBusyTarget || bookTitleSaving}}"
              bindtap="saveBookChapterEditorialCopy"
            >
              保存文案
            </button>
            <button
              class="ghost-button"
              disabled="{{bookEditorialCopyBusyTarget || bookTitleSaving}}"
              bindtap="closeBookChapterEditorialEditor"
            >
              取消
            </button>
          </view>
        </view>

        <view wx:if="{{bookContent}}" class="book-preview">
          <block wx:if="{{playingTarget === 'book' && bookTTSActiveTarget === 'book'}}">
            <view class="tts-progress-bar">
              <view class="tts-progress-fill" style="width: {{bookTTSProgressPercent}}%;"></view>
            </view>
            <text class="tts-highlight-text book" selectable>
              <text class="tts-spoken">{{bookTTSSpokenText}}</text>
              <text wx:if="{{bookTTSCurrentText}}" class="tts-current">{{bookTTSCurrentText}}</text>
              <text class="tts-remaining">{{bookTTSRemainingText}}</text>
            </text>
          </block>
          <block wx:elif="{{bookPreviewChapters.length}}">
            <view class="book-preview-cover">
              <text class="book-preview-title">{{bookPreviewTitle}}</text>
              <text class="book-preview-subtitle">{{bookPreviewChapters.length}} 章 · {{bookCharCount}} 字</text>
            </view>
            <view class="book-preview-toc">
              <view class="book-preview-label-row">
                <text class="book-preview-label">目录</text>
                <text class="book-preview-label-meta">按当前章节顺序</text>
              </view>
              <view
                wx:for="{{bookPreviewTocItems}}"
                wx:for-item="toc"
                wx:key="id"
                class="book-toc-row"
                data-id="{{toc.chapterId}}"
                bindtap="editBookOutputChapter"
              >
                <text class="book-toc-index">{{toc.indexText}}</text>
                <view class="book-toc-main">
                  <text class="book-toc-title">{{toc.title}}</text>
                  <text class="book-toc-meta">{{toc.metaText}}</text>
                </view>
                <text class="book-toc-action">编辑</text>
              </view>
            </view>
            <button
              class="book-preview-toggle"
              bindtap="toggleBookPreviewChapters"
            >
              {{bookPreviewChaptersExpanded ? "收起章节正文" : "展开章节正文"}}
            </button>
            <view wx:if="{{bookPreviewChaptersExpanded}}" class="book-preview-chapters">
              <view
                wx:for="{{bookPreviewChapters}}"
                wx:for-item="chapter"
                wx:key="id"
                class="book-preview-chapter"
              >
                <view class="book-preview-chapter-head">
                  <view class="book-preview-chapter-title-block">
                    <text class="book-preview-chapter-index">{{chapter.indexText}}</text>
                    <text class="book-preview-chapter-title">{{chapter.title}}</text>
                  </view>
                  <button
                    class="chapter-preview-edit"
                    data-id="{{chapter.chapterId}}"
                    bindtap="editBookOutputChapter"
                  >
                    编辑本章
                  </button>
                </view>
                <text class="book-preview-chapter-meta">{{chapter.metaText}}</text>
                <text class="book-preview-chapter-content" selectable>{{chapter.content}}</text>
              </view>
            </view>
          </block>
          <text wx:else class="book-output-text" selectable>{{bookContent}}</text>
        </view>
        <view wx:else class="draft-empty">
          <text>全书会直接使用已确认章节正文，不额外扩写叙述内容。</text>
        </view>
        </view>

        <view wx:if="{{bookOutputDetailsExpanded}}" class="actions-row">
          <button
            class="ghost-button"
            loading="{{generatingBook}}"
            disabled="{{updatingPlanStructure || generatingBook || ttsBusyTarget || !canGenerateBook}}"
            bindtap="generateBook"
          >
            {{bookActionText}}
          </button>
          <button
            class="ghost-button"
            loading="{{ttsBusyTarget === 'book'}}"
            disabled="{{updatingPlanStructure || generatingBook || !bookContent || hasDraftChanges || bookStaleNotice || bookViewingHistoricalVersion || ttsBusyTarget}}"
            bindtap="playBookAudio"
          >
            {{ttsBusyTarget === "book" ? "准备朗读" : (playingTarget === "book" ? "停止朗读" : "朗读全书")}}
          </button>
          <button
            class="ghost-button"
            data-format="pdf"
            loading="{{bookExportBusyTarget === 'book-export:pdf:' + bookExportLayout}}"
            disabled="{{updatingPlanStructure || generatingBook || !bookContent || hasDraftChanges || bookStaleNotice || bookExportBusyTarget}}"
            bindtap="downloadBookOutputExport"
          >
            阅读版 PDF
          </button>
          <button
            class="ghost-button"
            data-format="pdf"
            data-layout="large_print"
            loading="{{bookExportBusyTarget === 'book-export:pdf:large_print'}}"
            disabled="{{updatingPlanStructure || generatingBook || !bookContent || hasDraftChanges || bookStaleNotice || bookExportBusyTarget}}"
            bindtap="downloadBookOutputExport"
          >
            打印版 PDF
          </button>
          <button
            class="ghost-button"
            data-format="txt"
            loading="{{bookExportBusyTarget === 'book-export:txt:standard'}}"
            disabled="{{updatingPlanStructure || generatingBook || !bookContent || hasDraftChanges || bookStaleNotice || bookExportBusyTarget}}"
            bindtap="downloadBookOutputExport"
          >
            导出文本
          </button>
        </view>
      </view>
    </view>
  </view>
  </block>
  </block>

  <view class="bottom-spacer"></view>
</view>
