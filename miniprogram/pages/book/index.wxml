<view class="book-page">
  <view class="top-row">
    <view class="back-hit" bindtap="openHome">
      <text class="back-mark">‹</text>
    </view>
    <view class="title-block">
      <text class="page-title">成书</text>
      <text class="page-meta">{{projectTitle || "我的回忆录"}} · {{stageText}}</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view wx:if="{{needsLogin}}" class="empty-panel guest-panel">
    <image class="empty-icon" src="/assets/memoir-gramophone.png" mode="aspectFit" />
    <text class="empty-title">浏览整理成书</text>
    <text class="empty-copy">登录后可以把语音转写归入章节，确认章节正文，再生成全书和章节朗读。</text>
    <view class="guest-steps">
      <text>1. 先生成章节规划</text>
      <text>2. 再逐章整理正文</text>
      <text>3. 最后合成全书朗读</text>
    </view>
    <view class="actions-row">
      <button class="primary-button" bindtap="openLogin">登录后整理</button>
      <button class="ghost-button" bindtap="openHome">返回首页</button>
    </view>
  </view>

  <block wx:else>
  <view wx:if="{{!projectId}}" class="empty-panel">
    <image class="empty-icon" src="/assets/memoir-gramophone.png" mode="aspectFit" />
    <text class="empty-title">还没有回忆录</text>
    <text class="empty-copy">先创建一本回忆录并设置讲述资料，完成语音转写后再整理成书。</text>
    <view class="actions-row">
      <button class="primary-button" bindtap="createProject">创建回忆录</button>
      <button class="ghost-button" bindtap="openHome">返回首页</button>
    </view>
  </view>

  <block wx:else>
  <view class="status-panel">
    <view>
      <text class="status-title">{{planTitle || "整理成书"}}</text>
      <text class="status-meta">{{progressText}}</text>
    </view>
    <text class="status-pill">{{stageText}}</text>
  </view>

  <view wx:if="{{sourceCoverageNotice}}" class="coverage-section">
    <view class="coverage-head">
      <view class="coverage-copy">
        <view class="coverage-title-row">
          <text class="coverage-title">待收录转写</text>
          <text class="coverage-count">{{uncoveredSourceDisplayText}}</text>
        </view>
        <text class="coverage-meta">{{sourceCoverageNotice}}，新录音不会自动改动已确认章节和全书。</text>
      </view>
      <button class="coverage-link" bindtap="openTranscripts">转写记录</button>
    </view>

    <view wx:if="{{plan && chapterPickerOptions.length && uncoveredSources.length}}" class="coverage-source-list">
      <view wx:for="{{uncoveredSources}}" wx:key="utterance_id" class="coverage-source-card">
        <view class="coverage-source-main">
          <text class="coverage-source-time">{{item.createdAtText}}</text>
          <text class="coverage-source-text">{{item.previewText}}</text>
        </view>
        <view class="coverage-source-actions">
          <picker
            mode="selector"
            range="{{chapterPickerOptions}}"
            range-key="label"
            data-id="{{item.utterance_id}}"
            disabled="{{assigningSourceId || updatingPlanStructure}}"
            bindchange="assignUncoveredSource"
          >
            <view class="coverage-assign {{assigningSourceId === item.utterance_id ? 'loading' : ''}}">
              {{assigningSourceId === item.utterance_id ? "归入中" : "归入章节"}}
            </view>
          </picker>
        </view>
      </view>
    </view>

    <view wx:elif="{{!plan}}" class="coverage-empty">
      <text>生成章节规划后可以收录这些转写。</text>
    </view>
  </view>

  <view wx:if="{{loading && !plan}}" class="empty-panel">
    <text>正在加载</text>
  </view>

  <view wx:elif="{{!plan}}" class="empty-panel">
    <image class="empty-icon" src="/assets/memoir-gramophone.png" mode="aspectFit" />
    <text class="empty-title">从转写生成章节</text>
    <text class="empty-copy">系统会先把当前回忆录转写划分为若干章节。你确认章节后，再逐章生成正文。</text>
    <view class="actions-row">
      <button
        class="primary-button"
        loading="{{generatingPlan}}"
        disabled="{{loading || generatingPlan || !projectId}}"
        bindtap="generatePlan"
      >
        生成章节规划
      </button>
      <button class="ghost-button" disabled="{{generatingPlan}}" bindtap="openTranscripts">
        查看转写
      </button>
    </view>
  </view>

  <view wx:elif="{{stage === 'plan_draft'}}" class="section">
    <view class="field-block">
      <text class="field-label">目录名称</text>
      <input
        class="title-input"
        value="{{planTitle}}"
        bindinput="changePlanTitle"
        maxlength="120"
      />
    </view>

    <view class="section-head">
      <text class="section-title">确认章节</text>
      <text class="section-count">{{chapters.length}} 章</text>
    </view>

    <view wx:for="{{chapters}}" wx:key="id" class="chapter-card">
      <view class="chapter-head">
        <text class="chapter-index">第 {{index + 1}} 章</text>
        <text class="source-count">{{item.sourceCount}} 条来源</text>
      </view>

      <input
        class="chapter-title-input"
        value="{{item.editingTitle}}"
        data-id="{{item.id}}"
        bindinput="changeChapterTitle"
        maxlength="80"
      />

      <textarea
        class="summary-textarea"
        value="{{item.editingSummary}}"
        data-id="{{item.id}}"
        bindinput="changeChapterSummary"
        maxlength="-1"
        auto-height
        cursor-spacing="24"
      />

      <text class="source-preview">{{item.sourceSummary}}</text>

      <view class="actions-row compact">
        <button
          class="ghost-button"
          data-id="{{item.id}}"
          loading="{{titleBusyTarget === item.id}}"
          bindtap="generateChapterTitle"
          disabled="{{confirmingPlan || generatingPlan || titleBusyTarget || updatingPlanStructure}}"
        >
          {{titleBusyTarget === item.id ? "起名中" : "AI 起名"}}
        </button>
        <button
          class="danger-button"
          data-id="{{item.id}}"
          bindtap="removeChapter"
          disabled="{{confirmingPlan || chapters.length <= 1}}"
        >
          删除本章
        </button>
      </view>
    </view>

    <view class="sticky-actions">
      <button
        class="ghost-button"
        loading="{{generatingPlan}}"
        disabled="{{generatingPlan || confirmingPlan}}"
        bindtap="generatePlan"
      >
        重新规划
      </button>
      <button
        class="primary-button"
        loading="{{confirmingPlan}}"
        disabled="{{generatingPlan || confirmingPlan || !chapters.length}}"
        bindtap="confirmPlan"
      >
        确认章节
      </button>
    </view>
  </view>

  <view wx:else class="section">
    <view class="section-head">
      <text class="section-title">逐章成稿</text>
      <text class="section-count">{{confirmedDraftCount}}/{{totalChapterCount}} 已确认</text>
    </view>

    <view wx:for="{{chapters}}" wx:key="id" class="chapter-card">
      <view class="chapter-head">
        <view class="chapter-title-block">
          <text class="chapter-index">第 {{index + 1}} 章</text>
        </view>
        <text class="draft-status {{item.draft && item.draft.status === 'confirmed' ? 'confirmed' : ''}}">
          {{item.draftStatusText}}
        </text>
      </view>

      <view class="chapter-title-edit-row">
        <input
          class="chapter-title-inline-input"
          value="{{item.editingTitle}}"
          placeholder="输入章节名"
          data-id="{{item.id}}"
          bindinput="changeChapterTitle"
          maxlength="80"
          disabled="{{updatingPlanStructure || titleBusyTarget === item.id}}"
        />
        <view class="chapter-title-actions">
          <button
            class="title-action-button"
            data-id="{{item.id}}"
            loading="{{titleBusyTarget === item.id}}"
            bindtap="generateChapterTitle"
            disabled="{{updatingPlanStructure || item.draftBusy || titleBusyTarget}}"
          >
            {{titleBusyTarget === item.id ? "起名中" : "AI 起名"}}
          </button>
          <button
            class="title-action-button primary"
            data-id="{{item.id}}"
            bindtap="saveChapterTitle"
            disabled="{{updatingPlanStructure || item.draftBusy || titleBusyTarget}}"
          >
            保存章名
          </button>
        </view>
      </view>

      <text wx:if="{{item.summary}}" class="chapter-summary">{{item.summary}}</text>
      <text class="source-preview">{{item.sourceSummary}}</text>
      <text wx:if="{{item.sourceChangeNotice}}" class="draft-pending">{{item.sourceChangeNotice}}</text>

      <view wx:if="{{!item.draft || !item.draft.latest_version}}" class="draft-empty">
        <text>还没有章节正文</text>
      </view>

      <view wx:else class="draft-editor">
        <view class="draft-meta-row">
          <text class="draft-version">{{item.draftVersionText}}</text>
          <text class="draft-count">{{item.draftCharCount}} 字</text>
        </view>
        <textarea
          class="draft-textarea"
          value="{{item.draftContent}}"
          data-id="{{item.id}}"
          bindinput="changeDraftContent"
          maxlength="-1"
          auto-height
          cursor-spacing="24"
        />
        <view
          wx:if="{{playingTarget === item.ttsTarget && bookTTSActiveTarget === item.ttsTarget}}"
          class="tts-highlight-card"
        >
          <view class="tts-progress-bar">
            <view class="tts-progress-fill" style="width: {{bookTTSProgressPercent}}%;"></view>
          </view>
          <text class="tts-highlight-text" selectable>
            <text class="tts-spoken">{{bookTTSSpokenText}}</text>
            <text wx:if="{{bookTTSCurrentText}}" class="tts-current">{{bookTTSCurrentText}}</text>
            <text class="tts-remaining">{{bookTTSRemainingText}}</text>
          </text>
        </view>
      </view>

      <view wx:if="{{item.draftError}}" class="chapter-error">{{item.draftError}}</view>

      <view class="actions-row">
        <button
          class="ghost-button"
          data-id="{{item.id}}"
          disabled="{{updatingPlanStructure || item.draftBusy || item.draftChanged || (item.removedSourceCount && !item.sourceCount)}}"
          bindtap="generateChapterDraft"
        >
          {{item.draftActionText}}
        </button>
        <button
          class="ghost-button"
          data-id="{{item.id}}"
          disabled="{{updatingPlanStructure || item.draftBusy || !item.draftChanged}}"
          bindtap="saveChapterDraft"
        >
          保存修改
        </button>
        <button
          class="primary-button"
          data-id="{{item.id}}"
          disabled="{{updatingPlanStructure || item.draftBusy || !item.draft || !item.draft.latest_version || item.draft.status === 'confirmed' || item.draftChanged}}"
          bindtap="confirmChapterDraft"
        >
          确认本章
        </button>
        <button
          class="ghost-button"
          data-id="{{item.id}}"
          loading="{{ttsBusyTarget === item.ttsTarget}}"
          disabled="{{updatingPlanStructure || item.draftBusy || item.draftChanged || !item.draft || !item.draft.latest_version || ttsBusyTarget}}"
          bindtap="playChapterAudio"
        >
          {{ttsBusyTarget === item.ttsTarget ? "准备朗读" : (playingTarget === item.ttsTarget ? "停止朗读" : "朗读本章")}}
        </button>
        <button
          class="danger-button"
          data-id="{{item.id}}"
          disabled="{{updatingPlanStructure || item.draftBusy || chapters.length <= 1}}"
          bindtap="deleteConfirmedChapter"
        >
          删除本章
        </button>
      </view>
    </view>

    <view class="book-output-card">
      <view class="section-head inline">
        <text class="section-title">全书成稿</text>
        <text class="section-count">{{bookVersionText}}</text>
      </view>

      <view wx:if="{{!allChaptersConfirmed}}" class="draft-empty">
        <text>确认所有章节后，可以把当前章节内容合成为全书。</text>
      </view>
      <view wx:elif="{{hasDraftChanges}}" class="draft-empty">
        <text>当前有未保存的章节修改，保存后再生成全书。</text>
      </view>
      <view wx:else>
        <view class="book-output-meta">
          <text>{{bookContent ? bookCharCount + " 字" : "尚未生成正文"}}</text>
          <text>按已确认章节顺序合成</text>
        </view>
        <text wx:if="{{bookStaleNotice}}" class="book-stale-notice">{{bookStaleNotice}}</text>

        <view wx:if="{{bookContent}}" class="book-preview">
          <block wx:if="{{playingTarget === 'book' && bookTTSActiveTarget === 'book'}}">
            <view class="tts-progress-bar">
              <view class="tts-progress-fill" style="width: {{bookTTSProgressPercent}}%;"></view>
            </view>
            <text class="tts-highlight-text book" selectable>
              <text class="tts-spoken">{{bookTTSSpokenText}}</text>
              <text wx:if="{{bookTTSCurrentText}}" class="tts-current">{{bookTTSCurrentText}}</text>
              <text class="tts-remaining">{{bookTTSRemainingText}}</text>
            </text>
          </block>
          <text wx:else class="book-output-text" selectable>{{bookContent}}</text>
        </view>
        <view wx:else class="draft-empty">
          <text>全书会直接使用已确认章节正文，不额外扩写叙述内容。</text>
        </view>

        <view class="actions-row">
          <button
            class="primary-button"
            loading="{{generatingBook}}"
            disabled="{{updatingPlanStructure || generatingBook || ttsBusyTarget || !canGenerateBook}}"
            bindtap="generateBook"
          >
            {{bookActionText}}
          </button>
          <button
            class="ghost-button"
            loading="{{ttsBusyTarget === 'book'}}"
            disabled="{{updatingPlanStructure || generatingBook || !bookContent || hasDraftChanges || bookStaleNotice || ttsBusyTarget}}"
            bindtap="playBookAudio"
          >
            {{ttsBusyTarget === "book" ? "准备朗读" : (playingTarget === "book" ? "停止朗读" : "朗读全书")}}
          </button>
        </view>
      </view>
    </view>
  </view>
  </block>
  </block>

  <view class="bottom-spacer"></view>
</view>
