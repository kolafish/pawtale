<import src="../../templates/reading-share.wxml" />
<import src="../../templates/share-likes.wxml" />
<view class="ui-page-shell {{pageClass}}">
  <view wx:if="{{error}}" class="error ui-error-banner">{{error}}</view>
  <view wx:if="{{showingCachedBook}}" class="book-cache-banner ui-error-banner">
    <text>暂时无法获取最新书稿，当前显示上次保存的内容。</text>
    <button class="book-cache-retry" size="mini" bindtap="loadBookHome">重试刷新</button>
  </view>

  <view wx:if="{{loading}}" class="empty-panel ui-card" aria-live="polite">正在读取书稿…</view>
  <view wx:elif="{{loadError}}" class="empty-panel ui-card">
    <text class="empty-title">暂时没能打开书稿</text>
    <text class="empty-copy">{{loadError}}</text>
    <view class="actions-row">
      <button class="primary-button" bindtap="loadBookHome">重新读取</button>
    </view>
  </view>
  <view wx:elif="{{needsLogin}}" class="empty-panel guest-panel ui-card">
    <image class="empty-icon" src="/assets/memoir-gramophone.png" mode="aspectFit" />
    <text class="empty-title">浏览书稿</text>
    <text class="empty-copy">登录后阅读、编辑和导出书稿。</text>
    <view class="actions-row">
      <button class="primary-button" bindtap="openLogin">登录后整理</button>
      <button class="ghost-button" bindtap="openHome">返回首页</button>
    </view>
  </view>

  <block wx:else>
  <view wx:if="{{!projectId}}" class="empty-panel ui-card">
    <image class="empty-icon" src="/assets/memoir-gramophone.png" mode="aspectFit" />
    <text class="empty-title">还没有回忆录</text>
    <view class="actions-row">
      <button class="primary-button" bindtap="createProject">创建回忆录</button>
      <button class="ghost-button" bindtap="openHome">返回首页</button>
    </view>
  </view>

  <block wx:else>
  <view class="status-panel progress-panel ui-card">
    <view class="progress-main">
      <view class="progress-title-row">
        <text class="status-title">{{bookPreviewTitle || planTitle || "书稿"}}</text>
      </view>
      <text class="status-meta">{{bookContentAvailable && bookIncludedChapterCount < totalChapterCount ? '当前书稿收录 ' + bookIncludedChapterCount + '/' + totalChapterCount : totalChapterCount}} 章 · {{bookCharCountText}} 字</text>
      <image
        class="book-header-illustration"
        src="/assets/memoir-book-header.png"
        mode="aspectFit"
        aria-hidden="true"
      />
    </view>
    <view class="progress-actions">
      <template wx:if="{{bookContentAvailable}}" is="readingShareActions" data="{{bookShareActive, bookShareReady, bookShareStale, bookShareBusy, bookShareStatusKnown, bookShareDescription, bookShareLikeCount, bookShareLikers, showBookReader: true, bookStaleNotice}}" />
    </view>
    <view wx:if="{{bookStaleNotice || bookActivityNotice}}" class="book-activity-notice" bindtap="openBookActivity" aria-role="button">
      <text>{{bookPendingMaterialCount ? bookActivityNotice : (bookStaleNotice || bookActivityNotice)}}</text><text aria-hidden="true">›</text>
    </view>
  </view>

  <view
    wx:if="{{ttsBusyTarget || playingTarget || bookTTSActiveTarget}}"
    class="book-tts-shell"
  >
    <book-tts-player
      title="目录朗读"
      phase="{{ttsBusyTarget ? 'preparing' : (playingTarget ? 'playing' : 'completed')}}"
      progress="{{bookTTSProgressPercent}}"
      spoken-text="{{bookTTSSpokenText}}"
      current-text="{{bookTTSCurrentText}}"
      remaining-text="{{bookTTSRemainingText}}"
      bindstop="stopPlayback"
    />
  </view>

  <view class="book-operation-list ui-card">
    <view class="book-operation-row ui-pressable {{stage !== 'drafting' ? 'is-disabled' : ''}}" aria-role="button" aria-disabled="{{stage !== 'drafting'}}" bindtap="openBookCompletion">
      <view class="book-operation-copy"><text class="book-operation-title">书稿建议</text><text wx:if="{{blockingIssueCount}}" class="book-operation-notice">{{blockingIssueCount}} 项待核对，相关章节暂未入书</text></view><text class="book-row-arrow">›</text>
    </view>
    <view class="book-operation-row ui-pressable" aria-role="button" data-action="settings" bindtap="openBookExportPage">
      <view class="book-operation-copy"><text class="book-operation-title">书的设置</text></view><text class="book-row-arrow">›</text>
    </view>
    <view class="book-operation-row ui-pressable {{!bookContentAvailable ? 'is-disabled' : ''}}" aria-role="button" aria-disabled="{{!bookContentAvailable}}" data-action="files" bindtap="openBookExportPage">
      <view class="book-operation-copy"><text class="book-operation-title">导出文件</text></view><text class="book-row-arrow">›</text>
    </view>
  </view>

  <view wx:if="{{stage === 'empty'}}" class="empty-panel ui-card">
    <image class="empty-icon" src="/assets/memoir-gramophone.png" mode="aspectFit" />
    <text class="empty-title">讲述后会自动整理成书</text>
    <view class="actions-row">
      <button class="primary-button" bindtap="openHome">去讲述</button>
      <button class="ghost-button" bindtap="continueBookDraft" loading="{{retryingDraft}}" disabled="{{retryingDraft || !projectId}}">继续整理已有讲述</button>
    </view>
  </view>

  <view wx:else class="section">
    <view wx:if="{{planNeedsActivation}}" class="empty-panel ui-card">
      <text class="empty-copy">保留目录，继续整理正文。</text>
      <button class="primary-button" bindtap="continueBookDraft" loading="{{retryingDraft}}" disabled="{{retryingDraft}}">继续整理成书</button>
    </view>
    <view class="section-head chapter-section-head">
      <view class="section-head-copy">
        <text class="section-title">{{chapterStructureEditing ? "编辑目录" : "目录"}}</text>
        <text wx:if="{{chapterStructureEditing && updatingPlanStructure}}" class="section-count saving">正在保存顺序…</text>
      </view>
      <view
        class="section-head-action chapter-order-toggle {{updatingPlanStructure ? 'is-locked' : ''}}"
        hover-class="section-head-action-active"
        aria-role="button"
        aria-disabled="{{updatingPlanStructure}}"
        bindtap="toggleChapterStructureEditing"
      >
        {{chapterStructureEditing ? "完成" : "编辑目录"}}
      </view>
    </view>

    <view wx:if="{{chapterStructureEditing}}" class="chapter-order-panel" aria-busy="{{updatingPlanStructure}}">
      <view
        wx:for="{{chapters}}"
        wx:key="id"
        class="chapter-order-row {{planStructureBusyChapterId === item.id ? 'is-saving' : ''}}"
      >
        <view class="chapter-order-copy">
          <text class="chapter-order-index">第 {{index + 1}} 章</text>
          <text class="chapter-order-title">{{item.editingTitle || item.title || "未命名章节"}}</text>
        </view>
        <view class="chapter-order-actions">
          <view
            class="chapter-order-edit {{item.draftBusy ? 'is-unavailable' : ''}} {{updatingPlanStructure ? 'is-locked' : ''}}"
            hover-class="chapter-order-button-active"
            aria-role="button"
            aria-label="编辑第 {{index + 1}} 章"
            aria-disabled="{{updatingPlanStructure || item.draftBusy}}"
            data-id="{{item.id}}"
            bindtap="openChapterEditor"
          >
            编辑
          </view>
          <view
            class="chapter-order-button {{!item.canMoveUp ? 'is-unavailable' : ''}} {{updatingPlanStructure ? 'is-locked' : ''}} {{planStructureBusyChapterId === item.id && planStructureBusyDirection === 'up' ? 'is-saving' : ''}}"
            hover-class="chapter-order-button-active"
            aria-role="button"
            aria-label="第 {{index + 1}} 章上移"
            aria-disabled="{{updatingPlanStructure || !item.canMoveUp}}"
            data-id="{{item.id}}"
            data-direction="up"
            bindtap="moveChapter"
          >
            {{planStructureBusyChapterId === item.id && planStructureBusyDirection === "up" ? "…" : "↑"}}
          </view>
          <view
            class="chapter-order-button {{!item.canMoveDown ? 'is-unavailable' : ''}} {{updatingPlanStructure ? 'is-locked' : ''}} {{planStructureBusyChapterId === item.id && planStructureBusyDirection === 'down' ? 'is-saving' : ''}}"
            hover-class="chapter-order-button-active"
            aria-role="button"
            aria-label="第 {{index + 1}} 章下移"
            aria-disabled="{{updatingPlanStructure || !item.canMoveDown}}"
            data-id="{{item.id}}"
            data-direction="down"
            bindtap="moveChapter"
          >
            {{planStructureBusyChapterId === item.id && planStructureBusyDirection === "down" ? "…" : "↓"}}
          </view>
        </view>
      </view>
    </view>

    <block wx:else>
      <view class="chapter-directory ui-card">
        <view wx:for="{{chapters}}" wx:key="id" id="chapter-editor-{{item.id}}" class="chapter-directory-row ui-pressable {{updatingPlanStructure || item.draftBusy ? 'is-disabled' : ''}}" data-id="{{item.id}}" bindtap="openChapterEditor" aria-role="button" aria-disabled="{{updatingPlanStructure || item.draftBusy}}">
          <text class="chapter-directory-index">{{index + 1 < 10 ? '0' : ''}}{{index + 1}}</text>
          <view class="chapter-directory-copy">
            <text class="chapter-directory-title">{{item.editingTitle || item.title || "未命名章节"}}</text>
            <text class="chapter-directory-meta">{{item.chapterSummaryMetaText}}</text>
            <text wx:if="{{item.chapterActivityText || item.bookInclusionNotice || item.chapterNeedsAction}}" class="chapter-directory-notice">{{item.chapterActivityText || item.bookInclusionNotice || item.chapterGuidanceText}}</text>
            <text wx:if="{{item.draftError}}" class="chapter-directory-error">{{item.draftError}}</text>
          </view>
          <text class="book-row-arrow" aria-hidden="true">›</text>
        </view>
      </view>
    </block>

  </view>
  </block>
  </block>

  <view class="bottom-spacer"></view>
</view>
