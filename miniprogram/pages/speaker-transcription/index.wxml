<view class="{{pageClass}}">
  <view class="top-row">
    <view class="back-hit" bindtap="goBack">
      <text class="back-mark">‹</text>
    </view>
    <view class="title-block">
      <text class="page-title">多人实时转写</text>
      <text class="page-meta">本次转写仅在当前页面显示，不保存到素材库</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="{{controlPanelClass}}">
    <view class="control-head">
      <view>
        <text class="control-title">实时对话流</text>
        <text class="control-meta">最新内容在上方，本次记录不会留存</text>
      </view>
      <text class="{{statusClass}}">{{statusText}}</text>
    </view>

    <view wx:if="{{showFullControls}}" class="level-track">
      <view class="level-fill" style="{{audioLevelStyle}}"></view>
    </view>

    <view class="actions-row">
      <button
        class="{{primaryButtonClass}}"
        loading="{{busy}}"
        disabled="{{busy}}"
        bindtap="toggleRecording"
      >
        {{primaryButtonText}}
      </button>
      <button
        class="secondary-button"
        disabled="{{clearDisabled}}"
        bindtap="clearTranscript"
      >
        清空
      </button>
    </view>

    <view wx:if="{{showFullControls && showDiarizationNotice}}" class="{{diarizationNoticeClass}}">
      <text>{{diarizationNotice}}</text>
    </view>
  </view>

  <view wx:if="{{showEmpty}}" class="empty-panel">
    <text class="empty-title">等待实时转写</text>
    <text class="empty-copy">开始后，最新识别会固定显示在最上方。</text>
  </view>

  <scroll-view
    wx:if="{{!showEmpty}}"
    class="conversation-scroll"
    scroll-y="{{true}}"
    scroll-into-view="{{conversationScrollTarget}}"
    scroll-with-animation="{{false}}"
  >
    <view wx:if="{{activePartial.visible}}" id="active-partial-card" class="{{activePartial.partialBoxClass}}">
      <view class="line-meta-row">
        <text class="{{activePartial.speakerBadgeClass}}">{{activePartial.speakerTitle}}</text>
        <text class="partial-label">正在说</text>
      </view>
      <scroll-view
        class="partial-scroll"
        scroll-y="{{true}}"
        scroll-top="{{activePartial.partialScrollTop}}"
      >
        <text class="partial-text">{{activePartial.text}}</text>
      </scroll-view>
    </view>

    <view
      wx:for="{{conversationLines}}"
      wx:key="id"
      id="{{item.domId}}"
      class="{{item.lineClass}}"
    >
      <view class="line-meta-row">
        <text class="{{item.speakerBadgeClass}}">{{item.speakerTitle}}</text>
        <text wx:if="{{item.metaText}}" class="line-meta">{{item.metaText}}</text>
        <text wx:if="{{item.proofreadStatusText}}" class="line-status {{item.proofreadLoading ? 'loading' : ''}}">
          {{item.proofreadStatusText}}
        </text>
      </view>
      <text class="{{item.textClass}}">{{item.text}}</text>
    </view>
  </scroll-view>

  <view class="bottom-spacer"></view>
</view>
