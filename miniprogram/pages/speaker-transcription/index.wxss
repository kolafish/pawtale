.speaker-transcription-page {
  min-height: 100vh;
  padding: 44rpx 30rpx 128rpx;
  background: #f7f3ed;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

.top-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 28rpx;
}

.back-hit {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-mark {
  color: #a64b3e;
  font-size: 72rpx;
  line-height: 1;
}

.title-block {
  min-width: 0;
}

.page-title {
  display: block;
  color: #2b1713;
  font-size: 48rpx;
  font-weight: 850;
  line-height: 1.2;
}

.page-meta {
  display: block;
  margin-top: 8rpx;
  color: #7b6f68;
  font-size: 30rpx;
  line-height: 1.35;
}

.error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff1f3;
  color: #b84a5a;
  font-size: 32rpx;
  line-height: 1.45;
  word-break: break-word;
}

.control-panel,
.empty-panel {
  border: 2rpx solid #e7d8c9;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(64, 43, 24, 0.06);
  box-sizing: border-box;
}

.control-panel {
  padding: 32rpx;
  background: #fffdf9;
}

.control-panel.compact {
  padding: 22rpx 24rpx;
}

.control-head,
.actions-row {
  display: flex;
  align-items: center;
}

.control-head {
  justify-content: space-between;
  gap: 22rpx;
}

.control-title {
  display: block;
  color: #2b1713;
  font-size: 38rpx;
  font-weight: 850;
  line-height: 1.3;
}

.control-meta {
  display: block;
  margin-top: 8rpx;
  color: #7b6f68;
  font-size: 28rpx;
  line-height: 1.35;
}

.control-panel.compact .control-meta {
  display: none;
}

.status-pill {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f4f1ec;
  color: #62554d;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.25;
}

.status-pill.live {
  background: var(--ui-success-surface);
  color: var(--ui-success-text);
}

.status-pill.error-state {
  background: #fff1f3;
  color: #b84a5a;
}

.level-track {
  width: 100%;
  height: 18rpx;
  margin-top: 26rpx;
  border-radius: 999rpx;
  background: #eadfd3;
  overflow: hidden;
}

.level-fill {
  height: 100%;
  min-width: 0;
  border-radius: 999rpx;
  background: #a64b3e;
  transition: width 120ms ease;
}

.actions-row {
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
}

.control-panel.compact .actions-row {
  margin-top: 18rpx;
}

.primary-button,
.secondary-button {
  height: 98rpx;
  margin: 0;
  border: 0;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 850;
  line-height: 1;
}

.control-panel.compact .primary-button,
.control-panel.compact .secondary-button {
  height: 82rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

.primary-button {
  flex: 1 1 auto;
  background: #a64b3e;
  color: #ffffff;
}

.primary-button.stop {
  background: #2b1713;
}

.secondary-button {
  width: 184rpx;
  flex: 0 0 184rpx;
  background: #fff3ef;
  color: #8f3e35;
}

.primary-button[disabled],
.secondary-button[disabled] {
  opacity: 0.62;
}

.diarization-notice {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  color: #62554d;
  background: #f8f4ef;
  font-size: 30rpx;
  font-weight: 750;
  line-height: 1.45;
}

.diarization-notice.warning {
  border: 2rpx solid #e2b36d;
  background: #fff8e8;
  color: #6e4c14;
}

.diarization-notice.ok {
  border: 2rpx solid #c9d1b9;
  background: var(--ui-success-surface);
  color: var(--ui-success-text);
}

.empty-panel {
  margin-top: 24rpx;
  padding: 46rpx 34rpx;
}

.empty-title {
  display: block;
  color: #2b1713;
  font-size: 42rpx;
  font-weight: 850;
  line-height: 1.25;
}

.empty-copy {
  display: block;
  margin-top: 12rpx;
  color: #7b6f68;
  font-size: 32rpx;
  line-height: 1.4;
}

.conversation-scroll {
  height: calc(100vh - 500rpx - env(safe-area-inset-bottom));
  min-height: 440rpx;
  margin-top: 24rpx;
  box-sizing: border-box;
}

.control-panel.compact + .conversation-scroll {
  height: calc(100vh - 330rpx - env(safe-area-inset-bottom));
  min-height: 620rpx;
  margin-top: 18rpx;
}

.partial-box {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 18rpx;
  background: #f8f4ef;
}

.active-partial {
  margin-top: 0;
  border: 2rpx solid #d7a28c;
  background: #fffdf9;
}

.partial-label {
  display: block;
  color: #a64b3e;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.25;
}

.partial-scroll {
  height: 420rpx;
  margin-top: 12rpx;
  overflow: hidden;
}

.partial-text,
.line-text {
  display: block;
  color: #2b1713;
  word-break: break-word;
  text-wrap: pretty;
}

.partial-text,
.line-text.latest {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.55;
}

.line-text.history {
  color: #3c2b25;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.55;
}

.partial-text {
  padding-bottom: 8rpx;
}

.line-item {
  position: relative;
  margin-top: 24rpx;
  padding: 30rpx 30rpx 30rpx 34rpx;
  border-radius: 22rpx;
  background: #fffdf9;
  box-shadow: 0 8rpx 22rpx rgba(64, 43, 24, 0.06);
  box-sizing: border-box;
}

.line-item::before {
  content: "";
  position: absolute;
  top: 30rpx;
  bottom: 30rpx;
  left: 18rpx;
  width: 4rpx;
  border-radius: 999rpx;
  background: #e7d8c9;
  opacity: 0.72;
}

.line-item.latest::before {
  content: "";
  position: absolute;
  top: 30rpx;
  bottom: 30rpx;
  left: 18rpx;
  width: 6rpx;
  border-radius: 999rpx;
  background: #d7a28c;
  opacity: 1;
}

.line-meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.speaker-badge {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #f4f1ec;
  color: #62554d;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 44rpx;
}

.speaker-badge.tone-0 {
  background: #ddf0ed;
  color: #115e59;
}

.speaker-badge.tone-1 {
  background: #ddebf8;
  color: #28557d;
}

.speaker-badge.tone-2 {
  background: #ece5f7;
  color: #5e458e;
}

.speaker-badge.tone-3 {
  background: #f8e1e7;
  color: #84364b;
}

.speaker-badge.tone-4 {
  background: #f3e8c8;
  color: #6b5118;
}

.speaker-badge.tone-5 {
  background: #e3f0d9;
  color: #3b6128;
}

.speaker-badge.tone-6 {
  background: #f6e1d2;
  color: #87441f;
}

.speaker-badge.tone-7 {
  background: #e2e9f8;
  color: #38558d;
}

.partial-box.tone-0,
.line-item.tone-0 {
  background: #f0f8f6;
}

.partial-box.tone-1,
.line-item.tone-1 {
  background: #f1f7fc;
}

.partial-box.tone-2,
.line-item.tone-2 {
  background: #f7f3fc;
}

.partial-box.tone-3,
.line-item.tone-3 {
  background: #fff4f6;
}

.partial-box.tone-4,
.line-item.tone-4 {
  background: #fbf7e9;
}

.partial-box.tone-5,
.line-item.tone-5 {
  background: #f3f9ef;
}

.partial-box.tone-6,
.line-item.tone-6 {
  background: #fff4ec;
}

.partial-box.tone-7,
.line-item.tone-7 {
  background: #f3f6fd;
}

.active-partial.tone-0 {
  border-color: #147d73;
}

.active-partial.tone-1 {
  border-color: #2f6ea5;
}

.active-partial.tone-2 {
  border-color: #7a5bb7;
}

.active-partial.tone-3 {
  border-color: #a84b62;
}

.active-partial.tone-4 {
  border-color: #8a6a22;
}

.active-partial.tone-5 {
  border-color: #4f7b38;
}

.active-partial.tone-6 {
  border-color: #b15e2d;
}

.active-partial.tone-7 {
  border-color: #4b6fb6;
}

.line-item.tone-0::before {
  background: #147d73;
}

.line-item.tone-1::before {
  background: #2f6ea5;
}

.line-item.tone-2::before {
  background: #7a5bb7;
}

.line-item.tone-3::before {
  background: #a84b62;
}

.line-item.tone-4::before {
  background: #8a6a22;
}

.line-item.tone-5::before {
  background: #4f7b38;
}

.line-item.tone-6::before {
  background: #b15e2d;
}

.line-item.tone-7::before {
  background: #4b6fb6;
}

.line-meta {
  display: inline-flex;
  color: #7b6f68;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.25;
  font-variant-numeric: tabular-nums;
}

.line-status {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #f4f1ec;
  color: #a64b3e;
  font-size: 26rpx;
  font-weight: 850;
  line-height: 1.25;
}

.line-status.loading {
  color: #7b6f68;
}

.speaker-transcription-page.large-text {
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.speaker-transcription-page.large-text .page-title {
  font-size: 52rpx;
}

.speaker-transcription-page.large-text .page-meta,
.speaker-transcription-page.large-text .control-meta,
.speaker-transcription-page.large-text .line-meta,
.speaker-transcription-page.large-text .line-status {
  font-size: 34rpx;
  line-height: 1.35;
}

.speaker-transcription-page.large-text .control-panel,
.speaker-transcription-page.large-text .empty-panel,
.speaker-transcription-page.large-text .line-item {
  border-radius: 30rpx;
}

.speaker-transcription-page.large-text .control-panel {
  padding: 38rpx;
}

.speaker-transcription-page.large-text .control-title,
.speaker-transcription-page.large-text .empty-title {
  font-size: 44rpx;
  line-height: 1.25;
}

.speaker-transcription-page.large-text .status-pill {
  font-size: 38rpx;
}

.speaker-transcription-page.large-text .primary-button,
.speaker-transcription-page.large-text .secondary-button {
  height: 116rpx;
  font-size: 40rpx;
}

.speaker-transcription-page.large-text .secondary-button {
  width: 212rpx;
  flex-basis: 212rpx;
}

.speaker-transcription-page.large-text .empty-copy {
  font-size: 36rpx;
  line-height: 1.45;
}

.speaker-transcription-page.large-text .conversation-scroll {
  height: calc(100vh - 540rpx - env(safe-area-inset-bottom));
  min-height: 420rpx;
}

.speaker-transcription-page.large-text .speaker-badge {
  min-height: 52rpx;
  padding: 0 18rpx;
  font-size: 34rpx;
  line-height: 52rpx;
}

.speaker-transcription-page.large-text .partial-label {
  font-size: 34rpx;
}

.speaker-transcription-page.large-text .partial-scroll {
  height: 420rpx;
}

.speaker-transcription-page.large-text .control-panel.compact {
  padding: 24rpx;
}

.speaker-transcription-page.large-text .control-panel.compact .primary-button,
.speaker-transcription-page.large-text .control-panel.compact .secondary-button {
  height: 92rpx;
  font-size: 36rpx;
}

.speaker-transcription-page.large-text .control-panel.compact + .conversation-scroll {
  height: calc(100vh - 360rpx - env(safe-area-inset-bottom));
  min-height: 600rpx;
  margin-top: 18rpx;
}

.speaker-transcription-page.large-text .partial-text,
.speaker-transcription-page.large-text .line-text.latest {
  font-size: 76rpx;
  line-height: 96rpx;
}

.speaker-transcription-page.large-text .line-text.history {
  font-size: 46rpx;
  line-height: 72rpx;
}

.speaker-transcription-page.large-text .line-item {
  padding-left: 42rpx;
}

.speaker-transcription-page.large-text .line-item::before {
  top: 34rpx;
  bottom: 34rpx;
  left: 22rpx;
  width: 5rpx;
}

.speaker-transcription-page.large-text .line-item.latest::before {
  top: 34rpx;
  bottom: 34rpx;
  left: 22rpx;
  width: 8rpx;
}

.bottom-spacer {
  height: 36rpx;
}
