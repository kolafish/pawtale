.voice-start-page {
  min-height: 100vh;
  padding: 32rpx 36rpx 72rpx;
  background: #fffaf2;
}

.top-bar {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.back-hit {
  position: absolute;
  left: -12rpx;
  top: 10rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-mark {
  color: #9f4a3c;
  font-size: 70rpx;
  line-height: 1;
}

.page-title {
  color: #24100b;
  font-size: 42rpx;
  font-weight: 800;
}

.intro-panel,
.project-panel {
  border: 2rpx solid #f0dac0;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 10rpx 28rpx rgba(64, 43, 24, 0.06);
}

.intro-panel {
  margin-top: 34rpx;
  padding: 34rpx 30rpx;
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.intro-icon {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
}

.intro-copy {
  flex: 1;
  min-width: 0;
}

.intro-title {
  display: block;
  color: #24100b;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.25;
}

.intro-subtitle {
  display: block;
  margin-top: 14rpx;
  color: #685b55;
  font-size: 28rpx;
  line-height: 1.45;
}

.project-panel {
  margin-top: 30rpx;
  padding: 30rpx;
}

.project-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.mode-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff1ec;
  color: #9f4a3c;
  font-size: 24rpx;
  font-weight: 800;
}

.project-label {
  color: #685b55;
  font-size: 28rpx;
  font-weight: 700;
}

.project-title {
  display: block;
  margin-top: 18rpx;
  color: #24100b;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.35;
}

.start-button {
  height: 108rpx;
  margin-top: 44rpx;
  border: 0;
  border-radius: 28rpx;
  background: #9f4a3c;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
}

.start-button::after {
  border: 0;
}

.start-button[disabled] {
  opacity: 0.72;
}

.error {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #fff1f2;
  color: #be123c;
  font-size: 26rpx;
  line-height: 1.5;
}
