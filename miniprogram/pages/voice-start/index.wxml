<view class="voice-start-page">
  <view class="top-bar">
    <view class="back-hit" bindtap="backHome">
      <text class="back-mark">‹</text>
    </view>
    <text class="page-title">开始语音访谈</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="intro-panel">
    <image class="intro-icon" src="/assets/memoir-microphone.png" mode="aspectFit" />
    <view class="intro-copy">
      <text class="intro-title">开始语音聊天</text>
      <text class="intro-subtitle">边说边显示大字转写，AI 会按当前回忆录的讲述方式接话。</text>
    </view>
  </view>

  <view class="project-panel">
    <view class="project-row">
      <text class="project-label">当前回忆录</text>
      <text class="mode-tag">{{guidanceLabel}}</text>
    </view>
    <text class="project-title">{{projectTitle}}</text>
  </view>

  <button class="start-button" loading="{{loading}}" disabled="{{loading}}" bindtap="startVoiceChat">
    {{loading ? "正在准备" : "进入语音聊天"}}
  </button>
</view>
