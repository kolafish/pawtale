<view class="review-page">
  <view class="stack">
    <text class="eyebrow">记忆沉淀</text>
    <text class="title">本次访谈整理</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="surface stack">
    <text class="section-title">访谈回答</text>
    <text wx:if="{{questionPrompt}}" class="muted">{{questionPrompt}}</text>
    <text class="body-text">{{transcript || "暂无回答文本"}}</text>
  </view>

  <view class="surface stack">
    <view class="section-row">
      <text class="section-title">本次摘要</text>
      <text wx:if="{{processing || refreshing}}" class="muted">处理中...</text>
    </view>
    <text class="body-text">{{summaryText || "正在提取结构化记忆"}}</text>
  </view>

  <view class="surface stack">
    <view class="section-row">
      <text class="section-title">写作片段</text>
      <text class="count-text">{{outputs.length}}</text>
    </view>
    <view wx:if="{{!outputs.length}}" class="empty-state">暂无写作片段</view>
    <view wx:for="{{outputs}}" wx:key="id" class="output-card">
      <text class="memory-title">{{item.title}}</text>
      <text class="body-text">{{item.content_preview || "暂无片段预览"}}</text>
      <text class="muted">{{item.output_type === "story_fragment" ? "故事片段" : item.output_type}}</text>
    </view>
  </view>

  <view class="surface stack">
    <view class="section-row">
      <text class="section-title">覆盖度地图</text>
      <text class="count-text">{{coverage.length}}</text>
    </view>
    <view wx:if="{{!coverage.length}}" class="empty-state">暂无覆盖度数据</view>
    <view wx:for="{{coverage}}" wx:key="topic_id" class="coverage-row">
      <view class="coverage-copy">
        <text class="coverage-name">{{item.name}}</text>
        <text class="muted">{{item.life_stage || "人生主题"}}</text>
      </view>
      <view class="coverage-meter">
        <view class="coverage-track">
          <view class="coverage-fill {{item.status}}" style="width: {{item.coverage_score}}%;"></view>
        </view>
        <text class="coverage-score">{{item.coverage_score}}%</text>
      </view>
    </view>
  </view>

  <view class="surface stack">
    <view class="section-row">
      <text class="section-title">记忆卡片</text>
      <text class="count-text">{{memoryCards.length}}</text>
    </view>
    <view wx:if="{{!memoryCards.length}}" class="empty-state">暂无结构化记忆</view>
    <view wx:for="{{memoryCards}}" wx:key="id" class="memory-card memory-card-vertical">
      <view class="memory-head">
        <text class="type-pill">{{item.typeLabel}}</text>
        <text class="status-pill {{item.status}}">{{item.status === "confirmed" ? "已确认" : item.status === "rejected" ? "已拒绝" : "待确认"}}</text>
      </view>
      <view class="memory-main">
        <text class="memory-title">{{item.title}}</text>
        <text class="muted">{{item.detail}}</text>
        <text class="muted">置信度 {{item.confidenceText}}</text>
        <text wx:if="{{item.evidence}}" class="evidence-text">证据：{{item.evidence}}</text>
      </view>
      <view class="memory-actions">
        <button class="mini-button confirm" disabled="{{item.status === 'confirmed'}}" data-id="{{item.id}}" data-type="{{item.type}}" bindtap="confirmMemory">确认</button>
        <button class="mini-button reject" disabled="{{item.status === 'rejected'}}" data-id="{{item.id}}" data-type="{{item.type}}" bindtap="rejectMemory">拒绝</button>
      </view>
    </view>
  </view>

  <view class="surface stack">
    <view class="section-row">
      <text class="section-title">待确认问题</text>
      <text class="count-text">{{openQuestions.length}}</text>
    </view>
    <view wx:if="{{!openQuestions.length}}" class="empty-state">暂无待确认问题</view>
    <view wx:for="{{openQuestions}}" wx:key="id" class="question-card">
      <text class="body-text">{{item.question}}</text>
      <text class="muted">{{item.reason || item.question_type}}</text>
      <view class="button-row compact">
        <button class="mini-button confirm" data-id="{{item.id}}" bindtap="askOpenQuestion">作为下一问</button>
        <button class="mini-button confirm" data-id="{{item.id}}" bindtap="markOpenQuestionAnswered">已解决</button>
        <button class="mini-button reject" data-id="{{item.id}}" bindtap="dismissOpenQuestion">暂时跳过</button>
      </view>
    </view>
  </view>

  <view class="surface stack">
    <view class="section-row">
      <text class="section-title">推荐下一问</text>
      <text class="count-text">{{candidates.length}}</text>
    </view>
    <view wx:if="{{!candidates.length}}" class="empty-state">暂无推荐问题</view>
    <view wx:for="{{candidates}}" wx:key="id" class="candidate-card" data-id="{{item.id}}" bindtap="askCandidate" hover-class="tap-hover">
      <text class="body-text">{{item.question}}</text>
      <text class="muted">{{item.reason}}</text>
      <text class="candidate-action">作为下一问</text>
    </view>
  </view>

  <view class="button-row">
    <button class="button button-secondary" bindtap="openStories">写作片段</button>
    <button class="button button-primary" loading="{{processing || selecting}}" bindtap="continueInterview">继续讲述</button>
  </view>
</view>
