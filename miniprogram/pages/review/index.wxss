.review-page {
  min-height: 100vh;
  padding: 32rpx 36rpx 56rpx;
  background: #fffaf2;
}

.surface {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 2rpx solid #f0dac0;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.9);
}

.section-row,
.coverage-row,
.memory-card,
.memory-actions,
.memory-head {
  display: flex;
  align-items: center;
}

.section-row,
.coverage-row,
.memory-card {
  justify-content: space-between;
  gap: 20rpx;
}

.memory-card-vertical {
  display: block;
}

.section-title {
  color: #24100b;
  font-size: 34rpx;
  font-weight: 800;
}

.count-text {
  color: #9f4a3c;
  font-size: 28rpx;
  font-weight: 700;
}

.empty-state {
  padding: 24rpx;
  border-radius: 18rpx;
  background: #fff6f1;
  color: #5f6d69;
  font-size: 28rpx;
}

.coverage-row,
.memory-card,
.question-card,
.candidate-card,
.output-card {
  padding: 24rpx 0;
  border-top: 2rpx solid #f5eadc;
}

.memory-head {
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.coverage-copy,
.memory-main {
  min-width: 0;
  flex: 1;
}

.coverage-name,
.memory-title {
  display: block;
  color: #24100b;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
}

.coverage-meter {
  width: 220rpx;
  flex-shrink: 0;
}

.coverage-track {
  height: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #f6d7ca;
}

.coverage-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #e35d4f;
}

.coverage-fill.yellow {
  background: #ef9b35;
}

.coverage-fill.green {
  background: #9f4a3c;
}

.coverage-score {
  display: block;
  margin-top: 8rpx;
  color: #9f4a3c;
  font-size: 24rpx;
  font-weight: 700;
  text-align: right;
}

.status-pill {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #8a5b12;
  background: #fff0c2;
  font-size: 22rpx;
  font-weight: 700;
}

.type-pill {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #9f4a3c;
  background: #fff1ec;
  font-size: 22rpx;
  font-weight: 700;
}

.status-pill.confirmed {
  color: #8f3f35;
  background: #fde5dc;
}

.status-pill.rejected {
  color: #b83c35;
  background: #ffe4df;
}

.memory-actions {
  margin-top: 18rpx;
  gap: 10rpx;
}

.evidence-text {
  display: block;
  margin-top: 12rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #fff8ee;
  color: #6f574f;
  font-size: 26rpx;
  line-height: 1.5;
}

.mini-button {
  min-width: 88rpx;
  height: 52rpx;
  margin: 0;
  padding: 0 14rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 52rpx;
}

.mini-button.confirm {
  color: #8f3f35;
  background: #fff1ec;
}

.mini-button.reject {
  color: #9c4033;
  background: #fff0eb;
}

.question-card .muted,
.candidate-card .muted {
  display: block;
  margin-top: 10rpx;
}

.candidate-action {
  display: block;
  margin-top: 12rpx;
  color: #9f4a3c;
  font-size: 26rpx;
  font-weight: 700;
}

.compact {
  margin-top: 16rpx;
  justify-content: flex-start;
}

.button-row {
  margin-top: 28rpx;
}

.button-row .button {
  flex: 1;
}
