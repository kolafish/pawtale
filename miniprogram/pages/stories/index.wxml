<view class="stories-page">
  <view class="top-bar">
    <view class="back-hit" bindtap="backWorkbench">
      <text class="back-mark">‹</text>
    </view>
    <text class="page-title">写作片段</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="summary-panel">
    <view class="summary-row">
      <view class="summary-item {{activeFilter === 'all' ? 'selected' : ''}}" bindtap="selectAll" hover-class="tap-hover">
        <text class="summary-value">{{hasDashboardData ? outputCount : "..."}}</text>
        <text class="summary-label">全部片段</text>
      </view>
      <view class="summary-item warm {{activeFilter === 'story_fragment' ? 'selected' : ''}}" bindtap="selectFragments" hover-class="tap-hover">
        <text class="summary-value warm-text">{{hasDashboardData ? storyFragmentCount : "..."}}</text>
        <text class="summary-label">故事片段</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">{{hasDashboardData ? pendingReviewCount : "..."}}</text>
        <text class="summary-label">待确认</text>
      </view>
    </view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{hasDashboardData ? progressPercent : 0}}%;"></view>
    </view>
    <view wx:if="{{hasDashboardData}}" class="progress-value">覆盖度 {{progressPercent}}%</view>
    <view wx:else class="progress-value">加载中</view>
  </view>

  <view class="story-list">
    <view class="story-list-header">
      <text>{{activeFilter === "story_fragment" ? "故事片段" : "全部片段"}}</text>
      <text class="story-count">{{hasOutputData ? visibleOutputs.length : "..."}}</text>
    </view>
    <view wx:if="{{!hasOutputData && loading || !hasOutputData && refreshing}}" class="empty-state">
      <text>正在加载写作片段</text>
    </view>
    <view wx:elif="{{hasOutputData && !visibleOutputs.length}}" class="empty-state">
      <text>{{activeFilter === "story_fragment" ? "还没有故事片段。" : "还没有写作片段。先回答一个问题，系统会根据结构化记忆整理到这里。"}}</text>
      <view wx:if="{{activeFilter === 'all'}}" class="primary-action small-action" bindtap="continueInterview">
        <image class="action-art-icon" src="/assets/memoir-microphone.png" mode="aspectFit" />
        <text class="primary-action-text">开始讲述</text>
      </view>
    </view>
    <view wx:for="{{visibleOutputs}}" wx:key="id" class="story-card">
      <text class="story-question">{{item.title}}</text>
      <text class="story-preview">{{item.content_preview || "暂无片段预览"}}</text>
      <view class="tts-actions">
        <button
          class="tts-button {{ttsSourceKey === item.ttsSourceKey && ttsPlaying ? 'active' : ''}}"
          disabled="{{ttsBusy}}"
          data-source-type="output"
          data-source-id="{{item.id}}"
          data-label="写作片段"
          bindtap="toggleTtsSource"
        >
          {{ttsSourceKey === item.ttsSourceKey && ttsPlaying ? "暂停朗读" : "朗读片段"}}
        </button>
        <button class="tts-speed-button" bindtap="cycleTtsSpeed">{{ttsSpeedLabel}}</button>
      </view>
      <text
        wx:if="{{ttsSourceKey === item.ttsSourceKey && (ttsMessage || ttsError)}}"
        class="tts-status {{ttsError ? 'tts-error' : ''}}"
      >
        {{ttsError || ttsMessage}}
      </text>
      <view class="story-meta">
        <text>{{item.output_type === "story_fragment" ? "故事片段" : item.output_type}}</text>
        <text wx:if="{{item.version_count}}" class="story-action">第 {{item.latest_version}} 版</text>
        <text wx:else class="story-action">草稿</text>
      </view>
    </view>
  </view>

  <view class="bottom-nav">
    <view class="bottom-nav-item" bindtap="openHome">
      <view class="nav-mark home-mark"></view>
      <text>首页</text>
    </view>
    <view class="bottom-nav-item active" bindtap="openWorkbench">
      <view class="nav-mark grid-mark"></view>
      <text>工作台</text>
    </view>
    <view class="bottom-nav-item" bindtap="openQa">
      <view class="nav-mark chat-mark"></view>
      <text>问答</text>
    </view>
    <view class="bottom-nav-item" bindtap="openProfile">
      <view class="nav-mark user-mark"></view>
      <text>我的</text>
    </view>
  </view>
</view>
