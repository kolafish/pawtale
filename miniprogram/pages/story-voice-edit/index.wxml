<page-meta page-style="--ui-navigation-height: {{navigationHeight || 0}}px;" />
<brand-navigation title="{{navigationTitle || '语音编辑'}}" page-class="{{pageClass || homePageClass}}" bindlayout="onNavigationLayout" />
<view class="ui-page-shell {{pageClass}}">
  <view class="edit-intro">
    <text class="edit-book">{{projectTitle || '当前回忆录'}}</text>
    <text class="edit-title">{{splitConfirmation ? '确认这次调整' : '说说你想怎么改'}}</text>
    <text class="edit-hint">{{splitConfirmation ? '核对内容和新章节名后确认。' : '直接说出修改要求，停顿后自动理解；确认后生效。'}}</text>
  </view>
  <view hidden="{{splitConfirmation !== null}}">
    <voice-text-editor value="{{instruction}}" gateway-url="{{gatewayUrl}}" maxlength="2000"
      placeholder="例如：把于大姐改成余大姐。"
      submit-text="发送" busy-text="正在理解…" busy="{{loading}}" disabled="{{applying || !projectId || splitConfirmation !== null}}"
      automatic-voice-command="{{true}}"
      bind:change="changeInstruction" bind:submit="submitInstruction" />
  </view>
  <view wx:if="{{error}}" class="ui-error-banner" aria-live="polite">{{error}}</view>
  <view wx:if="{{splitConfirmation}}" class="edit-result edit-split-confirmation ui-card" aria-live="polite">
    <text class="edit-split-summary">{{splitConfirmation.label}}</text>
    <text wx:if="{{splitConfirmation.detail}}" class="edit-detail">{{splitConfirmation.detail}}</text>
    <view class="edit-split-title-block">
      <text class="edit-split-caption">建议的新章节名</text>
      <text class="edit-split-title">{{splitConfirmation.new_title}}</text>
    </view>
    <button class="edit-apply ui-button ui-block-action" bindtap="apply" disabled="{{applying}}" loading="{{applying}}">确认移到新章节</button>
    <button class="edit-restart ui-button" bindtap="restartInstruction" disabled="{{applying}}">修改要求</button>
  </view>
  <view wx:elif="{{preview}}" class="edit-result ui-card" aria-live="polite">
    <text class="edit-reply">{{preview.reply}}</text>
    <view wx:for="{{preview.questions}}" wx:key="*this" class="edit-question">{{item}}</view>
    <text wx:if="{{preview.questions.length}}" class="edit-hint">请补充回答，之前的要求会保留。</text>
    <checkbox-group bindchange="selectOperations">
      <label wx:for="{{items}}" wx:key="selectionKey" class="edit-operation">
        <checkbox value="{{item.selectionKey}}" checked="{{item.selected}}" disabled="{{applying}}" color="#b65d49" />
        <view class="edit-operation-copy">
          <text class="edit-operation-title">{{item.label}}</text>
          <text wx:if="{{item.detail}}" class="edit-detail">{{item.detail}}</text>
        </view>
      </label>
    </checkbox-group>
    <button wx:if="{{items.length}}" class="edit-apply ui-button ui-block-action" bindtap="apply" disabled="{{!selectedCount || applying}}" loading="{{applying}}">确认修改（{{selectedCount}}）</button>
    <button wx:if="{{!items.length && preview.navigation}}" class="edit-apply ui-button ui-block-action" bindtap="openNavigation">{{preview.navigation.label}}</button>
  </view>
  <view wx:if="{{message}}" class="edit-result edit-message {{sectionTasks.length ? 'has-section-tasks' : ''}} ui-card" aria-live="polite">
    <text>{{message}}</text>
    <button wx:if="{{undoable}}" class="edit-restart ui-button" bindtap="undo" disabled="{{undoing}}" loading="{{undoing}}">撤销这次修改</button>
  </view>
  <view wx:if="{{sectionTasks.length}}" class="edit-task-list" aria-live="polite">
    <view wx:for="{{sectionTasks}}" wx:key="chapterId" class="edit-task ui-card">
      <text class="edit-task-label">{{item.label}}</text>
      <text class="edit-task-status {{item.status === 'succeeded' ? 'is-succeeded' : (item.status === 'failed' || item.status === 'cancelled' ? 'is-failed' : '')}}">{{item.status === 'succeeded' ? '已完成' : item.status === 'failed' ? '未完成' : item.status === 'cancelled' ? '已取消' : item.status === 'idle' ? '状态未知' : item.status === 'checking' ? '正在核对' : '进行中'}}</text>
      <text class="edit-task-detail">{{item.detail}}</text>
      <button class="edit-task-open ui-button" data-chapter-id="{{item.chapterId}}" bindtap="openChapterProgress">查看本章</button>
    </view>
  </view>
  <button class="edit-back ui-button" bindtap="backToStory">回到故事</button>
</view>
