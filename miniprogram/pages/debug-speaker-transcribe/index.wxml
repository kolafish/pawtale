<view class="{{pageClass}}">
  <view class="top-row">
    <view class="back-hit" bindtap="goBack">
      <text class="back-mark">‹</text>
    </view>
    <view class="title-block">
      <text class="page-title">多人实时转写</text>
      <text class="page-meta">本次识别不保存到素材库</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="{{controlPanelClass}}">
    <view class="control-head">
      <view>
        <text class="control-title">实时对话流</text>
        <text class="control-meta">最新内容在上方，不保存到素材库</text>
      </view>
      <text class="{{statusClass}}">{{statusText}}</text>
    </view>

    <view wx:if="{{showFullControls}}" class="level-track">
      <view class="level-fill" style="{{audioLevelStyle}}"></view>
    </view>

    <view wx:if="{{showFullControls}}" class="stats-grid">
      <view class="stat-cell">
        <text class="stat-value">{{elapsedText}}</text>
        <text class="stat-label">时长</text>
      </view>
      <view class="stat-cell">
        <text class="stat-value">{{frameCountText}}</text>
        <text class="stat-label">音频帧</text>
      </view>
      <view class="stat-cell">
        <text class="stat-value">{{audioBytesText}}</text>
        <text class="stat-label">已发送</text>
      </view>
    </view>

    <view class="actions-row">
      <button
        class="{{primaryButtonClass}}"
        loading="{{busy}}"
        disabled="{{busy}}"
        bindtap="toggleRecording"
      >
        {{primaryButtonText}}
      </button>
      <button
        class="secondary-button"
        disabled="{{clearDisabled}}"
        bindtap="clearTranscript"
      >
        清空
      </button>
    </view>

    <view wx:if="{{showFullControls && showDiarizationNotice}}" class="{{diarizationNoticeClass}}">
      <text>{{diarizationNotice}}</text>
    </view>
  </view>

  <view wx:if="{{showEmpty}}" class="empty-panel">
    <text class="empty-title">等待实时转写</text>
    <text class="empty-copy">开始后，最新识别会固定显示在最上方。</text>
  </view>

  <scroll-view
    wx:if="{{!showEmpty}}"
    class="conversation-scroll"
    scroll-y="{{true}}"
    scroll-into-view="{{conversationScrollTarget}}"
    scroll-with-animation="{{false}}"
  >
    <view wx:if="{{activePartial.visible}}" id="active-partial-card" class="partial-box active-partial">
      <view class="line-meta-row">
        <text class="{{activePartial.speakerBadgeClass}}">{{activePartial.speakerTitle}}</text>
        <text class="partial-label">正在说</text>
      </view>
      <scroll-view
        class="{{activePartial.partialScrollClass}}"
        scroll-y="{{true}}"
        scroll-top="{{activePartial.partialScrollTop}}"
      >
        <text class="partial-text">{{activePartial.text}}</text>
        <view id="{{activePartial.partialEndId}}" class="partial-end"></view>
      </scroll-view>
    </view>

    <view
      wx:for="{{conversationLines}}"
      wx:key="id"
      id="{{item.domId}}"
      class="{{item.lineClass}}"
      data-line-id="{{item.id}}"
      data-preview-enabled="{{item.previewEnabled}}"
      bindtouchstart="handleLineTouchStart"
      bindtouchmove="handleLineTouchMove"
      bindtouchend="handleLineTouchEnd"
      bindtouchcancel="handleLineTouchCancel"
    >
      <view class="line-meta-row">
        <text class="{{item.speakerBadgeClass}}">{{item.speakerTitle}}</text>
        <text wx:if="{{item.metaText}}" class="line-meta">{{item.metaText}}</text>
        <text wx:if="{{item.proofreadStatusText}}" class="line-status {{item.proofreadLoading ? 'loading' : ''}}">
          {{item.proofreadStatusText}}
        </text>
      </view>
      <text class="{{item.textClass}}">{{item.text}}</text>
    </view>
  </scroll-view>

  <view
    wx:if="{{historyLinePreview.visible}}"
    class="history-preview-layer"
    bindtap="hideHistoryLinePreview"
    bindtouchend="hideHistoryLinePreview"
    bindtouchcancel="hideHistoryLinePreview"
  >
    <view class="history-preview-panel">
      <view class="history-preview-meta-row">
        <text class="history-preview-speaker">{{historyLinePreview.speakerTitle}}</text>
        <text wx:if="{{historyLinePreview.metaText}}" class="history-preview-meta">
          {{historyLinePreview.metaText}}
        </text>
        <text wx:if="{{historyLinePreview.statusText}}" class="history-preview-status">
          {{historyLinePreview.statusText}}
        </text>
      </view>
      <scroll-view class="history-preview-scroll" scroll-y="{{true}}">
        <text class="history-preview-text">{{historyLinePreview.text}}</text>
      </scroll-view>
    </view>
  </view>

  <view class="bottom-spacer"></view>
</view>
