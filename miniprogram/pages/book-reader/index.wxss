@import "../../templates/share-likes.wxss";
.book-reader-page {
  padding: 26rpx 28rpx calc(76rpx + env(safe-area-inset-bottom));
  color: var(--ui-text-primary);
}

.reader-cover {
  position: relative;
  overflow: hidden;
  padding: 46rpx 36rpx 40rpx;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 84% 82%, rgba(243, 226, 216, 0.44), rgba(243, 226, 216, 0) 42%),
    linear-gradient(145deg, rgba(255, 253, 250, 0.99), rgba(251, 247, 241, 0.96));
}

.reader-cover-art {
  position: absolute;
  z-index: 0;
  top: -26rpx;
  right: -34rpx;
  width: 330rpx;
  height: 390rpx;
  opacity: 0.34;
  pointer-events: none;
}

.reader-cover-copy {
  position: relative;
  z-index: 1;
}

.reader-eyebrow,
.reader-title,
.reader-subtitle,
.reader-meta,
.reader-notice,
.section-label,
.toc-index,
.toc-title,
.toc-story-count,
.toc-section-index,
.toc-section-title,
.chapter-index,
.chapter-title,
.chapter-content,
.small-section-title,
.small-section-content,
.book-content,
.reader-state {
  display: block;
}

.reader-eyebrow {
  color: var(--ui-section-title);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  letter-spacing: 0.06em;
  line-height: 1.4;
}

.reader-title {
  max-width: 540rpx;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.25;
  word-break: break-word;
  text-wrap: balance;
}

.reader-eyebrow + .reader-title {
  margin-top: 12rpx;
}

.reader-subtitle {
  max-width: 520rpx;
  margin-top: 14rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: 1.6;
  word-break: break-word;
  text-wrap: pretty;
}

.reader-meta {
  margin-top: 26rpx;
  color: var(--ui-text-muted);
  font-size: var(--ui-font-meta);
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}

.reader-notice {
  max-width: 540rpx;
  margin-top: 18rpx;
  padding: 15rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(250, 237, 231, 0.88);
  color: var(--ui-accent-strong);
  box-shadow: inset 0 0 0 1rpx rgba(182, 93, 73, 0.08);
  font-size: var(--ui-font-body);
  line-height: 1.55;
  text-wrap: pretty;
}

.reader-notice-dot {
  margin-right: 12rpx;
  color: var(--ui-accent);
}

.reader-notice.subtle {
  background: rgba(250, 247, 242, 0.92);
  color: var(--ui-text-secondary);
  box-shadow: inset 0 0 0 1rpx rgba(54, 42, 34, 0.05);
}

.reader-audio-action {
  width: auto;
  min-width: 224rpx;
  min-height: 44px;
  margin-top: 26rpx;
  padding: 10rpx 24rpx 10rpx 20rpx;
  display: inline-flex;
  gap: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 250, 0.92);
  color: var(--ui-accent-strong);
  box-shadow:
    inset 0 0 0 2rpx var(--ui-accent-border),
    0 4rpx 12rpx rgba(63, 47, 37, 0.025);
  font-size: var(--ui-font-action);
  font-weight: 700;
  line-height: 1.4;
}

.reader-audio-icon {
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
}

.reader-playback-error {
  display: block;
  margin-top: 16rpx;
  color: var(--ui-danger-text);
  font-size: var(--ui-font-body);
  line-height: 1.5;
  text-wrap: pretty;
}

.reader-tts-shell {
  position: sticky;
  top: 16rpx;
  z-index: 4;
  margin-top: 24rpx;
}

.reader-state {
  padding: 34rpx 30rpx;
  color: var(--ui-text-secondary);
  font-size: 30rpx;
  line-height: 1.55;
}

.reader-state.error {
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
  box-shadow: inset 0 0 0 1rpx rgba(168, 73, 63, 0.12);
}

.reader-section {
  margin-top: 22rpx;
  padding: 32rpx 30rpx 22rpx;
}

.section-label {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  line-height: 1.4;
  text-wrap: balance;
}

.toc-list {
  margin-top: 18rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.toc-group {
  min-width: 0;
  border-bottom: 1rpx solid var(--ui-divider);
}

.toc-row {
  width: 100%;
  min-height: 52px;
  margin: 0;
  padding: 16rpx 2rpx;
  display: grid;
  grid-template-columns: 58rpx minmax(0, 1fr) 40rpx;
  align-items: center;
  gap: 14rpx;
  border: 0;
  background: transparent;
  text-align: left;
}

.toc-index {
  align-self: start;
  padding-top: 4rpx;
  color: var(--ui-section-title);
  font-size: var(--ui-font-meta);
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}

.toc-heading {
  min-width: 0;
}

.toc-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-section-title);
  font-weight: 700;
  line-height: 1.48;
  word-break: break-word;
  text-wrap: balance;
}

.toc-story-count {
  margin-top: 3rpx;
  color: var(--ui-text-muted);
  font-size: var(--ui-font-caption);
  line-height: 1.45;
}

.toc-chevron {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-accent-strong);
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
  transform: rotate(0deg);
  transition-property: transform;
  transition-duration: 180ms;
  transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
}

.toc-chevron.is-expanded {
  transform: rotate(90deg);
}

.toc-section-list {
  margin: 0 0 18rpx 58rpx;
  padding: 4rpx 0 4rpx 20rpx;
  border-left: 2rpx solid var(--ui-divider);
}

.toc-section-row {
  min-height: 44px;
  display: grid;
  grid-template-columns: 68rpx minmax(0, 1fr);
  align-items: center;
  gap: 12rpx;
  padding: 9rpx 6rpx;
  border-radius: 12rpx;
}

.toc-section-index,
.toc-section-title {
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  line-height: 1.55;
}

.toc-chapter-action .toc-section-title {
  grid-column: 2;
}

.toc-section-index {
  font-variant-numeric: tabular-nums;
}

.toc-section-title {
  word-break: break-word;
  text-wrap: pretty;
}

.chapter-list {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.chapter-block.ui-card {
  padding: 48rpx 34rpx 52rpx;
  border-radius: 20rpx;
  box-shadow:
    0 0 0 1rpx rgba(54, 42, 34, 0.025),
    0 8rpx 28rpx rgba(63, 47, 37, 0.032);
}

.chapter-preview-block.ui-card {
  padding-top: 42rpx;
}

.chapter-index {
  color: var(--ui-section-title);
  font-size: var(--ui-font-meta);
  line-height: 1.4;
  letter-spacing: 0.08em;
  font-variant-numeric: tabular-nums;
}

.chapter-title {
  margin-top: 10rpx;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.42;
  word-break: break-word;
  text-wrap: balance;
}

.reader-small-section-list {
  margin-top: 38rpx;
}

.chapter-preview-block .reader-small-section-list {
  margin-top: 0;
}

.reader-small-section {
  min-width: 0;
  scroll-margin-top: 24rpx;
}

.reader-small-section + .reader-small-section {
  margin-top: 52rpx;
}

.small-section-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.5;
  word-break: break-word;
  text-wrap: balance;
}

.small-section-paragraph-list {
  margin-top: 24rpx;
}

.reader-small-section:first-child .small-section-paragraph-list:first-child {
  margin-top: 0;
}

.small-section-content,
.chapter-content,
.book-content {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 34rpx;
  font-weight: 400;
  line-height: 2;
  word-break: break-word;
}

.small-section-paragraph-list .small-section-content {
  margin: 0;
  text-indent: 2em;
}

.small-section-paragraph-list .small-section-content ~ .small-section-content {
  margin-top: 24rpx;
}

.reader-sentence-highlight {
  border-radius: 4rpx;
  background: var(--ui-warning-surface);
  color: var(--ui-text-primary);
}

.chapter-content,
.book-content {
  margin-top: 26rpx;
  white-space: pre-wrap;
}

.book-content {
  margin-top: 18rpx;
}

.reader-pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 24rpx;
}

.reader-page-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 0 20rpx;
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-action);
}

.reader-page-action[aria-disabled="true"] {
  opacity: 0.35;
}

.reader-page-count {
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  font-variant-numeric: tabular-nums;
}

.reader-top-action-shell {
  padding-top: 22rpx;
  text-align: center;
}

.reader-top-action {
  min-height: 44px;
  padding: 0 24rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-action);
  font-weight: 700;
  line-height: 1.4;
}

.book-reader-page.large-text .toc-title,
.book-reader-page.large-text .small-section-title {
  font-size: 38rpx;
}

.book-reader-page.large-text .toc-story-count,
.book-reader-page.large-text .toc-section-index,
.book-reader-page.large-text .toc-section-title {
  font-size: var(--ui-font-large-meta);
}

.book-reader-page.large-text .small-section-content,
.book-reader-page.large-text .chapter-content,
.book-reader-page.large-text .book-content {
  font-size: 38rpx;
  line-height: 2;
}

.share-preview-notice { display: block; padding: 16rpx 0; color: var(--ui-text-secondary); text-align: center; }
.share-reading-image { clear: both; text-indent: 0; }
.share-cover-image, .share-reading-image image { width: 100%; border-radius: 28rpx; }
.share-reading-image text { display: block; color: var(--ui-text-secondary); font-size: var(--ui-font-meta); line-height: 1.5; margin: 12rpx 0; }
.small-section-content, .chapter-content, .book-content { font-size: 32rpx; line-height: 1.8; }
.large-text .small-section-content, .large-text .chapter-content, .large-text .book-content { font-size: 36rpx; }
/* Selected stories share the card's warm paper and editorial typography. */
.excerpt-page { box-sizing: border-box; background: #fcf8f1; min-height: 100vh; padding: 44rpx 40rpx calc(48rpx + env(safe-area-inset-bottom)); }
.excerpt-help { display: block; margin-top: 16rpx; color: var(--ui-text-secondary); font-size: var(--ui-font-meta); line-height: 1.7; }
.excerpt-select-help { margin: 0 0 24rpx; }
.excerpt-selector { box-sizing: border-box; width: 100%; height: 62vh; margin: 0; padding: 0; }
.excerpt-selection-error { display: block; margin-top: 20rpx; color: var(--ui-accent-strong); line-height: 1.6; }
.excerpt-actions { display: flex; gap: 16rpx; margin: 24rpx 0 0; }
.excerpt-actions button { flex: 1; margin: 0; min-height: 48px; }
.excerpt-card-image { display: block; width: 100%; margin-top: 28rpx; border-radius: 16rpx; box-shadow: 0 8rpx 32rpx rgba(97,75,57,.08); outline: 1px solid rgba(0,0,0,.06); }
.excerpt-paper { padding: 0 8rpx; }
.excerpt-eyebrow { display: block; color: #806b55; font-family: var(--ui-font-editorial); font-size: 26rpx; line-height: 1.6; }
.excerpt-title { display: block; margin: 24rpx 0 26rpx; color: #3f291b; font-family: var(--ui-font-editorial); font-size: 48rpx; font-weight: 700; line-height: 1.5; }
.excerpt-quote { color: #4c392a; font-family: var(--ui-font-editorial); font-size: 34rpx; line-height: 1.95; white-space: pre-wrap; overflow-wrap: break-word; }
.excerpt-highlight { background: #eaf0d3; border-radius: 6rpx; }
.excerpt-source { display: flex; align-items: center; gap: 20rpx; margin-top: 36rpx; padding: 28rpx 0; border-top: 1rpx solid #e3d8c7; }
.excerpt-source-icon { flex: none; width: 60rpx; height: 68rpx; opacity: .65; }
.excerpt-attribution { display: block; color: #614b39; font-family: var(--ui-font-editorial); font-size: 28rpx; line-height: 1.7; }
.excerpt-source-chapter { display: block; color: #806b55; font-size: 24rpx; line-height: 1.7; }
.excerpt-origin { display: flex; align-items: center; gap: 20rpx; margin: 0 0 32rpx; padding: 22rpx; border-radius: 24rpx; background: #f5eddf; }
.excerpt-origin image { flex: none; width: 64rpx; height: 64rpx; }
.excerpt-origin text { color: #6d5540; font-size: 26rpx; line-height: 1.8; }
.excerpt-share-button, .excerpt-start-button { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-height: 48px; padding: 20rpx 28rpx; border-radius: 100rpx; font-size: 30rpx; line-height: 1.5; transition: transform 120ms ease, opacity 120ms ease; }
.excerpt-share-button { margin: 0; background: #974c42; color: #fffaf3; }
.excerpt-share-button[disabled] { opacity: .45; }
.excerpt-start-button { margin-top: 20rpx; border: 1rpx solid #dfd0bc; background: transparent; color: #563c2a; font-size: 26rpx; }
.excerpt-share-button:active, .excerpt-start-button:active { transform: scale(.96); }
.excerpt-page .share-like-bar { background: transparent; border: 0; padding: 8rpx 0; }
.excerpt-page.large-text .excerpt-quote { font-size: 38rpx; }

/* Contain each section's float without constraining the paragraph text flow. */
.small-section-paragraph-list::after {
  content: "";
  display: block;
  clear: both;
}

.share-reading-image.portrait {
  float: right;
  clear: right;
  width: 38%;
  margin: 8rpx 0 20rpx 24rpx;
}

.share-reading-image.portrait image {
  border-radius: 16rpx;
}

.excerpt-config-heading { display: block; margin: 36rpx 0 18rpx; color: #614b39; font-size: 30rpx; font-weight: 600; }
.excerpt-title-input { height: 96rpx; padding: 0 24rpx; background: #fffdf8; border-radius: 20rpx; font-size: 34rpx; color: #453323; box-shadow: 0 0 0 1rpx rgba(97,75,57,.12); }
.excerpt-title-tools { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; color: #86745f; font-size: 23rpx; }
.excerpt-title-tools button { margin-right: 0; }
.excerpt-style-choices { display: flex; gap: 18rpx; margin: 20rpx 0; }
.excerpt-style-choice { flex: 1; padding: 22rpx 12rpx; min-height: 88rpx; background: #f6efe4; color: #614b39; border-radius: 20rpx; font-size: 28rpx; line-height: 1.6; }
.excerpt-style-choice text { display: block; font-size: 22rpx; font-weight: normal; }
.excerpt-style-choice.selected { background: #eaf0df; box-shadow: inset 0 0 0 2rpx #899875; }
.excerpt-selected-copy { margin: 36rpx 0 24rpx; padding: 28rpx; border-radius: 20rpx; background: #f5eee4; font-size: 28rpx; line-height: 1.8; white-space: pre-wrap; }
.excerpt-selected-copy > text { display: block; }
.excerpt-generate { margin-top: 24rpx; }
.excerpt-story-image { width: 100%; margin: 28rpx 0 8rpx; border-radius: 16rpx; outline: 1px solid rgba(0,0,0,.1); outline-offset: -1px; }
.excerpt-reading-link { margin: 24rpx 0 0; background: #f5eee4; color: #614b39; text-align: left; font-size: 28rpx; border-radius: 18rpx; }
