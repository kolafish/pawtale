.book-reader-page {
  padding: 26rpx 28rpx 72rpx;
  color: var(--ui-text-primary);
}

.reader-cover {
  overflow: hidden;
  padding: 42rpx 34rpx 36rpx;
  background:
    linear-gradient(145deg, rgba(255, 253, 250, 0.98), rgba(250, 247, 242, 0.92));
}

.reader-eyebrow,
.reader-title,
.reader-subtitle,
.reader-meta,
.reader-notice,
.section-label,
.toc-index,
.toc-title,
.toc-section-index,
.toc-section-title,
.chapter-index,
.chapter-title,
.chapter-meta,
.chapter-content,
.small-section-index,
.small-section-title,
.small-section-content,
.book-content,
.reader-state {
  display: block;
}

.reader-eyebrow {
  color: var(--ui-section-title);
  font-family: var(--ui-font-editorial);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0.06em;
  line-height: 1.4;
}

.reader-title {
  margin-top: 14rpx;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.28;
  word-break: break-word;
}

.reader-subtitle {
  margin-top: 16rpx;
  color: var(--ui-text-secondary);
  font-size: 29rpx;
  line-height: 1.55;
  word-break: break-word;
}

.reader-meta {
  margin-top: 20rpx;
  color: var(--ui-text-muted);
  font-size: 24rpx;
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}

.reader-notice {
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: var(--ui-radius-control);
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-accent-strong);
  box-shadow: inset 4rpx 0 0 var(--ui-accent-border);
  font-size: 24rpx;
  line-height: 1.55;
}

.reader-notice.subtle {
  background: var(--ui-surface-soft);
  color: var(--ui-text-secondary);
  box-shadow: inset 4rpx 0 0 var(--ui-divider);
}

.reader-audio-action {
  width: auto;
  min-width: 232rpx;
  min-height: 88rpx;
  margin-top: 26rpx;
  padding: 10rpx 22rpx 10rpx 14rpx;
  display: inline-flex;
  gap: 14rpx;
  border-radius: 999rpx;
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  box-shadow: var(--ui-control-shadow);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}

.reader-audio-mark {
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--ui-accent);
  color: var(--ui-on-accent);
  font-size: 22rpx;
  line-height: 1;
}

.reader-playback-error {
  display: block;
  margin-top: 16rpx;
  color: var(--ui-danger-text);
  font-size: 25rpx;
  line-height: 1.5;
  text-wrap: pretty;
}

.reader-tts-shell {
  position: sticky;
  top: 16rpx;
  z-index: 4;
  margin-top: 24rpx;
}

.reader-state {
  padding: 34rpx 30rpx;
  color: var(--ui-text-secondary);
  font-size: 30rpx;
  line-height: 1.55;
}

.reader-state.error {
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
  box-shadow: inset 0 0 0 1rpx rgba(168, 73, 63, 0.12);
}

.reader-section {
  margin-top: 22rpx;
  padding: 28rpx 30rpx;
}

.section-label {
  color: var(--ui-accent-strong);
  font-family: var(--ui-font-editorial);
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  line-height: 1.4;
}

.toc-list {
  margin-top: 16rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.toc-group {
  min-width: 0;
  padding: 10rpx 0 14rpx;
  border-bottom: 1rpx solid var(--ui-divider);
}

.toc-row {
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 10rpx 0;
  display: grid;
  grid-template-columns: 82rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 14rpx;
  border: 0;
  background: transparent;
  text-align: left;
}

.toc-index {
  color: var(--ui-section-title);
  font-size: 24rpx;
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}

.toc-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.5;
  word-break: break-word;
}

.toc-action {
  color: var(--ui-accent-strong);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.4;
}

.toc-section-list {
  margin: 4rpx 0 0 26rpx;
  padding: 4rpx 0 4rpx 20rpx;
  border-left: 2rpx solid var(--ui-divider);
}

.toc-section-row {
  min-height: 52rpx;
  display: grid;
  grid-template-columns: 68rpx minmax(0, 1fr);
  align-items: start;
  gap: 12rpx;
  padding: 7rpx 0;
}

.toc-section-index,
.toc-section-title {
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.toc-section-index {
  font-variant-numeric: tabular-nums;
}

.toc-section-title {
  word-break: break-word;
}

.chapter-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.chapter-block {
  padding: 34rpx 32rpx;
}

.chapter-preview-block {
  padding-top: 38rpx;
}

.chapter-index {
  color: var(--ui-section-title);
  font-size: 24rpx;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
}

.chapter-title {
  margin-top: 8rpx;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
  word-break: break-word;
}

.chapter-meta {
  margin-top: 10rpx;
  color: var(--ui-text-muted);
  font-size: 24rpx;
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}

.reader-small-section-list {
  margin-top: 28rpx;
}

.reader-small-section {
  min-width: 0;
}

.reader-small-section + .reader-small-section {
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--ui-divider);
}

.small-section-index {
  color: var(--ui-section-title);
  font-size: 22rpx;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
}

.small-section-title {
  margin-top: 8rpx;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 33rpx;
  font-weight: 700;
  line-height: 1.45;
  word-break: break-word;
}

.small-section-paragraph-list {
  margin-top: 18rpx;
}

.small-section-content,
.chapter-content,
.book-content {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 31rpx;
  line-height: 1.9;
  word-break: break-word;
}

.small-section-paragraph-list .small-section-content {
  margin: 0;
  text-indent: 2em;
}

.small-section-paragraph-list .small-section-content + .small-section-content {
  margin-top: 18rpx;
}

.reader-sentence-highlight {
  border-radius: 4rpx;
  background: var(--ui-warning-surface);
  color: var(--ui-text-primary);
}

.chapter-content,
.book-content {
  margin-top: 22rpx;
  white-space: pre-wrap;
}

.book-content {
  margin-top: 16rpx;
}

.reader-top-action {
  width: 100%;
  min-height: 88rpx;
  margin: 28rpx 0 0;
  border: 0;
  border-radius: var(--ui-radius-control);
  background: transparent;
  color: var(--ui-accent-strong);
  box-shadow: inset 0 0 0 1rpx var(--ui-accent-border);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}
