<view class="book-reader-page ui-page-shell">
  <view wx:if="{{loading}}" class="reader-state">
    <text>正在打开成书...</text>
  </view>

  <view wx:elif="{{error}}" class="reader-state error">
    <text>{{error}}</text>
  </view>

  <block wx:else>
    <view class="reader-cover">
      <text class="reader-eyebrow">{{readerMode === "chapter" ? "整章预览" : "成书阅读"}}</text>
      <text class="reader-title">{{readerTitle}}</text>
      <text wx:if="{{readerSubtitle}}" class="reader-subtitle">{{readerSubtitle}}</text>
      <text class="reader-meta">
        {{readerMode === "chapter" ? bookVersionText : ((bookPreviewChapters.length || bookPreviewTocItems.length) + " 章 · " + (bookCharCount || 0) + " 字 · " + bookVersionText)}}
      </text>
      <text wx:if="{{bookStaleNotice}}" class="reader-notice">{{bookStaleNotice}}</text>
      <text wx:if="{{bookVersionNotice}}" class="reader-notice subtle">{{bookVersionNotice}}</text>
      <view
        class="reader-audio-action ui-block-action ui-pressable {{bookViewingHistoricalVersion ? 'is-disabled' : ''}}"
        aria-role="button"
        aria-disabled="{{bookViewingHistoricalVersion}}"
        bindtap="playReaderAudio"
      >
        {{ttsBusyTarget === readerMode ? (readerMode === "chapter" ? "正在准备整章朗读…" : "正在准备全书朗读…") : (playingTarget === readerMode ? "停止朗读" : (bookViewingHistoricalVersion ? "历史版本暂不朗读" : (readerMode === "chapter" ? "朗读整章" : "朗读全书")))}}
      </view>
      <text wx:if="{{playbackError}}" class="reader-playback-error">{{playbackError}}</text>
    </view>

    <view
      wx:if="{{ttsBusyTarget || playingTarget || bookTTSActiveTarget}}"
      class="reader-tts-shell"
    >
      <book-tts-player
        title="{{readerMode === 'chapter' ? '整章朗读' : '全书朗读'}}"
        phase="{{ttsBusyTarget ? 'preparing' : (playingTarget ? 'playing' : 'completed')}}"
        progress="{{bookTTSProgressPercent}}"
        spoken-text="{{readerMode === 'chapter' ? '' : bookTTSSpokenText}}"
        current-text="{{readerMode === 'chapter' ? '' : bookTTSCurrentText}}"
        remaining-text="{{readerMode === 'chapter' ? '' : bookTTSRemainingText}}"
        bindstop="stopPlayback"
      />
    </view>

    <view wx:if="{{readerMode === 'book' && bookPreviewTocItems.length}}" class="reader-section">
      <text class="section-label">目录</text>
      <view class="toc-list">
        <view wx:for="{{bookPreviewTocItems}}" wx:key="id" wx:for-item="chapter" class="toc-group">
          <view
            class="toc-row"
            data-index="{{index}}"
            aria-role="button"
            aria-label="跳到 {{chapter.title}}"
            bindtap="openReaderChapter"
          >
            <text class="toc-index">{{chapter.indexText}}</text>
            <text class="toc-title">{{chapter.title}}</text>
            <text class="toc-action">阅读</text>
          </view>
          <view wx:if="{{chapter.sections.length}}" class="toc-section-list">
            <view wx:for="{{chapter.sections}}" wx:key="id" wx:for-item="section" class="toc-section-row">
              <text class="toc-section-index">{{section.indexText}}</text>
              <text class="toc-section-title">{{section.title}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{bookPreviewChapters.length}}" class="chapter-list">
      <view
        wx:for="{{bookPreviewChapters}}"
        wx:key="id"
        wx:for-item="chapter"
        id="reader-chapter-{{index}}"
        class="chapter-block {{readerMode === 'chapter' ? 'chapter-preview-block' : ''}}"
      >
        <block wx:if="{{readerMode === 'book'}}">
          <text class="chapter-index">{{chapter.indexText}}</text>
          <text class="chapter-title">{{chapter.title}}</text>
          <text wx:if="{{chapter.metaText}}" class="chapter-meta">{{chapter.metaText}}</text>
        </block>
        <view wx:if="{{chapter.sections.length}}" class="reader-small-section-list">
          <view wx:for="{{chapter.sections}}" wx:key="id" wx:for-item="section" class="reader-small-section">
            <text class="small-section-index">小节 {{section.indexText}}</text>
            <text class="small-section-title">{{section.title}}</text>
            <view class="small-section-paragraph-list">
              <view
                wx:for="{{section.paragraphs}}"
                wx:key="*this"
                wx:for-item="paragraph"
                wx:for-index="paragraphIndex"
                class="small-section-content"
              >
                <block wx:if="{{readerMode === 'chapter' && section.id === readerHighlightSectionId && paragraphIndex === readerHighlightParagraphIndex}}">
                  <text selectable>{{readerHighlightBefore}}</text>
                  <text class="reader-sentence-highlight" selectable>{{readerHighlightCurrent}}</text>
                  <text selectable>{{readerHighlightAfter}}</text>
                </block>
                <text wx:else selectable>{{paragraph}}</text>
              </view>
            </view>
          </view>
        </view>
        <text wx:else class="chapter-content" selectable>{{chapter.content}}</text>
      </view>
    </view>

    <view wx:else class="reader-section">
      <text class="section-label">正文</text>
      <text class="book-content" selectable>{{bookContent}}</text>
    </view>

    <view
      class="reader-top-action ui-block-action ui-pressable"
      aria-role="button"
      bindtap="scrollReaderToTop"
    >{{readerMode === "chapter" ? "回到章首" : "回到目录与封面"}}</view>
  </block>
</view>
