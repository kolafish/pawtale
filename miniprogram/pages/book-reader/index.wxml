<import src="../../templates/share-likes.wxml" />
<template name="readerHighlightedText">
  <block wx:if="{{active}}">
    <text selectable>{{before}}</text><text id="reader-spoken-sentence" class="reader-sentence-highlight" selectable>{{current}}</text><text selectable>{{after}}</text>
  </block>
  <text wx:else selectable>{{text}}</text>
</template>
<view wx:if="{{excerptMode === 'compose' || excerptMode === 'preview' || excerptMode === 'shared'}}" class="ui-page-shell {{pageClass}} excerpt-page">
  <view wx:if="{{loading}}" class="reader-state">正在打开选文…</view>
  <block wx:elif="{{excerptMode === 'compose'}}">
    <text class="excerpt-eyebrow">分享这段故事</text>
    <text class="excerpt-config-heading">一个让好友想读下去的标题</text>
    <input class="excerpt-title-input" value="{{excerptTitle}}" maxlength="40" disabled="{{excerptTitleBusy || excerptBusy}}" bindinput="changeExcerptTitle" placeholder="写一个分享标题" />
    <text class="excerpt-summary-label">卡片摘要</text>
    <input class="excerpt-summary-input" value="{{excerptSummary}}" maxlength="48" disabled="{{excerptTitleBusy || excerptBusy}}" bindinput="changeExcerptSummary" placeholder="用一句话介绍这个故事" />
    <view class="excerpt-title-tools"><text>{{excerptTitleBusy ? '正在推荐标题和摘要…' : 'AI 推荐后，可自行修改'}}</text><button class="ui-share-more" bindtap="suggestExcerptTitle" disabled="{{excerptTitleBusy || excerptBusy}}">重新推荐</button></view>
    <text wx:if="{{excerptTitleError}}" class="excerpt-selection-error">{{excerptTitleError}}</text>
    <text class="excerpt-config-heading">选择卡片样式</text>
    <view class="excerpt-style-choices" aria-role="radiogroup" aria-label="卡片样式">
      <button class="excerpt-style-choice {{excerptStyle === 'text' ? 'selected' : ''}}" data-style="text" bindtap="chooseExcerptStyle" aria-role="radio" aria-checked="{{excerptStyle === 'text'}}">纯文字<text>简短摘要 + 出处</text></button>
      <button class="excerpt-style-choice {{excerptStyle === 'image' ? 'selected' : ''}}" data-style="image" bindtap="chooseExcerptStyle" aria-role="radio" aria-checked="{{excerptStyle === 'image'}}">带图片<text>图片 + 简短摘要</text></button>
    </view>
    <block wx:if="{{excerptStyle === 'image'}}">
      <view class="excerpt-style-choices">
        <button class="excerpt-style-choice {{excerptImageSource === 'ai' ? 'selected' : ''}}" data-source="ai" bindtap="chooseExcerptImageSource">AI 插图</button>
        <button class="excerpt-style-choice {{excerptImageSource === 'photo' ? 'selected' : ''}}" data-source="photo" bindtap="chooseExcerptImageSource">自己的照片</button>
      </view>
      <block wx:if="{{excerptImageSource === 'ai'}}">
        <text class="excerpt-help">与视频共用插图风格。仅在点击生成后制作一张插图。</text>
        <image-background-note value="{{excerptBackgroundNote}}" page-class="{{pageClass}}"
          disabled="{{materialImageCreating || materialImagePolling || excerptBusy}}" bindchange="changeExcerptBackgroundNote" />
        <illustration-style-picker options="{{excerptStyleOptions}}" value="{{excerptIllustrationStyle}}" disabled="{{materialImageCreating || materialImagePolling}}" bindchange="changeExcerptIllustrationStyle" />
        <share-video-photos wx:if="{{excerptAiAssetIds.length}}" project-id="{{projectId}}" photo-ids="{{excerptAiAssetIds}}" max-count="1" disabled="{{true}}" binderror="onExcerptPhotoError" />
        <button class="ui-share-more excerpt-generate" bindtap="generateExcerptImage" loading="{{materialImageCreating || materialImagePolling}}" disabled="{{materialImageCreating || materialImagePolling || !excerptStyleOptions.length || excerptAiAssetIds.length}}">{{excerptAiAssetIds.length ? '插图已生成' : '生成一张插图'}}</button>
        <text class="excerpt-help">{{materialImageError || materialImageStatusText || 'AI 意象插图，不是真实历史照片；图片会保存到插图管理。'}}</text>
      </block>
      <block wx:else>
        <share-video-photos project-id="{{projectId}}" photo-ids="{{excerptPhotoIds}}" max-count="1" disabled="{{excerptBusy}}" bindchange="changeExcerptPhotos" bindbusy="onExcerptPhotoBusy" binderror="onExcerptPhotoError" />
        <text class="excerpt-help">从手机上传或从图片素材选择，统一保存在插图管理中。</text>
      </block>
    </block>
    <view class="excerpt-selected-copy"><text class="excerpt-eyebrow">完整选文 · {{excerptSelectionCount}} 字</text><text user-select="{{true}}">{{excerptContent}}</text></view>
    <text class="excerpt-help">确认标题、摘要、选文和图片均适合公开。卡片只展示引子，好友点开可读全部选文。</text>
    <view class="excerpt-actions"><button class="ui-share-more" bindtap="reselectExcerpt">重新选文</button><button class="excerpt-share-button" bindtap="confirmExcerptCard" loading="{{excerptBusy}}" disabled="{{excerptBusy || excerptTitleBusy || excerptPhotoBusy || excerptReloadRequired}}">预览分享卡片</button></view>
  </block>
  <block wx:elif="{{excerptMode === 'preview'}}">
    <text class="excerpt-eyebrow">选文分享</text>
    <text class="excerpt-help">请确认选中的文字没有不想公开的内容。</text>
    <image class="excerpt-card-image" src="{{excerptImageUrl}}" data-url="{{excerptImageUrl}}" mode="widthFix" bindload="onExcerptImageLoad" binderror="onExcerptImageError" />
    <text class="excerpt-help">已选 {{excerptSelectionCount}} 字 · 好友点开可读全部选文</text>
    <view class="excerpt-actions">
      <button class="ui-share-more" bindtap="editExcerptCard">修改卡片</button>
      <button class="excerpt-share-button" open-type="{{excerptImageReady ? 'share' : ''}}" disabled="{{!excerptImageReady}}">分享给好友</button>
    </view>
  </block>
  <block wx:elif="{{excerptContent}}">
    <view class="excerpt-paper">
      <text class="excerpt-eyebrow">分享的故事</text>
      <text class="excerpt-title">{{excerptTitle}}</text>
      <view wx:if="{{excerptStoryImageUrl}}" class="excerpt-story-image-shell"><image class="excerpt-story-image" src="{{excerptStoryImageUrl}}" mode="aspectFill" /></view>
      <text wx:if="{{excerptStoryImageUrl && excerptImageDisclosure}}" class="excerpt-image-disclosure">AI背景图</text>
      <view class="excerpt-quote"><text user-select="{{true}}">{{excerptContent}}</text></view>
      <view class="excerpt-source-card {{excerptReadingLink && excerptReadingLink.scope === 'book' ? 'is-readable' : ''}}"
        bindtap="openExcerptReading" aria-role="{{excerptReadingLink && excerptReadingLink.scope === 'book' ? 'link' : ''}}"
        aria-label="选自《{{excerptBookTitle}}》，{{excerptChapterTitle}}{{excerptReadingLink && excerptReadingLink.scope === 'book' ? '，继续阅读这本回忆录' : ''}}"
        hover-class="{{excerptReadingLink && excerptReadingLink.scope === 'book' ? 'excerpt-source-card-hover' : 'none'}}">
        <view class="excerpt-source">
          <image class="excerpt-source-icon" src="/assets/book-reader/hero-branch.png" mode="aspectFit" aria-hidden="true" />
          <view class="excerpt-source-copy"><text class="excerpt-attribution">选自《{{excerptBookTitle}}》</text><text class="excerpt-source-chapter">{{excerptChapterTitle}}</text></view>
        </view>
        <view wx:if="{{excerptReadingLink && excerptReadingLink.scope === 'book'}}" class="excerpt-reading-link"><text class="excerpt-reading-label">继续阅读这本回忆录</text><text class="excerpt-reading-arrow" aria-hidden="true">→</text></view>
      </view>
    </view>
    <view class="excerpt-origin">
      <image src="/assets/memoir-microphone.png" mode="aspectFit" aria-hidden="true" />
      <text>由讲述者亲口讲述 · 老余口述整理成书</text>
    </view>
    <view class="excerpt-reader-actions">
      <button class="excerpt-reader-button is-primary" open-type="share">分享给好友</button>
      <button class="excerpt-reader-button is-secondary" bindtap="openShareHome">我也想记录家人的故事</button>
    </view>
    <template is="shareLikeBar" data="{{shareLikeVisible, shareLiked, shareCanLike, shareLikeBusy, shareLikeAvatars, shareLikeText, shareLikeProfileMissing}}" />
  </block>
  <view wx:if="{{error}}" class="reader-state error">
    <text>{{error}}</text>
    <button class="ui-share-more" bindtap="retryExcerpt">重试</button>
  </view>
</view>
<view wx:else class="ui-page-shell {{pageClass}} {{excerptMode === 'select' ? 'ui-fixed-action-page' : ''}}">
  <text wx:if="{{sharePreview}}" class="share-preview-notice">好友将看到这些内容</text>
  <view wx:if="{{loading}}" class="reader-state ui-card">
    <text>正在打开成书...</text>
  </view>

  <view wx:elif="{{error && (excerptMode !== 'select' || !bookPreviewChapters.length)}}" class="reader-state error ui-card">
    <text>{{error}}</text>
    <button wx:if="{{excerptMode === 'select'}}" class="ui-share-more" bindtap="retryExcerpt">重新载入正文</button>
    <button wx:if="{{readerShared && shareRetryable}}" class="ui-share-primary" bindtap="retrySharedReading">重试</button>
    <button wx:if="{{readerShared}}" class="ui-share-more" bindtap="openShareHome">返回首页</button>
  </view>

  <block wx:else>
    <view class="reader-cover ui-card">
      <image wx:if="{{shareCoverUrl}}" class="share-cover-image" src="{{shareCoverUrl}}" mode="widthFix" />
      <image
        wx:if="{{readerMode === 'book' && !shareCoverUrl}}"
        class="reader-cover-art"
        src="/assets/book-reader/hero-branch.png"
        mode="aspectFit"
        aria-hidden="true"
      />
      <view class="reader-cover-copy">
        <text wx:if="{{readerMode === 'chapter'}}" class="reader-eyebrow">{{readerShared ? (shareScope === 'story' ? '一则故事' : '本章') : '整章预览'}}</text>
        <text class="reader-title">{{readerTitle}}</text>
        <text wx:if="{{shareByline}}" class="reader-subtitle">{{shareByline}}</text>
        <text wx:if="{{readerSubtitle}}" class="reader-subtitle">{{readerSubtitle}}</text>
        <text wx:if="{{readerMetaText}}" class="reader-meta">{{readerMetaText}}</text>
        <text wx:if="{{readerUpdateNotice}}" class="reader-notice">
          <text class="reader-notice-dot">•</text>
          <text>{{readerUpdateNotice}}</text>
        </text>
        <text wx:if="{{bookVersionNotice}}" class="reader-notice subtle">{{bookVersionNotice}}</text>
        <view
          wx:if="{{excerptMode !== 'select' && (!readerShared || (!sharePreview && !readerDemo))}}"
          class="reader-audio-action ui-block-action ui-pressable {{bookViewingHistoricalVersion ? 'is-disabled' : ''}}"
          aria-role="button"
          aria-disabled="{{bookViewingHistoricalVersion}}"
          bindtap="playReaderAudio"
        >
          <image class="reader-audio-icon" src="/assets/book-reader/audio.png" mode="aspectFit" />
          <text wx:if="{{readerShared}}">{{ttsBusyTarget ? '正在准备 AI 朗读…' : (playingTarget ? '停止朗读' : (shareScope === 'story' ? '听故事 · AI 朗读' : '听本章 · AI 朗读'))}}</text>
          <text wx:else>{{ttsBusyTarget === readerMode ? (readerMode === "chapter" ? "正在准备整章朗读…" : "正在准备全书朗读…") : (playingTarget === readerMode ? "停止朗读" : (bookViewingHistoricalVersion ? "历史版本暂不朗读" : (readerMode === "chapter" ? "朗读整章" : "朗读全书")))}}</text>
        </view>
        <button wx:if="{{readerShared && shareScope === 'book'}}" class="ui-share-more" bindtap="continueSharedReading">继续阅读</button>
        <text wx:if="{{playbackError}}" class="reader-playback-error">{{playbackError}}</text>
      </view>
    </view>

    <view
      wx:if="{{ttsBusyTarget || playingTarget || bookTTSActiveTarget}}"
      class="reader-tts-shell"
    >
      <book-tts-player
        title="{{readerShared ? 'AI 朗读' : (readerMode === 'chapter' ? '整章朗读' : '全书朗读')}}"
        phase="{{ttsBusyTarget ? 'preparing' : (playingTarget ? 'playing' : 'completed')}}"
        preparing-text="{{bookTTSPreparingText || ''}}"
        progress="{{bookTTSProgressPercent}}"
        bindstop="stopPlayback"
      />
    </view>

    <view wx:if="{{shareScope !== 'story' && bookPreviewTocItems.length}}" class="reader-section ui-card">
      <text class="section-label">目录</text>
      <view class="toc-list">
        <view wx:for="{{bookPreviewTocItems}}" wx:key="id" wx:for-item="chapter" wx:for-index="chapterIndex" class="toc-group">
          <view
            class="toc-row ui-pressable"
            data-chapter-index="{{chapterIndex}}"
            aria-role="button"
            aria-label="{{chapter.expanded ? '收起' : '展开'}} {{chapter.title}}"
            aria-expanded="{{chapter.expanded}}"
            bindtap="toggleTocChapter"
          >
            <text class="toc-index">{{chapter.indexText}}</text>
            <view class="toc-heading">
              <text class="toc-title">{{chapter.title}}</text>
              <text class="toc-story-count">{{chapter.storyCountText}}</text>
            </view>
            <text class="toc-chevron {{chapter.expanded ? 'is-expanded' : ''}}">›</text>
          </view>
          <view wx:if="{{chapter.expanded && chapter.sections.length}}" class="toc-section-list">
            <view class="toc-section-row toc-chapter-action ui-pressable" data-chapter-id="{{chapter.chapterId}}" aria-role="button" bindtap="openReaderChapter">
              <text class="toc-section-title">阅读本章</text>
            </view>
            <view
              wx:for="{{chapter.sections}}"
              wx:key="id"
              wx:for-item="section"
              wx:for-index="sectionIndex"
              class="toc-section-row ui-pressable"
              data-chapter-id="{{chapter.chapterId}}"
              data-section-id="{{section.id}}"
              aria-role="button"
              aria-label="跳到 {{section.title}}"
              bindtap="openReaderSection"
            >
              <text class="toc-section-index">{{section.indexText}}</text>
              <text class="toc-section-title">{{section.title}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{sharePreface && readerChapterIndex === 0}}" class="reader-section ui-card"><text class="section-label">前言</text><text class="book-content" selectable>{{sharePreface}}</text></view>
    <view wx:if="{{bookPreviewChapters.length}}" id="reader-body" class="chapter-list">
      <view
        wx:for="{{bookPreviewChapters}}"
        wx:key="id"
        wx:for-item="chapter"
        wx:for-index="chapterIndex"
        class="chapter-block ui-card {{readerMode === 'chapter' ? 'chapter-preview-block' : ''}}"
      >
        <block wx:if="{{readerMode === 'book'}}">
          <text class="chapter-index">{{chapter.indexText}}</text>
          <text class="chapter-title">{{chapter.title}}</text>
        </block>
        <block wx:if="{{excerptMode === 'select'}}">
          <text class="excerpt-help excerpt-select-help">长按正文，拖动选区选择 1–512 字。好友只会看到选中的文字。</text>
          <editor id="excerpt-editor" class="excerpt-selector chapter-content" read-only="{{true}}" bindready="onExcerptEditorReady" />
          <text wx:if="{{error}}" class="excerpt-selection-error">{{error}}</text>
          <view class="excerpt-actions excerpt-selection-actions ui-fixed-action-dock">
            <button wx:if="{{excerptReloadRequired}}" class="ui-share-more" bindtap="retryExcerpt">重新载入正文</button>
            <button class="excerpt-share-button" catchtouchend="previewExcerptSelection" loading="{{excerptBusy}}" disabled="{{excerptBusy || excerptReloadRequired}}">分享这段选文</button>
          </view>
        </block>
        <block wx:else>
<view wx:for="{{shareImages}}" wx:key="id" wx:for-item="illustration" class="share-reading-image">
          <block wx:if="{{illustration.chapterId === chapter.chapterId && !illustration.sectionId}}">
            <image src="{{illustration.url}}" mode="widthFix" />
            <text wx:if="{{illustration.disclosure}}">AI背景图</text>
          </block>
        </view>
        <view wx:if="{{chapter.sections.length}}" class="reader-small-section-list">
          <view
            wx:for="{{chapter.sections}}"
            wx:key="id"
            wx:for-item="section"
            wx:for-index="sectionIndex"
            id="reader-section-{{sectionIndex}}"
            class="reader-small-section"
          >
            <text wx:if="{{section.title !== chapter.title}}" class="small-section-title">{{section.title}}</text>
            <view class="small-section-paragraph-list">
              <block wx:for="{{section.paragraphs}}" wx:key="*this" wx:for-item="paragraph" wx:for-index="paragraphIndex">
                <block wx:for="{{shareImages}}" wx:key="id" wx:for-item="illustration">
                  <view wx:if="{{illustration.chapterId === chapter.chapterId && illustration.sectionId === section.id && illustration.paragraphBefore === paragraphIndex}}" class="share-reading-image {{illustration.portrait ? 'portrait' : ''}}">
                    <image src="{{illustration.url}}" mode="widthFix" data-id="{{illustration.id}}" data-url="{{illustration.url}}" bindload="onReadingImageLoad" />
                    <text wx:if="{{illustration.disclosure}}">AI背景图</text>
                  </view>
                </block>
                <view class="small-section-content">
                  <template is="readerHighlightedText" data="{{text: paragraph, active: readerChapterIndex === readerHighlightChapterIndex && section.id === readerHighlightSectionId && paragraphIndex === readerHighlightParagraphIndex, before: readerHighlightBefore, current: readerHighlightCurrent, after: readerHighlightAfter}}" />
                </view>
              </block>
              <block wx:for="{{shareImages}}" wx:key="id" wx:for-item="illustration">
                <view wx:if="{{illustration.chapterId === chapter.chapterId && illustration.sectionId === section.id && illustration.paragraphBefore === section.paragraphs.length}}" class="share-reading-image">
                  <image src="{{illustration.url}}" mode="widthFix" data-id="{{illustration.id}}" data-url="{{illustration.url}}" bindload="onReadingImageLoad" />
                  <text wx:if="{{illustration.disclosure}}">AI背景图</text>
                </view>
              </block>
            </view>
          </view>
        </view>
        <view wx:else class="chapter-content"><template is="readerHighlightedText" data="{{text: chapter.content, active: readerChapterIndex === readerHighlightChapterIndex && readerHighlightSectionId === '', before: readerHighlightBefore, current: readerHighlightCurrent, after: readerHighlightAfter}}" /></view>
        </block>
      </view>
    </view>

    <view wx:else id="reader-body" class="reader-section ui-card">
      <text class="section-label">正文</text>
      <view class="book-content"><template is="readerHighlightedText" data="{{text: bookContent, active: readerChapterIndex === readerHighlightChapterIndex && readerHighlightSectionId === '', before: readerHighlightBefore, current: readerHighlightCurrent, after: readerHighlightAfter}}" /></view>
    </view>

    <view wx:if="{{readerMode === 'book' && readerChapterTotal > 1}}" class="reader-pagination">
      <view class="reader-page-action ui-pressable" aria-role="button" aria-disabled="{{readerChapterIndex === 0}}" bindtap="previousReaderChapter">上一{{bookPreviewChapters.length ? '章' : '页'}}</view>
      <text class="reader-page-count">{{readerChapterIndex + 1}} / {{readerChapterTotal}}</text>
      <view class="reader-page-action ui-pressable" aria-role="button" aria-disabled="{{readerChapterIndex === readerChapterTotal - 1}}" bindtap="nextReaderChapter">下一{{bookPreviewChapters.length ? '章' : '页'}}</view>
    </view>

    <view wx:if="{{shareAfterword && readerChapterIndex === readerChapterTotal - 1}}" class="reader-section ui-card"><text class="section-label">后记</text><text class="book-content" selectable>{{shareAfterword}}</text></view>
    <template is="shareLikeBar" data="{{shareLikeVisible, shareLiked, shareCanLike, shareLikeBusy, shareLikeAvatars, shareLikeText, shareLikeProfileMissing, shareForward: readerShared && !sharePreview && !readerDemo}}" />
  </block>
  <view wx:if="{{readerShared && !sharePreview && !readerDemo}}" hidden="{{loading || error}}">
    <share-response-form id="shared-response" reading-token="{{responseToken}}" active="{{!loading && !error}}" bindunavailable="onResponseUnavailable" />
  </view>

  <block wx:if="{{!loading && !error}}">
    <button wx:if="{{readerShared && !sharePreview}}" class="ui-share-more" bindtap="openShareHome">我也想讲故事</button>
    <view class="reader-top-action-shell">
      <view wx:if="{{readerDemo}}" class="reader-top-action ui-pressable" aria-role="button" bindtap="startMyStory">种下我的故事</view>
      <view
        class="reader-top-action ui-pressable"
        aria-role="button"
        bindtap="scrollReaderToTop"
      >↑ {{readerMode === "chapter" ? "回到章首" : "回到目录"}}</view>
    </view>
  </block>
</view>
