<view class="book-reader-page">
  <view wx:if="{{loading}}" class="reader-state">
    <text>正在打开成书...</text>
  </view>

  <view wx:elif="{{error}}" class="reader-state error">
    <text>{{error}}</text>
  </view>

  <block wx:else>
    <view class="reader-cover">
      <text class="reader-eyebrow">成书阅读</text>
      <text class="reader-title">{{readerTitle}}</text>
      <text wx:if="{{readerSubtitle}}" class="reader-subtitle">{{readerSubtitle}}</text>
      <text class="reader-meta">
        {{bookPreviewChapters.length || bookPreviewTocItems.length}} 章 · {{bookCharCount || 0}} 字 · {{bookVersionText}}
      </text>
      <text wx:if="{{bookStaleNotice}}" class="reader-notice">{{bookStaleNotice}}</text>
    </view>

    <view wx:if="{{bookPreviewTocItems.length}}" class="reader-section">
      <text class="section-label">目录</text>
      <view class="toc-list">
        <view wx:for="{{bookPreviewTocItems}}" wx:key="id" wx:for-item="chapter" class="toc-group">
          <view
            class="toc-row"
            data-index="{{index}}"
            aria-role="button"
            aria-label="跳到 {{chapter.title}}"
            bindtap="openReaderChapter"
          >
            <text class="toc-index">{{chapter.indexText}}</text>
            <text class="toc-title">{{chapter.title}}</text>
            <text class="toc-action">阅读</text>
          </view>
          <view wx:if="{{chapter.sections.length}}" class="toc-section-list">
            <view wx:for="{{chapter.sections}}" wx:key="id" wx:for-item="section" class="toc-section-row">
              <text class="toc-section-index">{{section.indexText}}</text>
              <text class="toc-section-title">{{section.title}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{bookPreviewChapters.length}}" class="chapter-list">
      <view
        wx:for="{{bookPreviewChapters}}"
        wx:key="id"
        wx:for-item="chapter"
        id="reader-chapter-{{index}}"
        class="chapter-block"
      >
        <text class="chapter-index">{{chapter.indexText}}</text>
        <text class="chapter-title">{{chapter.title}}</text>
        <text wx:if="{{chapter.metaText}}" class="chapter-meta">{{chapter.metaText}}</text>
        <view wx:if="{{chapter.sections.length}}" class="reader-small-section-list">
          <view wx:for="{{chapter.sections}}" wx:key="id" wx:for-item="section" class="reader-small-section">
            <text class="small-section-index">小节 {{section.indexText}}</text>
            <text class="small-section-title">{{section.title}}</text>
            <text class="small-section-content" selectable>{{section.content}}</text>
          </view>
        </view>
        <text wx:else class="chapter-content" selectable>{{chapter.content}}</text>
      </view>
    </view>

    <view wx:else class="reader-section">
      <text class="section-label">正文</text>
      <text class="book-content" selectable>{{bookContent}}</text>
    </view>

    <view
      class="reader-top-action ui-block-action ui-pressable"
      aria-role="button"
      bindtap="scrollReaderToTop"
    >回到目录与封面</view>
  </block>
</view>
