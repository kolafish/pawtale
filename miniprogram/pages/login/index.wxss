.login-page {
  min-height: 100vh;
  padding: 72rpx 36rpx 80rpx;
  background: #fcf7ed;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.brand-icon {
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
}

.brand-copy {
  flex: 1;
  min-width: 0;
}

.brand-title {
  display: block;
  color: #2b1713;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.2;
}

.brand-subtitle {
  display: block;
  margin-top: 12rpx;
  color: #7b6f68;
  font-size: 28rpx;
  line-height: 1.35;
}

.login-panel {
  padding: 36rpx 32rpx;
  border: 2rpx solid #e8d8c3;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(64, 43, 24, 0.08);
}

.panel-title {
  display: block;
  color: #2b1713;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
}

.panel-copy {
  display: block;
  margin-top: 14rpx;
  color: #7b6f68;
  font-size: 26rpx;
  line-height: 1.45;
}

.field {
  margin-top: 28rpx;
}

.field-label {
  display: block;
  color: #a64b3e;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.2;
}

.field-input {
  height: 92rpx;
  margin-top: 14rpx;
  padding: 0 22rpx;
  border: 2rpx solid #e8d8c3;
  border-radius: 14rpx;
  background: #fcf7ed;
  color: #2b1713;
  font-size: 30rpx;
}

.account-panel {
  margin-top: 12rpx;
}

.primary-button,
.mode-button,
.secondary-button {
  width: 100%;
  height: 98rpx;
  margin: 30rpx 0 0;
  border: 0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
}

.primary-button::after,
.mode-button::after,
.secondary-button::after {
  border: 0;
}

.primary-button {
  background: #a64b3e;
  color: #ffffff;
}

.mode-button {
  background: #fff3ef;
  color: #a64b3e;
}

.secondary-button {
  background: #2b1713;
  color: #ffffff;
}

.primary-button[disabled],
.mode-button[disabled],
.secondary-button[disabled] {
  opacity: 0.72;
}

.error {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  background: #fff1f3;
  color: #b84a5a;
  font-size: 26rpx;
  line-height: 1.45;
}
