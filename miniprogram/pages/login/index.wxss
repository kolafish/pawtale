.login-page {
  min-height: 100vh;
  padding: 72rpx 36rpx 80rpx;
  background: #fcf7ed;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.brand-icon {
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
}

.brand-copy {
  flex: 1;
  min-width: 0;
}

.brand-title {
  display: block;
  color: #2b1713;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.2;
}

.brand-subtitle {
  display: block;
  margin-top: 12rpx;
  color: #7b6f68;
  font-size: 28rpx;
  line-height: 1.35;
}

.login-panel {
  padding: 36rpx 32rpx;
  border: 0;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.06),
    0 4rpx 10rpx rgba(64, 43, 24, 0.04),
    0 20rpx 48rpx rgba(64, 43, 24, 0.09);
}

.panel-eyebrow {
  display: block;
  margin-bottom: 10rpx;
  color: #8f3e35;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
}

.panel-title {
  display: block;
  color: #2b1713;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
  text-wrap: balance;
}

.panel-copy {
  display: block;
  margin-top: 14rpx;
  color: #7b6f68;
  font-size: 26rpx;
  line-height: 1.45;
  text-wrap: pretty;
}

.field {
  margin-top: 28rpx;
}

.field-label {
  display: block;
  color: #a64b3e;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.2;
}

.field-input {
  height: 92rpx;
  margin-top: 14rpx;
  padding: 0 22rpx;
  border: 2rpx solid #e8d8c3;
  border-radius: 14rpx;
  background: #fcf7ed;
  color: #2b1713;
  font-size: 30rpx;
}

.account-panel {
  margin-top: 12rpx;
}

.primary-button,
.mode-button,
.secondary-button {
  width: 100%;
  height: 98rpx;
  margin: 30rpx 0 0;
  border: 0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.primary-button::after,
.mode-button::after,
.secondary-button::after {
  border: 0;
}

.primary-button {
  background: #a64b3e;
  color: #ffffff;
}

.primary-button-hover {
  background: #8f3e35;
  transform: scale(0.96);
}

.mode-button {
  background: #fff3ef;
  color: #a64b3e;
}

.secondary-button {
  background: #2b1713;
  color: #ffffff;
}

.primary-button[disabled],
.mode-button[disabled],
.secondary-button[disabled] {
  opacity: 0.72;
}

.error {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  background: #fff1f3;
  color: #b84a5a;
  font-size: 26rpx;
  line-height: 1.45;
}

.profile-setup-panel {
  padding-top: 32rpx;
}

.profile-avatar-row {
  margin-top: 32rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #fffaf6;
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.05),
    0 6rpx 16rpx rgba(64, 43, 24, 0.04);
}

.profile-avatar-picker {
  position: relative;
  flex: 0 0 112rpx;
  width: 112rpx;
  height: 112rpx;
  min-width: 112rpx;
  min-height: 112rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: #a64b3e;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
  transition-property: transform, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.profile-avatar-picker::after {
  border: 0;
}

.profile-avatar-picker-hover {
  transform: scale(0.96);
  box-shadow: 0 0 0 8rpx rgba(166, 75, 62, 0.10);
}

.profile-avatar-image {
  width: 112rpx;
  height: 112rpx;
  border-radius: 999rpx;
}

.profile-avatar-fallback {
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 112rpx;
}

.profile-avatar-edit {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #8f3e35;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 44rpx;
  text-align: center;
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.08),
    0 4rpx 10rpx rgba(64, 43, 24, 0.10);
}

.profile-avatar-copy {
  min-width: 0;
  flex: 1;
}

.profile-name-field {
  margin-top: 24rpx;
}

.profile-field-title {
  display: block;
  color: #2b1713;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.4;
  text-wrap: balance;
}

.profile-field-hint {
  display: block;
  margin-top: 8rpx;
  color: #7b6f68;
  font-size: 24rpx;
  line-height: 1.45;
  text-wrap: pretty;
}

.profile-name-input {
  width: 100%;
  height: 96rpx;
  min-height: 48px;
  margin-top: 12rpx;
  padding: 0 22rpx;
  border: 2rpx solid #e8d8c3;
  border-radius: 18rpx;
  background: #fcf7ed;
  color: #2b1713;
  font-size: 30rpx;
  font-weight: 700;
}

.skip-profile-button {
  width: 100%;
  min-height: 88rpx;
  margin: 12rpx 0 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 18rpx;
  background: transparent;
  color: #7b6f68;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 88rpx;
  transition-property: transform, background-color;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.skip-profile-button::after {
  border: 0;
}

.skip-profile-button-hover {
  background: #f5eee7;
  transform: scale(0.96);
}
