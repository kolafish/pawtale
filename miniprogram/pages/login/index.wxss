@import "../../styles/support-forms.wxss";

.login-page {
  padding: 64rpx 36rpx 80rpx;
}

.brand-row {
  margin-bottom: 44rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.brand-icon {
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
}

.brand-copy,
.login-action-label,
.profile-avatar-copy {
  min-width: 0;
  flex: 1;
}

.brand-title,
.brand-subtitle,
.panel-eyebrow,
.panel-title,
.panel-copy,
.profile-field-title {
  display: block;
}

.brand-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 0.04em;
  text-wrap: balance;
}

.brand-subtitle {
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: var(--ui-line-body);
}

.login-panel {
  padding: 24rpx 4rpx 12rpx;
}

.panel-eyebrow {
  margin-bottom: 10rpx;
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-meta);
  font-weight: 800;
  line-height: 1.35;
}

.panel-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-page-title);
  font-weight: 800;
  line-height: 1.3;
  text-wrap: balance;
}

.panel-copy {
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: 1.5;
  text-wrap: pretty;
}

.primary-button {
  width: 100%;
  min-height: 92rpx;
  margin: 28rpx 0 0;
  padding: 0 24rpx;
  border-radius: var(--ui-radius-control);
  gap: 16rpx;
  font-size: var(--ui-font-action);
}

.primary-button {
  background: var(--ui-accent);
  color: var(--ui-on-accent);
  text-align: center;
  box-shadow: 0 10rpx 24rpx rgba(148, 69, 53, 0.18);
}

.login-action-mark {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  color: var(--ui-on-accent);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-meta);
  line-height: 48rpx;
  text-align: center;
}

.login-action-arrow {
  width: 48rpx;
  flex: 0 0 48rpx;
  color: var(--ui-on-accent);
  text-align: center;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1;
  transform: translateY(-1rpx);
}

.primary-button-hover {
  background: var(--ui-accent-strong);
  transform: scale(0.96);
}

.profile-field-title {
  color: var(--ui-text-primary);
  font-size: var(--ui-font-list-title);
  font-weight: 800;
  line-height: 1.4;
}

.profile-name-input {
  min-height: 92rpx;
  margin-top: 12rpx;
}

.error {
  margin-top: 22rpx;
  font-size: var(--ui-font-body);
}

.profile-setup-panel {
  padding-top: 20rpx;
}

.profile-avatar-row {
  margin-top: 28rpx;
  padding: 22rpx;
  border-radius: var(--ui-radius-card);
  background: var(--ui-success-surface);
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.profile-avatar-picker {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  min-width: 104rpx;
  min-height: 104rpx;
  flex: 0 0 104rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: var(--ui-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
  transition-property: transform, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.profile-avatar-image {
  width: 104rpx;
  height: 104rpx;
  border-radius: 999rpx;
}

.profile-avatar-fallback {
  color: var(--ui-accent-strong);
  font-family: var(--ui-font-editorial);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 104rpx;
}

.profile-avatar-edit {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-caption);
  font-weight: 800;
  line-height: 44rpx;
  text-align: center;
  box-shadow: var(--ui-control-shadow);
}

.profile-name-field {
  margin-top: 24rpx;
}

.profile-name-input {
  min-height: 96rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.skip-profile-button {
  min-height: 88rpx;
  margin: 10rpx 0 0;
  padding: 0 24rpx;
  border-radius: var(--ui-radius-control);
  background: transparent;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-action);
  font-weight: 700;
  line-height: 88rpx;
}
