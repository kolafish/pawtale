<view class="ui-page-shell {{pageClass}}">
  <view class="brand-row">
    <image class="brand-icon" src="/assets/memoir-gramophone.png" mode="aspectFit" />
    <view class="brand-copy">
      <text class="brand-title">老余口述</text>
      <text class="brand-subtitle">把您的往事讲成一本书</text>
    </view>
  </view>

  <view wx:if="{{!profileMode}}" class="login-panel">
    <text class="panel-title">欢迎登录</text>
    <text class="panel-copy">登录后保存您的讲述和书稿。</text>

    <view wx:if="{{error}}" class="error ui-error-banner">{{error}}</view>

    <view
      id="wechat-login-action"
      class="primary-button support-action ui-block-action ui-pressable {{wechatLoading ? 'is-disabled' : ''}}"
      aria-role="button"
      aria-disabled="{{wechatLoading}}"
      bindtap="submitWeChat"
    >
      <text class="login-action-mark" aria-hidden="true">微</text>
      <text class="login-action-label">{{wechatLoading ? "微信登录中" : "微信登录"}}</text>
      <text class="login-action-arrow" aria-hidden="true">›</text>
    </view>

    <checkbox-group class="privacy-consent" bindchange="changePrivacyConsent">
      <view class="ui-consent-row">
        <label class="ui-consent-choice">
          <checkbox value="privacy_contract" checked="{{privacyAgreed}}" disabled="{{wechatLoading}}" color="#b65d49" />
          <text>我已阅读并同意</text>
        </label>
        <view class="ui-consent-link ui-pressable" catchtap="openPrivacyContract"
          hover-class="ui-subtle-action-hover" aria-role="button" aria-label="阅读用户隐私保护指引">《用户隐私保护指引》</view>
      </view>
    </checkbox-group>
  </view>

  <view wx:else class="login-panel profile-setup-panel">
    <text class="panel-eyebrow">已点赞</text>
    <text class="panel-title">让家人知道是谁点的赞</text>
    <text class="panel-copy">头像昵称用于展示点赞，可跳过。</text>

    <view wx:if="{{error}}" class="error ui-error-banner">{{error}}</view>

    <view class="profile-avatar-row">
      <button
        class="profile-avatar-picker"
        open-type="chooseAvatar"
        bindchooseavatar="chooseWeChatAvatar"
        aria-label="选择微信头像"
        hover-class="ui-avatar-action-hover"
      >
        <image
          wx:if="{{profileAvatarPath}}"
          class="profile-avatar-image ui-image-outline"
          src="{{profileAvatarPath}}"
          mode="aspectFill"
        />
        <text wx:else class="profile-avatar-fallback">微</text>
        <text class="profile-avatar-edit">换</text>
      </button>
      <view class="profile-avatar-copy">
        <text class="profile-field-title">微信头像</text>
      </view>
    </view>

    <view class="profile-name-field">
      <text class="profile-field-title">昵称</text>
      <input
        class="profile-name-input support-form-input"
        type="nickname"
        value="{{profileDisplayName}}"
        maxlength="40"
        placeholder="点击选择微信昵称"
        bindinput="changeProfileDisplayName"
      />
    </view>

    <view
      class="primary-button support-action ui-block-action ui-pressable {{profileSaving ? 'is-disabled' : ''}}"
      aria-role="button"
      aria-disabled="{{profileSaving}}"
      bindtap="saveWeChatProfile"
      hover-class="primary-button-hover"
    >
      <text class="login-action-mark" aria-hidden="true">✓</text>
      <text class="login-action-label">{{profileSaving ? "保存中" : "保存"}}</text>
      <text class="login-action-arrow" aria-hidden="true">›</text>
    </view>
    <view
      class="skip-profile-button support-action ui-block-action ui-pressable {{profileSaving ? 'is-disabled' : ''}}"
      aria-role="button"
      aria-disabled="{{profileSaving}}"
      bindtap="skipWeChatProfile"
      hover-class="ui-subtle-action-hover"
    >
      跳过
    </view>
  </view>
</view>
