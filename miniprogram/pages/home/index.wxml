<view class="ui-page-shell {{homePageClass}}">
  <view class="header">
    <view class="header-main">
      <view class="header-copy">
        <text class="hello">{{greetingText}}</text>
        <text class="subtitle">老余口述</text>
      </view>
      <button class="home-share-button" open-type="share" data-share-kind="home" hover-class="ui-accent-action-hover">
        分享给家人
      </button>
    </view>
  </view>

  <view wx:if="{{error}}" class="error ui-error-banner">{{error}}</view>

  <view wx:if="{{showLaunchPanel}}" class="launch-card">
    <view class="project-row">
      <text class="panel-label">{{launchEyebrow}}</text>
      <text class="mode-tag">{{launchModeTagText}}</text>
    </view>
    <text class="launch-title">{{launchTitle}}</text>
    <text class="launch-body">{{launchBody}}</text>
    <view
      class="{{voiceStartButtonClass}}"
      bindtap="startLaunchVoiceChat"
      hover-class="{{voiceStartButtonHoverClass}}"
      aria-role="button"
      aria-disabled="{{creatingVoice}}"
    >
      <view class="voice-start-icon-shell">
        <image class="voice-start-icon" src="/assets/memoir-microphone.png" mode="aspectFit" />
      </view>
      <view class="voice-start-copy">
        <text class="voice-start-title">{{launchVoiceButtonTitle}}</text>
      </view>
    </view>
    <button class="launch-secondary-button" bindtap="dismissLaunchPanel" hover-class="launch-secondary-button-hover">
      {{launchSecondaryText}}
    </button>
  </view>

  <view wx:else class="home-card">
    <view wx:if="{{showReturnPrompt}}" class="return-prompt">
      <view class="return-prompt-copy">
        <text class="return-prompt-title">好久不见，今天接着讲一段？</text>
        <text class="return-prompt-text">可以从上次停下的地方继续，也可以随便说点别的。</text>
      </view>
      <view class="return-prompt-close" bindtap="dismissReturnPrompt" hover-class="return-prompt-close-hover">×</view>
    </view>

    <view class="project-row">
      <text class="panel-label">{{panelLabelText}}</text>
      <text class="mode-tag">{{modeTagText}}</text>
    </view>
    <view
      wx:if="{{hasProject}}"
      class="active-project-link"
      bindtap="openProjects"
      hover-class="ui-subtle-action-hover"
      aria-role="button"
      aria-label="当前回忆录 {{projectHeadingText}}，点击切换"
    >
      <view class="active-project-copy">
        <text class="project-title">{{projectHeadingText}}</text>
        <text class="project-switch-hint">当前回忆录 · 点击切换</text>
      </view>
      <text class="project-switch-action">切换 ›</text>
    </view>
    <text wx:else class="project-title">{{projectHeadingText}}</text>
    <text class="project-meta">
      {{projectMetaText}}
    </text>
    <text wx:if="{{hasProject}}" class="resume-note">可以接着这里讲，也可以随便说点别的。</text>

    <view
      class="{{voiceStartButtonClass}}"
      bindtap="startPrimaryVoiceChat"
      hover-class="{{voiceStartButtonHoverClass}}"
      aria-role="button"
      aria-disabled="{{creatingVoice}}"
    >
      <view class="voice-start-icon-shell">
        <image class="voice-start-icon" src="/assets/memoir-microphone.png" mode="aspectFit" />
      </view>
      <view class="voice-start-copy">
        <text class="voice-start-title">
          {{primaryVoiceButtonTitle}}
        </text>
      </view>
    </view>
    <text class="voice-start-note">
      {{voiceStartNoteText}}
    </text>

    <view wx:if="{{showResumeActions}}" class="resume-actions">
      <view
        class="more-actions-toggle"
        bindtap="toggleMoreActions"
        hover-class="ui-subtle-action-hover"
        aria-role="button"
        aria-expanded="{{showMoreActions}}"
        aria-label="{{moreActionsToggleAriaLabel}}"
      >
        <text>{{moreActionsToggleText}}</text>
        <text class="more-actions-chevron">{{showMoreActions ? "⌃" : "⌄"}}</text>
      </view>
      <view wx:if="{{showMoreActions}}" class="more-actions-panel">
        <view
          class="{{resumeAskButtonClass}}"
          bindtap="startAlternateGuidance"
          hover-class="{{resumeAskButtonHoverClass}}"
          aria-role="button"
          aria-disabled="{{creatingVoice}}"
        >
          <text>{{alternateModeButtonTitle}}</text>
          <text class="resume-action-hint">换一种讲述方式</text>
        </view>
        <view
          class="{{resumeAskButtonClass}} topic-map"
          bindtap="openTopicMap"
          hover-class="{{resumeAskButtonHoverClass}}"
          aria-role="button"
          aria-disabled="{{creatingVoice}}"
        >
          <text>看看聊过的话题</text>
          <text class="resume-action-hint">回顾已经讲过的内容</text>
        </view>
        <view
          class="{{resumeAskButtonClass}} completion"
          bindtap="startBookCompletion"
          hover-class="{{resumeAskButtonHoverClass}}"
          aria-role="button"
          aria-disabled="{{creatingVoice}}"
        >
          <text>{{completionButtonTitle}}</text>
          <text class="resume-action-hint">查找全书还缺的内容</text>
        </view>
        <view
          class="{{resumeAskButtonClass}}"
          bindtap="startHumanInterview"
          hover-class="{{resumeAskButtonHoverClass}}"
          aria-role="button"
          aria-disabled="{{creatingVoice}}"
        >
          <text>人工访谈</text>
          <text class="resume-action-hint">由家人分别记录问与答</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{showVoiceAuthorizationPanel}}" class="voice-auth-panel">
    <checkbox-group bindchange="changeVoiceAuthorization">
      <label class="voice-auth-row">
        <checkbox
          value="voice_authorization"
          checked="{{voiceAuthorizationAgreed}}"
          color="#a84f43"
        />
        <view class="voice-auth-copy">
          <text>我已阅读并同意</text>
          <text class="voice-auth-link" catchtap="openVoiceAuthorization">《声纹授权协议》</text>
        </view>
      </label>
    </checkbox-group>
    <text class="voice-auth-hint">同意后才会打开麦克风，并上传语音用于实时识别文字、原始音频留存和成书。</text>
  </view>
</view>
