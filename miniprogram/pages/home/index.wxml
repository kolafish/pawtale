<view class="home-page">
  <view class="header">
    <text class="hello">你好，{{displayName || "作者"}}</text>
    <text class="subtitle">余主任留声机</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view class="project-panel">
    <view class="project-row">
      <text class="panel-label">当前回忆录</text>
      <text class="mode-tag">{{hasProject ? guidanceLabel : "待创建"}}</text>
    </view>
    <text class="project-title">{{projectTitle || "正在加载回忆录"}}</text>
    <text class="project-meta">
      {{hasProject ? "讲述方式由这本回忆录决定。" : "先创建一本回忆录。"}}
    </text>
    <button
      wx:if="{{!needsLogin && !hasProject}}"
      class="project-create-button"
      bindtap="createProject"
      disabled="{{loading}}"
    >
      创建第一本回忆录
    </button>
  </view>

  <view class="voice-panel">
    <view class="voice-head">
      <image class="voice-icon" src="/assets/memoir-microphone.png" mode="aspectFit" />
      <view class="voice-main">
        <text class="voice-title">开始讲述</text>
        <text class="voice-copy">
          {{needsLogin ? "登录后开始。" : (!hasProject ? "创建回忆录后开始。" : "AI 会先开场。")}}
        </text>
      </view>
    </view>
    <view wx:if="{{!needsLogin && hasProject}}" class="voice-mode-row">
      <text class="voice-mode-label">当前方式</text>
      <text class="voice-mode-value">{{guidanceLabel}}</text>
    </view>
    <view wx:if="{{!voiceAuthorizationAgreed}}" class="voice-auth-panel">
      <checkbox-group bindchange="changeVoiceAuthorization">
        <label class="voice-auth-row">
          <checkbox
            value="voice_authorization"
            checked="{{voiceAuthorizationAgreed}}"
            color="#9f4a3c"
          />
          <view class="voice-auth-copy">
            <text>我已阅读并同意</text>
            <text class="voice-auth-link" catchtap="openVoiceAuthorization">《声纹授权协议》</text>
          </view>
        </label>
      </checkbox-group>
      <text class="voice-auth-hint">同意后才会打开麦克风，并上传语音用于访谈转写、原始音频留存和成书。</text>
    </view>
    <button
      class="primary-button"
      loading="{{creatingVoice}}"
      disabled="{{loading || creatingVoice}}"
      bindtap="startVoiceChat"
    >
      <block wx:if="{{needsLogin}}">登录后开始语音聊天</block>
      <block wx:elif="{{!hasProject}}">先创建回忆录</block>
      <block wx:elif="{{creatingVoice}}">正在准备</block>
      <block wx:else>开始讲述</block>
    </button>
  </view>
</view>
