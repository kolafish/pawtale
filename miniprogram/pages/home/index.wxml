<import src="../../templates/share-likes.wxml" />
<view class="ui-page-shell {{homePageClass}}">
  <view class="header" hidden="{{voiceEntry}}">
    <view class="header-main">
      <view class="header-copy">
        <text class="hello">{{greetingText}}</text>
        <text wx:if="{{headerSubtitleText}}" class="header-subtitle">{{headerSubtitleText}}</text>
      </view>
      <view class="header-actions">
        <button id="home-settings" size="mini" class="home-header-button ui-button" bindtap="openSettings"
          aria-label="打开设置" hover-class="ui-subtle-action-hover">设置</button>
        <button size="mini" class="home-header-button ui-button" open-type="share" data-share-kind="home"
          aria-label="分享老余口述" hover-class="ui-accent-action-hover">分享</button>
      </view>
    </view>
  </view>

  <view wx:if="{{error}}" class="error ui-error-banner">{{error}}</view>

  <voice-session id="voice-session" wx:if="{{voiceEntry}}" entry="{{voiceEntry}}" embedded="{{true}}"
    bindexit="exitVoiceSession" />

  <view hidden="{{voiceEntry}}" class="home-content">
    <view wx:if="{{loading && !storyLoaded}}" class="story-loading">正在读取故事树…</view>
    <button wx:if="{{!storyLoaded && error}}" class="home-story-action ui-button" bindtap="refreshStory"
      loading="{{loading}}" disabled="{{loading}}">重新读取故事</button>

    <story-tree
      wx:if="{{storyLoaded || needsLogin}}"
      id="story-tree"
      story="{{story}}"
      demo-mode="{{needsLogin}}"
      large-text="{{largeTextEnabled}}"
      can-open-book="{{hasProject || (needsLogin && demoReadableChapterIds.length > 0)}}"
      can-switch-project="{{hasProject}}"
      profile-text="{{narratorProfileText}}"
      can-voice-edit="{{hasProject && (hasLastStoryHint || story.overview.hasChapters)}}"
      show-book-hint="{{showBookHint}}"
      bind:openbook="openBook"
      bind:openprojects="openProjects"
      bind:openprofile="openNarratorProfile"
      bind:openchapter="openChapter"
      bind:opentranscripts="openTranscripts"
      bind:voiceedit="openVoiceEdit"
    >
      <view slot="heroAction">
        <view wx:if="{{showNarrationChoiceCard}}" class="narration-choice-card">
          <view class="narration-choice-copy">
            <text class="narration-choice-kicker">上次说到：</text>
            <text class="narration-choice-text">{{lastStoryHint}}</text>
          </view>
          <view class="narration-choice-actions">
            <view
              id="resume-story-action"
              class="narration-choice-action narration-choice-primary ui-pressable {{voiceStartButtonClass}}"
              bindtap="resumeLastStory"
              hover-class="{{voiceStartButtonHoverClass}}"
              aria-role="button"
              aria-label="接着上次的内容继续讲"
              aria-disabled="{{loading || creatingVoice || voiceAuthorizationSaving}}"
            >
              <text>接着讲</text>
              <text class="narration-choice-arrow" aria-hidden="true">›</text>
            </view>
            <view
              id="primary-voice-action"
              class="narration-choice-action narration-choice-secondary ui-pressable {{voiceStartButtonClass}}"
              bindtap="startPrimaryVoiceChat"
              hover-class="{{voiceStartButtonHoverClass}}"
              aria-role="button"
              aria-label="讲一个新故事"
              aria-disabled="{{loading || creatingVoice || voiceAuthorizationSaving}}"
            >
              <text class="narration-choice-plus" aria-hidden="true">＋</text>
              <text>讲个新故事</text>
            </view>
          </view>
        </view>

        <view
          wx:else
          id="primary-voice-action"
          class="hero-voice-action {{voiceStartButtonClass}} {{needsLogin || !hasProject ? 'is-inviting' : ''}}"
          bindtap="startPrimaryVoiceChat"
          hover-class="{{voiceStartButtonHoverClass}}"
          aria-role="button"
          aria-disabled="{{loading || creatingVoice || voiceAuthorizationSaving}}"
        >
          <text class="hero-voice-label">{{primaryVoiceButtonTitle}}</text>
          <text class="hero-voice-arrow" aria-hidden="true">›</text>
        </view>
      </view>

      <view slot="afterHero" id="home-narration-end" class="after-hero">
        <view wx:if="{{notice}}" class="home-growth-notice" aria-live="polite">
          <template wx:if="{{notice.kind === 'like'}}" is="shareLikePeople" data="{{avatars: notice.people.avatars, text: notice.text}}" />
          <text wx:else class="home-growth-value ui-tabular">{{notice.text}}</text>
          <view class="home-growth-actions">
            <button wx:if="{{notice.kind === 'progress' && notice.action === 'retry'}}" size="mini" class="home-inline-action ui-button" bindtap="retryDraft"
              loading="{{retryingDraft}}" disabled="{{retryingDraft}}">继续整理 ›</button>
            <button wx:elif="{{notice.kind === 'progress' && notice.action === 'review'}}" size="mini"
              class="home-inline-action ui-button" bindtap="openReviewIssues">查看待确认 ›</button>
            <button wx:elif="{{notice.kind === 'progress' && notice.action === 'supplement'}}" size="mini"
              class="home-inline-action ui-button" bindtap="supplementPendingMaterial">补充讲述 ›</button>
            <button size="mini" class="home-inline-action is-secondary ui-button" bindtap="dismissNotice"
              loading="{{dismissingGrowth}}" disabled="{{dismissingGrowth}}">知道了</button>
          </view>
        </view>

        <view
          wx:if="{{!voiceEntry && ((shareCandidate && (shareCandidate.status === 'ready' || shareCandidate.status === 'accepted')) || shareVideoTotal || shareVideoActiveCount || shareVideoFailedCount || (hasProject && hasLastStoryHint))}}"
          class="home-share-candidate"
          aria-label="我的分享视频"
          bindtap="openShareCard"
          hover-class="{{shareCandidate && (shareCandidate.status === 'ready' || shareCandidate.status === 'accepted') ? 'none' : 'ui-subtle-action-hover'}}"
        >
          <view class="home-share-candidate-head">
            <text class="home-share-module-title">分享视频</text>
            <block wx:if="{{shareCandidate && (shareCandidate.status === 'ready' || shareCandidate.status === 'accepted')}}">
              <button wx:if="{{shareVideoTotal || shareVideoActiveCount || shareVideoFailedCount}}" class="home-share-all ui-button" bindtap="openShareVideoLibrary" hover-class="ui-subtle-action-hover">{{shareVideoActiveCount ? '制作中 ' + shareVideoActiveCount + ' 个' : shareVideoTotal ? '全部 ' + shareVideoTotal + ' 个' : '制作失败 ' + shareVideoFailedCount + ' 个'}} ›</button>
              <button wx:elif="{{shareCandidate.status === 'ready'}}" class="home-share-all ui-button" bindtap="pickShareVideoClip" hover-class="ui-subtle-action-hover">自己挑一段 ›</button>
            </block>
            <!-- Without a suggestion the whole card is one link, so the count is only a label. -->
            <text wx:else class="home-share-all">{{shareVideoActiveCount ? '制作中 ' + shareVideoActiveCount + ' 个' : shareVideoTotal ? '全部 ' + shareVideoTotal + ' 个' : shareVideoFailedCount ? '制作失败 ' + shareVideoFailedCount + ' 个' : '挑一段'}} ›</text>
          </view>
          <block wx:if="{{shareCandidate && (shareCandidate.status === 'ready' || shareCandidate.status === 'accepted')}}">
            <view class="home-share-candidate-content">
              <button class="home-share-thumbnail ui-button" bindtap="openShareCandidateVideo" disabled="{{!shareCandidate.video_job_id || shareCandidateDismissing}}" aria-label="预览分享视频" hover-class="ui-subtle-action-hover">
                <image wx:if="{{shareCandidateThumbnailPath}}" class="home-share-thumbnail-image" src="{{shareCandidateThumbnailPath}}" mode="aspectFill" />
                <view class="home-share-thumbnail-play" aria-hidden="true">▶</view>
              </button>
              <view class="home-share-candidate-heading">
                <text class="home-share-candidate-title">{{shareCandidate.status === 'ready' ? shareCandidate.selected_text : '《' + (shareCandidateJob ? shareCandidateJob.title : '讲述片段') + '》'}}</text>
                <text class="home-share-candidate-meta ui-tabular">{{shareCandidate.status === 'ready' ? '待制作' : (shareCandidateJob && shareCandidateJob.status === 'succeeded' ? '刚刚生成' : (shareCandidateJob && shareCandidateJob.status === 'failed' ? '制作未完成' : '制作中'))}}{{shareCandidateDurationText ? ' · ' + shareCandidateDurationText : ''}}</text>
              </view>
            </view>
            <text wx:if="{{shareCandidateError}}" class="home-share-candidate-error" aria-live="polite">{{shareCandidateError}}</text>
            <view class="home-share-candidate-actions">
              <button
                wx:if="{{shareCandidate.status === 'ready'}}"
                class="home-share-candidate-primary ui-button"
                bindtap="openShareCandidateEditor"
                disabled="{{shareCandidateDismissing}}"
                hover-class="ui-subtle-action-hover"
              >做成视频 ›</button>
              <button
                wx:elif="{{shareCandidate.video_job_id}}"
                class="home-share-candidate-primary ui-button"
                bindtap="openShareCandidateVideo"
                disabled="{{shareCandidateDismissing}}"
                hover-class="ui-subtle-action-hover"
              >{{shareCandidateJob && shareCandidateJob.status === 'failed' ? '查看详情 ›' : (shareCandidateJob && shareCandidateJob.status === 'succeeded' ? '预览视频 ›' : '查看进度 ›')}}</button>
              <button
                class="home-share-candidate-secondary ui-button"
                bindtap="dismissShareCandidate"
                loading="{{shareCandidateDismissing}}"
                disabled="{{shareCandidateDismissing}}"
                hover-class="ui-subtle-action-hover"
              >{{shareCandidate.status === 'ready' ? '先不做' : '稍后'}}</button>
            </view>
          </block>
          <view wx:else class="home-share-pick">
            <text class="home-share-pick-copy">{{shareVideoTotal || shareVideoActiveCount || shareVideoFailedCount ? '预览或转发做好的视频。' : '挑一段讲述，做成视频。'}}</text>
          </view>
        </view>

        <view id="home-voice-authorization" wx:if="{{showVoiceAuthorizationPanel}}" class="voice-auth-panel">
          <checkbox-group bindchange="changeVoiceAuthorization">
            <view class="voice-auth-row ui-consent-row">
              <label class="ui-consent-choice">
                <checkbox value="voice_authorization" checked="{{voiceAuthorizationAgreed}}" disabled="{{voiceAuthorizationSaving}}" color="#b65d49" />
                <text class="voice-auth-copy">我已阅读并同意</text>
              </label>
              <view class="voice-auth-link ui-consent-link ui-pressable" catchtap="openVoiceAuthorization"
                hover-class="ui-subtle-action-hover" aria-role="button" aria-label="查看语音采集与处理授权">《语音采集与处理授权》</view>
            </view>
          </checkbox-group>
          <text class="voice-auth-hint">同意后开启麦克风，上传语音用于识别、保存原音和整理故事。</text>
        </view>

      </view>
    </story-tree>

    <view wx:if="{{storyError}}" class="story-refresh-error ui-error-banner">{{storyError}}</view>
    <button wx:if="{{storyError}}" class="home-story-action ui-button" bindtap="refreshStory"
      loading="{{loading}}" disabled="{{loading}}">重新读取故事</button>


  </view>

  <view wx:if="{{showContinueNarration}}" class="continue-narration-bar">
    <button id="continue-narration" class="continue-narration-button ui-button" bindtap="continueNarration"
      loading="{{creatingVoice}}" disabled="{{creatingVoice || voiceAuthorizationSaving}}" hover-class="voice-start-button-hover">
      <text>{{primaryVoiceButtonTitle}}</text><text class="continue-narration-arrow" aria-hidden="true">›</text>
    </button>
  </view>
</view>
