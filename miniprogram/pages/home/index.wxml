<view class="home-page">
  <view class="home-header">
    <view class="avatar-mark">
      <image class="avatar-logo" src="/assets/memoir-gramophone.png" mode="aspectFit" />
    </view>
    <view class="header-copy">
      <text class="host-name">余主任留声机</text>
      <text class="host-note">让我听听你的故事</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view
    class="question-card {{questionCardDragging ? 'question-card-dragging' : ''}} {{questionCardLeaving ? 'question-card-leaving' : ''}} {{questionSwipeReady ? 'question-card-ready' : ''}}"
    style="transform: translateX({{questionCardTranslateX}}px) rotate({{questionCardRotate}}deg);"
    bindtouchstart="onQuestionTouchStart"
    bindtouchmove="onQuestionTouchMove"
    bindtouchend="onQuestionTouchEnd"
    bindtouchcancel="onQuestionTouchCancel"
  >
    <view class="card-label">
      <view class="label-dot"></view>
      <text>{{sessionTitle || "回忆录访谈"}}</text>
    </view>
    <text class="question-text">{{currentPrompt || "正在获取问题"}}</text>
    <view wx:if="{{currentQuestionTtsSourceKey}}" class="tts-actions">
      <button
        class="tts-button {{ttsSourceKey === currentQuestionTtsSourceKey && ttsPlaying ? 'active' : ''}}"
        disabled="{{ttsBusy}}"
        data-source-type="question"
        data-source-id="{{currentQuestionId}}"
        data-label="问题"
        catchtap="toggleTtsSource"
      >
        {{ttsSourceKey === currentQuestionTtsSourceKey && ttsPlaying ? "暂停朗读" : "朗读问题"}}
      </button>
      <button class="tts-speed-button" catchtap="cycleTtsSpeed">{{ttsSpeedLabel}}</button>
    </view>
    <text
      wx:if="{{ttsSourceKey === currentQuestionTtsSourceKey && (ttsMessage || ttsError)}}"
      class="tts-status {{ttsError ? 'tts-error' : ''}}"
    >
      {{ttsError || ttsMessage}}
    </text>
    <view wx:if="{{hasAnswerDraft}}" class="draft-state">
      <text class="draft-label">{{answerDraftLabel}}</text>
      <text wx:if="{{answerDraftPendingLabel}}" class="draft-pending">{{answerDraftPendingLabel}}</text>
    </view>

    <view
      class="primary-action {{loading || switchingQuestion ? 'primary-action-disabled' : ''}}"
      bindtap="continueInterview"
    >
      <image class="action-art-icon" src="/assets/memoir-microphone.png" mode="aspectFit" />
      <text class="primary-action-text">{{loading ? "加载中" : primaryActionText}}</text>
    </view>
  </view>

  <view class="weekly-card" bindtap="openStories" hover-class="tap-hover">
    <view class="clipboard-icon">
      <view class="clip-top"></view>
      <view class="clip-line"></view>
      <view class="clip-line short"></view>
    </view>
    <view class="weekly-copy">
      <text class="weekly-title">已整理 <text class="accent">{{hasDashboardData ? weeklyStoryCount : "..."}}</text> 个片段</text>
    </view>
    <text class="chevron">›</text>
  </view>

  <view class="progress-panel">
    <view class="progress-row" bindtap="openProjects" hover-class="tap-hover">
      <text>{{projectTitle || "我的回忆录"}}</text>
      <text wx:if="{{hasDashboardData}}">{{progressPercent}}%</text>
      <text wx:else>加载中</text>
    </view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{hasDashboardData ? progressPercent : 0}}%;"></view>
    </view>
    <view class="mini-stats">
      <view class="mini-stat">
        <text class="mini-value">{{hasDashboardData ? completedCount : "..."}}</text>
        <text class="mini-label">已回答</text>
      </view>
      <view class="mini-stat action-stat" bindtap="openPendingReview" hover-class="tap-hover">
        <text class="mini-value">{{hasDashboardData ? pendingReviewCount : "..."}}</text>
        <text class="mini-label">待确认</text>
      </view>
      <view class="mini-stat">
        <text class="mini-value">{{hasDashboardData ? confirmedStoryCount : "..."}}</text>
        <text class="mini-label">已确认</text>
      </view>
    </view>
  </view>

  <view class="latest-card" wx:if="{{latestOutputPreview}}">
    <text class="latest-label">最近整理</text>
    <text class="latest-text">{{latestOutputPreview}}</text>
    <view wx:if="{{latestOutputTtsSourceKey}}" class="tts-actions">
      <button
        class="tts-button {{ttsSourceKey === latestOutputTtsSourceKey && ttsPlaying ? 'active' : ''}}"
        disabled="{{ttsBusy}}"
        data-source-type="{{latestOutputTtsSourceType}}"
        data-source-id="{{latestOutputId}}"
        data-label="最近整理"
        catchtap="toggleTtsSource"
      >
        {{ttsSourceKey === latestOutputTtsSourceKey && ttsPlaying ? "暂停朗读" : "朗读整理"}}
      </button>
      <button class="tts-speed-button" catchtap="cycleTtsSpeed">{{ttsSpeedLabel}}</button>
    </view>
    <text
      wx:if="{{ttsSourceKey === latestOutputTtsSourceKey && (ttsMessage || ttsError)}}"
      class="tts-status {{ttsError ? 'tts-error' : ''}}"
    >
      {{ttsError || ttsMessage}}
    </text>
  </view>

  <view class="bottom-nav">
    <view class="bottom-nav-item active">
      <view class="nav-mark home-mark"></view>
      <text>首页</text>
    </view>
    <view class="bottom-nav-item" bindtap="openWorkbench">
      <view class="nav-mark grid-mark"></view>
      <text>工作台</text>
    </view>
    <view class="bottom-nav-item" bindtap="openQa">
      <view class="nav-mark chat-mark"></view>
      <text>问答</text>
    </view>
    <view class="bottom-nav-item" bindtap="openProfile">
      <view class="nav-mark user-mark"></view>
      <text>我的</text>
    </view>
  </view>
</view>
