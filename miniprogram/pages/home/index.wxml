<import src="../../templates/share-likes.wxml" />
<view class="ui-page-shell {{homePageClass}}">
  <view class="header" hidden="{{voiceEntry}}">
    <view class="header-main">
      <text class="hello">{{greetingText}}</text>
      <view class="header-actions">
        <button id="home-settings" size="mini" class="home-header-button ui-button" bindtap="openSettings"
          aria-label="打开设置" hover-class="ui-subtle-action-hover">设置</button>
        <button size="mini" class="home-header-button ui-button" open-type="share" data-share-kind="home"
          aria-label="分享老余口述" hover-class="ui-accent-action-hover">分享</button>
      </view>
    </view>
  </view>

  <view wx:if="{{error}}" class="error ui-error-banner">{{error}}</view>

  <voice-session id="voice-session" wx:if="{{voiceEntry}}" entry="{{voiceEntry}}" embedded="{{true}}"
    bindexit="exitVoiceSession" />

  <view hidden="{{voiceEntry}}" class="home-content">
    <view class="home-voice-card" id="home-voice">
      <image class="home-card-background" src="/assets/home/narration-background.png" mode="aspectFill" aria-hidden="true" />
      <view class="voice-card-copy">
        <text class="voice-card-title">聊两句</text>
        <text class="voice-card-subtitle">AI 陪您慢慢聊</text>
        <view
          id="primary-voice-action"
          class="voice-start-button ui-pressable {{voiceStartButtonClass}}"
          bindtap="resumeLastStory"
          hover-class="{{voiceStartButtonHoverClass}}"
          aria-role="button"
          aria-label="开始讲述"
          aria-disabled="{{loading || creatingVoice || voiceAuthorizationSaving}}"
        >
          <image class="voice-start-icon" src="/assets/memoir-microphone.png" mode="aspectFit" aria-hidden="true" />
          <text>{{primaryVoiceButtonTitle}}</text>
          <text class="voice-start-arrow" aria-hidden="true">›</text>
        </view>
      </view>
    </view>

    <view id="home-voice-authorization" wx:if="{{showVoiceAuthorizationPanel}}" class="voice-auth-panel">
      <checkbox-group bindchange="changeVoiceAuthorization">
        <view class="voice-auth-row ui-consent-row">
          <label class="ui-consent-choice">
            <checkbox value="voice_authorization" checked="{{voiceAuthorizationAgreed}}" disabled="{{voiceAuthorizationSaving}}" color="#b65d49" />
            <text class="voice-auth-copy">我已阅读并同意</text>
          </label>
          <view class="voice-auth-link ui-consent-link ui-pressable" catchtap="openVoiceAuthorization"
            hover-class="ui-subtle-action-hover" aria-role="button" aria-label="查看语音采集与处理授权">《语音采集与处理授权》</view>
        </view>
      </checkbox-group>
      <text class="voice-auth-hint">同意后开启麦克风，上传语音用于识别、保存原音和整理故事。</text>
    </view>

    <view wx:if="{{storyLoaded}}" id="home-memoir" class="home-memoir-card ui-pressable"
      bindtap="openBook" hover-class="home-memoir-card-hover" aria-role="button" aria-label="翻开我的书">
      <image class="home-card-background" src="/assets/home/memoir-background.png" mode="aspectFill" aria-hidden="true" />
      <view class="memoir-cover-caption" aria-hidden="true">
        <text class="memoir-cover-title">{{story.memoir.title}}</text>
      </view>
      <view class="memoir-card-copy">
        <text class="memoir-card-kicker">我的回忆录</text>
        <text class="memoir-card-title">{{story.memoir.title}}</text>
        <view class="memoir-card-rule"></view>
        <text class="memoir-card-progress ui-tabular">{{story.memoir.bookProgressText}}</text>
        <view class="memoir-open-action">
          <text>翻开我的书</text>
          <text class="memoir-open-arrow" aria-hidden="true">›</text>
        </view>
      </view>
    </view>
    <view wx:elif="{{loading}}" class="memoir-loading-card" aria-live="polite">正在整理您的回忆录…</view>

    <view wx:if="{{storyError}}" class="story-refresh-error ui-error-banner">{{storyError}}</view>
    <button wx:if="{{storyError || (!storyLoaded && error)}}" class="home-story-action ui-button" bindtap="refreshStory"
      loading="{{loading}}" disabled="{{loading}}">重新读取</button>

    <view wx:if="{{notice}}" class="home-growth-notice" aria-live="polite">
      <template wx:if="{{notice.kind === 'like'}}" is="shareLikePeople" data="{{avatars: notice.people.avatars, text: notice.text}}" />
      <text wx:else class="home-growth-value ui-tabular">{{notice.text}}</text>
      <view class="home-growth-actions">
        <button wx:if="{{notice.kind === 'progress' && notice.action === 'retry'}}" size="mini" class="home-inline-action ui-button" bindtap="retryDraft"
          loading="{{retryingDraft}}" disabled="{{retryingDraft}}">继续整理 ›</button>
        <button wx:elif="{{notice.kind === 'progress' && notice.action === 'review'}}" size="mini"
          class="home-inline-action ui-button" bindtap="openReviewIssues">查看待确认 ›</button>
        <button size="mini" class="home-inline-action is-secondary ui-button" bindtap="dismissNotice"
          loading="{{dismissingGrowth}}" disabled="{{dismissingGrowth}}">知道了</button>
      </view>
    </view>

    <view wx:if="{{storyLoaded || needsLogin}}" class="home-utilities" aria-label="更多功能">
      <view
        wx:if="{{shareCandidate || shareVideoTotal || shareVideoActiveCount || shareVideoFailedCount}}"
        class="home-share-candidate ui-pressable"
        aria-label="分享视频"
        aria-role="button"
        bindtap="openShareCard"
        hover-class="ui-subtle-action-hover"
      >
        <view class="home-utility-icon home-utility-video" aria-hidden="true">▶</view>
        <view class="home-utility-copy">
          <text class="home-utility-title">分享视频</text>
        </view>
        <button wx:if="{{shareCandidate && shareCandidate.status === 'ready'}}" class="home-utility-action ui-button" catchtap="openShareCandidateEditor" disabled="{{shareCandidateDismissing}}">制作</button>
        <button wx:elif="{{shareCandidate && shareCandidate.status === 'accepted' && shareCandidate.video_job_id}}" class="home-utility-action ui-button" catchtap="openShareCandidateVideo" disabled="{{shareCandidateDismissing}}">查看</button>
        <text class="home-utility-arrow" aria-hidden="true">›</text>
      </view>
      <view wx:else class="home-utility-row ui-pressable" bindtap="openShareCard" hover-class="ui-subtle-action-hover"
        aria-role="button" aria-label="分享视频">
        <view class="home-utility-icon home-utility-video" aria-hidden="true">▶</view>
        <view class="home-utility-copy"><text class="home-utility-title">分享视频</text></view>
        <text class="home-utility-arrow" aria-hidden="true">›</text>
      </view>
      <view class="home-utility-row ui-pressable" bindtap="openTranscripts" hover-class="ui-subtle-action-hover"
        aria-role="button" aria-label="查看全部回忆">
        <view class="home-utility-icon home-utility-memories" aria-hidden="true">▤</view>
        <view class="home-utility-copy"><text class="home-utility-title">全部回忆</text></view>
        <text class="home-utility-arrow" aria-hidden="true">›</text>
      </view>
      <view class="home-utility-row ui-pressable" bindtap="openVoiceEdit" hover-class="ui-subtle-action-hover"
        aria-role="button" aria-label="语音编辑">
        <view class="home-utility-icon home-utility-edit" aria-hidden="true"><text class="home-utility-edit-bar-one"></text><text class="home-utility-edit-bar-two"></text><text class="home-utility-edit-bar-three"></text></view>
        <view class="home-utility-copy"><text class="home-utility-title">语音编辑</text></view>
        <text class="home-utility-arrow" aria-hidden="true">›</text>
      </view>
    </view>
  </view>
</view>
