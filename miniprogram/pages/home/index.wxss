.home-page {
  max-width: 980rpx;
  margin: 0 auto;
  padding: 22rpx 30rpx calc(92px + env(safe-area-inset-bottom));
}

.header {
  margin-bottom: 20rpx;
}

.header-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.header-copy {
  min-width: 0;
  flex: 1;
}

.hello,
.header-subtitle {
  display: block;
}

.hello {
  overflow: hidden;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-subtitle {
  margin-top: 5rpx;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 1.5;
  text-wrap: pretty;
}

.header-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 2rpx;
}

.header-actions .home-header-button {
  width: auto;
  min-width: 44px;
  min-height: 44px;
  padding: 0 10rpx;
  border-radius: 16rpx;
  color: var(--ui-text-secondary);
  background: transparent;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1;
}

.home-content {
  display: block;
}

.error {
  margin-bottom: 20rpx;
  box-shadow: 0 0 0 1rpx rgba(182, 69, 69, 0.08);
}

.story-loading {
  padding: 30rpx 20rpx;
  color: var(--ui-text-secondary);
  font-size: 28rpx;
  text-align: center;
}

.hero-voice-action {
  box-sizing: border-box;
  width: 100%;
  min-height: 48px;
  margin-top: 22rpx;
  padding: 8rpx 10rpx 8rpx 30rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  color: var(--ui-text-primary);
  background: rgba(255, 253, 250, 0.72);
  box-shadow:
    0 0 0 2rpx rgba(182, 93, 73, 0.23) inset,
    0 6rpx 16rpx rgba(63, 47, 37, 0.035);
  transition-property: transform, background-color, box-shadow, opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.hero-voice-action.button-blocked {
  opacity: 0.66;
}

.hero-voice-label {
  min-width: 0;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
  text-align: center;
}

.hero-voice-arrow,
.continue-narration-arrow {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  border-radius: 50%;
  background: var(--ui-accent);
  color: var(--ui-on-accent);
  font-size: 42rpx;
  font-weight: 400;
  line-height: 60rpx;
  text-align: center;
  transform: translateX(1rpx);
}

.voice-start-button-hover {
  background: var(--ui-accent-surface-subtle);
  transform: scale(0.96);
  box-shadow:
    0 0 0 2rpx var(--ui-accent-border) inset,
    0 5rpx 14rpx rgba(63, 47, 37, 0.04);
}

.after-hero {
  display: block;
}

.home-saved-notice {
  display: block;
  margin: 16rpx 8rpx -4rpx;
  color: var(--ui-success-text);
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.5;
  text-align: center;
}

.resume-card {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  display: grid;
  grid-template-columns: 58rpx minmax(0, 1fr);
  gap: 8rpx 16rpx;
  background: rgba(255, 253, 250, 0.92);
}

.resume-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-accent-strong);
  background: var(--ui-accent-surface-subtle);
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.resume-copy {
  min-width: 0;
}

.resume-title,
.resume-text {
  display: block;
}

.resume-title {
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
}

.resume-text {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 4rpx;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 1.5;
  text-wrap: pretty;
}

.resume-actions {
  grid-column: 2;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.resume-primary-action {
  min-height: 44px;
  padding: 0 14rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  font-size: 25rpx;
  font-weight: 700;
}

.resume-primary-action {
  color: var(--ui-accent-strong);
}

.voice-auth-panel,
.home-growth-notice {
  margin-top: 20rpx;
  border-radius: 26rpx;
  background: var(--ui-accent-surface-subtle);
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.045),
    0 8rpx 20rpx rgba(0, 0, 0, 0.04);
}

.voice-auth-panel {
  padding: 22rpx 24rpx;
}

.voice-auth-copy,
.voice-auth-link {
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.45;
}

.voice-auth-hint {
  display: block;
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 1.5;
  text-wrap: pretty;
}

.home-growth-notice {
  padding: 20rpx;
  display: grid;
  grid-template-columns: 52rpx minmax(0, 1fr);
  align-items: center;
  gap: 8rpx 14rpx;
}

.home-growth-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ui-success-surface);
}

.home-growth-image {
  width: 46rpx;
  height: 46rpx;
}

.home-growth-copy,
.home-review-copy {
  min-width: 0;
  flex: 1;
}

.home-growth-title,
.home-growth-detail,
.home-story-progress-title,
.home-story-progress-detail,
.home-review-text {
  display: block;
}

.home-growth-title,
.home-story-progress-title {
  color: var(--ui-text-primary);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.45;
}

.home-growth-detail,
.home-story-progress-detail,
.home-review-text {
  margin-top: 3rpx;
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
  text-wrap: pretty;
}

.home-growth-actions {
  grid-column: 2;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.home-inline-action {
  width: auto;
  min-height: 44px;
  padding: 0 12rpx;
  border-radius: 14rpx;
  color: var(--ui-accent-strong);
  background: transparent;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.home-inline-action.is-secondary {
  color: var(--ui-text-secondary);
  font-weight: 600;
}

.story-refresh-error,
.home-review-notice,
.home-story-progress {
  margin-top: 18rpx;
}

.home-review-notice,
.home-story-progress {
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(250, 247, 242, 0.86);
  box-shadow: var(--ui-control-shadow);
}

.home-story-progress.is-error {
  background: var(--ui-danger-surface);
}

.home-story-action {
  width: 100%;
  min-height: 88rpx;
  margin-top: 12rpx;
  border-radius: 20rpx;
  color: var(--ui-accent-strong);
  background: var(--ui-accent-surface);
  box-shadow: var(--ui-control-shadow);
  font-size: 27rpx;
  font-weight: 700;
}

.continue-narration-bar {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: calc(12px + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.continue-narration-bar .continue-narration-button {
  width: auto;
  max-width: calc(100% - 48rpx);
  min-width: 300rpx;
  min-height: 48px;
  padding: 8rpx 10rpx 8rpx 28rpx;
  border-radius: 26rpx;
  color: var(--ui-text-primary);
  background: rgba(255, 253, 250, 0.96);
  box-shadow: var(--ui-card-shadow-raised);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.5;
  pointer-events: auto;
  gap: 22rpx;
}

.home-page.large-text {
  padding: 26rpx 30rpx calc(108px + env(safe-area-inset-bottom));
}

.large-text .hello { font-size: 44rpx; }
.large-text .header-subtitle { font-size: 31rpx; }
.large-text .home-header-button { font-size: 31rpx; }
.large-text .hero-voice-action { min-height: 56px; }
.large-text .hero-voice-label { font-size: 37rpx; }
.large-text .resume-title { font-size: 36rpx; }
.large-text .resume-text,
.large-text .resume-primary-action,
.large-text .voice-auth-hint,
.large-text .home-growth-detail,
.large-text .home-story-progress-detail,
.large-text .home-review-text { font-size: 31rpx; }
.large-text .voice-auth-copy,
.large-text .voice-auth-link,
.large-text .home-growth-title,
.large-text .home-story-progress-title { font-size: 34rpx; }
.large-text .home-inline-action { font-size: 30rpx; }
.large-text .continue-narration-button { min-height: 56px; font-size: 36rpx; }

@media (max-width: 360px) {
  .home-page { padding-right: 24rpx; padding-left: 24rpx; }
  .header-main { align-items: flex-start; }
  .resume-card { grid-template-columns: 52rpx minmax(0, 1fr); padding: 20rpx; }
  .resume-actions { grid-column: 1 / span 2; }
  .home-growth-actions { grid-column: 1 / span 2; padding-left: 66rpx; }
}
