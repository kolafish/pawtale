@import "../../templates/share-likes.wxss";

.home-page {
  max-width: 980rpx;
  margin: 0 auto;
  padding: 24rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));
}

.header {
  margin-bottom: 26rpx;
}

.header-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.hello {
  min-width: 0;
  overflow: hidden;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.home-header-button {
  box-sizing: border-box;
  min-width: 40px;
  min-height: 40px;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: var(--ui-text-secondary);
  background: rgba(255, 253, 250, 0.66);
  box-shadow: 0 0 0 1rpx rgba(54, 42, 34, 0.06) inset;
  font-size: var(--ui-font-meta);
  font-weight: 650;
  line-height: 1;
}

.home-content {
  display: block;
}

.error {
  margin-bottom: 20rpx;
  box-shadow: 0 0 0 1rpx rgba(182, 69, 69, 0.08);
}

.home-voice-card,
.home-memoir-card {
  position: relative;
  overflow: hidden;
  border-radius: 34rpx;
  box-shadow:
    0 0 0 1rpx rgba(54, 42, 34, 0.045),
    0 10rpx 24rpx rgba(63, 47, 37, 0.045),
    0 24rpx 52rpx rgba(63, 47, 37, 0.04);
}

.home-voice-card {
  box-sizing: border-box;
  min-height: 390rpx;
  padding: 42rpx 32rpx 34rpx;
  display: flex;
  align-items: stretch;
  background: #fbf5ed;
}

.home-card-background {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.home-voice-card .home-card-background {
  transform: translate(-2%, -1%) scale(0.94);
}

.home-memoir-card .home-card-background {
  transform: translate(3%, 3%) scale(0.94);
  transform-origin: right bottom;
}

.home-voice-card::before,
.home-memoir-card::before {
  content: "";
  position: absolute;
  z-index: 1;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background:
    linear-gradient(0deg, #fbf5ed, rgba(251, 245, 237, 0) 18%, rgba(251, 245, 237, 0) 82%, #fbf5ed),
    linear-gradient(90deg, #fbf5ed, rgba(251, 245, 237, 0) 12%, rgba(251, 245, 237, 0) 85%, #fbf5ed);
  pointer-events: none;
}

.voice-card-copy {
  position: relative;
  z-index: 2;
  width: 58%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.voice-card-title,
.voice-card-subtitle,
.memoir-card-kicker,
.memoir-card-title,
.memoir-card-progress,
.home-utility-title {
  display: block;
}

.voice-card-title {
  color: var(--ui-accent-strong);
  font-family: var(--ui-font-editorial);
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1.2;
  text-wrap: balance;
}

.voice-card-subtitle {
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: 33rpx;
  line-height: 1.45;
  text-wrap: pretty;
}

.voice-start-button {
  box-sizing: border-box;
  width: 100%;
  min-height: 80rpx;
  margin-top: auto;
  padding: 8rpx 16rpx 8rpx 20rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: var(--ui-on-accent);
  background: var(--ui-accent);
  box-shadow: 0 12rpx 26rpx rgba(148, 69, 53, 0.2);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
  transition-property: transform, background-color, box-shadow, opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.voice-start-button.button-blocked {
  opacity: 0.64;
}

.voice-start-icon {
  width: 38rpx;
  height: 38rpx;
  flex: 0 0 38rpx;
  filter: brightness(0) invert(1);
}

.voice-start-arrow {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  border-radius: 50%;
  color: var(--ui-on-accent);
  background: rgba(255, 255, 255, 0.2);
  font-size: 36rpx;
  font-weight: 400;
  line-height: 43rpx;
  text-align: center;
}

.voice-auth-panel {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: var(--ui-accent-surface-subtle);
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.045),
    0 8rpx 20rpx rgba(0, 0, 0, 0.04);
}

.voice-auth-copy,
.voice-auth-link {
  font-size: var(--ui-font-body);
  font-weight: 650;
  line-height: var(--ui-line-body);
}

.voice-auth-hint {
  display: block;
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  line-height: 1.5;
  text-wrap: pretty;
}

.home-memoir-card {
  min-height: 360rpx;
  margin-top: 24rpx;
  padding: 38rpx 32rpx 30rpx;
  display: flex;
  background: #fbf5ed;
  transition-property: transform, opacity, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.home-memoir-card-hover {
  opacity: 0.94;
  transform: scale(0.985);
}

.memoir-card-copy {
  position: relative;
  z-index: 2;
  width: 58%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.memoir-cover-caption {
  position: absolute;
  z-index: 1;
  top: 42%;
  left: 70%;
  width: 21%;
  color: #8b7563;
  font-family: var(--ui-font-editorial);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.25;
  text-align: center;
  transform: rotate(9deg) skewX(-23deg);
  pointer-events: none;
}

.memoir-switch-action {
  position: absolute;
  z-index: 3;
  top: 12rpx;
  right: 16rpx;
  min-height: 40px;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  color: var(--ui-text-secondary);
  background: rgba(255, 253, 250, 0.8);
  font-size: 26rpx;
  line-height: 1.3;
}

.memoir-cover-title {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-break: break-all;
}

.memoir-card-kicker {
  letter-spacing: 1rpx;
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}

.memoir-card-title {
  max-width: 100%;
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.memoir-card-rule {
  width: 68rpx;
  height: 5rpx;
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: #d89d4f;
}

.memoir-card-progress {
  margin-top: 18rpx;
  color: var(--ui-text-secondary);
  font-size: 29rpx;
  font-weight: 500;
  line-height: 1.45;
  font-variant-numeric: tabular-nums;
  text-wrap: pretty;
}

.memoir-open-action {
  box-sizing: border-box;
  min-height: 72rpx;
  margin-top: auto;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--ui-accent-strong);
  background: rgba(255, 253, 250, 0.84);
  box-shadow:
    0 0 0 1rpx rgba(148, 69, 53, 0.14),
    0 6rpx 14rpx rgba(63, 47, 37, 0.06);
  font-size: 32rpx;
  font-weight: 750;
  line-height: 1.3;
}

.memoir-open-arrow {
  margin-left: 4rpx;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 1;
}

.memoir-loading-card {
  box-sizing: border-box;
  min-height: 156rpx;
  margin-top: 24rpx;
  padding: 48rpx 30rpx;
  border-radius: 28rpx;
  color: var(--ui-text-secondary);
  background: rgba(255, 253, 250, 0.72);
  box-shadow: var(--ui-card-shadow);
  font-size: var(--ui-font-body);
  text-align: center;
}

.home-growth-notice {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 253, 250, 0.86);
  box-shadow:
    0 0 0 1rpx rgba(54, 42, 34, 0.04),
    0 6rpx 16rpx rgba(63, 47, 37, 0.035);
}

.home-growth-value {
  display: block;
  color: var(--ui-accent-strong);
  font-family: var(--ui-font-editorial);
  font-size: 33rpx;
  font-weight: 800;
  line-height: 1.35;
  font-variant-numeric: tabular-nums;
  text-wrap: balance;
}

.home-growth-actions {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.home-inline-action {
  width: auto;
  min-height: 44px;
  padding: 0 24rpx;
  border-radius: var(--ui-radius-control);
  color: var(--ui-accent-strong);
  background: var(--ui-surface);
  box-shadow: 0 0 0 2rpx var(--ui-accent-border) inset;
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 1.4;
}

.home-inline-action.is-secondary {
  padding: 0 14rpx;
  color: var(--ui-text-secondary);
  background: transparent;
  box-shadow: none;
  font-weight: 600;
}

.home-utilities {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}

.home-utility-row,
.home-share-candidate {
  box-sizing: border-box;
  min-height: 40px;
  padding: 10rpx 16rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--ui-text-primary);
  background: rgba(255, 253, 250, 0.54);
  box-shadow: 0 0 0 1rpx rgba(54, 42, 34, 0.025);
}

.home-utility-row:first-child,
.home-share-candidate {
  grid-column: 1 / -1;
}

.home-utility-icon {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-accent-strong);
  background: #fbefe9;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
}

.home-utility-memories {
  color: #73816a;
  background: #f2f4ee;
  font-size: 35rpx;
  font-weight: 500;
}

.home-utility-edit {
  gap: 6rpx;
  align-items: center;
  background: #fff6e7;
}

.home-utility-edit-bar-one,
.home-utility-edit-bar-two,
.home-utility-edit-bar-three {
  display: block;
  width: 7rpx;
  border-radius: 999rpx;
  background: #c89d59;
}

.home-utility-edit-bar-one { height: 20rpx; }
.home-utility-edit-bar-two { height: 34rpx; }
.home-utility-edit-bar-three { height: 26rpx; }

.home-utility-copy {
  min-width: 0;
  flex: 1;
}

.home-utility-title {
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.35;
}

.home-utility-arrow {
  flex: 0 0 auto;
  color: var(--ui-text-secondary);
  opacity: 0.55;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 1;
}

.home-utility-action {
  flex: 0 0 auto;
  min-height: 44px;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: var(--ui-accent-strong);
  background: var(--ui-accent-surface-subtle);
  font-size: var(--ui-font-caption);
  font-weight: 700;
  line-height: 1.3;
}

.story-refresh-error {
  margin-top: 18rpx;
}

.home-story-action {
  width: 100%;
  min-height: 80rpx;
  margin-top: 12rpx;
  border-radius: 20rpx;
  color: var(--ui-accent-strong);
  background: var(--ui-accent-surface);
  box-shadow: var(--ui-control-shadow);
  font-size: var(--ui-font-action);
  font-weight: 700;
}

.large-text .hello { font-size: 56rpx; }
.large-text .home-header-button { font-size: var(--ui-font-large-body); }
.large-text .voice-card-title { font-size: 64rpx; }
.large-text .voice-card-subtitle { font-size: var(--ui-font-large-body); }
.large-text .voice-start-button { min-height: 92rpx; font-size: 37rpx; }
.large-text .memoir-card-kicker { font-size: var(--ui-font-large-meta); }
.large-text .memoir-card-title { font-size: 55rpx; }
.large-text .memoir-card-progress { font-size: var(--ui-font-large-body); }
.large-text .memoir-open-action { font-size: var(--ui-font-large-body); }
.large-text .home-utility-title { font-size: var(--ui-font-large-body); }

@media (max-width: 360px) {
  .home-page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .hello {
    font-size: 45rpx;
  }

  .home-header-button {
    padding-right: 18rpx;
    padding-left: 18rpx;
  }

  .home-voice-card,
  .home-memoir-card {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .voice-card-copy,
  .memoir-card-copy {
    width: 62%;
  }

  .voice-start-button {
    font-size: 30rpx;
  }

  .home-utility-row:nth-child(n + 2) {
    gap: 10rpx;
    padding-right: 12rpx;
    padding-left: 12rpx;
  }
}
