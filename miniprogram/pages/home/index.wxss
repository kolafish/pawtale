.home-page {
  min-height: 100vh;
  padding: 52rpx 32rpx 120rpx;
  background: #fcf7ed;
}

.header {
  margin-bottom: 30rpx;
}

.hello {
  display: block;
  color: #2b1713;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 52rpx;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  color: #7b6f68;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.home-card,
.launch-card {
  border: 1rpx solid #e8d8c3;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(93, 61, 42, 0.06);
  padding: 32rpx;
}

.launch-title {
  display: block;
  margin-top: 18rpx;
  color: #2b1713;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 58rpx;
}

.launch-body {
  display: block;
  margin-top: 20rpx;
  color: #3a2a25;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 52rpx;
}

.launch-secondary-button {
  width: 72%;
  min-height: 88rpx;
  margin: 18rpx auto 0;
  border: 0;
  border-radius: 999rpx;
  background: #f3efea;
  color: #5c4b43;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.launch-secondary-button::after {
  border: 0;
}

.launch-secondary-button-hover {
  background: #ebe3da;
}

.return-prompt {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-bottom: 28rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #fff9f3;
  border: 1rpx solid #ead8c5;
}

.return-prompt-copy {
  flex: 1;
  min-width: 0;
}

.return-prompt-title {
  display: block;
  color: #2b1713;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.return-prompt-text {
  display: block;
  margin-top: 8rpx;
  color: #7b6f68;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.return-prompt-close {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f3efea;
  color: #7b6f68;
  font-size: 32rpx;
  line-height: 40rpx;
  text-align: center;
}

.project-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.panel-label {
  color: #7b6f68;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.mode-tag {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f3efea;
  color: #7a6b60;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.project-title {
  display: block;
  margin-top: 14rpx;
  color: #2b1713;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 52rpx;
}

.project-meta {
  display: block;
  margin-top: 18rpx;
  color: #3a2a25;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 50rpx;
}

.resume-note {
  display: block;
  margin-top: 12rpx;
  color: #7b6f68;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.voice-start-button {
  width: 92%;
  min-height: 112rpx;
  margin: 42rpx auto 0;
  border: 0;
  border-radius: 999rpx;
  background: #a64b3e;
  box-shadow: 0 12rpx 28rpx rgba(166, 75, 62, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 22rpx 34rpx;
  text-align: center;
}

.voice-start-button::after {
  border: 0;
}

.voice-start-button.button-blocked {
  background: #a64b3e;
  color: #ffffff;
  opacity: 0.72;
}

.voice-start-button.button-blocked.voice-start-button-hover {
  background: #a64b3e;
}

.voice-start-button-hover {
  background: #8f3e35;
}

.voice-start-icon {
  flex: 0 0 auto;
  width: 58rpx;
  height: 58rpx;
  display: block;
}

.voice-start-title {
  display: block;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 46rpx;
}

.voice-start-note {
  display: block;
  margin-top: 18rpx;
  color: #7b6f68;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 38rpx;
  text-align: center;
}

.resume-actions {
  margin-top: 18rpx;
}

.resume-ask-button {
  width: 92%;
  min-height: 96rpx;
  margin: 0 auto;
  border: 1rpx solid #d8c8bb;
  border-radius: 999rpx;
  background: #ffffff;
  color: #5c4b43;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.resume-ask-button::after {
  border: 0;
}

.resume-ask-button.button-blocked {
  opacity: 0.72;
}

.resume-ask-button-hover {
  background: #fff9f3;
}

.voice-auth-panel {
  margin-top: 32rpx;
  padding: 22rpx;
  border: 1rpx solid #e8d8c3;
  border-radius: 20rpx;
  background: #fff9f3;
}

.voice-auth-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.voice-auth-copy {
  flex: 1;
  min-width: 0;
  color: #3a2a25;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
}

.voice-auth-link {
  color: #a64b3e;
}

.voice-auth-hint {
  display: block;
  margin-top: 14rpx;
  color: #7b6f68;
  font-size: 25rpx;
  line-height: 1.45;
}

.error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff1f3;
  color: #b84a5a;
  font-size: 26rpx;
  line-height: 1.45;
}
