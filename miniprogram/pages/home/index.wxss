.home-page {
  max-width: 980rpx;
  margin: 0 auto;
  padding: 24rpx 32rpx calc(88px + env(safe-area-inset-bottom));
}

.header-actions {
  flex: 0 0 auto;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.header-actions .home-settings-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  flex: 0 0 auto;
  min-width: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0 10rpx;
  border-radius: 16rpx;
  color: var(--ui-text-secondary);
  background: transparent;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 500;
}

.home-story {
  margin-top: 24rpx;
}

.story-refresh-error,
.story-loading,
.home-story-progress,
.home-growth-notice {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: var(--ui-accent-surface-subtle);
}

.story-loading {
  color: var(--ui-text-secondary);
  font-size: 28rpx;
  padding: 20rpx;
}

.home-story-progress {
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: var(--ui-surface-subtle);
}

.home-story-progress-title,
.home-story-progress-detail {
  display: block;
  line-height: 1.5;
}

.home-story-progress-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ui-text-primary);
}

.home-story-progress-detail {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--ui-text-secondary);
  white-space: pre-line;
}

.home-story-action {
  min-height: 88rpx;
  padding: 0 20rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: var(--ui-accent-strong);
  background: var(--ui-accent-surface);
  box-shadow: var(--ui-control-shadow);
}

.home-growth-notice {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--ui-accent-surface-subtle);
  box-shadow:
    0 0 0 1rpx rgba(88, 112, 82, 0.06),
    0 6rpx 18rpx rgba(77, 60, 48, 0.035);
}

.home-growth-icon {
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ui-success-surface);
  box-shadow: 0 0 0 1rpx rgba(88, 112, 82, 0.08);
}

.home-growth-image { width: 48rpx; height: 48rpx; }

.home-growth-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.home-growth-text { min-width: 0; flex: 1; }

.large-text .home-story-progress-title {
  font-size: 36rpx;
}

.large-text .home-story-progress-detail,
.large-text .home-story-action,
.large-text .home-settings-button {
  font-size: 30rpx;
}

.header {
  margin-bottom: 12rpx;
}

.header-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.header-copy {
  min-width: 0;
  flex: 1;
}

.hello {
  display: block;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.5;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.header-actions .home-share-button {
  width: auto;
  flex: 0 0 auto;
  min-width: 44px;
  min-height: 44px;
  margin: 0;
  border: 0;
  border-radius: 16rpx;
  background: transparent;
  color: var(--ui-text-secondary);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  transition: transform 150ms ease-out, background-color 150ms ease-out;
}

.home-share-button::after {
  border: 0;
}

.home-card,
.launch-card {
  border: 0;
  border-radius: var(--ui-radius-card);
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow);
  padding: 26rpx;
}

.memory-quote-card {
  position: relative;
  min-height: 212rpx;
  margin-bottom: 22rpx;
  padding: 34rpx 30rpx;
  border-radius: var(--ui-radius-card);
  overflow: hidden;
  background: linear-gradient(135deg, #f7e8d7, #f8efe5 58%, #eee8de);
  box-shadow: var(--ui-card-shadow);
}

.memory-quote {
  position: relative;
  z-index: 1;
  display: block;
  width: 62%;
  color: #68483d;
  font-family: var(--ui-font-editorial);
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.75;
  letter-spacing: 0.08em;
  text-wrap: balance;
}

.memory-quote text { display: block; }

.memory-landscape {
  position: absolute;
  z-index: 0;
  right: -12rpx;
  bottom: -2rpx;
  width: 500rpx;
  height: 168rpx;
  opacity: 0.9;
}

.launch-title {
  display: block;
  margin-top: 18rpx;
  color: var(--ui-text-primary);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 62rpx;
}

.launch-body {
  display: block;
  margin-top: 20rpx;
  color: var(--ui-text-primary);
  font-size: 34rpx;
  font-weight: 400;
  line-height: 58rpx;
}

.launch-secondary-button {
  width: 100%;
  min-height: 88rpx;
  margin: 12rpx 0 0;
  border: 0;
  border-radius: var(--ui-radius-control);
  background: transparent;
  color: var(--ui-text-secondary);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition-property: transform, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.launch-secondary-button::after {
  border: 0;
}

.launch-secondary-button-hover {
  background: var(--ui-surface-subtle);
  transform: scale(0.96);
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.07);
}

.return-prompt {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-bottom: 28rpx;
  padding: 22rpx 22rpx 22rpx 24rpx;
  border-radius: 20rpx;
  background: var(--ui-accent-surface-subtle);
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.05),
    0 8rpx 18rpx rgba(0, 0, 0, 0.05);
}

.return-prompt-copy {
  flex: 1;
  min-width: 0;
}

.return-prompt-title {
  display: block;
  color: var(--ui-text-primary);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.return-prompt-text {
  display: block;
  margin-top: 8rpx;
  color: var(--ui-text-secondary);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.return-prompt-close {
  flex: 0 0 auto;
  width: 84rpx;
  height: 84rpx;
  margin-top: -14rpx;
  margin-right: -14rpx;
  border-radius: 50%;
  background: var(--ui-surface-subtle);
  color: var(--ui-text-secondary);
  font-size: 32rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition-property: transform, background-color;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.return-prompt-close-hover {
  background: var(--ui-divider);
  transform: scale(0.96);
}

.project-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.panel-label {
  color: var(--ui-text-secondary);
  font-size: 30rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.mode-tag {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--ui-surface-subtle);
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 36rpx;
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.04);
}

.project-title {
  display: block;
  margin-top: 16rpx;
  color: var(--ui-text-primary);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 52rpx;
}

.active-project-link {
  min-height: 88rpx;
  margin: 0 -18rpx;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  transition-property: transform, background-color;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.active-project-copy {
  flex: 1;
  min-width: 0;
}

.active-project-link .project-title {
  margin-top: 0;
}

.project-switch-action {
  flex: 0 0 auto;
  color: var(--ui-accent);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.project-meta {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--ui-text-primary);
  font-size: 34rpx;
  line-height: 1.6;
}

.voice-start-button {
  box-sizing: border-box;
  width: 100%;
  min-height: 112rpx;
  margin: 16rpx auto 0;
  border: 0;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-soft);
  box-shadow: var(--ui-control-shadow);
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  padding: 16rpx 16rpx 16rpx 20rpx;
  text-align: left;
  transition-property: transform, background-color, box-shadow, opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.voice-start-button.button-blocked {
  opacity: 0.72;
}

.voice-start-button-hover {
  background: var(--ui-accent-surface-subtle);
  transform: scale(0.96);
  box-shadow: 0 0 0 1rpx var(--ui-accent-border), 0 5rpx 14rpx rgba(63, 47, 37, 0.04);
}

.voice-start-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  text-align: left;
}

.voice-start-title {
  display: block;
  max-width: 100%;
  overflow: hidden;
  color: var(--ui-text-primary);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-align: left;
  white-space: nowrap;
  word-break: keep-all;
}

.voice-start-subtitle {
  display: block;
  margin-top: 2rpx;
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: left;
  text-wrap: pretty;
}

.voice-start-arrow,
.continue-narration-arrow {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  border-radius: 50%;
  background: var(--ui-accent);
  color: var(--ui-on-accent);
  font-size: 42rpx;
  font-weight: 400;
  line-height: 60rpx;
  text-align: center;
  transform: translateX(1rpx);
}

.current-guidance { display: block; margin-top: 28rpx; color: var(--ui-text-primary); font-size: 28rpx; font-weight: 600; line-height: 42rpx; }
.current-guidance + .voice-start-button { margin-top: 14rpx; }
.resume-actions { margin-top: 8rpx; }
.more-actions-toggle { box-sizing: border-box; width: 100%; min-height: 44px; border-radius: 16rpx; color: var(--ui-text-secondary); font-size: 28rpx; line-height: 1.5; display: flex; align-items: center; justify-content: space-between; padding: 0 8rpx; transition: transform 150ms ease-out, background-color 150ms ease-out; }
.more-actions-chevron { color: var(--ui-accent); font-size: 34rpx; font-weight: 700; line-height: 44rpx; }
.more-actions-panel { margin-top: 10rpx; padding-top: 18rpx; border-top: 1rpx solid var(--ui-divider); }
.home-page.large-text .current-guidance { font-size: 32rpx; line-height: 48rpx; }
.home-page.large-text .current-guidance + .voice-start-button { margin-top: 18rpx; }
.home-page.large-text .more-actions-toggle { font-size: 32rpx; }
.home-page.large-text .more-actions-chevron { font-size: 44rpx; line-height: 60rpx; }

.home-workspace-link {
  min-height: 44px;
  padding: 20rpx 8rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  transition-property: transform, background-color;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.home-workspace-copy {
  min-width: 0;
  flex: 1;
}

.home-workspace-title,
.home-workspace-hint {
  display: block;
}

.home-workspace-title {
  color: var(--ui-text-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.home-workspace-hint {
  margin-top: 4rpx;
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  line-height: 36rpx;
}

.home-workspace-arrow {
  flex: 0 0 auto;
  color: var(--ui-text-muted);
  font-size: 36rpx;
  font-weight: 700;
}

.home-workspace-link.button-blocked {
  opacity: 0.72;
}

.voice-auth-panel {
  margin-top: 32rpx;
  padding: 24rpx;
  border: 0;
  border-radius: 24rpx;
  background: var(--ui-accent-surface-subtle);
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.05),
    0 8rpx 20rpx rgba(0, 0, 0, 0.05);
}

.voice-auth-copy {
  min-width: 0;
  color: var(--ui-text-primary);
}

.voice-auth-copy,
.voice-auth-link {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
}

.voice-auth-hint {
  display: block;
  margin-top: 14rpx;
  color: var(--ui-text-secondary);
  font-size: 28rpx;
  line-height: 1.45;
}

.error {
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 0 0 1rpx rgba(182, 69, 69, 0.08);
}

.home-page.large-text {
  padding: 28rpx 32rpx calc(180rpx + env(safe-area-inset-bottom));
}

.home-page.large-text .header {
  margin-bottom: 16rpx;
}

.home-page.large-text .header-main {
  align-items: center;
  gap: 16rpx;
}

.home-page.large-text .hello {
  font-size: 40rpx;
  line-height: 1.5;
}

.home-page.large-text .home-share-button {
  font-size: 32rpx;
}

.home-page.large-text .home-card,
.home-page.large-text .launch-card {
  padding: 28rpx;
  border-radius: var(--ui-radius-card);
}

.home-page.large-text .memory-quote-card { min-height: 244rpx; padding: 36rpx 30rpx; }
.home-page.large-text .memory-quote { width: 68%; font-size: 38rpx; line-height: 1.7; }
.home-page.large-text .memory-landscape { width: 540rpx; height: 180rpx; }

.home-page.large-text .panel-label {
  font-size: 38rpx;
  line-height: 54rpx;
}

.home-page.large-text .mode-tag {
  padding: 10rpx 18rpx;
  font-size: 32rpx;
  line-height: 46rpx;
}

.home-page.large-text .launch-title,
.home-page.large-text .project-title {
  margin-top: 18rpx;
  font-size: 52rpx;
  line-height: 68rpx;
}

.home-page.large-text .active-project-link .project-title {
  margin-top: 0;
}

.home-page.large-text .project-switch-action {
  font-size: 28rpx;
  line-height: 1.45;
}

.home-page.large-text .launch-body,
.home-page.large-text .project-meta {
  margin-top: 22rpx;
  font-size: 40rpx;
  line-height: 60rpx;
}

.home-page.large-text .voice-start-subtitle,
.home-page.large-text .home-workspace-title {
  font-size: 32rpx;
  line-height: 48rpx;
}

.home-page.large-text .home-workspace-hint {
  font-size: 32rpx;
  line-height: 48rpx;
}

.home-page.large-text .voice-start-button {
  width: 100%;
  min-height: 128rpx;
  margin-top: 26rpx;
  padding: 20rpx;
  gap: 20rpx;
}

.home-page.large-text .voice-start-copy {
  flex: 1;
}

.home-page.large-text .voice-start-title {
  font-size: 42rpx;
  line-height: 58rpx;
}

.home-page.large-text .voice-start-arrow { width: 76rpx; height: 76rpx; flex-basis: 76rpx; font-size: 50rpx; line-height: 72rpx; }

.home-page.large-text .launch-secondary-button {
  min-height: 124rpx;
  padding: 0 34rpx;
  font-size: 40rpx;
  line-height: 60rpx;
}

.home-page.large-text .return-prompt-title {
  font-size: 40rpx;
  line-height: 60rpx;
}

.home-page.large-text .return-prompt-text,
.home-page.large-text .voice-auth-copy,
.home-page.large-text .voice-auth-link {
  font-size: 36rpx;
  line-height: 56rpx;
}

.home-page.large-text .voice-auth-hint,
.home-page.large-text .error {
  font-size: 34rpx;
  line-height: 52rpx;
}

.home-saved-notice {
  display: block;
  margin: 0 8rpx 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--ui-text-secondary);
}

.home-growth-actions { display: flex; flex-wrap: wrap; gap: 8rpx; margin-left: auto; }
.home-growth-dismiss { background: transparent; box-shadow: none; }

.continue-narration-bar {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: calc(12px + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.continue-narration-bar .continue-narration-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  max-width: calc(100% - 48rpx);
  min-width: 300rpx;
  min-height: 48px;
  margin: 0;
  padding: 8rpx 10rpx 8rpx 28rpx;
  border-radius: var(--ui-radius-card);
  color: var(--ui-text-primary);
  background: rgba(255, 253, 250, 0.96);
  box-shadow: var(--ui-card-shadow-raised);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.5;
  pointer-events: auto;
  gap: 24rpx;
  transition-property: transform, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.continue-narration-button .continue-narration-arrow { width: 64rpx; height: 64rpx; flex-basis: 64rpx; }
.large-text .continue-narration-button { min-height: 56px; font-size: 36rpx; }
.large-text .continue-narration-button .continue-narration-arrow { width: 72rpx; height: 72rpx; flex-basis: 72rpx; line-height: 68rpx; }
.large-text .home-saved-notice { font-size: 34rpx; }

.home-review-notice {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 4rpx 20rpx;
  border-radius: 18rpx;
  background: var(--ui-accent-surface-subtle);
}
.home-review-notice-footer { margin: 24rpx 0 0; }
.home-review-copy { flex: 1; min-width: 0; }
.home-review-text { display: block; color: var(--ui-text-secondary); font-size: 28rpx; line-height: 1.5; }
.home-page .home-inline-action {
  display: flex;
  align-items: center;
  width: auto;
  min-height: 44px;
  padding: 0 12rpx;
  margin: 0;
  flex: 0 0 auto;
  background: transparent;
  color: var(--ui-accent-strong);
  font-size: 28rpx;
  line-height: 1.5;
}
.home-story-progress.is-error { background: var(--ui-danger-surface); }
.home-growth-notice { flex-wrap: wrap; }
.home-growth-copy { flex-basis: 320rpx; }
.home-growth-notice .home-story-progress-title { font-size: 28rpx; }
.home-growth-notice .home-story-progress-detail { overflow-wrap: anywhere; text-wrap: pretty; }
.home-growth-dismiss { color: var(--ui-text-secondary); }

.home-page.large-text .home-growth-icon {
  width: 62rpx;
  height: 62rpx;
  flex-basis: 62rpx;
}

.home-page.large-text .home-growth-image { width: 58rpx; height: 58rpx; }

.large-text .home-review-text,
.home-page.large-text .home-inline-action { font-size: 32rpx; }
.home-page.is-narrating {
  padding-bottom: calc(360rpx + env(safe-area-inset-bottom));
}

.home-page.large-text.is-narrating { padding-bottom: calc(430rpx + env(safe-area-inset-bottom)); }
