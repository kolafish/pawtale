.home-page {
  min-height: 100vh;
  padding: 52rpx 30rpx 128rpx;
  background: var(--ui-page-background);
}

.header {
  margin-bottom: 34rpx;
}

.header-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.header-copy {
  min-width: 0;
  flex: 1;
}

.hello {
  display: block;
  color: var(--ui-text-primary);
  font-size: 46rpx;
  font-weight: 700;
  line-height: 60rpx;
  word-break: break-word;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  color: var(--ui-text-secondary);
  font-size: 30rpx;
  font-weight: 400;
  line-height: 44rpx;
  word-break: break-word;
}

.home-share-button {
  flex: 0 0 auto;
  min-width: 168rpx;
  height: 72rpx;
  margin: 4rpx 0 0;
  border: 0;
  border-radius: 999rpx;
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  white-space: nowrap;
  box-shadow:
    0 0 0 1rpx rgba(168, 79, 67, 0.16),
    0 6rpx 14rpx rgba(0, 0, 0, 0.06);
  transition-property: transform, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.home-share-button::after {
  border: 0;
}

.home-share-button-hover {
  background: var(--ui-accent-surface-subtle);
  transform: scale(0.96);
  box-shadow:
    0 0 0 1rpx rgba(168, 79, 67, 0.20),
    0 4rpx 10rpx rgba(0, 0, 0, 0.05);
}

.home-card,
.launch-card {
  border: 0;
  border-radius: 36rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow-raised);
  padding: 36rpx;
}

.launch-title {
  display: block;
  margin-top: 18rpx;
  color: var(--ui-text-primary);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 62rpx;
}

.launch-body {
  display: block;
  margin-top: 20rpx;
  color: var(--ui-text-primary);
  font-size: 34rpx;
  font-weight: 400;
  line-height: 58rpx;
}

.launch-secondary-button {
  width: 72%;
  min-height: 88rpx;
  margin: 18rpx auto 0;
  border: 0;
  border-radius: 999rpx;
  background: var(--ui-surface-subtle);
  color: var(--ui-value-text);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition-property: transform, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.launch-secondary-button::after {
  border: 0;
}

.launch-secondary-button-hover {
  background: var(--ui-divider);
  transform: scale(0.96);
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.07);
}

.return-prompt {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-bottom: 28rpx;
  padding: 22rpx 22rpx 22rpx 24rpx;
  border-radius: 20rpx;
  background: var(--ui-accent-surface-subtle);
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.05),
    0 8rpx 18rpx rgba(0, 0, 0, 0.05);
}

.return-prompt-copy {
  flex: 1;
  min-width: 0;
}

.return-prompt-title {
  display: block;
  color: var(--ui-text-primary);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.return-prompt-text {
  display: block;
  margin-top: 8rpx;
  color: var(--ui-text-secondary);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.return-prompt-close {
  flex: 0 0 auto;
  width: 84rpx;
  height: 84rpx;
  margin-top: -14rpx;
  margin-right: -14rpx;
  border-radius: 50%;
  background: var(--ui-surface-subtle);
  color: var(--ui-text-secondary);
  font-size: 32rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition-property: transform, background-color;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.return-prompt-close-hover {
  background: var(--ui-divider);
  transform: scale(0.96);
}

.project-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.panel-label {
  color: var(--ui-text-secondary);
  font-size: 30rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.mode-tag {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--ui-surface-subtle);
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 36rpx;
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.04);
}

.project-title {
  display: block;
  margin-top: 16rpx;
  color: var(--ui-text-primary);
  font-size: 46rpx;
  font-weight: 700;
  line-height: 60rpx;
}

.active-project-link {
  min-height: 88rpx;
  margin: 8rpx -18rpx 0;
  padding: 14rpx 18rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  transition-property: transform, background-color;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.active-project-link-hover {
  background: var(--ui-surface-subtle);
  transform: scale(0.96);
}

.active-project-copy {
  flex: 1;
  min-width: 0;
}

.active-project-link .project-title {
  margin-top: 0;
}

.project-switch-hint {
  display: block;
  margin-top: 6rpx;
  color: var(--ui-text-secondary);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 34rpx;
}

.project-switch-action {
  flex: 0 0 auto;
  color: var(--ui-accent);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.project-meta {
  display: block;
  margin-top: 18rpx;
  color: var(--ui-text-primary);
  font-size: 34rpx;
  font-weight: 400;
  line-height: 56rpx;
}

.resume-note {
  display: block;
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: 30rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.voice-start-button {
  box-sizing: border-box;
  width: 100%;
  min-height: 112rpx;
  margin: 38rpx auto 0;
  border: 0;
  border-radius: 999rpx;
  background: var(--ui-accent);
  box-shadow:
    0 0 0 1rpx rgba(255, 255, 255, 0.18) inset,
    0 10rpx 18rpx -8rpx rgba(143, 64, 55, 0.36),
    0 20rpx 38rpx rgba(168, 79, 67, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  text-align: center;
  transition-property: transform, background-color, box-shadow, opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.voice-start-button::after {
  border: 0;
}

.voice-start-button.button-blocked {
  background: var(--ui-accent);
  color: var(--ui-on-accent);
  opacity: 0.72;
}

.voice-start-button-hover {
  background: var(--ui-accent-strong);
  transform: scale(0.96);
  box-shadow:
    0 0 0 1rpx rgba(255, 255, 255, 0.14) inset,
    0 8rpx 14rpx -8rpx rgba(143, 64, 55, 0.36),
    0 14rpx 28rpx rgba(168, 79, 67, 0.18);
}

.voice-start-icon-shell {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.voice-start-icon {
  flex: 0 0 auto;
  width: 48rpx;
  height: 48rpx;
  display: block;
  transform: translateY(-1rpx) scale(1.35);
}

.voice-start-copy {
  flex: 0 1 auto;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.voice-start-title {
  display: block;
  max-width: 100%;
  overflow: hidden;
  color: var(--ui-on-accent);
  font-size: 38rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
  white-space: nowrap;
  word-break: keep-all;
}

.voice-start-note {
  display: block;
  margin-top: 18rpx;
  color: var(--ui-text-secondary);
  font-size: 30rpx;
  font-weight: 400;
  line-height: 44rpx;
  text-align: center;
}

.resume-actions {
  margin-top: 22rpx;
}

.more-actions-toggle {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  border: 0;
  border-radius: 20rpx;
  background: transparent;
  color: var(--ui-text-secondary);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  transition-property: transform, background-color;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.more-actions-toggle::after {
  border: 0;
}

.more-actions-toggle-hover {
  background: var(--ui-surface-subtle);
  transform: scale(0.96);
}

.more-actions-chevron {
  flex: 0 0 auto;
  color: var(--ui-accent);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.more-actions-panel {
  width: 100%;
  margin-top: 10rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--ui-divider);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.resume-ask-button {
  box-sizing: border-box;
  width: 100%;
  max-width: none;
  align-self: stretch;
  min-height: 92rpx;
  margin: 0;
  border: 0;
  border-radius: 22rpx;
  background: var(--ui-surface);
  color: var(--ui-value-text);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  padding: 16rpx 24rpx;
  text-align: center;
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.08),
    0 4rpx 10rpx rgba(0, 0, 0, 0.05);
  transition-property: transform, background-color, box-shadow, opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.resume-ask-button > text {
  display: block;
  width: 100%;
  text-align: center;
  text-wrap: balance;
}

.resume-ask-button::after {
  border: 0;
}

.resume-ask-button.button-blocked {
  opacity: 0.72;
}

.resume-ask-button-hover {
  background: var(--ui-accent-surface-subtle);
  transform: scale(0.96);
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.10),
    0 4rpx 10rpx rgba(0, 0, 0, 0.05);
}

.resume-ask-button.completion {
  background: var(--ui-accent-surface-subtle);
  color: var(--ui-accent-strong);
  box-shadow:
    0 0 0 1rpx rgba(168, 79, 67, 0.16),
    0 6rpx 14rpx rgba(0, 0, 0, 0.06);
}

.resume-ask-button.topic-map {
  background: var(--ui-success-surface);
  color: var(--ui-success-text);
  box-shadow:
    0 0 0 1rpx rgba(94, 119, 88, 0.14),
    0 6rpx 14rpx rgba(0, 0, 0, 0.06);
}

.resume-action-hint {
  color: var(--ui-text-secondary);
  font-size: 25rpx;
  font-weight: 400;
  line-height: 36rpx;
  text-wrap: pretty;
}

.voice-auth-panel {
  margin-top: 32rpx;
  padding: 24rpx;
  border: 0;
  border-radius: 24rpx;
  background: var(--ui-accent-surface-subtle);
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.05),
    0 8rpx 20rpx rgba(0, 0, 0, 0.05);
}

.voice-auth-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.voice-auth-copy {
  flex: 1;
  min-width: 0;
  color: var(--ui-text-primary);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
}

.voice-auth-link {
  color: var(--ui-accent);
}

.voice-auth-hint {
  display: block;
  margin-top: 14rpx;
  color: var(--ui-text-secondary);
  font-size: 28rpx;
  line-height: 1.45;
}

.error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
  font-size: 28rpx;
  line-height: 1.45;
  box-shadow: 0 0 0 1rpx rgba(182, 69, 69, 0.08);
}

.home-page.large-text {
  padding: 42rpx 24rpx 136rpx;
}

.home-page.large-text .header {
  margin-bottom: 30rpx;
}

.home-page.large-text .header-main {
  align-items: flex-start;
  gap: 18rpx;
}

.home-page.large-text .hello {
  font-size: 60rpx;
  line-height: 76rpx;
}

.home-page.large-text .subtitle {
  font-size: 38rpx;
  line-height: 54rpx;
}

.home-page.large-text .home-share-button {
  min-width: 204rpx;
  height: 88rpx;
  padding: 0 28rpx;
  font-size: 32rpx;
}

.home-page.large-text .home-card,
.home-page.large-text .launch-card {
  padding: 34rpx 30rpx;
  border-radius: 36rpx;
}

.home-page.large-text .panel-label {
  font-size: 38rpx;
  line-height: 54rpx;
}

.home-page.large-text .mode-tag {
  padding: 10rpx 18rpx;
  font-size: 32rpx;
  line-height: 46rpx;
}

.home-page.large-text .launch-title,
.home-page.large-text .project-title {
  margin-top: 18rpx;
  font-size: 68rpx;
  line-height: 86rpx;
}

.home-page.large-text .active-project-link .project-title {
  margin-top: 0;
}

.home-page.large-text .project-switch-hint,
.home-page.large-text .project-switch-action {
  font-size: 28rpx;
  line-height: 1.45;
}

.home-page.large-text .launch-body,
.home-page.large-text .project-meta {
  margin-top: 22rpx;
  font-size: 48rpx;
  line-height: 70rpx;
}

.home-page.large-text .resume-note,
.home-page.large-text .voice-start-note {
  font-size: 38rpx;
  line-height: 56rpx;
}

.home-page.large-text .voice-start-button {
  width: 100%;
  min-height: 156rpx;
  margin-top: 36rpx;
  padding: 26rpx 32rpx;
  gap: 20rpx;
}

.home-page.large-text .voice-start-icon-shell {
  width: 94rpx;
  height: 94rpx;
}

.home-page.large-text .voice-start-icon {
  width: 64rpx;
  height: 64rpx;
}

.home-page.large-text .voice-start-copy {
  flex: 0 1 auto;
}

.home-page.large-text .voice-start-title {
  font-size: 54rpx;
  line-height: 66rpx;
}

.home-page.large-text .resume-ask-button,
.home-page.large-text .more-actions-toggle,
.home-page.large-text .launch-secondary-button {
  min-height: 124rpx;
  padding: 0 34rpx;
  font-size: 40rpx;
  line-height: 60rpx;
}

.home-page.large-text .resume-ask-button {
  align-items: center;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}

.home-page.large-text .resume-action-hint {
  font-size: 32rpx;
  line-height: 48rpx;
}

.home-page.large-text .more-actions-chevron {
  font-size: 44rpx;
  line-height: 60rpx;
}

.home-page.large-text .return-prompt-title {
  font-size: 40rpx;
  line-height: 60rpx;
}

.home-page.large-text .return-prompt-text,
.home-page.large-text .voice-auth-copy {
  font-size: 36rpx;
  line-height: 56rpx;
}

.home-page.large-text .voice-auth-hint,
.home-page.large-text .error {
  font-size: 34rpx;
  line-height: 52rpx;
}
