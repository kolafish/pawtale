.home-page {
  min-height: 100vh;
  padding: 52rpx 30rpx 128rpx;
  background: #f8f2e8;
}

.header {
  margin-bottom: 34rpx;
}

.hello {
  display: block;
  color: #2b1713;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 60rpx;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  color: #7b6f68;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.home-card,
.launch-card {
  border: 0;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.06),
    0 6rpx 14rpx -6rpx rgba(43, 23, 19, 0.12),
    0 28rpx 64rpx rgba(93, 61, 42, 0.11);
  padding: 36rpx;
}

.launch-title {
  display: block;
  margin-top: 18rpx;
  color: #2b1713;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 62rpx;
}

.launch-body {
  display: block;
  margin-top: 20rpx;
  color: #3a2a25;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 58rpx;
}

.launch-secondary-button {
  width: 72%;
  min-height: 88rpx;
  margin: 18rpx auto 0;
  border: 0;
  border-radius: 999rpx;
  background: #f3efea;
  color: #5c4b43;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition-property: transform, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.launch-secondary-button::after {
  border: 0;
}

.launch-secondary-button-hover {
  background: #ebe3da;
  transform: scale(0.96);
  box-shadow: 0 0 0 1rpx rgba(43, 23, 19, 0.07);
}

.return-prompt {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-bottom: 28rpx;
  padding: 22rpx 22rpx 22rpx 24rpx;
  border-radius: 20rpx;
  background: #fff9f3;
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.05),
    0 8rpx 18rpx rgba(93, 61, 42, 0.05);
}

.return-prompt-copy {
  flex: 1;
  min-width: 0;
}

.return-prompt-title {
  display: block;
  color: #2b1713;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.return-prompt-text {
  display: block;
  margin-top: 8rpx;
  color: #7b6f68;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.return-prompt-close {
  flex: 0 0 auto;
  width: 84rpx;
  height: 84rpx;
  margin-top: -14rpx;
  margin-right: -14rpx;
  border-radius: 50%;
  background: #f3efea;
  color: #7b6f68;
  font-size: 32rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition-property: transform, background-color;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.return-prompt-close-hover {
  background: #ebe3da;
  transform: scale(0.96);
}

.project-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.panel-label {
  color: #7b6f68;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.mode-tag {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f5eee7;
  color: #7a6b60;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 36rpx;
  box-shadow: 0 0 0 1rpx rgba(43, 23, 19, 0.04);
}

.project-title {
  display: block;
  margin-top: 16rpx;
  color: #2b1713;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 60rpx;
}

.project-meta {
  display: block;
  margin-top: 18rpx;
  color: #3a2a25;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 56rpx;
}

.resume-note {
  display: block;
  margin-top: 12rpx;
  color: #7b6f68;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.voice-start-button {
  width: 100%;
  min-height: 112rpx;
  margin: 38rpx auto 0;
  border: 0;
  border-radius: 999rpx;
  background: #a64b3e;
  box-shadow:
    0 0 0 1rpx rgba(255, 255, 255, 0.18) inset,
    0 10rpx 18rpx -8rpx rgba(104, 35, 27, 0.36),
    0 20rpx 38rpx rgba(166, 75, 62, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  text-align: center;
  transition-property: transform, background-color, box-shadow, opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.voice-start-button::after {
  border: 0;
}

.voice-start-button.button-blocked {
  background: #a64b3e;
  color: #ffffff;
  opacity: 0.72;
}

.voice-start-button-hover {
  background: #8f3e35;
  transform: scale(0.96);
  box-shadow:
    0 0 0 1rpx rgba(255, 255, 255, 0.14) inset,
    0 8rpx 14rpx -8rpx rgba(104, 35, 27, 0.36),
    0 14rpx 28rpx rgba(166, 75, 62, 0.18);
}

.voice-start-icon-shell {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.voice-start-icon {
  flex: 0 0 auto;
  width: 48rpx;
  height: 48rpx;
  display: block;
  transform: translateY(-1rpx);
}

.voice-start-copy {
  min-width: 0;
  display: flex;
  align-items: center;
}

.voice-start-title {
  display: block;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.voice-start-note {
  display: block;
  margin-top: 18rpx;
  color: #7b6f68;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 44rpx;
  text-align: center;
}

.resume-actions {
  margin-top: 18rpx;
}

.resume-ask-button {
  width: 92%;
  min-height: 96rpx;
  margin: 0 auto;
  border: 0;
  border-radius: 999rpx;
  background: #ffffff;
  color: #5c4b43;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.08),
    0 6rpx 14rpx rgba(93, 61, 42, 0.06);
  transition-property: transform, background-color, box-shadow, opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.resume-ask-button::after {
  border: 0;
}

.resume-ask-button.button-blocked {
  opacity: 0.72;
}

.resume-ask-button-hover {
  background: #fff9f3;
  transform: scale(0.96);
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.10),
    0 4rpx 10rpx rgba(93, 61, 42, 0.05);
}

.voice-auth-panel {
  margin-top: 32rpx;
  padding: 24rpx;
  border: 0;
  border-radius: 24rpx;
  background: #fff9f3;
  box-shadow:
    0 0 0 1rpx rgba(43, 23, 19, 0.05),
    0 8rpx 20rpx rgba(93, 61, 42, 0.05);
}

.voice-auth-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.voice-auth-copy {
  flex: 1;
  min-width: 0;
  color: #3a2a25;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
}

.voice-auth-link {
  color: #a64b3e;
}

.voice-auth-hint {
  display: block;
  margin-top: 14rpx;
  color: #7b6f68;
  font-size: 28rpx;
  line-height: 1.45;
}

.error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  background: #fff1f3;
  color: #b84a5a;
  font-size: 28rpx;
  line-height: 1.45;
  box-shadow: 0 0 0 1rpx rgba(184, 74, 90, 0.08);
}
