.home-page {
  min-height: 100vh;
  padding: 52rpx 32rpx 120rpx;
  background: #fcf7ed;
}

.header {
  margin-bottom: 30rpx;
}

.hello {
  display: block;
  color: #2b1713;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 52rpx;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  color: #7b6f68;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.home-card {
  border: 1rpx solid #e8d8c3;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(93, 61, 42, 0.06);
  padding: 32rpx;
}

.project-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.panel-label {
  color: #7b6f68;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.mode-tag {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f3efea;
  color: #7a6b60;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.project-title {
  display: block;
  margin-top: 14rpx;
  color: #2b1713;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 52rpx;
}

.project-meta {
  display: block;
  margin-top: 18rpx;
  color: #3a2a25;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 50rpx;
}

.voice-start-button {
  width: 100%;
  min-height: 148rpx;
  margin: 46rpx 0 0;
  border: 0;
  border-radius: 24rpx;
  background: #a64b3e;
  box-shadow: 0 12rpx 28rpx rgba(166, 75, 62, 0.16);
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 24rpx;
  padding: 24rpx 30rpx;
  text-align: left;
}

.voice-start-button::after {
  border: 0;
}

.voice-start-button[disabled] {
  opacity: 0.72;
}

.voice-start-button-hover {
  background: #8f3e35;
}

.voice-start-icon {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  display: block;
}

.voice-start-copy {
  flex: 1;
  min-width: 0;
}

.voice-start-title {
  display: block;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 46rpx;
}

.voice-start-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #fff3ef;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 38rpx;
}

.voice-auth-panel {
  margin-top: 32rpx;
  padding: 22rpx;
  border: 1rpx solid #e8d8c3;
  border-radius: 20rpx;
  background: #fff9f3;
}

.voice-auth-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.voice-auth-copy {
  flex: 1;
  min-width: 0;
  color: #3a2a25;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
}

.voice-auth-link {
  color: #a64b3e;
}

.voice-auth-hint {
  display: block;
  margin-top: 14rpx;
  color: #7b6f68;
  font-size: 25rpx;
  line-height: 1.45;
}

.error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff1f3;
  color: #b84a5a;
  font-size: 26rpx;
  line-height: 1.45;
}
