.home-page {
  max-width: 980rpx;
  margin: 0 auto;
  padding: 22rpx 30rpx calc(92px + env(safe-area-inset-bottom));
}

.header {
  margin-bottom: 20rpx;
}

.header-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.header-copy {
  min-width: 0;
  flex: 1;
}

.hello,
.header-subtitle {
  display: block;
}

.hello {
  overflow: hidden;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-page-title);
  font-weight: 800;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-subtitle {
  margin-top: 5rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: 1.5;
  text-wrap: pretty;
}

.header-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 2rpx;
}

.header-actions .home-header-button {
  width: auto;
  min-width: 44px;
  min-height: 44px;
  padding: 0 10rpx;
  border-radius: 16rpx;
  color: var(--ui-text-secondary);
  background: transparent;
  font-size: var(--ui-font-action);
  font-weight: 600;
  line-height: 1;
}

.home-content {
  display: block;
}

.error {
  margin-bottom: 20rpx;
  box-shadow: 0 0 0 1rpx rgba(182, 69, 69, 0.08);
}

.story-loading {
  padding: 30rpx 20rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-action);
  text-align: center;
}

.hero-voice-action {
  box-sizing: border-box;
  width: 100%;
  min-height: 48px;
  margin-top: 22rpx;
  padding: 8rpx 10rpx 8rpx 30rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  color: var(--ui-text-primary);
  background: rgba(255, 253, 250, 0.72);
  box-shadow:
    0 0 0 2rpx rgba(182, 93, 73, 0.23) inset,
    0 6rpx 16rpx rgba(63, 47, 37, 0.035);
  transition-property: transform, background-color, box-shadow, opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.hero-voice-action.button-blocked {
  opacity: 0.66;
}

.hero-voice-label {
  min-width: 0;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
  text-align: center;
}

.hero-voice-arrow,
.continue-narration-arrow {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  border-radius: 50%;
  background: var(--ui-accent);
  color: var(--ui-on-accent);
  font-size: 42rpx;
  font-weight: 400;
  line-height: 60rpx;
  text-align: center;
  transform: translateX(1rpx);
}

.voice-start-button-hover {
  background: var(--ui-accent-surface-subtle);
  transform: scale(0.96);
  box-shadow:
    0 0 0 2rpx var(--ui-accent-border) inset,
    0 5rpx 14rpx rgba(63, 47, 37, 0.04);
}

.after-hero {
  display: block;
}

.home-saved-notice {
  display: block;
  margin: 16rpx 8rpx -4rpx;
  color: var(--ui-success-text);
  font-size: var(--ui-font-body);
  font-weight: 650;
  line-height: 1.5;
  text-align: center;
}

.narration-choice-card {
  box-sizing: border-box;
  width: 100%;
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 253, 250, 0.78);
  box-shadow:
    0 0 0 1rpx rgba(96, 77, 64, 0.08),
    0 6rpx 16rpx rgba(63, 47, 37, 0.035);
}

.narration-choice-copy,
.narration-choice-kicker,
.narration-choice-text {
  display: block;
}

.narration-choice-kicker {
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  font-weight: 650;
  line-height: 1.45;
}

.narration-choice-text {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 5rpx;
  color: var(--ui-text-primary);
  font-size: var(--ui-font-body);
  font-weight: 650;
  line-height: 1.55;
  text-wrap: pretty;
}

.narration-choice-actions {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.narration-choice-action {
  box-sizing: border-box;
  min-height: 44px;
  padding: 8rpx 18rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: var(--ui-font-action);
  font-weight: 750;
  line-height: 1.35;
}

.narration-choice-action.button-blocked {
  opacity: 0.62;
  pointer-events: none;
}

.narration-choice-primary {
  flex: 1 1 auto;
  justify-content: flex-start;
  color: var(--ui-accent-strong);
}

.narration-choice-arrow {
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
  transform: translateY(-1rpx);
}

.narration-choice-secondary {
  flex: 0 1 auto;
  color: var(--ui-text-secondary);
  background: rgba(255, 253, 250, 0.76);
  box-shadow: 0 0 0 1rpx rgba(96, 77, 64, 0.12) inset;
}

.narration-choice-plus {
  font-size: var(--ui-font-action);
  font-weight: 500;
  line-height: 1;
}

.voice-auth-panel,
.home-growth-notice {
  margin-top: 20rpx;
  border-radius: 26rpx;
  background: var(--ui-accent-surface-subtle);
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.045),
    0 8rpx 20rpx rgba(0, 0, 0, 0.04);
}

.home-share-candidate {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 253, 250, 0.94);
  box-shadow:
    0 0 0 1rpx rgba(182, 93, 73, 0.14),
    0 8rpx 24rpx rgba(63, 47, 37, 0.055);
}

.home-share-candidate-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.home-share-candidate-heading,
.home-share-candidate-kicker,
.home-share-candidate-title,
.home-share-candidate-quote,
.home-share-candidate-hint,
.home-share-candidate-error {
  display: block;
}

.home-share-candidate-heading {
  min-width: 0;
}

.home-share-candidate-kicker {
  color: var(--ui-accent-strong);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 1.4;
}

.home-share-candidate-title {
  margin-top: 4rpx;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-action);
  font-weight: 750;
  line-height: 1.4;
  text-wrap: balance;
}

.home-share-candidate-duration {
  flex: 0 0 auto;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: var(--ui-accent-strong);
  background: var(--ui-accent-surface-subtle);
  font-size: var(--ui-font-meta);
  font-weight: 700;
  line-height: 1.35;
}

.home-share-candidate-quote {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  margin-top: 18rpx;
  color: var(--ui-text-primary);
  font-family: var(--ui-font-editorial);
  font-size: var(--ui-font-body);
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.home-share-candidate-hint {
  margin-top: 12rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  line-height: 1.55;
  text-wrap: pretty;
}

.home-share-candidate-error {
  margin-top: 12rpx;
  color: var(--ui-danger-text);
  font-size: var(--ui-font-meta);
  line-height: 1.45;
}

.home-share-candidate-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.home-share-candidate-primary,
.home-share-candidate-secondary {
  min-height: 44px;
  margin: 0;
  padding: 10rpx 22rpx;
  border-radius: 18rpx;
  font-size: var(--ui-font-action);
  font-weight: 750;
  line-height: 1.35;
  transition-property: transform, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.home-share-candidate-primary {
  flex: 1 1 auto;
  color: var(--ui-on-accent);
  background: var(--ui-accent);
}

.home-share-candidate-primary-hover {
  color: var(--ui-on-accent);
  background: var(--ui-accent-strong);
  transform: scale(0.96);
}

.home-share-candidate-secondary {
  flex: 0 0 auto;
  color: var(--ui-text-secondary);
  background: var(--ui-surface-soft);
  box-shadow: var(--ui-control-shadow);
}

.home-share-all {
  display: block;
  min-height: 40px;
  margin: 12rpx 0 0;
  padding: 10rpx 0 0;
  color: var(--ui-accent-strong);
  background: transparent;
  font-size: var(--ui-font-meta);
  font-weight: 700;
  text-align: left;
}

.voice-auth-panel {
  padding: 22rpx 24rpx;
}

.voice-auth-copy,
.voice-auth-link {
  font-size: var(--ui-font-body);
  font-weight: 650;
  line-height: var(--ui-line-body);
}

.voice-auth-hint {
  display: block;
  margin-top: 10rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: 1.5;
  text-wrap: pretty;
}

.home-growth-notice {
  padding: 26rpx 24rpx 22rpx;
  background: rgba(255, 253, 250, 0.9);
}

.home-growth-copy,
.home-review-copy {
  min-width: 0;
  flex: 1;
}

.home-growth-title,
.home-growth-value,
.home-growth-context,
.home-story-progress-title,
.home-story-progress-detail {
  display: block;
}

.home-growth-title {
  color: var(--ui-text-primary);
  font-size: var(--ui-font-list-title);
  font-weight: 650;
  line-height: 1.45;
  text-wrap: balance;
}

.home-story-progress-title {
  color: var(--ui-text-primary);
  font-size: var(--ui-font-list-title);
  font-weight: 700;
  line-height: 1.45;
}

.home-growth-value {
  margin-top: 8rpx;
  color: var(--ui-accent-strong);
  font-family: var(--ui-font-editorial);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
  text-wrap: balance;
}

.home-story-progress-detail {
  margin-top: 3rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-body);
  line-height: 1.5;
  text-wrap: pretty;
}

.home-growth-context {
  margin-top: 4rpx;
  color: var(--ui-text-muted);
  font-size: var(--ui-font-body);
  line-height: 1.5;
  text-wrap: pretty;
}

.home-growth-actions {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.home-inline-action {
  width: auto;
  min-height: 44px;
  padding: 0 12rpx;
  border-radius: 14rpx;
  color: var(--ui-accent-strong);
  background: transparent;
  font-size: var(--ui-font-action);
  font-weight: 700;
  line-height: 1.4;
}

.home-inline-action.is-secondary {
  color: var(--ui-text-muted);
  font-weight: 600;
}

.story-refresh-error,
.home-story-progress {
  margin-top: 18rpx;
}

.home-story-progress {
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(250, 247, 242, 0.86);
  box-shadow: var(--ui-control-shadow);
}

.home-story-progress.is-error {
  background: var(--ui-danger-surface);
}

.home-story-action {
  width: 100%;
  min-height: 88rpx;
  margin-top: 12rpx;
  border-radius: 20rpx;
  color: var(--ui-accent-strong);
  background: var(--ui-accent-surface);
  box-shadow: var(--ui-control-shadow);
  font-size: var(--ui-font-action);
  font-weight: 700;
}

.continue-narration-bar {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: calc(12px + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.continue-narration-bar .continue-narration-button {
  width: auto;
  max-width: calc(100% - 48rpx);
  min-width: 300rpx;
  min-height: 48px;
  padding: 8rpx 10rpx 8rpx 28rpx;
  border-radius: 26rpx;
  color: var(--ui-text-primary);
  background: rgba(255, 253, 250, 0.96);
  box-shadow: var(--ui-card-shadow-raised);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.5;
  pointer-events: auto;
  gap: 22rpx;
}

.home-page.large-text {
  padding: 26rpx 30rpx calc(108px + env(safe-area-inset-bottom));
}

.large-text .hello { font-size: 44rpx; }
.large-text .header-subtitle { font-size: var(--ui-font-large-body); }
.large-text .home-header-button { font-size: var(--ui-font-large-body); }
.large-text .hero-voice-action { min-height: 56px; }
.large-text .hero-voice-label { font-size: 37rpx; }
.large-text .narration-choice-kicker { font-size: var(--ui-font-large-meta); }
.large-text .home-share-candidate-kicker,
.large-text .home-share-candidate-duration { font-size: var(--ui-font-large-meta); }
.large-text .home-share-candidate-title { font-size: var(--ui-font-large-list-title); }
.large-text .narration-choice-text,
.large-text .narration-choice-action,
.large-text .home-share-candidate-quote,
.large-text .home-share-candidate-hint,
.large-text .home-share-candidate-error,
.large-text .home-share-candidate-primary,
.large-text .home-share-candidate-secondary,
.large-text .voice-auth-hint,
.large-text .home-growth-context,
.large-text .home-story-progress-detail { font-size: var(--ui-font-large-body); }
.large-text .voice-auth-copy,
.large-text .voice-auth-link,
.large-text .home-growth-title,
.large-text .home-story-progress-title { font-size: 34rpx; }
.large-text .home-growth-value { font-size: 46rpx; }
.large-text .home-inline-action { font-size: var(--ui-font-large-body); }
.large-text .continue-narration-button { min-height: 56px; font-size: 36rpx; }

@media (max-width: 360px) {
  .home-page { padding-right: 24rpx; padding-left: 24rpx; }
  .header-main { align-items: flex-start; }
  .narration-choice-actions { align-items: stretch; flex-direction: column; }
  .narration-choice-primary,
  .narration-choice-secondary { width: 100%; justify-content: center; }
}
