.home-page {
  min-height: 100vh;
  padding: 52rpx 36rpx 88rpx;
  background: #f7fbf9;
}

.top-row {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.hello {
  display: block;
  color: #17221f;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.2;
}

.project-line {
  display: block;
  margin-top: 12rpx;
  color: #5f6d69;
  font-size: 28rpx;
  line-height: 1.35;
}

.logout-button {
  width: 116rpx;
  height: 70rpx;
  margin: 0;
  border: 0;
  border-radius: 20rpx;
  background: #ffffff;
  color: #9f4a3c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 22rpx rgba(37, 73, 62, 0.08);
}

.logout-button::after {
  border: 0;
}

.logout-button[disabled] {
  opacity: 0.72;
}

.voice-panel,
.project-card,
.mode-strip {
  border: 2rpx solid #d6e7df;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(37, 73, 62, 0.08);
}

.voice-panel {
  margin-top: 42rpx;
  padding: 42rpx 34rpx;
}

.voice-icon {
  width: 112rpx;
  height: 112rpx;
}

.voice-title {
  display: block;
  margin-top: 26rpx;
  color: #17221f;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.18;
}

.voice-copy {
  display: block;
  margin-top: 18rpx;
  color: #5f6d69;
  font-size: 30rpx;
  line-height: 1.5;
}

.primary-button {
  width: 100%;
  height: 112rpx;
  margin: 42rpx 0 0;
  border: 0;
  border-radius: 28rpx;
  background: #2e7d6b;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 800;
}

.primary-button::after {
  border: 0;
}

.primary-button[disabled] {
  opacity: 0.72;
}

.project-card {
  margin-top: 28rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.card-label,
.card-meta {
  display: block;
  color: #5f6d69;
  font-size: 26rpx;
  line-height: 1.3;
}

.card-title {
  display: block;
  margin-top: 10rpx;
  color: #17221f;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
}

.card-meta {
  margin-top: 10rpx;
}

.chevron {
  color: #2e7d6b;
  font-size: 58rpx;
  line-height: 1;
}

.mode-strip {
  margin-top: 28rpx;
  padding: 24rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.mode-item {
  min-height: 132rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #e9f6f1;
}

.mode-title {
  display: block;
  color: #1f6b59;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.25;
}

.mode-desc {
  display: block;
  margin-top: 12rpx;
  color: #5f6d69;
  font-size: 25rpx;
  line-height: 1.35;
}

.error {
  margin-top: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff1f2;
  color: #be123c;
  font-size: 26rpx;
  line-height: 1.45;
}

.tap-hover {
  opacity: 0.82;
}
