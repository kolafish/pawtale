.home-page {
  min-height: 100vh;
  padding: 52rpx 36rpx 120rpx;
  background: #fffaf2;
}

.header {
  margin-bottom: 30rpx;
}

.hello {
  display: block;
  color: #24100b;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  color: #7a3b31;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.home-card {
  border: 2rpx solid #f0dac0;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(64, 43, 24, 0.08);
  padding: 30rpx;
}

.project-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.panel-label {
  color: #7a3b31;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.3;
}

.mode-tag {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff1ec;
  color: #9f4a3c;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.25;
}

.project-title {
  display: block;
  margin-top: 14rpx;
  color: #24100b;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.25;
}

.project-meta {
  display: block;
  margin-top: 18rpx;
  color: #685b55;
  font-size: 31rpx;
  line-height: 1.5;
}

.voice-start-button {
  width: 100%;
  min-height: 148rpx;
  margin: 46rpx 0 0;
  border: 0;
  border-radius: 36rpx;
  background: #9f4a3c;
  box-shadow: 0 18rpx 36rpx rgba(159, 74, 60, 0.18);
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 24rpx;
  padding: 24rpx 30rpx;
  text-align: left;
}

.voice-start-button::after {
  border: 0;
}

.voice-start-button[disabled] {
  opacity: 0.72;
}

.voice-start-button-hover {
  background: #b85c45;
}

.voice-start-icon {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  display: block;
}

.voice-start-copy {
  flex: 1;
  min-width: 0;
}

.voice-start-title {
  display: block;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.25;
}

.voice-start-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #fff1ec;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.35;
}

.voice-auth-panel {
  margin-top: 32rpx;
  padding: 22rpx;
  border: 2rpx solid #efd6c4;
  border-radius: 18rpx;
  background: #fffaf2;
}

.voice-auth-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.voice-auth-copy {
  flex: 1;
  min-width: 0;
  color: #24100b;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
}

.voice-auth-link {
  color: #9f4a3c;
}

.voice-auth-hint {
  display: block;
  margin-top: 14rpx;
  color: #685b55;
  font-size: 25rpx;
  line-height: 1.45;
}

.error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff1f2;
  color: #be123c;
  font-size: 26rpx;
  line-height: 1.45;
}
