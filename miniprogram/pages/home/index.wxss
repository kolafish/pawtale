.home-page {
  min-height: 100vh;
  padding: 52rpx 36rpx 120rpx;
  background: #fffaf2;
}

.header {
  margin-bottom: 30rpx;
}

.hello {
  display: block;
  color: #24100b;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  color: #7a3b31;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.project-panel,
.voice-panel {
  border: 2rpx solid #f0dac0;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(64, 43, 24, 0.08);
}

.project-panel {
  padding: 30rpx;
}

.panel-label {
  display: block;
  color: #7a3b31;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.3;
}

.project-title {
  display: block;
  margin-top: 14rpx;
  color: #24100b;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.25;
}

.project-meta {
  display: block;
  margin-top: 16rpx;
  color: #685b55;
  font-size: 27rpx;
  line-height: 1.5;
}

.voice-panel {
  margin-top: 28rpx;
  padding: 42rpx 34rpx;
}

.voice-icon {
  width: 112rpx;
  height: 112rpx;
}

.voice-title {
  display: block;
  margin-top: 26rpx;
  color: #24100b;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.18;
}

.voice-copy {
  display: block;
  margin-top: 18rpx;
  color: #685b55;
  font-size: 30rpx;
  line-height: 1.5;
}

.primary-button {
  width: 100%;
  height: 112rpx;
  margin: 42rpx 0 0;
  border: 0;
  border-radius: 28rpx;
  background: #9f4a3c;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 800;
}

.primary-button::after {
  border: 0;
}

.primary-button[disabled] {
  opacity: 0.72;
}

.error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff1f2;
  color: #be123c;
  font-size: 26rpx;
  line-height: 1.45;
}
