.home-page {
  min-height: 100vh;
  padding: 52rpx 36rpx 120rpx;
  background: #fffaf2;
}

.header {
  margin-bottom: 30rpx;
}

.hello {
  display: block;
  color: #24100b;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  color: #7a3b31;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.project-panel,
.voice-panel {
  border: 2rpx solid #f0dac0;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(64, 43, 24, 0.08);
}

.project-panel {
  padding: 30rpx;
}

.project-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.panel-label {
  color: #7a3b31;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.3;
}

.mode-tag {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff1ec;
  color: #9f4a3c;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.25;
}

.project-title {
  display: block;
  margin-top: 14rpx;
  color: #24100b;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.25;
}

.project-meta {
  display: block;
  margin-top: 16rpx;
  color: #685b55;
  font-size: 27rpx;
  line-height: 1.5;
}

.project-create-button {
  width: 100%;
  height: 88rpx;
  margin: 24rpx 0 0;
  border: 0;
  border-radius: 22rpx;
  background: #fff1ec;
  color: #9f4a3c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
}

.project-create-button::after {
  border: 0;
}

.project-create-button[disabled] {
  opacity: 0.68;
}

.voice-panel {
  margin-top: 28rpx;
  padding: 36rpx 34rpx;
}

.voice-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.voice-icon {
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
}

.voice-main {
  flex: 1;
  min-width: 0;
}

.voice-title {
  display: block;
  color: #24100b;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.18;
}

.voice-copy {
  display: block;
  margin-top: 10rpx;
  color: #685b55;
  font-size: 29rpx;
  line-height: 1.5;
}

.voice-mode-row {
  min-height: 74rpx;
  margin-top: 30rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #fffaf2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.voice-mode-label {
  color: #7a3b31;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
}

.voice-mode-value {
  color: #9f4a3c;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.voice-auth-panel {
  margin-top: 30rpx;
  padding: 22rpx;
  border: 2rpx solid #efd6c4;
  border-radius: 18rpx;
  background: #fffaf2;
}

.voice-auth-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.voice-auth-copy {
  flex: 1;
  min-width: 0;
  color: #24100b;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
}

.voice-auth-link {
  color: #9f4a3c;
}

.voice-auth-hint {
  display: block;
  margin-top: 14rpx;
  color: #685b55;
  font-size: 25rpx;
  line-height: 1.45;
}

.primary-button {
  width: 100%;
  height: 120rpx;
  margin: 36rpx 0 0;
  border: 0;
  border-radius: 30rpx;
  background: #2f7d63;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 800;
}

.primary-button::after {
  border: 0;
}

.primary-button[disabled] {
  opacity: 0.72;
}

.error {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: #fff1f2;
  color: #be123c;
  font-size: 26rpx;
  line-height: 1.45;
}
