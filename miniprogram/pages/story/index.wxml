<view class="{{pageClass}}">
  <view class="story-shell">
    <view wx:if="{{error}}" class="story-error ui-error-banner">{{error}}</view>

    <view wx:if="{{loading && !projectId}}" class="story-state ui-card">
      <text class="story-state-title">正在整理你的故事树</text>
      <text class="story-state-copy">正在读取回忆录、章节和讲述进度…</text>
    </view>

    <view wx:elif="{{needsLogin}}" class="story-state ui-card">
      <text class="story-state-title">登录后查看故事</text>
      <text class="story-state-copy">你的生命树会根据讲述、章节和成稿进度自动更新。</text>
      <button class="story-state-action ui-button" bindtap="openLogin">去登录</button>
    </view>

    <view wx:elif="{{!projectId && error}}" class="story-state ui-card">
      <text class="story-state-title">故事暂时没有加载出来</text>
      <text class="story-state-copy">可以稍后重试，已有讲述不会受影响。</text>
      <button class="story-state-action ui-button" bindtap="loadStory">重新加载</button>
    </view>

    <view wx:elif="{{!projectId}}" class="story-state ui-card">
      <text class="story-state-title">还没有回忆录</text>
      <text class="story-state-copy">先创建回忆录，之后的讲述会在这里长成一棵故事树。</text>
      <button class="story-state-action ui-button" bindtap="createProject">创建回忆录</button>
    </view>

    <block wx:else>
    <view wx:if="{{growthNoticeText}}" class="growth-notice" aria-live="polite">
      <view class="growth-notice-mark" aria-hidden="true"></view>
      <view class="growth-notice-copy">
        <text class="growth-notice-title">故事树长出了新内容</text>
        <text class="growth-notice-detail">{{growthNoticeText}}</text>
      </view>
    </view>
    <view
      class="memoir-card ui-card ui-card-borderless ui-card-raised ui-pressable"
      bindtap="openBook"
      hover-class="ui-subtle-action-hover"
      aria-role="button"
      aria-label="查看{{memoir.title}}的书稿"
    >
      <view class="memoir-copy">
        <text class="memoir-eyebrow">回忆录名称</text>
        <text class="memoir-title">{{memoir.title}}</text>
        <text class="memoir-meta">{{memoir.createdText}} · {{memoir.updatedText}}</text>
      </view>
      <view class="memoir-progress">
        <text class="memoir-progress-label">{{memoir.progressLabel}}</text>
        <text class="memoir-progress-value ui-tabular">{{memoir.progressValue}}</text>
        <text class="memoir-progress-detail">{{memoir.progressDetail}} ›</text>
      </view>
    </view>

    <view class="story-toolbar">
      <view class="timeline-label">
        <view class="timeline-mark"></view>
        <text>人生脉络</text>
      </view>
      <view
        class="transcript-list-entry ui-pressable"
        bindtap="openTranscripts"
        hover-class="ui-subtle-action-hover"
        aria-role="button"
        aria-label="查看全部讲述列表"
      >
        <text>全部讲述</text>
        <text class="transcript-list-mark" aria-hidden="true">›</text>
      </view>
    </view>

    <view class="story-tree">
      <view class="overview-row">
        <view class="overview-symbol" aria-hidden="true">
          <view class="overview-sprout"></view>
        </view>
        <view class="overview-card ui-card ui-card-borderless">
          <view class="overview-copy">
            <text class="overview-title">{{overview.title}}</text>
            <text class="overview-summary ui-tabular">{{overview.summaryText}}</text>
          </view>
          <text class="overview-outcome ui-tabular">{{overview.outcomeText}}</text>
        </view>
      </view>

      <view
        wx:for="{{chapters}}"
        wx:for-index="chapterIndex"
        wx:key="id"
        class="chapter-block {{item.highlighted ? 'is-new-growth' : ''}}"
      >
        <view class="chapter-decoration" aria-hidden="true"></view>
        <view class="chapter-branch" aria-hidden="true"></view>
        <view class="chapter-node ui-tabular" aria-hidden="true">{{chapterIndex + 1}}</view>

        <view
          class="chapter-card ui-card ui-card-borderless ui-pressable"
          data-id="{{item.id}}"
          bindtap="toggleChapter"
          hover-class="ui-subtle-action-hover"
          aria-role="button"
          aria-expanded="{{item.expanded}}"
          aria-label="{{item.title}}，{{item.summaryText}}，{{item.outcomeText}}，{{item.expanded ? '点击收起' : '点击展开'}}"
        >
          <view class="chapter-copy">
            <text class="chapter-title">{{item.title}}</text>
            <text class="chapter-meta ui-tabular">
              <text wx:if="{{item.timeRangeText}}">{{item.timeRangeText}} · </text>{{item.summaryText}}
            </text>
          </view>
          <text class="chapter-status {{item.state}}">{{item.outcomeText}}</text>
          <view class="chapter-chevron {{item.expanded ? 'expanded' : ''}}" aria-hidden="true">⌄</view>
        </view>

        <view wx:if="{{item.expanded}}" class="section-list">
          <view
            wx:if="{{item.imageCount || item.videoCount}}"
            class="chapter-media-row ui-pressable"
            data-id="{{item.id}}"
            bindtap="openMedia"
            hover-class="ui-subtle-action-hover"
            aria-role="button"
            aria-label="{{item.title}}的章节素材"
          >
            <text class="chapter-media-title">本章素材</text>
            <view class="section-media">
              <text wx:if="{{item.imageCount}}" class="media-chip image-chip">{{item.imageCount}} 图</text>
              <text wx:if="{{item.videoCount}}" class="media-chip video-chip">{{item.videoCount}} 视频</text>
            </view>
            <text class="section-action" aria-hidden="true">›</text>
          </view>
          <view
            wx:for="{{item.sections}}"
            wx:for-item="section"
            wx:key="id"
            class="section-row ui-pressable {{section.highlighted ? 'is-new-growth' : ''}}"
            data-chapter-id="{{item.id}}"
            data-section-id="{{section.id}}"
            bindtap="openChapter"
            hover-class="ui-subtle-action-hover"
            aria-role="button"
            aria-label="{{section.title}}，{{section.materialText}}"
          >
            <view class="section-marker" aria-hidden="true"></view>
            <view class="section-copy">
              <text class="section-title">{{section.title}}</text>
              <text class="section-meta ui-tabular">{{section.materialText}}</text>
            </view>
            <view
              wx:if="{{section.imageCount || section.videoCount}}"
              class="section-media"
            >
              <text wx:if="{{section.imageCount}}" class="media-chip image-chip">{{section.imageCount}} 图</text>
              <text wx:if="{{section.videoCount}}" class="media-chip video-chip">{{section.videoCount}} 视频</text>
            </view>
            <text class="section-action" aria-hidden="true">›</text>
          </view>
          <view
            wx:if="{{!item.sections.length}}"
            class="section-row section-empty ui-pressable"
            data-id="{{item.id}}"
            bindtap="openChapter"
            hover-class="ui-subtle-action-hover"
            aria-role="button"
            aria-label="{{item.title}}还没有小节，进入整理"
          >
            <view class="section-marker" aria-hidden="true"></view>
            <view class="section-copy">
              <text class="section-title">还没有小节</text>
              <text class="section-meta">进入章节整理后可以自动划分</text>
            </view>
            <text class="section-action" aria-hidden="true">›</text>
          </view>
        </view>
      </view>

      <view
        class="unassigned-card ui-pressable"
        bindtap="openTranscripts"
        hover-class="ui-subtle-action-hover"
        aria-role="button"
      >
        <text class="unassigned-mark">＋</text>
        <view class="unassigned-copy">
          <text class="unassigned-title">{{unassignedMaterialTitle}}</text>
          <text class="unassigned-meta">{{unassignedMaterialText}}</text>
          <text class="unassigned-detail">{{unassignedMaterialDetail}}</text>
        </view>
        <view
          wx:if="{{unassignedImageCount || unassignedVideoCount}}"
          class="section-media section-media-entry ui-pressable"
          catchtap="openMedia"
          aria-role="button"
          aria-label="查看待整理的图片和视频"
        >
          <text wx:if="{{unassignedImageCount}}" class="media-chip image-chip">{{unassignedImageCount}} 图</text>
          <text wx:if="{{unassignedVideoCount}}" class="media-chip video-chip">{{unassignedVideoCount}} 视频</text>
        </view>
        <text class="unassigned-action">查看讲述 ›</text>
      </view>
    </view>

    <view
      class="add-chapter-action ui-pressable"
      bindtap="openChapterManager"
      hover-class="ui-subtle-action-hover"
      aria-role="button"
      aria-label="开始整理故事"
    >
      <text class="add-chapter-mark">＋</text>
      <text>开始整理故事</text>
    </view>
    </block>
  </view>
</view>
