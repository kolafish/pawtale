<view class="{{pageClass}}">
  <view class="story-shell">
    <view wx:if="{{error}}" class="story-error ui-error-banner">{{error}}</view>

    <view wx:if="{{loading && !projectId}}" class="story-state ui-card">
      <text class="story-state-title">正在整理你的故事树</text>
      <text class="story-state-copy">正在读取回忆录、章节和讲述进度…</text>
    </view>

    <view wx:elif="{{needsLogin}}" class="story-state ui-card">
      <text class="story-state-title">登录后查看故事</text>
      <text class="story-state-copy">你的生命树会根据讲述、章节和成稿进度自动更新。</text>
      <button class="story-state-action ui-button" bindtap="openLogin">去登录</button>
    </view>

    <view wx:elif="{{!projectId && error}}" class="story-state ui-card">
      <text class="story-state-title">故事暂时没有加载出来</text>
      <text class="story-state-copy">可以稍后重试，已有讲述不会受影响。</text>
      <button class="story-state-action ui-button" bindtap="loadStory">重新加载</button>
    </view>

    <view wx:elif="{{!projectId}}" class="story-state ui-card">
      <text class="story-state-title">还没有回忆录</text>
      <text class="story-state-copy">先创建回忆录，之后的讲述会在这里长成一棵故事树。</text>
      <button class="story-state-action ui-button" bindtap="createProject">创建回忆录</button>
    </view>

    <block wx:else>
    <view wx:if="{{progress}}" class="story-state story-progress ui-card" aria-live="polite">
      <text class="story-state-title">{{progress.title}}</text>
      <text class="story-state-copy">{{progress.detail}}</text>
      <text wx:if="{{progress.total_chapter_count}}" class="story-state-copy ui-tabular">已有 {{progress.readable_chapter_count}} / {{progress.total_chapter_count}} 章可读</text>
      <button wx:if="{{bookReadable}}" class="story-state-action ui-button" bindtap="openBook">阅读草稿</button>
      <button wx:if="{{progress.can_retry}}" class="story-state-action story-secondary-action ui-button" bindtap="retryDraft" loading="{{retrying}}" disabled="{{retrying}}">继续后台整理</button>
      <button wx:if="{{progress.status === 'needs_input'}}" class="story-state-action story-secondary-action ui-button" bindtap="openReviewIssues">查看待确认事项</button>
    </view>
    <view wx:if="{{growthNoticeText}}" class="growth-notice" aria-live="polite">
      <view class="growth-notice-mark" aria-hidden="true"></view>
      <view class="growth-notice-copy">
        <text class="growth-notice-title">{{growthNoticeTitle}}</text>
        <text class="growth-notice-detail">{{growthNoticeText}}</text>
      </view>
      <button size="mini" class="growth-notice-dismiss story-secondary-action ui-button" bindtap="dismissGrowthNotice" loading="{{dismissingGrowth}}" disabled="{{dismissingGrowth}}">知道了</button>
    </view>
    <story-tree
      id="story-tree"
      story="{{story}}"
      large-text="{{largeText}}"
      bind:togglechapter="toggleChapter"
      bind:openbook="openBook"
      bind:readchapter="readChapter"
      bind:openchapter="openChapter"
      bind:openmedia="openMedia"
      bind:opentranscripts="openTranscripts"
      bind:managechapters="openChapterManager"
    />
    </block>
  </view>
</view>
