.story-page {
  min-height: 100vh;
  padding: 28rpx 24rpx calc(52rpx + env(safe-area-inset-bottom));
  background:
    linear-gradient(180deg, #f8f4ee 0%, #f5f0e8 55%, #f7f3ec 100%);
}

.story-shell {
  width: 100%;
  max-width: 920rpx;
  margin: 0 auto;
}

.growth-notice {
  min-height: 96rpx;
  margin-bottom: 18rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: rgba(244, 237, 226, 0.94);
  box-shadow: 0 0 0 1rpx rgba(151, 117, 91, 0.10);
}

.growth-notice-mark {
  flex: 0 0 auto;
  width: 18rpx;
  height: 34rpx;
  border-radius: 12rpx 12rpx 12rpx 2rpx;
  background: #9aa989;
  transform: rotate(28deg);
}

.growth-notice-copy {
  min-width: 0;
  flex: 1;
}

.growth-notice-dismiss {
  flex: 0 0 auto;
  width: auto;
  min-height: 88rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
}

.large-text .growth-notice-title {
  font-size: 36rpx;
  line-height: 1.45;
}

.large-text .growth-notice-detail {
  font-size: 30rpx;
  line-height: 1.5;
}

.growth-notice-title,
.growth-notice-detail {
  display: block;
}

.growth-notice-title {
  color: #55443b;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.growth-notice-detail {
  margin-top: 3rpx;
  color: #82736a;
  font-size: 23rpx;
  line-height: 34rpx;
}

.story-error {
  margin-bottom: 20rpx;
}

.story-state {
  min-height: 360rpx;
  padding: 52rpx 40rpx;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: rgba(255, 253, 250, 0.94);
}

.story-state-title {
  color: #453831;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.4;
}

.story-state-copy {
  max-width: 560rpx;
  margin-top: 14rpx;
  color: #897f78;
  font-size: 25rpx;
  line-height: 1.65;
}

.story-state-action {
  min-width: 240rpx;
  min-height: 88rpx;
  margin-top: 32rpx;
  border: 0;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fffaf7;
  font-size: 27rpx;
  font-weight: 700;
  background: #9b574d;
}

.story-state-action::after {
  border: 0;
}

.large-text .story-state-title {
  font-size: 34rpx;
}

.story-state.story-progress {
  min-height: 0;
  padding: 28rpx;
  align-items: stretch;
  text-align: left;
  margin-bottom: 20rpx;
}

.story-progress .story-state-action {
  margin-top: 20rpx;
}

.story-secondary-action {
  color: var(--ui-accent-strong);
  background: var(--ui-accent-surface);
  box-shadow: var(--ui-control-shadow);
}
