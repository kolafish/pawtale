page {
  --ui-page-background: #f7f3ec;
  --ui-surface: #fffdfc;
  --ui-surface-subtle: #f4f0eb;
  --ui-text-primary: #2e2724;
  --ui-text-secondary: #6f6864;
  --ui-text-muted: #8a827d;
  --ui-on-accent: #ffffff;
  --ui-section-title: #77473f;
  --ui-value-text: #5d514d;
  --ui-accent: #a84f43;
  --ui-accent-strong: #8f4037;
  --ui-accent-surface: #f6e9e6;
  --ui-accent-surface-subtle: #fbf4f2;
  --ui-accent-border: #dfc0ba;
  --ui-border: #e9e2da;
  --ui-divider: #ece6df;
  --ui-switch-off: #d8d6d2;
  --ui-danger-surface: #fff1f1;
  --ui-danger-text: #b64545;
  --ui-success-surface: #edf3ea;
  --ui-success-text: #5a7454;
  --ui-warning-surface: #fff5de;
  --ui-warning-text: #7d5c25;
  --ui-card-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.04),
    0 2rpx 6rpx rgba(0, 0, 0, 0.03),
    0 12rpx 28rpx rgba(0, 0, 0, 0.04);
  --ui-card-shadow-raised:
    0 0 0 1rpx rgba(0, 0, 0, 0.05),
    0 4rpx 10rpx rgba(0, 0, 0, 0.04),
    0 18rpx 42rpx rgba(0, 0, 0, 0.06);
  --ui-control-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.06);
  --ui-hit-size: 88rpx;
  min-height: 100vh;
  background: var(--ui-page-background);
  color: var(--ui-text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", Helvetica, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
textarea,
image {
  box-sizing: border-box;
}

.ui-page-shell {
  min-height: 100vh;
  background: var(--ui-page-background);
}

.ui-card {
  box-sizing: border-box;
  border: 1rpx solid var(--ui-border);
  border-radius: 24rpx;
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow);
}

.ui-card.ui-card-borderless {
  border: 0;
}

.ui-card.ui-card-raised {
  box-shadow: var(--ui-card-shadow-raised);
}

.ui-section-heading {
  display: block;
  color: var(--ui-section-title);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
  text-wrap: balance;
}

.ui-page-shell.ui-fixed-action-page {
  padding-bottom: calc(var(--ui-fixed-action-space, 168rpx) + env(safe-area-inset-bottom));
}

.ui-fixed-action-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  padding:
    var(--ui-fixed-action-top, 24rpx)
    var(--ui-fixed-action-inline, 32rpx)
    calc(var(--ui-fixed-action-bottom, 24rpx) + env(safe-area-inset-bottom));
  background: var(--ui-fixed-action-background, rgba(247, 243, 236, 0.96));
  box-shadow: 0 -1rpx 0 rgba(0, 0, 0, 0.06);
}

.ui-button {
  margin: 0;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.ui-button::after {
  border: 0;
}

.ui-button:active {
  transform: scale(0.96);
}

.ui-button[disabled] {
  opacity: 0.62;
  transform: none;
}

.ui-error-banner {
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
  font-size: 28rpx;
  line-height: 1.45;
  word-break: break-word;
}

.ui-accent-action-hover {
  background: var(--ui-accent-surface-subtle);
  transform: scale(0.96);
  box-shadow:
    0 0 0 1rpx rgba(168, 79, 67, 0.20),
    0 4rpx 10rpx rgba(0, 0, 0, 0.05);
}

.ui-subtle-action-hover {
  background: var(--ui-surface-subtle);
  transform: scale(0.96);
}

.ui-avatar-action-hover {
  transform: scale(0.96);
  box-shadow: 0 0 0 8rpx rgba(168, 79, 67, 0.10);
}

.tap-hover {
  opacity: 0.82;
}

.ui-page-context-row {
  min-height: 56rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.ui-page-context {
  min-width: 0;
  display: block;
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
  text-wrap: pretty;
}

.large-text .ui-page-context {
  font-size: 30rpx;
  line-height: 1.5;
}

.ui-accessible-page.large-text {
  --ui-hit-size: 96rpx;
}

.ui-accessible-page.large-text .brand-title,
.ui-accessible-page.large-text .hero-title,
.ui-accessible-page.large-text .page-title,
.ui-accessible-page.large-text .reader-title,
.ui-accessible-page.large-text .revision-title,
.ui-accessible-page.large-text .status-title {
  font-size: 60rpx;
  line-height: 1.35;
}

.ui-accessible-page.large-text .summary-value {
  font-size: 50rpx;
}

.ui-accessible-page.large-text .asset-title,
.ui-accessible-page.large-text .book-design-title,
.ui-accessible-page.large-text .book-review-title,
.ui-accessible-page.large-text .chapter-title,
.ui-accessible-page.large-text .draft-section-title,
.ui-accessible-page.large-text .empty-title,
.ui-accessible-page.large-text .module-title,
.ui-accessible-page.large-text .panel-title,
.ui-accessible-page.large-text .project-title,
.ui-accessible-page.large-text .section-name,
.ui-accessible-page.large-text .section-header,
.ui-accessible-page.large-text .section-title,
.ui-accessible-page.large-text .ui-section-heading,
.ui-accessible-page.large-text .session-title,
.ui-accessible-page.large-text .settings-toggle-title {
  font-size: 44rpx;
  line-height: 1.45;
}

.ui-accessible-page.large-text .book-review-summary,
.ui-accessible-page.large-text .chapter-finished-detail,
.ui-accessible-page.large-text .empty-copy,
.ui-accessible-page.large-text .page-detail,
.ui-accessible-page.large-text .panel-copy,
.ui-accessible-page.large-text .reader-subtitle,
.ui-accessible-page.large-text .review-list-item,
.ui-accessible-page.large-text .revision-summary,
.ui-accessible-page.large-text .section-detail,
.ui-accessible-page.large-text .status-detail {
  font-size: 32rpx;
  line-height: 1.6;
}

.ui-accessible-page.large-text .book-content,
.ui-accessible-page.large-text .book-output-text,
.ui-accessible-page.large-text .chapter-content,
.ui-accessible-page.large-text .draft-content,
.ui-accessible-page.large-text .paragraph,
.ui-accessible-page.large-text .section-content,
.ui-accessible-page.large-text .small-section-content {
  font-size: 36rpx;
  line-height: 1.75;
}

.ui-accessible-page.large-text .chapter-meta,
.ui-accessible-page.large-text .hero-meta,
.ui-accessible-page.large-text .module-meta,
.ui-accessible-page.large-text .project-hint,
.ui-accessible-page.large-text .project-meta,
.ui-accessible-page.large-text .reader-meta,
.ui-accessible-page.large-text .reader-notice,
.ui-accessible-page.large-text .revision-meta,
.ui-accessible-page.large-text .section-meta,
.ui-accessible-page.large-text .session-meta,
.ui-accessible-page.large-text .summary-label {
  font-size: 28rpx;
  line-height: 1.5;
}

.ui-accessible-page.large-text button,
.ui-accessible-page.large-text input,
.ui-accessible-page.large-text textarea,
.ui-accessible-page.large-text .draft-section-action,
.ui-accessible-page.large-text .material-assignment-action,
.ui-accessible-page.large-text .primary-action,
.ui-accessible-page.large-text .reader-audio-action,
.ui-accessible-page.large-text .rewrite-action,
.ui-accessible-page.large-text .secondary-action,
.ui-accessible-page.large-text .settings-toggle,
.ui-accessible-page.large-text .structure-regenerate-action,
.ui-accessible-page.large-text .ui-version-option,
.ui-accessible-page.large-text .ui-block-action {
  min-height: 48px;
  font-size: 32rpx;
  line-height: 1.4;
}

.ui-pressable {
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.ui-pressable:active {
  transform: scale(0.96);
}

.ui-version-switch {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: var(--ui-surface-subtle);
}

.ui-version-option {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  color: var(--ui-text-secondary);
  font-size: 27rpx;
  font-weight: 700;
}

.ui-version-option.active {
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  box-shadow: var(--ui-control-shadow);
}

.ui-block-action {
  box-sizing: border-box;
  width: 100%;
  min-height: var(--ui-hit-size);
  margin-right: 0;
  margin-left: 0;
  padding-right: 24rpx;
  padding-left: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.ui-block-action.is-disabled {
  pointer-events: none;
  opacity: 0.62;
}

.ui-block-action.is-disabled:active {
  transform: none;
}

.ui-tabular {
  font-variant-numeric: tabular-nums;
}

.ui-image-outline {
  outline: 1rpx solid rgba(0, 0, 0, 0.1);
  outline-offset: -1rpx;
}
