page {
  min-height: 100vh;
  background: #f6f7f9;
  color: #17212b;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

view,
text,
button,
textarea,
image {
  box-sizing: border-box;
}

.avatar-mark {
  overflow: hidden;
}

.avatar-logo {
  width: 88%;
  height: 88%;
  display: block;
}

.action-art-icon {
  width: 88rpx;
  height: 88rpx;
  display: block;
  padding: 6rpx;
  border-radius: 24rpx;
  background: rgba(255, 247, 237, 0.96);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.72), 0 6rpx 16rpx rgba(64, 43, 24, 0.12);
  flex: 0 0 88rpx;
}

.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 56rpx;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.surface {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 32rpx;
}

.eyebrow {
  color: #9f4a3c;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.title {
  color: #111827;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.25;
  letter-spacing: 0;
}

.subtitle {
  color: #5b6573;
  font-size: 28rpx;
  line-height: 1.6;
}

.body-text {
  color: #273445;
  font-size: 30rpx;
  line-height: 1.75;
}

.muted {
  color: #6b7280;
  font-size: 26rpx;
}

.textarea {
  width: 100%;
  min-height: 260rpx;
  padding: 26rpx;
  border: 1rpx solid #d1d5db;
  border-radius: 14rpx;
  background: #ffffff;
  color: #111827;
  font-size: 30rpx;
  line-height: 1.6;
}

.button-row {
  display: flex;
  gap: 20rpx;
}

.button {
  min-height: 92rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 92rpx;
}

.button-primary {
  background: #9f4a3c;
  color: #ffffff;
}

.button-secondary {
  background: #fff1ec;
  color: #9f4a3c;
}

.button-quiet {
  background: #f3f4f6;
  color: #374151;
}

.button-danger {
  background: #fff1f2;
  color: #be123c;
}

.tts-inline {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
  vertical-align: middle;
}

.tts-icon-button {
  min-height: 62rpx;
  margin: 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 62rpx;
}

.tts-icon-button {
  width: 112rpx;
  height: 100rpx;
  min-height: 100rpx;
  padding: 0;
  border-radius: 28rpx;
  background: #fffaf2;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 112rpx;
  box-shadow: inset 0 0 0 2rpx rgba(240, 218, 192, 0.88), 0 8rpx 18rpx rgba(64, 43, 24, 0.08);
}

.tts-icon-button.active {
  background: #fff1ec;
  box-shadow: inset 0 0 0 3rpx rgba(159, 74, 60, 0.18), 0 10rpx 22rpx rgba(159, 74, 60, 0.14);
}

.tts-icon-button[disabled] {
  background: #fffaf2;
  opacity: 0.56;
}

.tts-icon {
  width: 104rpx;
  height: 92rpx;
  display: block;
}

.tts-icon-button::after {
  border: 0;
}

.tts-status {
  display: block;
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #fff6f1;
  color: #9f4a3c;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.45;
}

.tts-status.tts-error {
  background: #fff1f2;
  color: #be123c;
}

.stat-row {
  display: flex;
  gap: 16rpx;
}

.stat {
  flex: 1;
  padding: 24rpx;
  border-radius: 14rpx;
  background: #fff6f1;
}

.stat-value {
  color: #9f4a3c;
  font-size: 38rpx;
  font-weight: 800;
}

.stat-label {
  margin-top: 6rpx;
  color: #5b6573;
  font-size: 24rpx;
}

.error {
  padding: 24rpx;
  border-radius: 14rpx;
  background: #fff1f2;
  color: #be123c;
  font-size: 26rpx;
  line-height: 1.5;
}

.tap-hover {
  opacity: 0.82;
}

.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 132rpx;
  padding: 14rpx 18rpx 26rpx;
  border-top: 1rpx solid #e5ded2;
  background: rgba(255, 255, 255, 0.96);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  align-items: center;
  z-index: 20;
}

.bottom-nav-item {
  min-width: 0;
  height: 92rpx;
  color: #74706c;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.bottom-nav-item.active {
  color: #9f4a3c;
}

.bottom-nav-item text {
  display: block;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
}

.nav-mark {
  width: 46rpx;
  height: 46rpx;
  flex: 0 0 46rpx;
  position: relative;
  display: block;
}

.nav-mark::before,
.nav-mark::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
}

.home-mark::before {
  left: 11rpx;
  top: 20rpx;
  width: 24rpx;
  height: 18rpx;
  border: 4rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 5rpx 5rpx;
}

.home-mark::after {
  left: 10rpx;
  top: 7rpx;
  width: 26rpx;
  height: 26rpx;
  border-left: 4rpx solid currentColor;
  border-top: 4rpx solid currentColor;
  border-radius: 5rpx 0 0 0;
  transform: rotate(45deg);
  transform-origin: center;
}

.grid-mark {
  display: block;
}

.grid-mark::before {
  left: 5rpx;
  top: 5rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 5rpx;
  background: currentColor;
  box-shadow: 22rpx 0 0 currentColor, 0 22rpx 0 currentColor, 22rpx 22rpx 0 currentColor;
}

.chat-mark::before {
  left: 6rpx;
  top: 8rpx;
  width: 34rpx;
  height: 26rpx;
  border: 4rpx solid currentColor;
  border-radius: 18rpx;
}

.chat-mark::after {
  left: 27rpx;
  top: 29rpx;
  width: 10rpx;
  height: 10rpx;
  border-right: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(24deg);
  transform-origin: center;
}

.user-mark::before {
  left: 16rpx;
  top: 6rpx;
  width: 16rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.user-mark::after {
  left: 8rpx;
  top: 28rpx;
  width: 30rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-radius: 24rpx 24rpx 0 0;
  border-bottom: 0;
}
