page {
  min-height: 100vh;
  background: #f6f7f9;
  color: #17212b;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

view,
text,
button,
textarea,
image {
  box-sizing: border-box;
}

.avatar-mark {
  overflow: hidden;
}

.avatar-logo {
  width: 88%;
  height: 88%;
  display: block;
}

.action-art-icon {
  width: 88rpx;
  height: 88rpx;
  display: block;
  padding: 6rpx;
  border-radius: 24rpx;
  background: rgba(255, 247, 237, 0.96);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.72), 0 6rpx 16rpx rgba(64, 43, 24, 0.12);
  flex: 0 0 88rpx;
}

.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 56rpx;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.surface {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 32rpx;
}

.eyebrow {
  color: #9f4a3c;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.title {
  color: #111827;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.25;
  letter-spacing: 0;
}

.subtitle {
  color: #5b6573;
  font-size: 28rpx;
  line-height: 1.6;
}

.body-text {
  color: #273445;
  font-size: 30rpx;
  line-height: 1.75;
}

.muted {
  color: #6b7280;
  font-size: 26rpx;
}

.textarea {
  width: 100%;
  min-height: 260rpx;
  padding: 26rpx;
  border: 1rpx solid #d1d5db;
  border-radius: 14rpx;
  background: #ffffff;
  color: #111827;
  font-size: 30rpx;
  line-height: 1.6;
}

.button-row {
  display: flex;
  gap: 20rpx;
}

.button {
  min-height: 92rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 92rpx;
}

.button-primary {
  background: #9f4a3c;
  color: #ffffff;
}

.button-secondary {
  background: #fff1ec;
  color: #9f4a3c;
}

.button-quiet {
  background: #f3f4f6;
  color: #374151;
}

.button-danger {
  background: #fff1f2;
  color: #be123c;
}

.tts-inline {
  display: inline-flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 0;
  vertical-align: middle;
}

.tts-icon-button,
.tts-speed-chip {
  min-height: 56rpx;
  margin: 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.tts-icon-button {
  width: 90rpx;
  height: 82rpx;
  min-height: 82rpx;
  padding: 0;
  border-radius: 24rpx;
  background: transparent;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 90rpx;
}

.tts-icon-button.active {
  background: #fff1ec;
  box-shadow: 0 0 0 4rpx rgba(159, 74, 60, 0.12);
}

.tts-icon-button[disabled] {
  background: rgba(255, 255, 255, 0.72);
  opacity: 0.56;
}

.tts-icon {
  width: 84rpx;
  height: 76rpx;
  display: block;
}

.tts-speed-chip {
  width: 94rpx;
  height: 56rpx;
  padding: 0;
  flex: 0 0 94rpx;
  background: #f3f4f6;
  color: #374151;
}

.tts-icon-button::after,
.tts-speed-chip::after {
  border: 0;
}

.tts-status {
  display: block;
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #fff6f1;
  color: #9f4a3c;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.45;
}

.tts-status.tts-error {
  background: #fff1f2;
  color: #be123c;
}

.stat-row {
  display: flex;
  gap: 16rpx;
}

.stat {
  flex: 1;
  padding: 24rpx;
  border-radius: 14rpx;
  background: #fff6f1;
}

.stat-value {
  color: #9f4a3c;
  font-size: 38rpx;
  font-weight: 800;
}

.stat-label {
  margin-top: 6rpx;
  color: #5b6573;
  font-size: 24rpx;
}

.error {
  padding: 24rpx;
  border-radius: 14rpx;
  background: #fff1f2;
  color: #be123c;
  font-size: 26rpx;
  line-height: 1.5;
}

.tap-hover {
  opacity: 0.82;
}

.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 132rpx;
  padding: 14rpx 18rpx 26rpx;
  border-top: 1rpx solid #e5ded2;
  background: rgba(255, 255, 255, 0.96);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  z-index: 20;
}

.bottom-nav-item {
  color: #74706c;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
}

.bottom-nav-item.active {
  color: #9f4a3c;
}

.nav-mark {
  width: 42rpx;
  height: 42rpx;
  position: relative;
}

.home-mark::before {
  content: "";
  position: absolute;
  left: 9rpx;
  top: 15rpx;
  width: 24rpx;
  height: 22rpx;
  border: 4rpx solid currentColor;
  border-top: 0;
  border-radius: 4rpx;
}

.home-mark::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 4rpx;
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid currentColor;
  border-top: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.grid-mark {
  display: grid;
  grid-template-columns: repeat(2, 14rpx);
  grid-template-rows: repeat(2, 14rpx);
  gap: 8rpx;
  justify-content: center;
  align-content: center;
}

.grid-mark::before,
.grid-mark::after {
  content: "";
  width: 14rpx;
  height: 14rpx;
  border-radius: 5rpx;
  background: currentColor;
  box-shadow: 22rpx 0 0 currentColor, 0 22rpx 0 currentColor, 22rpx 22rpx 0 currentColor;
}

.chat-mark::before {
  content: "";
  position: absolute;
  left: 5rpx;
  top: 7rpx;
  width: 32rpx;
  height: 26rpx;
  border: 4rpx solid currentColor;
  border-radius: 18rpx;
}

.chat-mark::after {
  content: "";
  position: absolute;
  left: 24rpx;
  top: 29rpx;
  width: 10rpx;
  height: 10rpx;
  border-right: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(20deg);
}

.user-mark::before {
  content: "";
  position: absolute;
  left: 13rpx;
  top: 4rpx;
  width: 16rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.user-mark::after {
  content: "";
  position: absolute;
  left: 7rpx;
  top: 26rpx;
  width: 28rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-radius: 24rpx 24rpx 0 0;
  border-bottom: 0;
}
