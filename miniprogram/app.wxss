page {
  --ui-page-background: #f5f1ea;
  --ui-page-background-deep: #eee7dd;
  --ui-surface: #fffdfa;
  --ui-surface-soft: #faf7f2;
  --ui-surface-subtle: #f2ece4;
  --ui-text-primary: #302925;
  --ui-text-secondary: #625953;
  --ui-text-muted: #6a6059;
  --ui-on-accent: #ffffff;
  --ui-section-title: #8d4d40;
  --ui-value-text: #5f5550;
  --ui-accent: #b65d49;
  --ui-accent-strong: #944535;
  --ui-accent-surface: #f5e6e0;
  --ui-accent-surface-subtle: #fbf3ef;
  --ui-accent-border: #e7c6bc;
  --ui-border: #e9e1d7;
  --ui-divider: #eee7df;
  --ui-switch-off: #d8d3cc;
  --ui-danger-surface: #fff0ed;
  --ui-danger-text: #a8493f;
  --ui-success-surface: #eaf1e6;
  --ui-success-text: #587052;
  --ui-warning-surface: #fbf0dc;
  --ui-warning-text: #866231;
  --ui-info-surface: #edf1f5;
  --ui-info-text: #53677a;
  --ui-radius-card: 28rpx;
  --ui-radius-inner: 20rpx;
  --ui-radius-control: 18rpx;
  --ui-page-inline: 32rpx;
  --ui-font-sans: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", Helvetica, Arial, sans-serif;
  --ui-font-editorial: "Songti SC", STSong, "Noto Serif CJK SC", serif;
  /* Shared reading scale. Keep page display titles and decorative cover lettering local. */
  --ui-font-caption: 26rpx;
  --ui-font-meta: 28rpx;
  --ui-font-body: 29rpx;
  --ui-font-action: 30rpx;
  --ui-font-list-title: 31rpx;
  --ui-font-section-title: 35rpx;
  --ui-font-page-title: 42rpx;
  --ui-font-large-caption: 30rpx;
  --ui-font-large-meta: 32rpx;
  --ui-font-large-body: 34rpx;
  --ui-font-large-list-title: 36rpx;
  --ui-line-meta: 1.45;
  --ui-line-body: 1.5;
  --ui-fixed-action-background: linear-gradient(180deg, rgba(245, 241, 234, 0), rgba(245, 241, 234, 0.94) 28rpx, #f5f1ea 64rpx);
  --ui-card-shadow:
    0 0 0 1rpx rgba(54, 42, 34, 0.035),
    0 4rpx 12rpx rgba(63, 47, 37, 0.035),
    0 18rpx 42rpx rgba(63, 47, 37, 0.045);
  --ui-card-shadow-raised:
    0 0 0 1rpx rgba(54, 42, 34, 0.045),
    0 8rpx 20rpx rgba(63, 47, 37, 0.05),
    0 24rpx 52rpx rgba(63, 47, 37, 0.065);
  --ui-control-shadow:
    0 0 0 1rpx rgba(54, 42, 34, 0.055),
    0 4rpx 12rpx rgba(63, 47, 37, 0.035);
  --ui-hit-size: 88rpx;
  min-height: 100vh;
  background: var(--ui-page-background);
  color: var(--ui-text-primary);
  font-family: var(--ui-font-sans);
  line-height: var(--ui-line-body);
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
textarea,
input,
image {
  box-sizing: border-box;
}

button,
input,
textarea {
  font-family: var(--ui-font-sans);
}

.ui-page-shell {
  min-height: 100vh;
  background:
    linear-gradient(180deg, rgba(255, 253, 250, 0.72) 0, rgba(245, 241, 234, 0) 320rpx),
    var(--ui-page-background);
}

.ui-card {
  box-sizing: border-box;
  border: 0;
  border-radius: var(--ui-radius-card);
  background: var(--ui-surface);
  box-shadow: var(--ui-card-shadow);
}

.ui-card.ui-card-borderless {
  border: 0;
}

.ui-card.ui-card-raised {
  box-shadow: var(--ui-card-shadow-raised);
}

.ui-section-heading {
  display: block;
  color: var(--ui-section-title);
  font-size: var(--ui-font-section-title);
  font-weight: 800;
  line-height: 1.35;
  font-family: var(--ui-font-editorial);
  letter-spacing: 0.02em;
  text-wrap: balance;
}

.ui-page-shell.ui-fixed-action-page {
  padding-bottom: calc(var(--ui-fixed-action-space, 168rpx) + env(safe-area-inset-bottom));
}

.ui-fixed-action-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  padding:
    var(--ui-fixed-action-top, 24rpx)
    var(--ui-fixed-action-inline, 32rpx)
    calc(var(--ui-fixed-action-bottom, 24rpx) + env(safe-area-inset-bottom));
  background: var(--ui-fixed-action-background);
}

.ui-button {
  margin: 0;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

button::after {
  border: 0;
}

.ui-button:active {
  transform: scale(0.96);
}

.ui-button[disabled] {
  opacity: 0.62;
  transform: none;
}

.ui-error-banner {
  padding: 22rpx 26rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
  font-size: 28rpx;
  line-height: 1.45;
  word-break: break-word;
}

.ui-accent-action-hover {
  background: var(--ui-accent-surface-subtle);
  transform: scale(0.96);
  box-shadow:
    0 0 0 1rpx rgba(182, 93, 73, 0.20),
    0 4rpx 10rpx rgba(0, 0, 0, 0.05);
}

.ui-subtle-action-hover {
  background: var(--ui-surface-subtle);
  transform: scale(0.96);
}

.ui-consent-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  column-gap: 8rpx;
}

.ui-consent-choice,
.ui-consent-link {
  min-height: var(--ui-hit-size);
  display: inline-flex;
  align-items: center;
}

.ui-consent-choice {
  gap: 16rpx;
}

.ui-consent-link {
  padding: 0 8rpx;
  border-radius: 12rpx;
  color: var(--ui-accent);
  font-weight: 700;
}

.ui-avatar-action-hover {
  transform: scale(0.96);
  box-shadow: 0 0 0 8rpx rgba(182, 93, 73, 0.10);
}

.ui-page-context-row {
  min-height: 56rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.ui-page-context {
  min-width: 0;
  display: block;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  line-height: var(--ui-line-meta);
  overflow-wrap: anywhere;
  text-wrap: pretty;
}

.large-text .ui-page-context {
  font-size: var(--ui-font-large-body);
  line-height: 1.5;
}

.ui-accessible-page.large-text {
  --ui-hit-size: 96rpx;
}

.ui-accessible-page.large-text .brand-title,
.ui-accessible-page.large-text .hero-title,
.ui-accessible-page.large-text .page-title,
.ui-accessible-page.large-text .reader-title,
.ui-accessible-page.large-text .revision-title,
.ui-accessible-page.large-text .status-title {
  font-size: 60rpx;
  line-height: 1.35;
}

.ui-accessible-page.large-text .summary-value {
  font-size: 50rpx;
}

.ui-accessible-page.large-text .asset-title,
.ui-accessible-page.large-text .book-design-title,
.ui-accessible-page.large-text .book-review-title,
.ui-accessible-page.large-text .chapter-title,
.ui-accessible-page.large-text .draft-section-title,
.ui-accessible-page.large-text .empty-title,
.ui-accessible-page.large-text .module-title,
.ui-accessible-page.large-text .panel-title,
.ui-accessible-page.large-text .project-title,
.ui-accessible-page.large-text .section-name,
.ui-accessible-page.large-text .section-header,
.ui-accessible-page.large-text .section-title,
.ui-accessible-page.large-text .ui-section-heading,
.ui-accessible-page.large-text .session-title,
.ui-accessible-page.large-text .settings-toggle-title {
  font-size: 44rpx;
  line-height: 1.45;
}

.ui-accessible-page.large-text .book-review-summary,
.ui-accessible-page.large-text .chapter-finished-detail,
.ui-accessible-page.large-text .empty-copy,
.ui-accessible-page.large-text .page-detail,
.ui-accessible-page.large-text .panel-copy,
.ui-accessible-page.large-text .reader-subtitle,
.ui-accessible-page.large-text .review-list-item,
.ui-accessible-page.large-text .revision-summary,
.ui-accessible-page.large-text .section-detail,
.ui-accessible-page.large-text .status-detail {
  font-size: var(--ui-font-large-list-title);
  line-height: 1.6;
}

.ui-accessible-page.large-text .book-content,
.ui-accessible-page.large-text .book-output-text,
.ui-accessible-page.large-text .chapter-content,
.ui-accessible-page.large-text .draft-content,
.ui-accessible-page.large-text .paragraph,
.ui-accessible-page.large-text .section-content,
.ui-accessible-page.large-text .small-section-content {
  font-size: 36rpx;
  line-height: 1.75;
}

.ui-accessible-page.large-text .chapter-meta,
.ui-accessible-page.large-text .hero-meta,
.ui-accessible-page.large-text .module-meta,
.ui-accessible-page.large-text .project-hint,
.ui-accessible-page.large-text .project-meta,
.ui-accessible-page.large-text .reader-meta,
.ui-accessible-page.large-text .reader-notice,
.ui-accessible-page.large-text .revision-meta,
.ui-accessible-page.large-text .section-meta,
.ui-accessible-page.large-text .session-meta,
.ui-accessible-page.large-text .summary-label {
  font-size: var(--ui-font-large-meta);
  line-height: 1.5;
}

.ui-accessible-page.large-text button,
.ui-accessible-page.large-text input,
.ui-accessible-page.large-text textarea,
.ui-accessible-page.large-text .draft-section-action,
.ui-accessible-page.large-text .material-assignment-action,
.ui-accessible-page.large-text .primary-action,
.ui-accessible-page.large-text .reader-audio-action,
.ui-accessible-page.large-text .rewrite-action,
.ui-accessible-page.large-text .secondary-action,
.ui-accessible-page.large-text .settings-toggle,
.ui-accessible-page.large-text .structure-regenerate-action,
.ui-accessible-page.large-text .ui-version-option,
.ui-accessible-page.large-text .ui-block-action {
  min-height: 48px;
  font-size: var(--ui-font-large-list-title);
  line-height: 1.4;
}

.ui-pressable {
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.ui-pressable:active {
  transform: scale(0.96);
}

.ui-version-switch {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 8rpx;
  border-radius: var(--ui-radius-inner);
  background: var(--ui-surface-subtle);
}

.ui-version-option {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: var(--ui-text-secondary);
  font-size: var(--ui-font-meta);
  font-weight: 700;
}

.ui-version-option.active {
  background: var(--ui-surface);
  color: var(--ui-accent-strong);
  box-shadow: var(--ui-control-shadow);
}

.ui-block-action {
  box-sizing: border-box;
  width: 100%;
  min-height: var(--ui-hit-size);
  margin-right: 0;
  margin-left: 0;
  padding-right: 24rpx;
  padding-left: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.ui-block-action.is-disabled {
  pointer-events: none;
  opacity: 0.62;
}

.ui-block-action.is-disabled:active {
  transform: none;
}

.ui-tabular {
  font-variant-numeric: tabular-nums;
}

.ui-image-outline {
  outline: 1rpx solid rgba(0, 0, 0, 0.1);
  outline-offset: -1rpx;
}
