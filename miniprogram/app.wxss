page {
  --ui-page-background: #f7f3ec;
  --ui-surface: #fffdfc;
  --ui-surface-subtle: #f4f0eb;
  --ui-text-primary: #2e2724;
  --ui-text-secondary: #6f6864;
  --ui-text-muted: #8a827d;
  --ui-on-accent: #ffffff;
  --ui-section-title: #77473f;
  --ui-value-text: #5d514d;
  --ui-accent: #a84f43;
  --ui-accent-strong: #8f4037;
  --ui-accent-surface: #f6e9e6;
  --ui-accent-surface-subtle: #fbf4f2;
  --ui-accent-border: #dfc0ba;
  --ui-border: #e9e2da;
  --ui-divider: #ece6df;
  --ui-switch-off: #d8d6d2;
  --ui-danger-surface: #fff1f1;
  --ui-danger-text: #b64545;
  --ui-success-surface: #edf3ea;
  --ui-success-text: #5a7454;
  --ui-warning-surface: #fff5de;
  --ui-warning-text: #7d5c25;
  --ui-card-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.04),
    0 2rpx 6rpx rgba(0, 0, 0, 0.03),
    0 12rpx 28rpx rgba(0, 0, 0, 0.04);
  --ui-card-shadow-raised:
    0 0 0 1rpx rgba(0, 0, 0, 0.05),
    0 4rpx 10rpx rgba(0, 0, 0, 0.04),
    0 18rpx 42rpx rgba(0, 0, 0, 0.06);
  --ui-control-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.06);
  --ui-hit-size: 88rpx;
  min-height: 100vh;
  background: var(--ui-page-background);
  color: var(--ui-text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", Helvetica, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
textarea,
image {
  box-sizing: border-box;
}

.ui-page-shell {
  min-height: 100vh;
  background: var(--ui-page-background);
}

.ui-error-banner {
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background: var(--ui-danger-surface);
  color: var(--ui-danger-text);
  font-size: 28rpx;
  line-height: 1.45;
  word-break: break-word;
}

.ui-accent-action-hover {
  background: var(--ui-accent-surface-subtle);
  transform: scale(0.96);
  box-shadow:
    0 0 0 1rpx rgba(168, 79, 67, 0.20),
    0 4rpx 10rpx rgba(0, 0, 0, 0.05);
}

.ui-subtle-action-hover {
  background: var(--ui-surface-subtle);
  transform: scale(0.96);
}

.ui-avatar-action-hover {
  transform: scale(0.96);
  box-shadow: 0 0 0 8rpx rgba(168, 79, 67, 0.10);
}

.tap-hover {
  opacity: 0.82;
}

.ui-page-context-row {
  min-height: 56rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.ui-page-context {
  min-width: 0;
  display: block;
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
  text-wrap: pretty;
}

.large-text .ui-page-context {
  font-size: 30rpx;
  line-height: 1.5;
}

.ui-pressable {
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.ui-pressable:active {
  transform: scale(0.96);
}

.ui-block-action {
  box-sizing: border-box;
  width: 100%;
  min-height: var(--ui-hit-size);
  margin-right: 0;
  margin-left: 0;
  padding-right: 24rpx;
  padding-left: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.ui-block-action.is-disabled {
  pointer-events: none;
  opacity: 0.62;
}

.ui-block-action.is-disabled:active {
  transform: none;
}

.ui-tabular {
  font-variant-numeric: tabular-nums;
}

.ui-image-outline {
  outline: 1rpx solid rgba(0, 0, 0, 0.1);
  outline-offset: -1rpx;
}
