page {
  --ui-page-background: #fcf7ed;
  --ui-surface: #ffffff;
  --ui-surface-warm: #fffdf9;
  --ui-text-primary: #2b1713;
  --ui-text-secondary: #6f625b;
  --ui-accent: #a64b3e;
  --ui-accent-strong: #8f3e35;
  --ui-danger-surface: #fff1f3;
  --ui-danger-text: #a83f50;
  --ui-success-surface: #eef2e8;
  --ui-success-text: #5f6f4f;
  --ui-card-radius: 24rpx;
  --ui-control-radius: 22rpx;
  --ui-card-shadow: 0 12rpx 32rpx rgba(64, 43, 24, 0.07);
  --ui-card-shadow-raised: 0 18rpx 42rpx rgba(63, 45, 35, 0.09);
  --ui-hit-size: 88rpx;
  min-height: 100vh;
  background: var(--ui-page-background);
  color: #3a2a25;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", Helvetica, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
textarea,
image {
  box-sizing: border-box;
}

.tap-hover {
  opacity: 0.82;
}

.ui-page-context-row {
  min-height: 56rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.ui-page-context {
  min-width: 0;
  display: block;
  color: var(--ui-text-secondary);
  font-size: 26rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
  text-wrap: pretty;
}

.large-text .ui-page-context {
  font-size: 30rpx;
  line-height: 1.5;
}

.ui-pressable {
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.ui-pressable:active {
  transform: scale(0.96);
}

.ui-block-action {
  box-sizing: border-box;
  width: 100%;
  min-height: var(--ui-hit-size);
  margin-right: 0;
  margin-left: 0;
  padding-right: 24rpx;
  padding-left: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.ui-block-action.is-disabled {
  pointer-events: none;
  opacity: 0.62;
}

.ui-tabular {
  font-variant-numeric: tabular-nums;
}

.ui-image-outline {
  outline: 1rpx solid rgba(0, 0, 0, 0.1);
  outline-offset: -1rpx;
}
