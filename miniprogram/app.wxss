page {
  min-height: 100vh;
  background: #fcf7ed;
  color: #3a2a25;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", Helvetica, Arial, sans-serif;
}

view,
text,
button,
textarea,
image {
  box-sizing: border-box;
}

.avatar-mark {
  overflow: hidden;
}

.avatar-logo {
  width: 88%;
  height: 88%;
  display: block;
}

.action-art-icon {
  width: 88rpx;
  height: 88rpx;
  display: block;
  padding: 6rpx;
  border-radius: 24rpx;
  background: rgba(255, 247, 237, 0.96);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.72), 0 6rpx 16rpx rgba(64, 43, 24, 0.12);
  flex: 0 0 88rpx;
}

.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 56rpx;
  background: #fcf7ed;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.surface {
  background: #ffffff;
  border: 1rpx solid #e8d8c3;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(93, 61, 42, 0.06);
}

.eyebrow {
  color: #a64b3e;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.title {
  color: #2b1713;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 52rpx;
  letter-spacing: 0;
}

.subtitle {
  color: #7b6f68;
  font-size: 28rpx;
  line-height: 1.6;
}

.body-text {
  color: #3a2a25;
  font-size: 30rpx;
  line-height: 1.72;
}

.muted {
  color: #7b6f68;
  font-size: 26rpx;
}

.textarea {
  width: 100%;
  min-height: 260rpx;
  padding: 26rpx;
  border: 1rpx solid #e8d8c3;
  border-radius: 18rpx;
  background: #ffffff;
  color: #3a2a25;
  font-size: 30rpx;
  line-height: 1.6;
}

.button-row {
  display: flex;
  gap: 20rpx;
}

.button {
  min-height: 88rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.button-primary {
  background: #a64b3e;
  color: #ffffff;
}

.button-secondary {
  background: #f8e8e2;
  color: #8f3e35;
}

.button-quiet {
  background: #ffffff;
  color: #7b4a40;
  border: 1rpx solid #d8c4b2;
}

.button-danger {
  background: #fff1f3;
  color: #b84a5a;
}

.stat-row {
  display: flex;
  gap: 16rpx;
}

.stat {
  flex: 1;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #fff9f3;
}

.stat-value {
  color: #a64b3e;
  font-size: 38rpx;
  font-weight: 800;
}

.stat-label {
  margin-top: 6rpx;
  color: #7b6f68;
  font-size: 24rpx;
}

.error {
  padding: 24rpx;
  border-radius: 18rpx;
  background: #fff1f3;
  color: #b84a5a;
  font-size: 26rpx;
  line-height: 1.5;
}

.tag-status {
  display: inline-flex;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eef4ea;
  color: #5f7e55;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.tag-count {
  display: inline-flex;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f6eee5;
  color: #8b6a55;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.tag-chapter {
  display: inline-flex;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff3ef;
  color: #a64b3e;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.tag-warning {
  display: inline-flex;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff2d9;
  color: #9a6a24;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.tag-ai {
  display: inline-flex;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f3efea;
  color: #7a6b60;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.tap-hover {
  opacity: 0.82;
}

.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 132rpx;
  padding: 14rpx 18rpx 26rpx;
  border-top: 1rpx solid #efe6da;
  background: rgba(255, 255, 255, 0.96);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  align-items: center;
  z-index: 20;
}

.bottom-nav-item {
  min-width: 0;
  height: 92rpx;
  color: #7b6f68;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.bottom-nav-item.active {
  color: #a64b3e;
}

.bottom-nav-item text {
  display: block;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
}

.nav-mark {
  width: 46rpx;
  height: 46rpx;
  flex: 0 0 46rpx;
  position: relative;
  display: block;
}

.nav-mark::before,
.nav-mark::after {
  content: "";
  position: absolute;
  box-sizing: border-box;
}

.home-mark::before {
  left: 11rpx;
  top: 20rpx;
  width: 24rpx;
  height: 18rpx;
  border: 4rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 5rpx 5rpx;
}

.home-mark::after {
  left: 10rpx;
  top: 7rpx;
  width: 26rpx;
  height: 26rpx;
  border-left: 4rpx solid currentColor;
  border-top: 4rpx solid currentColor;
  border-radius: 5rpx 0 0 0;
  transform: rotate(45deg);
  transform-origin: center;
}

.grid-mark {
  display: block;
}

.grid-mark::before {
  left: 5rpx;
  top: 5rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 5rpx;
  background: currentColor;
  box-shadow: 22rpx 0 0 currentColor, 0 22rpx 0 currentColor, 22rpx 22rpx 0 currentColor;
}

.chat-mark::before {
  left: 6rpx;
  top: 8rpx;
  width: 34rpx;
  height: 26rpx;
  border: 4rpx solid currentColor;
  border-radius: 18rpx;
}

.chat-mark::after {
  left: 27rpx;
  top: 29rpx;
  width: 10rpx;
  height: 10rpx;
  border-right: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(24deg);
  transform-origin: center;
}

.user-mark::before {
  left: 14rpx;
  top: 6rpx;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.user-mark::after {
  left: 8rpx;
  top: 28rpx;
  width: 30rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-radius: 24rpx 24rpx 0 0;
  border-bottom: 0;
}
