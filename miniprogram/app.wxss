page {
  min-height: 100vh;
  background: #fcf7ed;
  color: #3a2a25;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", Helvetica, Arial, sans-serif;
}

view,
text,
button,
textarea,
image {
  box-sizing: border-box;
}

.tap-hover {
  opacity: 0.82;
}
