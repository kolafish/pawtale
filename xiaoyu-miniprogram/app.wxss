page {
  --color-bg: #f3f7f6;
  --color-surface: #ffffff;
  --color-surface-soft: #eaf3f1;
  --color-text: #173433;
  --color-muted: #637775;
  --color-accent: #267a78;
  --color-accent-strong: #1d605f;
  --color-border: #d8e4e1;
  --color-danger: #a33d3d;
  --shadow-card: 0 2rpx 4rpx rgba(19, 63, 61, 0.06),
    0 14rpx 34rpx rgba(19, 63, 61, 0.08);
  background: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  -webkit-font-smoothing: antialiased;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 36rpx 120rpx;
}

.card {
  border: 2rpx solid var(--color-border);
  border-radius: 30rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.pressable {
  min-height: 88rpx;
  transition-property: transform, background-color, border-color, box-shadow, opacity;
  transition-duration: 150ms;
  transition-timing-function: ease-out;
}

.pressable-hover {
  transform: scale(0.96);
  opacity: 0.88;
}

.error-banner {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border: 2rpx solid rgba(163, 61, 61, 0.22);
  border-radius: 22rpx;
  background: #fff1f0;
  color: var(--color-danger);
  font-size: 27rpx;
  line-height: 1.5;
}

.numeric {
  font-variant-numeric: tabular-nums;
}
