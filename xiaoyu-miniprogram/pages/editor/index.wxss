.editor-page {
  padding-top: 28rpx;
}

.paper {
  min-height: calc(100vh - 176rpx);
  box-sizing: border-box;
  padding: 42rpx 34rpx;
}

.title-input {
  height: 88rpx;
  color: var(--color-text);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.3;
}

.status-row {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 25rpx;
}

.save-status {
  color: var(--color-muted);
}

.save-saving,
.save-unsaved {
  color: var(--color-accent);
}

.save-conflict {
  color: var(--color-danger);
  font-weight: 700;
}

.divider {
  height: 2rpx;
  margin: 26rpx 0 30rpx;
  background: var(--color-border);
}

.content-input {
  width: 100%;
  height: calc(100vh - 390rpx);
  min-height: 720rpx;
  color: var(--color-text);
  font-size: 32rpx;
  line-height: 1.85;
  text-wrap: pretty;
}

.loading {
  padding: 70rpx 32rpx;
  color: var(--color-muted);
  font-size: 29rpx;
  text-align: center;
}

.reload-button {
  margin: 20rpx 0 0;
  border-radius: 18rpx;
  background: var(--color-danger);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}
