.editor-page {
  padding-top: 28rpx;
}

.paper {
  min-height: calc(100vh - 176rpx);
  box-sizing: border-box;
  padding: 42rpx 34rpx;
}

.title-input {
  height: 88rpx;
  color: var(--color-text);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.3;
}

.status-row {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 25rpx;
}

.save-status {
  color: var(--color-muted);
}

.save-saving,
.save-unsaved {
  color: var(--color-accent);
}

.save-conflict {
  color: var(--color-danger);
  font-weight: 700;
}

.divider {
  height: 2rpx;
  margin: 26rpx 0;
  background: var(--color-border);
}

.dictation-panel {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 28rpx;
  padding: 22rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-surface-soft);
  transition-property: background-color, border-color;
  transition-duration: 150ms;
}

.dictation-panel.is-active {
  border-color: rgba(38, 122, 120, 0.52);
  background: #e2f1ee;
}

.dictation-copy {
  flex: 1;
  min-width: 0;
}

.dictation-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--color-text);
  font-size: 27rpx;
  font-weight: 700;
}

.dictation-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: var(--color-accent);
  box-shadow: 0 0 0 8rpx rgba(38, 122, 120, 0.12);
}

.dictation-hint {
  display: block;
  margin-top: 10rpx;
  color: var(--color-muted);
  font-size: 23rpx;
  line-height: 1.45;
}

.dictation-button {
  flex: 0 0 auto;
  min-width: 164rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: var(--color-accent);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.dictation-button.is-recording {
  background: var(--color-danger);
}

.dictation-button[disabled] {
  background: #8aabaa;
  color: #fff;
}

.content-input {
  width: 100%;
  height: calc(100vh - 570rpx);
  min-height: 600rpx;
  color: var(--color-text);
  font-size: 32rpx;
  line-height: 1.85;
  text-wrap: pretty;
}

.loading {
  padding: 70rpx 32rpx;
  color: var(--color-muted);
  font-size: 29rpx;
  text-align: center;
}

.reload-button {
  margin: 20rpx 0 0;
  border-radius: 18rpx;
  background: var(--color-danger);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}
