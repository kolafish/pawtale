<view class="page editor-page">
  <view wx:if="{{error}}" class="error-banner">
    <text>{{error}}</text>
    <button
      wx:if="{{saveState === 'conflict'}}"
      class="reload-button pressable"
      bindtap="reloadArticle"
      hover-class="pressable-hover"
    >
      重新载入
    </button>
  </view>

  <view wx:if="{{loading}}" class="loading card">正在打开文章…</view>

  <view wx:else class="paper card">
    <input
      class="title-input"
      value="{{title}}"
      maxlength="80"
      placeholder="文章标题"
      disabled="{{aiBusy}}"
      bindinput="onTitleInput"
      bindblur="onTitleBlur"
    />

    <view class="status-row">
      <text class="numeric">{{wordCount}} 字</text>
      <text class="save-status save-{{saveState}}">{{saveText}}</text>
    </view>

    <view class="divider"></view>

    <view class="dictation-panel {{dictationActive ? 'is-active' : ''}}">
      <view class="dictation-copy">
        <view class="dictation-status">
          <view class="dictation-dot"></view>
          <text>{{dictationStatusText}}</text>
        </view>
        <text class="dictation-hint">语音用于实时转文字，停止后自动保存正文。</text>
      </view>
      <button
        class="dictation-button pressable {{dictationState === 'recording' ? 'is-recording' : ''}}"
        disabled="{{dictationDisabled || saveState === 'conflict' || aiBusy}}"
        bindtap="toggleDictation"
        hover-class="pressable-hover"
      >
        {{dictationButtonText}}
      </button>
    </view>

    <textarea
      class="content-input"
      value="{{content}}"
      cursor="{{cursorPosition}}"
      maxlength="-1"
      placeholder="从这里开始写。可以先把想到的都记下来。"
      bindinput="onContentInput"
      disabled="{{saveState === 'conflict' || dictationActive || aiBusy}}"
      show-confirm-bar="{{false}}"
    ></textarea>

    <view class="ai-panel">
      <view class="ai-heading-row">
        <text class="ai-heading">AI 写作助手</text>
        <text class="ai-note">根据正文判断文体、目的和语气，不套固定格式。</text>
      </view>
      <textarea
        class="ai-instruction"
        value="{{aiInstruction}}"
        maxlength="300"
        placeholder="可以写要求，例如：语气自然一些、结尾更有力量（修改时必填）"
        bindinput="onAIInstructionInput"
        disabled="{{aiBusy || dictationActive || saveState === 'conflict'}}"
        show-confirm-bar="{{false}}"
      ></textarea>
      <view class="ai-actions">
        <button
          class="ai-action pressable"
          data-action="continue"
          disabled="{{aiBusy || dictationActive || saveState === 'conflict'}}"
          bindtap="runAIAction"
          hover-class="pressable-hover"
        >{{aiAction === "continue" ? "续写中" : "接着写"}}</button>
        <button
          class="ai-action pressable"
          data-action="revise"
          disabled="{{aiBusy || dictationActive || saveState === 'conflict'}}"
          bindtap="runAIAction"
          hover-class="pressable-hover"
        >{{aiAction === "revise" ? "修改中" : "按要求改"}}</button>
        <button
          class="ai-action pressable"
          data-action="review"
          disabled="{{aiBusy || dictationActive || saveState === 'conflict'}}"
          bindtap="runAIAction"
          hover-class="pressable-hover"
        >{{aiAction === "review" ? "检查中" : "检查文章"}}</button>
      </view>
    </view>

    <view wx:if="{{aiResultKind !== 'none'}}" class="ai-result">
      <text class="ai-result-summary">{{aiSummary}}</text>
      <scroll-view wx:if="{{aiResultKind === 'revision'}}" scroll-y class="ai-proposal">
        <text selectable>{{aiProposal}}</text>
      </scroll-view>
      <view
        wx:for="{{aiSuggestions}}"
        wx:key="index"
        class="ai-suggestion"
      >
        <text wx:if="{{item.excerpt}}" class="ai-excerpt">“{{item.excerpt}}”</text>
        <text class="ai-issue">{{item.issue}}</text>
        <text class="ai-suggestion-copy">{{item.suggestion}}</text>
      </view>
      <view class="ai-result-actions">
        <button
          wx:if="{{aiResultKind === 'revision'}}"
          class="apply-button pressable"
          disabled="{{aiBusy || saveState === 'conflict'}}"
          bindtap="applyAIRevision"
          hover-class="pressable-hover"
        >采用这版</button>
        <button
          class="dismiss-button pressable"
          disabled="{{aiBusy}}"
          bindtap="dismissAIResult"
          hover-class="pressable-hover"
        >收起</button>
      </view>
    </view>
  </view>
</view>
