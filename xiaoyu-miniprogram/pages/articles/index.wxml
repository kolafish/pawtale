<view class="page articles-page">
  <view class="hero">
    <text class="eyebrow">小鱼口述</text>
    <text class="headline">把想到的，慢慢写成文章</text>
    <text class="intro">随时记录，内容会自动保存。</text>
  </view>

  <view wx:if="{{error}}" class="error-banner">{{error}}</view>

  <button
    class="create-button pressable"
    disabled="{{busy}}"
    bindtap="createArticle"
    hover-class="pressable-hover"
  >
    {{busy && !deletingId ? "正在新建" : "新建文章"}}
  </button>

  <view wx:if="{{loading && !articles.length}}" class="empty card">正在加载文章…</view>
  <view wx:elif="{{!articles.length}}" class="empty card">
    <text class="empty-title">还没有文章</text>
    <text class="empty-hint">点击“新建文章”开始写作。</text>
  </view>

  <view
    wx:for="{{articles}}"
    wx:key="id"
    class="article-card card pressable"
    data-id="{{item.id}}"
    bindtap="openArticle"
    hover-class="pressable-hover"
  >
    <view class="article-main">
      <text class="article-title">{{item.title || "未命名文章"}}</text>
      <text class="article-meta numeric">{{item.wordCountText}} · {{item.updatedText || "刚刚更新"}}</text>
    </view>
    <button
      class="delete-button pressable"
      data-id="{{item.id}}"
      disabled="{{busy}}"
      catchtap="deleteArticle"
      hover-class="pressable-hover"
    >
      {{deletingId === item.id ? "删除中" : "删除"}}
    </button>
  </view>
</view>
