# Copy this file to .env.e2e.local and keep the copy untracked.
# The account must be dedicated to automated testing.
PAWTALE_E2E_EMAIL=
PAWTALE_E2E_PASSWORD=

# Optional overrides. Defaults match the local macOS setup and repository root.
# PAWTALE_E2E_CLI_PATH=/Applications/wechatwebdevtools.app/Contents/MacOS/cli
# PAWTALE_E2E_PROJECT_PATH=/absolute/path/to/Pawtale
# Leave unset to allocate an available local port for this run.
# PAWTALE_E2E_AUTOMATION_PORT=9420
# PAWTALE_E2E_HTTP_BASE_URL=https://pawtale-api.spaceflows.cn
# PAWTALE_E2E_WS_BASE_URL=wss://pawtale-api.spaceflows.cn

# Optional iOS real-device settings. By default the runner prints a QR code and
# waits up to three minutes for WeChat on the iPhone to connect.
# PAWTALE_E2E_IOS_AUTO_CONNECT=false
# PAWTALE_E2E_IOS_CONNECT_TIMEOUT_MS=180000
