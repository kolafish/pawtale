# Copy this file to .env.e2e.local and keep the copy untracked.
# The account must be dedicated to automated testing.
PAWTALE_E2E_EMAIL=
PAWTALE_E2E_PASSWORD=

# Optional overrides. Defaults match the local macOS setup and repository root.
# PAWTALE_E2E_CLI_PATH=/Applications/wechatwebdevtools.app/Contents/MacOS/cli
# PAWTALE_E2E_PROJECT_PATH=/absolute/path/to/Pawtale
# Leave unset to allocate an available local port for this run.
# PAWTALE_E2E_AUTOMATION_PORT=9420
# PAWTALE_E2E_HTTP_BASE_URL=https://pawtale-api.spaceflows.cn
# PAWTALE_E2E_WS_BASE_URL=wss://pawtale-api.spaceflows.cn

# iOS Appium/XCUITest real-device settings.
# Required: the Apple Developer Team used to sign WebDriverAgent.
PAWTALE_E2E_IOS_TEAM_ID=

# The runner discovers a single USB iPhone from the RemoteXPC tunnel registry.
# Set the UDID only when more than one device is connected.
# PAWTALE_E2E_IOS_UDID=
# PAWTALE_E2E_IOS_WDA_BUNDLE_ID=cn.spaceflows.pawtale.webdriveragent
# PAWTALE_E2E_IOS_TUNNEL_REGISTRY_URL=http://127.0.0.1:43000
# PAWTALE_E2E_APPIUM_SERVER_URL=http://127.0.0.1:4723
# PAWTALE_E2E_XCODE_DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
# PAWTALE_E2E_IOS_RECENT_SLOT=1
