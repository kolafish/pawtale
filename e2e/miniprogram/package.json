{
  "name": "pawtale-miniprogram-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Developer Tools and real-device end-to-end tests for the Pawtale memoir mini program.",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 specs/*.test.js",
    "test:devtools": "node --test --test-concurrency=1 specs/*.test.js",
    "ios:setup": "node bin/setup-ios-appium.js",
    "ios:tunnel": "node bin/start-ios-tunnel.js",
    "test:ios": "node bin/run-ios-ui-test.js",
    "test:ios:node": "node --test --test-concurrency=1 device-specs/ios-ui.test.js",
    "test:voice": "node --test --test-concurrency=1 specs/voice.test.js"
  },
  "devDependencies": {
    "appium": "3.7.0",
    "miniprogram-automator": "0.12.1",
    "ws": "8.21.3"
  },
  "overrides": {
    "jpeg-js": "0.4.4",
    "minimist": "1.2.8",
    "mkdirp": "0.5.6",
    "phin": "3.7.1"
  }
}
